;; Public facade for the render layer.
;;
;; The render layer is split into focused sub-namespaces under
;; src/io/render/ (buffer, palette, frame-math, hud, paint, sprites, main
;; for the per-frame scene, screens for the full-screen overlays).
;; This file re-exports the stable public surface so callers
;; (commands/play, tests) keep requiring `phel-doom.io.render` unchanged.
;; See docs/rendering.md for the module map.
(ns phel-doom.io.render
  (:require phel-doom.io.render.frame-math :as frame-math)
  (:require phel-doom.io.render.hud :as hud)
  (:require phel-doom.io.render.paint :as paint)
  (:require phel-doom.io.render.sprites :as sprites)
  (:require phel-doom.io.render.main :as main)
  (:require phel-doom.io.render.screens :as screens))

;; --- main: per-frame pipeline; screens: full-screen overlays
(def render! main/render!)
(def clear-screen main/clear-screen)
(def read-perf-snapshot main/read-perf-snapshot)
(def render-start-menu screens/render-start-menu)
(def render-settings! screens/render-settings!)
(def render-death-screen screens/render-death-screen)
(def render-victory-screen screens/render-victory-screen)

;; --- frame-math: projection + visibility (used by tests)
(def direction-char frame-math/direction-char)
(def project-enemy frame-math/project-enemy)
(def enemy-front-visible-at? frame-math/enemy-front-visible-at?)
(def scene-rows frame-math/scene-rows)

;; --- paint / sprites: reload reminder + blood columns (used by tests)
(def reload-reminder-visible? paint/reload-reminder-visible?)
(def build-blood-cols sprites/build-blood-cols)

;; --- hud: help menu rows (used by tests)
(def help-menu-rows hud/help-menu-rows)
