(ns phel-doom.modules.render
  (:require phel-doom.modules.engine :refer [cast-frame max-depth proj-dist]))

(def sky    "\e[48;5;236m ")
(def floor  "\e[48;5;239m ")
(def char-aspect 2.0)
(def hud-rows 1)

(defn- ^{:memoize-lru 64} shade-c [c]
  (str "\e[48;5;" c "m "))

(defn- shade [dist]
  (shade-c (+ 232
              (php/intval (* (- 1.0 (php/min 1.0 (/ dist max-depth))) 23)))))

(defn- direction-char [angle]
  (let [q (mod (php/intval
                (+ (/ (php/fmod (+ angle (* 4.0 php/M_PI)) (* 2.0 php/M_PI))
                      (/ php/M_PI 4.0))
                   0.5))
               8)]
    (cond
      (= q 0) "→"
      (= q 1) "↘"
      (= q 2) "↓"
      (= q 3) "↙"
      (= q 4) "←"
      (= q 5) "↖"
      (= q 6) "↑"
      :else   "↗")))

(defn- minimap-rows
  "Render the world's grid into a vector of ANSI-coded strings, one per
   grid row. Player cell shows a directional marker derived from angle."
  [world]
  (let [grid                (:grid world)
        {:keys [x y angle]} (:player world)
        pcol                (php/intval x)
        prow                (php/intval y)
        marker              (direction-char angle)
        gw                  (count (first grid))]
    (apply vector
           (map (fn [row]
                  (let [grow (get grid row)]
                    (apply str
                           (map (fn [col]
                                  (cond
                                    (and (= row prow) (= col pcol))
                                    (str "\e[93;1m" marker "\e[0m")
                                    (= 1 (get grow col))
                                    "\e[37;1m#\e[0m"
                                    :else                           "\e[90m·\e[0m"))
                                (range 0 gw)))))
                (range 0 (count grid))))))

(defn- hud-line [world stats]
  (let [{:keys [x y angle]} (:player world)]
    (str "\e[0m\e[1mpos\e[0m ("
         (php/number_format x 1) ", " (php/number_format y 1) ")"
         "  \e[1mangle\e[0m "
         (php/intval (* (php/fmod (+ angle (* 4.0 php/M_PI)) (* 2.0 php/M_PI))
                        (/ 180.0 php/M_PI)))
         "°"
         "  \e[1mfps\e[0m " (or (get stats :fps) 0)
         "  \e[1mframe\e[0m " (or (get stats :frame-ms) 0) "ms"
         "  \e[2m[wasd move, m map, q quit]\e[0m")))

(defn- layout
  "Viewport always fills the terminal; the minimap is an overlay in the
   top-right corner that the M key shows or hides."
  [cols rows mw]
  {:vw      cols
   :vh      (- rows hud-rows)
   :map-col (php/max 1 (+ (- cols mw) 1))
   :map-row 1})

(defn frame->string
  "Render the world sized to cols x rows. Walls project at a constant
   scale (proj-dist from engine) with a 2:1 character-aspect correction,
   so resizing the terminal widens the FOV instead of growing the walls.
   Minimap is overlaid top-right when (:show-map world) is truthy."
  {:export true}
  [world stats cols rows]
  (let [{:keys [vw vh map-col map-row]}
        (layout cols rows (count (first (:grid world))))
        columns                         (cast-frame world vw)
        tops                            (php/array)
        bots                            (php/array)
        shades                          (php/array)
        mrows                           (if (:show-map world) (minimap-rows world) [])
        visible-mh                      (php/min (count mrows) vh)]
    (loop [col 0 cs columns]
      (when (< col vw)
        (let [dist   (:dist (first cs))
              wall-h (php/min vh (php/intval
                                  (/ proj-dist (* (php/max 0.3 dist) char-aspect))))
              top    (php/intdiv (- vh wall-h) 2)]
          (aset tops col top)
          (aset bots col (+ top wall-h))
          (aset shades col (shade dist))
          (recur (+ col 1) (next cs)))))
    (str
     (loop [row 0 acc ""]
       (if (>= row vh)
         acc
         (recur (+ row 1)
                (str acc
                     (loop [col 0 prev nil run 0 line ""]
                       (if (>= col vw)
                         (if (zero? run) line (str line prev (php/str_repeat " " (- run 1))))
                         (let [c (cond
                                   (< row (aget tops col))  sky
                                   (>= row (aget bots col)) floor
                                   :else                    (aget shades col))]
                           (cond
                             (zero? run) (recur (+ col 1) c 1 line)
                             (= c prev)  (recur (+ col 1) prev (+ run 1) line)
                             :else       (recur (+ col 1) c 1
                                                (str line prev (php/str_repeat " " (- run 1))))))))
                     "\e[0m\n"))))
     (hud-line world stats)
     (apply str
            (map (fn [i]
                   (str "\e[" (+ map-row i) ";" map-col "H"
                        (get mrows i)))
                 (range 0 visible-mh))))))

(defn clear-screen
  "ANSI clear + cursor home."
  {:export true}
  []
  (print "\e[2J\e[H"))

(defn render!
  "Move cursor home and overwrite the previous frame in place. Avoids
   the full-screen clear that would otherwise flicker each frame."
  {:export true}
  [world stats cols rows]
  (print "\e[H")
  (print (frame->string world stats cols rows))
  (php/flush))
