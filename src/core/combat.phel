(ns phel-doom.core.combat
  (:require phel-doom.core.engine     :refer [cast-ray fov-proj-dist])
  (:require phel-doom.core.projection :refer [pitch-rows])
  (:require phel-doom.core.enemy      :refer [push-back-enemy shoot target-index spread-target-index beam-impact splash pierce spread-shoot])
  (:require phel-doom.core.enemy-ai :refer [attacks? noise-wake])
  (:require phel-doom.core.physics  :refer [try-move])
  (:require phel-doom.core.state    :refer [max-lives])
  (:require phel-doom.core.loot      :refer [corpse-type-at push-kill-loot])
  (:require phel-doom.core.weapons  :refer [weapon-order weapon-spec weapons]))

(def shot-knockback-dist
  "World units an enemy is shoved AWAY from the player on every shot
   that connects. ~1 cell. Wall-clamped (falls back to 0.5 / 0.25 if
   the full distance lands in geometry) so the push never punts an
   enemy through a wall. Bigger enemies (more HP) feel weighty as
   they walk back into range; small enemies get knocked clear of the
   muzzle giving the player a beat to reload."
  1.0)

(def armory-reserve
  "Reserve cap stamped onto every weapon when --armory is on. Picked
   big enough to read as 'infinite' in the HUD chip even after long
   chaingun sprays, small enough to render as 4 digits."
  9999)

;; ---------------------------------------------------------------------
;; Combat: the hitscan trigger pull (fire-shot) and the damage / i-frame
;; ticking (damage-step). Both consume and produce a world. Pure: sound
;; effects are not played here. Combat enqueues `{:name :vol}` events on
;; the world's per-frame `:sfx` queue via `push-sfx`; io (commands/play)
;; drains it after tick-world and emits them, gated on (:sound-on world).
;; ---------------------------------------------------------------------

(defn push-sfx
  "Append a sound event to the world's per-frame `:sfx` queue. Keeps
   the pure tick effect-free: the io layer drains `:sfx` after the tick
   and plays each event (gated on :sound-on). `tick-world` clears the
   queue at the start of every frame, so events never replay. Used by
   core/combat and by the pickup / interaction steps in commands/play."
  [world name ^float vol]
  (update world :sfx (fn [s] (conj (or s []) {:name name :vol vol}))))

;; =====================================================================
;; § Tunables
;; =====================================================================

(def shot-hit-radius
  "Off-axis tolerance for a hitscan — half an enemy 'cell'."
  0.5)

(def shot-max-range
  "Maximum hitscan range in world units."
  12.0)

(def shotgun-spread-half-angle
  "Default half-angle (radians, ~17°) of the shotgun cone when a weapon
   spec omits `:spread-half-angle`. Enemies within this angle of facing
   can be grazed by a spread shot (#125)."
  0.30)

(def touch-damage-dist
  "If an alive enemy is closer than this in world units, the player
   loses a life."
  0.7)

(def iframe-seconds
  "Seconds of post-hit invulnerability so one touch doesn't drain
   multiple lives across consecutive frames."
  1.0)

(def shake-damage-secs
  "Screen-shake duration when the player takes a hit. Matches the old
   iframe-derived jolt (the first ~0.25s of the i-frame window) so the
   damage feel is unchanged now that shake is its own timer (#414)."
  0.25)

(def shake-fire-secs
  "Base screen-shake for launching a splash weapon (rocket/BFG) that
   whiffs. Scaled by the weapon's :splash-radius so the BFG kicks harder
   than the rocket."
  0.08)

(def shake-blast-secs
  "Base screen-shake when a splash weapon's blast connects - the felt
   kick of an explosion. Scaled by :splash-radius like the launch kick."
  0.16)

(def fire-anim-seconds
  "Visibility duration of the recoil kick + muzzle flash + tracer after a
   shot. Long enough that the gun's bounce reads even if the frame rate
   dips (a too-short window collapsed the kick into one frame)."
  0.13)

(def muzzle-flash-fraction
  "Fraction of `fire-anim-seconds` the muzzle extralight stays lit for
   (#413). A fraction, not an absolute window, so it can never outlast the
   fire animation itself. 0.25 of 0.13s is ~1-2 frames at 60fps: the gun
   flashes the room, not a sustained glow over the whole recoil."
  0.25)

(def muzzle-extralight-steps
  "Shade-table steps the muzzle flash brightens walls by while lit (#413).
   Subtracted from the near-death `haze-shift` in the renderer, so it pulls
   walls toward the bright end of the 24-step table. Untuned by feel yet -
   picked as a visible-but-subtle lift; adjust once play-tested."
  4)

(defn ^:pure fire-extralight
  "Shade-table steps the muzzle flash brightens the room by, given the
   decaying `fire-anim` timer and its `fire-anim-duration` (#413). The
   flash is lit only while `fire-anim` is within the first
   `muzzle-flash-fraction` of the animation (i.e. the frame or two right
   after a shot), then goes dark for the rest of the recoil. Returns 0
   when idle (`fire-anim` 0) or for a degenerate 0 duration, so a resting
   frame stays byte-identical to the no-extralight renderer.
     (fire-extralight 0.0 0.13)  ; => 0  (idle)
     (fire-extralight 0.13 0.13) ; => muzzle-extralight-steps (just fired)"
  [^float fire-anim ^float fire-anim-duration]
  (if (and (php/> fire-anim-duration 0.0)
           (php/> fire-anim (php/* fire-anim-duration (php/- 1.0 muzzle-flash-fraction))))
    muzzle-extralight-steps
    0))

(def hit-marker-seconds
  "How long the crosshair hit-marker (`✗` kill / `×` wound) stays lit
   after a shot connects. A brief game-feel flash, sized like the recoil
   kick so it reads even at a dipped frame rate."
  0.12)

(def tracer-flight-seconds
  "Flight time of a cosmetic shot tracer (BFG ball / rocket). The shot's
   damage is instant (hitscan splash); the tracer is a purely visual
   projectile that flies from the muzzle to the impact over this window."
  0.32)

(def tracer-spawn-offset
  "World-units ahead of the player a tracer spawns, so it clears the
   muzzle instead of filling the screen on frame one."
  1.0)

(def fx-ttl-seconds
  "Initial life of a blood splatter. Render slices this lifetime into
   stages (kill flash → slump → collapse → blood gradient) so the
   enemy reads as dying in pieces instead of vanishing instantly."
  0.7)

(def corpse-ttl-seconds
  "Lifetime of a KILL fx (one carrying the dead enemy's :type, rendered
   as a Freedoom corpse sprite). Longer than a wound splatter so the
   body reads after the quick collapse, but short enough that corpses
   clear fast and don't litter the floor. The renderer normalises the
   death-frame timeline by this value."
  0.5)

(def streak-window-seconds
  "Time after a kill during which the next kill chains the streak.
   Counter resets to 1 if the player waits longer without a kill. Sized
   above the enemy respawn band (3-6s, see enemy/respawn-delay-max) so a
   steady kill-per-respawn pace keeps the streak alive instead of
   resetting on nearly every kill."
  7.0)

(def hit-stop-tough-seconds
  "Hit-stop: brief world freeze on a meaty kill so the blow lands with
   weight (play/tick-world skips the gameplay step while it decays).
   Only tough enemies (>= hit-stop-min-lives HP) trigger it — trash
   mobs would stutter a chaingun spray into a slideshow, so they kill
   clean with no freeze."
  0.07)

(def hit-stop-boss-seconds
  "Longer freeze on a boss kill (>= hit-stop-boss-lives HP) for a
   punchier finish."
  0.16)

(def hit-stop-min-lives
  "Minimum enemy max-HP for a kill to trigger hit-stop. Caco (3) and up;
   imps (1) and demons (2) kill without a freeze so the flow stays fast."
  3)

(def hit-stop-boss-lives
  "Enemy max-HP at / above which a kill triggers the longer boss freeze."
  10)

(defn hit-stop-for
  "Hit-stop duration (seconds) for killing an enemy with `max-lives` HP:
   0.0 for trash (no freeze), `hit-stop-tough-seconds` for tough mobs,
   `hit-stop-boss-seconds` for bosses. Pure lookup; exported for tests."
  [^int max-lives]
  (cond
    (php/>= max-lives hit-stop-boss-lives) hit-stop-boss-seconds
    (php/>= max-lives hit-stop-min-lives)  hit-stop-tough-seconds
    :else                                  0.0))

;; Per-weapon cadence / capacity lives in weapons/spec. These pistol
;; defaults remain as the explicit fallback at the few call sites that
;; may see a spec-less world (play reload-duration, pickups ammo-per-box)
;; and as the pistol reference in combat tests.

(def mag-size
  "Default magazine capacity (pistol). Per-weapon override in
   weapons/weapons :mag-size."
  10)

(def ammo-per-box
  "Default rounds added to the active weapon's reserve per pickup
   (pistol). Per-weapon override in weapons/weapons :ammo-per-box."
  10)

(def reload-cooldown-seconds
  "Default reload animation + firing lockout (pistol). Per-weapon
   override in weapons/weapons :reload-duration."
  1.2)

(defn- w-spec
  "Static catalogue entry for the world's active weapon. current-weapon
   defaults an unset :weapon to :pistol, so this is non-nil for every
   valid weapon in the catalog."
  [world]
  (weapon-spec world))

(def empty-click-seconds
  "How long the 'dry-fire click' visual + audio cue lingers after the
   player pulled the trigger on an empty mag. Long enough that the
   prompt is readable; short enough that holding the trigger doesn't
   leave it pinned forever."
  0.8)

(def berserk-seconds
  "Active window of the berserk powerup. While > 0 the player's
   weapon damage is multiplied by `berserk-damage-mul` and render
   paints a red rage tint on the viewport."
  18.0)

(def berserk-damage-mul
  "Berserk damage multiplier for RANGED weapons (the default). Berserk is
   melee-biased (#127): ranged guns get this modest boost, melee gets the
   much larger `berserk-melee-mul`."
  2)

(def berserk-melee-mul
  "Berserk damage multiplier for `:melee` weapons (the chainsaw). Far
   bigger than the ranged boost so berserk's identity is the DOOM 'go
   punch everything' melee surge, not a flat all-weapon buff (#127). At
   chainsaw damage 1 this is 6 per hit on a 0.10s cadence = a tank
   shredder for the rage window."
  6)

(defn berserk-mul-for
  "Berserk damage multiplier for `damage-type`: the big melee boost for
   `:melee`, the modest ranged boost otherwise (#127)."
  [damage-type]
  (if (= damage-type :melee) berserk-melee-mul berserk-damage-mul))

(defn arm-berserk
  "Pure helper: stamp the full `berserk-seconds` rage window on the world
   (a refresh, not a stack) AND full-heal the player to `max-lives` - the
   DOOM berserk pack restores health on pickup (#127). Never lowers an
   over-cap life count (e.g. from a soulsphere). Used by `pickup-berserks`
   after the pickup is consumed; isolated here so the timer + heal logic
   can be unit-tested without the IO sfx call."
  [world]
  (assoc world
         :berserk-secs berserk-seconds
         :lives (php/max (:lives world) max-lives)))

(defn berserk?
  "True while the player's berserk timer is still ticking down."
  [world]
  (pos? (or (:berserk-secs world) 0.0)))

(def invuln-seconds
  "Active window of the invulnerability sphere. While > 0 the
   damage-step skips touch hits and render paints a blue tint."
  10.0)

(defn invuln?
  "True while the player's invulnerability timer is still ticking."
  [world]
  (pos? (or (:invuln-secs world) 0.0)))

(def heat-per-shot
  "Heat added on each shot. Heat decays continuously; when it crosses
   1.0 the pistol jams. 0.30 = ~4 shots cold-mashed before jam, ~6
   sustained with the cool-rate bleed-off."
  0.30)

(def heat-cool-rate
  "Heat units shed per second when not firing."
  0.7)

(def jam-seconds
  "How long the pistol stays jammed (locked-out + visual indicator)
   after overheat."
  0.7)

(def knockback-dist
  "World units the player gets shoved AWAY from the attacker on each
   hit. ~1 cell; try-move clamps against walls so the player can't be
   pushed through geometry."
  0.9)

;; =====================================================================
;; § Damage step (timer decay + touch collision)
;; =====================================================================

(defn- ^:pure enemy-distance-sq
  [enemy ^float px ^float py]
  (let [dx (php/- (:x enemy) px)
        dy (php/- (:y enemy) py)]
    (php/+ (php/* dx dx) (php/* dy dy))))

(defn- ^:pure enemies-touching?
  [enemies ^float px ^float py]
  (let [threshold-sq (php/* touch-damage-dist touch-damage-dist)]
    (loop [es enemies]
      (cond
        (nil? es) false
        :else
        (let [e (first es)]
          ;; Dormant enemies don't deal contact damage — they're
          ;; passive until something wakes them. enemy-ai/attacks?
          ;; reads `:state` and falls back to the default-state
          ;; (:aware) for legacy fixtures that don't carry one,
          ;; so existing tests stay green.
          (if (and e (:alive e) (attacks? e)
                   (php/<= (enemy-distance-sq e px py) threshold-sq))
            true
            (recur (next es))))))))

(defn- decay-fx [fx ^float dt]
  (filterv (fn [e] (php/> (:ttl e) 0.0))
           (map (fn [e] (assoc e :ttl (php/- (:ttl e) dt)))
                (or fx []))))

(defn- ^:pure decay-timer
  "Tick world timer `k` down by `dt`, clamped at 0. Missing keys read as
   0.0 so a partial test fixture never errors."
  [world k ^float dt]
  (php/max 0.0 (php/- (or (get world k) 0.0) dt)))

(defn- ^:pure add-shake
  ;; Kick the screen-shake timer, keeping whichever is longer so a fresh
  ;; jolt never cuts an in-progress rumble short.
  [world ^float secs]
  (assoc world :shake-secs (php/max (or (:shake-secs world) 0.0) secs)))

(defn- stamp-hit-fx
  ;; Stamp the crosshair hit-marker for a connecting shot: a kill marker
  ;; when `killed?`, else a wound marker, both lit for hit-marker-seconds.
  ;; One call per trigger pull (each fire path already aggregates its
  ;; kill count), so no intra-frame stickiness is needed. This is also the
  ;; single "this shot connected" point, so it bumps the :shots-hit
  ;; accuracy counter here (issue #202).
  [world killed?]
  (-> world
      (assoc :hit-fx {:kill? (boolean killed?) :ttl hit-marker-seconds})
      (update :shots-hit (fn [n] (php/+ (or n 0) 1)))))

(defn- bump-weapon-kills
  ;; Tally `n` kills under the active weapon for the run-summary per-weapon
  ;; breakdown (issue #202). Keyed by the world's current :weapon.
  [world ^int n]
  (let [w   (or (:weapon world) :pistol)
        kbw (or (:kills-by-weapon world) {})]
    (assoc world :kills-by-weapon (assoc kbw w (php/+ (or (get kbw w) 0) n)))))

(defn- decay-hit-fx
  ;; Tick the hit-marker ttl down by `dt`; drop the whole FX (nil) once it
  ;; expires so the overlay stops drawing and the field doesn't linger.
  [fx ^float dt]
  (when fx
    (let [ttl' (php/- (or (:ttl fx) 0.0) dt)]
      (when (php/> ttl' 0.0) (assoc fx :ttl ttl')))))

(defn- ^:pure decay-timers [world ^float dt]
  (let [streak-secs' (decay-timer world :streak-secs dt)]
    (assoc world
           :iframes               (decay-timer world :iframes dt)
           :shake-secs            (decay-timer world :shake-secs dt)
           :fire-anim             (decay-timer world :fire-anim dt)
           :intro-secs            (decay-timer world :intro-secs dt)
           ;; The message TEXT is left in place; render gates on the timer,
           ;; so there is no per-frame string write here (#456).
           :msg-secs              (decay-timer world :msg-secs dt)
           :flash-secs            (decay-timer world :flash-secs dt)
           :streak-secs           streak-secs'
           :fire-cooldown         (decay-timer world :fire-cooldown dt)
           :reload-cooldown       (decay-timer world :reload-cooldown dt)
           :empty-click-secs      (decay-timer world :empty-click-secs dt)
           :berserk-secs          (decay-timer world :berserk-secs dt)
           :invuln-secs           (decay-timer world :invuln-secs dt)
           :heat                  (php/max 0.0 (php/- (or (:heat world) 0.0) (php/* heat-cool-rate dt)))
           :jam-secs              (decay-timer world :jam-secs dt)
           :locked-door-bump-secs (decay-timer world :locked-door-bump-secs dt)
           ;; Window expired: streak counter goes back to 0 so the HUD
           ;; stops showing it.
           :streak                (if (php/<= streak-secs' 0.0) 0 (or (:streak world) 0))
           :fx                    (decay-fx (:fx world) dt)
           :hit-fx                (decay-hit-fx (:hit-fx world) dt))))

(defn ^:pure player-immune?
  "True when an incoming hit can't land: i-frames still ticking, an
   invuln powerup is up, or dev god mode (--god, which suppresses damage
   entirely so the player can roam every room — reload + ammo + AI still
   run so the rest of the loop is exercised). Shared by the contact path
   (`vulnerable?`) and the projectile path (core/projectile) so the
   immunity rule lives in one place."
  [world]
  (or (php/> (:iframes world) 0.0)
      (invuln? world)
      (:god? world)))

(defn- ^:pure vulnerable? [world]
  (and (not (player-immune? world))
       (enemies-touching? (:enemies world)
                          (:x (:player world))
                          (:y (:player world)))))

(defn closest-attacker
  "Nearest alive enemy {:x :y :d2} to (px, py), or nil. One pass over
   the enemies vector, called once per damage event. Exported so the
   selection rule can be pinned by unit tests."
  [enemies ^float px ^float py]
  (loop [es enemies best-d 1.0e9 best nil]
    (cond
      (nil? es) best
      :else
      (let [e (first es)]
        (if (and e (:alive e))
          (let [dx (php/- (:x e) px)
                dy (php/- (:y e) py)
                d2 (php/+ (php/* dx dx) (php/* dy dy))]
            (if (php/< d2 best-d)
              (recur (next es) d2 {:x (:x e) :y (:y e) :d2 d2 :type (:type e)})
              (recur (next es) best-d best)))
          (recur (next es) best-d best))))))

(defn attacker-side
  "Map an attacker position to one of four bearings relative to player
   facing (atan2 convention): `:front`, `:back`, `:left`, `:right`. nil
   if `att` is nil. Front and back are narrow ±30° wedges around the
   player's facing and anti-facing vectors (`cos rel > cos(30°)` /
   `cos rel < -cos(30°)`) so the off-axis 45° hits stay on left/right.
   The remaining ~300° splits left vs right on the sign of `sin rel`.
   Render reads this to paint a directional damage indicator on the
   matching screen edge."
  [att ^float px ^float py ^float pangle]
  (when att
    (let [rel (php/- (php/atan2 (php/- (:y att) py) (php/- (:x att) px)) pangle)
          c   (php/cos rel)
          s   (php/sin rel)]
      (cond
        (php/> c 0.866)  :front
        (php/< c -0.866) :back
        (php/> s 0.0)    :right
        :else            :left))))

(defn attacker-octant
  "Map an attacker position to an octant index 0..7 relative to player
   facing: 0 = dead ahead, then clockwise (1 front-right, 2 right,
   3 back-right, 4 behind, 5 back-left, 6 left, 7 front-left). nil when
   `att` is nil. The 8-way twin of `attacker-side` (same atan2 / screen-
   Y-down convention): render draws the directional damage arc at the
   matching screen edge."
  [att ^float px ^float py ^float pangle]
  (when att
    (let [rel (php/- (php/atan2 (php/- (:y att) py) (php/- (:x att) px)) pangle)]
      (mod (php/intval (php/round (php// rel (php// php/M_PI 4.0)))) 8))))

(defn knockback
  "Shove the player one knockback-dist step AWAY from `att`.
   Uses try-move so walls clamp the displacement. Returns the world
   unchanged if att is nil or the player and attacker share a cell.
   Exported so the shove-away rule can be unit tested."
  [world att]
  (if (nil? att)
    world
    (let [p   (:player world)
          dx  (php/- (:x p) (:x att))
          dy  (php/- (:y p) (:y att))
          len (php/sqrt (php/+ (php/* dx dx) (php/* dy dy)))]
      (if (php/<= len 0.0001)
        world
        (try-move world
                  (php/* (php// dx len) knockback-dist)
                  (php/* (php// dy len) knockback-dist))))))

(def flash-seconds
  "How long the all-white impact flash holds before the red i-frame
   wash takes over. About two frames at 60fps - long enough that the
   eye reads it as a jolt, short enough not to mask the attacker behind it."
  0.03)

(defn ^:pure distance-volume
  "Map a world-units distance to a 0-1 sound volume. 1.0 at the player,
   ~0.1 floor at shot-max-range so a far kill / hit is still audible.
   Used by both `take-damage` (player pain) and `play-shot-sfx`
   (enemy kill / wound)."
  [^float dist]
  (php/max 0.1 (php/- 1.0 (php/min 1.0 (php// dist shot-max-range)))))

(def enemy-hit-damage
  "Half-heart HP an enemy's attack costs the player (the health pool is
   `state/max-lives` = 10, drawn as 5 hearts of 2 HP each). Light melee
   rushers chip a half heart; heavy bruisers + casters take a full
   heart; the cyberdemon boss hits for 1.5 hearts. Anything not listed
   defaults to 1 (half heart) via `hit-damage-for`."
  {:caco     2
   :baron    2
   :archvile 2
   :mancubus 2
   :cyber    3})

(defn hit-damage-for
  "HP one hit from an enemy of `type-kw` costs. Falls back to 1 (half
   heart) for unlisted / nil types, so a typeless test fixture or a
   light melee enemy lands the minimum."
  [type-kw]
  (or (get enemy-hit-damage type-kw) 1))

(defn- apply-hit
  "Land one hit on the player from attacker `att` ({:x :y :d2 [:type]}
   or nil) for `dmg` HP, `vol`-scaled pain sfx included. Armor absorbs
   the whole hit (drop one armor unit, no life lost regardless of dmg)
   but still triggers i-frames + the white flash so the player sees the
   armor consumed. Knockback shoves away from the attacker first, then
   the timers + hurt-side stamp onto the shoved world so render reads
   the new position next frame. Shared by the contact path
   (`take-damage`) and the projectile path (`hit-player-at`)."
  [world att ^float vol ^int dmg]
  (let [p       (:player world)
        armor   (:armor world)
        ;; HP ACTUALLY lost (clamped to the pool) feeds the run-summary
        ;; :damage-taken counter (issue #202) so an overkill blow on the
        ;; last point doesn't over-count; armor-absorbed hits cost no HP.
        lost    (php/min dmg (:lives world))
        damaged (if (php/> armor 0)
                  (assoc world :armor (php/- armor 1))
                  (-> world
                      (update :lives (fn [l] (php/max 0 (php/- l dmg))))
                      (update :damage-taken (fn [d] (php/+ (or d 0) lost)))))]
    (push-sfx
     (assoc (add-shake (knockback damaged att) shake-damage-secs)
            :iframes    iframe-seconds
            :flash-secs flash-seconds
            :hurt-side  (attacker-side att (:x p) (:y p) (:angle p))
            ;; 8-way bearing for the precise directional damage arc
            ;; (issue #201); :hurt-side stays for the 4-way blood-drip cols.
            :hurt-dir   (attacker-octant att (:x p) (:y p) (:angle p)))
     :player-pain vol)))

(defn hit-player-at
  "Apply one hit from a point source at world `(sx, sy)` for `dmg` HP —
   a projectile impact. Same effect as a contact hit (armor/life,
   i-frames, flash, distance-scaled sfx, knockback + hurt-side away from
   the source) but the attacker is an arbitrary point rather than the
   nearest enemy. `dmg` defaults to 1 for older callers. Caller must
   gate on `player-immune?` first."
  ([w0 ^float x0 ^float y0] (hit-player-at w0 x0 y0 1))
  ([world ^float sx ^float sy ^int dmg]
   (let [p  (:player world)
         dx (php/- sx (:x p))
         dy (php/- sy (:y p))
         d2 (php/+ (php/* dx dx) (php/* dy dy))]
     (apply-hit world {:x sx :y sy :d2 d2} (distance-volume (php/sqrt d2)) dmg))))

(defn- take-damage [world]
  (let [p   (:player world)
        att (closest-attacker (:enemies world) (:x p) (:y p))
        ;; Distance-attenuate the player-pain sfx the same way `:kill`
        ;; / `:wound` are scaled: a far enemy chipping a life off
        ;; should sound as quiet as the final hit that drops a far
        ;; enemy. closest-attacker already cached squared distance.
        vol (if att (distance-volume (php/sqrt (or (:d2 att) 0.0))) 1.0)]
    (apply-hit world att vol (hit-damage-for (:type att)))))

(defn damage-step
  "Per-frame: decay every timer, then apply a touch hit if i-frames
   have elapsed and an enemy is in range."
  [world ^float dt]
  (let [w (decay-timers world dt)]
    (if (vulnerable? w) (take-damage w) w)))

;; =====================================================================
;; § Shooting (one trigger pull → world update)
;; =====================================================================

(defn aim-angle-offset
  "Radians to add to the player's facing so a hitscan aims at the movable
   crosshair (#324). Maps the reticle's screen COLUMN to the per-column FOV
   ray the renderer casts for that column: `atan((aim-col - center) / pd)`
   where `center = scene-cols / 2` and `pd = fov-proj-dist(scene-cols)`.
   Sharing the engine's `fov-proj-dist` keeps the shot's ray identical to
   the column the player sees the reticle on, so the enemy whose projected
   sprite the `+` sits over is the one struck.

   Returns 0.0 (fire straight ahead, the centre-aim default) when the
   reticle is at screen centre, OR when `aim-col` / `scene-cols` is nil
   (mouse off / headless world): a centred reticle offsets nothing, so the
   mouse-off render + hitscan stay byte-identical to the pre-#324 game."
  [aim-col scene-cols]
  (if (or (nil? aim-col) (nil? scene-cols) (php/<= scene-cols 0))
    0.0
    (let [center (php/* 0.5 scene-cols)
          pd     (fov-proj-dist scene-cols)]
      (php/atan (php// (php/- aim-col center) pd)))))

(defn- aim-angle
  "Player facing PLUS the reticle's angular offset (#324) - the direction
   every hitscan / beam / cone is fired along. A mouse-off world (no
   `:aim-col`) offsets 0, so this is just `:angle` and the shot fires dead
   ahead exactly as before."
  [world]
  (php/+ (:angle (:player world))
         (aim-angle-offset (:aim-col world) (:scene-cols world))))

(defn- cast-wall-dist
  "Distance the shot travels along the AIM direction (#324): an off-centre
   reticle steers the probe too, so the shot stops at the wall the reticle
   points at, not the one dead ahead. Centre / mouse-off aims down
   `:angle`, identical to the pre-#324 cast."
  [world]
  (let [p (:player world)]
    (cast-ray (:pgrid world) (:x p) (:y p) (aim-angle world))))

(defn- aim-svh
  "Scene viewport height (rows) the hit gate projects against. The game
   loop stamps `:scene-rows` each frame from the SAME terminal-derived
   height the renderer uses, so a hitscan agrees with the drawn sprite.
   nil when absent (tests / headless callers that never set it), which
   disables the vertical gate downstream - identical to looking level."
  [world]
  (:scene-rows world))

(defn- aim-pr
  "Camera pitch shear in scene rows for the hit gate: `pitch-rows` of the
   player's `:pitch` at the scene height `svh`. The fixed screen-centre
   crosshair sits `pr` rows off the sprite centre, so combat compares
   `|pr|` against `sprite-half-rows`. 0 when `svh` is nil (no scene to
   project against) or the player has no pitch - the level-aim default."
  [world svh]
  (if (nil? svh)
    0
    (pitch-rows (or (:pitch (:player world)) 0.0) svh)))

(defn- target-in-sights?* [world]
  (let [p      (:player world)
        spec   (w-spec world)
        svh    (aim-svh world)
        pr     (aim-pr world svh)
        wall-d (cast-wall-dist world)
        max-r  (or (:max-range spec) shot-max-range)
        idx    (if (:spread? spec)
                 ;; The shotgun takes the nearest enemy inside its CONE,
                 ;; with no perpendicular corridor, and the two rules
                 ;; disagree in both directions at shotgun range: a
                 ;; point-blank enemy 0.45 off-axis is inside the corridor
                 ;; but outside the cone (red, whiffs), and one 0.8 off at
                 ;; five units is outside the corridor but inside the cone
                 ;; (white, hits). Ask the rule this weapon actually fires.
                 (spread-target-index (:enemies world) (:x p) (:y p) (aim-angle world)
                                      wall-d
                                      (or (:spread-half-angle spec) shotgun-spread-half-angle)
                                      max-r svh pr)
                 (target-index (:enemies world) (:x p) (:y p) (aim-angle world)
                               wall-d shot-hit-radius max-r svh pr))]
    (php/>= idx 0)))

(defn target-in-sights?
  "True when a shot fired THIS instant would hit an enemy (#458).

   Runs the same selection `resolve-shot` runs - same aim angle, same
   wall probe, same weapon range, same vertical billboard gate - through
   `enemy/target-index`, which is the extracted, damage-free half of
   `enemy/shoot`. Asking the real rule rather than re-deriving it is the
   whole point: since #243 a shot only lands when the crosshair is on the
   drawn sprite, so an approximation would eventually disagree with the
   gun and the reticle would be lying.

   Dispatches on the weapon: `:spread?` (the shotgun) fires a CONE with
   no perpendicular corridor, so it asks `spread-target-index` instead.
   The two rules disagree in both directions at shotgun range, which is
   the range a shotgun is used at. Splash weapons (BFG, rocket) are the
   one loose end: red still means the blast connects, but the blast can
   also catch an enemy the reticle left white, since it clips everything
   near the impact.

   It answers WHERE the shot goes, not whether the trigger works: an
   empty mag or a running reload leaves the target under the crosshair
   and the reticle red, which is correct - the dry CLICK and the reload
   prompt already own the ammo story, and a reticle that dropped out
   mid-reload would read as the target having moved.

   Called once per frame by `frame-stats` for the hostile reticle: one
   `cast-ray` (against the 120+ the cast loop already marches) plus a
   walk over the same handful of enemies the renderer projects. Skipped
   entirely while paused, where there is nothing to aim at."
  [world]
  (if (or (:paused world) (nil? (some :alive (:enemies world))))
    false
    (target-in-sights?* world)))

(defn- resolve-shot [world]
  (let [p         (:player world)
        spec      (w-spec world)
        base-dmg  (or (:damage spec) 1)
        dmg-type  (:damage-type spec)
        dmg       (if (berserk? world) (php/* base-dmg (berserk-mul-for dmg-type)) base-dmg)
        max-range (or (:max-range spec) shot-max-range)
        svh       (aim-svh world)]
    ;; Fire along the AIM direction (#324) so the reticle column selects the
    ;; target enemy; a centred / mouse-off reticle reduces to `:angle`.
    (shoot (:enemies world) (:x p) (:y p) (aim-angle world)
           (cast-wall-dist world)
           shot-hit-radius max-range dmg dmg-type
           svh (aim-pr world svh))))

(defn- push-blood-fx
  "Append a blood/death fx at `hit-pos`. On a kill the caller passes the
   dead enemy's `type-kw`, which the renderer uses to draw a collapsing
   Freedoom corpse sprite; wounds (no type) stay a blood splatter."
  ([w hp] (push-blood-fx w hp nil))
  ([world hit-pos type-kw]
   (update world :fx
           (fn [fx]
             (conj (or fx [])
                   (if type-kw
                     {:x (:x hit-pos) :y (:y hit-pos) :ttl corpse-ttl-seconds :type type-kw}
                     {:x (:x hit-pos) :y (:y hit-pos) :ttl fx-ttl-seconds}))))))

(defn- spawn-shot-tracer
  "Append a cosmetic projectile (`kind` -> a sprite) flying from just
   ahead of the player toward the impact (`ix`, `iy`). Purely visual; the
   damage was already applied by the splash."
  [world kind ix iy]
  (let [p  (:player world)
        sx (php/+ (:x p) (php/* tracer-spawn-offset (php/cos (:angle p))))
        sy (php/+ (:y p) (php/* tracer-spawn-offset (php/sin (:angle p))))]
    (update world :shot-tracers
            (fn [ts] (conj (or ts [])
                           {:x sx :y sy :tx ix :ty iy :kind kind
                            :t 0.0 :dur tracer-flight-seconds})))))

(defn- maybe-unlock-boss-door
  "On a `:door-lock :boss` level, killing a `:cyber` enemy grants the
   synthetic `:boss` keycard so the exit door becomes passable. No
   physical card spawns for boss locks — this hook is the unlock."
  [world killed-enemy]
  (if (and (= (:door-lock world) :boss)
           (= (:type killed-enemy) :cyber))
    (assoc world :held-keys
           (conj (or (:held-keys world) #{}) :boss))
    world))

(defn- on-shot-hit
  "World update on a successful hit. enemy/shoot has already decremented
   `:lives` and (when the pool emptied) flipped `:alive false` and
   stamped a respawn timer; on-shot-hit only has to decide whether this
   was a wound or a kill, and update the score / streak / blood-fx
   accordingly. A blood splatter fires on every hit so the player sees
   the wound, but `:kills` and `:streak` only advance on the final
   shot that drops the enemy. Streak chains while `:streak-secs` is
   still ticking from the previous kill; otherwise it restarts at 1.
   When the killed enemy is the L10 boss the exit door unlocks via
   `maybe-unlock-boss-door`."
  [world enemies-after hit-pos idx]
  (let [killed?   (false? (:alive (get enemies-after idx)))
        killed-e  (get enemies-after idx)
        chain?    (pos? (or (:streak-secs world) 0.0))
        streak'   (if chain? (php/+ (or (:streak world) 0) 1) 1)
        ;; Shot-direction knockback: shove wounded enemies one cell
        ;; back along the SHOT direction (the aim angle, #324) so an
        ;; off-centre hit recoils away from the muzzle line, not the
        ;; screen centre. Skip on the killing blow so the corpse +
        ;; loot drop stay on the death cell.
        pushed-es (if killed?
                    enemies-after
                    (let [a     (aim-angle world)
                          cos-a (php/cos a)
                          sin-a (php/sin a)]
                      (push-back-enemy enemies-after (:grid world)
                                       idx cos-a sin-a
                                       shot-knockback-dist)))
        scored    (if killed?
                    (bump-weapon-kills
                     (assoc (update (assoc world :enemies pushed-es)
                                    :kills (fn [k] (php/+ k 1)))
                            :streak      streak'
                            :streak-secs streak-window-seconds)
                     1)
                    (assoc world :enemies pushed-es))
        unlocked  (if killed? (maybe-unlock-boss-door scored killed-e) scored)
        ;; Kill drops a random pickup at the corpse's cell. Wounds
        ;; don't drop — the kill is the reward trigger.
        with-loot (if killed? (push-kill-loot unlocked hit-pos) unlocked)
        ;; Hit-stop: stamp a freeze timer on a meaty kill so the blow
        ;; reads. Trash mobs return 0.0 (no freeze) — see hit-stop-for.
        juiced    (if killed?
                    (let [hs (hit-stop-for (or (:max-lives killed-e) 1))]
                      (if (php/> hs 0.0) (assoc with-loot :hit-stop-secs hs) with-loot))
                    with-loot)]
    (stamp-hit-fx
     (push-blood-fx (assoc juiced :fire-anim fire-anim-seconds) hit-pos
                    (when killed? (:type killed-e)))
     killed?)))

(defn- on-shot-miss [world]
  (assoc world :fire-anim fire-anim-seconds))

(def sight-sfx-by-type
  "Per-type wake cue (#460): the growl a monster makes on noticing the
   player. Types with no baked cry of their own borrow a sibling's, so
   every monster in the catalog has a voice."
  {:imp       :sight-imp
   :demon     :sight-demon
   :spectre   :sight-spectre
   :pinky     :sight-pinky
   :caco      :sight-caco
   :baron     :sight-baron
   :cyber     :sight-cyber
   :revenant  :sight-revenant
   :archvile  :sight-archvile
   :mancubus  :sight-mancubus})

(defn sight-sfx-for
  "The wake cue for `type-kw`, falling back to the imp's so an unlisted
   or typeless enemy still announces itself."
  [type-kw]
  (or (get sight-sfx-by-type type-kw) :sight-imp))

(def death-sfx-by-type
  "Per-type death cry (#460). Keys are the baked `freedoom-sfx` events;
   a type absent here keeps the generic `:kill` cue alone."
  {:imp       :death-imp
   :demon     :death-demon
   :spectre   :death-demon
   :pinky     :death-demon
   :caco      :death-caco
   :baron     :death-baron
   :cyber     :death-cyber
   :revenant  :death-revenant
   :archvile  :death-archvile
   :mancubus  :death-mancubus})

(defn death-sfx-for
  "The death cry for `type-kw`, or nil when the catalog has none."
  [type-kw]
  (get death-sfx-by-type type-kw))

(defn- enqueue-shot-sfx
  "Append the shot's sound events to `out`'s :sfx queue and return it.
   `src` is the pre-shot world (active weapon spec + player position).

   The fire report is distance-attenuated by how far the COLLISION TARGET
   is from the player (`distance-volume`): a point-blank hit plays at full
   volume, a far hit drops toward the ~0.1 floor so a distant firefight
   reads quieter than one in your face. On a hit the target is the struck
   enemy; on a MISS (`hit?` false) there is no enemy, so the shot still
   collides with a WALL and the report attenuates by that wall distance
   (`cast-wall-dist`) — a near wall reads loud, a far wall or an open
   level drops toward the floor. Either way the volume tells you how close
   the thing the shot hit is. Every volume here is later multiplied by the
   player's global SFX scalar in io/sound, so it stays relative to the SFX
   max set in options.

   Always queue the ACTIVE weapon's own report so every trigger pull
   sounds like the gun going off — hit or miss. Per-weapon `:fire-sfx`
   (weapons spec) gives each gun a distinct voice; falls back to :shoot.

   On a kill, layer the kill cue ON TOP of the fire report at the same
   distance volume so a kill keeps its punch. Wounds ride on the fire
   sound plus the floating HP digit + blood splatter — no separate thud."
  [out src hit? killed? hit-pos]
  (let [fire-sfx (or (:fire-sfx (w-spec src)) :shoot)]
    (if hit?
      (let [p     (:player src)
            dx    (php/- (:x hit-pos) (:x p))
            dy    (php/- (:y hit-pos) (:y p))
            d     (php/sqrt (php/+ (php/* dx dx) (php/* dy dy)))
            vol   (distance-volume d)
            fired (push-sfx out fire-sfx vol)]
        ;; Per-type death cry (#460) layered on the generic kill cue: an
        ;; imp and a cyberdemon dying used to make exactly the same noise.
        ;; `corpse-type-at` is the same lookup the corpse sprite uses, and
        ;; an unbaked type simply has no extra cry.
        (if killed?
          (let [killed-cue (push-sfx fired :kill vol)
                death-sfx  (death-sfx-for (corpse-type-at src hit-pos))]
            (if death-sfx (push-sfx killed-cue death-sfx vol) killed-cue))
          fired))
      ;; MISS: no enemy struck, but the shot still collides with a wall.
      ;; Attenuate by that wall distance so a near wall reads loud and a
      ;; far wall / open level reads quiet, matching the enemy-hit path.
      ;; cast-wall-dist re-probes the aim ray (cheap, off the per-frame
      ;; path) and reproduces the same wall-d the fire path used.
      (push-sfx out fire-sfx (distance-volume (cast-wall-dist src))))))

(defn can-fire?
  "True when the active weapon is ready: cooldown elapsed, not jammed,
   no reload in progress, AND the magazine still has rounds. Empty
   mags fall through to tick-shooting's dry-fire path which arms the
   `:empty-click-secs` timer and plays the deny sfx so the player
   sees they need to press R.

   Weapons flagged `:no-ammo?` (chainsaw) skip the mag check entirely
   so the saw fires as long as the cooldown is up."
  [world]
  (let [no-ammo? (boolean (:no-ammo? (w-spec world)))]
    (and (php/<= (or (:fire-cooldown world) 0.0) 0.0)
         (php/<= (or (:jam-secs world) 0.0) 0.0)
         (php/<= (or (:reload-cooldown world) 0.0) 0.0)
         (or no-ammo? (pos? (or (:mag world) 0))))))

(defn apply-heat
  "After a shot lands, bump heat + arm the per-weapon fire-cooldown,
   and burn one round from the magazine. Heat / jam math only runs
   for weapons whose spec has `:overheats? true` (pistol only); on
   other weapons heat stays at 0 and the jam timer is never set.
   Chaingun would otherwise hit jam in under half a second of
   auto-fire (0.30 heat-per-shot × 20 shots/s) — that's
   anti-feature for a 'sustained spray' weapon.

   Weapons flagged `:no-ammo?` (chainsaw) skip the mag drain so the
   saw can run indefinitely; the cooldown still arms so the per-tick
   rhythm is honoured."
  [world]
  (let [sp        (w-spec world)
        overheat? (boolean (:overheats? sp))
        no-ammo?  (boolean (:no-ammo? sp))
        heat'     (if overheat?
                    (php/+ (or (:heat world) 0.0) heat-per-shot)
                    0.0)
        jam?      (and overheat? (php/>= heat' 1.0))
        mag-now   (or (:mag world) (:mag-size sp))
        mag'      (if no-ammo? mag-now (php/max 0 (php/- mag-now 1)))]
    (assoc world
           :fire-cooldown (:fire-cooldown sp)
           :heat          (if jam? 0.0 heat')
           :jam-secs      (if jam? jam-seconds (or (:jam-secs world) 0.0))
           :mag           mag')))

(defn reloading?
  "True when the player COULD reload the active weapon right now.
   Returns false unconditionally for `:no-ammo?` weapons (chainsaw)
   so pressing R is a silent no-op rather than firing the reload
   lockout."
  [world]
  (let [sp (w-spec world)]
    (and (not (boolean (:no-ammo? sp)))
         (php/<= (or (:reload-cooldown world) 0.0) 0.0)
         (php/< (or (:mag world) 0) (:mag-size sp))
         (pos? (or (:ammo-reserve world) 0)))))

(defn reload
  "Top the magazine back up from the spare reserve and arm a short
   reload cooldown so trigger-mashing can't fire on the same frame
   as pressing R. Three no-op cases that all keep the world identity
   stable so callers can compare cheaply:
     - reload already in progress (don't reset the lockout)
     - mag already full        (don't waste reserve)
     - reserve empty           (let the player keep pressing R)
   Otherwise: draw `min(needed, reserve)` rounds from `:ammo-reserve`
   into `:mag` and arm the cooldown."
  [world]
  (let [sp      (w-spec world)
        mag     (or (:mag world) 0)
        reserve (or (:ammo-reserve world) 0)
        needed  (php/- (:mag-size sp) mag)]
    (cond
      (php/> (or (:reload-cooldown world) 0.0) 0.0) world
      (php/<= needed 0)                             world
      (php/<= reserve 0)                            world
      :else
      (let [drawn (php/min needed reserve)]
        (assoc world
               :mag             (php/+ mag drawn)
               :ammo-reserve    (php/- reserve drawn)
               :reload-cooldown (:reload-duration sp))))))

(defn- score-multikill
  "Shared multi-kill aggregation for `bfg-fire` / `finish-multikill`:
   given the woken enemies + kill count, bump :kills / :streak /
   :streak-secs, award weapon kills, and unlock the boss door if a cyber
   died. Returns [world' boss-killed?] so the caller can size hit-stop."
  [world woken killed]
  (let [killed?      (php/> killed 0)
        chain?       (pos? (or (:streak-secs world) 0.0))
        boss-killed? (and (= (:door-lock world) :boss)
                          (some (fn [e] (and (= (:type e) :cyber)
                                             (false? (:alive e))))
                                woken))
        scored       (let [s (assoc world
                                    :enemies     woken
                                    :kills       (php/+ (or (:kills world) 0) killed)
                                    :streak      (if killed?
                                                   (php/+ (if chain? (or (:streak world) 0) 0) killed)
                                                   (or (:streak world) 0))
                                    :streak-secs (if killed? streak-window-seconds
                                                     (or (:streak-secs world) 0.0)))]
                       (if killed? (bump-weapon-kills s killed) s))
        unlocked     (if boss-killed?
                       (assoc scored :held-keys (conj (or (:held-keys scored) #{}) :boss))
                       scored)]
    [unlocked boss-killed?]))

(defn- bfg-fire
  "Resolve a BFG shot (any weapon with a `:splash-radius`). The beam
   lands at `beam-impact` (nearest enemy along the ray, else the wall);
   `splash` then damages every enemy within `:splash-radius` of that
   point — a multi-kill room-clearer. Bumps `:kills` by the body count,
   chains the streak, unlocks the boss door if a cyber died in the
   blast, arms hit-stop, and (like every shot) wakes the room by noise.
   No per-enemy loot drops: the blast is its own reward (issue #58)."
  [world]
  (let [p                       (:player world)
        spec                    (w-spec world)
        radius                  (:splash-radius spec)
        base                    (or (:splash-damage spec) 1)
        dtype                   (:damage-type spec)
        dmg                     (if (berserk? world) (php/* base (berserk-mul-for dtype)) base)
        max-r                   (or (:max-range spec) shot-max-range)
        wall-d                  (cast-wall-dist world)
        [ix iy]                 (beam-impact (:enemies world) (:x p) (:y p) (aim-angle world)
                                             wall-d shot-hit-radius max-r)
        [es' killed]            (splash (:enemies world) ix iy radius dmg dtype)
        woken                   (noise-wake es' (:grid world) (:x p) (:y p))
        hit-pos                 {:x ix :y iy}
        killed?                 (php/> killed 0)
        [unlocked boss-killed?] (score-multikill world woken killed)
        juiced                  (if killed?
                                  (assoc unlocked :hit-stop-secs
                                         (if boss-killed? hit-stop-boss-seconds hit-stop-tough-seconds))
                                  unlocked)
        ;; Cosmetic flying projectile: a green BFG ball or a rocket.
        tracered                (spawn-shot-tracer juiced
                                                   (if (php/=== (:weapon world) :bfg) :bfg-ball :rocket)
                                                   ix iy)
        ;; Felt kick (#414): the launch alone rumbles; a connecting blast
        ;; rumbles harder. Both scale by splash-radius so the BFG (3.0)
        ;; out-shakes the rocket (2.0).
        kicked                  (add-shake tracered
                                           (php/* (if killed? shake-blast-secs shake-fire-secs)
                                                  (php// radius 2.0)))]
    ;; bfg has no wound-only signal (splash returns just a kill count), so
    ;; a kill is the hit proxy: a killing blast attenuates by the impact
    ;; distance, a wall hit / whiff plays at full volume.
    (enqueue-shot-sfx
     (apply-heat (let [bw (push-blood-fx (assoc kicked :fire-anim fire-anim-seconds) hit-pos
                                         (when killed? (corpse-type-at woken hit-pos)))]
                   ;; bfg has no wound-only signal, so a kill is the hit
                   ;; proxy for the marker too (no marker on a whiff).
                   (if killed? (stamp-hit-fx bw true) bw)))
     world killed? killed? hit-pos)))

(defn- finish-multikill
  "Shared tail for the multi-target hitscans (`pierce-fire`,
   `spread-fire`): given the enemies after damage was applied, the kill
   count, the nearest hit-pos (or nil), and the toughest kill's HP,
   aggregate kills + streak like `bfg-fire`, unlock the boss door if a
   cyber died, size hit-stop per the meatiest kill, splat blood on the
   primary, drain the mag, and queue sfx. No per-enemy loot (mirrors the
   splash path)."
  [world enemies-after killed hit-pos tough]
  (let [p        (:player world)
        woken    (noise-wake enemies-after (:grid world) (:x p) (:y p))
        hit?     (some? hit-pos)
        killed?  (php/> killed 0)
        unlocked (first (score-multikill world woken killed))
        juiced   (if killed?
                   (let [hs (hit-stop-for tough)]
                     (if (php/> hs 0.0)
                       (assoc unlocked :hit-stop-secs hs)
                       unlocked))
                   unlocked)
        based    (assoc juiced :fire-anim fire-anim-seconds)]
    (enqueue-shot-sfx
     (apply-heat (if hit?
                   (stamp-hit-fx
                    (push-blood-fx based hit-pos
                                   (when killed? (corpse-type-at enemies-after hit-pos)))
                    killed?)
                   based))
     world hit? killed? (or hit-pos {:x (:x p) :y (:y p)}))))

(defn- pierce-fire
  "Resolve a piercing shot (weapons flagged `:pierce?`, the pistol). The
   round damages every enemy in the line instead of stopping at the
   nearest, so a row of lined-up enemies takes one hit each — the
   pistol's niche over the higher-DPS chaingun."
  [world]
  (let [p                          (:player world)
        spec                       (w-spec world)
        base                       (or (:damage spec) 1)
        dtype                      (:damage-type spec)
        dmg                        (if (berserk? world) (php/* base (berserk-mul-for dtype)) base)
        max-r                      (or (:max-range spec) shot-max-range)
        wall-d                     (cast-wall-dist world)
        svh                        (aim-svh world)
        [es' killed hit-pos tough] (pierce (:enemies world) (:x p) (:y p) (aim-angle world)
                                           wall-d shot-hit-radius max-r dmg dtype
                                           svh (aim-pr world svh))]
    (finish-multikill world es' killed hit-pos tough)))

(defn- spread-fire
  "Resolve a spread shot (weapons flagged `:spread?`, the shotgun). The
   nearest enemy in the cone takes full damage; up to `:spread-targets`-1
   others in the cone are grazed for the smaller `:graze-damage` — a
   multi-target crowd hit that justifies the slow cadence (#125)."
  [world]
  (let [p                          (:player world)
        spec                       (w-spec world)
        base                       (or (:damage spec) 1)
        dtype                      (:damage-type spec)
        mul                        (if (berserk? world) (berserk-mul-for dtype) 1)
        prim                       (php/* base mul)
        graze-base                 (or (:graze-damage spec) 1)
        graze                      (php/* graze-base mul)
        targets                    (or (:spread-targets spec) 3)
        half                       (or (:spread-half-angle spec) shotgun-spread-half-angle)
        max-r                      (or (:max-range spec) shot-max-range)
        wall-d                     (cast-wall-dist world)
        svh                        (aim-svh world)
        [es' killed hit-pos tough] (spread-shoot (:enemies world) (:x p) (:y p) (aim-angle world)
                                                 wall-d half max-r prim graze targets dtype
                                                 svh (aim-pr world svh))]
    (finish-multikill world es' killed hit-pos tough)))

(defn- single-hitscan-fire
  "Single-target hitscan path (chaingun / chainsaw / incinerator): scan
   the one nearest enemy on the player's facing, wake the room, and route
   to on-shot-hit / on-shot-miss."
  [world]
  (let [[enemies' hit? hit-pos idx] (resolve-shot world)
        p                           (:player world)
        woken                       (noise-wake enemies' (:grid world) (:x p) (:y p))
        killed?                     (and hit?
                                         (false? (:alive (get woken idx))))]
    (enqueue-shot-sfx
     (apply-heat (if hit?
                   (on-shot-hit world woken hit-pos idx)
                   (on-shot-miss (assoc world :enemies woken))))
     world hit? killed? hit-pos)))

(defn fire-shot
  "Resolve one trigger pull end-to-end. Weapons with `:splash-radius`
   (BFG, rocket) route to `bfg-fire`; `:pierce?` weapons (pistol) to
   `pierce-fire`; `:spread?` weapons (shotgun) to `spread-fire`;
   everything else is a single-target hitscan. After the shot, run a
   flood-fill sound-wake from the player's cell so dormant enemies in the
   same room hear it and switch to :aware. Doors block the BFS so the
   wake stays local — same per-sector noise rule DOOM uses."
  [world]
  ;; Accuracy (issue #202): every trigger pull that reaches fire-shot
  ;; counts as one shot fired, regardless of weapon or whether it lands.
  ;; :shots-hit is bumped per connecting pull inside stamp-hit-fx.
  (update
   (cond
     (:splash-radius (w-spec world)) (bfg-fire world)
     (:pierce? (w-spec world))       (pierce-fire world)
     (:spread? (w-spec world))       (spread-fire world)
     :else                           (single-hitscan-fire world))
   :shots-fired (fn [n] (php/+ (or n 0) 1))))

(defn- empty-trigger-pull
  "Trigger pulled while mag = 0 AND no cooldown / jam in the way. Arm
   the empty-click timer and play the dry-fire sfx so render can
   surface the 'press R to reload' prompt this frame. Cooldown / jam
   pulls stay silent — the player gets visual feedback from those
   states already (jam label / fire-anim) so doubling up would be
   noisy."
  [world]
  (push-sfx (assoc world :empty-click-secs empty-click-seconds) :click 0.6))

(defn tick-shooting
  {:doc "Resolve a shot when the trigger is active this frame AND the
         active weapon is ready (not on cooldown, not jammed).

         Trigger semantics depend on the weapon's `:auto-fire?` flag:
           - auto-fire (pistol, chaingun): fires every frame the trigger
             is held once `:fire-cooldown` elapses. Holding space sprays.
           - single-action (shotgun): each shell requires a fresh rising
             edge - holding space does not re-fire after the first shot.

         Trigger pulls during a jam / fire-cooldown / mid-reload are
         dropped silently. Pulls on an empty mag arm a dry-fire click +
         'R to reload' prompt instead. Two-arity kept for legacy callers
         (e.g. tests) that pre-date :fire-held."
   :see-also ["fire-shot" "reload" "push-sfx" "damage-step"]
   :example "(tick-shooting world true false) ; trigger rising-edge this frame"}
  ([world fire?] (tick-shooting world fire? false))
  ([w fire-edge? fire-held?]
   (let [auto?        (boolean (:auto-fire? (weapon-spec w)))
         ;; No weapon in hand (`:hide-weapon?`): swallow the trigger so
         ;; there's no shot, no dry-fire click, no muzzle flash.
         should-fire? (and (not (:hide-weapon? w))
                           (or fire-edge? (and auto? fire-held?)))]
     (cond
       (not should-fire?) w
       (can-fire? w)      (fire-shot w)
       (and (zero? (or (:mag w) 0))
            (php/<= (or (:fire-cooldown w) 0.0) 0.0)
            (php/<= (or (:jam-secs w) 0.0) 0.0)
            (php/<= (or (:reload-cooldown w) 0.0) 0.0)) (empty-trigger-pull w)
       :else              w))))

(defn tick-armory
  "Dev cheat: when `:armory?` is set, refill every weapon's mag to
   capacity and reserve to `armory-reserve` each tick + clear the
   reload cooldown. Net effect is effectively-infinite ammo with no
   reload pauses, so the player can test every weapon's hit feel
   without grinding for boxes. No-op when `:armory?` is falsy.

   A world may override the reserve count via `:armory-reserve` (e.g.
   pinned to 99 so the HUD reads a clean two digits instead of the dev
   default)."
  [world]
  (if (not (:armory? world))
    world
    (let [res     (or (:armory-reserve world) armory-reserve)
          active  (or (:weapon world) :pistol)
          stash   (reduce (fn [acc kw]
                            (let [s (get weapons kw)]
                              (assoc acc kw {:mag     (:mag-size s)
                                             :reserve res})))
                          {} weapon-order)
          mag-cap (:mag-size (get weapons active))]
      (assoc world
             :weapon-state    stash
             :mag             mag-cap
             :ammo-reserve    res
             :reload-cooldown 0.0))))
