(ns phel-doom-tests.io.render-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.core.engine :refer [proj-dist])
  (:require phel-doom.core.projection :refer [wall-px])
  (:require phel-doom.io.render.frame-math :refer [floor-offset-rows project-enemy-pd sprite-h-pd])
  (:require phel-doom.io.render :refer [direction-char project-enemy enemy-front-visible-at? reload-reminder-visible? help-menu-rows]))

;; ---------------------------------------------------------------------
;; reload-reminder-visible? (#128): the periodic "press R to RELOAD" nag
;; must scale to the active weapon's mag-size instead of an absolute
;; mag<=2 threshold. Single-round mags (BFG mag-size 1) reload every
;; shot by design, so the nag is pure noise and must be suppressed.
;; ---------------------------------------------------------------------

(deftest test-reload-reminder-suppressed-for-single-round-mag
  ;; BFG: mag-size 1. Empty mag, reserve to spare, clock on a visible
  ;; phase -- still must not nag.
  (is (= false (reload-reminder-visible? 0 1 5 0.0 0.0 0.0 30))
      "single-round mag (BFG) never shows the periodic reminder"))

(deftest test-reload-reminder-shows-on-low-mag-fraction
  ;; Pistol mag-size 10, 2 rounds left (20% <= 30% threshold), reserve
  ;; spare, not reloading, clock inside the 0.5s visible window.
  (is (= true (reload-reminder-visible? 2 10 30 0.0 0.0 0.0 30))
      "pistol at low mag fraction shows the reminder"))

(deftest test-reload-reminder-arms-at-exact-threshold
  ;; mag=3, mag-size=10 -> frac exactly 0.3 == reload-reminder-frac.
  ;; The `<=` compare must arm here (locks boundary intent).
  (is (= true (reload-reminder-visible? 3 10 30 0.0 0.0 0.0 30))
      "exactly 30% mag fraction arms the reminder (<= threshold)"))

(deftest test-reload-reminder-hidden-on-full-mag
  (is (= false (reload-reminder-visible? 9 10 30 0.0 0.0 0.0 30))
      "near-full mag (90%) does not nag"))

(deftest test-reload-reminder-suppressed-while-reloading
  (is (= false (reload-reminder-visible? 0 10 30 1.0 0.0 0.0 30))
      "active reload cooldown suppresses the nag"))

(deftest test-reload-reminder-suppressed-when-reserve-dry
  (is (= false (reload-reminder-visible? 1 10 0 0.0 0.0 0.0 30))
      "no reserve -> a reload would no-op -> no nag"))

(deftest test-reload-reminder-suppressed-during-empty-click
  (is (= false (reload-reminder-visible? 0 10 30 0.0 0.5 0.0 30))
      "dry-fire CLICK on screen suppresses the nag so prompts don't stack"))

(deftest test-reload-reminder-steady-regardless-of-clock
  ;; Calm 3D view: the nag is held steady while armed - the old game-time
  ;; on/off blink cadence was dropped, so it stays visible at any clock
  ;; phase (here game-time 0.6, which used to blink it off).
  (is (= true (reload-reminder-visible? 0 10 30 0.0 0.0 0.6 30))
      "reminder is steady (no cadence gate) while the mag is near-empty"))

(deftest test-reload-reminder-needs-min-viewport-height
  (is (= false (reload-reminder-visible? 0 10 30 0.0 0.0 0.0 8))
      "tiny viewport (<9 rows) suppresses the reminder"))

(deftest test-direction-char-cardinal
  (is (= "→" (direction-char 0.0)))
  (is (= "↓" (direction-char (/ php/M_PI 2.0))))
  (is (= "←" (direction-char php/M_PI)))
  (is (= "↑" (direction-char (* php/M_PI 1.5)))))

(deftest test-direction-char-diagonal
  (is (= "↘" (direction-char (/ php/M_PI 4.0))))
  (is (= "↙" (direction-char (* php/M_PI 0.75))))
  (is (= "↖" (direction-char (* php/M_PI 1.25))))
  (is (= "↗" (direction-char (* php/M_PI 1.75)))))

(deftest test-direction-char-wraps-negatives-and-overshoots
  ;; Whatever the input rotation, the marker snaps to one of 8 arrows.
  (is (= "→" (direction-char (* 4.0 php/M_PI))))
  (is (= "←" (direction-char (- 0.0 php/M_PI)))))

(deftest test-project-enemy-dead-ahead
  (let [proj (project-enemy {:x 5.0 :y 3.0 :alive true}
                            {:x 2.0 :y 3.0 :angle 0.0}
                            80)]
    ;; Enemy 3 units east, player facing east: should project on screen
    ;; right at viewport centre column.
    (is (= 40 (:col proj)))
    ;; Fish-eye corrected distance is the raw distance because the
    ;; relative angle is zero.
    (is (< (php/abs (- (:dist proj) 3.0)) 0.0001))
    (is (>= (:half-width proj) 1))))

(deftest test-project-enemy-behind-player-returns-nil
  ;; Enemy west of an east-facing player is off-camera.
  (let [proj (project-enemy {:x 1.0 :y 3.0 :alive true}
                            {:x 5.0 :y 3.0 :angle 0.0}
                            80)]
    (is (= nil proj))))

(deftest test-project-enemy-off-to-the-side
  ;; Enemy 45° to the right of facing. Projects to the right of centre.
  (let [proj (project-enemy {:x 4.0 :y 4.0 :alive true}
                            {:x 3.0 :y 3.0 :angle 0.0}
                            80)]
    (is (> (:col proj) 40))))

;; ---------------------------------------------------------------------
;; Enemy floor anchoring (#234): each sprite shifts vertically by the
;; projection of its CELL floor height (`floor-offset-rows`), so a monster
;; standing on a raised platform rises to stand on it instead of floating
;; at the horizon. fz=0 (every flat-world cell) -> offset exactly 0 ->
;; byte-identical to the pre-#234 renderer (the golden frame guard in
;; render-cache-test asserts the bytes themselves).
;; ---------------------------------------------------------------------

(deftest test-floor-offset-zero-on-flat-floor
  ;; The critical byte-identity invariant: a cell at floor height 0
  ;; projects to a 0-row shift at ANY distance. `intval(0 * x) == 0`.
  (is (= 0 (floor-offset-rows proj-dist 0.0 1.0)))
  (is (= 0 (floor-offset-rows proj-dist 0.0 3.0)))
  (is (= 0 (floor-offset-rows proj-dist 0.0 12.0))))

(deftest test-floor-offset-positive-when-raised
  ;; A cell above ground (fz>0) shifts the sprite UP by a POSITIVE row
  ;; count (callers subtract it from the top/bottom rows, so a positive
  ;; value moves the sprite toward row 0).
  (is (php/> (floor-offset-rows proj-dist 0.5 3.0) 0))
  (is (php/> (floor-offset-rows proj-dist 1.0 3.0) 0)))

(deftest test-floor-offset-grows-with-height
  ;; Twice the floor height -> twice the projected shift (it is linear in
  ;; fz). A taller platform pushes the sprite further up.
  (let [d 3.0]
    (is (php/> (floor-offset-rows proj-dist 1.0 d)
               (floor-offset-rows proj-dist 0.5 d))
        "taller floor -> larger up-shift")
    (is (= (floor-offset-rows proj-dist 1.0 d)
           (php/intval (wall-px proj-dist d)))
        "fz=1 offset is exactly one wall-px (round-trips wall-px)")))

(deftest test-floor-offset-shrinks-with-distance
  ;; The same raised floor projects to a smaller shift the farther the
  ;; enemy is (perspective falloff via wall-px's distance divisor).
  (is (php/> (floor-offset-rows proj-dist 1.0 2.0)
             (floor-offset-rows proj-dist 1.0 8.0))
      "a distant platform shifts the sprite less than a near one"))

(defn- floor-pgrid-for
  ;; Build a flat (all-zero) n×n float[][] floor grid - the same shape /
  ;; PHP-array twin new-world stamps as `:floor-pgrid` (#232) - then raise
  ;; cell (x,y) to height `h`. The row is read then written back (PHP
  ;; nested-array value semantics, the closure array-copy gotcha) so the
  ;; stamp lands on the grid rather than a temporary copy.
  [^int n ^int x ^int y ^float h]
  (let [fpg (php/array)]
    (loop [yy 0]
      (when (php/< yy n)
        (let [row (php/array)]
          (loop [xx 0]
            (when (php/< xx n)
              (php/aset row xx 0.0)
              (recur (php/+ xx 1))))
          (php/aset fpg yy row))
        (recur (php/+ yy 1))))
    (let [row (php/aget fpg y)]
      (php/aset row x (php/* 1.0 h))
      (php/aset fpg y row))
    fpg))

(deftest test-project-enemy-flat-cell-zero-offset
  ;; An enemy on a flat cell (fz=0) carries :floor-offset 0 -> the zone
  ;; pass subtracts nothing -> identical position to the no-pgrid path.
  (let [fpg  (floor-pgrid-for 5 2 2 0.0)
        proj (project-enemy-pd proj-dist {:x 2.5 :y 2.5 :alive true}
                               {:x 1.5 :y 2.5 :angle 0.0} 80 fpg)]
    (is (= 0 (:floor-offset proj)) "flat cell -> no vertical shift")))

(deftest test-project-enemy-no-pgrid-zero-offset
  ;; Back-compat: a projection with no floor grid (legacy callers / world
  ;; built before #232) defaults to a 0 offset, never nil.
  (let [proj (project-enemy-pd proj-dist {:x 2.5 :y 2.5 :alive true}
                               {:x 1.5 :y 2.5 :angle 0.0} 80 nil)]
    (is (= 0 (:floor-offset proj)) "missing floor grid -> no vertical shift")))

(deftest test-project-enemy-raised-cell-shifts-up
  ;; Same enemy, same pose: raising its CELL floor gives a positive
  ;; :floor-offset (sprite rises) while :col and :dist are untouched (the
  ;; horizontal projection is independent of floor height).
  (let [enemy  {:x 2.5 :y 2.5 :alive true}
        player {:x 1.5 :y 2.5 :angle 0.0}
        flat   (project-enemy-pd proj-dist enemy player 80
                                 (floor-pgrid-for 5 2 2 0.0))
        raised (project-enemy-pd proj-dist enemy player 80
                                 (floor-pgrid-for 5 2 2 0.5))]
    (is (= 0 (:floor-offset flat)))
    (is (php/> (:floor-offset raised) 0) "raised cell -> sprite shifts up")
    (is (= (:col flat) (:col raised)) "column is unchanged by floor height")
    (is (= (:dist flat) (:dist raised)) "distance is unchanged by floor height")))

(defn- enemy-top-row
  ;; The pre-#297 horizon-centred top row for a projection in a scene `svh`
  ;; rows tall with no pitch: `(svh - h)/2 - floor-offset` (issue #234).
  ;; NOTE: the renderer now anchors by the FEET (`sprite-feet-row`, #297)
  ;; instead; this helper is retained only to pin the legacy `:floor-offset`
  ;; field's monotonicity (it still rises with cell height), not the live
  ;; on-screen row. See projection-test `sprite-feet-row-*` for the anchor.
  [proj ^int svh]
  (let [d (:dist proj)
        h (sprite-h-pd proj-dist svh d (or (:scale proj) 1.0))]
    (php/- (php/+ (php/intdiv (php/- svh h) 2) 0)
           (or (:floor-offset proj) 0))))

(deftest test-enemy-on-raised-cell-projects-higher
  ;; The render-level proof: an enemy standing on a raised cell projects
  ;; to a SMALLER (higher on screen) top row than the same enemy on flat
  ;; ground, while the flat top row equals the pre-#234 center exactly.
  (let [enemy  {:x 2.5 :y 2.5 :alive true}
        player {:x 1.5 :y 2.5 :angle 0.0}
        svh    30
        flat   (project-enemy-pd proj-dist enemy player 80
                                 (floor-pgrid-for 5 2 2 0.0))
        raised (project-enemy-pd proj-dist enemy player 80
                                 (floor-pgrid-for 5 2 2 0.5))
        flat-h (sprite-h-pd proj-dist svh (:dist flat) 1.0)]
    (is (php/< (enemy-top-row raised svh) (enemy-top-row flat svh))
        "enemy on a platform draws higher than on flat ground")
    (is (= (php/intdiv (php/- svh flat-h) 2) (enemy-top-row flat svh))
        "flat-ground top row is the unchanged horizon-centred value")))

;; ---------------------------------------------------------------------
;; enemy-front-visible-at?: per-column "front-most enemy" gate shared by
;; the grounding shadow (issue #86) and the face / eyes glyph (issue
;; #91). Only the front-most enemy at a column draws its overlay;
;; farther ones and wall-occluded ones skip, so a rear shadow / face
;; can't bleed over a nearer sprite.
;; ---------------------------------------------------------------------

(deftest test-enemy-shadow-hidden-behind-wall
  (let [dists  (php/array 3.0)
        edists (php/array 4.0)]
    (is (= false (enemy-front-visible-at? 6.0 0 dists edists))
        "behind a closer wall -> no shadow")))

(deftest test-enemy-shadow-front-enemy-grounds
  ;; This enemy IS the nearest at the column (d == edists). Inclusive
  ;; compare keeps its own shadow.
  (let [dists  (php/array 10.0)
        edists (php/array 4.0)]
    (is (= true (enemy-front-visible-at? 4.0 0 dists edists))
        "front enemy grounds its shadow")))

(deftest test-enemy-shadow-rear-enemy-skips
  ;; A farther enemy sharing the column with a nearer one (edists=4):
  ;; its shadow must NOT draw (would bleed over the front sprite).
  (let [dists  (php/array 10.0)
        edists (php/array 4.0)]
    (is (= false (enemy-front-visible-at? 6.0 0 dists edists))
        "rear enemy's shadow is suppressed")))

(deftest test-enemy-shadow-no-enemy-recorded-at-column
  ;; edists empty at this column (no sprite painted there) -> the
  ;; enemy's own shadow may draw, still wall-gated.
  (let [dists  (php/array 10.0)
        edists (php/array)]
    (is (= true (enemy-front-visible-at? 4.0 0 dists edists))
        "no nearer enemy -> shadow allowed")))

;; ---------------------------------------------------------------------
;; help-menu-rows borders: every interior row of the H info overlay is
;; padded to the same width so the right `│` border lines up. A row built
;; without help-pad (or a miscounted glyph) would render a ragged border.
;; This guards every section: RUN, PLAYER, WEAPONS, COMPASS, CONTROLS
;; (incl. the F5/F9 quick save/load line).
;; ---------------------------------------------------------------------

(defn- visible-width [s]
  ;; Strip CSI SGR escapes, then count display columns (mb, not bytes):
  ;; matches how render's help-pad measures interior width.
  (php/mb_strlen (php/preg_replace "/\\x1b\\[[\\d;]*m/" "" s)))

(defn- expected-frame-width [vw]
  ;; Mirror help-menu-string: interior w clamped to [36, 44], plus the
  ;; two side borders.
  (php/+ 2 (php/max 36 (php/min 44 (php/- vw 2)))))

(defn- all-rows-aligned? [vw vh stats]
  (let [rows (help-menu-rows vw vh stats)
        want (expected-frame-width vw)]
    (every? (fn [r] (= want (visible-width r))) rows)))

(deftest test-help-menu-borders-align-default-stats
  ;; vh=60 is tall enough that the greedy fit keeps every section,
  ;; including CONTROLS (the F5/F9 + h/ESC rows).
  (is (all-rows-aligned? 80 60 {})
      "all help-menu rows share one width with every section visible"))

(deftest test-help-menu-borders-align-narrow
  ;; vw=44 -> interior clamps to 42 (below the 44 default). The widest
  ;; row (rocket launcher) still fits, so borders stay aligned. Terminals
  ;; narrower than the weapon table are the documented clip zone.
  (is (all-rows-aligned? 44 40 {})
      "borders still align when the menu clamps below its default width"))

(deftest test-help-menu-borders-align-with-buffs-and-keys
  ;; Populate the coloured keys/buffs rows + an active non-pistol weapon
  ;; so the SGR-stripping pad math is exercised on every dynamic row.
  (is (all-rows-aligned? 80 40
                         {:held-keys #{:blue :red}
                          :berserk-secs 12.0
                          :invuln-secs 4.0
                          :backpack? true
                          :owned-weapons #{:pistol :shotgun :chaingun}
                          :weapon :shotgun})
      "coloured keys/buffs + weapon rows stay border-aligned"))

(deftest test-help-menu-borders-align-short-viewport
  ;; Short vh drops CONTROLS then COMPASS; the surviving rows must still
  ;; align (closer row is always appended).
  (is (all-rows-aligned? 80 14 {})
      "section-dropping on a short terminal keeps borders aligned"))

(deftest test-help-menu-lists-save-load
  ;; The save/load feature must be discoverable in the info menu, not
  ;; only via the post-press HUD flash.
  (let [rows (help-menu-rows 80 60 {})]
    (is (some (fn [r] (php/!== false (php/strpos r "F5 / F9"))) rows)
        "H info menu lists F5 / F9 quick save / load")))
