(ns phel-doom.modules.engine)

(def fov (/ php/M_PI 3.0))
(def max-depth 16.0)
(def step 0.2)

(defn- pwall?
  "Wall test against a PHP-native nested array. OOB returns nil from
   aget, which is not = 1, so the ray simply runs to max-depth and stops."
  [pgrid x y]
  (= 1 (aget pgrid y x)))

(defn cast-ray
  "March a ray from (px, py) at the given angle until it hits a wall or
   `max-depth`. Uses incremental position update (no per-step multiply)
   and a PHP-native grid lookup."
  {:export true}
  [pgrid px py angle]
  (let [dx (* (php/cos angle) step)
        dy (* (php/sin angle) step)]
    (loop [dist 0.0 x px y py]
      (cond
        (>= dist max-depth)                          max-depth
        (pwall? pgrid (php/intval x) (php/intval y)) dist
        :else                                        (recur (+ dist step) (+ x dx) (+ y dy))))))

(defn cast-frame
  "Cast `width` rays across the player's FOV. Returns a sequence of
   {:dist d :angle a} entries, one per screen column. `:dist` is fish-eye
   corrected so straight walls render straight."
  {:export true}
  [world width]
  (let [pgrid               (:pgrid world)
        {:keys [x y angle]} (:player world)
        half-fov            (/ fov 2.0)]
    (map (fn [col]
           (let [ray-angle (+ angle (- (* fov (/ col width)) half-fov))
                 corrected (* (cast-ray pgrid x y ray-angle)
                              (php/cos (- ray-angle angle)))]
             {:dist corrected :angle ray-angle}))
         (range 0 width))))
