(ns phel-doom-tests.io.render-fixtures
  (:require phel-doom.core.rng :as rng)
  (:require phel-doom.core.level :refer [build-world])
  (:require phel-doom.core.engine :refer [mark-visible-cells]))

;; ---------------------------------------------------------------------
;; The scene the render golden suites pin, shared by render-cache-test
;; (default emit path) and render-flags-test (the non-default paths).
;;
;; Both must render the SAME world and stats or the comparison stops
;; being apples-to-apples - and since each file pins its own hashes, two
;; drifting copies would leave both suites green while quietly testing
;; different scenes.
;;
;; build-world draws from the global rng, so this snapshots the
;; generator, seeds, builds, and restores it: reproducible on its own and
;; invisible to every other namespace regardless of test discovery order
;; (which differs between macOS and Linux).
;;
;; No deftest here on purpose - this namespace contributes fixtures.
;; ---------------------------------------------------------------------

(def world
  (let [prev @rng/state]
    (rng/seed! 1337)
    (let [w (mark-visible-cells (build-world 1 5 0 :normal #{:pistol}))]
      (reset! rng/state prev)
      w)))

(def stats
  {:game-time 1.0 :debug? false :iframes 0.0 :lives 5 :max-lives 5
   :armor 0 :kills 0 :level 1 :weapon :pistol :weapon-name "pistol"
   :mag 10 :mag-size 10 :ammo-reserve 50 :stamina 100 :max-stamina 100
   :owned-weapons #{:pistol} :difficulty :normal :held-keys #{}
   :fire-anim-duration 0.1 :reload-duration 1.0
   :secrets-total 0 :secrets-found 0 :backpack-level 0})
