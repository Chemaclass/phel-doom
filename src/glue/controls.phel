(ns phel-doom.glue.controls
  (:require phel.string :as str))

;; ---------------------------------------------------------------------
;; Controls: drained terminal bytes -> direction counters + rising-edge
;; one-shots. This module is intentionally pure: it doesn't touch the
;; terminal (input.phel does that), it just consumes the byte string
;; drain-keys returns.
;; ---------------------------------------------------------------------

;; =====================================================================
;; § Directional input
;; =====================================================================

(def move-hold-frames
  "Frames a movement direction (W/S/A/D) stays active
   after each input byte. Sized to bridge the OS initial-key-repeat
   delay (~250-500ms on macOS/Linux): without this, the first byte
   arrives, motion runs for a few frames, then stops dead until the
   OS finally starts auto-repeating. 18 frames (~300ms at 60fps)
   covers the typical initial-delay so a press reads as one smooth
   walk, at the cost of ~300ms of post-release glide. Kitty-protocol
   release events (when supported) override this with an instant
   clear."
  18)

(def turn-hold-frames
  "Frames a turn direction (←/→) stays active after each input byte.
   Short, so rotation halts within ~50ms of releasing the arrow. The
   OS terminal sends no key-release event; this counter is the only
   way the game can tell the player let go."
  3)

(def sprint-hold-frames
  "Frames the :sprint slot stays warm after a SHIFT-mod or 'x' byte.
   Short (~50ms) because there is no explicit SHIFT-release signal
   on the kitty path — sprint MUST decay fast enough that releasing
   SHIFT while still walking forward stops the speed boost (and the
   stamina drain) within a frame or two. Without this the 18-frame
   move-hold-frames bridge would leave sprint hot for ~300ms after
   release, which the HUD bar exposes as a phantom drain."
  3)

(def pitch-hold-frames
  "Frames a look up/down direction (↑/↓ arrows) stays active after each
   input byte. Short, like turn-hold-frames, so the camera pitch halts
   within ~50ms of releasing the key (no terminal key-release on the
   legacy path) instead of drifting on for the full move-hold bridge."
  3)

(def key->slot
  "Map a single-byte input to the direction-counter slot it activates.
   Arrow-key escape sequences are normalised to ^ _ < > before lookup:
   ↑/↓ (^/_) shear the camera look up/down (pitch), ←/→ (</>) turn, and
   forward/back are WASD's w/s. `x` arms the sprint slot — the legacy /
   non-kitty fallback for terminals that don't expose SHIFT modifier
   bits via CSI-u."
  {"w" :fwd
   "s" :back
   "^" :pitch-up
   "_" :pitch-down
   "<" :turn-left
   ">" :turn-right
   "a" :strafe-left
   "d" :strafe-right
   "x" :sprint})

(def shift-key->slot
  "Capital-letter equivalents of `key->slot` movement keys. In cooked
   raw-mode terminals without kitty CSI-u support (Terminal.app, plain
   xterm, GNOME Terminal) holding SHIFT just uppercases the byte, so
   SHIFT+W = 'W' (87), SHIFT+A = 'A' (65), etc. Mapping these to the
   matching direction slot AND :sprint makes SHIFT+WASD sprint work
   everywhere, not just on kitty-protocol terminals."
  {"W" :fwd
   "S" :back
   "A" :strafe-left
   "D" :strafe-right})

(def turn-slots
  "Slots that use turn-hold-frames instead of move-hold-frames."
  #{:turn-left :turn-right})

(def pitch-slots
  "Slots that use pitch-hold-frames (look up/down) instead of
   move-hold-frames."
  #{:pitch-up :pitch-down})

(defn- hold-frames-for [slot]
  (cond
    (turn-slots slot)  turn-hold-frames
    (pitch-slots slot) pitch-hold-frames
    (= slot :sprint)   sprint-hold-frames
    :else              move-hold-frames))

(defn refresh-move
  "If `byte` maps to a direction slot, refresh that slot's counter on
   `world`. Capital W/A/S/D additionally refresh `:sprint` so SHIFT+WASD
   sprints on terminals without kitty CSI-u (Terminal.app, xterm).
   Anything else (unmapped bytes) leaves the world untouched."
  [world byte]
  (let [slot       (get key->slot byte)
        shift-slot (get shift-key->slot byte)]
    (cond
      (some? shift-slot)
      (-> world
          (assoc-in [:moves shift-slot] (hold-frames-for shift-slot))
          (assoc-in [:moves :sprint]    (hold-frames-for :sprint)))

      (some? slot)
      (assoc-in world [:moves slot] (hold-frames-for slot))

      :else              world)))

(def arrow-escape-keys
  "Search-side PHP array for php/str_replace: arrow-key escapes in both
   the CSI (`\\e[A`) and SS3 application-cursor-key (`\\eOA`) forms, so
   in-game turning works whether or not the terminal is in app-cursor
   mode (tmux / the alternate screen flip it on a lot)."
  (php/array "\e[A" "\e[B" "\e[D" "\e[C"
             "\eOA" "\eOB" "\eOD" "\eOC"))

(def arrow-escape-replacements
  "Replace-side PHP array for php/str_replace: single-byte stand-ins
   for ↑↓←→ so refresh-from-keys can walk the input one byte at a time.
   Both arrow encodings collapse to the same four stand-ins."
  (php/array "^"    "_"    "<"    ">"
             "^"    "_"    "<"    ">"))

(defn- normalise-arrows [keys]
  (php/str_replace arrow-escape-keys arrow-escape-replacements keys))

;; ---------------------------------------------------------------------
;; Kitty keyboard protocol parsing.
;;
;; When init-input! sent CSI >3u the terminal (if it supports the
;; protocol) replaces plain key bytes with CSI-u events of the form:
;;     ESC [ <code> [;<mods>[:<event>]] u
;; where <event> is 1 (press), 2 (repeat), or 3 (release). This lets
;; us track real release transitions instead of guessing from absence
;; of input — which is the whole point of the opt-in.
;;
;; The keycode for ASCII keys is the codepoint of the lowercase
;; letter (w=119, a=97, s=115, d=100). Arrow keys are CSI ~ sequences
;; under the legacy protocol but become regular CSI u codes here:
;;     left  57417, right 57415... actually kitty assigns 1-based
;; functional codes. To keep parsing simple we only recognise the
;; ASCII direction keys (w/a/s/d) — players using ↑↓←→ still get
;; legacy CSI sequences via the arrow-normalisation path above, which
;; works regardless of protocol support.
;; ---------------------------------------------------------------------

(def ascii->slot
  "ASCII codepoint -> direction-counter slot. WASD movement, ←→ turn
   (kitty reports left-arrow as 57351, right as 57349), 'x' (120) as the
   legacy sprint key — all work under kitty too without needing the SHIFT
   modifier bit. Look up/down (pitch) rides the ↑/↓ arrows via
   `arrow-letter->slot`, not a CSI-u codepoint here."
  {119 :fwd
   115 :back
   97 :strafe-left
   100 :strafe-right
   120 :sprint
   57351 :turn-left
   57349 :turn-right})

(defn- clear-slot
  "Force a counter to 0 (immediate stop)."
  [world slot]
  (assoc-in world [:moves slot] 0))

(defn- press-slot
  "Press / repeat event: set the counter to the slot's normal hold."
  [world slot]
  (assoc-in world [:moves slot] (hold-frames-for slot)))

(def movement-slots
  "Slots whose press counts as 'the player is trying to walk' for
   SHIFT-modifier sprint arming. Turn slots are excluded — sprint is
   a translation modifier, not a rotation one (issue #35 design)."
  #{:fwd :back :strafe-left :strafe-right})

(defn- shift-mods?
  "Kitty encodes the mod field as `bits + 1`, so plain SHIFT alone
   arrives as mods=2 (bits=1, bit 0 = SHIFT). 0 / missing means no
   mods. Returns true when the SHIFT bit is set."
  [mods]
  (and (pos? mods)
       (= (php/intval (php/% (php/- mods 1) 2)) 1)))

(defn- handle-kitty-event
  "Apply one parsed kitty event [code event-type mods] to `world`.
   Press + repeat refresh the slot's hold; release clears the slot
   to 0 so the player stops the instant they let go. When the event
   is press/repeat AND the SHIFT modifier bit is set AND the slot is
   a movement slot, also refresh `:sprint` so SHIFT+WASD primes the
   sprint pool (this is the kitty path of the user-picked
   `SHIFT (kitty) + x fallback` binding from issue #35)."
  [world code event-type mods]
  (let [slot (get ascii->slot code)]
    (cond
      (= event-type 3)
      (if (nil? slot) world (clear-slot world slot))

      :else
      (let [w1 (if (nil? slot) world (press-slot world slot))]
        (if (and (shift-mods? mods) (contains? movement-slots slot))
          (press-slot w1 :sprint)
          w1)))))

(defn- kitty-mods
  "Decode an optional kitty mods capture: empty / nil means no modifiers (0).
   Kitty encodes modifiers as a bitfield + 1; bit 0 = SHIFT (sprint arming)."
  [raw]
  (if (or (nil? raw) (= raw "")) 0 (php/intval raw)))

(defn- kitty-event
  "Decode an optional kitty event-type capture: empty / nil means a press (1).
   Event types: 1 = press, 2 = repeat, 3 = release."
  [raw]
  (if (or (nil? raw) (= raw "")) 1 (php/intval raw)))

(defn- apply-kitty-events
  "Scan `keys` for kitty CSI-u sequences and fold them into `world`.
   Returns [world-after-events leftover-string]; leftover-string is
   what's left after stripping recognised CSI-u tokens so the legacy
   byte path can handle anything that wasn't a kitty event."
  [world keys]
  (let [matches (php/array)
        ;; Regex: ESC [ <code> ( ; mods ( : event )? )? u
        ;; - code  is digits
        ;; - mods  optional digits after the first ';' (kitty encodes
        ;;         as bits+1; bit 0 = SHIFT — used by sprint arming)
        ;; - event optional digits after ':' (1=press 2=repeat 3=release)
        re      "/\\x1b\\[(\\d+)(?:;(\\d+)(?::(\\d+))?)?u/"]
    (php/preg_match_all re keys matches)
    (let [codes-arr (php/aget matches 1)
          mods-arr  (php/aget matches 2)
          ev-arr    (php/aget matches 3)
          n         (php/count codes-arr)]
      (loop [i 0 w world]
        (if (php/>= i n)
          [w (php/preg_replace re "" keys)]
          (let [code  (php/intval (php/aget codes-arr i))
                mods  (kitty-mods (php/aget mods-arr i))
                event (kitty-event (php/aget ev-arr i))]
            (recur (php/+ i 1) (handle-kitty-event w code event mods))))))))

(def arrow-letter->slot
  "Kitty-enhanced arrow CSI sequences (`\\e[1;<mods>(:<event>)?<letter>`)
   keep the legacy letter suffix instead of becoming CSI-u tokens.
   Letter codes: A=up B=down C=right D=left — ↑/↓ look up/down (pitch),
   ←/→ turn."
  {"A" :pitch-up
   "B" :pitch-down
   "D" :turn-left
   "C" :turn-right})

(defn- apply-kitty-arrow-events
  "Strip kitty-enhanced arrow sequences from `keys` and fold them
   into `world`. Pattern: ESC [ 1 [;mods[:event]] <A|B|C|D>. Event 3
   = release (clear slot); anything else = press/repeat (refresh hold).
   When the mods bitfield has SHIFT set AND the slot is a movement
   slot, also refresh `:sprint` so SHIFT+arrow keeps the player
   sprinting (mirrors the SHIFT+WASD path in apply-kitty-events).
   Plain legacy arrows (\\e[A etc.) are untouched here and handled
   downstream by normalise-arrows. Returns [world leftover]."
  [world keys]
  (let [matches (php/array)
        re      "/\\x1b\\[1(?:;(\\d+)(?::(\\d+))?)?([ABCD])/"]
    (php/preg_match_all re keys matches)
    (let [mods-arr (php/aget matches 1)
          ev-arr   (php/aget matches 2)
          letters  (php/aget matches 3)
          n        (php/count letters)]
      (loop [i 0 w world]
        (if (php/>= i n)
          [w (php/preg_replace re "" keys)]
          (let [letter (php/aget letters i)
                mods   (kitty-mods (php/aget mods-arr i))
                event  (kitty-event (php/aget ev-arr i))
                slot   (get arrow-letter->slot letter)]
            (recur (php/+ i 1)
                   (cond
                     (nil? slot) w
                     (= event 3) (clear-slot w slot)
                     :else
                     (let [w1 (press-slot w slot)]
                       (if (and (shift-mods? mods) (contains? movement-slots slot))
                         (press-slot w1 :sprint)
                         w1))))))))))

(def mouse-report-re
  "SGR-extended mouse report (issue #246): ESC [ < b ; Cx ; Cy (M|m).
   Stripped from the drain string before the movement byte-walk so the
   `<` (turn-left) / `>` (turn-right) / digit bytes inside a report can
   never be mistaken for keyboard movement. controls/mouse-look reads the
   same reports separately for the look delta."
  "/\\x1b\\[<\\d+;\\d+;\\d+[Mm]/")

(defn- strip-mouse-reports
  "Remove every SGR mouse report from `keys` so the movement / edge
   parsers below see only keyboard bytes. Pure string scrub."
  [keys]
  (php/preg_replace mouse-report-re "" keys))

(defn refresh-from-keys
  "Fold every input byte into `world`. Four-stage parse: strip SGR mouse
   reports (#246, handled separately by mouse-look) → kitty CSI-u events
   (WASD with press/repeat/release) → kitty enhanced arrows
   (\\e[1;m:eD with same events) → legacy normalise + single-byte
   refresh. Terminals supporting any subset of kitty fall through
   gracefully to the legacy path."
  [world keys]
  (let [no-mouse       (strip-mouse-reports keys)
        [w1 leftover1] (apply-kitty-events world no-mouse)
        [w2 leftover2] (apply-kitty-arrow-events w1 leftover1)]
    (let [normalised (normalise-arrows leftover2)
          n          (php/strlen normalised)]
      (loop [i 0 w w2]
        (if (php/>= i n)
          w
          (recur (php/+ i 1)
                 (refresh-move w (php/substr normalised i 1))))))))

;; =====================================================================
;; § Mouse look (issue #246)
;;
;; init-input! (io) enables xterm SGR-extended mouse reporting
;; (`\e[?1006h`) + any-motion tracking (`\e[?1003h`). The terminal then
;; reports pointer events as:
;;     ESC [ < b ; Cx ; Cy ( M | m )
;; where M = button press / motion, m = button release, (Cx, Cy) are
;; 1-based ABSOLUTE cell coordinates, and `b` is a bit-packed button +
;; modifier code:
;;     bits 0-1 : button (0 = left, 1 = middle, 2 = right)
;;     bit  2   : SHIFT      bit 3 : META/ALT     bit 4 : CTRL
;;     bit  5   : motion (a drag / bare-move report, `b & 32`)
;;     bit  6   : wheel      (`b & 64`)
;;
;; Mouselook caveat: a terminal can only report ABSOLUTE cell coords and
;; offers no pointer lock / warp, so we derive yaw + pitch from the DELTA
;; between consecutive position reports, summed across the frame. The
;; pointer saturates at the screen edges (coords clamp to 1..cols /
;; 1..rows), so a continuous drag into an edge yields a zero delta there
;; - the terminal equivalent of running the mouse off the pad. This is a
;; best-effort approximation of true mouselook, not a perfect one.
;;
;; This stays PURE: it consumes the drained byte string + the previous
;; pointer position and returns the per-frame angular delta + fire
;; intent; io/input owns the escape emission + STDIN read.
;; =====================================================================

(def mouse-yaw-scale
  "Radians of yaw per one cell of horizontal pointer travel, before the
   player's sensitivity multiplier. Sized so a brisk flick across a
   ~120-column terminal sweeps roughly a half turn at sensitivity 1.0."
  0.012)

(def mouse-pitch-scale
  "Look up/down `:pitch` fraction per one cell of vertical pointer
   travel, before sensitivity. Smaller than the yaw scale: the pitch
   axis is a clamped fraction in [-1, 1] (state/clamp-pitch), so a few
   cells of vertical travel already covers a useful slice of the range."
  0.02)

(def mouse-motion-bit
  "Bit 5 of the SGR button code: set on a motion (drag / bare-move)
   report, clear on a discrete press / release."
  32)

(def mouse-wheel-bit
  "Bit 6 of the SGR button code: set on a scroll-wheel report. Wheel
   events carry no useful look delta, so they are skipped."
  64)

(defn- mouse-button
  "Low two bits of the SGR button code = which button (0 = left)."
  [b]
  (php/% b 4))

(defn- bit-set?
  "True when the bit of weight `weight` (a power of two) is set in `b`.
   Phel/PHP has no portable bitwise-and helper handy here, so extract the
   bit via integer divide + mod 2 instead of `b & weight`."
  [b weight]
  (php/=== 1 (php/% (php/intval (php// b weight)) 2)))

(defn- mouse-motion? [b]
  (bit-set? b mouse-motion-bit))

(defn- mouse-wheel? [b]
  (bit-set? b mouse-wheel-bit))

(defn- left-press?
  "True for a left-button (button 0) PRESS report: `final` is the M
   terminator (m = release) and the code is neither a wheel tick nor a
   pure motion report."
  [b final]
  (and (= final "M")
       (php/=== 0 (mouse-button b))
       (not (mouse-wheel? b))
       (not (mouse-motion? b))))

(defn- left-down?
  "True while the left button is engaged this report: either a left
   press OR a left-button drag (motion bit set with button 0). Used for
   held-fire on auto-fire weapons - the closest a terminal gets to a
   continuously-held trigger, since it only emits drag reports while the
   button stays down during motion."
  [b final]
  (and (= final "M")
       (php/=== 0 (mouse-button b))
       (not (mouse-wheel? b))))

(defn- fold-mouse-event
  "Fold one parsed SGR event [b x y final] into the running accumulator
   `{:dx :dy :fire? :held? :pos}`. Position reports advance the summed
   pointer delta against the last-seen position; a fresh left press sets
   :fire?; a left press / drag sets :held?. `:pos` always trails the most
   recent coordinate so the next frame measures from where the pointer
   actually is. Two no-delta cases:
   - `:pos` nil (no prior report yet - first ever mouse byte of the
     session): the event only ESTABLISHES the baseline, so the pointer's
     initial absolute position can't be misread as one giant jump.
   - a scroll-WHEEL tick (`mouse-wheel?`): it carries no look intent, so
     its coordinate must not feed the yaw/pitch delta - but `:pos` still
     advances to it so the next real motion measures from the true spot."
  [acc b x y final]
  (let [prev    (:pos acc)
        [dx dy] (if (or (nil? prev) (mouse-wheel? b))
                  [0 0]
                  [(php/- x (get prev 0)) (php/- y (get prev 1))])]
    {:dx    (php/+ (:dx acc) dx)
     :dy    (php/+ (:dy acc) dy)
     :fire? (or (:fire? acc) (left-press? b final))
     :held? (or (:held? acc) (left-down? b final))
     :pos   [x y]}))

(defn mouse-look
  "Pure SGR-mouse reader for FPS-style mouselook (issue #246). Parses the
   drained byte string `keys` for xterm SGR mouse reports, measures
   pointer travel against `prev-pos` (`[x y]`, the last position the
   previous frame ended on) and returns:

     {:yaw        signed radians to add to the player's :angle this frame
      :pitch      signed fraction to add to the player's :pitch (look up
                  is +, look down is -; clamp via state/clamp-pitch)
      :fire?      true on a fresh left-button press (rising edge - a press
                  report arrives once, so this maps onto the space-fire
                  path directly)
      :fire-held? true while the left button is held / dragged (feeds
                  auto-fire weapons like the :fire-held space path)
      :pos        the pointer position to thread into the next frame}

   `sensitivity` is a positive scalar (1.0 = neutral) multiplied into
   both axes. Motion RIGHT yields +yaw (turn right), motion UP yields
   +pitch (look up) - note terminal rows grow DOWNWARD, so up is a
   DECREASING y, hence the negated dy. No mouse bytes (or a malformed /
   non-mouse sequence such as a kitty CSI-u key event, arrow or F-key)
   produce a zero delta and carry `prev-pos` forward unchanged, so the
   keyboard path is never disturbed.

   Caveat: terminals report ABSOLUTE clamped cell coords with no pointer
   lock, so the delta saturates to zero at the screen edges (see the
   section header). This approximates mouselook within that limit."
  [keys prev-pos ^float sensitivity]
  (let [matches (php/array)
        ;; ESC [ < b ; Cx ; Cy (M|m) — SGR-extended (1006) mouse report.
        re      "/\\x1b\\[<(\\d+);(\\d+);(\\d+)([Mm])/"]
    (php/preg_match_all re keys matches)
    (let [bs     (php/aget matches 1)
          xs     (php/aget matches 2)
          ys     (php/aget matches 3)
          finals (php/aget matches 4)
          n      (php/count bs)]
      (loop [i 0 acc {:dx 0 :dy 0 :fire? false :held? false :pos prev-pos}]
        (if (php/>= i n)
          {:yaw        (php/* (php/* (:dx acc) mouse-yaw-scale) sensitivity)
           ;; Negate dy: screen y grows downward, so an UPWARD flick
           ;; (decreasing y) must read as a positive (look-up) pitch.
           :pitch      (php/* (php/* (php/- 0 (:dy acc)) mouse-pitch-scale) sensitivity)
           :fire?      (:fire? acc)
           :fire-held? (:held? acc)
           :pos        (:pos acc)}
          (recur (php/+ i 1)
                 (fold-mouse-event acc
                                   (php/intval (php/aget bs i))
                                   (php/intval (php/aget xs i))
                                   (php/intval (php/aget ys i))
                                   (php/aget finals i))))))))

;; =====================================================================
;; § Edge detection (one-shot actions)
;; =====================================================================

(def initial-key-snapshot
  "First-frame snapshot — nothing held yet."
  {:m false :sp false :p false :n false :e false :f false :f3 false :r false :h false
   :esc false :k1 false :k2 false :k3 false :k4 false :k5 false :k6 false :k7 false})

(defn- f3-pressed? [keys]
  ;; F3 across terminals: xterm/macOS Terminal/iTerm2 send `\eOR`;
  ;; Linux console + a few others send `\e[13~`. Cover both.
  (or (str/contains? keys "\eOR")
      (str/contains? keys "\e[13~")))

(defn- f5-pressed? [keys]
  ;; F5 = `\e[15~` on xterm / iTerm2 / Terminal.app / Linux console.
  (str/contains? keys "\e[15~"))

(defn- f9-pressed? [keys]
  ;; F9 = `\e[20~`.
  (str/contains? keys "\e[20~"))

(defn- esc-pressed?
  "True when ESC was pressed this frame. Two paths:

   1. Legacy byte stream — terminals without kitty CSI-u send a bare
      `\\x1b` for ESC. We strip every CSI (`\\e[…<final>`) and SS3
      (`\\eO<letter>`) sequence first because arrow keys / F-keys
      embed an ESC byte that must NOT count as an ESC press, then
      check for a bare `\\e` in what's left.

   2. Kitty CSI-u — supporting terminals (kitty, WezTerm, Ghostty,
      iTerm2/Alacritty with the flag) report ESC as keycode 27 wrapped
      `\\e[27u` (with optional `;mods[:event]`). The legacy strip
      would erase that whole sequence, so we explicitly preg_match
      kitty's press-only form first. Same `:1` / no-`:event` rule as
      `key-pressed?` so repeats (`:2`) / releases (`:3`) don't fire."
  [keys]
  (let [kitty-esc-re "/\\x1b\\[27(?:u|;\\d+(?::1)?u)/"
        re           "/\\x1b(?:\\[[\\d;:<=>?]*[@-~]|O[A-Za-z])/"
        stripped     (php/preg_replace re "" keys)]
    (or (= 1 (php/preg_match kitty-esc-re keys))
        (str/contains? stripped "\e"))))

(defn- enter-pressed?
  "True when ENTER / Return appears in `keys`. Raw mode sends CR (`\\r`),
   some terminals LF (`\\n`); kitty CSI-u wraps Return (code 13) as
   `\\e[13u` (press-only, same `:1`/no-`:event` rule as key-pressed?)."
  [keys]
  (or (str/contains? keys "\r")
      (str/contains? keys "\n")
      (= 1 (php/preg_match "/\\x1b\\[13(?:u|;\\d+(?::1)?u)/" keys))))

(defn- key-pressed?
  "True when the byte `plain` OR its kitty CSI-u PRESS code appears in
   `keys`. Some terminals running with `CSI >3u` enabled wrap every
   key (including plain alphanumerics + digits) as `\\e[<code>u` /
   `\\e[<code>;<mods>u` / `\\e[<code>;<mods>:<event>u` where event
   1=press, 2=repeat, 3=release.

   Two gotchas drive the implementation:
   1. The plain-byte substring check must NOT see inside CSI escapes
      — `\\e[50;1:3u` (release of key-2) contains the bytes '1' and
      '3', which would otherwise falsely match plain '1' and '3'. So
      strip every CSI sequence before doing the plain compare.
   2. The kitty regex matches PRESS events only (no `:event` suffix
      OR `:1`); repeat (`:2`) and release (`:3`) are excluded so a
      held key fires exactly once on its rising edge."
  [keys plain code]
  (let [stripped (php/preg_replace "/\\x1b\\[[\\d;:<=>?]*[@-~]/" "" keys)
        kitty-re (str "/\\x1b\\[" code "(?:u|;\\d+(?::1)?u)/")]
    (or (str/contains? stripped plain)
        (= 1 (php/preg_match kitty-re keys)))))

(defn- arrow-count
  "How many PRESS / REPEAT arrows with final byte `letter` (A=up B=down
   C=right D=left) appear in `keys`. Matches every encoding a terminal
   may send: CSI (`\\e[A`), modified / kitty-enhanced CSI (`\\e[1;2A`,
   `\\e[1;1:2A`), AND the SS3 application-cursor form (`\\eOA`) that many
   terminals + tmux emit in the alternate screen.

   Excludes kitty RELEASE events (`:3`). With report-event-types on
   (`\\e[>3u` in init-input!) a single tap sends a press AND a release;
   counting both moved the settings cursor twice per keypress. The
   optional `(?::[12])?` accepts press (`:1` / none) and repeat (`:2`,
   so a held key still ramps) but not release. Counting (not a bool)
   lets a held key's repeat burst ramp a slider."
  [keys letter]
  (let [m (php/array)]
    (php/preg_match_all (str "/\\x1b(?:\\[[\\d;]*(?::[12])?|O)" letter "/") keys m)))

(defn nav-deltas
  "Net menu-navigation intent in `keys` for the settings page, as
   `{:cursor steps :value steps}` signed integers. Each arrow press
   counts as one step toward its axis, and the WASD equivalents
   (`w`/`s` cursor, `a`/`d` value) count too — so navigation works even
   when a terminal's arrow encoding isn't recognised, and a held key
   (arrow or WASD) ramps via OS key-repeat. Read straight off the drain
   string, no rising-edge snapshot needed."
  [keys]
  (let [up    (php/+ (arrow-count keys "A") (php/substr_count keys "w"))
        down  (php/+ (arrow-count keys "B") (php/substr_count keys "s"))
        left  (php/+ (arrow-count keys "D") (php/substr_count keys "a"))
        right (php/+ (arrow-count keys "C") (php/substr_count keys "d"))]
    {:cursor (php/- down up)
     :value  (php/- right left)}))

(defn key-states
  "Which of the tracked one-shot keys appear in `keys` this frame.
   Codes are ASCII codepoints for the matching lowercase letter /
   digit (m=109, p=112, etc.) so the kitty CSI-u path stays in sync
   with the legacy byte path."
  [keys]
  {:m  (key-pressed? keys "m" 109)
   :sp (key-pressed? keys " " 32)
   :p  (key-pressed? keys "p" 112)
   :n  (key-pressed? keys "n" 110)
   :e  (key-pressed? keys "e" 101)
   :f  (key-pressed? keys "f" 102)
   :f3 (f3-pressed? keys)
   :f5 (f5-pressed? keys)
   :f9 (f9-pressed? keys)
   :r  (key-pressed? keys "r" 114)
   :h  (key-pressed? keys "h" 104)
   :esc (esc-pressed? keys)
   :enter (enter-pressed? keys)
   :k1 (key-pressed? keys "1" 49)
   :k2 (key-pressed? keys "2" 50)
   :k3 (key-pressed? keys "3" 51)
   :k4 (key-pressed? keys "4" 52)
   :k5 (key-pressed? keys "5" 53)
   :k6 (key-pressed? keys "6" 54)
   :k7 (key-pressed? keys "7" 55)})

(defn rising-edges
  "Build the edges map tick consumes — truthy only for keys that just
   turned on relative to the previous snapshot."
  [now prev]
  {:fire           (and (:sp now) (not (:sp prev)))
   ;; Distinct from :fire — true whenever space is in the input
   ;; buffer this frame, regardless of whether prev was held.
   ;; tick-shooting uses this with the active weapon's `:auto-fire?`
   ;; spec flag so auto-fire weapons (pistol, chaingun) spray while
   ;; the trigger is held, and single-action weapons (shotgun)
   ;; still need one press per shot.
   :fire-held      (boolean (:sp now))
   ;; Menu CONFIRM / select (#225): space OR Enter, rising-edge so a held
   ;; key (fire from gameplay, or Enter auto-repeat) can't auto-select on
   ;; pause-open or oscillate menu<->settings. The pause menu + the
   ;; settings sub-page back-out key off this.
   :confirm        (and (or (:sp now)  (:enter now))
                        (not (or (:sp prev) (:enter prev))))
   :toggle-map     (and (:m now)  (not (:m prev)))
   :toggle-pause   (and (:p now)  (not (:p prev)))
   :toggle-sound   (and (:n now)  (not (:n prev)))
   :toggle-debug   (and (:f3 now) (not (:f3 prev)))
   :reload         (and (:r now)  (not (:r prev)))
   ;; H and ESC are aliased: both rising-edge into :toggle-help so
   ;; ESC opens/closes the info panel exactly like H (pause-coupled).
   :toggle-help    (and (or (:h now)  (:esc now))
                        (not (or (:h prev) (:esc prev))))
   :about-face     (and (:e now)  (not (:e prev)))
   ;; Action key for revealing secret walls + (eventually) flipping
   ;; switches. Rising-edge only so holding F doesn't chain-reveal
   ;; multiple walls when the player walks through a row of secrets.
   :action         (and (:f now)  (not (:f prev)))
   :select-weapon1 (and (:k1 now) (not (:k1 prev)))
   :select-weapon2 (and (:k2 now) (not (:k2 prev)))
   :select-weapon3 (and (:k3 now) (not (:k3 prev)))
   :select-weapon4 (and (:k4 now) (not (:k4 prev)))
   :select-weapon5 (and (:k5 now) (not (:k5 prev)))
   :select-weapon6 (and (:k6 now) (not (:k6 prev)))
   :select-weapon7 (and (:k7 now) (not (:k7 prev)))
   ;; F5 quick-save / F9 quick-load (issue #63). Handled in game-loop
   ;; (file IO), not tick-world, so the pure tick stays effect-free.
   :save           (and (:f5 now) (not (:f5 prev)))
   :load           (and (:f9 now) (not (:f9 prev)))})
