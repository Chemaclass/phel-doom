(ns phel-doom.io.input)

(def mouse-enable
  "Escapes that turn ON xterm mouse reporting for FPS-style mouselook
   (issue #246): `\\e[?1003h` requests ANY-MOTION tracking (the terminal
   reports the pointer even with no button held), `\\e[?1006h` switches
   the reports to the SGR-extended encoding (`\\e[<b;x;y(M|m)`) that
   controls/mouse-look parses, and `\\e[>3p` (XTSMPOINTER, Ps=3) tells the
   terminal to ALWAYS hide the OS mouse pointer, even leaving/entering the
   window. The pointer-hide is load-bearing (#295): enabling tracking
   makes xterm's default (XTSMPOINTER 1 = hide only when tracking is OFF)
   SHOW the arrow, and `\\e[?25l` only hides the text caret - so without
   `\\e[>3p` the pointer stays visible over the 3D view. Emitted only when
   the Mouse setting is on, so an opted-out player keeps a normal pointer.
   Terminals without XTSMPOINTER ignore it (harmless); no escape can warp
   or confine the pointer, so this hides but cannot truly lock it."
  "\e[?1003h\e[?1006h\e[>3p")

(def mouse-disable
  "Reverse of `mouse-enable`: disable any-motion tracking + SGR mode and
   restore the default pointer visibility (`\\e[>1p`, XTSMPOINTER 1) so the
   terminal stops capturing + force-hiding the pointer on teardown. Always
   emitted on restore! (idempotent / harmless even if the mouse was never
   enabled this session)."
  "\e[?1003l\e[?1006l\e[>1p")

(def focus-enable
  "Focus tracking on (`\\e[?1004h`, #454): the terminal then reports the
   window losing focus as `\\e[O` and regaining it as `\\e[I`. The game
   pauses on the loss, so alt-tabbing away can't leave the player standing
   in front of an enemy. Unconditional - unlike mouse reporting there is
   nothing to opt out of, and a terminal without the mode ignores it.
   Inside tmux the outer terminal's report only reaches the pane with
   `focus-events on` (see docs/input.md)."
  "\e[?1004h")

(def focus-disable
  "Reverse of `focus-enable`, emitted on teardown so the terminal stops
   reporting focus changes to whatever runs next."
  "\e[?1004l")

(defn init-escapes
  "Pure: the terminal-setup escape string init-input! emits. Alt screen
   (`\\e[?1049h`) + hide cursor (`\\e[?25l`) + no autowrap (`\\e[?7l`) +
   clear/home (`\\e[2J\\e[H`) + kitty keyboard opt-in (`\\e[>3u`), then
   the xterm mouse-reporting escapes (`mouse-enable`) appended ONLY when
   `mouse?` is true (#246). Split out from the side-effecting init-input!
   so the mouse gating is unit-testable without touching the terminal."
  [mouse?]
  (str "\e[?1049h\e[?25l\e[?7l\e[2J\e[H\e[>3u" focus-enable
       (if mouse? mouse-enable "")))

(def unhideable-pointer-terminals
  "TERM_PROGRAM values for terminals known NOT to hide the OS mouse pointer
   during mouselook (#295) - either they ignore XTSMPOINTER `\\e[>3p`
   entirely (iTerm2 / Apple Terminal / VS Code) or they only hide it while
   TYPING, not while the mouse MOVES (Ghostty et al.) - the hard #313 limit.
   Maps the raw env value to a friendly name for the startup notice. A small
   DENYlist (only the sure cases) so unknown terminals are assumed capable
   and never falsely nagged; `\\e[>3p` is sent to all regardless and is
   harmless where ignored."
  {"iTerm.app"      "iTerm2"
   "Apple_Terminal" "Apple Terminal"
   "vscode"         "VS Code"
   ;; Ghostty / kitty / WezTerm hide the pointer only while TYPING, not
   ;; during mouse motion, and do not honour XTSMPOINTER always-hide, so the
   ;; arrow stays visible during mouselook (#295/#312). The edge-pan keeps
   ;; the aim working regardless; the notice sets expectations.
   "ghostty"        "Ghostty"})

(defn pointer-limit-notice
  "Pure: a short start-menu note for a terminal that can't hide the OS mouse
   pointer - the arrow stays visible but is cosmetic (the real aim is the
   centred crosshair). nil when `term` (a $TERM_PROGRAM value) hides the
   pointer / is unknown. Shown on the welcome screen, not as a startup flash.
   Generic wording so it fits the menu box on every named terminal."
  [term]
  (when (some? (get unhideable-pointer-terminals term))
    "OS arrow is cosmetic; aim is the + crosshair."))

(def halfblock-seam-terminals
  "TERM_PROGRAM values whose ▀ half-block renders with row seams / inter-row
   gaps (#332), so the sub-pixel renderer defaults OFF there for a player who
   has never chosen otherwise. Apple's Terminal anti-aliases ▀ with gaps;
   iTerm2 / kitty / WezTerm / Ghostty draw it pixel-tight. A small allowlist
   (only the sure case) - unknown terminals are assumed capable and keep
   sub-pixel on."
  #{"Apple_Terminal"})

(defn halfblock-seams?
  "True when `term` (a $TERM_PROGRAM value) renders the ▀ half-block with
   seams (#332). Pure; pair with `terminal-program`."
  [term]
  (contains? halfblock-seam-terminals term))

(defn terminal-program
  "The terminal identifier from $TERM_PROGRAM (\"\" when unset). Reads the
   environment, so it is side-effecting (not pure)."
  []
  (or (php/getenv "TERM_PROGRAM") ""))

(defn init-input!
  "Put the terminal in non-blocking raw mode so we can read single keys
   without waiting for Enter. Switch to the alternate screen buffer and
   hide the cursor to avoid flicker during the render loop.

   Kitty keyboard protocol opt-in: `CSI > 3 u` pushes flags
   `disambiguate (1) | report-event-types (2)`. Supporting terminals
   (kitty, WezTerm, Ghostty, recent iTerm2/Alacritty) then send real
   press / repeat / release events for keys, which controls.phel
   parses to clear movement slots instantly on release. Non-supporting
   terminals ignore the opt-in and we fall back to the legacy byte
   stream + hold-secs bridge.

   `mouse?` (default true) gates the xterm mouse-reporting escapes
   (`mouse-enable`) for FPS-style mouselook (issue #246). When the Mouse
   setting is off the caller passes false and no mouse escapes are sent,
   so the terminal never captures the pointer."
  [& [mouse?]]
  (php/exec "stty -icanon -echo min 0 time 0")
  (php/stream_set_blocking php/STDIN false)
  (print (init-escapes (if (nil? mouse?) true mouse?))))

(defn rearm-mouse!
  "Re-assert the xterm mouse-reporting escapes (`mouse-enable`) so pointer
   reports re-arm after a focus loss / regain or a resize (#288). A
   terminal can silently drop mouse tracking on a mode flip; init-input!
   only enables it once at startup, so without a periodic / on-resize
   re-assert mouselook can go quiet even though the pointer is still over
   the window. Idempotent (the same escapes init-input! sent), gated by
   the caller on the Mouse setting so an opted-out player is untouched.
   `\\e[?25l` is bundled to keep the caret hidden across the same mode
   flip. Side-effecting: emits to STDOUT, hence the `!`."
  []
  (print "\e[?25l")
  (print mouse-enable))

(defn- drain-stdin!
  "Read and discard pending STDIN bytes for up to `ms` milliseconds.
   Used on teardown to swallow an in-flight kitty key-release report for
   the quit key, which would otherwise echo onto the shell prompt once
   cooked mode is restored."
  [^int ms]
  (let [deadline (php/+ (php/microtime true) (php// (php/* 1.0 ms) 1000.0))]
    (loop []
      (php/fread php/STDIN 256)
      (php/usleep 10000)
      (when (php/< (php/microtime true) deadline)
        (recur)))))

(def restore-prelude
  "Pure: the first escape burst restore! emits - pop the kitty keyboard
   flags (`\\e[<u`) AND disable mouse reporting (`mouse-disable`) so the
   terminal stops emitting key / pointer reports before the teardown
   drain. mouse-disable is always sent (harmless if mouse was never
   enabled). Split out so the teardown contract is unit-testable."
  (str "\e[<u" mouse-disable focus-disable))

(def- signals-armed
  ;; Whether install-signal-handlers! armed anything; interrupted? skips
  ;; the dispatch when it did not.
  (atom false))

(def- interrupt-flag
  ;; Set by the SIGINT / SIGTERM handler, read at a frame checkpoint. An
  ;; atom rather than a direct teardown from the handler: doing terminal
  ;; IO inside a signal handler would race the render write it interrupts.
  (atom false))

(defn install-signal-handlers!
  "Ask for SIGINT / SIGTERM to set a quit flag instead of killing the
   process outright. Ctrl-C is the normal way out of a stuck game, and
   PHP's `finally` does NOT run on signal death - so without this the one
   teardown guarantee the session has is bypassed and the player is left
   with a raw-mode terminal, no cursor and the alternate screen still up.

   Also turns `pcntl_async_signals` back OFF. symfony/console switches it
   ON in the Application constructor (SignalRegistry), which src/main.phel
   runs at load, so async delivery is already active by the time we get
   here - it is not the PHP default. Async means a signal lands at an
   arbitrary opcode boundary including mid-render, which
   .claude/rules/io-boundaries.md refuses to depend on because render does
   not retry partial writes. With it off, delivery happens only at the
   explicit `pcntl_signal_dispatch` in `interrupted?`, which every loop
   that can be interrupted calls once per frame.

   The SECOND signal is not trapped. Trapping without escalation would
   make a genuinely wedged process (an infinite loop between checkpoints,
   a hung exec) killable only by `kill -9`, which is the outcome that
   wrecks the terminal - the very thing this exists to prevent. So a
   repeat signal restores the default disposition and re-raises, and the
   process dies the way it always would have.

   Returns true when handlers were installed; false on a PHP build
   without ext-pcntl, where behaviour is exactly as it was before."
  []
  (if (php/function_exists "pcntl_signal")
    (let [handler (fn [signal]
                    (if @interrupt-flag
                      ;; Already asked once and we are still here: the loop is
                      ;; not reaching a checkpoint. Hand the signal back to the
                      ;; default handler so this one terminates the process.
                      (do (php/pcntl_signal signal php/SIG_DFL)
                          (when (php/function_exists "posix_kill")
                            (php/posix_kill (php/getmypid) signal)))
                      (reset! interrupt-flag true)))]
      (php/pcntl_signal php/SIGINT handler)
      (php/pcntl_signal php/SIGTERM handler)
      ;; Separate probe: pcntl_signal and pcntl_async_signals are separable
      ;; (php -d disable_functions=pcntl_async_signals), and a throw here would
      ;; land after init-input! put the terminal in raw mode but before the
      ;; try/finally that guarantees teardown.
      (when (php/function_exists "pcntl_async_signals")
        (php/pcntl_async_signals false))
      (reset! signals-armed true)
      true)
    false))

(def- resize-flag
  ;; Set by the SIGWINCH handler, read at the same frame checkpoint the
  ;; interrupt flag uses. The handler must not shell out to `stty` - the
  ;; whole point is to keep the fork off the hot path, and doing IO in a
  ;; handler would race the render write it interrupts.
  (atom false))

(def- resize-armed
  ;; Whether install-resize-handler! armed SIGWINCH this session.
  (atom false))

(defn install-resize-handler!
  "Ask for SIGWINCH to raise a flag when the terminal is resized (#459).

   Without it the loops fork `stty size` every 12th frame - a ~5ms hitch
   at 10Hz, on a frame budget of 8.3ms, to answer a question whose answer
   changes about once a session. With it, the poll only runs when the
   terminal actually says something changed.

   Same synchronous delivery as SIGINT / SIGTERM: dispatch happens at the
   frame checkpoint, never asynchronously mid-render (see
   .claude/rules/io-boundaries.md). Returns true when armed; false on a
   build without ext-pcntl, where the frame-count poll stays the only
   mechanism."
  []
  (if (and (php/function_exists "pcntl_signal") (php/defined "SIGWINCH"))
    (do (php/pcntl_signal (php/constant "SIGWINCH")
                          (fn [_signal] (reset! resize-flag true)))
        (reset! signals-armed true)
        (reset! resize-armed true)
        true)
    false))

(defn resize-armed?
  "True when `install-resize-handler!` armed SIGWINCH this session. The
   game loop reads it to decide whether the frame-count `stty` poll is
   still needed at all."
  []
  @resize-armed)

(defn resized?
  "True when a SIGWINCH arrived since the last call, clearing the flag.
   The pending-signal dispatch runs in `interrupted?`, which every
   interruptible loop already calls once per frame."
  []
  (if @resize-flag
    (do (reset! resize-flag false) true)
    false))

(defn interrupted?
  "True once SIGINT / SIGTERM has been received. Runs the pending-signal
   dispatch itself, so the game loop only has to call this once per frame
   at a point where returning `:quit` is safe."
  []
  (when @signals-armed
    (php/pcntl_signal_dispatch))
  @interrupt-flag)

(defn reset-interrupt!
  "Clear the quit flag. For tests, and for a caller that deliberately
   wants to survive one interrupt."
  []
  (reset! interrupt-flag false)
  nil)

(defn restore!
  "Pop any kitty keyboard flags this session pushed, disable mouse
   reporting, restore cooked terminal mode and leave the alternate
   screen buffer."
  []
  ;; Pop the kitty protocol + mouse reporting first so the terminal
  ;; stops emitting key / pointer reports, then swallow the trailing
  ;; release event for the quit key before cooked mode (echo on) would
  ;; print it to the shell.
  (print restore-prelude)
  (php/flush)
  (drain-stdin! 120)
  (print "\e[?25h\e[?7h\e[?1049l")
  (php/exec "stty sane"))

(def drain-bytes
  "Per-frame STDIN read budget. Sized to hold a frame's worth of input
   without truncating a multi-byte sequence mid-escape: a fast mouse
   drag under any-motion tracking (#246) floods many ~12-byte SGR
   reports, and the SGR parser silently drops a half-read trailing
   report, so a generous buffer keeps the look delta smooth. Held keys
   still apply their motion multiple times per frame instead of being
   throttled by the loop's read-one-key cadence."
  512)

(defn drain-keys
  "Drain all pending input bytes as a raw string (possibly empty). Lets
   a held key apply its motion multiple times per frame instead of being
   throttled by the loop's read-one-key cadence."
  []
  (let [s (php/fread php/STDIN drain-bytes)]
    (if (= s false) "" s)))
