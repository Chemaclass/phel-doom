(def base-hud-rows 1)

(def shade-table
  "Pre-baked ANSI strings for the 24 grayscale palette entries (codes
   232-255). Indexed by an integer shade level 0-23, so the per-cell
   shade lookup is just one PHP array fetch — no memoize, no string
   alloc, no Phel runtime dispatch."
  (let [t (buf-mk)]
    (loop [i 0]
      (when (php/< i 24)
        (buf-set t i (str "\e[48;5;" (php/+ 232 i) "m "))
        (recur (php/+ i 1))))
    t))

(def shade-code-table
  "Parallel palette to shade-table holding ONLY the 256-color code as
   a string (e.g. \"240\"). Used to compose ▀ half-block edge cells
   that mix a wall colour with sky / floor for sub-pixel-looking wall
   tops and bottoms."
  (let [t (buf-mk)]
    (loop [i 0]
      (when (php/< i 24)
        (buf-set t i (php/strval (php/+ 232 i)))
        (recur (php/+ i 1))))
    t))

(def shade-table-blood
  "Red gradient palette swapped in for the duration of the player's
   post-hit i-frames so the whole viewport flushes red — instant 'you
   just got hit' feedback without rendering a separate overlay."
  (let [t (buf-mk)]
    (loop [i 0]
      (when (php/< i 24)
        ;; bright red (close) -> dark red (far) along the 256-color
        ;; reds: 196 -> 58, every shade step ~6 indices.
        (buf-set t i (str "\e[48;5;" (php/- 196 (php/intval (php/* i 6))) "m "))
        (recur (php/+ i 1))))
    t))

(def shade-code-table-blood
  "Code-only twin of shade-table-blood for edge-cell composition."
  (let [t (buf-mk)]
    (loop [i 0]
      (when (php/< i 24)
        (buf-set t i (php/strval (php/- 196 (php/intval (php/* i 6)))))
        (recur (php/+ i 1))))
    t))

;; ---------------------------------------------------------------------
;; Colour-space helpers: 256-colour code <-> RGB. Used by load-time LUT
;; bakes (distance fog) that must lerp in true RGB so a fade lands on the
;; perceptually nearest code instead of jumping hue. All load-time only;
;; never called on the per-cell hot path.
;; ---------------------------------------------------------------------

(def- cube-lv (php/array 0 95 135 175 215 255))

(def- color-rgb-luts
  ;; Three parallel 256-entry LUTs: code -> R / G / B (0-255). Cube
  ;; (16-231), grayscale (232-255), and the 16 ANSI system colours.
  (let [r   (php/array)
        g   (php/array)
        b   (php/array)
        sys (php/array 0 0 0 205 0 0 0 205 0 205 205 0 0 0 238 205 0 205 0 205 205 229 229 229
                       127 127 127 255 0 0 0 255 0 255 255 0 92 92 255 255 0 255 0 255 255 255 255 255)]
    (loop [c 0]
      (when (php/< c 256)
        (cond
          (php/>= c 232) (let [v (php/+ 8 (php/* 10 (php/- c 232)))]
                           (php/aset r c v) (php/aset g c v) (php/aset b c v))
          (php/>= c 16)  (let [k (php/- c 16)]
                           (php/aset r c (php/aget cube-lv (php/intdiv k 36)))
                           (php/aset g c (php/aget cube-lv (php/intdiv (php/% k 36) 6)))
                           (php/aset b c (php/aget cube-lv (php/% k 6))))
          :else          (do (php/aset r c (php/aget sys (php/* 3 c)))
                             (php/aset g c (php/aget sys (php/+ (php/* 3 c) 1)))
                             (php/aset b c (php/aget sys (php/+ (php/* 3 c) 2)))))
        (recur (php/+ c 1))))
    ;; Index -1 = the transparent-texel sentinel; maps to 0 so callers
    ;; can average a 2x2 block that mixes opaque + transparent sources
    ;; without an undefined-key probe.
    (php/aset r -1 0)
    (php/aset g -1 0)
    (php/aset b -1 0)
    (php/array r g b)))

(def code-r "256-colour code -> red channel (0-255); index -1 (transparent) -> 0. Load-time LUT bakes only." (php/aget color-rgb-luts 0))
(def code-g "256-colour code -> green channel (0-255); index -1 (transparent) -> 0. Load-time LUT bakes only." (php/aget color-rgb-luts 1))
(def code-b "256-colour code -> blue channel (0-255); index -1 (transparent) -> 0. Load-time LUT bakes only." (php/aget color-rgb-luts 2))

(defn- cube-idx
  ;; nearest 6x6x6 cube level index for one 0-255 channel value.
  [^int v]
  (cond (php/< v 48)  0
        (php/< v 115) 1
        (php/< v 155) 2
        (php/< v 195) 3
        (php/< v 235) 4
        :else         5))

(defn- color-sq [^int v] (php/* v v))

(defn nearest-256
  "Nearest xterm-256 code for an RGB triple (0-255 each): tries the
   6x6x6 cube and the 24-step grayscale ramp, keeps whichever is closer
   in squared RGB distance. Load-time colour quantizer; never on the hot
   path."
  [^int r ^int g ^int b]
  (let [ri   (cube-idx r)
        gi   (cube-idx g)
        bi   (cube-idx b)
        cr   (php/aget cube-lv ri)
        cg   (php/aget cube-lv gi)
        cb   (php/aget cube-lv bi)
        avg  (php/intdiv (php/+ r g b) 3)
        gidx (php/max 0 (php/min 23 (php/intdiv (php/- avg 3) 10)))
        gv   (php/+ 8 (php/* 10 gidx))
        dc   (php/+ (color-sq (php/- r cr)) (color-sq (php/- g cg)) (color-sq (php/- b cb)))
        dg   (php/+ (color-sq (php/- r gv)) (color-sq (php/- g gv)) (color-sq (php/- b gv)))]
    (if (php/<= dc dg)
      (php/+ 16 (php/* 36 ri) (php/* 6 gi) bi)
      (php/+ 232 gidx))))

;; ---------------------------------------------------------------------
;; Per-tier floor tint (issue #304). A multi-tier room (L7) drew every
;; raised platform, riser and cap in the same grey stone, so the stepped
;; structure was invisible. Each raised tier now gets a DISTINCT hue tint
;; keyed on the cell's floor height `fz`: the lower raised band reads cool
;; (steel-blue stone), the higher band reads rose (magenta stone). Tier 0
;; (fz<=0, the spawn floor + every flat level) keeps the neutral grey -
;; the tint is a strict NO-OP there, so flat frames stay byte-identical
;; (the golden `test-frame-bytes-pinned` hashes are unchanged).
;; ---------------------------------------------------------------------

(defn floor-tier
  "Tier band for a cell floor height `fz` (issue #304): 0 = ground (no
   tint, fz<=0 - flat floor + descended trench), 1 = lower raised band
   (cool), 2 = higher raised band (rose). The 0.85 split lands the L7
   middle tier (0.75) + L5 dais (0.8) in the cool band and the L7 top
   tier (1.5) + its 1.125 stair in the rose band, so the two stacked
   plateaus read as two distinct hues. Pure; one comparison, hot-path
   cheap (called once per riser column, not per cell)."
  [^float fz]
  (cond (php/<= fz 0.0) 0
        (php/< fz 0.85) 1
        :else           2))

(def- tier-tints
  ;; Per-tier RGB channel multipliers applied to the grey stone before
  ;; re-quantizing. Tuned to stay a TINT, not a solid neon: luminance is
  ;; preserved (the fog ramp + EW side shading still read), only the hue
  ;; is pushed. Index 0 is unused (tier 0 never tints).
  ;;   tier 1 = cool steel-blue (pull blue up, red/green down).
  ;;   tier 2 = magenta-rose (pull red + blue up, CRUSH green).
  ;; The base stone is warm-grey, so an amber tier-2 would blend into it
  ;; (a stone code like 94 only shifts to the near-identical 130). Rose is
  ;; ABSENT from the grey/brown/orange stone band, so a rose riser reads
  ;; distinct at any distance, and cool-blue + rose form a complementary
  ;; cold/warm pair so the two tiers never compete in the same hue half.
  {1 {:r 0.55 :g 0.75 :b 1.45}    ; cool steel-blue
   2 {:r 1.35 :g 0.55 :b 1.10}})  ; magenta-rose

(defn- tint-code
  ;; Hue-shift one grey 256-colour `code` by a tier's RGB multipliers,
  ;; then quantize to the nearest 256 code. Clamps each channel to 255 so
  ;; a bright near-white stone does not overflow. Load-time only.
  [^int code mult]
  (let [v (php/aget code-r code)]            ; grey: r=g=b, any channel works
    (nearest-256 (php/min 255 (php/intval (php/* v (:r mult))))
                 (php/min 255 (php/intval (php/* v (:g mult))))
                 (php/min 255 (php/intval (php/* v (:b mult)))))))

(defn- tint-shade-table
  ;; Build a 24-entry tinted twin of `shade-table` for `tier`: each grey
  ;; level 0-23 is hue-shifted then baked into a ready `\e[48;5;Cm ` BG
  ;; cell string, so the riser/cap hot path is one aget (no per-cell tint
  ;; math). Mirrors shade-table's structure so the riser/cap loop can swap
  ;; tables by tier with no other change.
  [tier]
  (let [mult (get tier-tints tier)
        t    (buf-mk)]
    (loop [i 0]
      (when (php/< i 24)
        (buf-set t i (str "\e[48;5;" (tint-code (php/+ 232 i) mult) "m "))
        (recur (php/+ i 1))))
    t))

(def shade-table-tier1
  "Cool steel-blue tint of `shade-table` for the lower raised tier
   (issue #304). Same 24-level fog ramp, hue pushed cool so a mid-height
   platform/riser reads as a distinct tier without losing depth shading."
  (tint-shade-table 1))

(def shade-table-tier2
  "Magenta-rose tint of `shade-table` for the higher raised tier (issue
   #304). Same 24-level fog ramp, hue pushed to rose - a hue ABSENT from
   the warm-grey stone palette, so the top tier reads distinct from both
   the neutral ground and the cool middle tier at any distance."
  (tint-shade-table 2))

(def tier-shade-tables
  "Tier index -> tinted shade table. Index 0 is the neutral grey
   `shade-table` (no tint), so a `(php/aget tier-shade-tables (floor-tier
   fz))` lookup is a uniform, branch-free table swap on the riser/cap
   path. fz=0 cells select the grey table verbatim, keeping flat frames
   byte-identical."
  (php/array shade-table shade-table-tier1 shade-table-tier2))

(defn- tint-bg-cell-cache
  ;; Build a tinted twin of frame-math's `bg-cell-cache` for `tier`: a
  ;; 256-entry table mapping each 256-colour code to a ready
  ;; `\e[48;5;Cm ` BG cell whose colour is the tier-hue-shifted code.
  ;; The textured cap path resolves a fogged floor texel code, then
  ;; fetches its tinted cell here so a raised cap reads as tier-coloured
  ;; STONE (texture + fog preserved, only hue pushed). Load-time only.
  [tier]
  (let [mult (get tier-tints tier)
        a    (buf-mk)]
    (loop [c 0]
      (when (php/< c 256)
        (buf-set a c (str "\e[48;5;" (tint-code c mult) "m "))
        (recur (php/+ c 1))))
    a))

(def- neutral-bg-cell-cache
  ;; Untinted twin of frame-math's `bg-cell-cache` (palette can't require
  ;; frame-math - that would be a circular dep - so it is rebuilt here).
  ;; Only used as the index-0 fallback below; the per-cell hot path still
  ;; goes through frame-math's own `bg-cell-cache`.
  (let [a (buf-mk)]
    (loop [c 0]
      (when (php/< c 256)
        (buf-set a c (str "\e[48;5;" c "m "))
        (recur (php/+ c 1))))
    a))

(def tier-bg-cell-caches
  "Tier index -> tinted `bg-cell-cache` for the textured step cap
   (issue #304). Index 1 = cool, index 2 = rose. Index 0 is the NEUTRAL
   (untinted) cache: a tier-0 cap never exists today (a cap is only drawn
   for fz>0, guarded at the `floor-cap-px` call site), so the cap path
   only ever indexes 1 or 2 - but index 0 holds real cells (not nil) so
   that if the textured-cap path is ever extended to fz=0 it renders plain
   stone rather than a silent empty-string hole (`php/aget` on nil). Lets
   `floor-cap-px` fetch a tier-tinted stone cell with the same single
   nested aget as the neutral path."
  (php/array neutral-bg-cell-cache (tint-bg-cell-cache 1) (tint-bg-cell-cache 2)))

;; ---------------------------------------------------------------------
;; Sprite ground-platform (issue #319). An enemy standing on a raised tier
;; was drawn with its feet correctly LIFTED but with no platform under it,
;; so it read as floating: the renderer only ever paints the single nearest
;; riser + a flat z=0 floor, never the tier floor surface the enemy stands
;; on. To ground the billboard we paint a short PLATFORM PAD directly under
;; its feet - a bright lit front edge (the lip the enemy stands on) rolling
;; into a darker tier-tinted face below. Tier-hued (cool/rose, same #304
;; palette) so the pad reads as the same stone as the rest of that tier and
;; the enemy unmistakably stands ON it. fz<=0 (flat ground / every flat
;; level) never paints a pad, so flat frames stay byte-identical.
;; ---------------------------------------------------------------------

(defn- tier-stone-code
  ;; Tier-hue-shifted twin of a grey ramp code `232+lvl` (lvl 0-23). One
  ;; nearest-256 quantize; load-time only. tier 0 returns the grey code
  ;; verbatim so the helper is a no-op there.
  [tier ^int lvl]
  (let [code (php/+ 232 (php/min 23 (php/max 0 lvl)))]
    (if (php/=== tier 0)
      code
      (tint-code code (get tier-tints tier)))))

(def tier-platform-nose
  "Tier index -> the platform's lit FRONT-EDGE cell (issue #319): a BRIGHT
   tier-tinted stone BG painted at the enemy's feet row - the lit lip the
   billboard stands on. Kept a BG-only space cell (not a `▀` half-block) so
   a run of identical pad cells RLE-coalesces into one escape + spaces; a
   glyph cell would defeat the renderer's space-run compression and draw a
   single edge mark followed by blanks. Legibility comes from the strong
   brightness step between this bright nose row and the darker `tier-platform-
   face` rows below, which reads as a lit edge dropping into shadow. Indexed
   by `(floor-tier fz)`; index 0 is an unused grey fallback (pad drawn for
   fz>0 only)."
  (let [mk (fn [tier] (str "\e[48;5;" (tier-stone-code tier 18) "m "))]
    (php/array (mk 0) (mk 1) (mk 2))))

(def tier-platform-face
  "Tier index -> the platform's FACE cell (issue #319): a solid mid-dark
   tier-tinted stone painted for the row(s) below the lit nose, so the pad
   has visible depth (a small riser dropping toward the player) instead of a
   single floating line. Indexed by `(floor-tier fz)`; index 0 is an unused
   grey fallback (pad drawn for fz>0 only)."
  (let [mk (fn [tier] (str "\e[48;5;" (tier-stone-code tier 8) "m "))]
    (php/array (mk 0) (mk 1) (mk 2))))
