(ns phel-doom-tests.io.render-cache-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.core.level :refer [build-world])
  (:require phel-doom.core.engine :refer [mark-visible-cells])
  (:require phel-doom.core.rng :as rng)
  (:require phel-doom-tests.io.render-fixtures :refer [world stats])
  (:require phel-doom.io.render.frame-math :refer [halfblock build-sky-halfblock])
  (:require phel-doom.io.render.palette :refer [shade-code-table boss-door-marker])
  (:require phel-doom.io.render.hud :refer [minimap-rows minimap-door-pulse])
  (:require phel-doom.io.render.main :refer [frame->string floor-tex-px]))

;; ---------------------------------------------------------------------
;; Gradient memo (frame-gradients) transparency. The sky/floor gradient
;; bundle is cached by vh in a module atom; these tests pin that the
;; cache stays transparent: same size renders identically (cache hit),
;; and a size that changes vh and changes back renders identically again
;; (the rebuild path can't leave a stale/corrupt bundle).
;; ---------------------------------------------------------------------

(deftest test-same-size-renders-identically
  ;; Deterministic at a fixed vh — the cache hit returns the same arrays.
  (is (= (frame->string world stats 120 30)
         (frame->string world stats 120 30))))

(deftest test-vh-change-and-back-is-stable
  ;; vh changes (30 -> 40) force a rebuild; coming back to 30 must
  ;; render exactly as the first 30 did (no stale bundle bleed-through).
  (let [a (frame->string world stats 120 30)]
    (frame->string world stats 120 40)   ; rebuild at vh' = 40 - hud rows
    (is (= a (frame->string world stats 120 30)))))

(deftest test-different-size-differs
  ;; A genuinely different viewport produces different output (sanity:
  ;; the cache isn't pinning one frame for all sizes).
  (is (not= (frame->string world stats 80 24)
            (frame->string world stats 160 44))))

(deftest test-frame-bytes-pinned
  ;; Golden hash: the exact rendered bytes for a fixed world + stats at
  ;; several viewports (full detail + pixel-doubled). Any unintended
  ;; pixel change - e.g. a regression in the vertical-projection kernel -
  ;; flips a hash and fails loudly. Update the constants DELIBERATELY when
  ;; output is meant to change.
  (is (= "453c4baf9062da97bed130cc89623807" (php/md5 (frame->string world stats 120 30))))
  (is (= "c13279bcc03f79f194d9daa4cfd883fe" (php/md5 (frame->string world stats 80 24))))
  (is (= "a8944ba06820b1c267695234ffed6ecb" (php/md5 (frame->string world stats 160 44))))
  (is (= "23df8cf945a88757c0b7e000b1b811ec" (php/md5 (frame->string world (assoc stats :px2? true) 120 30)))))

(deftest test-theme-tints-the-floor-gradient
  ;; #417: a level's :theme resolves to a floor gradient base code that is
  ;; threaded into the memoized bundle. The base-grey level-1 `world`
  ;; renders one way; forcing a :hell theme retints the floor, so the bytes
  ;; differ - proof the theme is actually plumbed through render. And the
  ;; :base theme reproduces the neutral default byte-for-byte.
  (let [base (frame->string world stats 120 30)
        hell (frame->string (assoc world :theme :hell) stats 120 30)]
    (is (not= base hell) "a themed level retints the floor gradient")
    (is (= base (frame->string (assoc world :theme :base) stats 120 30))
        ":base theme is byte-identical to the neutral default")))

(deftest test-room-light-off-is-byte-identical-to-default
  ;; #418: the golden stats carry no :light, so lighting is off. An
  ;; explicit :light false must reproduce the neutral golden frame - the
  ;; opt-in contract (like view-bob / subpixel).
  (is (= (frame->string world stats 120 30)
         (frame->string world (assoc stats :light false) 120 30))
      "room light off == default (byte-identical)"))

(deftest test-room-light-on-changes-the-frame
  ;; Turning room light on folds the world's :light-grid into the wall
  ;; shade index, so the bytes differ from the unlit frame.
  (is (not= (frame->string world stats 120 30)
            (frame->string world (assoc stats :light true) 120 30))
      "room light on reshades the walls")
  (is (= (frame->string world (assoc stats :light true) 120 30)
         (frame->string world (assoc stats :light true) 120 30))
      "lit render stays deterministic"))

(deftest test-room-light-on-px2-renders-without-error
  ;; Regression guard: px2 must thread hxs/hys through compact-cast-2, else
  ;; light-on throws on (php/aget nil ...) per column. The frame renders and
  ;; differs from the px2 unlit frame.
  (let [lit (frame->string world (assoc stats :light true :px2? true) 120 30)]
    (is (php/> (php/strlen lit) 0) "px2 + light on renders")
    (is (not= lit (frame->string world (assoc stats :px2? true) 120 30))
        "px2 light on differs from px2 unlit")))

(deftest test-view-bob-shears-scene-only-when-mid-stride
  ;; End-to-end wiring (#411): with View bob ON, a resting frame
  ;; (bob-phase 0) is byte-identical to the bob-off golden, but a
  ;; mid-stride phase shears the whole scene so the bytes change. Proves
  ;; the render term is actually plumbed AND that off/at-rest stays clean.
  (let [bob-on  (assoc stats :view-bob 1.0)
        resting (php/md5 (frame->string world bob-on 120 30))
        peak    (php/md5 (frame->string (assoc world :bob-phase (php/* 0.5 php/M_PI)) bob-on 120 30))]
    (is (= "453c4baf9062da97bed130cc89623807" resting)
        "View bob on but at rest (bob-phase 0) stays the golden frame")
    (is (not= resting peak) "a mid-stride bob shifts the whole scene")))

(deftest test-muzzle-extralight-brightens-only-while-firing
  ;; End-to-end wiring (#413): the muzzle extralight is 0 with no :fire-anim,
  ;; so an idle frame is byte-identical to the golden; a shot (fire-anim at
  ;; peak) lifts the near-death haze and brightens the walls. This pins the
  ;; byte-identical-at-rest contract and that firing is actually plumbed;
  ;; the min-23 CLAMP is guarded by the level-10 test below (this lives-5
  ;; scene's net shift is too shallow to push any wall index past 23).
  (let [firing (php/md5 (frame->string world (assoc stats :fire-anim 0.1) 120 30))]
    (is (= "453c4baf9062da97bed130cc89623807"
           (php/md5 (frame->string world stats 120 30)))
        "not firing (no :fire-anim) stays the golden frame - byte-identical")
    (is (= "5a50ebb91f4d822cb553f8147ecd7f44" firing)
        "a fresh shot brightens the walls to this exact frame")
    (is (not= "453c4baf9062da97bed130cc89623807" firing)
        "firing genuinely changes the scene bytes")))

(deftest test-muzzle-extralight-clamps-the-negative-haze
  ;; Premise (seeded like the golden-geometry cases below): level 10 at
  ;; level gaze has walls near enough that a firing frame's negative net
  ;; haze shift (#413) pushes their shade index past 23. The min-23 clamp
  ;; in the three shade kernels absorbs that overflow; WITHOUT it `buf-get`
  ;; on the shade table returns nil and frame->string throws - so this test
  ;; ERRORS if any clamp is dropped. That is a real crash in normal play
  ;; (level 10, lives 5, a shot near a wall), not a synthetic edge case.
  ;; The pinned hash also byte-regresses the brightened frame.
  (rng/seed! 10)
  (let [w10    (mark-visible-cells (build-world 10 5 0 :normal #{:pistol}))
        s10    (assoc stats :level 10)
        firing (php/md5 (frame->string w10 (assoc s10 :fire-anim 0.1) 120 30))]
    (is (= "830b7faa50f1407daf28e81c1b8a4479" firing)
        "level-10 firing brightens to this exact clamped frame")
    (is (not= firing (php/md5 (frame->string w10 s10 120 30)))
        "firing genuinely brightens the walls vs the resting frame")))

;; The golden hash above pins a single config (level 1, level gaze). The
;; px2 / px1 scene emitters branch on scene geometry - sky above the wall
;; top, textured floor below the wall bottom, and the graduated seam
;; darken at each wall edge - so one config can't prove a `frame->string`
;; refactor byte-identical. The table below pins that contract across a
;; spread of those dimensions: level-to-level geometry (1/3/7/10), look
;; up (sky-heavy top) and down (floor pulled up) via pitch, and both pixel
;; modes incl. a px2 look-down case for the px2 floor-seam path. Together
;; they are the safety net the emitter extraction (#350) is built on.
;; build-world draws from the global RNG stream (no per-level reseed), so
;; building inside a deftest would make the frame depend on ambient RNG
;; state - i.e. on test execution order, flaky between a single-file run
;; and the full suite. Seed per level first so each case is reproducible
;; regardless of what ran before it.
(defn- golden-frame [level ^float pitch px2?]
  (rng/seed! level)
  (frame->string
   (assoc-in (mark-visible-cells (build-world level 5 0 :normal #{:pistol}))
             [:player :pitch] pitch)
   (assoc stats :level level :px2? px2?)
   120 30))

(def golden-geometry-cases
  ;; [level pitch px2? md5] - pitch +0.8 looks up (sky-heavy top), -0.8
  ;; looks down (floor pulled up into view), 0.0 is level gaze.
  [[1  0.8  false "40858c111481ff74d3eb21125694c3bd"]
   [1  -0.8 false "20172363e8f68e6fec5948d910576b34"]
   [3  0.0  false "e8d360fd9876eaaf2999aecf4d07337c"]
   [7  0.0  false "35a1113a6639205e6c3ca0f63862f7e8"]
   [10 0.0  false "9f421313ef4ce2c433a07955cceb6cc3"]
   [3  0.0  true  "d3d45922c861376cadc53a521c7f7195"]
   [10 0.8  true  "751fd4213c1dc8965800075cd563eb99"]
   [3  -0.8 true  "5fd6badeb600f2e39416395d37ceb7d8"]])

(deftest test-frame-bytes-pinned-across-geometry
  (doseq [[level pitch px2? expected] golden-geometry-cases]
    (is (= expected (php/md5 (golden-frame level pitch px2?)))
        (str "golden frame changed for level " level " pitch " pitch " px2? " px2?))))

(deftest test-golden-geometry-cases-are-distinct
  ;; Guard the premise: each case must render a DIFFERENT frame, else the
  ;; coverage is an illusion - a regression that ignored pitch, level or
  ;; px2 would collapse them and the hashes above would still pass in
  ;; lockstep. Dedupe on the digest, not the multi-KB frame strings.
  (let [digests (map (fn [[level pitch px2? _]] (php/md5 (golden-frame level pitch px2?)))
                     golden-geometry-cases)]
    (is (= (count golden-geometry-cases) (count (set digests)))
        "every golden geometry case renders a distinct frame")))

;; The golden world above carries no keycards / weapon-pickups, so its
;; hashes only exercise the empty-source path. These pin the non-empty
;; path: the keycard / weapon-pickup paint passes are guarded by a
;; `(seq source)` check (perf #348), and a wrong guard would silently
;; stop painting them with no other test catching it. (12.77, 12.91) sits
;; in an open cell ~1.4 units straight ahead of the seeded level-1 spawn
;; (11.5, 13.5 facing 5.85 rad), so the pickup projects into view and
;; changes the frame. Re-derive both if the fixture seed ever changes.
(deftest test-keycard-paints-into-frame
  (let [w-kc (assoc world :keycards [{:x 12.77 :y 12.91 :colour :blue}])]
    (is (not= (frame->string world stats 120 30)
              (frame->string w-kc stats 120 30))
        "a visible keycard paints into the frame")
    (is (= (frame->string w-kc stats 120 30)
           (frame->string w-kc stats 120 30))
        "keycard render stays deterministic")))

(deftest test-weapon-pickup-paints-into-frame
  (let [w-wp (assoc world :weapon-pickups [{:x 12.77 :y 12.91 :weapon :shotgun}])]
    (is (not= (frame->string world stats 120 30)
              (frame->string w-wp stats 120 30))
        "a visible weapon-pickup paints into the frame")
    (is (= (frame->string w-wp stats 120 30)
           (frame->string w-wp stats 120 30))
        "weapon-pickup render stays deterministic")))

(deftest test-low-detail-setting-flattens-and-is-deterministic
  ;; The `Low detail` perf setting is threaded into stats as :fast-walls (key
  ;; kept for save-file back-compat) and flips the wall + floor interior to a
  ;; single flat sample. It must (a) actually change the rendered bytes vs the
  ;; default subpixel render and (b) stay deterministic. The golden hashes
  ;; above are stats WITHOUT :fast-walls (= off), pinning that the default
  ;; render is unchanged - the setting is purely opt-in.
  (let [fast (assoc stats :fast-walls true)]
    (is (not= (frame->string world stats 160 44)
              (frame->string world fast 160 44))
        "low detail changes the rendered frame")
    (is (= (frame->string world fast 160 44)
           (frame->string world fast 160 44))
        "fast-walls render stays deterministic")))

(deftest test-subpixel-setting-off-switches-render-and-is-deterministic
  ;; The `Sub-pixel` compat setting (#332) is threaded into stats as :subpixel;
  ;; OFF picks the one-colour-per-cell path (the macOS Terminal.app row-seam
  ;; fix). It must (a) change the frame vs the default ▀ half-block render and
  ;; (b) stay deterministic. Default-on: the golden hashes above carry no
  ;; :subpixel key, so they pin the sub-pixel render unchanged.
  (let [flat (assoc stats :subpixel false)]
    (is (not= (frame->string world stats 160 44)
              (frame->string world flat 160 44))
        "subpixel off changes the rendered frame")
    (is (= (frame->string world flat 160 44)
           (frame->string world flat 160 44))
        "subpixel-off render stays deterministic")))

;; ---------------------------------------------------------------------
;; Camera pitch (look up/down, issue #231): a vertical horizon shear.
;; pitch=0 must reproduce the unpitched frame byte-for-byte; positive
;; pitch (look up) shears the wall/floor band DOWN the screen so the top
;; rows show more (RLE-friendly) sky, and negative pitch (look down)
;; pulls the textured floor up into the top rows.
;; ---------------------------------------------------------------------

(defn- pitched [^float p]
  (frame->string (assoc-in world [:player :pitch] p) stats 120 30))

(defn- top-row-segments
  "ANSI-segment count across the top 12 scene rows as a horizon-position
   proxy: sky rows coalesce into a couple of runs (few segments); wall /
   textured-floor rows carry many. Fewer => more sky on top."
  [^float p]
  (let [rows (php/explode "\n" (pitched p))]
    (loop [i 0 c 0]
      (if (php/< i 12)
        (recur (php/+ i 1)
               (php/+ c (php/- (php/count (php/explode "\e[" (php/aget rows i))) 1)))
        c))))

(deftest test-pitch-zero-matches-unpitched-frame
  ;; The byte-identical contract at the frame level: an explicit
  ;; :pitch 0.0 renders exactly like the world with no pitch shear.
  (is (= (frame->string world stats 120 30) (pitched 0.0))))

(deftest test-pitch-changes-the-frame
  (is (not= (pitched 0.0) (pitched 0.8)))
  (is (not= (pitched 0.0) (pitched -0.8))))

(deftest test-look-up-shears-horizon-down
  ;; Looking UP (positive pitch) slides the wall band DOWN, so the top
  ;; rows are more sky than at level gaze, which is in turn more sky than
  ;; looking DOWN (where the floor is pulled up into view). Directional
  ;; proof that wall tops / the sky-floor split move with +pitch.
  (is (php/< (top-row-segments 0.8) (top-row-segments 0.0))
      "look up => more sky on top than level")
  (is (php/< (top-row-segments 0.0) (top-row-segments -0.8))
      "look down => less sky on top than level"))

;; ---------------------------------------------------------------------
;; Half-block sub-pixel cell cache (halfblock). Two distinct codes pack
;; into a ▀ with top fg / bottom bg; equal codes collapse to a single-
;; colour BG cell (fewer bytes, RLE-friendly). The memo must return a
;; byte-identical cell on the second call (regression guard for the
;; `def-`-ate-the-docstring bug that stored the cache as an empty string
;; and corrupted entries via string-offset assignment).
;; ---------------------------------------------------------------------

(deftest test-halfblock-distinct-codes
  (is (= "\e[38;5;240;48;5;232m▀" (halfblock 240 232))))

(deftest test-halfblock-equal-codes-collapse
  (is (= "\e[48;5;200m " (halfblock 200 200))))

(deftest test-halfblock-memo-stable
  ;; Same pair, twice: the cached entry must be the full, uncorrupted
  ;; string (not a one-byte string-offset write).
  (let [a (halfblock 81 16)
        b (halfblock 81 16)]
    (is (= a b))
    (is (= "\e[38;5;81;48;5;16m▀" a))))

(deftest test-crosshair-bg-is-real-rendered-cell
  ;; The reticle `+` paints on the SGR of the ACTUAL cell the row loop
  ;; rendered under it (captured live), so its BG always matches the
  ;; surroundings. The captured cell string ends in `m`, so the crosshair
  ;; attr immediately follows an `m`: "...m\e[97;1m+". If the capture
  ;; broke (empty center cell), the `+` would follow the cursor-move `H`
  ;; instead - the regression this guards against (the old recompute used
  ;; the flat wall shade and read as a fake light box on textured walls).
  (let [frame (frame->string world stats 120 30)]
    (is (or (php/str_contains frame "m\e[97;1m+")
            (php/str_contains frame "m\e[93;1m+"))
        "crosshair + follows a real cell's BG SGR, not the bare cursor move")))

(deftest test-movable-crosshair-drawn-at-reticle-cell
  ;; Movable aim crosshair (#324): with :aim-col / :aim-row set the `+` is
  ;; drawn at the reticle's 1-based cursor cell (aim+1), not screen centre,
  ;; and the frame differs from the centred (mouse-off) frame. The reticle
  ;; col 90 / row 8 on a 120x30 view -> cursor "\e[9;91H...+".
  (let [centred (frame->string world stats 120 30)
        moved   (frame->string world (assoc stats :aim-col 90 :aim-row 8) 120 30)]
    (is (not= centred moved) "a moved reticle renders a different frame")
    (is (or (php/str_contains moved "\e[9;91H")
            ;; the firing jump lifts the row by one; this fixture is idle
            ;; (no :fire-anim), so the idle row stands.
            false)
        "the + cursor-moves to the reticle cell (row 9, col 91, 1-based)")))

(deftest test-mouse-off-crosshair-is-centered-default
  ;; Without :aim-col the reticle falls back to the fixed screen centre, so
  ;; the frame is byte-identical to the no-reticle stats (the golden path).
  ;; Re-asserts the centre default at the frame level next to the golden
  ;; hashes so a regression in the fallback fails close to its cause.
  (is (= (frame->string world stats 120 30)
         (frame->string world (assoc stats :aim-col nil :aim-row nil) 120 30))
      "nil reticle == centred crosshair (mouse-off byte-identity)"))

(defn- arr-mm [a]
  (let [n (php/count a)]
    (loop [i 1 lo (php/aget a 0) hi (php/aget a 0)]
      (if (php/< i n)
        (let [v (php/aget a i)]
          (recur (php/+ i 1) (php/min lo v) (php/max hi v)))
        [lo hi]))))

(deftest test-floor-texture-softer-than-wall
  ;; The floor samples a contrast-softened copy of the stone texture so
  ;; the hard dark cracks don't read as harsh black speckle at the grazing
  ;; floor angle. The stone flat spans 232..249; the floor copy is
  ;; compressed toward mid-grey, so its darks lift above 232 and its
  ;; brights pull below 249 (robust to retuning the factor).
  (let [[flo fhi] (arr-mm floor-tex-px)]
    (is (php/> flo 232) "floor darks lifted above the wall's darkest (232)")
    (is (php/< fhi 249) "floor brights pulled below the wall's brightest (249)")))

(deftest test-build-sky-halfblock-shape
  ;; One cell per row, each a non-empty paint string.
  (let [vh  20
        sky (build-sky-halfblock vh shade-code-table)]
    (is (= vh (count sky)))
    (is (php/> (php/strlen (php/aget sky 0)) 0))
    (is (php/> (php/strlen (php/aget sky (php/- vh 1))) 0))))

;; ---------------------------------------------------------------------
;; Pixel-doubled mode (:px2? in stats). The scene renders at half
;; resolution and each scene cell paints a 2x2 terminal block, so the
;; frame still fills every terminal column on every scene row - the
;; full-screen contract the auto pixel-scale relies on.
;; ---------------------------------------------------------------------

(defn- visible-width
  "Printable width of one frame row (SGR escapes stripped)."
  [row]
  (php/mb_strlen (php/preg_replace "/\e\\[[0-9;]*[A-Za-z]/" "" row)))

(deftest test-px2-rows-fill-the-terminal-width
  (let [s    (frame->string world (assoc stats :px2? true) 120 30)
        rows (php/explode "\n" s)]
    ;; Every scene row paints exactly the full 120 columns.
    (loop [i 0]
      (when (php/< i 20)
        (is (= 120 (visible-width (php/aget rows i))))
        (recur (php/+ i 1))))))

(deftest test-px2-odd-dims-still-fill
  ;; Odd terminal sizes clip the last 2x2 block to one column / row.
  (let [s    (frame->string world (assoc stats :px2? true) 119 29)
        rows (php/explode "\n" s)]
    (is (= 119 (visible-width (php/aget rows 0))))
    (is (= 119 (visible-width (php/aget rows 13))))))

(deftest test-px2-deterministic
  (is (= (frame->string world (assoc stats :px2? true) 120 30)
         (frame->string world (assoc stats :px2? true) 120 30))))

(deftest test-px2-differs-from-full-detail
  (is (not= (frame->string world (assoc stats :px2? true) 120 30)
            (frame->string world stats 120 30))))

;; ---------------------------------------------------------------------
;; L10 boss-locked exit: red on the minimap until the cyberdemon dies,
;; then it flips to the ordinary orange door glyph (combat stamps :boss
;; into :held-keys). The arena has exactly one door, so the boss-door
;; marker and the normal door glyph are mutually exclusive cues.
;; ---------------------------------------------------------------------

(defn- l10-minimap [held]
  (php/implode "\n"
               (minimap-rows
                (mark-visible-cells (assoc (build-world 10 5) :full-map? true :held-keys held))
                minimap-door-pulse 1)))

(deftest test-l10-boss-door-minimap-red-until-boss-killed
  (let [locked   (l10-minimap #{})
        unlocked (l10-minimap #{:boss})]
    (is (php/str_contains locked boss-door-marker)       "locked: boss door is red")
    (is (not (php/str_contains locked minimap-door-pulse)) "locked: no orange door yet")
    (is (php/str_contains unlocked minimap-door-pulse)   "killed: door turns orange")
    (is (not (php/str_contains unlocked boss-door-marker)) "killed: red marker gone")))
