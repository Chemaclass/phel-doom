(ns phel-doom.io.sound
  (:require phel-doom.io.sound-data :refer [freedoom-sfx]))

;; ---------------------------------------------------------------------
;; Sound effects via OS shell-out.
;;
;; Strategy:
;;   1. Try a real audio file via the first audio player on PATH
;;      (afplay/paplay/aplay/play). Use built-in system sound files so
;;      we don't have to ship audio assets. macOS has a stable set
;;      under /System/Library/Sounds; Linux distros vary too much to
;;      hardcode, so the bell is the fallback there.
;;   2. If no player is on PATH or the file doesn't exist, fall back
;;      to writing \a to STDOUT (terminal bell).
;;
;; Cost per event: one fork+exec via system(), fired in the background
;; with & so the game loop never blocks. ext-ffi + miniaudio would be
;; cheaper and bundled, but it's a heavy native binding; keeping the
;; public surface here (play-sfx!) lets that swap happen later without
;; touching callers.
;; ---------------------------------------------------------------------

(def player-binaries
  "Audio players we'll try in order. First one present on PATH wins."
  ["afplay" "paplay" "aplay" "play"])

(def macos-sounds
  "macOS ships these .aiff files in every install. Map game events to
   short, distinctive ones. One kill sound for all monsters: makes
   the death beat read the same across the run."
  {:shoot          "/System/Library/Sounds/Pop.aiff"
   ;; Per-weapon fire reports (weapons spec :fire-sfx). Distinct files
   ;; so each gun sounds different: pistol snaps (Pop, shared with
   ;; :shoot), shotgun booms (Blow), chaingun rattles (Morse), chainsaw
   ;; buzzes (Purr).
   :shoot-shotgun  "/System/Library/Sounds/Blow.aiff"
   :shoot-chaingun "/System/Library/Sounds/Morse.aiff"
   :shoot-chainsaw "/System/Library/Sounds/Purr.aiff"
   ;; BFG: bright glassy plasma discharge, distinct from the ballistic
   ;; weapons.
   :shoot-bfg      "/System/Library/Sounds/Glass.aiff"
   ;; Incinerator (#122): a wet sizzle for the flame stream, distinct
   ;; from the dry ballistic reports and the glassy BFG.
   :shoot-incinerator "/System/Library/Sounds/Frog.aiff"
   ;; Rocket launcher (#123): a sharp metallic ping for the launch,
   ;; distinct from the other weapon reports.
   :shoot-rocket   "/System/Library/Sounds/Ping.aiff"
   :kill      "/System/Library/Sounds/Pop.aiff"
   :hit       "/System/Library/Sounds/Sosumi.aiff"
   :wound     "/System/Library/Sounds/Submarine.aiff"
   :reload    "/System/Library/Sounds/Funk.aiff"
   :click     "/System/Library/Sounds/Basso.aiff"
   :door      "/System/Library/Sounds/Tink.aiff"
   :berserk   "/System/Library/Sounds/Hero.aiff"
   :heartbeat "/System/Library/Sounds/Bottle.aiff"})

(def state
  "Memoised session state: the resolved player binary and per-event
   sound files for this host. nil entries mean 'not yet resolved'.
   `:sfx-scalar` (default 1.0) is a global volume multiplier the
   settings page drives via set-sfx-scalar!; every play-sfx! event
   volume is scaled by it."
  (atom {:player nil :sounds nil :probed false :sfx-scalar 1.0}))

(def sfx-files
  "Memoised temp-WAV paths for baked Freedoom weapon sounds, keyed by
   event. Each baked sound is written to the temp dir once per session,
   then reused (the bytes are fixed)."
  (atom {}))

(defn- ensure-sfx-file!
  "If `event` has a baked Freedoom sound, decode it to a temp WAV (once)
   and return the path; nil when the event has no baked sound. The WAV
   is afplay/paplay-friendly 8-bit PCM. Only reached from play-sfx!,
   which is fully gated under PHEL_DOOM_SILENT, so tests never write."
  [event]
  (let [b64 (get freedoom-sfx event)]
    (when b64
      (or (get @sfx-files event)
          (let [path (str (php/sys_get_temp_dir) "/phel-doom-sfx-" (name event) ".wav")]
            (when (not (php/file_exists path))
              (php/file_put_contents path (php/base64_decode b64)))
            (swap! sfx-files assoc event path)
            path)))))

(defn set-sfx-scalar!
  "Set the global sfx volume multiplier (clamped to [0.0, 1.0]). Called
   from the settings page so SFX volume changes take effect on the next
   sound. 0.0 effectively mutes per-event sfx without touching the N
   sound toggle."
  [^float scalar]
  (swap! state assoc :sfx-scalar (php/max 0.0 (php/min 1.0 scalar))))

(defn- which
  "Return the path of `bin` if it's on PATH, else nil."
  [bin]
  (let [out (php/array)]
    (php/exec (str "command -v " bin " 2>/dev/null") out)
    (let [line (php/aget out 0)]
      (if (or (nil? line) (= line ""))
        nil
        line))))

(defn- resolve-player []
  (loop [bins player-binaries]
    (if (empty? bins)
      nil
      (if (which (first bins))
        (first bins)
        (recur (rest bins))))))

(defn- resolve-sounds
  "Pick a per-event sound map appropriate for this OS. Returns nil if
   the OS doesn't ship usable defaults."
  []
  (let [os (php/strtolower (php/php_uname "s"))]
    (if (php/str_contains os "darwin")
      macos-sounds
      nil)))

(defn- ensure-probed! []
  (let [s @state]
    (when (not (:probed s))
      ;; merge, not reset!: the probe must NOT clobber :sfx-scalar /
      ;; :mute-until. apply-audio-settings! runs set-sfx-scalar! BEFORE
      ;; the first probe (start-music! -> audio-player -> here), so a
      ;; reset! here would wipe the player's SFX volume back to 1.0 and
      ;; every shot would play at full volume regardless of the setting.
      (swap! state merge {:player (resolve-player)
                          :sounds (resolve-sounds)
                          :probed true}))))

(defn- play-file-async!
  "Fire-and-forget shell-out to the resolved audio player. Optional
   `volume` in [0.0, 1.0] is wired through afplay's `-v` flag (other
   players ignore it). Always backgrounded so the game loop never
   blocks."
  ([player path]                (play-file-async! player path 1.0))
  ([bin audio-path ^float vol] (let [v   (php/max 0.0 (php/min 1.0 vol))
                                     arg (if (php/=== bin "afplay")
                                           (str " -v " (php/number_format v 3))
                                           "")]
                                 (php/exec (str bin arg " "
                                                (php/escapeshellarg audio-path)
                                                " > /dev/null 2>&1 &")))))

(defn- bell! []
  (print "\a")
  (php/flush))

(defn- test-runner?
  "Belt-and-suspenders mute: detect the `phel test` CLI command from argv
   so the suite stays SILENT even if a runner forgets to export
   PHEL_DOOM_SILENT (make/composer/docker all set it now — this guarantees
   a bare `vendor/bin/phel test` never shells out to afplay either). Only
   matches the literal `test` command token, never the game runtime
   (`phel run phel-doom.main play`)."
  []
  (let [argv (php/aget php/$_SERVER "argv")]
    (if (php/is_array argv)
      (php/in_array "test" argv)
      false)))

(defn- muted?
  "Test gate: play-sfx! short-circuits and returns nil — no afplay, no
   terminal bell — when PHEL_DOOM_SILENT=1 OR the process is the `phel
   test` runner (`test-runner?`). Composer / make / docker test scripts
   set the env var; the argv check is the safety net so tests can NEVER
   trigger real audio. Game runtime matches neither, so play is unchanged."
  []
  (or (php/=== "1" (php/getenv "PHEL_DOOM_SILENT"))
      (test-runner?)))

(defn audio-player
  "Resolved audio-player binary for this host (afplay / paplay / aplay /
   play), or nil if none is on PATH. Probes once and memoises. Exposed
   so the OST loop (io/music) reuses the same resolution instead
   of duplicating the PATH probe."
  []
  (ensure-probed!)
  (:player @state))

(defn mute-for!
  "Stamp an absolute mute-until timestamp on the sound state atom so
   play-sfx! short-circuits for the next `seconds`. Stacks against an
   existing mute: never shortens. No-op when PHEL_DOOM_SILENT is set
   (tests stay deterministic)."
  [^float seconds]
  (when (not (muted?))
    (let [until (php/+ (php/microtime true) seconds)
          cur   (or (:mute-until @state) 0.0)]
      (swap! state assoc :mute-until (php/max cur until)))))

(defn- session-muted?
  "True while the wall-clock has not yet caught up to :mute-until on
   the state atom. Driven by mute-for! from the horror layer."
  []
  (let [until (or (:mute-until @state) 0.0)]
    (php/> until (php/microtime true))))

(defn play-sfx!
  "Play the sound effect tagged `event` (:shoot, :hit, :door,
   :heartbeat, :kill). Falls through to the terminal bell when no
   native player + file is available, so the game still gives
   feedback on bare/headless systems. Heartbeat skips the bell
   fallback so silent terminals don't get spammed by the bell once a
   second when the player is low on lives."
  ([event]                  (play-sfx! event 1.0))
  ([evt ^float volume]      (when (and (not (muted?)) (not (session-muted?)))
                              (ensure-probed!)
                              (let [s    @state
                                    p    (:player s)
                                    ;; Prefer a baked Freedoom weapon sound
                                    ;; (real DOOM-style report); fall back to
                                    ;; the per-OS system sound for everything
                                    ;; else (and on hosts without the baked map).
                                    path (or (ensure-sfx-file! evt)
                                             (and (:sounds s) (get (:sounds s) evt)))
                                    vol  (php/* volume (or (:sfx-scalar s) 1.0))]
                                (cond
                                  ;; SFX volume turned to 0 in settings:
                                  ;; stay fully silent, no bell fallback.
                                  (php/<= vol 0.0)
                                  nil

                                  (and p path (php/file_exists path))
                                  (play-file-async! p path vol)

                                  (= evt :heartbeat)
                                  nil

                                  :else
                                  (bell!))))))
