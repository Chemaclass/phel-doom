(ns phel-doom.io.music
  (:require phel-doom.io.sound :refer [audio-player]))

;; ---------------------------------------------------------------------
;; Background OST loop (issue #158).
;;
;; A driving, dark melodic riff under the run to evoke the original DOOM
;; without using any copyrighted asset. The original DOOM soundtrack
;; (Bobby Prince) is NOT free; several tracks also echo copyrighted
;; metal songs. So this is an ORIGINAL procedural composition — no WAD,
;; no shipped file.
;;
;; To avoid the 3-second riff looping audibly, we don't play one fixed
;; clip. session-riff concatenates several ornamented sections (variant-
;; riff — the ostinato with random 3rd/5th/octave stabs over the root
;; chug) into ONE long continuous track, seeded off the pid so every
;; session sounds fresh. It is baked once into a temp WAV and looped
;; whole by a backgrounded `sh`, so there are no player-relaunch gaps
;; between sections — only a brief one at the (much rarer) track wrap.
;; Rides the Music slider.
;;
;; The loop guards on `kill -0 <game-pid>` each iteration, so a crashed
;; / SIGKILLed game self-terminates the music within one clip instead of
;; orphaning a forever-looping player. Lifecycle is driven from
;; commands/play: start-music! when gameplay begins, stop-music! on
;; teardown, sync-music! on the N (sound) toggle, and pause-music! /
;; resume-music! (SIGSTOP/SIGCONT) on the pause edge so the OST freezes
;; with the game and resumes where it left off. All entry points are
;; no-ops under PHEL_DOOM_SILENT and on hosts with no audio player.
;; ---------------------------------------------------------------------

(def sample-rate 22050)

(def gain
  "Peak amplitude as a fraction of full scale before the per-note
   envelope. The riff sits under the sfx so shots / footsteps still cut
   through, so it stays moderate."
  0.5)

(def volume
  "Current afplay -v playback value for the OST (other players ignore
   it). Driven live from the settings Music slider via set-music-volume!.
   0.0 means 'no soundtrack'. Default matches a 50% Music setting, low
   enough that footsteps / shots still cut through."
  (atom 0.25))

(def proc
  "Session state for the loop process: `:pid` of the backgrounded
   shell, or nil when not running."
  (atom {:pid nil}))

(def doom-riff
  "An ORIGINAL driving riff in E minor (license-clean — not the E1M1
   theme). Each entry is a MIDI note number and a slot length in
   seconds; -1 is a rest. Eighth-note ostinato with a couple of
   higher stabs for menace. Total length is the loop period; the
   per-note envelope returns to silence inside every slot, so the wrap
   from the last slot back to the first is click-free (seamless)."
  [;; bar 1 — low chug on E with a minor-third lift
   {:midi 40 :dur 0.20} {:midi 40 :dur 0.20} {:midi 43 :dur 0.20} {:midi 40 :dur 0.20}
   {:midi 47 :dur 0.20} {:midi 40 :dur 0.20} {:midi 43 :dur 0.20} {:midi 45 :dur 0.20}
   ;; bar 2 — climb to the b5 stab, then resolve back down
   {:midi 40 :dur 0.20} {:midi 40 :dur 0.20} {:midi 47 :dur 0.20} {:midi 50 :dur 0.20}
   {:midi 51 :dur 0.20} {:midi 50 :dur 0.20} {:midi 47 :dur 0.20} {:midi 43 :dur 0.20}])

(def ornament-intervals
  "Scale-degree lifts above the chugging root (E, midi 40): minor 3rd (G),
   perfect 5th (B), octave (E). All sit inside E minor, so any random pick
   stays consonant with the ostinato — the '3/5/8' colour."
  [3 7 12])

(def ornament-chance
  "Percent chance a root chug hit is swapped for a random 3/5/8 stab. Low
   enough that the relentless E pulse still dominates; high enough that the
   ear hears the riff breathe differently each pass."
  22)

(def variant-reps
  "Copies of the base riff chained inside one section. >1 makes a section
   longer and gives the random stabs room to land in different bars."
  2)

(def track-sections
  "Distinct ornamented sections concatenated — back to back, gapless —
   into the one continuous session track. The whole track loops as a
   single file, so the only player-relaunch silence is at the track wrap;
   more sections push that wrap further apart. Each section is seeded
   differently, so the colour keeps shifting as the track plays."
  8)

(defn variant-riff
  "One OST variant: `reps` copies of `base` with random 3rd/5th/octave
   (root+3/+7/+12) stabs sprinkled over the chugging root hits, leaving the
   melodic slots untouched so the groove stays anchored. mt_rand is seeded
   from `seed`, so a given seed reproduces a given colouring (one seed per
   variant index keeps the baked set varied yet deterministic). Returns a
   {:midi :dur} vector ready for riff-wav-bytes. Like the base riff, every
   note still envelopes to zero, so clips stay click-free end to end."
  [base ^int reps ^int seed]
  (php/mt_srand seed)
  (let [out (php/array)]
    (dotimes [_ reps]
      (foreach [note base]
        (php/array_push
         out
         (if (and (php/=== 40 (:midi note))
                  (php/< (php/mt_rand 0 99) ornament-chance))
           {:midi (php/+ 40 (get ornament-intervals (php/mt_rand 0 2)))
            :dur  (:dur note)}
           note))))
    out))

(defn session-riff
  "The full per-session track: `track-sections` ornamented sections
   concatenated into one continuous note vector. Each section is seeded
   off `seed` + its index, so the colour keeps shifting across the track
   instead of repeating one phrase. Baked to a single WAV and looped as a
   whole, so there are no player-relaunch gaps between sections — only
   when the track wraps. Every note still envelopes to zero, so both the
   section joins and the loop wrap stay click-free."
  [^int seed]
  (let [out (php/array)]
    (dotimes [i track-sections]
      (foreach [note (variant-riff doom-riff variant-reps (php/+ seed i))]
        (php/array_push out note)))
    out))

(defn- silent? []
  (php/=== "1" (php/getenv "PHEL_DOOM_SILENT")))

(defn- midi->freq
  "Equal-temperament frequency for a MIDI note number (A4 = 69 = 440 Hz)."
  [^int midi]
  (php/* 440.0 (php/pow 2.0 (php// (php/- midi 69) 12.0))))

(defn- note-bytes
  "Return `dur` seconds of one voiced note (or a rest when midi < 0) at
   `sr` Hz, as a packed little-endian signed-16 PCM string. The tone is
   the fundamental plus a sub-octave for weight and two harmonics for
   grit, shaped by a fast-attack / exponential-decay / linear-release
   envelope. The release ramps the tail to exactly zero inside the slot
   so note boundaries — and the loop wrap — never click."
  [^int sr ^int midi ^float dur]
  (let [n      (php/intval (php/* sr dur))
        two-pi (php/* 2.0 php/M_PI)
        f      (if (php/< midi 0) 0.0 (midi->freq midi))
        ;; Decay constant: most of the note's energy is in its first
        ;; third, giving the chug its percussive bite.
        tau    (php/* dur 0.33)
        ;; Sum of partial weights — normalise so the mix can't clip.
        norm   (php// 1.0 2.4)
        ;; Local accumulator: a PHP array is copy-on-write, so the buffer
        ;; must be built and returned here rather than mutated through an
        ;; argument (array_push on a passed-in array hits the copy).
        buf    (php/array)]
    (dotimes [i n]
      (let [t   (php// i sr)
                   ;; 4 ms attack ramp in, 15% linear release out.
            atk (php/min 1.0 (php// t 0.004))
            rel (php/min 1.0 (php// (php/- n i) (php/* 0.15 n)))
            env (php/* atk rel (php/exp (php// (php/* -1.0 t) tau)))
            sig (if (php/<= f 0.0)
                  0.0
                  (php/+ (php/* 1.0 (php/sin (php/* two-pi f t)))
                         (php/* 0.6 (php/sin (php/* two-pi (php// f 2.0) t)))
                         (php/* 0.5 (php/sin (php/* two-pi (php/* f 2.0) t)))
                         (php/* 0.3 (php/sin (php/* two-pi (php/* f 3.0) t)))))
            v   (php/intval (php/round (php/* sig norm env gain 32767.0)))
            c   (php/max -32767 (php/min 32767 v))
            u   (if (php/< c 0) (php/+ 65536 c) c)]
        (php/array_push buf (php/pack "v" u))))
    (php/implode "" buf)))

(defn riff-wav-bytes
  "Synthesise `notes` (a vector of {:midi :dur}) into a complete 16-bit
   mono PCM WAV (header + data) at `sr` Hz. Pure: same args → same
   bytes, no IO. Exposed for unit tests (header + length pins)."
  [^int sr notes]
  (let [buf (php/array)]
    (foreach [note notes]
      (php/array_push buf (note-bytes sr (:midi note) (:dur note))))
    (let [data     (php/implode "" buf)
          data-len (php/strlen data)]
      (str "RIFF"
           (php/pack "V" (php/+ 36 data-len))
           "WAVE"
           "fmt "
           (php/pack "V" 16)
           (php/pack "v" 1)               ; PCM
           (php/pack "v" 1)               ; mono
           (php/pack "V" sr)
           (php/pack "V" (php/* sr 2))    ; byte rate (1ch * 2 bytes)
           (php/pack "v" 2)               ; block align
           (php/pack "v" 16)              ; bits per sample
           "data"
           (php/pack "V" data-len)
           data))))

(defn- music-path-prefix
  "Temp-path stem for this game process's baked track. The pid keeps
   concurrent games from clobbering each other and lets stop-music! /
   pause-music! target exactly this session's process by pattern."
  []
  (str (php/sys_get_temp_dir) "/phel-doom-music-" (php/getmypid)))

(defn- music-path []
  (str (music-path-prefix) ".wav"))

(defn- ensure-wav!
  "Bake this session's continuous track once (idempotent: an existing
   file is reused, so a volume-driven restart doesn't re-synth). Seeded
   off the pid, so a new game gets fresh 3/5/8 colourings. Returns the
   path, or nil if the write failed."
  []
  (let [path (music-path)]
    (if (php/file_exists path)
      path
      (let [ok (php/file_put_contents
                path
                (riff-wav-bytes sample-rate (session-riff (php/* (php/getmypid) 100))))]
        (if (php/=== false ok) nil path)))))

(defn- loop-command
  "The backgrounded shell that re-plays the continuous track `path` while
   the game process (`ppid`) is alive. The whole session track loops as
   one file, so the only silence is the brief player relaunch at the wrap
   — not between sections. afplay gets a -v volume; others just play the
   file. `& echo $!` prints the shell's PID so the caller can track +
   kill it."
  [player path ^int ppid]
  (let [vol (if (php/=== player "afplay")
              (str " -v " (php/number_format @volume 3))
              "")]
    (str "sh -c 'while kill -0 " ppid " 2>/dev/null; do "
         player vol " " (php/escapeshellarg path) " >/dev/null 2>&1; "
         "done' >/dev/null 2>&1 & echo $!")))

(defn start-music!
  "Begin the OST loop if it isn't already running. No-op under
   PHEL_DOOM_SILENT, when no audio player is on PATH, when the WAV can't
   be written, or when the music volume is 0 (player muted music in
   settings). Idempotent: a second call while running does nothing."
  []
  (when (and (not (silent?))
             (php/> @volume 0.0)
             (nil? (:pid @proc)))
    (let [player (audio-player)]
      (when player
        (let [path (ensure-wav!)]
          (when path
            (let [out (php/array)]
              (php/exec (loop-command player path (php/getmypid)) out)
              (let [pid (php/intval (or (php/aget out 0) 0))]
                (when (php/> pid 0)
                  (swap! proc assoc :pid pid))))))))))

(defn stop-music!
  "Stop the OST loop immediately: kill the loop shell (so it can't
   relaunch) then any player still playing our temp file. No-op when
   nothing is running. Safe to call on every teardown path."
  []
  (let [pid (:pid @proc)]
    (when pid
      ;; Wake first: a SIGSTOP-paused player can't receive the kill until
      ;; it continues, so resume it before tearing down.
      (php/exec (str "pkill -CONT -f " (php/escapeshellarg (music-path-prefix)) " 2>/dev/null"))
      (php/exec (str "kill " pid " 2>/dev/null"))
      (php/exec (str "pkill -f " (php/escapeshellarg (music-path-prefix)) " 2>/dev/null"))
      ;; Drop this session's baked track so temp doesn't accumulate.
      (php/exec (str "rm -f " (php/escapeshellarg (music-path-prefix)) "*.wav 2>/dev/null"))
      (swap! proc assoc :pid nil))))

(defn pause-music!
  "Suspend the OST in place so it resumes exactly where it left off:
   SIGSTOP the player (and its loop shell) via the session pattern. The
   loop shell is blocked waiting on the player, so it can't relaunch while
   paused. No-op when nothing is running. Idempotent."
  []
  (when (:pid @proc)
    (php/exec (str "pkill -STOP -f " (php/escapeshellarg (music-path-prefix)) " 2>/dev/null"))))

(defn resume-music!
  "Resume a paused OST (SIGCONT) from where it was suspended. No-op when
   nothing is running. Idempotent (CONT on a running process is harmless)."
  []
  (when (:pid @proc)
    (php/exec (str "pkill -CONT -f " (php/escapeshellarg (music-path-prefix)) " 2>/dev/null"))))

(defn set-music-volume!
  "Set the OST playback volume (clamped [0.0, 1.0]) from the settings
   page. When the loop is already running, restart it so the new -v
   takes effect immediately: a volume of 0 stops the soundtrack, any
   positive value relaunches at the new level. When nothing is running,
   just store the value so the next start-music! uses it."
  [^float v]
  (let [cv       (php/max 0.0 (php/min 1.0 v))
        running? (boolean (:pid @proc))]
    (reset! volume cv)
    (when running?
      (stop-music!)
      (when (php/> cv 0.0)
        (start-music!)))))

(defn sync-music!
  "Start or stop the OST to match the sound-on flag. Called when the
   player toggles sound (N)."
  [sound-on?]
  (if sound-on?
    (start-music!)
    (stop-music!)))
