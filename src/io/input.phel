(ns phel-doom.io.input)

(def mouse-enable
  "Escapes that turn ON xterm mouse reporting for FPS-style mouselook
   (issue #246): `\\e[?1003h` requests ANY-MOTION tracking (the terminal
   reports the pointer even with no button held), `\\e[?1006h` switches
   the reports to the SGR-extended encoding (`\\e[<b;x;y(M|m)`) that
   controls/mouse-look parses, and `\\e[>3p` (XTSMPOINTER, Ps=3) tells the
   terminal to ALWAYS hide the OS mouse pointer, even leaving/entering the
   window. The pointer-hide is load-bearing (#295): enabling tracking
   makes xterm's default (XTSMPOINTER 1 = hide only when tracking is OFF)
   SHOW the arrow, and `\\e[?25l` only hides the text caret - so without
   `\\e[>3p` the pointer stays visible over the 3D view. Emitted only when
   the Mouse setting is on, so an opted-out player keeps a normal pointer.
   Terminals without XTSMPOINTER ignore it (harmless); no escape can warp
   or confine the pointer, so this hides but cannot truly lock it."
  "\e[?1003h\e[?1006h\e[>3p")

(def mouse-disable
  "Reverse of `mouse-enable`: disable any-motion tracking + SGR mode and
   restore the default pointer visibility (`\\e[>1p`, XTSMPOINTER 1) so the
   terminal stops capturing + force-hiding the pointer on teardown. Always
   emitted on restore! (idempotent / harmless even if the mouse was never
   enabled this session)."
  "\e[?1003l\e[?1006l\e[>1p")

(defn init-escapes
  "Pure: the terminal-setup escape string init-input! emits. Alt screen
   (`\\e[?1049h`) + hide cursor (`\\e[?25l`) + no autowrap (`\\e[?7l`) +
   clear/home (`\\e[2J\\e[H`) + kitty keyboard opt-in (`\\e[>3u`), then
   the xterm mouse-reporting escapes (`mouse-enable`) appended ONLY when
   `mouse?` is true (#246). Split out from the side-effecting init-input!
   so the mouse gating is unit-testable without touching the terminal."
  [mouse?]
  (str "\e[?1049h\e[?25l\e[?7l\e[2J\e[H\e[>3u"
       (if mouse? mouse-enable "")))

(def unhideable-pointer-terminals
  "TERM_PROGRAM values for terminals known NOT to implement XTSMPOINTER, so
   `\\e[>3p` can't hide the OS mouse pointer there (#295) - the hard #313
   limit. Maps the raw env value to a friendly name for the startup notice.
   A small DENYlist (only the sure cases) so unknown terminals are assumed
   capable and never falsely nagged; `\\e[>3p` is sent to all regardless and
   is harmless where ignored."
  {"iTerm.app"      "iTerm2"
   "Apple_Terminal" "Apple Terminal"
   "vscode"         "VS Code"})

(defn pointer-limit-notice
  "Pure: a one-line startup notice for a terminal that can't hide the OS
   pointer, or nil when `term` (a $TERM_PROGRAM value) is capable / unknown.
   Split from the IO so the wording + gating are unit-testable."
  [term]
  (let [name (get unhideable-pointer-terminals term)]
    (when (some? name)
      (str "\e[2mphel-doom: " name " can't hide the OS mouse pointer "
           "(terminal limit). Your aim is the centred + crosshair - mouse "
           "MOTION turns the view; the visible arrow is cosmetic.\e[0m\n"))))

(defn terminal-program
  "The terminal identifier from $TERM_PROGRAM (\"\" when unset). Reads the
   environment, so it is side-effecting (not pure)."
  []
  (or (php/getenv "TERM_PROGRAM") ""))

(defn announce-pointer-limit!
  "Identify the terminal at startup (#295) and, when the Mouse setting is on
   AND this terminal can't hide the OS pointer, print a one-line notice then
   pause ~1.5s so it is readable before the alt screen takes over. No-op
   otherwise. Call BEFORE init-input! (before the alt screen). Side-effecting."
  [mouse?]
  (when mouse?
    (let [notice (pointer-limit-notice (terminal-program))]
      (when (some? notice)
        (print notice)
        (php/flush)
        (php/usleep 1500000)))))

(defn init-input!
  "Put the terminal in non-blocking raw mode so we can read single keys
   without waiting for Enter. Switch to the alternate screen buffer and
   hide the cursor to avoid flicker during the render loop.

   Kitty keyboard protocol opt-in: `CSI > 3 u` pushes flags
   `disambiguate (1) | report-event-types (2)`. Supporting terminals
   (kitty, WezTerm, Ghostty, recent iTerm2/Alacritty) then send real
   press / repeat / release events for keys, which controls.phel
   parses to clear movement slots instantly on release. Non-supporting
   terminals ignore the opt-in and we fall back to the legacy byte
   stream + hold-frames bridge.

   `mouse?` (default true) gates the xterm mouse-reporting escapes
   (`mouse-enable`) for FPS-style mouselook (issue #246). When the Mouse
   setting is off the caller passes false and no mouse escapes are sent,
   so the terminal never captures the pointer."
  [& [mouse?]]
  (php/exec "stty -icanon -echo min 0 time 0")
  (php/stream_set_blocking php/STDIN false)
  (print (init-escapes (if (nil? mouse?) true mouse?))))

(defn rearm-mouse!
  "Re-assert the xterm mouse-reporting escapes (`mouse-enable`) so pointer
   reports re-arm after a focus loss / regain or a resize (#288). A
   terminal can silently drop mouse tracking on a mode flip; init-input!
   only enables it once at startup, so without a periodic / on-resize
   re-assert mouselook can go quiet even though the pointer is still over
   the window. Idempotent (the same escapes init-input! sent), gated by
   the caller on the Mouse setting so an opted-out player is untouched.
   `\\e[?25l` is bundled to keep the caret hidden across the same mode
   flip. Side-effecting: emits to STDOUT, hence the `!`."
  []
  (print "\e[?25l")
  (print mouse-enable))

(defn- drain-stdin!
  "Read and discard pending STDIN bytes for up to `ms` milliseconds.
   Used on teardown to swallow an in-flight kitty key-release report for
   the quit key, which would otherwise echo onto the shell prompt once
   cooked mode is restored."
  [^int ms]
  (let [deadline (php/+ (php/microtime true) (php// (php/* 1.0 ms) 1000.0))]
    (loop []
      (php/fread php/STDIN 256)
      (php/usleep 10000)
      (when (php/< (php/microtime true) deadline)
        (recur)))))

(def restore-prelude
  "Pure: the first escape burst restore! emits - pop the kitty keyboard
   flags (`\\e[<u`) AND disable mouse reporting (`mouse-disable`) so the
   terminal stops emitting key / pointer reports before the teardown
   drain. mouse-disable is always sent (harmless if mouse was never
   enabled). Split out so the teardown contract is unit-testable."
  (str "\e[<u" mouse-disable))

(defn restore!
  "Pop any kitty keyboard flags this session pushed, disable mouse
   reporting, restore cooked terminal mode and leave the alternate
   screen buffer."
  []
  ;; Pop the kitty protocol + mouse reporting first so the terminal
  ;; stops emitting key / pointer reports, then swallow the trailing
  ;; release event for the quit key before cooked mode (echo on) would
  ;; print it to the shell.
  (print restore-prelude)
  (php/flush)
  (drain-stdin! 120)
  (print "\e[?25h\e[?7h\e[?1049l")
  (php/exec "stty sane"))

(def drain-bytes
  "Per-frame STDIN read budget. Sized to hold a frame's worth of input
   without truncating a multi-byte sequence mid-escape: a fast mouse
   drag under any-motion tracking (#246) floods many ~12-byte SGR
   reports, and the SGR parser silently drops a half-read trailing
   report, so a generous buffer keeps the look delta smooth. Held keys
   still apply their motion multiple times per frame instead of being
   throttled by the loop's read-one-key cadence."
  512)

(defn drain-keys
  "Drain all pending input bytes as a raw string (possibly empty). Lets
   a held key apply its motion multiple times per frame instead of being
   throttled by the loop's read-one-key cadence."
  []
  (let [s (php/fread php/STDIN drain-bytes)]
    (if (= s false) "" s)))
