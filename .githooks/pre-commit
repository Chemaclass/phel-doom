#!/usr/bin/env bash
# pre-commit: run the same gates CI runs (format-check + lint + test + build)
# so we never push code that would turn CI red.
#
# Wired via `git config core.hooksPath .githooks`, set up automatically by
# the composer post-install-cmd. Bypass with `git commit --no-verify` only
# in genuine emergencies.

set -e

if ! command -v composer >/dev/null 2>&1; then
  echo "pre-commit: composer not on PATH; skipping CI gate" >&2
  exit 0
fi

if [ ! -x vendor/bin/phel ]; then
  echo "pre-commit: vendor/bin/phel missing; run 'composer install' first" >&2
  exit 1
fi

echo "pre-commit: running 'composer ci' ..."
composer --quiet ci
