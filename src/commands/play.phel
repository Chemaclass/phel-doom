(ns phel-doom.commands.play
  (:require phel.cli :as cli)
  (:require phel.string :as str)
  (:require phel-doom.modules.core.state    :refer [advance-game-time gain-life max-lives
                                                    toggle-debug toggle-map toggle-pause toggle-sound])
  (:require phel-doom.modules.core.map      :refer [door?])
  (:require phel-doom.modules.glue.controls :refer [refresh-from-keys key-states rising-edges
                                                    initial-key-snapshot])
  (:require phel-doom.modules.core.physics  :refer [apply-physics tick-heartbeat tick-flicker tick-blood-drops tick-door-face])
  (:require phel-doom.modules.core.combat   :refer [ammo-per-box damage-step max-reserve reload reloading? reload-cooldown-seconds tick-shooting])
  (:require phel-doom.modules.core.enemy    :refer [advance tick-scare rear-attacker?])
  (:require phel-doom.modules.io.sound    :refer [play-sfx! mute-for!])
  (:require phel-doom.modules.core.level    :refer [build-world num-levels])
  (:require phel-doom.modules.io.scores   :refer [update-scores!])
  (:require phel-doom.modules.io.render   :refer [render! clear-screen
                                                  read-perf-snapshot
                                                  render-start-menu
                                                  render-death-screen render-victory-screen])
  (:require phel-doom.modules.io.input    :refer [init-input! restore! drain-keys]))

;; ---------------------------------------------------------------------
;; The play subcommand wires together:
;;   - Terminal IO            (term-size, render!, drain-keys, sleep)
;;   - Per-frame state tick   (tick-world, pure — exported for tests)
;;   - Per-run lifecycle      (run-play → levels, end screens, restart)
;;
;; Per-domain logic (physics, combat, controls) lives in dedicated
;; modules; this file is the orchestration layer.
;; ---------------------------------------------------------------------

(def frame-us
  "Microseconds to usleep at the end of each frame. Render time is the
   real throttle; this just yields the CPU."
  1000)

;; =====================================================================
;; § Terminal IO helpers
;; =====================================================================

(def default-term-size
  "Fallback [rows cols] when stty isn't available (CI, piped input)."
  [24 80])

(defn- parse-stty-line [line]
  (if (or (nil? line) (= line ""))
    nil
    (let [parts (php/explode " " line)]
      [(php/intval (php/aget parts 0))
       (php/intval (php/aget parts 1))])))

(defn- term-size
  "Current terminal [rows cols]. Falls back when stty can't answer."
  []
  (let [out (php/array)]
    (php/exec "stty size 2>/dev/null" out)
    (or (parse-stty-line (php/aget out 0)) default-term-size)))

;; =====================================================================
;; § Per-frame tick orchestration (pure, exported for tests)
;; =====================================================================

(defn- about-face
  "Snap the player's facing by π (180° turn). Triggered by the rising
   edge on the `e` key in the game loop."
  [world]
  (update-in world [:player :angle] (fn [a] (php/+ a php/M_PI))))

(defn- handle-toggles
  "Apply rising-edge toggle keys (pause / minimap / sound / debug /
   about-face) for this frame. Debug edge stays outside the paused
   short-circuit so F3 still flips the overlay while paused."
  [world edges]
  (let [after-pause (if (:toggle-pause edges) (toggle-pause world) world)
        after-map   (if (:toggle-map edges) (toggle-map after-pause) after-pause)
        after-sound (if (:toggle-sound edges) (toggle-sound after-map) after-map)
        after-debug (if (:toggle-debug edges) (toggle-debug after-sound) after-sound)]
    (if (:about-face edges) (about-face after-debug) after-debug)))

(defn- tick-enemies
  "Step every alive enemy one dt-scaled frame toward the player, using
   the world's per-level chase speed."
  [world ^float dt]
  (let [p (:player world)]
    (update world :enemies advance (:grid world) (:x p) (:y p) dt
            (or (:chase-speed world) 0.75))))

(defn- heart-at-cell? [h px py]
  (and (php/=== (php/intval (:x h)) px)
       (php/=== (php/intval (:y h)) py)))

(defn- hearts-not-at [hearts px py]
  (apply vector
         (filter (fn [h] (not (heart-at-cell? h px py))) hearts)))

(defn- pickup-hearts
  "If the player stands on a heart cell, consume it and gain a life."
  [world]
  (let [kept (hearts-not-at (:hearts world)
                            (php/intval (:x (:player world)))
                            (php/intval (:y (:player world))))]
    (if (= (count kept) (count (:hearts world)))
      world
      (let [healed (assoc world :hearts kept)]
        (when (:sound-on world) (play-sfx! :door))
        (gain-life healed)))))

(defn- armors-not-at [armors px py]
  (apply vector
         (filter (fn [a]
                   (not (and (php/=== (php/intval (:x a)) px)
                             (php/=== (php/intval (:y a)) py))))
                 (or armors []))))

(defn- pickup-armors
  "Step-on triggers an armor pickup: bumps :armor by 1 (stacks). The
   next contact-damage hit consumes one armor unit instead of a life
   (see combat/take-damage)."
  [world]
  (let [kept (armors-not-at (:armors world)
                            (php/intval (:x (:player world)))
                            (php/intval (:y (:player world))))]
    (if (= (count kept) (count (or (:armors world) [])))
      world
      (let [shielded (assoc world :armors kept)]
        (when (:sound-on world) (play-sfx! :door))
        (update shielded :armor (fn [a] (php/+ (or a 0) 1)))))))

(defn- ammo-boxes-not-at [boxes px py]
  (apply vector
         (filter (fn [b]
                   (not (and (php/=== (php/intval (:x b)) px)
                             (php/=== (php/intval (:y b)) py))))
                 (or boxes []))))

(defn- pickup-ammos
  "Step-on triggers an ammo-box pickup: bumps :ammo-reserve by
   `ammo-per-box`, capped at `max-reserve`. Box is removed from the
   world so the player can't farm a single cell."
  [world]
  (let [kept (ammo-boxes-not-at (:ammo-boxes world)
                                (php/intval (:x (:player world)))
                                (php/intval (:y (:player world))))]
    (if (= (count kept) (count (or (:ammo-boxes world) [])))
      world
      (let [refilled (assoc world :ammo-boxes kept)]
        (when (:sound-on world) (play-sfx! :door))
        (update refilled :ammo-reserve
                (fn [r] (php/min max-reserve (php/+ (or r 0) ammo-per-box))))))))

(defn- on-door?
  "True when the player's current cell is a door (auto-advances level)."
  [world]
  (let [p (:player world)]
    (door? (:grid world) (php/intval (:x p)) (php/intval (:y p)))))

(defn tick-world
  "Pure one-frame state transition. `keys` is the drained input string,
   `dt` is seconds since the previous tick, `edges` is the rising-edge
   map ({:fire :toggle-map :toggle-pause :toggle-sound :about-face}).
   Physics and AI skip while the world is paused. The pipeline reads
   top-to-bottom: handle one-shots, refresh held-key counters, run
   physics, collect pickups, advance enemies, resolve a shot, decay
   timers + apply contact damage."
  [world keys ^float dt edges]
  (let [w0 (handle-toggles world edges)]
    (if (:paused w0)
      w0
      ;; Linear pipeline. Each step takes the previous world + its
      ;; own deps and returns a new world. Phel `->` would be nicer
      ;; but the lint pass doesn't macro-expand it (arity-mismatch
      ;; false positives), so stick with sequential let bindings.
      (let [w1  (refresh-from-keys w0 keys)
            w2  (apply-physics w1 dt)
            w3  (pickup-hearts w2)
            w4  (pickup-armors w3)
            w4b (pickup-ammos  w4)
            w5  (tick-enemies  w4b dt)
            w5b (if (:reload edges)
                  (do
                    (when (and (:sound-on w5) (reloading? w5)) (play-sfx! :reload))
                    (reload w5))
                  w5)
            w6  (tick-shooting w5b (:fire edges))
            w7  (damage-step   w6 dt)
            w8  (tick-heartbeat w7 dt)
            w9  (tick-flicker  w8 dt)
            w10 (tick-scare    w9 dt)
            w11 (tick-blood-drops w10 dt)
            w12 (tick-door-face w11 dt)]
        (advance-game-time w12 dt)))))

;; =====================================================================
;; § Per-frame IO + stats
;; =====================================================================

(defn- frame-stats
  "Snapshot of `world` + per-frame timing the render layer needs."
  [world fps frame-ms]
  {:fps         fps
   :frame-ms    frame-ms
   :kills       (:kills world)
   :lives       (:lives world)
   :armor       (:armor world)
   :max-lives   max-lives
   :iframes     (:iframes world)
   :fire-anim   (:fire-anim world)
   :intro-secs  (:intro-secs world)
   :flash-secs  (:flash-secs world)
   :fx          (:fx world)
   :paused      (:paused world)
   :sound-on    (:sound-on world)
   :level       (:level world)
   :level-name  (:level-name world)
   :hurt-side   (:hurt-side world)
   :streak      (:streak world)
   :heat        (:heat world)
   :jam-secs    (:jam-secs world)
   :heartbeat-phase (:heartbeat-phase world)
   :flicker-active-secs (:flicker-active-secs world)
   :scare-secs (:scare-secs world)
   :blood-drops (:blood-drops world)
   :door-face-active-secs (:door-face-active-secs world)
   :game-time   (or (:game-time world) 0.0)
   :debug?      (:debug? world)
   :perf-stats  (when (:debug? world) (read-perf-snapshot))
   :mag         (or (:mag world) 0)
   :ammo-reserve (or (:ammo-reserve world) 0)
   :reload-cooldown (or (:reload-cooldown world) 0.0)
   :reload-duration reload-cooldown-seconds
   :empty-click-secs (or (:empty-click-secs world) 0.0)
   :rear-warning? (rear-attacker? (:enemies world)
                                  (:x (:player world))
                                  (:y (:player world))
                                  (:angle (:player world)))
   :enemy-head-code      (:enemy-head-code world)
   :enemy-body-code      (:enemy-body-code world)
   :enemy-legs-code      (:enemy-legs-code world)
   :enemy-body-glyph     (:enemy-body-glyph world)
   :enemy-body-glyph-alt (:enemy-body-glyph-alt world)
   :enemy-body-glyph-fg  (:enemy-body-glyph-fg world)
   :enemy-face           (:enemy-face world)
   :enemy-face-alt       (:enemy-face-alt world)
   :enemy-face-attack    (:enemy-face-attack world)})

(defn- ms-since
  "Whole-millisecond delta between two microtime samples. Args tagged
   ^float so Phel doesn't infer int from the * 1000 op and implicitly
   downcast a microtime() value at the call site."
  [^float t-then ^float t-now]
  (php/intval (php/* (php/- t-now t-then) 1000)))

(defn- fps-from-ms
  "Instant fps estimate from one frame's ms cost. 0 if delta < 1ms."
  [ms]
  (if (php/> ms 0) (php/intval (php// 1000.0 ms)) 0))

;; =====================================================================
;; § Per-level result kinds returned by game-loop
;; =====================================================================

(defn- result-game-over [world ^float t-start ^float now]
  {:game-over  true
   :kills      (:kills world)
   :level      (:level world)
   :level-name (:level-name world)
   :survived-s (php/intval (php/- now t-start))})

(defn- result-victory [world ^float t-start ^float now]
  {:victory    true
   :kills      (:kills world)
   :level      (:level world)
   :level-name (:level-name world)
   :survived-s (php/intval (php/- now t-start))})

(defn- result-next-level [world ^float t-start ^float now]
  {:next-level true
   :level      (php/+ (:level world) 1)
   :kills      (:kills world)
   :lives      (:lives world)
   :survived-s (php/intval (php/- now t-start))})

(defn- play-door-sfx [world]
  (when (:sound-on world) (play-sfx! :door)))

(defn- door-result
  "When the player steps on a door: either victory (final level) or
   the next-level result."
  [world ^float t-start ^float now]
  (play-door-sfx world)
  (if (php/>= (:level world) num-levels)
    (result-victory world t-start now)
    (result-next-level world t-start now)))

;; =====================================================================
;; § Game loop (one level)
;; =====================================================================

(defn- redraw-if-resized [dims rows cols]
  (when (not= [rows cols] dims) (clear-screen)))

(defn- draw-frame [world fps frame-ms rows cols]
  (render! world (frame-stats world fps frame-ms) cols rows)
  (php/usleep frame-us))

(defn- game-loop [world0]
  (let [t-start (php/microtime true)]
    (loop [world     world0
           t-last    t-start
           frame-ms  0
           fps       0
           prev-keys initial-key-snapshot
           dims      [0 0]]
      (let [[rows cols] (term-size)]
        (redraw-if-resized dims rows cols)
        (draw-frame world fps frame-ms rows cols)
        (let [keys     (drain-keys)
              now      (php/microtime true)
              ms       (ms-since t-last now)
              now-keys (key-states keys)
              world'   (tick-world world keys (php// ms 1000.0)
                                   (rising-edges now-keys prev-keys))]
          (when (and (:heartbeat-tick? world') (:sound-on world'))
            (play-sfx! :heartbeat 0.35))
          (when (and (:silence-tick? world') (:sound-on world'))
            (mute-for! 0.4))
          (cond
            (str/contains? keys "q")   :quit
            (php/<= (:lives world') 0) (result-game-over world' t-start now)
            (on-door? world')          (door-result      world' t-start now)
            :else                      (recur world' now ms
                                              (fps-from-ms ms)
                                              now-keys
                                              [rows cols])))))))

;; =====================================================================
;; § End screens (death / victory)
;; =====================================================================

(defn- end-loop
  "Render an end screen each frame until the user picks:
     q  quit
     r  restart with a fresh random seed (new maps)
     R  restart with the SAME random seed (same map sequence) —
        useful when the player wants a replay attempt at a tough
        spawn or wall layout.
   `render-fn` takes (cols rows) and draws the variant."
  [render-fn]
  (loop [dims [0 0]]
    (let [[rows cols] (term-size)]
      (redraw-if-resized dims rows cols)
      (render-fn cols rows)
      (php/usleep 16000)
      (let [keys (drain-keys)]
        (cond
          (str/contains? keys "q") :quit
          (str/contains? keys "R") :restart-same
          (str/contains? keys "r") :restart
          :else                    (recur [rows cols]))))))

(defn- death-loop [kills survived-s level level-name scores]
  (end-loop (fn [cols rows]
              (render-death-screen cols rows kills survived-s level level-name scores))))

(defn- victory-loop [kills survived-s level level-name scores]
  (end-loop (fn [cols rows]
              (render-victory-screen cols rows kills survived-s level level-name scores))))

;; =====================================================================
;; § Run lifecycle (level chain + restart)
;; =====================================================================

(defn- carry-on [carry-kills carry-time result]
  [(php/+ carry-kills (:kills result))
   (php/+ carry-time  (:survived-s result))])

(defn- maybe-restart
  "Run the end-loop and pass the raw choice (:quit / :restart /
   :restart-same) back to run-levels so it can branch on which kind
   of restart the player asked for."
  [end-fn kills survived-s level level-name scores]
  (clear-screen)
  (let [choice (end-fn kills survived-s level level-name scores)]
    (clear-screen)
    choice))

(defn- handle-end
  "Show the end screen for `end-fn` (death or victory), persist the
   bests, and translate the player's choice into a vector that
   run-levels can match on:
     [:quit]              quit out
     [:fresh]             restart with a fresh PRNG seed
     [:same seed]         restart re-using the saved seed
   Anything else returns [:quit]."
  [end-fn k t result seed victory?]
  (let [choice (maybe-restart end-fn k t
                              (:level result)
                              (:level-name result)
                              (update-scores! k (:level result) t victory?))]
    (cond
      (= choice :restart-same) [:same seed]
      (= choice :restart)      [:fresh]
      :else                    [:quit])))

(defn- run-levels
  "Outer loop driving one full run. Each iteration captures a fresh
   PRNG seed before calling build-world so the player can replay the
   SAME map sequence by hitting R on an end screen (fresh seed = lower
   r, same seed = capital R). Lives + kills + time carry across
   levels; death/victory both update the persisted scores file."
  []
  (loop [level       1
         lives       max-lives
         carry-kills 0
         carry-time  0
         seed        (php/mt_rand)]
    (php/mt_srand seed)
    (let [result (game-loop (build-world level lives))]
      (cond
        (= result :quit)
        nil

        (and (map? result) (:next-level result))
        (let [[k t] (carry-on carry-kills carry-time result)]
          (recur (:level result) (:lives result) k t (php/mt_rand)))

        (and (map? result) (:victory result))
        (let [[k t]           (carry-on carry-kills carry-time result)
              [kind new-seed] (handle-end victory-loop k t result seed true)]
          (cond
            (= kind :fresh) (recur 1 max-lives 0 0 (php/mt_rand))
            (= kind :same)  (recur 1 max-lives 0 0 new-seed)
            :else           nil))

        (and (map? result) (:game-over result))
        (let [[k t]           (carry-on carry-kills carry-time result)
              [kind new-seed] (handle-end death-loop k t result seed false)
              died-on         (or (:level result) 1)]
          (cond
            ;; r: try the level you died on again with a fresh map.
            (= kind :fresh) (recur died-on max-lives 0 0 (php/mt_rand))
            ;; R: replay the exact level you died on (same seed + same
            ;; level number reproduces identical geometry + enemies).
            (= kind :same)  (recur died-on max-lives 0 0 new-seed)
            :else           nil))

        :else
        nil))))

(defn- print-credits []
  (println)
  (println "  \e[1mphel-doom\e[0m  by \e[1mChemaclass\e[0m  https://github.com/Chemaclass/phel-doom")
  (println "  written in \e[1mPhel Lang\e[0m  https://phel-lang.org/")
  (println))

(defn- show-start-menu!
  "Block until the user presses any key on the start screen. Re-draws
   each frame so terminal resizes don't leave a stale half-painted box."
  []
  (loop [dims [0 0]]
    (let [[rows cols] (term-size)]
      (redraw-if-resized dims rows cols)
      (render-start-menu cols rows)
      (php/usleep 16000)
      (let [keys (drain-keys)]
        (if (php/=== keys "")
          (recur [rows cols])
          (when (str/contains? keys "q")
            :quit))))))

(defn- run-play [ctx]
  (init-input!)
  (if (php/=== (show-start-menu!) :quit)
    (do (restore!)
        (clear-screen)
        0)
    (do (clear-screen)
        (run-levels)
        (restore!)
        (clear-screen)
        (cli/success ctx "Thanks for playing.")
        (print-credits)
        0)))

(def play-command
  {:name "play"
   :doc  "Start the DOOM showcase. WASD / arrow keys move + turn,
          space fires, M toggles the minimap, N toggles sound,
          P pauses, Q quits. Walk into a door to advance levels."
   :run  run-play})
