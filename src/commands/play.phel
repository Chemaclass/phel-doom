(ns phel-doom.commands.play
  (:require phel.cli :as cli)
  (:require phel.string :as str)
  (:require phel-doom.modules.state  :refer [new-player new-world move-player turn-player toggle-map with-enemies])
  (:require phel-doom.modules.map    :refer [random-grid random-spawn wall?])
  (:require phel-doom.modules.engine :refer [cast-ray])
  (:require phel-doom.modules.enemy  :refer [spawn-enemies advance shoot])
  (:require phel-doom.modules.render :refer [render! clear-screen])
  (:require phel-doom.modules.input  :refer [init-input! restore! drain-keys]))

(def move-speed
  "World units per second when the player holds forward, back, or strafe."
  4.5)
(def turn-speed
  "Radians per second when the player holds a turn arrow."
  3.0)
(def move-hold-frames
  "Frames a movement direction (W/S/A/D) stays active after each input
   byte. Terminal auto-repeat typically interrupts when another key is
   pressed, so we keep movement 'warm' for ~200ms — long enough to
   compose forward + turn even when the W repeat pauses while the arrow
   takes over the byte stream."
  12)
(def turn-hold-frames
  "Frames a turn direction (←/→) stays active. Shorter than the move
   hold so a single arrow tap rotates a precise small amount instead
   of overshooting."
  5)
(def frame-us 1000)
(def map-w 32)
(def map-h 22)
(def num-enemies 10)
(def enemy-min-spawn-dist 3.0)
(def shot-hit-radius
  "How far off-axis a shot may miss the enemy's center and still count
   as a hit. ~half an enemy 'cell'."
  0.5)
(def shot-max-range 12.0)
(def touch-damage-dist
  "If an alive enemy gets this close (units), the player loses a life."
  0.7)
(def iframe-seconds
  "Seconds of post-hit invulnerability so a single touch doesn't drain
   multiple lives across consecutive frames."
  1.0)
(def fire-anim-seconds
  "How long the muzzle flash / tracer stays visible after each shot."
  0.09)
(def fx-ttl-seconds
  "Initial life of a blood splatter effect — visually fades down to 0."
  0.45)

(defn- term-size
  "Query the terminal for [rows cols] via stty. Falls back to a
   sensible default if stty isn't available (e.g. piped input)."
  []
  (let [out (php/array)]
    (php/exec "stty size 2>/dev/null" out)
    (let [line (php/aget out 0)]
      (if (or (nil? line) (= line ""))
        [24 80]
        (let [parts (php/explode " " line)]
          [(php/intval (php/aget parts 0)) (php/intval (php/aget parts 1))])))))

(defn- try-move [world dx dy]
  (let [{:keys [grid player]} world
        nx                    (+ (:x player) dx)
        ny                    (+ (:y player) dy)]
    (if (wall? grid (php/intval nx) (php/intval ny))
      world
      (move-player world dx dy))))

(defn- refresh-move [world k]
  (cond
    (or (= k "^") (= k "w")) (assoc-in world [:moves :fwd]          move-hold-frames)
    (or (= k "_") (= k "s")) (assoc-in world [:moves :back]         move-hold-frames)
    (= k "<")                (assoc-in world [:moves :turn-left]    turn-hold-frames)
    (= k ">")                (assoc-in world [:moves :turn-right]   turn-hold-frames)
    (= k "a")                (assoc-in world [:moves :strafe-left]  move-hold-frames)
    (= k "d")                (assoc-in world [:moves :strafe-right] move-hold-frames)
    :else                    world))

(defn- refresh-from-keys
  "Walk the drained input string, resetting the matching direction
   counter for every input byte. Arrow-key escape sequences are
   normalised to single-byte placeholders (^ _ < >) so the per-byte
   loop can treat them like ordinary keys. Held keys (terminal repeat)
   keep refreshing; orthogonal keys layer onto the same world."
  [world keys]
  (let [normalized (php/str_replace (php/array "\e[A" "\e[B" "\e[D" "\e[C")
                                    (php/array "^"    "_"    "<"    ">")
                                    keys)]
    (let [n (php/strlen normalized)]
      (loop [i 0 w world]
        (if (php/>= i n)
          w
          (recur (php/+ i 1) (refresh-move w (php/substr normalized i 1))))))))

(defn- touching?
  "True iff any alive enemy is within touch-damage-dist of (px, py)."
  [enemies px py]
  (loop [es enemies]
    (cond
      (php/=== es nil) false
      :else            (let [e (first es)]
                         (if (and e (:alive e)
                                  (let [dx (php/- (:x e) px)
                                        dy (php/- (:y e) py)]
                                    (php/<= (php/+ (php/* dx dx) (php/* dy dy))
                                            (php/* touch-damage-dist touch-damage-dist))))
                           true
                           (recur (next es)))))))

(defn- decay-fx [fx dt]
  (apply vector
         (filter (fn [e] (php/> (:ttl e) 0.0))
                 (map (fn [e] (assoc e :ttl (php/- (:ttl e) dt)))
                      (or fx [])))))

(defn- damage-step
  "Tick the i-frame, fire-anim, and fx timers down by dt; if no
   i-frames are left and an enemy is touching the player, subtract a
   life and start a fresh i-frame window."
  [world dt]
  (let [i  (php/max 0.0 (php/- (:iframes world) dt))
        fa (php/max 0.0 (php/- (or (:fire-anim world) 0.0) dt))]
    (let [w' (-> world
                 (assoc :iframes i)
                 (assoc :fire-anim fa)
                 (update :fx decay-fx dt))
          p  (:player world)]
      (if (and (php/<= i 0.0) (touching? (:enemies w') (:x p) (:y p)))
        (-> w' (update :lives (fn [l] (php/max 0 (php/- l 1))))
            (assoc :iframes iframe-seconds))
        w'))))

(defn- fire-shot
  "Resolve one trigger pull: hitscan along the player's facing, taking
   wall occlusion and a small off-axis tolerance into account. On hit:
   bump :kills, push a blood splatter at the kill site, and respawn a
   fresh enemy in the slot so the arena stays populated."
  [world]
  (let [p (:player world)]
    (let [wall-d (cast-ray (:pgrid world) (:x p) (:y p) (:angle p))]
      (let [[es hit? hit-pos idx] (shoot (:enemies world) (:x p) (:y p) (:angle p)
                                         wall-d shot-hit-radius shot-max-range)]
        (if hit?
          (let [respawn (first (spawn-enemies (:grid world) 1
                                              enemy-min-spawn-dist (:x p) (:y p)))]
            (-> world
                (assoc :enemies (if respawn (assoc es idx respawn) es))
                (update :kills (fn [k] (php/+ k 1)))
                (assoc :fire-anim fire-anim-seconds)
                (update :fx (fn [fx]
                              (conj (or fx [])
                                    {:x (:x hit-pos) :y (:y hit-pos) :ttl fx-ttl-seconds})))))
          (assoc world :fire-anim fire-anim-seconds))))))

(defn- apply-physics
  "Per-frame physics step. Active direction counters contribute dt-scaled
   motion: turn first (so strafing and forward use the new heading), then
   combine longitudinal (fwd/back) and lateral (strafe-left/right) into
   one composite move along the current facing. Every counter is then
   decremented; zero means that direction stops on its own."
  [world dt]
  (let [m (:moves world)]
    (assoc
     (let [turn-by (php/- (if (php/> (:turn-right m) 0) (php/* turn-speed dt) 0.0)
                          (if (php/> (:turn-left m) 0)  (php/* turn-speed dt) 0.0))]
       (let [turned (if (php/=== turn-by 0.0) world (turn-player world turn-by))]
         (let [a      (:angle (:player turned))
               long-d (php/- (if (php/> (:fwd m) 0)  (php/* move-speed dt) 0.0)
                             (if (php/> (:back m) 0) (php/* move-speed dt) 0.0))
               lat-d  (php/- (if (php/> (:strafe-right m) 0) (php/* move-speed dt) 0.0)
                             (if (php/> (:strafe-left m) 0)  (php/* move-speed dt) 0.0))]
           (if (and (php/=== long-d 0.0) (php/=== lat-d 0.0))
             turned
             (try-move turned
                       (php/- (php/* long-d (php/cos a)) (php/* lat-d (php/sin a)))
                       (php/+ (php/* long-d (php/sin a)) (php/* lat-d (php/cos a))))))))
     :moves {:fwd          (php/max 0 (php/- (:fwd m) 1))
             :back         (php/max 0 (php/- (:back m) 1))
             :strafe-left  (php/max 0 (php/- (:strafe-left m) 1))
             :strafe-right (php/max 0 (php/- (:strafe-right m) 1))
             :turn-left    (php/max 0 (php/- (:turn-left m) 1))
             :turn-right   (php/max 0 (php/- (:turn-right m) 1))})))

(defn- game-loop [world0]
  (loop [world    world0
         t-last   (php/microtime true)
         frame-ms 0
         fps      0
         m-prev   false
         sp-prev  false
         dims     [0 0]]
    (let [[rows cols] (term-size)]
      (when (not= [rows cols] dims) (clear-screen))
      (render! world
               {:fps       fps
                :frame-ms  frame-ms
                :kills     (:kills world)
                :lives     (:lives world)
                :iframes   (:iframes world)
                :fire-anim (:fire-anim world)
                :fx        (:fx world)}
               cols rows)
      (php/usleep frame-us)
      (let [keys   (drain-keys)
            m-now  (str/contains? keys "m")
            sp-now (str/contains? keys " ")
            now    (php/microtime true)
            ms     (php/intval (php/* (php/- now t-last) 1000))
            f      (if (php/> ms 0) (php/intval (php// 1000.0 ms)) 0)
            world' (let [dt (php// ms 1000.0)]
                     (let [stepped (apply-physics
                                    (refresh-from-keys
                                     (if (and m-now (not m-prev)) (toggle-map world) world)
                                     keys)
                                    dt)]
                       (let [fired (let [moved (update stepped :enemies advance
                                                       (:grid stepped)
                                                       (:x (:player stepped))
                                                       (:y (:player stepped))
                                                       dt)]
                                     (if (and sp-now (not sp-prev)) (fire-shot moved) moved))]
                         (damage-step fired dt))))]
        (cond
          (str/contains? keys "q")   :quit
          (php/<= (:lives world') 0) {:game-over true :kills (:kills world')}
          :else                      (recur world' now ms f m-now sp-now [rows cols]))))))

(defn- fresh-world []
  (let [grid (random-grid map-w map-h)]
    (let [[px py] (random-spawn grid)]
      (with-enemies
       (new-world grid (new-player px py (php/* (rand-int 360) (php// php/M_PI 180.0))))
       (spawn-enemies grid num-enemies enemy-min-spawn-dist px py)))))

(defn- run-play [ctx]
  (init-input!)
  (let [result (game-loop (fresh-world))]
    (restore!)
    (clear-screen)
    (if (and (map? result) (:game-over result))
      (do
        (println)
        (println "\e[1;91m  YOU DIED  \e[0m")
        (println "\e[1m  kills:\e[0m" (:kills result))
        (println)
        (cli/info ctx "Better luck next run."))
      (cli/success ctx "Thanks for playing."))
    0))

(def play-command
  {:name "play"
   :doc  "Start the DOOM showcase. Arrow keys move/turn (↑↓ forward/back, ←→ turn), , and . strafe, M toggles the minimap, Q quits."
   :run  run-play})
