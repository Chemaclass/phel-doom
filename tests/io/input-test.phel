(ns phel-doom-tests.io.input-test
  (:require phel.test :refer [deftest is])
  (:require phel.string :as str)
  (:require phel-doom.io.input :refer [mouse-enable mouse-disable
                                       init-escapes restore-prelude
                                       pointer-limit-notice halfblock-seams?]))

;; ---------------------------------------------------------------------
;; Mouse reporting escape contract (issue #246). The side-effecting
;; init-input! / restore! print these strings; the pure builders
;; (init-escapes / restore-prelude) let us assert the exact bytes without
;; touching the real terminal (stty / alt-screen flip).
;; ---------------------------------------------------------------------

(deftest test-mouse-enable-is-sgr-plus-any-motion
  ;; \e[?1003h = any-motion tracking, \e[?1006h = SGR-extended encoding,
  ;; \e[>3p = XTSMPOINTER always-hide the OS pointer (#295).
  (is (= "\e[?1003h\e[?1006h\e[>3p" mouse-enable))
  (is (str/contains? mouse-enable "\e[>3p") "always-hide pointer escape present"))

(deftest test-mouse-disable-reverses-enable
  ;; Same two private modes reset (l) instead of set (h), plus \e[>1p to
  ;; restore the default XTSMPOINTER pointer visibility (#295).
  (is (= "\e[?1003l\e[?1006l\e[>1p" mouse-disable)))

(deftest test-init-escapes-include-mouse-enable-when-on
  (let [s (init-escapes true)]
    (is (str/contains? s mouse-enable) "mouse enable present when on")
    (is (str/contains? s "\e[>3u") "kitty opt-in still present")
    (is (str/contains? s "\e[?1049h") "alt screen still present")
    ;; The mouse escapes come AFTER the base setup, not before.
    (is (str/ends-with? s mouse-enable) "mouse enable appended last")))

(deftest test-init-escapes-omit-mouse-enable-when-off
  (let [s (init-escapes false)]
    (is (not (str/contains? s mouse-enable)) "no mouse enable when off")
    (is (not (str/contains? s "\e[?1006h")) "no SGR mode when off")
    (is (not (str/contains? s "\e[?1003h")) "no any-motion when off")
    ;; The keyboard / screen setup is untouched by the mouse gate (BC).
    (is (str/contains? s "\e[>3u") "kitty opt-in still present when mouse off")
    (is (str/contains? s "\e[?1049h") "alt screen still present when mouse off")
    (is (str/ends-with? s "\e[>3u") "ends at the kitty opt-in, no mouse tail")))

(deftest test-pointer-limit-notice-fires-only-on-unhideable-terminals
  ;; Known can't-hide terminals (#295/#313) get a start-menu caveat that the
  ;; OS arrow is cosmetic; capable / unknown terminals get nil (no notice, no
  ;; false nag). The notice is shown on the welcome screen, not at startup.
  (let [iterm (pointer-limit-notice "iTerm.app")]
    (is (some? iterm) "iTerm2 -> notice")
    (is (str/contains? iterm "cosmetic") "explains the OS arrow is cosmetic"))
  (is (some? (pointer-limit-notice "Apple_Terminal")) "Terminal.app -> notice")
  (is (some? (pointer-limit-notice "vscode")) "VS Code -> notice")
  (is (some? (pointer-limit-notice "ghostty")) "Ghostty (hides only while typing) -> notice")
  (is (nil? (pointer-limit-notice "WezTerm")) "unknown terminal -> no notice")
  (is (nil? (pointer-limit-notice "")) "unset TERM_PROGRAM -> no notice"))

(deftest test-halfblock-seams-only-apple-terminal
  ;; Only Terminal.app is on the seam allowlist (#332); pixel-tight
  ;; terminals + unknown/unset keep sub-pixel on.
  (is (= true  (halfblock-seams? "Apple_Terminal")) "Terminal.app -> seams")
  (is (= false (halfblock-seams? "iTerm.app")) "iTerm2 draws ▀ tight")
  (is (= false (halfblock-seams? "WezTerm")) "unknown terminal assumed capable")
  (is (= false (halfblock-seams? "")) "unset TERM_PROGRAM -> no seams"))

(deftest test-restore-prelude-pops-kitty-then-disables-mouse
  ;; Teardown always disables mouse reporting, regardless of whether it
  ;; was enabled (idempotent).
  (is (= (str "\e[<u" mouse-disable) restore-prelude))
  (is (str/contains? restore-prelude "\e[<u") "kitty pop present")
  (is (str/contains? restore-prelude mouse-disable) "mouse disable present"))
