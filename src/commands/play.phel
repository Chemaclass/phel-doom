(ns phel-doom.commands.play
  (:require phel.cli :as cli)
  (:require phel.string :as str)
  (:require phel-doom.modules.state  :refer [move-player turn-player
                                             toggle-map toggle-pause toggle-sound])
  (:require phel-doom.modules.map    :refer [wall? door?])
  (:require phel-doom.modules.engine :refer [cast-ray])
  (:require phel-doom.modules.enemy  :refer [advance shoot spawn-enemies])
  (:require phel-doom.modules.sound  :refer [play-sfx!])
  (:require phel-doom.modules.level  :refer [build-world num-levels])
  (:require phel-doom.modules.render :refer [render! clear-screen
                                             render-death-screen render-victory-screen])
  (:require phel-doom.modules.input  :refer [init-input! restore! drain-keys]))

(def move-speed
  "World units per second when the player holds forward, back, or strafe."
  4.5)
(def turn-speed
  "Radians per second when the player holds a turn arrow. Tuned for
   precision aiming — full 180° spin takes ~1.6s."
  2.0)
(def move-hold-frames
  "Frames a movement direction (W/S/A/D) stays active after each input
   byte. Terminal auto-repeat typically interrupts when another key is
   pressed, so we keep movement 'warm' for ~200ms — long enough to
   compose forward + turn even when the W repeat pauses while the arrow
   takes over the byte stream."
  12)
(def turn-hold-frames
  "Frames a turn direction (←/→) stays active. Shorter than the move
   hold so a single arrow tap rotates a precise small amount instead
   of overshooting."
  5)
(def frame-us 1000)
(def enemy-min-spawn-dist-respawn
  "Min spawn distance reused when a kill triggers an in-game respawn."
  3.0)
(def shot-hit-radius
  "How far off-axis a shot may miss the enemy's center and still count
   as a hit. ~half an enemy 'cell'."
  0.5)
(def shot-max-range 12.0)
(def touch-damage-dist
  "If an alive enemy gets this close (units), the player loses a life."
  0.7)
(def iframe-seconds
  "Seconds of post-hit invulnerability so a single touch doesn't drain
   multiple lives across consecutive frames."
  1.0)
(def fire-anim-seconds
  "How long the muzzle flash / tracer stays visible after each shot."
  0.09)
(def fx-ttl-seconds
  "Initial life of a blood splatter effect — visually fades down to 0."
  0.45)

(defn- term-size
  "Query the terminal for [rows cols] via stty. Falls back to a
   sensible default if stty isn't available (e.g. piped input)."
  []
  (let [out (php/array)]
    (php/exec "stty size 2>/dev/null" out)
    (let [line (php/aget out 0)]
      (if (or (nil? line) (= line ""))
        [24 80]
        (let [parts (php/explode " " line)]
          [(php/intval (php/aget parts 0)) (php/intval (php/aget parts 1))])))))

(defn- try-move [world dx dy]
  (let [{:keys [grid player]} world
        nx                    (+ (:x player) dx)
        ny                    (+ (:y player) dy)]
    (if (wall? grid (php/intval nx) (php/intval ny))
      world
      (move-player world dx dy))))

(def key->slot
  "Normalised single-byte input -> direction counter slot. Arrow keys
   are normalised to ^ _ < > before lookup (refresh-from-keys); the
   WASD aliases sit alongside so either keyboard half plays."
  {"^" :fwd          "w" :fwd
   "_" :back         "s" :back
   "<" :turn-left
   ">" :turn-right
   "a" :strafe-left
   "d" :strafe-right})

(def turn-slots
  "Slots that use the shorter turn-hold-frames timer (precise taps)
   instead of move-hold-frames (forgiving holds)."
  #{:turn-left :turn-right})

(defn- refresh-move [world k]
  (let [slot (get key->slot k)]
    (if (nil? slot)
      world
      (assoc-in world [:moves slot]
                (if (turn-slots slot) turn-hold-frames move-hold-frames)))))

(defn- refresh-from-keys
  "Walk the drained input string, resetting the matching direction
   counter for every input byte. Arrow-key escape sequences are
   normalised to single-byte placeholders (^ _ < >) so the per-byte
   loop can treat them like ordinary keys. Held keys (terminal repeat)
   keep refreshing; orthogonal keys layer onto the same world."
  [world keys]
  (let [normalized (php/str_replace (php/array "\e[A" "\e[B" "\e[D" "\e[C")
                                    (php/array "^"    "_"    "<"    ">")
                                    keys)]
    (let [n (php/strlen normalized)]
      (loop [i 0 w world]
        (if (php/>= i n)
          w
          (recur (php/+ i 1) (refresh-move w (php/substr normalized i 1))))))))

(defn- touching?
  "True iff any alive enemy is within touch-damage-dist of (px, py)."
  [enemies px py]
  (loop [es enemies]
    (cond
      (php/=== es nil) false
      :else            (let [e (first es)]
                         (if (and e (:alive e)
                                  (let [dx (php/- (:x e) px)
                                        dy (php/- (:y e) py)]
                                    (php/<= (php/+ (php/* dx dx) (php/* dy dy))
                                            (php/* touch-damage-dist touch-damage-dist))))
                           true
                           (recur (next es)))))))

(defn- decay-fx [fx dt]
  (apply vector
         (filter (fn [e] (php/> (:ttl e) 0.0))
                 (map (fn [e] (assoc e :ttl (php/- (:ttl e) dt)))
                      (or fx [])))))

(defn- damage-step
  "Tick the i-frame, fire-anim, and fx timers down by dt; if no
   i-frames are left and an enemy is touching the player, subtract a
   life and start a fresh i-frame window."
  [world dt]
  (let [i  (php/max 0.0 (php/- (:iframes world) dt))
        fa (php/max 0.0 (php/- (or (:fire-anim world) 0.0) dt))]
    (let [w' (-> world
                 (assoc :iframes i)
                 (assoc :fire-anim fa)
                 (update :fx decay-fx dt))
          p  (:player world)]
      (if (and (php/<= i 0.0) (touching? (:enemies w') (:x p) (:y p)))
        (do
          (when (:sound-on world) (play-sfx! :hit))
          (-> w' (update :lives (fn [l] (php/max 0 (php/- l 1))))
              (assoc :iframes iframe-seconds)))
        w'))))

(defn- fire-shot
  "Resolve one trigger pull: hitscan along the player's facing, taking
   wall occlusion and a small off-axis tolerance into account. On hit:
   bump :kills, push a blood splatter at the kill site, and respawn a
   fresh enemy in the slot so the arena stays populated."
  [world]
  (let [p (:player world)]
    (let [wall-d (cast-ray (:pgrid world) (:x p) (:y p) (:angle p))]
      (let [[es hit? hit-pos idx] (shoot (:enemies world) (:x p) (:y p) (:angle p)
                                         wall-d shot-hit-radius shot-max-range)]
        (do
          (when (:sound-on world) (play-sfx! (if hit? :kill :shoot)))
          (if hit?
            (let [respawn (first (spawn-enemies (:grid world) 1
                                                enemy-min-spawn-dist-respawn (:x p) (:y p)))]
              (-> world
                  (assoc :enemies (if respawn (assoc es idx respawn) es))
                  (update :kills (fn [k] (php/+ k 1)))
                  (assoc :fire-anim fire-anim-seconds)
                  (update :fx (fn [fx]
                                (conj (or fx [])
                                      {:x (:x hit-pos) :y (:y hit-pos) :ttl fx-ttl-seconds})))))
            (assoc world :fire-anim fire-anim-seconds)))))))

(defn- apply-physics
  "Per-frame physics step. Active direction counters contribute dt-scaled
   motion: turn first (so strafing and forward use the new heading), then
   combine longitudinal (fwd/back) and lateral (strafe-left/right) into
   one composite move along the current facing. Every counter is then
   decremented; zero means that direction stops on its own."
  [world dt]
  (let [m (:moves world)]
    (assoc
     (let [turn-by (php/- (if (php/> (:turn-right m) 0) (php/* turn-speed dt) 0.0)
                          (if (php/> (:turn-left m) 0)  (php/* turn-speed dt) 0.0))]
       (let [turned (if (php/=== turn-by 0.0) world (turn-player world turn-by))]
         (let [a      (:angle (:player turned))
               long-d (php/- (if (php/> (:fwd m) 0)  (php/* move-speed dt) 0.0)
                             (if (php/> (:back m) 0) (php/* move-speed dt) 0.0))
               lat-d  (php/- (if (php/> (:strafe-right m) 0) (php/* move-speed dt) 0.0)
                             (if (php/> (:strafe-left m) 0)  (php/* move-speed dt) 0.0))]
           (if (and (php/=== long-d 0.0) (php/=== lat-d 0.0))
             turned
             (try-move turned
                       (php/- (php/* long-d (php/cos a)) (php/* lat-d (php/sin a)))
                       (php/+ (php/* long-d (php/sin a)) (php/* lat-d (php/cos a))))))))
     :moves {:fwd          (php/max 0 (php/- (:fwd m) 1))
             :back         (php/max 0 (php/- (:back m) 1))
             :strafe-left  (php/max 0 (php/- (:strafe-left m) 1))
             :strafe-right (php/max 0 (php/- (:strafe-right m) 1))
             :turn-left    (php/max 0 (php/- (:turn-left m) 1))
             :turn-right   (php/max 0 (php/- (:turn-right m) 1))})))

(defn- handle-toggles
  "Apply edge-triggered toggles (pause, minimap, sound) for one frame."
  [world edges]
  (let [w0 (if (:toggle-pause edges) (toggle-pause world) world)]
    (let [w1 (if (:toggle-map edges) (toggle-map w0) w0)]
      (if (:toggle-sound edges) (toggle-sound w1) w1))))

(defn- tick-enemies
  "Walk every alive enemy one dt-scaled step toward the player, using
   the world's per-level chase-speed when present."
  [world dt]
  (let [p (:player world)]
    (update world :enemies advance (:grid world) (:x p) (:y p) dt
            (or (:chase-speed world) 0.75))))

(defn- tick-shooting
  "If the trigger was pulled this frame, resolve the hitscan; otherwise
   bypass."
  [world fire?]
  (if fire? (fire-shot world) world))

(defn- on-door?
  "True when the player's current integer cell is a door, meaning we
   should advance to the next level this frame."
  [world]
  (let [p (:player world)]
    (door? (:grid world) (php/intval (:x p)) (php/intval (:y p)))))

(defn tick-world
  "Pure one-frame state transition. Decoupled from IO so it can be
   unit-tested directly: build a world, hand it inputs, assert what
   comes back. `keys` is the drained input string, `dt` is seconds
   since the previous tick, `edges` is a map of rising-edge events
   {:fire :toggle-map :toggle-pause :toggle-sound}."
  {:export true}
  [world keys dt edges]
  (let [w0 (handle-toggles world edges)]
    (if (:paused w0)
      w0
      (let [w1 (refresh-from-keys w0 keys)]
        (let [w2 (apply-physics w1 dt)]
          (let [w3 (tick-enemies w2 dt)]
            (let [w4 (tick-shooting w3 (:fire edges))]
              (damage-step w4 dt))))))))

(defn- key-states
  "Snapshot which of the tracked keys appear anywhere in `keys`."
  [keys]
  {:m  (str/contains? keys "m")
   :sp (str/contains? keys " ")
   :p  (str/contains? keys "p")
   :n  (str/contains? keys "n")})

(defn- rising-edges
  "Given the current and previous key snapshots, build the edges map
   tick-world consumes (truthy only for keys that just turned on)."
  [now prev]
  {:fire         (and (:sp now) (not (:sp prev)))
   :toggle-map   (and (:m now)  (not (:m prev)))
   :toggle-pause (and (:p now)  (not (:p prev)))
   :toggle-sound (and (:n now)  (not (:n prev)))})

(def initial-key-snapshot
  {:m false :sp false :p false :n false})

(defn- game-loop [world0]
  (let [t-start (php/microtime true)]
    (loop [world     world0
           t-last    t-start
           frame-ms  0
           fps       0
           prev-keys initial-key-snapshot
           dims      [0 0]]
      (let [[rows cols] (term-size)]
        (when (not= [rows cols] dims) (clear-screen))
        (render! world
                 {:fps        fps
                  :frame-ms   frame-ms
                  :kills      (:kills world)
                  :lives      (:lives world)
                  :iframes    (:iframes world)
                  :fire-anim  (:fire-anim world)
                  :fx         (:fx world)
                  :paused     (:paused world)
                  :sound-on   (:sound-on world)
                  :level      (:level world)
                  :level-name (:level-name world)
                  :enemy-head (:enemy-head world)
                  :enemy-body (:enemy-body world)}
                 cols rows)
        (php/usleep frame-us)
        (let [keys     (drain-keys)
              now      (php/microtime true)
              ms       (php/intval (php/* (php/- now t-last) 1000))
              f        (if (php/> ms 0) (php/intval (php// 1000.0 ms)) 0)
              now-keys (key-states keys)
              world'   (tick-world world keys (php// ms 1000.0)
                                   (rising-edges now-keys prev-keys))]
          (cond
            (str/contains? keys "q")
            :quit

            (php/<= (:lives world') 0)
            {:game-over  true
             :kills      (:kills world')
             :survived-s (php/intval (php/- now t-start))}

            (on-door? world')
            (do
              (when (:sound-on world') (play-sfx! :door))
              (if (php/>= (:level world') num-levels)
                {:victory    true
                 :kills      (:kills world')
                 :survived-s (php/intval (php/- now t-start))}
                {:next-level true
                 :level      (php/+ (:level world') 1)
                 :kills      (:kills world')
                 :lives      (:lives world')
                 :survived-s (php/intval (php/- now t-start))}))

            :else
            (recur world' now ms f now-keys [rows cols])))))))

(defn- end-loop
  "Render an end screen (death or victory) frame by frame until the
   user picks R (restart) or Q (quit). `render-fn` takes cols/rows and
   draws the appropriate variant."
  [render-fn]
  (loop [dims [0 0]]
    (let [[rows cols] (term-size)]
      (when (not= [rows cols] dims) (clear-screen))
      (render-fn cols rows)
      (php/usleep 16000)
      (let [keys (drain-keys)]
        (cond
          (str/contains? keys "q") :quit
          (str/contains? keys "r") :restart
          :else                    (recur [rows cols]))))))

(defn- death-loop [kills survived-s]
  (end-loop (fn [cols rows] (render-death-screen cols rows kills survived-s))))

(defn- victory-loop [kills survived-s]
  (end-loop (fn [cols rows] (render-victory-screen cols rows kills survived-s))))

(defn- run-play [ctx]
  (init-input!)
  ;; Outer loop drives one full run: it walks the player through up to
  ;; `num-levels` rooms by feeding game-loop fresh worlds in sequence.
  ;; Kills + time accumulate across levels so the death / victory
  ;; screen shows the cumulative run totals.
  (loop [level 1 carry-kills 0 carry-time 0]
    (let [result (game-loop (build-world level))]
      (cond
        (= result :quit)
        nil

        (and (map? result) (:next-level result))
        (recur (:level result)
               (php/+ carry-kills (:kills result))
               (php/+ carry-time (:survived-s result)))

        (and (map? result) (:victory result))
        (let [k (php/+ carry-kills (:kills result))
              t (php/+ carry-time (:survived-s result))]
          (when (= :restart (victory-loop k t))
            (clear-screen)
            (recur 1 0 0)))

        (and (map? result) (:game-over result))
        (let [k (php/+ carry-kills (:kills result))
              t (php/+ carry-time (:survived-s result))]
          (when (= :restart (death-loop k t))
            (clear-screen)
            (recur 1 0 0)))

        :else
        nil)))
  (restore!)
  (clear-screen)
  (cli/success ctx "Thanks for playing.")
  (println)
  (println "  \e[1mphel-doom\e[0m  by \e[1mChemaclass\e[0m  https://github.com/Chemaclass/phel-doom")
  (println "  written in \e[1mPhel Lang\e[0m  https://phel-lang.org/")
  (println)
  0)

(def play-command
  {:name "play"
   :doc  "Start the DOOM showcase. Arrow keys move/turn (↑↓ forward/back, ←→ turn), , and . strafe, M toggles the minimap, Q quits."
   :run  run-play})
