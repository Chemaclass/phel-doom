(ns phel-doom.io.render
  (:require phel-doom.core.enemies :refer [enemy-types])
  (:require phel-doom.core.engine  :refer [cast-frame max-depth proj-dist])
  (:require phel-doom.core.perf    :refer [render-scale])
  (:require phel-doom.core.map     :refer [find-door-cell])
  (:require phel-doom.core.weapons :refer [weapon-order weapons])
  (:require phel-doom.core.settings :refer [page-fields])
  (:require phel-doom.core.format  :refer [format-duration]))

;; =====================================================================
;; § Hot-loop buffer macros
;;
;; The inner row + col loops read/write ~7200 cells per frame at 180×40.
;; Bench (docs/contributing.md → Phel gotchas) puts Phel persistent
;; vectors at ~680× slower than php-array on a per-cell read; the row
;; loop would drop from ~60fps to <2fps if we used (get v i) here.
;;
;; To avoid leaking php/* call shapes across the module we wrap the
;; raw php interop in zero-cost macros. Reader stays at the Phel
;; level (`(buf-mk)`, `(buf-set b i v)`, `(buf-get b i)`); the macro
;; expands at compile time to the underlying php/array op.
;;
;; CAVEAT: these are macros, not fns. They compile inline. Trying to
;; pass `buf-set` as a value (e.g. to `map`) won't work. Use them
;; only at direct call sites in hot loops.
;;
;; PHP arrays still pass by value across fn boundaries. Helpers that
;; build a buffer must RETURN it; callers rebind via let. See
;; compute-wall-shades / paint-* helpers for the pattern.
;; =====================================================================

(defmacro buf-mk
  "Create an empty buffer (php-array)."
  []
  `(php/array))

(defmacro buf-set
  "Write `v` at `i` in buffer `b`. Inlines to php/aset."
  [b i v]
  `(php/aset ~b ~i ~v))

(defmacro buf-get
  "Read `b[i]`. Inlines to php/aget."
  [b i]
  `(php/aget ~b ~i))

(defmacro buf-push
  "Append `v` to the end of buffer `b`. Inlines to php/array_push."
  [b v]
  `(php/array_push ~b ~v))

(def sky        "\e[48;5;236m ")
(def floor      "\e[48;5;239m ")
(def sky-blood  "\e[48;5;52m ")
(def floor-blood "\e[48;5;88m ")
(def enemy-head "\e[48;5;196m ")
(def enemy-body "\e[48;5;52m ")
;; All minimap + HUD cells carry an explicit dark BG (`\e[40m`). Without
;; it, the underlying terminal default BG (which can be light/transparent
;; on some iTerm2 themes) shows through and washes the overlay out.
(def enemy-marker "\e[40;91;1mE\e[0m")
(def heart-marker "\e[40;91;1m♥\e[0m")
(def ammo-marker     "\e[40;93;1mA\e[0m")
(def berserk-marker  "\e[40;91;1mB\e[0m")
(def invuln-marker   "\e[40;96;1mI\e[0m")
(def soulsphere-marker
  "Soulsphere minimap glyph (issue #68): bright cyan circle on
   black. Distinct from `I` (invuln) and `B` (berserk) on the same
   palette family so the player can tell which powerup is which at
   a glance."
  "\e[40;96;1m●\e[0m")
(def armor-shard-marker
  "Armor-shard minimap glyph (issue #68): green caret. Shape +
   colour both distinct from the heart `♥` and ammo `A` so the
   common shard pickup reads as its own kind on a busy minimap."
  "\e[40;92;1m▲\e[0m")
(def backpack-marker "\e[40;33;1mP\e[0m")
(def keycard-blue-marker "\e[40;94;1mk\e[0m")
(def keycard-red-marker  "\e[40;91;1mk\e[0m")
(def door-blue-marker    "\e[40;94;1m▌\e[0m")
(def door-red-marker     "\e[40;91;1m▌\e[0m")
(def shotgun-pickup-marker  "\e[40;33;1mS\e[0m")
(def chaingun-pickup-marker "\e[40;32;1mC\e[0m")
(def door-shade
  "Door body cell drawn when a ray hit a door. Frame glyph `▌` (left
   half block) on a dark steel BG with bright orange FG, so a column
   of door cells reads as a vertical metal frame rather than a flat
   orange band. Cheap: still one paint cell per column."
  "\e[48;5;94;38;5;214m▌")
(def boss-door-shade
  "Boss-locked door body cell. Same frame glyph as the standard
   door but on a blood-red BG with bright yellow FG so the L10
   exit reads at a glance as 'kill the boss to open this'."
  "\e[48;5;88;38;5;226m▌")
(def boss-door-marker
  "Minimap glyph for the L10 boss-locked door — vivid red so the
   exit reads as 'danger / locked' against the dim minimap floor."
  "\e[40;91;1m▌\e[0m")

;; Color CODES used for half-block edge anti-aliasing. The outer
;; column loop composes 'top edge' and 'bottom edge' cells by
;; combining a wall code with the sky / floor code into a single
;; ▀ glyph (upper-half block — FG paints top half, BG paints
;; bottom half). The eye reads it as a sub-cell wall boundary
;; instead of a staircase.
(def sky-code         "236")
(def floor-code       "239")
(def sky-blood-code   "52")
(def floor-blood-code "88")
(def door-code        "172")
(def boss-door-code   "196")
(def kill-flash    "\e[48;5;231;38;5;226;1m✦")
(def death-slump   "\e[48;5;124;38;5;232;1m▼")
(def death-collapse "\e[48;5;88;38;5;52m▒")
(def blood-bright  "\e[48;5;160m ")
(def blood-mid     "\e[48;5;88m ")
(def blood-dim     "\e[48;5;52m ")
(def sprite-shadow
  "Darkest-grey BG painted into the row immediately under an enemy's
   feet so the sprite reads as grounded instead of floating in mid-air."
  "\e[48;5;232m ")

;; Pickup sprites paint a coloured BG rectangle over the projected
;; column range, then overlay a single ICON glyph at the centre cell
;; so the pickup reads as a proper symbol up close and a coloured
;; glow from across the room. BG + glyph cycle on a sin wave.

