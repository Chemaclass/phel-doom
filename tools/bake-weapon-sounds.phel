(ns bake-sounds (:require phel-doom.io.wad :refer [parse-header parse-directory find-lump]))

;; Bake Freedoom (BSD) weapon DMX sounds into a committed base64 WAV map.
;; Runtime (io/sound) decodes + writes each to a temp WAV once, then
;; afplays it per weapon-fire event. No binary asset in the repo.
;; Usage: vendor/bin/phel run tools/bake-weapon-sounds.phel <freedoom1.wad>

(defn u16 [s o] (php/aget (php/unpack "v" (php/substr s o 2)) 1))
(defn u32 [s o] (php/aget (php/unpack "V" (php/substr s o 4)) 1))

;; DMX lump -> 8-bit unsigned mono WAV bytes. Header is 8 bytes
;; (fmt u16, rate u16, nsamples u32); the PCM has 16 pad samples front
;; and back (DMX convention) which we trim so the clip starts/ends clean.
(defn dmx->wav [s entry]
  (let [o    (:offset entry)
        rate (u16 s (php/+ o 2))
        ns   (u32 s (php/+ o 4))
        raw  (php/substr s (php/+ o 8) ns)
        pcm  (if (php/> ns 32) (php/substr raw 16 (php/- ns 32)) raw)
        len  (php/strlen pcm)]
    (str "RIFF" (php/pack "V" (php/+ 36 len)) "WAVE"
         "fmt " (php/pack "V" 16) (php/pack "v" 1) (php/pack "v" 1)
         (php/pack "V" rate) (php/pack "V" rate) (php/pack "v" 1) (php/pack "v" 8)
         "data" (php/pack "V" len) pcm)))

(let [argv (php/aget php/$_SERVER "argv")
      wad  (if (php/>= (php/count argv) 4) (php/aget argv 3) "/tmp/fd1.wad")
      s    (php/file_get_contents wad)
      dir  (parse-directory s (parse-header s))
      ;; weapon-fire event -> freedoom1 DMX lump. chaingun reuses the
      ;; pistol report (as in classic DOOM); incinerator borrows the
      ;; fireball whoosh; super-shotgun has no fd1 sound (keeps fallback).
      emap [[":shoot" "DSPISTOL"] [":shoot-chaingun" "DSPISTOL"]
            [":shoot-shotgun" "DSSHOTGN"] [":shoot-bfg" "DSBFG"]
            [":shoot-incinerator" "DSFIRSHT"] [":shoot-rocket" "DSRLAUNC"]
            [":shoot-chainsaw" "DSSAWFUL"]]
      sb   (php/array)
      n    (php/array)]
  (php/aset n 0 0)
  (php/array_push sb "(ns phel-doom.io.sound-data)\n\n")
  (php/array_push sb ";; GENERATED by tools/bake-weapon-sounds.phel from Freedoom (BSD).\n")
  (php/array_push sb ";; weapon-fire event -> base64 of an 8-bit mono WAV. io/sound writes\n")
  (php/array_push sb ";; each to a temp file once and afplays it. Do NOT hand-edit; re-bake.\n\n")
  (php/array_push sb "(def freedoom-sfx\n  {")
  (foreach [pair emap]
           (let [e (find-lump dir (php/aget pair 1))]
             (when e
               (php/array_push sb (php/sprintf "\n   %s\n   \"%s\""
                                               (php/aget pair 0)
                                               (php/base64_encode (dmx->wav s e))))
               (php/aset n 0 (php/+ (php/aget n 0) 1)))))
  (php/array_push sb "})\n")
  (php/file_put_contents "src/io/sound_data.phel" (php/implode "" sb))
  (php/printf "wrote src/io/sound_data.phel (%d sounds)\n" (php/aget n 0)))
