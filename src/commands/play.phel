(ns phel-doom.commands.play
  (:require phel.cli :as cli)
  (:require phel-doom.modules.doom.state  :refer [new-player new-world move-player turn-player])
  (:require phel-doom.modules.doom.map    :refer [default-grid wall?])
  (:require phel-doom.modules.doom.render :refer [render! clear-screen])
  (:require phel-doom.modules.doom.input  :refer [init-input! restore! drain-keys]))

(def move-speed 0.35)
(def turn-speed 0.15)
(def frame-us 1000)

(defn- try-move [world dx dy]
  (let [{:keys [grid player]} world
        nx                    (+ (:x player) dx)
        ny                    (+ (:y player) dy)]
    (if (wall? grid (php/intval nx) (php/intval ny))
      world
      (move-player world dx dy))))

(defn- step-input [world key]
  (let [a (:angle (:player world))]
    (cond
      (= key "w") (try-move world (* move-speed (php/cos a)) (* move-speed (php/sin a)))
      (= key "s") (try-move world (* (- 0 move-speed) (php/cos a)) (* (- 0 move-speed) (php/sin a)))
      (= key "a") (turn-player world (- 0 turn-speed))
      (= key "d") (turn-player world turn-speed)
      :else       world)))

(defn- apply-keys [world keys]
  (let [n (php/strlen keys)]
    (loop [i 0 w world]
      (if (>= i n)
        w
        (recur (+ i 1) (step-input w (php/substr keys i 1)))))))

(defn- game-loop [world0]
  (loop [world    world0
         t-last   (php/microtime true)
         frame-ms 0
         fps      0]
    (render! world {:fps fps :frame-ms frame-ms})
    (php/usleep frame-us)
    (let [keys (drain-keys)
          now  (php/microtime true)
          dt   (- now t-last)
          ms   (php/intval (* dt 1000))
          f    (if (> dt 0.0) (php/intval (/ 1.0 dt)) 0)]
      (if (str-contains? keys "q")
        :quit
        (recur (apply-keys world keys) now ms f)))))

(defn- run-play [ctx]
  (init-input!)
  (game-loop (new-world default-grid (new-player 8.0 8.0 0.0)))
  (restore!)
  (clear-screen)
  (cli/success ctx "Thanks for playing.")
  0)

(def play-command
  {:name "play"
   :doc  "Start the DOOM showcase. Controls: WASD to move/turn, Q to quit."
   :run  run-play})
