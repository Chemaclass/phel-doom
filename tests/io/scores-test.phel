(ns phel-doom-tests.io.scores-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.io.scores :refer [merge-run empty-scores]))

;; Pure-merge tests only — never load-scores / update-scores! which
;; touch the user's $HOME .phel-doom-scores.json file.

(deftest test-merge-run-from-empty-keeps-current
  (let [s (merge-run empty-scores 12 3 45 false)]
    (is (= 12 (:best-kills s)))
    (is (= 3  (:best-level s)))
    ;; Not a victory: fastest-victory-s stays at the previous 0.
    (is (= 0 (:fastest-victory-s s)))))

(deftest test-merge-run-best-kills-monotonic-non-decreasing
  ;; New kill count below previous best should NOT downgrade it.
  (let [prev {:best-kills 50 :best-level 2 :fastest-victory-s 0}
        s    (merge-run prev 10 1 30 false)]
    (is (= 50 (:best-kills s)))
    (is (= 2  (:best-level s)))))

(deftest test-merge-run-best-level-tracks-deepest-reached
  (let [prev {:best-kills 0 :best-level 2 :fastest-victory-s 0}
        s    (merge-run prev 0 4 0 false)]
    (is (= 4 (:best-level s)))))

(deftest test-merge-run-victory-sets-first-time
  ;; First victory: any time becomes the record (no previous victory
  ;; means :fastest-victory-s starts at 0).
  (let [s (merge-run empty-scores 30 5 120 true)]
    (is (= 120 (:fastest-victory-s s)))))

(deftest test-merge-run-victory-beats-old-record
  (let [prev {:best-kills 0 :best-level 5 :fastest-victory-s 120}
        s    (merge-run prev 30 5 90 true)]
    (is (= 90 (:fastest-victory-s s)))))

(deftest test-merge-run-victory-slower-than-record-keeps-record
  (let [prev {:best-kills 0 :best-level 5 :fastest-victory-s 90}
        s    (merge-run prev 30 5 120 true)]
    (is (= 90 (:fastest-victory-s s)))))

(deftest test-merge-run-non-victory-never-touches-fastest
  (let [prev {:best-kills 0 :best-level 5 :fastest-victory-s 90}
        s    (merge-run prev 30 5 10 false)]
    ;; Even though 10s is much faster than 90s, a non-victory run
    ;; cannot post a time.
    (is (= 90 (:fastest-victory-s s)))))
