(ns phel-doom-tests.io.demo-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.io.demo :as demo))

(deftest test-frames-json-round-trip
  (let [frames [["w" 16] ["s a" 17] ["" 16]]
        back   (demo/json->demo (demo/frames->json 4242 frames))]
    (is (= 4242 (:seed back)))
    (is (= frames (:frames back)))))

(deftest test-json-demo-rejects-malformed
  (is (= nil (demo/json->demo "garbage not json"))))

(deftest test-json-demo-rejects-version-mismatch
  (let [o (php/array)]
    (php/aset o "version" 99)
    (php/aset o "frames" (php/array))
    (is (= nil (demo/json->demo (php/json_encode o))))))

(deftest test-json-demo-rejects-malformed-frames
  ;; Valid version but a non-array :frames must be rejected (nil),
  ;; matching the docstring - not throw or yield {:frames []}.
  (let [o (php/array)]
    (php/aset o "version" demo/demo-version)
    (php/aset o "seed" 1)
    (php/aset o "frames" "not-an-array")
    (is (= nil (demo/json->demo (php/json_encode o))))))

(deftest test-json-demo-rejects-malformed-frame-elements
  ;; The frames container being an array is not enough: scalar or short
  ;; elements used to decode to [nil nil] pairs, and the nil ms fed the
  ;; loop's dt arithmetic.
  (let [with-frames (fn [frames]
                      (let [o (php/array)]
                        (php/aset o "version" demo/demo-version)
                        (php/aset o "seed" 1)
                        (php/aset o "frames" frames)
                        (php/json_encode o)))]
    (is (= nil (demo/json->demo (with-frames (php/array 1 2 3)))) "scalar frames")
    (is (= nil (demo/json->demo (with-frames (php/array (php/array "w")))))
        "one-element frame")
    (is (= nil (demo/json->demo (with-frames (php/array (php/array "w" "soon")))))
        "non-numeric ms")))

(deftest test-json-demo-rejects-non-string-keys-field
  ;; The keys field feeds key-states / str-contains?, which throw on a
  ;; non-string. Such a demo used to parse fine and then explode on the
  ;; first replayed frame, after the terminal was already in raw mode.
  (let [with-frames (fn [frames]
                      (let [o (php/array)]
                        (php/aset o "version" demo/demo-version)
                        (php/aset o "seed" 1)
                        (php/aset o "frames" frames)
                        (php/json_encode o)))]
    (is (= nil (demo/json->demo (with-frames (php/array (php/array 123 16))))) "int keys")
    (is (= nil (demo/json->demo (with-frames (php/array (php/array true 16))))) "bool keys")
    (is (= nil (demo/json->demo (with-frames (php/array (php/array 1.5 16))))) "float keys")))

(deftest test-record-mode-flags
  (demo/start-record! 1)
  (is (demo/recording?))
  (is (not (demo/replaying?)))
  (is (= 1 (demo/run-seed)))
  (demo/reset-off!)
  (is (not (demo/recording?))))

(deftest test-replay-feeds-frames-then-ends
  (demo/start-replay! 9 [["w" 16] ["s" 17]])
  (let [f1 (demo/resolve-frame! "x" 99)
        f2 (demo/resolve-frame! "x" 99)
        f3 (demo/resolve-frame! "x" 99)]
    (is (= "w" (:keys f1)) "first recorded frame, terminal ignored")
    (is (= 16 (:ms f1)))
    (is (= "s" (:keys f2)))
    (is (= true (:end? f3)) "stream exhausted -> end"))
  (demo/reset-off!))

(deftest test-off-mode-passes-through
  (demo/reset-off!)
  (let [f (demo/resolve-frame! "wd" 16)]
    (is (= "wd" (:keys f)))
    (is (= 16 (:ms f)))))
