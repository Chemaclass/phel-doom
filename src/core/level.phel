(ns phel-doom.core.level
  (:require phel-doom.core.rng :as rng)
  (:require phel-doom.core.state      :refer [max-backpacks max-lives new-player new-world with-enemies])
  (:require phel-doom.core.map        :refer [cell-door cell-door-blue cell-door-boss cell-door-red cell-door-yellow count-secrets parse-layout place-exit random-grid random-spawn scatter-walls seed-secrets])
  (:require phel-doom.core.enemy      :refer [default-wander-fraction promote-wanderers spawn-enemies spawn-enemies-mixed])
  (:require phel-doom.core.enemy-ai   :refer [aggression-for])
  (:require phel-doom.core.enemies    :refer [enemy-types type-spec default-lives-for])
  (:require phel-doom.core.difficulty :refer [normalise scale-cfg]))

;; ---------------------------------------------------------------------
;; Level catalog + fresh-world factory.
;;
;; All progression knobs (room size, wall count, monster count, monster
;; type, chase speed, sprite colours) live in `levels`. Adding a new
;; level is a single map literal; nothing else needs to change.
;;
;; build-world wires a chosen level into a brand-new world record by
;; combining the random map generator, door seeding, player spawn, and
;; monster spawning. The IO shell (play.phel) doesn't know any of these
;; numbers — it just asks for level N.
;; ---------------------------------------------------------------------

(def enemy-min-spawn-dist
  "How far from the player a fresh enemy must spawn (world units), so
   the first frame isn't an ambush."
  3.0)

;; ---------------------------------------------------------------------
;; Hand-authored flat campaign rooms (L2-L8). Each is a flat `:layout`
;; chamber: walls + spawn + exit (and any keycard-locked door char) live
;; in the ASCII; the floor is the classic flat ground. Each preserves its
;; level's identity (name, enemy mix, chase, lock, weapon drop, rough
;; size) while the geometry stays simple.
;; ---------------------------------------------------------------------

(def showcase-layout
  "24x18 staircase showcase chamber for L2 (issue #372, epic #375). Spawn
   `@` is south-of-centre (cell 11, row 15 -> centre 11.5, 15.5). North of
   the spawn a 3-tread staircase climbs the centre columns (8-13): row 10
   `1` = fz 0.25, row 9 `2` = 0.5, then rows 8-4 are one contiguous `3`
   block at fz 0.75 - the top tread merges straight into the raised
   platform (no riser between them). Walking north snaps the player's :z
   up one fz-step per tread (physics/step-clears?, #371); the stair reads
   from below at the spawn and from above on the platform. Open flanks let
   the player walk around it. The exit door is dropped at a random
   reachable wall by place-exit (not authored). The L2 entry omits `:walls`
   so scatter-walls can't chew the tread cells."
  ["########################"
   "#......................#"
   "#......................#"
   "#......................#"
   "#.......333333.........#"
   "#.......333333.........#"
   "#.......333333.........#"
   "#.......333333.........#"
   "#.......333333.........#"
   "#.......222222.........#"
   "#.......111111.........#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#..........@...........#"
   "#......................#"
   "########################"])

