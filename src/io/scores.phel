(ns phel-doom.io.scores)

;; ---------------------------------------------------------------------
;; High-score persistence in $HOME/.phel-doom-scores.json.
;;
;; Three running bests are tracked:
;;   :best-kills         most kills in any single run
;;   :best-level         deepest level reached in any single run
;;   :fastest-victory-s  shortest time to clear the final level (nil/0
;;                       if no victory yet)
;;
;; The file is plain JSON so a user can inspect or wipe it without any
;; tooling. Neither load nor save throws — we'd rather lose a score than
;; block a game from running — but a failed save is recorded in
;; `write-failed` and reported once at exit, so the loss is not silent.
;; ---------------------------------------------------------------------

(def empty-scores
  {:best-kills        0
   :best-level        0
   :fastest-victory-s 0})

(defn- scores-path []
  (str (or (php/getenv "HOME") ".") "/.phel-doom-scores.json"))

(defn- read-int [arr key fallback]
  (let [v (php/aget arr key)]
    (if (or (nil? v) (php/=== v false)) fallback (php/intval v))))

(defn load-scores
  "Read the persisted scores file, returning empty-scores when missing
   or malformed."
  []
  (let [path (scores-path)]
    (if (php/file_exists path)
      (let [content (php/file_get_contents path)]
        (if (or (php/=== content false) (php/=== content ""))
          empty-scores
          (let [data (php/json_decode content true)]
            (if (php/is_array data)
              {:best-kills        (read-int data "best-kills"        0)
               :best-level        (read-int data "best-level"        0)
               :fastest-victory-s (read-int data "fastest-victory-s" 0)}
              empty-scores))))
      empty-scores)))

(def- write-failed
  ;; Set by every write-scores! call. A run's bests are only worth keeping
  ;; if they reach disk; an unwritable HOME silently discards every record,
  ;; so the caller reports it once at exit.
  (atom false))

(defn scores-write-failed?
  "True when the last scores write could not reach the file."
  []
  @write-failed)

(defn- write-scores! [scores]
  (let [arr (php/array)]
    (php/aset arr "best-kills"        (:best-kills        scores))
    (php/aset arr "best-level"        (:best-level        scores))
    (php/aset arr "fastest-victory-s" (:fastest-victory-s scores))
    (reset! write-failed
            (php/=== false (php/file_put_contents (scores-path) (php/json_encode arr))))))

(defn merge-run
  "Pure merge: fold a finished run's stats (kills, level, survived-s,
   victory?) into the previous bests map. Lifted out of update-scores!
   so the rule (only victories update :fastest-victory-s, only IF
   it's a new record or no previous victory existed) can be unit
   tested without touching the file system."
  [prev kills level survived-s victory?]
  {:best-kills        (php/max (:best-kills prev) kills)
   :best-level        (php/max (:best-level prev) level)
   :fastest-victory-s (if (and victory?
                               (or (php/<= (:fastest-victory-s prev) 0)
                                   (php/< survived-s (:fastest-victory-s prev))))
                        survived-s
                        (:fastest-victory-s prev))})

(defn update-scores!
  "Merge this run into the persisted bests and write the file back.
   Returns the resulting scores so the caller can display them on the
   end screen alongside the current run."
  [kills level survived-s victory?]
  (let [next (merge-run (load-scores) kills level survived-s victory?)]
    (write-scores! next)
    next))
