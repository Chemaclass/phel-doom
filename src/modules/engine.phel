(ns phel-doom.modules.engine)

(def max-depth 16.0)
(def step 0.25)
(def proj-dist
  "Horizontal projection distance in screen cells. Wall heights are
   `proj-dist / (dist * char-aspect)`, so this controls how big walls
   look at a given world distance. The horizontal FOV emerges as
   `2 * atan(viewport-width / 2 / proj-dist)` — wider terminals show
   more of the world without changing wall scale."
  70.0)

(defn- pwall?
  "Wall test against a PHP-native nested array. OOB returns nil from
   aget, which is not = 1, so the ray simply runs to max-depth and stops."
  [pgrid x y]
  (= 1 (aget pgrid y x)))

(defn cast-ray
  "March a ray from (px, py) at the given angle until it hits a wall or
   `max-depth`. Uses incremental position update (no per-step multiply)
   and a PHP-native grid lookup."
  {:export true}
  [pgrid px py angle]
  (let [dx (* (php/cos angle) step)
        dy (* (php/sin angle) step)]
    (loop [dist 0.0 x px y py]
      (cond
        (>= dist max-depth)                          max-depth
        (pwall? pgrid (php/intval x) (php/intval y)) dist
        :else                                        (recur (+ dist step) (+ x dx) (+ y dy))))))

(defn cast-frame
  "Cast `width` rays from the player. Each ray's angular offset is
   atan(col-offset / proj-dist), so wider viewports widen the FOV
   instead of changing wall scale. Fish-eye correction multiplies by
   cos of the offset angle to keep straight walls straight."
  {:export true}
  [world width]
  (let [pgrid               (:pgrid world)
        {:keys [x y angle]} (:player world)
        center              (* 0.5 width)]
    (map (fn [col]
           (let [ray-angle (+ angle (php/atan (/ (- col center) proj-dist)))
                 corrected (* (cast-ray pgrid x y ray-angle)
                              (php/cos (- ray-angle angle)))]
             {:dist corrected :angle ray-angle}))
         (range 0 width))))
