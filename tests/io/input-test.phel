(ns phel-doom-tests.io.input-test
  (:require phel.test :refer [deftest is])
  (:require phel.string :as str)
  (:require phel-doom.io.input :refer [mouse-enable mouse-disable
                                       init-escapes restore-prelude
                                       focus-enable focus-disable
                                       install-resize-handler! resized? resize-armed?
                                       pointer-limit-notice halfblock-seams?
                                       linux-console? mouse-usable? start-menu-notice
                                       linux-console-notice restore-prelude-for]))

;; ---------------------------------------------------------------------
;; Mouse reporting escape contract (issue #246). The side-effecting
;; init-input! / restore! print these strings; the pure builders
;; (init-escapes / restore-prelude) let us assert the exact bytes without
;; touching the real terminal (stty / alt-screen flip).
;; ---------------------------------------------------------------------

(deftest test-mouse-enable-is-sgr-plus-any-motion
  ;; \e[?1003h = any-motion tracking, \e[?1006h = SGR-extended encoding,
  ;; \e[>3p = XTSMPOINTER always-hide the OS pointer (#295).
  (is (= "\e[?1003h\e[?1006h\e[>3p" mouse-enable))
  (is (str/contains? mouse-enable "\e[>3p") "always-hide pointer escape present"))

(deftest test-mouse-disable-reverses-enable
  ;; Same two private modes reset (l) instead of set (h), plus \e[>1p to
  ;; restore the default XTSMPOINTER pointer visibility (#295).
  (is (= "\e[?1003l\e[?1006l\e[>1p" mouse-disable)))

(deftest test-init-escapes-include-mouse-enable-when-on
  (let [s (init-escapes true)]
    (is (str/contains? s mouse-enable) "mouse enable present when on")
    (is (str/contains? s "\e[>3u") "kitty opt-in still present")
    (is (str/contains? s "\e[?1049h") "alt screen still present")
    ;; The mouse escapes come AFTER the base setup, not before.
    (is (str/ends-with? s mouse-enable) "mouse enable appended last")))

(deftest test-init-escapes-omit-mouse-enable-when-off
  (let [s (init-escapes false)]
    (is (not (str/contains? s mouse-enable)) "no mouse enable when off")
    (is (not (str/contains? s "\e[?1006h")) "no SGR mode when off")
    (is (not (str/contains? s "\e[?1003h")) "no any-motion when off")
    ;; The keyboard / screen setup is untouched by the mouse gate (BC).
    (is (str/contains? s "\e[>3u") "kitty opt-in still present when mouse off")
    (is (str/contains? s "\e[?1049h") "alt screen still present when mouse off")
    (is (str/ends-with? s focus-enable) "ends at the focus opt-in, no mouse tail")))

(deftest test-init-escapes-always-enable-focus-tracking
  ;; #454: focus reporting is not opt-in the way the mouse is - there is
  ;; nothing to opt out of, and a terminal without the mode ignores it.
  (is (str/contains? (init-escapes true)  focus-enable))
  (is (str/contains? (init-escapes false) focus-enable))
  (is (= "\e[?1004h" focus-enable))
  (is (= "\e[?1004l" focus-disable)))

(deftest test-pointer-limit-notice-fires-only-on-unhideable-terminals
  ;; Known can't-hide terminals (#295/#313) get a start-menu caveat that the
  ;; OS arrow is cosmetic; capable / unknown terminals get nil (no notice, no
  ;; false nag). The notice is shown on the welcome screen, not at startup.
  (let [iterm (pointer-limit-notice "iTerm.app")]
    (is (some? iterm) "iTerm2 -> notice")
    (is (str/contains? iterm "cosmetic") "explains the OS arrow is cosmetic"))
  (is (some? (pointer-limit-notice "Apple_Terminal")) "Terminal.app -> notice")
  (is (some? (pointer-limit-notice "vscode")) "VS Code -> notice")
  (is (some? (pointer-limit-notice "ghostty")) "Ghostty (hides only while typing) -> notice")
  (is (nil? (pointer-limit-notice "WezTerm")) "unknown terminal -> no notice")
  (is (nil? (pointer-limit-notice "")) "unset TERM_PROGRAM -> no notice"))

(deftest test-halfblock-seams-only-apple-terminal
  ;; Only Terminal.app is on the seam allowlist (#332); pixel-tight
  ;; terminals + unknown/unset keep sub-pixel on.
  (is (= true  (halfblock-seams? "Apple_Terminal")) "Terminal.app -> seams")
  (is (= false (halfblock-seams? "iTerm.app")) "iTerm2 draws ▀ tight")
  (is (= false (halfblock-seams? "WezTerm")) "unknown terminal assumed capable")
  (is (= false (halfblock-seams? "")) "unset TERM_PROGRAM -> no seams"))

(deftest test-restore-prelude-pops-kitty-then-disables-mouse
  ;; Teardown always disables mouse reporting, regardless of whether it
  ;; was enabled (idempotent).
  (is (= (str "\e[?2026l\e[<u" mouse-disable focus-disable) restore-prelude))
  (is (str/contains? restore-prelude "\e[<u") "kitty pop present")
  (is (str/contains? restore-prelude mouse-disable) "mouse disable present")
  (is (str/contains? restore-prelude focus-disable) "focus reporting off (#454)"))

;; ---------------------------------------------------------------------
;; Linux virtual console (#545): TERM=linux, 16 colours, no xterm mouse,
;; no kitty keyboard / XTSMPOINTER / focus reporting.
;; ---------------------------------------------------------------------

(deftest test-linux-console-is-exactly-term-linux
  (is (= true  (linux-console? "linux")) "kernel VT")
  (is (= false (linux-console? "xterm-256color")) "graphical terminal")
  (is (= false (linux-console? "linux-16color")) "only the exact value")
  (is (= false (linux-console? "")) "unset TERM"))

(deftest test-init-escapes-on-the-console-keep-only-the-screen-setup
  (let [s (init-escapes true true)]
    (is (= "\e[?1049h\e[?25l\e[?7l\e[2J\e[H" s) "alt screen, caret, autowrap, clear")
    (is (not (str/contains? s "\e[>3u")) "no kitty keyboard push")
    (is (not (str/contains? s focus-enable)) "no focus reporting")
    (is (not (str/contains? s "\e[>3p")) "no XTSMPOINTER")
    (is (not (str/contains? s "\e[?1003h")) "no any-motion mouse even with mouse? on")))

(deftest test-init-escapes-off-the-console-are-unchanged
  ;; Every other terminal keeps the exact bytes it always got.
  (is (= (str "\e[?1049h\e[?25l\e[?7l\e[2J\e[H\e[>3u" focus-enable mouse-enable)
         (init-escapes true false)))
  (is (= (init-escapes true) (init-escapes true false)))
  (is (= (init-escapes false) (init-escapes false false))))

(deftest test-restore-prelude-on-the-console-only-ends-sync-output
  (is (= "\e[?2026l" (restore-prelude-for true)) "nothing to pop or disable")
  (is (= restore-prelude (restore-prelude-for false)) "other terminals unchanged"))

(deftest test-mouse-is-unusable-on-the-console-whatever-the-setting
  (is (= false (mouse-usable? true "linux")) "console: no mouselook")
  (is (= false (mouse-usable? false "linux")))
  (is (= true  (mouse-usable? true "xterm-256color")) "setting on elsewhere")
  (is (= false (mouse-usable? false "xterm-256color")) "setting off elsewhere")
  (is (= false (mouse-usable? nil "")) "missing setting reads as off"))

(deftest test-start-menu-notice-on-the-console
  (is (= linux-console-notice (start-menu-notice "" "linux")) "console notice")
  (is (= linux-console-notice (start-menu-notice "iTerm.app" "linux")) "console trumps the pointer caveat")
  (is (= (pointer-limit-notice "iTerm.app") (start-menu-notice "iTerm.app" "xterm-256color")))
  (is (nil? (start-menu-notice "" "xterm-256color")) "capable terminal -> no notice")
  ;; The menu row is 48 columns with a 2-space indent.
  (is (<= (php/mb_strwidth linux-console-notice) 46) "fits the start-menu box"))

;; ---------------------------------------------------------------------
;; SIGWINCH (#459). The loops forked `stty size` every 12th frame - a
;; ~5ms hitch at 10Hz on an 8.3ms budget, to answer a question whose
;; answer changes about once a session.
;; ---------------------------------------------------------------------

(deftest test-resized-is-false-until-the-terminal-says-otherwise
  (is (= false (resized?))))

(deftest test-resize-armed-reports-whether-the-signal-is-the-answer
  ;; The game loop drops the stty poll only when this says yes.
  (is (= false (resize-armed?)) "nothing armed before install")
  (install-resize-handler!)
  (is (= (and (php/function_exists "pcntl_signal") (php/defined "SIGWINCH"))
         (resize-armed?))))

(deftest test-resize-handler-arms-where-pcntl-exists
  ;; Reports honestly either way: false on a build without ext-pcntl,
  ;; where the frame-count poll stays the only mechanism.
  (is (= (and (php/function_exists "pcntl_signal") (php/defined "SIGWINCH"))
         (install-resize-handler!))))

(deftest test-resize-flag-clears-when-read
  ;; Raise it the way the kernel would, then confirm it is one-shot.
  (when (and (install-resize-handler!) (php/function_exists "posix_kill"))
    (php/posix_kill (php/getmypid) (php/constant "SIGWINCH"))
    (php/pcntl_signal_dispatch)
    (is (= true  (resized?)) "the signal raised the flag")
    (is (= false (resized?)) "and reading it cleared it")))
