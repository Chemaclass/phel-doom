(ns phel-doom.modules.state)

(defn new-player
  "Create a player record with floating-point position and angle in radians."
  {:export true}
  [x y angle]
  {:x x :y y :angle angle})

(defn new-world
  "Bundle map grid and player into the world state. Stores a PHP-native
   copy of the grid under :pgrid so the raycast hot loop can read cells
   via aget instead of going through Phel's persistent-vector dispatch."
  {:export true}
  [grid player]
  {:grid grid
   :pgrid (to-php-array (map to-php-array grid))
   :width (count (first grid))
   :height (count grid)
   :player player})

(defn move-player
  "Translate the player by (dx, dy) — no collision check here."
  {:export true}
  [world dx dy]
  (let [{:keys [x y]} (:player world)]
    (update world :player merge {:x (+ x dx) :y (+ y dy)})))

(defn turn-player
  "Rotate the player by dtheta radians."
  {:export true}
  [world dtheta]
  (let [a (:angle (:player world))]
    (update world :player merge {:angle (+ a dtheta)})))
