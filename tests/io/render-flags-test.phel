(ns phel-doom-tests.io.render-flags-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom-tests.io.render-fixtures :refer [world stats])
  (:require phel-doom.io.render.main :refer [frame->string]))

;; ---------------------------------------------------------------------
;; Golden hashes for the NON-default render paths.
;;
;; tests/io/render-cache-test.phel pins one point in the render
;; configuration space: everything at its default. But the renderer also
;; carries per-frame env escape hatches (PHEL_DOOM_FLAT_WALLS /
;; FLAT_FLOOR / NO_SUBPIXEL / FLAT_WALLTEX) and two settings-driven
;; toggles (:quad, :truecolor), each selecting a genuinely different emit
;; path. Nothing pinned any of them, so a refactor could silently reshape
;; the low-detail or compatibility output and every test would still pass
;; - the exact hole a cleanup audit flagged.
;;
;; Only per-frame flags are covered here. PHEL_DOOM_NO_SPRITES is
;; memoized in a module atom (first read wins) and PHEL_DOOM_FLAT_FOG is
;; baked into a load-time LUT, so neither can be toggled from inside a
;; running test process.
;;
;; Update a constant DELIBERATELY when that path's output is meant to
;; change.
;; ---------------------------------------------------------------------

(defn- with-env
  "Set every env var named in `vars` to \"1\", run `f`, and always clear
   them again - a leaked env var would silently retune every later test in
   the process."
  [vars f]
  (let [prev (php/array)]
    (foreach [k vars] (php/aset prev k (php/getenv k)))
    (try
      (foreach [k vars] (php/putenv (str k "=1")))
      (f)
      (finally
        ;; Restore the exact prior value rather than relying on putenv's
        ;; unset form: these tests run in the same process as every other
        ;; render test, and a stuck "1" would silently flip all of them to
        ;; a low-detail path.
        (foreach [k vars]
          (let [was (php/aget prev k)]
            (if (php/=== false was)
              (php/putenv k)
              (php/putenv (str k "=" was)))))))))

(defn- frame-hash [vars stats-overrides cols rows]
  (with-env vars
            (fn [] (php/md5 (frame->string world (merge stats stats-overrides) cols rows)))))

(deftest test-flat-walls-path-pinned
  (is (= "0e00e839afdeba7ae0d8acfbed6f216e"
         (frame-hash ["PHEL_DOOM_FLAT_WALLS"] {} 120 30))))

(deftest test-flat-floor-path-pinned
  (is (= "5889ac39651ebe7a3f5c7063e570ef8e"
         (frame-hash ["PHEL_DOOM_FLAT_FLOOR"] {} 120 30))))

(deftest test-no-subpixel-path-pinned
  (is (= "06b721d09e70d131e19fe23713b3c7bc"
         (frame-hash ["PHEL_DOOM_NO_SUBPIXEL"] {} 120 30))))

(deftest test-flat-walltex-path-pinned
  (is (= "efccb88bdf9a3461f46c64e8ae85856d"
         (frame-hash ["PHEL_DOOM_FLAT_WALLTEX"] {} 120 30))))

(deftest test-all-flat-plus-no-subpixel-pinned
  ;; The full compatibility path: no wall or floor texture, one colour
  ;; per cell. This is what a seam-prone terminal actually renders.
  (is (= "ef5b9ac88de1e6e23a4195faa003a9e5"
         (frame-hash ["PHEL_DOOM_FLAT_WALLS" "PHEL_DOOM_FLAT_FLOOR" "PHEL_DOOM_NO_SUBPIXEL"]
                     {} 120 30))))

(deftest test-quad-setting-path-pinned
  (is (= "4c0fcf296d2242e4624ceee1f46469e6"
         (frame-hash [] {:quad true} 120 30))))

(deftest test-truecolor-setting-path-pinned
  (is (= "dabe1f148805c19e961c7dddd35a6765"
         (frame-hash [] {:truecolor true} 120 30))))

(deftest test-flags-actually-change-the-output
  ;; Sanity: the hashes above are pinning DIFFERENT paths, not the same
  ;; default frame seven times over.
  (let [default   (frame-hash [] {} 120 30)
        flat-wall (frame-hash ["PHEL_DOOM_FLAT_WALLS"] {} 120 30)
        no-sub    (frame-hash ["PHEL_DOOM_NO_SUBPIXEL"] {} 120 30)]
    (is (not= default flat-wall) "flat walls differs from default")
    (is (not= default no-sub) "no-subpixel differs from default")
    (is (not= flat-wall no-sub) "the two compatibility paths differ")))

(deftest test-env-is-restored-after-a-flagged-render
  ;; with-env must not leak: after a flagged render, a default render must
  ;; still produce the default hash.
  (frame-hash ["PHEL_DOOM_FLAT_WALLS"] {} 120 30)
  (is (= "586338bf67d5c9f7c02b707c99f9357a"
         (php/md5 (frame->string world stats 120 30)))))

;; ---------------------------------------------------------------------
;; Texture filter (#462). Off is the default and must reproduce the
;; default golden exactly; on selects a pre-filtered smaller texture
;; level per column, so it MUST differ - and must do so deterministically.
;; ---------------------------------------------------------------------

(deftest test-texture-filter-off-is-the-default-frame
  (is (= (frame-hash [] {} 120 30)
         (frame-hash [] {:texmip? false} 120 30))))

(deftest test-texture-filter-on-changes-the-frame
  (is (not (= (frame-hash [] {} 120 30)
              (frame-hash [] {:texmip? true} 120 30)))))

(deftest test-texture-filter-is-deterministic
  (is (= (frame-hash [] {:texmip? true} 120 30)
         (frame-hash [] {:texmip? true} 120 30))))

(deftest test-texture-filter-composes-with-the-other-paths
  ;; Each of these takes a different emit path; the filter must not
  ;; break any of them, and must still change what they draw.
  (foreach [override [{:quad true} {:truecolor? true} {:px2? true}]]
    (is (not (= (frame-hash [] override 120 30)
                (frame-hash [] (merge override {:texmip? true}) 120 30)))
        (str "filter changes the frame under " (php/json_encode (keys override))))))
