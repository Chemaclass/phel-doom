(ns phel-doom-tests.glue.controls-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.glue.controls
            :refer [key-states refresh-from-keys rising-edges initial-key-snapshot
                    nav-deltas refresh-move mouse-look]))

(def blank-moves
  {:fwd          0
   :back         0
   :strafe-left  0
   :strafe-right 0
   :turn-left    0
   :turn-right   0
   :sprint       0
   :pitch-up     0
   :pitch-down   0})

(def blank-world
  {:moves blank-moves})

;; ---------------------------------------------------------------------
;; key-states: snapshot of which one-shot keys appear in the byte
;; stream this frame.
;; ---------------------------------------------------------------------

(deftest test-key-states-empty-input
  (let [s (key-states "")]
    (is (= false (:sp s)))
    (is (= false (:m  s)))
    (is (= false (:p  s)))
    (is (= false (:n  s)))
    (is (= false (:e  s)))))

(deftest test-key-states-detects-space
  (is (= true (:sp (key-states " ")))))

(deftest test-key-states-detects-multiple
  (let [s (key-states "mp")]
    (is (= true (:m s)))
    (is (= true (:p s)))
    (is (= false (:sp s)))))

(deftest test-key-states-detects-about-face
  (is (= true (:e (key-states "e")))))

;; ---------------------------------------------------------------------
;; rising-edges: a key counts as "just pressed" only when it was off
;; the previous frame and is on this frame.
;; ---------------------------------------------------------------------

(deftest test-rising-edges-fresh-press-fires
  (let [edges (rising-edges {:sp true :m false :p false :n false :e false}
                            {:sp false :m false :p false :n false :e false})]
    (is (= true (:fire edges)))
    (is (= false (:toggle-map edges)))))

(deftest test-rising-edges-held-key-does-not-refire
  ;; Space pressed both frames — that's "still held", not a new press.
  (let [edges (rising-edges {:sp true :m false :p false :n false :e false}
                            {:sp true :m false :p false :n false :e false})]
    (is (= false (:fire edges)))))

(deftest test-rising-edges-release-does-not-fire
  ;; Was on, now off → nothing to do.
  (let [edges (rising-edges {:sp false :m false :p false :n false :e false}
                            {:sp true  :m false :p false :n false :e false})]
    (is (= false (:fire edges)))))

(deftest test-rising-edges-about-face-edge
  (let [edges (rising-edges {:sp false :m false :p false :n false :e true}
                            {:sp false :m false :p false :n false :e false})]
    (is (= true (:about-face edges)))))

(deftest test-initial-key-snapshot-has-every-tracked-key
  ;; Snapshot must cover every key rising-edges peeks at, else the
  ;; first frame after launch could spuriously fire.
  (is (= false (:sp initial-key-snapshot)))
  (is (= false (:m  initial-key-snapshot)))
  (is (= false (:p  initial-key-snapshot)))
  (is (= false (:n  initial-key-snapshot)))
  (is (= false (:e  initial-key-snapshot)))
  (is (= false (:f3 initial-key-snapshot)))
  ;; Weapon-slot keys are peeked by rising-edges too; a missing key
  ;; makes (not (:kN prev)) nil->true and can spuriously fire slot N
  ;; on frame 0.
  (is (= false (:k1 initial-key-snapshot)))
  (is (= false (:k2 initial-key-snapshot)))
  (is (= false (:k3 initial-key-snapshot)))
  (is (= false (:k4 initial-key-snapshot)))
  (is (= false (:k5 initial-key-snapshot)))
  (is (= false (:k6 initial-key-snapshot)))
  (is (= false (:k7 initial-key-snapshot))))

(deftest test-key-states-detects-f3-xterm-sequence
  ;; Most terminals (xterm, macOS Terminal, iTerm2) send `\eOR` for F3.
  (is (= true (:f3 (key-states "\eOR")))))

(deftest test-key-states-detects-f3-linux-sequence
  ;; Linux console + a handful of others use the CSI `~` form.
  (is (= true (:f3 (key-states "\e[13~")))))

(deftest test-rising-edges-toggle-debug-fires-on-fresh-f3
  (let [edges (rising-edges {:sp false :m false :p false :n false :e false :f3 true}
                            {:sp false :m false :p false :n false :e false :f3 false})]
    (is (= true (:toggle-debug edges)))))

(deftest test-rising-edges-toggle-debug-does-not-refire-while-held
  (let [edges (rising-edges {:sp false :m false :p false :n false :e false :f3 true}
                            {:sp false :m false :p false :n false :e false :f3 true})]
    (is (= false (:toggle-debug edges)))))

(deftest test-key-states-detects-r
  (is (= true (:r (key-states "r")))))

(deftest test-rising-edges-reload-fires-on-fresh-r
  (let [edges (rising-edges {:sp false :m false :p false :n false :e false :r true}
                            {:sp false :m false :p false :n false :e false :r false})]
    (is (= true (:reload edges)))))

;; ---------------------------------------------------------------------
;; Weapon-slot one-shots (1/2/3) — regression: kitty CSI-u release
;; events for one slot must NOT trigger the other two.
;; ---------------------------------------------------------------------

(deftest test-key-states-detects-digits-plain
  (let [s (key-states "2")]
    (is (= false (:k1 s)))
    (is (= true  (:k2 s)))
    (is (= false (:k3 s)))))

(deftest test-key-states-kitty-press-of-key-2-only-fires-k2
  ;; \e[50u  — press of digit '2' (codepoint 50) under kitty CSI-u.
  (let [s (key-states "\e[50u")]
    (is (= false (:k1 s)))
    (is (= true  (:k2 s)))
    (is (= false (:k3 s)))))

(deftest test-key-states-kitty-release-of-key-2-still-only-fires-k2
  ;; \e[50;1:3u — release of key-2 with mods=1, event=3. Bytes '1'
  ;; and '3' inside the CSI must NOT match plain '1' / '3', and the
  ;; release event itself must NOT match k2's press regex either.
  (let [s (key-states "\e[50;1:3u")]
    (is (= false (:k1 s)))
    (is (= false (:k2 s)))
    (is (= false (:k3 s)))))

(deftest test-key-states-kitty-repeat-of-key-2-does-not-fire-press
  ;; \e[50;1:2u — repeat event. Must not register as a press.
  (let [s (key-states "\e[50;1:2u")]
    (is (= false (:k2 s)))))

(deftest test-key-states-kitty-press-of-key-1-with-mods
  ;; \e[49;1u — kitty press with mods, no explicit event marker.
  (let [s (key-states "\e[49;1u")]
    (is (= true  (:k1 s)))
    (is (= false (:k2 s)))
    (is (= false (:k3 s)))))

(deftest test-key-states-letter-key-not-confused-by-digit-in-csi
  ;; A CSI containing '1' must not light up :k1.
  (is (= false (:k1 (key-states "\e[1;2D"))))
  ;; ...but plain "1" still does.
  (is (= true  (:k1 (key-states "1")))))

;; ---------------------------------------------------------------------
;; H info menu toggle. Symmetric with the other rising-edge toggles —
;; pressing H once flips :help?, pressing again flips it back. Held
;; H doesn't refire.
;; ---------------------------------------------------------------------

(deftest test-key-states-detects-h
  (is (= true  (:h (key-states "h"))))
  (is (= false (:h (key-states "")))))

(deftest test-key-states-detects-h-via-kitty-press
  ;; 104 = codepoint of lowercase 'h'.
  (is (= true (:h (key-states "\e[104u")))))

(deftest test-rising-edges-toggle-help-fires-on-fresh-h
  (let [edges (rising-edges (assoc initial-key-snapshot :h true)
                            initial-key-snapshot)]
    (is (= true (:toggle-help edges)))))

(deftest test-rising-edges-toggle-help-does-not-refire-while-held
  (let [held (assoc initial-key-snapshot :h true)]
    (is (= false (:toggle-help (rising-edges held held))))))

;; ---------------------------------------------------------------------
;; ESC: bare ESC byte closes whichever modal is open. Must NOT fire
;; on directional escape sequences (arrow keys, kitty events, F3).
;; ---------------------------------------------------------------------

(deftest test-key-states-detects-bare-esc
  (is (= true  (:esc (key-states "\e"))))
  (is (= false (:esc (key-states "")))))

(deftest test-key-states-ignores-esc-inside-csi
  ;; Arrow keys (`\e[A` etc), kitty CSI-u events, F3 (`\eOR`,
  ;; `\e[13~`) all start with ESC but must NOT register as
  ;; bare-ESC presses — those bytes are part of a sequence.
  (is (= false (:esc (key-states "\e[A"))))
  (is (= false (:esc (key-states "\e[B"))))
  (is (= false (:esc (key-states "\e[D"))))
  (is (= false (:esc (key-states "\eOR"))))    ; F3 xterm
  (is (= false (:esc (key-states "\e[13~"))))  ; F3 linux
  (is (= false (:esc (key-states "\e[50;1:3u"))))) ; kitty release

(deftest test-key-states-esc-with-trailing-input
  ;; ESC mixed with arrow keys should still detect the bare ESC.
  (is (= true (:esc (key-states "\e[A\e")))))

(deftest test-key-states-detects-kitty-esc
  ;; Kitty CSI-u: ESC (keycode 27) arrives wrapped as `\e[27u` (or
  ;; with `;mods` / `;mods:1` for press). Without explicit handling
  ;; the legacy CSI-strip erases the whole sequence and ESC is never
  ;; seen on kitty/WezTerm/Ghostty.
  (is (= true (:esc (key-states "\e[27u"))))
  (is (= true (:esc (key-states "\e[27;1u"))))
  (is (= true (:esc (key-states "\e[27;1:1u"))))
  ;; Repeat (`:2`) and release (`:3`) must NOT count as a press.
  (is (= false (:esc (key-states "\e[27;1:2u"))))
  (is (= false (:esc (key-states "\e[27;1:3u")))))

(deftest test-rising-edges-esc-fires-toggle-help
  ;; ESC is aliased to H — fresh ESC press lights up :toggle-help so
  ;; the info panel opens/closes exactly like pressing H.
  (let [edges (rising-edges (assoc initial-key-snapshot :esc true)
                            initial-key-snapshot)]
    (is (= true (:toggle-help edges)))))

(deftest test-rising-edges-esc-does-not-refire-while-held
  (let [held (assoc initial-key-snapshot :esc true)]
    (is (= false (:toggle-help (rising-edges held held))))))

(deftest test-rising-edges-h-fires-toggle-help
  (let [edges (rising-edges (assoc initial-key-snapshot :h true)
                            initial-key-snapshot)]
    (is (= true (:toggle-help edges)))))

;; ---------------------------------------------------------------------
;; Sprint: SHIFT-modified kitty CSI-u press of any movement key OR plain
;; 'x' byte refreshes the :sprint slot. Release events / plain
;; movement (no SHIFT mod) must NOT light up :sprint.
;;
;; Kitty CSI-u mods are encoded as (bits + 1); bit 0 = SHIFT, so SHIFT
;; alone is mods=2. Event 3 = release.
;; ---------------------------------------------------------------------

(deftest test-kitty-shift-mod-on-w-refreshes-sprint-slot
  ;; \e[119;2u — press of 'w' (codepoint 119) with mods=2 (SHIFT).
  ;; Also refreshes :fwd (W is still W).
  (let [w' (refresh-from-keys blank-world "\e[119;2u")]
    (is (php/> (:sprint (:moves w')) 0))
    (is (php/> (:fwd    (:moves w')) 0))))

(deftest test-kitty-no-mod-on-w-leaves-sprint-untouched
  (let [w' (refresh-from-keys blank-world "\e[119u")]
    (is (= 0 (:sprint (:moves w'))))
    (is (php/> (:fwd (:moves w')) 0))))

(deftest test-kitty-shift-mod-release-does-not-refresh-sprint
  ;; \e[119;2:3u — release event with shift held. Sprint slot stays 0.
  (let [w' (refresh-from-keys blank-world "\e[119;2:3u")]
    (is (= 0 (:sprint (:moves w'))))
    (is (= 0 (:fwd    (:moves w'))))))

(deftest test-x-byte-refreshes-sprint-slot
  ;; Legacy / non-kitty fallback: plain 'x' byte arms sprint.
  (let [w' (refresh-from-keys blank-world "x")]
    (is (php/> (:sprint (:moves w')) 0))))

(deftest test-x-still-works-under-kitty-as-codepoint-120
  ;; Under kitty, 'x' arrives wrapped as \e[120u. Must still hit :sprint.
  (let [w' (refresh-from-keys blank-world "\e[120u")]
    (is (php/> (:sprint (:moves w')) 0))))

(deftest test-sprint-slot-uses-short-hold-frames
  ;; Regression: the :sprint slot must NOT inherit the 18-frame
  ;; move-hold-frames bridge. Otherwise releasing SHIFT while still
  ;; walking forward would leave sprint hot for ~300ms — phantom
  ;; drain. sprint-hold-frames (3) matches turn-hold-frames so
  ;; release feels instant.
  (let [w' (refresh-from-keys blank-world "x")]
    (is (php/<= (:sprint (:moves w')) 5))))

;; ---------------------------------------------------------------------
;; Look up/down (pitch): ↑/↓ arrows arm :pitch-up / :pitch-down on every
;; encoding (legacy CSI \e[A/\e[B, SS3 \eOA/\eOB, kitty-enhanced
;; \e[1;..A/B). 't'/'g' are no longer bound.
;; ---------------------------------------------------------------------

(deftest test-up-arrow-refreshes-pitch-up-slot
  (let [w' (refresh-from-keys blank-world "\e[A")]
    (is (php/> (:pitch-up   (:moves w')) 0))
    (is (= 0   (:pitch-down (:moves w'))))
    (is (= 0   (:fwd        (:moves w'))) "up arrow looks, no longer moves forward")))

(deftest test-down-arrow-refreshes-pitch-down-slot
  (let [w' (refresh-from-keys blank-world "\e[B")]
    (is (php/> (:pitch-down (:moves w')) 0))
    (is (= 0   (:pitch-up   (:moves w'))))
    (is (= 0   (:back       (:moves w'))) "down arrow looks, no longer moves back")))

(deftest test-ss3-up-down-arrows-pitch
  ;; App-cursor SS3 form (tmux / alt-screen) reaches the same slots.
  (is (php/> (:pitch-up   (:moves (refresh-from-keys blank-world "\eOA"))) 0))
  (is (php/> (:pitch-down (:moves (refresh-from-keys blank-world "\eOB"))) 0)))

(deftest test-kitty-enhanced-up-down-arrows-pitch
  ;; Kitty enhanced arrows keep the legacy letter suffix: \e[1;mods:eventA.
  (is (php/> (:pitch-up   (:moves (refresh-from-keys blank-world "\e[1;1:1A"))) 0))
  (is (php/> (:pitch-down (:moves (refresh-from-keys blank-world "\e[1;1:1B"))) 0)))

(deftest test-refresh-move-maps-up-standin-to-pitch-up
  ;; refresh-move sees the normalised single-byte stand-in (^ = up arrow);
  ;; it lands in exactly :pitch-up, nothing else.
  (let [w' (refresh-move blank-world "^")]
    (is (= (assoc blank-moves :pitch-up (:pitch-up (:moves w')))
           (:moves w')))))

(deftest test-t-and-g-no-longer-bound
  ;; The old t/g pitch keys are freed - they touch no slot now.
  (is (= blank-moves (:moves (refresh-from-keys blank-world "t"))))
  (is (= blank-moves (:moves (refresh-from-keys blank-world "g")))))

(deftest test-pitch-slot-uses-short-hold-frames
  ;; Pitch halts fast (like turn), not the long move-hold bridge, so the
  ;; camera doesn't keep drifting after the key is released.
  (let [w' (refresh-from-keys blank-world "\e[A")]
    (is (php/<= (:pitch-up (:moves w')) 5))))

;; ---------------------------------------------------------------------
;; Capital WASD: legacy fallback so SHIFT+WASD sprints on terminals
;; without kitty CSI-u (Terminal.app, plain xterm, GNOME Terminal).
;; In cooked raw mode SHIFT just uppercases the byte, so SHIFT+W = 'W'.
;; ---------------------------------------------------------------------

(deftest test-capital-w-refreshes-fwd-and-sprint
  (let [w' (refresh-from-keys blank-world "W")]
    (is (php/> (:fwd    (:moves w')) 0))
    (is (php/> (:sprint (:moves w')) 0))))

(deftest test-capital-s-refreshes-back-and-sprint
  (let [w' (refresh-from-keys blank-world "S")]
    (is (php/> (:back   (:moves w')) 0))
    (is (php/> (:sprint (:moves w')) 0))))

(deftest test-capital-a-refreshes-strafe-left-and-sprint
  (let [w' (refresh-from-keys blank-world "A")]
    (is (php/> (:strafe-left (:moves w')) 0))
    (is (php/> (:sprint      (:moves w')) 0))))

(deftest test-capital-d-refreshes-strafe-right-and-sprint
  (let [w' (refresh-from-keys blank-world "D")]
    (is (php/> (:strafe-right (:moves w')) 0))
    (is (php/> (:sprint       (:moves w')) 0))))

(deftest test-lowercase-w-does-not-arm-sprint
  ;; Plain w (no SHIFT) must NOT light up :sprint — only capitals do.
  (let [w' (refresh-from-keys blank-world "w")]
    (is (php/> (:fwd    (:moves w')) 0))
    (is (= 0 (:sprint (:moves w'))))))

;; ---------------------------------------------------------------------
;; Settings page (issue #107): nav-deltas turns the raw drain string
;; into net cursor / value steps. Arrows (CSI / SS3 / kitty) AND WASD
;; both count, and counting (not a bool) means a held key's OS-repeat
;; burst ramps a slider.
;; ---------------------------------------------------------------------

(deftest test-nav-deltas-csi-arrows
  (is (= {:cursor 1  :value 0}  (nav-deltas "\e[B")) "down")
  (is (= {:cursor -1 :value 0}  (nav-deltas "\e[A")) "up")
  (is (= {:cursor 0  :value 1}  (nav-deltas "\e[C")) "right")
  (is (= {:cursor 0  :value -1} (nav-deltas "\e[D")) "left"))

(deftest test-nav-deltas-ss3-arrows
  ;; SS3 application-cursor form (`\eO*`) common under tmux / alt-screen.
  (is (= {:cursor 1 :value 0}  (nav-deltas "\eOB")))
  (is (= {:cursor 0 :value -1} (nav-deltas "\eOD"))))

(deftest test-nav-deltas-modified-and-kitty-arrows
  (is (= {:cursor -1 :value 0} (nav-deltas "\e[1;2A")) "shift+up")
  (is (= {:cursor -1 :value 0} (nav-deltas "\e[1;1:1A")) "kitty up press"))

(deftest test-nav-deltas-excludes-kitty-release-events
  ;; Regression (menu double-move): with report-event-types on
  ;; (\e[>3u in init-input!), a single arrow tap sends a PRESS and a
  ;; RELEASE (:3). Counting both moved the settings cursor twice per
  ;; keypress. Release events must NOT count.
  (is (= {:cursor 0 :value 0} (nav-deltas "\e[1;1:3B")) "release alone = no move")
  (is (= {:cursor 1 :value 0} (nav-deltas "\e[B\e[1;1:3B")) "bare press + release = one move")
  (is (= {:cursor 1 :value 0} (nav-deltas "\e[1;1:1B\e[1;1:3B")) "press + release = one move"))

(deftest test-nav-deltas-counts-kitty-repeat-for-ramp
  ;; A held arrow on kitty sends press then repeat (:2) events; both
  ;; count so the slider still ramps. Only release (:3) is dropped.
  (is (= {:cursor 3 :value 0} (nav-deltas "\e[1;1:1B\e[1;1:2B\e[1;1:2B"))))

(deftest test-nav-deltas-wasd-fallback
  ;; WASD navigates too, so the page works even when arrows aren't
  ;; recognised by the terminal.
  (is (= {:cursor 1  :value 0}  (nav-deltas "s")) "s = down")
  (is (= {:cursor -1 :value 0}  (nav-deltas "w")) "w = up")
  (is (= {:cursor 0  :value 1}  (nav-deltas "d")) "d = right")
  (is (= {:cursor 0  :value -1} (nav-deltas "a")) "a = left"))

(deftest test-nav-deltas-counts-repeats-for-ramp
  ;; A held key's repeated bytes accumulate so a slider ramps.
  (is (= {:cursor 0 :value 3}  (nav-deltas "ddd")))
  (is (= {:cursor -2 :value 0} (nav-deltas "\e[A\e[A"))))

(deftest test-nav-deltas-empty-and-non-nav
  (is (= {:cursor 0 :value 0} (nav-deltas "")))
  ;; F3's SS3 (`\eOR`) shares the `\eO` prefix but a different final
  ;; byte, so it is not mistaken for an arrow.
  (is (= {:cursor 0 :value 0} (nav-deltas "\eOR"))))

(deftest test-ss3-arrow-drives-in-game-turn
  ;; The SS3 form also feeds the movement path so turning works under
  ;; app-cursor mode, not just menu nav.
  (let [w' (refresh-from-keys blank-world "\eOD")]
    (is (php/> (:turn-left (:moves w')) 0)))
  (let [w' (refresh-from-keys blank-world "\eOC")]
    (is (php/> (:turn-right (:moves w')) 0))))

;; ---------------------------------------------------------------------
;; Menu confirm (#225): key-states :enter detects ENTER/Return; the
;; :confirm rising edge (space OR enter) drives pause-menu select +
;; settings back-out. Edge-gated so a held key can't auto-select.
;; ---------------------------------------------------------------------

(deftest test-key-states-detects-enter
  (is (= true (:enter (key-states "\r"))) "CR is Enter")
  (is (= true (:enter (key-states "\n"))) "LF is Enter")
  (is (not (:enter (key-states ""))) "no Enter in empty input")
  (is (not (:enter (key-states "x"))) "a plain key is not Enter"))

(deftest test-rising-edges-confirm-fires-on-enter
  (let [edges (rising-edges {:sp false :enter true} {:sp false :enter false})]
    (is (= true (:confirm edges)) "fresh Enter confirms")))

(deftest test-rising-edges-confirm-fires-on-space
  (let [edges (rising-edges {:sp true :enter false} {:sp false :enter false})]
    (is (= true (:confirm edges)) "fresh space confirms")))

(deftest test-rising-edges-confirm-held-does-not-refire
  ;; Held space/enter (e.g. fire carried from gameplay into pause, or
  ;; Enter auto-repeat) must NOT keep confirming - edge only.
  (is (= false (:confirm (rising-edges {:sp true :enter false} {:sp true :enter false}))))
  (is (= false (:confirm (rising-edges {:sp false :enter true} {:sp false :enter true})))))

(deftest test-rising-edges-confirm-silent-when-idle
  (is (= false (:confirm (rising-edges {:sp false :enter false} {:sp false :enter false})))))

;; ---------------------------------------------------------------------
;; Mouse look (issue #246): pure SGR-mouse parse -> per-frame yaw/pitch
;; delta + fire intent. SGR report shape: ESC [ < b ; Cx ; Cy (M|m).
;;   b = 0  -> left button press (discrete)
;;   b = 32 -> motion bit set, button 0 = LEFT DRAG (held during move)
;;   b = 35 -> motion bit set, low bits 3 = bare hover (no button held)
;; Deltas are measured against the previous pointer position; motion
;; RIGHT (+dx) -> +yaw, motion UP (-dy, rows grow downward) -> +pitch.
;; Scales: yaw 0.018, pitch 0.02 rad/fraction per cell at sensitivity 1.
;; ---------------------------------------------------------------------

;; Shared baseline so deltas are computed immediately (a non-nil prev-pos
;; skips the first-report-establishes-baseline rule).
(def mouse-origin [10 10])

(defn- approx?
  "Float compare with a tolerance, so e.g. -6 * 0.018 (which lands on
   -0.10799999... not the exact literal) still matches -0.108."
  [^float a ^float b]
  (php/< (php/abs (php/- a b)) 1.0e-9))

(deftest test-mouse-look-no-bytes-is-zero-delta
  ;; The keyboard path must be untouched: empty input yields no delta and
  ;; carries prev-pos forward unchanged.
  (let [r (mouse-look "" mouse-origin 1.0)]
    (is (= 0.0 (:yaw r)))
    (is (= 0.0 (:pitch r)))
    (is (= false (:fire? r)))
    (is (= false (:fire-held? r)))
    (is (= mouse-origin (:pos r)) "prev-pos carried forward")))

(deftest test-mouse-look-motion-right-yields-positive-yaw
  ;; Hover (b=35) from x=10 to x=15: dx=+5 -> yaw = 5 * 0.018 = 0.09.
  ;; No pitch (dy=0), no fire (hover, not a press / drag).
  (let [r (mouse-look "\e[<35;15;10M" mouse-origin 1.0)]
    (is (approx? 0.09 (:yaw r)) "+dx -> +yaw")
    (is (= 0.0 (:pitch r)))
    (is (= false (:fire? r)))
    (is (= false (:fire-held? r)) "bare hover is not held-fire")
    (is (= [15 10] (:pos r)))))

(deftest test-mouse-look-motion-left-yields-negative-yaw
  ;; Hover from x=10 to x=4: dx=-6 -> yaw = -6 * 0.018 = -0.108.
  (let [r (mouse-look "\e[<35;4;10M" mouse-origin 1.0)]
    (is (approx? -0.108 (:yaw r)) "-dx -> -yaw")
    (is (= 0.0 (:pitch r)))))

(deftest test-mouse-look-motion-up-yields-positive-pitch
  ;; Hover from y=10 to y=6: rows grow DOWNWARD so up is dy=-4; the
  ;; negation makes pitch = -(-4) * 0.02 = +0.08 (look up).
  (let [r (mouse-look "\e[<35;10;6M" mouse-origin 1.0)]
    (is (approx? 0.08 (:pitch r)) "moving up -> +pitch")
    (is (= 0.0 (:yaw r)))))

(deftest test-mouse-look-motion-down-yields-negative-pitch
  ;; Hover from y=10 to y=14: down is dy=+4 -> pitch = -4 * 0.02 = -0.08.
  (let [r (mouse-look "\e[<35;10;14M" mouse-origin 1.0)]
    (is (approx? -0.08 (:pitch r)) "moving down -> -pitch")))

(deftest test-mouse-look-left-press-fires
  ;; Discrete left press (b=0, final M) at the origin: no delta, but
  ;; :fire? and :fire-held? both set so a click shoots like space.
  (let [r (mouse-look "\e[<0;10;10M" mouse-origin 1.0)]
    (is (= true (:fire? r)) "left press fires")
    (is (= true (:fire-held? r)) "press counts as held this frame")
    (is (= 0.0 (:yaw r)) "press at the same cell adds no delta")
    (is (= 0.0 (:pitch r)))))

(deftest test-mouse-look-left-release-does-not-fire
  ;; Release (final m) at the origin: NOT a press, button not down.
  (let [r (mouse-look "\e[<0;10;10m" mouse-origin 1.0)]
    (is (= false (:fire? r)) "release is not a press")
    (is (= false (:fire-held? r)) "release is not held")))

(deftest test-mouse-look-left-drag-is-held-fire-and-turns
  ;; Left DRAG (b=32: motion bit + button 0) from x=10 to x=15: turns
  ;; (+yaw) AND holds the trigger (auto-fire weapons spray while dragged),
  ;; but is NOT a fresh press edge.
  (let [r (mouse-look "\e[<32;15;10M" mouse-origin 1.0)]
    (is (= false (:fire? r)) "a drag is not a rising-edge press")
    (is (= true (:fire-held? r)) "left held during drag = held-fire")
    (is (approx? 0.09 (:yaw r)) "drag still turns")))

(deftest test-mouse-look-multiple-events-accumulate
  ;; Two hover reports in one frame: 10->15 (dx+5) then 15->20 (dx+5).
  ;; Deltas sum: total dx=10 -> yaw = 10 * 0.018 = 0.18; pos ends at 20.
  (let [r (mouse-look "\e[<35;15;10M\e[<35;20;10M" mouse-origin 1.0)]
    (is (approx? 0.18 (:yaw r)) "deltas across the frame sum")
    (is (= [20 10] (:pos r)) "pos trails the last report")))

(deftest test-mouse-look-press-then-move-fires-and-turns
  ;; A press followed by a hover move in the same frame: fire AND yaw.
  (let [r (mouse-look "\e[<0;10;10M\e[<35;16;10M" mouse-origin 1.0)]
    (is (= true (:fire? r)) "the press still registers")
    (is (approx? 0.108 (:yaw r)) "the move still turns (dx +6 -> 0.108)")))

(deftest test-mouse-look-sensitivity-scales-the-delta
  ;; sensitivity 2.0 doubles, 0.0 zeroes the look (mouselook effectively
  ;; off) while leaving fire untouched. dx=5 -> 5 * 0.018 * 2.0 = 0.18.
  (is (approx? 0.18 (:yaw (mouse-look "\e[<35;15;10M" mouse-origin 2.0))) "2x sensitivity doubles yaw")
  (is (= 0.0  (:yaw (mouse-look "\e[<35;15;10M" mouse-origin 0.0))) "0 sensitivity = no look")
  (let [r (mouse-look "\e[<0;10;10M" mouse-origin 0.0)]
    (is (= true (:fire? r)) "0 sensitivity still lets a click fire")))

(deftest test-mouse-look-yaw-tracks-pointer-speed
  ;; Issue #275: the camera turn must TRACK how fast the pointer moves -
  ;; a 2x-bigger per-frame delta yields ~2x the yaw at a FIXED sensitivity
  ;; (fast flick = fast turn, slow nudge = slow turn). Pin the linear,
  ;; clamp-free proportionality so a future tweak can't silently flatten
  ;; it. dx=4 vs dx=8 at sensitivity 1.0; pitch tracks dy the same way.
  (let [slow (mouse-look "\e[<35;14;10M" mouse-origin 1.0)   ; dx=+4
        fast (mouse-look "\e[<35;18;10M" mouse-origin 1.0)]  ; dx=+8
    (is (approx? (php/* 2.0 (:yaw slow)) (:yaw fast))
        "2x pointer delta = 2x yaw at fixed sensitivity")
    (is (php/> (:yaw fast) (:yaw slow)) "faster flick turns more"))
  (let [slow (mouse-look "\e[<35;10;7M" mouse-origin 1.0)    ; dy=-3 (up)
        fast (mouse-look "\e[<35;10;4M" mouse-origin 1.0)]   ; dy=-6 (up)
    (is (approx? (php/* 2.0 (:pitch slow)) (:pitch fast))
        "2x vertical delta = 2x pitch at fixed sensitivity")))

(deftest test-mouse-look-proportionality-holds-under-sensitivity
  ;; The delta->yaw proportionality is preserved AFTER the sensitivity
  ;; multiplier: at any fixed sensitivity, doubling the delta doubles the
  ;; yaw (sensitivity scales the whole proportional response, #275). Here
  ;; sensitivity is the wider 3.0x high-end multiplier from core/settings.
  (let [slow (mouse-look "\e[<35;14;10M" mouse-origin 3.0)   ; dx=+4
        fast (mouse-look "\e[<35;18;10M" mouse-origin 3.0)]  ; dx=+8
    (is (approx? (php/* 2.0 (:yaw slow)) (:yaw fast))
        "proportionality survives the sensitivity scale")
    (is (approx? (php/* 4.0 0.018 3.0) (:yaw slow)) "yaw = dx * yaw-scale * sensitivity")))

(deftest test-mouse-look-first-report-only-sets-baseline
  ;; prev-pos nil (no prior report this session): the first position
  ;; report ESTABLISHES the baseline and contributes NO delta, so the
  ;; pointer's opening absolute coords can't read as one giant jump.
  (let [r (mouse-look "\e[<35;40;20M" nil 1.0)]
    (is (= 0.0 (:yaw r)) "first report = baseline, no yaw")
    (is (= 0.0 (:pitch r)) "first report = baseline, no pitch")
    (is (= [40 20] (:pos r)) "baseline recorded for next frame")))

(deftest test-mouse-look-wheel-tick-adds-no-look-delta
  ;; A scroll-wheel report (bit 6 set: b=64 up / b=65 down) carries no
  ;; look intent. Even if its reported cell differs from the baseline, it
  ;; must NOT feed yaw/pitch - but it advances :pos so a following real
  ;; motion still measures from the true pointer spot.
  (let [r (mouse-look "\e[<64;30;30M" mouse-origin 1.0)]
    (is (= 0.0 (:yaw r)) "wheel adds no yaw")
    (is (= 0.0 (:pitch r)) "wheel adds no pitch")
    (is (= false (:fire? r)) "wheel is not a fire")
    (is (= [30 30] (:pos r)) "but :pos still advances to the wheel cell"))
  ;; Wheel tick then a hover from the wheel's cell: only the hover counts.
  (let [r (mouse-look "\e[<64;30;30M\e[<35;33;30M" mouse-origin 1.0)]
    (is (approx? 0.054 (:yaw r)) "delta measured from the wheel cell (33-30=3)")))

(deftest test-mouse-look-malformed-sequence-ignored
  ;; A truncated SGR report (missing the y coord + terminator) does not
  ;; match the parser, so it produces no delta and leaves prev-pos as-is.
  (let [r (mouse-look "\e[<35;15M" mouse-origin 1.0)]
    (is (= 0.0 (:yaw r)))
    (is (= 0.0 (:pitch r)))
    (is (= mouse-origin (:pos r)) "malformed leaves baseline untouched")))

(deftest test-mouse-look-ignores-kitty-key-event
  ;; REGRESSION: a kitty CSI-u key report (e.g. 'a' press = \e[97;1:1u)
  ;; shares the ESC-[ prefix but is NOT an SGR mouse report. It must NOT
  ;; produce a look delta or fire, so the mouse parser can never hijack
  ;; the keyboard path.
  (let [r (mouse-look "\e[97;1:1u" mouse-origin 1.0)]
    (is (= 0.0 (:yaw r)) "kitty key is not mouse motion")
    (is (= 0.0 (:pitch r)))
    (is (= false (:fire? r)) "kitty key is not a mouse click")
    (is (= mouse-origin (:pos r)))))

(deftest test-mouse-look-ignores-arrow-and-fkey
  ;; REGRESSION: legacy arrow (\e[C) and F-key (\eOR = F3) sequences are
  ;; not SGR mouse reports either - no delta, no fire.
  (let [arrow (mouse-look "\e[C" mouse-origin 1.0)
        fkey  (mouse-look "\eOR" mouse-origin 1.0)]
    (is (= 0.0 (:yaw arrow)) "arrow is not mouse motion")
    (is (= false (:fire? arrow)))
    (is (= 0.0 (:yaw fkey)) "F-key is not mouse motion")
    (is (= false (:fire? fkey)))))

(deftest test-mouse-look-mixed-keyboard-and-mouse-bytes
  ;; A frame can carry BOTH a WASD byte and a mouse report (drained
  ;; together). mouse-look only parses the SGR part; the 'w' is ignored
  ;; here (refresh-from-keys handles it elsewhere) but must not corrupt
  ;; the delta.
  (let [r (mouse-look "w\e[<35;15;10Md" mouse-origin 1.0)]
    (is (approx? 0.09 (:yaw r)) "WASD bytes around the report don't affect yaw")
    (is (= [15 10] (:pos r)))))

(deftest test-mouse-look-bytes-do-not-leak-into-key-parsing
  ;; REGRESSION (the inverse guard): an SGR mouse report fed to the
  ;; keyboard parsers must not be mistaken for movement / fire. The
  ;; report's digits ('1', '5', '3', '2') and 'M' must not trip key-states
  ;; or refresh-move into phantom input.
  (let [drag "\e[<32;15;10M"
        st   (key-states drag)
        w'   (refresh-from-keys blank-world drag)]
    (is (= false (:sp st)) "no phantom fire from the mouse digits")
    (is (= blank-moves (:moves w')) "no phantom movement from the report")))

(deftest test-mouse-look-right-button-does-not-fire
  ;; Right-button report (b=2: low bits 2 = button 2, final M). Only the
  ;; LEFT button maps to fire, so a right click must leave :fire? /
  ;; :fire-held? clear (and at the same cell adds no look delta).
  (let [r (mouse-look "\e[<2;10;10M" mouse-origin 1.0)]
    (is (= false (:fire? r)) "right press is not a fire edge")
    (is (= false (:fire-held? r)) "right button is not held-fire")
    (is (= 0.0 (:yaw r)) "right press at the same cell adds no yaw")
    (is (= 0.0 (:pitch r)))))

(deftest test-mouse-look-middle-button-does-not-fire
  ;; Middle-button report (b=1: low bits 1 = button 1, final M). Same rule
  ;; as the right button - only button 0 (left) fires.
  (let [r (mouse-look "\e[<1;10;10M" mouse-origin 1.0)]
    (is (= false (:fire? r)) "middle press is not a fire edge")
    (is (= false (:fire-held? r)) "middle button is not held-fire")
    (is (= 0.0 (:yaw r)) "middle press at the same cell adds no yaw")))

(deftest test-mouse-look-press-then-release-fires-once
  ;; A full click in ONE drained frame: left press (M) immediately
  ;; followed by its release (m), both at the origin. :fire? is OR'd
  ;; across the events, so the press still latches the single rising-edge
  ;; fire; the trailing release neither re-fires nor un-fires it. :held?
  ;; is OR'd too, so the in-frame press keeps it set for this frame even
  ;; though the button is up by the end (the press itself is held-fire).
  (let [r (mouse-look "\e[<0;10;10M\e[<0;10;10m" mouse-origin 1.0)]
    (is (= true (:fire? r)) "press latches one fire even with a trailing release")
    (is (= true (:fire-held? r)) "the in-frame press counts as held this frame")
    (is (= 0.0 (:yaw r)) "click in place adds no look delta")
    (is (= [10 10] (:pos r)) "pos trails the last (release) report"))
  ;; The NEXT frame, fed only the release tail (button already up), is a
  ;; clean no-op: no fire, no held, no delta.
  (let [r (mouse-look "\e[<0;10;10m" mouse-origin 1.0)]
    (is (= false (:fire? r)) "release-only frame does not fire")
    (is (= false (:fire-held? r)) "release-only frame is not held")
    (is (= 0.0 (:yaw r)))))

(deftest test-mouse-look-left-drag-counts-as-held-fire
  ;; PIN (existing-correct): a left DRAG (b=32, motion bit + button 0) is
  ;; the terminal's only "trigger still down" signal during motion, so it
  ;; must read as held-fire (auto-fire weapons spray) without being a fresh
  ;; press edge. Distinct from the right/middle buttons above, which never
  ;; fire at all.
  (let [r (mouse-look "\e[<32;12;10M" mouse-origin 1.0)]
    (is (= true (:fire-held? r)) "left drag = held-fire")
    (is (= false (:fire? r)) "but not a rising-edge press")))

(deftest test-mouse-look-wide-flick-yields-proportional-yaw
  ;; Large-delta saturation: a single wide pointer flick from x=10 to
  ;; x=110 (a ~100-cell sweep across a wide terminal) yields a yaw that is
  ;; exactly proportional to the travel: dx=100 -> 100 * 0.018 = 1.8 rad.
  ;; No clamping inside mouse-look itself - the proportionality is linear
  ;; right up to wherever the terminal stops reporting.
  (let [r (mouse-look "\e[<35;110;10M" mouse-origin 1.0)]
    (is (approx? 1.8 (:yaw r)) "wide flick -> proportional yaw (100 cells)")
    (is (= 0.0 (:pitch r)) "horizontal flick has no pitch")
    (is (= [110 10] (:pos r)) "pos trails the flick endpoint")))

(deftest test-mouse-look-edge-clamped-coords-yield-zero-delta
  ;; PIN the docstring's edge-clamp promise: terminals report ABSOLUTE
  ;; clamped cell coords with no pointer lock, so once the pointer
  ;; saturates at a screen edge it reports the SAME clamped cell every
  ;; frame. Two consecutive reports at the same edge cell therefore carry
  ;; a zero delta - the terminal equivalent of the mouse running off the
  ;; pad. Drive the pointer to an edge cell, then hold there: the second
  ;; report adds no further yaw/pitch.
  (let [edge [120 1]
        held (mouse-look "\e[<35;120;1M" edge 1.0)]
    (is (= 0.0 (:yaw held)) "re-report at the clamped edge cell adds no yaw")
    (is (= 0.0 (:pitch held)) "and no pitch")
    (is (= [120 1] (:pos held)) "pos stays pinned at the edge cell"))
  ;; A flick INTO the edge, then a second report stuck at the edge: only
  ;; the approach contributes; the saturated tail is a zero delta.
  (let [r (mouse-look "\e[<35;120;10M\e[<35;120;10M" mouse-origin 1.0)]
    (is (approx? (php/* 110 0.018) (:yaw r)) "only the approach to the edge turns; the stuck tail adds nothing")))

;; ---------------------------------------------------------------------
;; mouse-look EDGE-TURN CONTINUATION (#288): with the live [rows cols]
;; threaded in, a pointer in the thin outer band adds a CONTINUOUS yaw in
;; that direction (signed + ramped with depth) on TOP of the saturated
;; delta, so pushing into an edge keeps the camera turning. The central
;; region stays pure delta (old feel). band on 120 cols = max(2, 8% of
;; 120) = 10; edge-turn rate 0.06 rad/frame at full depth.
;; ---------------------------------------------------------------------

(def look-dims
  "Live [rows cols] for edge-turn tests: 30 rows, 120 cols (band = 10)."
  [30 120])

(deftest test-mouse-look-right-edge-continues-turning-right
  ;; Pointer parked at the very right edge cell (x=cols=120) with NO delta
  ;; (re-report at the same edge cell): the saturated delta is zero, but
  ;; edge-turn adds a positive (turn-right) yaw at full depth = +0.06.
  (let [r (mouse-look "\e[<35;120;15M" [120 15] 1.0 look-dims)]
    (is (approx? 0.06 (:yaw r)) "right edge -> continuous +yaw (turn right) even with zero delta")
    (is (= 0.0 (:pitch r)) "edge-turn is yaw-only")))

(deftest test-mouse-look-left-edge-continues-turning-left
  ;; Pointer parked at the very left edge cell (x=1): edge-turn adds a
  ;; negative (turn-left) yaw at full depth = -0.06.
  (let [r (mouse-look "\e[<35;1;15M" [1 15] 1.0 look-dims)]
    (is (approx? -0.06 (:yaw r)) "left edge -> continuous -yaw (turn left)")
    (is (= 0.0 (:pitch r)) "edge-turn is yaw-only")))

(deftest test-mouse-look-edge-turn-ramps-with-depth
  ;; Deeper into the band = more yaw. Inside the right band on 120 cols:
  ;; at x=115 the depth term is (band - (cols - x)) = (10 - 5) = 5, ramp
  ;; 5/10 = 0.5 -> 0.03; at x=120 (the edge cell) it is (10 - 0) = 10, ramp
  ;; 1.0 -> 0.06. Both measured with zero delta (re-report at the same
  ;; cell) so only edge-turn contributes.
  (let [shallow (mouse-look "\e[<35;115;15M" [115 15] 1.0 look-dims)
        deep    (mouse-look "\e[<35;120;15M" [120 15] 1.0 look-dims)]
    (is (approx? 0.03 (:yaw shallow)) "half-depth -> half rate")
    (is (approx? 0.06 (:yaw deep)) "full depth -> full rate")
    (is (php/> (:yaw deep) (:yaw shallow)) "deeper into the edge turns faster")))

(deftest test-mouse-look-edge-turn-rides-on-top-of-delta
  ;; Edge-turn is ADDITIVE on the (saturated) delta, not a replacement. A
  ;; flick INTO the right edge: dx=10->120 = 110 cells = 1.98 rad of delta
  ;; yaw, PLUS the +0.06 edge-turn because the endpoint sits at the edge.
  (let [r (mouse-look "\e[<35;120;10M" mouse-origin 1.0 look-dims)]
    (is (approx? (php/+ (php/* 110 0.018) 0.06) (:yaw r))
        "edge-turn adds on top of the approach delta")))

(deftest test-mouse-look-edge-turn-respects-sensitivity
  ;; Edge-turn is scaled by sensitivity like the delta look (#288 respects
  ;; the Sensitivity setting). 2x sensitivity doubles the edge-turn yaw;
  ;; 0 sensitivity kills it entirely.
  (is (approx? 0.12 (:yaw (mouse-look "\e[<35;120;15M" [120 15] 2.0 look-dims)))
      "2x sensitivity doubles edge-turn")
  (is (= 0.0 (:yaw (mouse-look "\e[<35;120;15M" [120 15] 0.0 look-dims)))
      "0 sensitivity = no edge-turn"))

(deftest test-mouse-look-central-pointer-is-pure-delta-with-dims
  ;; The CENTRAL region is untouched by edge-turn even with dims threaded
  ;; in: a hover well clear of both bands (x=10 -> 60 on 120 cols) yields
  ;; exactly the delta yaw (50 * 0.018 = 0.9) and nothing extra. Same
  ;; result as the no-dims call - the old feel is preserved.
  (let [with-dims (mouse-look "\e[<35;60;15M" [10 15] 1.0 look-dims)
        no-dims   (mouse-look "\e[<35;60;15M" [10 15] 1.0)]
    (is (approx? 0.9 (:yaw with-dims)) "centre -> pure delta yaw, no edge-turn")
    (is (= (:yaw no-dims) (:yaw with-dims)) "dims do not change central feel")))

(deftest test-mouse-look-no-dims-disables-edge-turn
  ;; Backwards-compatible: omitting dims (the old 3-arg call) means NO
  ;; edge-turn, so a pointer pinned at the edge with zero delta produces
  ;; zero yaw - exactly the pre-#288 saturation behaviour.
  (let [r (mouse-look "\e[<35;120;15M" [120 15] 1.0)]
    (is (= 0.0 (:yaw r)) "no dims -> no edge-turn (old saturating behaviour)")))

(deftest test-mouse-look-reentry-after-gap-resets-cleanly
  ;; Graceful re-entry (#288): if the pointer leaves the terminal and
  ;; comes back FAR from where it was (a Chebyshev gap beyond
  ;; mouse-reentry-gap-cells = 256), that frame RE-BASELINES rather than
  ;; reading the gap as one giant yaw jump. Here prev-pos is [10 10] and
  ;; the pointer re-appears at x=300: the 290-cell gap is treated as a
  ;; re-entry, so no yaw this frame; pos still advances so the NEXT frame
  ;; measures from the new spot.
  (let [r (mouse-look "\e[<35;300;10M" [10 10] 1.0)]
    (is (= 0.0 (:yaw r)) "re-entry gap re-baselines, no jump yaw")
    (is (= 0.0 (:pitch r)) "and no jump pitch")
    (is (= [300 10] (:pos r)) "pos advances so the next frame measures cleanly")))

(deftest test-mouse-look-fast-flick-is-not-a-reentry
  ;; The re-entry guard must NOT swallow a fast-but-continuous flick: a
  ;; 110-cell sweep (under the 256 floor) is real travel and turns
  ;; normally. Guards against a too-tight threshold killing fast looks.
  (let [r (mouse-look "\e[<35;120;10M" mouse-origin 1.0)]
    (is (approx? (php/* 110 0.018) (:yaw r)) "a wide flick is real travel, not a re-entry")))

(deftest test-mouse-look-reentry-threshold-scales-with-width
  ;; On a very wide terminal the re-entry threshold scales to 2*cols, so a
  ;; full-width flick (here ~398 cells on a 400-col terminal, above the 256
  ;; floor but below 2*400 = 800) is still read as REAL travel, not a
  ;; re-entry. Without the cols-aware scaling the static 256 floor would
  ;; misclassify it and drop the yaw.
  (let [wide [60 400]
        r    (mouse-look "\e[<35;400;10M" [2 10] 1.0 wide)]
    ;; dx = 398; the endpoint x=400 also sits at the right edge so a full
    ;; edge-turn (+0.06) rides on top of the delta. The point of the test
    ;; is that the 398-cell delta is NOT swallowed as a re-entry.
    (is (php/> (:yaw r) (php/* 398 0.018)) "a full-width flick on a wide terminal is real travel, not a re-entry")))
