(ns phel-doom.core.settings
  (:require phel-doom.core.difficulty :refer [difficulty-choices]))

;; ---------------------------------------------------------------------
;; Settings model (pure).
;;
;; The player-facing options page: bg-music volume, sfx volume, the
;; default minimap state, and the default difficulty. Volumes are
;; stored as 0..100 percentages (step 10) so the slider math is integer
;; and the persisted JSON is human-readable.
;;
;; This namespace owns the DATA: defaults, coercion of loaded values,
;; cursor movement, value adjustment, and the percent -> playback-scalar
;; mapping. It performs no IO: io/settings loads + saves the map, and
;; commands/play applies the resulting volumes to io/sound + io/music.
;; ---------------------------------------------------------------------

(def crosshair-choices
  "Crosshair reticle styles the enum field cycles through. `:off` hides
   the idle reticle entirely (the hit-marker still flashes on a hit)."
  [:cross :dot :open :off])

(def colorblind-choices
  "Colour-vision-deficiency modes the enum field cycles through (issue
   #200). `:none` keeps the default palette; the others swap the
   minimap keycard + door markers - the only glyphs distinguished by
   COLOUR alone - to a CVD-safe triad. `:deuteran` and `:protan` share
   the red-green-safe set; `:tritan` uses the blue-yellow-safe set."
  [:none :deuteran :protan :tritan])

(def pct-step
  "Percent a volume field moves per left/right press."
  10)

(def music-ceiling
  "afplay -v value the OST plays at when Music is 100%. Capped below
   1.0 so a maxed bed still never masks footsteps / shots. 60% (the
   default) maps to 0.30."
  0.5)

(def glyph-choices
  "HUD symbol sets (#471): the drawn glyphs, or ASCII stand-ins of the
   same single-column width."
  [:unicode :ascii])

(def hud-glyph-sets
  "HUD symbols per set (#471). Each ascii stand-in is a single display
   column, exactly like the glyph it replaces: a font without these
   codepoints draws tofu, and a tofu box is often DOUBLE width, which
   shifts every column after it and breaks the strip alignment."
  {:unicode {:heart "♥" :half-heart "◖" :empty-pip "·" :key "⚿" :info "ⓘ" :star "✦"}
   :ascii   {:heart "@" :half-heart "%" :empty-pip "." :key "K" :info "i" :star "*"}})

(defn hud-glyph
  "One HUD symbol for the active set. `ascii?` comes from the Glyphs
   setting, projected once per frame into stats - never read per cell."
  [ascii? key]
  (get (get hud-glyph-sets (if ascii? :ascii :unicode)) key))

(def page-fields
  "Ordered field descriptors driving both navigation and rendering.
   `:kind` selects the adjust + paint behaviour (:pct slider, :bool
   toggle, :enum cycle). An :enum field carries its own `:choices`
   vector so the cycle logic is generic (not difficulty-specific)."
  [{:key :music          :label "Music"          :kind :pct :default 60}
   {:key :sfx            :label "SFX"            :kind :pct :default 90}
   {:key :minimap        :label "Minimap"        :kind :bool :default false}
   {:key :difficulty     :label "Difficulty"     :kind :enum :choices difficulty-choices :default :normal}
   {:key :crosshair      :label "Crosshair"      :kind :enum :choices crosshair-choices :default :cross}
   {:key :timer          :label "Run timer"      :kind :bool :default false}
   {:key :mouse          :label "Mouse"          :kind :bool :default true}
   {:key :sensitivity    :label "Sensitivity"    :kind :pct :default 50}
   {:key :high-contrast  :label "High contrast"  :kind :bool :default false}
   {:key :colorblind     :label "Colorblind"     :kind :enum :choices colorblind-choices :default :none}
   ;; :fast-walls is the "Low detail" perf mode: flattens the wall AND
   ;; floor interior to one texel per cell (silhouettes stay sub-pixel).
   ;; The key keeps its original name for save-file back-compat.
   {:key :fast-walls     :label "Low detail"     :kind :bool :default false}
   ;; :subpixel on (default) uses the ▀ half-block 2-colour cells; OFF is the
   ;; one-colour-per-cell compatibility path for terminals that render ▀ with
   ;; row seams / gaps (macOS Terminal.app, #332). render ANDs it with the
   ;; PHEL_DOOM_NO_SUBPIXEL env override.
   {:key :subpixel       :label "Sub-pixel"      :kind :bool :default true}
   ;; :truecolor off (default) keeps the xterm-256 palette so saved settings +
   ;; golden fixtures stay byte-identical; ON swaps the distance-fog fade to
   ;; 24-bit \e[38;2;r;g;b cells, removing the 256-cube/grayscale snap banding
   ;; on textured walls + floor. render ANDs it with PHEL_DOOM_TRUECOLOR /
   ;; PHEL_DOOM_NO_TRUECOLOR env overrides. Needs a truecolor-capable terminal.
   {:key :truecolor      :label "Truecolor"      :kind :bool :default false}
   ;; :quad off (default) keeps the ▀ half-block; ON packs a 2×2 quadrant
   ;; glyph where the four sub-pixels differ — smoothing the wall SILHOUETTE
   ;; staircase (high-contrast wall/sky edge, the visible win) and adding
   ;; horizontal floor texel detail — collapsing back to the ▀ cell elsewhere
   ;; so flat / far surfaces stay cheap. Only with Sub-pixel on; ANDed with
   ;; PHEL_DOOM_QUAD / PHEL_DOOM_NO_QUAD env overrides. Composes with Truecolor.
   {:key :quad           :label "Quad detail"    :kind :bool :default false}
   ;; :view-bob (#411) is the walk-cycle head-bob amplitude. 0 (default) =
   ;; off, so the shipped moving look is unchanged; higher nods the whole
   ;; horizon further. Accessibility: a motion-sensitive player leaves it
   ;; at 0. render scales projection/bob-cap by view-bob-intensity of it.
   {:key :view-bob       :label "View bob"       :kind :pct :default 0}
   ;; :light off (default) keeps the uniform distance shading + byte-identical
   ;; golden frames; ON folds a per-cell room-light bias (#418) into the wall
   ;; shade index so rooms read as dark-vs-lit pools. Cheap per-column lookup;
   ;; the bias grid is derived from the map at load (core/light).
   {:key :light          :label "Room light"     :kind :bool :default false}
   ;; :glyphs picks the HUD symbol set (#471). :unicode (default) uses the
   ;; keycard, half-heart, info and bullet glyphs; :ascii swaps each for a
   ;; single-column stand-in, for a font that renders them as tofu boxes -
   ;; which also shifts every column after them and breaks the strip
   ;; alignment. io/settings picks :ascii on first run when the locale is
   ;; not UTF-8; the player can always override here.
   {:key :glyphs         :label "HUD glyphs"     :kind :enum :choices glyph-choices :default :unicode}])

(def default-settings
  "Out-of-the-box options, derived from `page-fields`' `:default`s so the
   defaults and the page cannot drift apart. Music sits under the sfx (the
   OST is a bed, not a lead). Minimap starts hidden; difficulty normal.
   Mouse on by default (FPS-style mouselook, #246), sensitivity 50% (the
   neutral 1.0x multiplier - see `mouse-sensitivity`)."
  (reduce (fn [m f] (assoc m (:key f) (:default f))) {} page-fields))

(defn field-count
  "How many rows the settings page has."
  []
  (count page-fields))

(defn field-at
  "Field descriptor at cursor index `idx`, or nil when out of range."
  [idx]
  (get page-fields idx))

(defn- clamp-pct [n]
  (php/max 0 (php/min 100 (php/intval n))))

(defn- index-of [v coll]
  (loop [i 0 cs coll]
    (cond
      (empty? cs)      -1
      (= (first cs) v) i
      :else            (recur (php/+ i 1) (rest cs)))))

(defn valid-difficulty?
  "True when `d` is one of `core/difficulty`'s `difficulty-choices`.
   Exposed so the CLI override path validates against the same list the
   settings enum cycles through."
  [d]
  (php/>= (index-of d difficulty-choices) 0))

(defn- coerce-field
  "One field's value out of a loaded map, coerced by its `:kind`: percent
   fields clamp to 0..100, bool fields force to a boolean, and an enum
   falls back to its default when the saved value is not one of its
   `:choices`. Absent keys take the descriptor's `:default`."
  [m f]
  (let [v (get m (:key f) (:default f))]
    (case (:kind f)
      :pct  (clamp-pct v)
      :bool (boolean v)
      :enum (if (php/>= (index-of v (:choices f)) 0) v (:default f))
      v)))

(defn coerce-settings
  "Normalise a loaded (or partial) settings map against the defaults:
   clamp the percent fields (volumes + mouse sensitivity) into 0..100,
   force the bool fields (minimap, run timer, mouse) to booleans, and
   fall back to a valid choice for the enums (:normal
   difficulty, :cross crosshair) when the saved value is unrecognised.
   Always returns a complete, valid map, so callers downstream never
   have to re-validate."
  [raw]
  (let [m (or raw {})]
    (reduce (fn [acc f] (assoc acc (:key f) (coerce-field m f))) {} page-fields)))

(defn resolve-subpixel
  "Effective startup `:subpixel` (#332). A terminal that draws the ▀
   half-block with row seams (macOS Terminal.app) shreds the sub-pixel
   scene, so a player who has never saved a sub-pixel choice defaults to
   OFF there. Precedence: env opt-in (`force-on?`) > saved choice
   (`saved?`) > seam-terminal default-off (`seams?`) > normal default
   (`value`). The PHEL_DOOM_NO_SUBPIXEL kill-switch lives at the render
   seam and overrides all of this. Pure: the IO layer supplies the
   terminal + env booleans."
  [value saved? seams? force-on?]
  (cond
    force-on? true
    saved?    value
    seams?    false
    :else     value))

(defn resolve-glyphs
  "Effective startup `:glyphs` (#471). A locale that is not UTF-8 means
   the terminal is very unlikely to draw the keycard, half-heart and
   info symbols - it renders tofu boxes, which are often DOUBLE width
   and so shift every column after them, breaking the HUD strip
   alignment rather than merely looking wrong.

   Precedence: a saved choice always wins (the player may know better
   than the locale), then the non-UTF-8 default to `:ascii`, then the
   normal default. Pure: the IO layer supplies the locale boolean."
  [value saved? utf8?]
  (cond
    saved?      value
    (not utf8?) :ascii
    :else       value))

(defn- wrap [i n]
  (php/% (php/+ (php/% i n) n) n))

(defn move-cursor
  "Move the page cursor by `steps` (negative = up, positive = down),
   wrapping at both ends. Any integer magnitude is allowed so a held
   key's OS-repeat burst can move more than one row in a frame."
  [idx steps]
  (wrap (php/+ idx steps) (field-count)))

;; ---------------------------------------------------------------------
;; Pause menu (issue #203): a navigable top-level menu shown when paused,
;; sitting in front of the settings page. Pure model only - the game loop
;; (commands/play) acts on the resolved action keyword.
;; ---------------------------------------------------------------------

(def pause-menu-options
  "Top-level pause-menu entries in display order. Selecting one resolves
   to an action the game loop acts on: `:resume` unpauses, `:settings`
   opens the options sub-page, `:restart` restarts the run (fresh seed),
   `:quit` exits to the shell."
  [:resume :settings :restart :quit])

(defn pause-menu-count
  "Number of pause-menu rows."
  []
  (count pause-menu-options))

(defn pause-menu-move
  "Move the pause-menu cursor by `steps` (negative up / positive down),
   wrapping at both ends like the settings page."
  [cursor steps]
  (wrap (php/+ cursor steps) (pause-menu-count)))

(defn pause-menu-action
  "Action keyword for the option under `cursor` (wrapped into range), one
   of `pause-menu-options`."
  [cursor]
  (get pause-menu-options (wrap cursor (pause-menu-count))))

(defn pause-menu-index-of
  "Cursor position of `action` in the menu, or 0 when it is not there.
   Lets a caller open the menu on a specific row (`q` lands on Quit,
   #454) without hardcoding an index that a menu reshuffle would rot."
  [action]
  (loop [i 0]
    (cond
      (php/>= i (pause-menu-count))         0
      (= action (get pause-menu-options i)) i
      :else                                 (recur (php/+ i 1)))))

(defn- field-descriptor [field-key]
  (loop [fs page-fields]
    (cond
      (empty? fs)                     nil
      (= (:key (first fs)) field-key) (first fs)
      :else                           (recur (rest fs)))))

(defn- cycle-choices [cur choices steps]
  ;; Guard a missing/empty choice list (an :enum field that forgot its
  ;; :choices): hold the current value rather than returning nil and
  ;; silently corrupting the setting.
  (if (or (nil? choices) (empty? choices))
    cur
    (let [n  (count choices)
          i  (index-of cur choices)
          i' (if (php/< i 0) 0 i)]
      (get choices (wrap (php/+ i' steps) n)))))

(defn adjust
  "Adjust `field-key` on `settings` by `steps` (negative = left,
   positive = right): volumes move `steps * pct-step` (clamped), the
   minimap toggles when `steps` is odd, difficulty cycles by `steps`.
   Any integer magnitude is allowed (a held key ramps a slider).
   Returns the new settings map; an unknown field leaves it untouched."
  [settings field-key steps]
  (let [desc (field-descriptor field-key)
        kind (:kind desc)]
    (cond
      (= kind :pct)
      (update settings field-key
              (fn [v] (clamp-pct (php/+ (php/intval v) (php/* steps pct-step)))))

      (= kind :bool)
      (if (php/=== 1 (php/abs (php/% steps 2)))
        (update settings field-key not)
        settings)

      (= kind :enum)
      (update settings field-key (fn [v] (cycle-choices v (:choices desc) steps)))

      :else          settings)))

(defn navigate
  "Apply one frame of page navigation. `cursor-steps` moves the
   selection (negative up / positive down, wrapping); `value-steps`
   adjusts the selected field (negative left / positive right). Both
   are signed integers, so a held key's repeats ramp a slider. Returns
   `{:cursor _ :settings _ :adjusted? _}` so the caller pushes the new
   volumes only when something changed. Pure: the live audio/minimap
   effects stay in the caller (commands/play)."
  [settings cursor cursor-steps value-steps]
  (let [cursor'   (if (php/=== cursor-steps 0) cursor (move-cursor cursor cursor-steps))
        adjusted? (not (php/=== value-steps 0))
        settings' (if adjusted?
                    (adjust settings (:key (field-at cursor')) value-steps)
                    settings)]
    {:cursor cursor' :settings settings' :adjusted? adjusted?}))

(defn music-volume
  "afplay -v playback value [0.0, music-ceiling] for the current Music
   percent. 0% returns 0.0 (the music layer treats that as 'stop the
   OST')."
  [settings]
  (php/* (php// (php/intval (:music settings)) 100.0) music-ceiling))

(defn sfx-scalar
  "Per-event playback scalar [0.0, 1.0] for the current SFX percent.
   io/sound multiplies each effect's volume by this."
  [settings]
  (php// (php/intval (:sfx settings)) 100.0))

(defn view-bob-intensity
  "Walk-cycle head-bob amplitude scalar [0.0, 1.0] for the current View
   bob percent (#411), consumed by `projection/bob-rows` at each render
   horizon site. 0% (default) = off. A nil `settings` (headless /
   golden-frame callers that carry no `:settings` map) reads as off, so
   those frames stay byte-identical."
  [settings]
  (php// (clamp-pct (get (or settings {}) :view-bob 0)) 100.0))

(def mouse-sensitivity-neutral
  "The Sensitivity percent that maps to the neutral 1.0x mouselook
   multiplier (the default). Picked at the slider midpoint so the player
   has equal headroom to slow the look down or speed it up."
  50)

(def mouse-sensitivity-span
  "Multiplicative span of the Sensitivity slider, from the midpoint out to
   either end (#275). The multiplier is `span^((pct - 50) / 50)`, so the
   slider is geometric (not linear) around the neutral 1.0x: each end sits
   the SAME ratio away from neutral (3x faster at 100%, 1/3x as fast at
   0%). 3 gives a clearly useful slow<->fast range - distinctly slower
   fine-tracking at the low end, distinctly faster flicks at the high end
   - replacing the old narrow 0..2x linear band where 0% killed the look
   entirely and 100% only doubled it."
  3.0)

(defn mouse-sensitivity
  "Mouselook speed multiplier (#275) for the current Sensitivity percent.
   Geometric around the slider midpoint (`mouse-sensitivity-neutral`, the
   default): `mouse-sensitivity-span ^ ((pct - 50) / 50)`. So 50% is the
   neutral 1.0x (back-compatible with saved settings), 0% slows to ~0.33x
   for fine aiming, and 100% speeds up to 3.0x for fast flicks - a wider,
   genuinely useful range than the old 0..2x linear map.
   `glue/controls.mouse-aim` multiplies the whole mouselook by this - both
   the delta turn (pointer motion -> camera yaw/pitch) and the edge-pan
   fallback - on top of the base `controls/mouse-look-gain`, so the slider
   scales how fast the camera swings for a given hand movement. The crosshair
   stays fixed dead-centre regardless."
  [settings]
  (php/pow mouse-sensitivity-span
           (php// (php/- (php/intval (:sensitivity settings)) mouse-sensitivity-neutral)
                  (php/* 1.0 mouse-sensitivity-neutral))))
