(ns phel-doom-tests.io.paint-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.io.render.buffer :refer [buf-mk])
  (:require phel-doom.io.render.paint :refer [paint-crosshair paint-door-face paint-game-info paint-compass paint-hearts-hud]))

;; ---------------------------------------------------------------------
;; Crosshair legibility. The reticle must be a SOLID glyph, never the old
;; faint `\e[..;2m` (dim) attribute that read as a translucent smudge over
;; the busy half-block floor. Idle = bold bright-white, firing = bold
;; bright-yellow (muzzle-kick flash).
;; ---------------------------------------------------------------------

(defn- crosshair-str [stats]
  (php/implode "" (paint-crosshair (buf-mk) stats 80 24 "\e[48;5;236m")))

(deftest test-crosshair-idle-is-solid-white
  (let [s (crosshair-str {:fire-anim 0.0})]
    (is (php/str_contains s "\e[97;1m+") "idle reticle is bold bright-white")
    (is (not (php/str_contains s ";2m")) "no faint/dim attribute")))

(deftest test-crosshair-firing-flashes-yellow
  (let [s (crosshair-str {:fire-anim 0.2})]
    (is (php/str_contains s "\e[93;1m+") "firing reticle is bold bright-yellow")))

;; Hit-marker (issue #201): a live :hit-fx overrides the reticle glyph -
;; a bold-red ✗ on a kill, a bold-yellow × on a wound. Expired/absent
;; hit-fx leaves the plain + reticle.

(deftest test-crosshair-kill-marker
  (let [s (crosshair-str {:fire-anim 0.0 :hit-fx {:kill? true :ttl 0.1}})]
    (is (php/str_contains s "\e[91;1m✗") "kill shows a bold-red ✗")
    (is (not (php/str_contains s "+")) "reticle replaced by the marker")))

(deftest test-crosshair-wound-marker
  (let [s (crosshair-str {:fire-anim 0.0 :hit-fx {:kill? false :ttl 0.1}})]
    (is (php/str_contains s "\e[93;1m×") "wound shows a bold-yellow ×")))

(deftest test-crosshair-expired-hit-fx-is-plain-reticle
  (let [s (crosshair-str {:fire-anim 0.0 :hit-fx {:kill? true :ttl 0.0}})]
    (is (php/str_contains s "+") "expired marker (ttl 0) falls back to +")))

;; Crosshair style setting (issue #203): :cross + / :dot · / :open ○ /
;; :off hides the idle reticle (the hit-marker still flashes on a hit).

(deftest test-crosshair-style-dot
  (let [s (crosshair-str {:fire-anim 0.0 :crosshair :dot})]
    (is (php/str_contains s "·") "dot style reticle")
    (is (not (php/str_contains s "+")) "no plus when dot is selected")))

(deftest test-crosshair-style-open
  (is (php/str_contains (crosshair-str {:fire-anim 0.0 :crosshair :open}) "○") "open ring reticle"))

(deftest test-crosshair-style-off-hides-idle
  (let [s (crosshair-str {:fire-anim 0.0 :crosshair :off})]
    (is (= "" s) "off draws no idle reticle")))

(deftest test-crosshair-style-off-still-shows-hit-marker
  ;; The marker is essential feedback, so it overrides an :off reticle.
  (let [s (crosshair-str {:fire-anim 0.0 :crosshair :off :hit-fx {:kill? true :ttl 0.1}})]
    (is (php/str_contains s "✗") "kill marker shows even with reticle off")))

;; Run-timer setting (issue #203): elapsed run time appended to the
;; row-2 game-info strip only when :run-timer? is on.

(defn- game-info-str [extra]
  ;; stamina-chip divides by :max-stamina (no fallback by design), so the
  ;; fixture supplies the always-present HUD fields.
  (let [stats (merge {:stamina 100.0 :max-stamina 100.0} extra)]
    (php/implode "" (paint-game-info (buf-mk) stats 80))))

(deftest test-run-timer-shown-when-enabled
  (is (php/str_contains (game-info-str {:run-timer? true :game-time 65}) "1:05")
      "elapsed run time appears when the timer is on"))

(deftest test-run-timer-hidden-when-disabled
  (is (not (php/str_contains (game-info-str {:run-timer? false :game-time 65}) "1:05"))
      "no timer text when the setting is off"))

;; High-contrast HUD (issue #200): un-dim the compass non-facing letters,
;; empty heart pips, and a healthy reserve count.

(defn- compass-str [hc?]
  (php/implode "" (paint-compass (buf-mk)
                                 {:player {:angle 0.0} :settings {:high-contrast hc?}}
                                 80)))

(deftest test-compass-default-dims-other-letters
  (is (php/str_contains (compass-str false) "\e[40;2;97m") "default uses dim (SGR 2) letters"))

(deftest test-compass-high-contrast-bolds-other-letters
  (let [s (compass-str true)]
    (is (not (php/str_contains s "\e[40;2;97m")) "no dim letters under high contrast")
    (is (php/str_contains s "\e[40;97;1m") "bold white non-facing letters")))

(defn- hearts-str [hc?]
  ;; 4/10 HP -> some empty pips drawn.
  (php/implode "" (paint-hearts-hud (buf-mk) 0.0
                                    {:lives 4 :max-lives 10 :armor 0 :high-contrast? hc?}
                                    false)))

(deftest test-hearts-default-grey-empties
  (is (php/str_contains (hearts-str false) "\e[40;90m") "default empty pips are grey (90)"))

(deftest test-hearts-high-contrast-white-empties
  (let [s (hearts-str true)]
    (is (not (php/str_contains s "\e[40;90m")) "no grey empties under high contrast")
    (is (php/str_contains s "\e[40;97m") "empty pips are white")))

;; game-info reserve: healthy reserve dims by default, bolds under high
;; contrast, but a critical-low reserve always flashes (cond priority).

(deftest test-reserve-dim-by-default
  (is (php/str_contains (game-info-str {:ammo-reserve 50 :mag-size 10 :high-contrast? false})
                        "\e[2m[50]")
      "healthy reserve is dim (SGR 2) by default"))

(deftest test-reserve-bold-under-high-contrast
  (let [s (game-info-str {:ammo-reserve 50 :mag-size 10 :high-contrast? true})]
    (is (not (php/str_contains s "\e[2m[50]")) "no dim reserve under high contrast")
    (is (php/str_contains s "\e[1m[50]") "healthy reserve is bold white")))

(deftest test-critical-reserve-stays-red-under-high-contrast
  (is (php/str_contains (game-info-str {:ammo-reserve 0 :mag-size 10 :high-contrast? true})
                        "\e[1;91m[0]")
      "critical reserve still flashes red with high contrast on (cond priority)"))

;; ---------------------------------------------------------------------
;; Scene-coordinate painters carry a pixel-scale `sc`: their inputs live
;; in scene cells, so emitted terminal coordinates must multiply by sc
;; (identity at full detail, x2 in pixel-doubled mode).
;; ---------------------------------------------------------------------

(defn- door-face-str [sc]
  ;; One door column (hit code 2) at col 3, wall rows 2..8.
  (let [hits (php/array 1 1 1 2)
        tops (php/array 0 0 0 2)
        bots (php/array 0 0 0 8)]
    (php/implode "" (paint-door-face (buf-mk)
                                     {:door-face-active-secs 0.5}
                                     4 24 hits tops bots sc))))

(deftest test-door-face-full-detail-coords
  ;; r = top + (bot-top)/3 = 2 + 2 = 4, col+1 = 4.
  (is (php/str_contains (door-face-str 1) "\e[4;4H")))

(deftest test-door-face-pixel-doubled-coords
  ;; Same scene cell, terminal coords doubled: row 8, col 2*3+1 = 7.
  (is (php/str_contains (door-face-str 2) "\e[8;7H")))
