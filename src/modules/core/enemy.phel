(ns phel-doom.modules.core.enemy
  (:require phel-doom.modules.core.map :refer [random-spawn wall?]))

(def default-chase-speed
  "Fallback chase speed (units/sec) used by the single-arity advance
   call so existing tests / callers that don't pass a per-level speed
   still work. The level table in play.phel overrides this per room."
  0.75)
(def stop-dist
  "Enemies stop closing in once this close, so they don't pile up
   inside the player's cell."
  0.6)
(def respawn-delay-min
  "Lower bound (seconds) on the respawn cooldown that fires when an
   enemy is killed. A dead enemy sits invisible for this long before
   reappearing — gives the player breathing room and a clear feedback
   beat per kill."
  3.0)
(def respawn-delay-max
  "Upper bound (seconds) on the respawn cooldown."
  6.0)
(def respawn-min-dist
  "Minimum spawn distance from the player a revived enemy must claim,
   so the next frame isn't an ambush."
  3.0)

(defn new-enemy
  "Create an enemy record. `x` and `y` are world-space floats; `:alive`
   flips to false when the enemy is shot."
  {:export true}
  [x y]
  {:x x :y y :alive true})

(def chase-angle-offsets
  "Angle deltas (radians) tried when an enemy can't walk straight at the
   player. Ordered straight-ahead -> 45° -> 90° -> 135° on both sides,
   so the chase first cuts corners, then slides along walls, then
   backs out of dead ends."
  (let [q (php/* 0.25 php/M_PI)
        h (php/* 0.5 php/M_PI)
        t (php/* 0.75 php/M_PI)]
    [0.0 q (php/- 0.0 q) h (php/- 0.0 h) t (php/- 0.0 t)]))

(defn- try-step
  "Attempt to step `dist` units from (ex, ey) along `angle`. Returns
   [nx ny] if the destination cell is open, nil otherwise."
  [grid ex ey dist angle]
  (let [nx (php/+ ex (php/* dist (php/cos angle)))
        ny (php/+ ey (php/* dist (php/sin angle)))]
    (if (wall? grid (php/intval nx) (php/intval ny))
      nil
      [nx ny])))

(defn- pick-step
  "Walk chase-angle-offsets in order and return the first [nx ny] whose
   destination is open. nil if the enemy is sealed in."
  [grid ex ey step desired]
  (loop [offsets chase-angle-offsets]
    (cond
      (empty? offsets) nil
      :else            (let [hit (try-step grid ex ey step (php/+ desired (first offsets)))]
                         (if hit hit (recur (rest offsets)))))))

(defn- step-toward
  "Walk one frame of `speed` * dt toward (target-x, target-y). The
   enemy slides around obstacles via pick-step's offset cascade
   instead of bumping forever."
  [enemy grid target-x target-y dt speed]
  (let [ex (:x enemy)
        ey (:y enemy)]
    (let [dx   (php/- target-x ex)
          dy   (php/- target-y ey)
          dist (php/sqrt (php/+ (php/* dx dx) (php/* dy dy)))]
      (if (php/<= dist stop-dist)
        enemy
        (let [hit (pick-step grid ex ey
                             (php/* speed dt)
                             (php/atan2 dy dx))]
          (if hit
            (assoc enemy :x (first hit) :y (second hit))
            enemy))))))

(defn shoot
  "Fire a hitscan from the player along their facing. Returns
   [new-enemies hit?]: the nearest alive enemy whose distance-to-ray is
   under `hit-radius` and whose distance-along-ray is under `max-range`
   AND closer than the wall in that direction is flipped to :alive false;
   `hit?` is true when an enemy was killed this shot."
  {:export true}
  [enemies px py angle wall-dist hit-radius max-range]
  (let [cos-a (php/cos angle)
        sin-a (php/sin angle)]
    (let [best (loop [i      0
                      best-i -1
                      best-d max-range
                      es     enemies]
                 (if (php/=== es nil)
                   best-i
                   (let [e (first es)]
                     (let [along (when (and e (:alive e))
                                   (let [dx (php/- (:x e) px)
                                         dy (php/- (:y e) py)]
                                     (let [proj (php/+ (php/* dx cos-a) (php/* dy sin-a))]
                                       (when (and (php/> proj 0.0) (php/< proj best-d)
                                                  (php/< proj wall-dist))
                                         (let [perp-x (php/- dx (php/* proj cos-a))
                                               perp-y (php/- dy (php/* proj sin-a))]
                                           (let [perp2 (php/+ (php/* perp-x perp-x) (php/* perp-y perp-y))]
                                             (when (php/<= perp2 (php/* hit-radius hit-radius))
                                               proj)))))))]
                       (if along
                         (recur (php/+ i 1) i along (next es))
                         (recur (php/+ i 1) best-i best-d (next es)))))))]
      (if (php/=== best -1)
        [enemies false nil -1]
        (let [killed       (get enemies best)
              delay        (php/+ respawn-delay-min
                                  (php/* (php// (php/mt_rand) (php/mt_getrandmax))
                                         (php/- respawn-delay-max respawn-delay-min)))
              after-killed (assoc-in (apply vector enemies) [best :alive] false)]
          [(assoc-in after-killed [best :respawn-after] delay)
           true
           {:x (:x killed) :y (:y killed)}
           best])))))

(defn- random-spawn-far-from
  "Random open cell at least min-dist from (px, py). Falls back to nil
   after a few attempts so the caller can keep the enemy dead another
   frame instead of forcing an ambush spawn."
  [grid min-dist px py]
  (loop [attempts 8]
    (if (php/<= attempts 0)
      nil
      (let [[ex ey] (random-spawn grid)
            dx      (php/- ex px)
            dy      (php/- ey py)]
        (if (php/< (php/+ (php/* dx dx) (php/* dy dy))
                   (php/* min-dist min-dist))
          (recur (php/- attempts 1))
          [ex ey])))))

(defn- tick-one
  "One frame of update for a single enemy. Alive → walk toward the
   player. Dead WITH a respawn timer → decrement; on expiry revive at
   a random open cell at least respawn-min-dist away. Dead WITHOUT a
   timer (e.g. spawned that way in a test) stays untouched."
  [e grid player-x player-y ^float dt ^float speed]
  (cond
    (:alive e)                       (step-toward e grid player-x player-y dt speed)
    (php/=== (:respawn-after e) nil) e
    :else
    (let [t (php/- (:respawn-after e) dt)]
      (if (php/> t 0.0)
        (assoc e :respawn-after t)
        (let [pos (random-spawn-far-from grid respawn-min-dist player-x player-y)]
          (if pos
            {:x (first pos) :y (second pos) :alive true}
            (assoc e :respawn-after 0.5)))))))

(defn advance
  "Per-frame update for every enemy: alive enemies chase the player at
   `speed` units/sec; dead enemies tick their respawn timer and rejoin
   the fight once it expires."
  {:export true}
  [enemies grid player-x player-y dt speed]
  (apply vector
         (map (fn [e] (tick-one e grid player-x player-y dt speed))
              enemies)))

(def scare-trigger-dist
  "World-units. When the nearest alive enemy crosses inbound under this
   threshold the render flips to a wide-eyed face for scare-duration.
   Set well outside aggro-distance (1.8) so the scare lands a beat
   BEFORE the actual attack telegraph."
  3.5)

(def silence-trigger-dist
  "World-units. Tighter than scare-trigger-dist — the moment an enemy
   crosses inbound under this, the IO layer mutes all sfx for a brief
   beat so the impending strike lands in silence."
  1.5)

(def scare-duration
  "Seconds the jump-scare face stays on after a fresh crossing. Long
   enough (>0.5s) for the player to register the change at any frame
   rate — 250ms was easy to miss in fast play."
  0.6)

(defn- min-alive-dist
  "Distance from (px, py) to the nearest alive enemy. 1.0e9 when the
   enemy list is empty / all dead — large enough to never read as
   'close' to the scare trigger."
  [enemies ^float px ^float py]
  (loop [es   enemies
         best 1.0e9]
    (cond
      (empty? es) best
      :else
      (let [e (first es)]
        (if (:alive e)
          (let [dx (php/- (:x e) px)
                dy (php/- (:y e) py)
                d  (php/sqrt (php/+ (php/* dx dx) (php/* dy dy)))]
            (recur (rest es) (php/min best d)))
          (recur (rest es) best))))))

(defn tick-scare
  "Detect inbound crossings of the nearest enemy past two thresholds:
     - scare-trigger-dist (3.5) → one-shot wide-eyed face for
       scare-duration. :prev-min-enemy-dist remembers last frame's
       nearest-enemy distance so the scare fires only on the
       transition (far → near), not while a monster sits in the band.
     - silence-trigger-dist (1.5) → :silence-tick? one-frame flag so
       the IO layer can mute sfx briefly before the imminent strike.
   :scare-secs counts down while the wide-eyed face is held."
  {:export true}
  [world ^float dt]
  (let [p              (:player world)
        cur            (min-alive-dist (:enemies world) (:x p) (:y p))
        prev           (or (:prev-min-enemy-dist world) 1.0e9)
        active         (or (:scare-secs world) 0.0)
        active'        (php/max 0.0 (php/- active dt))
        scare-cross?   (and (php/>= prev scare-trigger-dist)
                            (php/< cur scare-trigger-dist)
                            (php/<= active' 0.0))
        silence-cross? (and (php/>= prev silence-trigger-dist)
                            (php/< cur silence-trigger-dist))]
    (assoc world
           :prev-min-enemy-dist cur
           :scare-secs          (if scare-cross? scare-duration active')
           :silence-tick?       silence-cross?)))

(def rear-arc-half-width
  "Angle (radians) past facing that counts as 'behind'. 3π/4 = 135°
   from facing covers the player's back 90° wedge — the part of the
   world they literally can't see."
  (php/* 0.75 php/M_PI))

(def rear-warn-max-dist
  "World-units beyond which a rear enemy is too far to register on
   the breathing-behind-you cue."
  5.0)

(defn rear-attacker?
  "True when at least one alive enemy sits in the rear arc AND within
   rear-warn-max-dist of the player. Pure: one pass; bails on first
   match. Exported so render + tests share the same rule."
  {:export true}
  [enemies ^float px ^float py ^float pangle]
  (let [max-d2 (php/* rear-warn-max-dist rear-warn-max-dist)]
    (loop [es enemies]
      (cond
        (empty? es) false
        :else
        (let [e (first es)]
          (if (:alive e)
            (let [dx    (php/- (:x e) px)
                  dy    (php/- (:y e) py)
                  d2    (php/+ (php/* dx dx) (php/* dy dy))
                  delta (php/- (php/atan2 dy dx) pangle)
                  norm  (php/abs (php/atan2 (php/sin delta) (php/cos delta)))]
              (if (and (php/<= d2 max-d2)
                       (php/>= norm rear-arc-half-width))
                true
                (recur (rest es))))
            (recur (rest es))))))))

(defn spawn-enemies
  "Place `n` enemies on random open cells of `grid`, well away from the
   player's spawn so the first frame isn't an ambush."
  {:export true}
  [grid n min-dist-from player-x player-y]
  (loop [acc       []
         attempts  0
         remaining n]
    (cond
      (php/=== remaining 0) acc
      (php/> attempts 200)  acc
      :else
      (let [[ex ey] (random-spawn grid)
            d2      (let [dx (php/- ex player-x)
                          dy (php/- ey player-y)]
                      (php/+ (php/* dx dx) (php/* dy dy)))]
        (if (php/< d2 (php/* min-dist-from min-dist-from))
          (recur acc (php/+ attempts 1) remaining)
          (recur (conj acc (new-enemy ex ey)) (php/+ attempts 1) (php/- remaining 1)))))))
