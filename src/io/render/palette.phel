;; Render palette: ANSI colour/glyph string constants, shade lookup
;; tables, and trivial data lookups. No rendering logic.
(ns phel-doom.io.render.palette
  (:require phel-doom.io.render.buffer :refer [buf-mk buf-set]))

(def sky        "\e[48;5;236m ")
(def floor      "\e[48;5;239m ")

(def enemy-head "\e[48;5;196m ")
(def enemy-body "\e[48;5;52m ")

;; All minimap + HUD cells carry an explicit dark BG (`\e[40m`). Without
;; it, the underlying terminal default BG (which can be light/transparent
;; on some iTerm2 themes) shows through and washes the overlay out.
(def enemy-marker "\e[40;91;1mE\e[0m")
(def heart-marker "\e[40;91;1m♥\e[0m")
(def ammo-marker     "\e[40;93;1mA\e[0m")
(def berserk-marker  "\e[40;91;1mB\e[0m")
(def invuln-marker   "\e[40;96;1mI\e[0m")

(def soulsphere-marker
  "Soulsphere minimap glyph (issue #68): bright cyan circle on
   black. Distinct from `I` (invuln) and `B` (berserk) on the same
   palette family so the player can tell which powerup is which at
   a glance."
  "\e[40;96;1m●\e[0m")

(def armor-shard-marker
  "Armor-shard minimap glyph (issue #68): green caret. Shape +
   colour both distinct from the heart `♥` and ammo `A` so the
   common shard pickup reads as its own kind on a busy minimap."
  "\e[40;92;1m▲\e[0m")

(def backpack-marker "\e[40;33;1mP\e[0m")
(def keycard-blue-marker "\e[40;94;1mk\e[0m")
(def keycard-red-marker  "\e[40;91;1mk\e[0m")
(def keycard-yellow-marker "\e[40;93;1mk\e[0m")
(def door-blue-marker    "\e[40;94;1m▌\e[0m")
(def door-red-marker     "\e[40;91;1m▌\e[0m")
(def door-yellow-marker  "\e[40;93;1m▌\e[0m")
(def shotgun-pickup-marker  "\e[40;33;1mS\e[0m")
(def chaingun-pickup-marker "\e[40;32;1mC\e[0m")

(def boss-door-marker
  "Minimap glyph for the L10 boss-locked door — vivid red so the
   exit reads as 'danger / locked' against the dim minimap floor."
  "\e[40;91;1m▌\e[0m")

;; Colorblind-safe minimap palettes (issue #200). The keycard (`k`) and
;; door (`▌`) markers are the ONLY minimap glyphs distinguished by COLOUR
;; alone - blue/red/yellow share one glyph each - so a colour-vision-
;; deficient player can confuse which key opens which door. Every other
;; marker already carries a distinct glyph (E/♥/A/B/I/●/▲/P/S/C), so the
;; shape-not-colour rule (CHANGELOG 0.3.0) already covers them.
;; 256-colour code per logical keycard/door colour, per CVD mode. Each
;; triad separates the three colours by BRIGHTNESS (preserved under every
;; CVD type) AND hue. :deuteran + :protan share the red-green-safe set
;; (sky-blue / orange / white); :tritan uses the blue-yellow-safe set
;; (blue / red / white). The SAME code is applied to a key and its
;; matching door so "match key colour to door colour" still works.
;; NOTE: def- (not def) so NO string docstring — def- stores a leading
;; string AS the value, which would corrupt the map.
(def- cb-triad
  {:deuteran {:blue "39" :red "208" :yellow "231"}
   :protan   {:blue "39" :red "208" :yellow "231"}
   :tritan   {:blue "33" :red "196" :yellow "231"}})

(defn colorblind-markers
  "Keycard + door minimap markers remapped to the CVD-safe triad for
   `mode` (issue #200), or nil for `:none` / unknown (the caller then
   keeps the default colour markers). Pure; selected once per frame in
   `minimap-rows`, so it adds no hot-3D-path cost."
  [mode]
  (let [t (get cb-triad mode)]
    (when t
      (let [mk (fn [code glyph] (str "\e[40;38;5;" code ";1m" glyph "\e[0m"))]
        {:keycard-blue   (mk (:blue t) "k")
         :keycard-red    (mk (:red t) "k")
         :keycard-yellow (mk (:yellow t) "k")
         :door-blue      (mk (:blue t) "▌")
         :door-red       (mk (:red t) "▌")
         :door-yellow    (mk (:yellow t) "▌")}))))

(def floor-theme-codes
  "Per-theme floor gradient base code: the bright screen-edge shade that
   `build-themed-gradient` fades to black at the horizon. `:base` is the
   original neutral grey (239); each other key tints one
   episode's ground so a level reads as a distinct place. The gradient
   LUT is rebaked only when the base changes (on level load), so per-level
   themes cost nothing on the hot path (#417)."
  {:base  239   ; neutral grey (unchanged default)
   :steel 66    ; desaturated blue-grey - early tech/base levels
   :moss  65    ; muted green - overgrown caverns
   :clay  95    ; warm brown-mauve - earthen halls
   :rust  131   ; muted red-brown - corroded late levels
   :hell  124}) ; deep red - the final descent

(defn theme-floor-code
  "Resolve a level's `:theme` keyword to its floor gradient base code,
   falling back to the neutral `:base` grey for nil / unknown themes so an
   un-themed level renders exactly as before."
  [theme]
  (or (get floor-theme-codes theme) (get floor-theme-codes :base)))
(def kill-flash    "\e[48;5;231;38;5;226;1m✦")
(def death-slump   "\e[48;5;124;38;5;232;1m▼")
(def death-collapse "\e[48;5;88;38;5;52m▒")
(def blood-mid     "\e[48;5;88m ")
(def blood-dim     "\e[48;5;52m ")

(def sprite-shadow
  "Darkest-grey BG painted into the row immediately under an enemy's
   feet so the sprite reads as grounded instead of floating in mid-air."
  "\e[48;5;232m ")

;; Pickup sprites paint a coloured BG rectangle over the projected
;; column range, then overlay a single ICON glyph at the centre cell
;; so the pickup reads as a proper symbol up close and a coloured
;; glow from across the room. BG + glyph cycle on a sin wave.

