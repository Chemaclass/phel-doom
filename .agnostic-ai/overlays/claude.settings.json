{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "includeCoAuthoredBy": false,
    "permissions": {
        "allow": [
            "Bash(composer *)",
            "Bash(vendor/bin/phel *)",
            "Bash(vendor/bin/*)",
            "Bash(make *)",
            "Bash(git *)",
            "Bash(gh *)",
            "Bash(timeout *)",
            "Bash(ls *)",
            "Bash(wc *)",
            "Bash(rm -rf out)",
            "Bash(rm -rf out/*)",
            "Bash(rm -rf .phel/cache)",
            "Bash(rm -rf .phel/cache/*)"
        ],
        "deny": [
            "Bash(rm -rf /:*)",
            "Bash(rm -rf ~*)",
            "Bash(rm -rf $HOME*)",
            "Bash(rm -rf ..*)",
            "Bash(rm -fr /:*)",
            "Bash(sudo:*)",
            "Bash(shutdown:*)",
            "Bash(reboot:*)",
            "Bash(mkfs:*)"
        ]
    },
    "hooks": null
}
