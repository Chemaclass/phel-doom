(ns phel-doom.io.render.sprites
  (:require phel-doom.io.render.buffer :refer [buf-mk buf-set buf-get])
  (:require phel-doom.io.render.palette :refer [kill-flash death-slump death-collapse blood-mid blood-dim fireball-shade fireball-glyph])
  (:require phel-doom.io.render.frame-math :refer [sprite-h-pd project-enemy-pd])
  (:require phel-doom.io.render.enemy-sprites-data :refer [projectile-sprites death-sprites blood-sprites pickup-sprites])
  (:require phel-doom.io.render.enemy-sprite :refer [sprite-col-x sprite-subcol-x enemy-sprite-cell sprite-fade sprite-fade-index])
  (:require phel-doom.core.engine :refer [proj-dist max-depth])
  (:require phel-doom.core.projection :refer [pitch-rows])
  (:require phel-doom.core.combat :refer [fx-ttl-seconds corpse-ttl-seconds]))

;; Sprite / billboard / blood-FX painters, extracted from io/render/paint.phel
;; (#351): item + projectile + tracer billboards, the Freedoom death/blood
;; frames, and the per-column visibility gate. paint.phel keeps the HUD /
;; overlay painters and calls back into sprites-enabled? for its weapon HUD.

(def sprites-on?
  "Memoised PHEL_DOOM_NO_SPRITES probe. The env can't change mid-run, so
   resolve it once instead of calling getenv every frame. nil = not yet
   probed."
  (atom nil))

(defn sprites-enabled?
  "All Freedoom bitmaps are on by default: the weapon HUD, pickup /
   projectile billboards, blood + death frames, and enemy billboards.
   PHEL_DOOM_NO_SPRITES=1 forces the hand-built ASCII silhouettes and
   glyph enemies - one flag, for an A/B compare or as a fallback."
  []
  (let [cached @sprites-on?]
    (if (nil? cached)
      (let [on (not (php/=== "1" (php/getenv "PHEL_DOOM_NO_SPRITES")))]
        (reset! sprites-on? on)
        on)
      cached)))

(defn- pickup-visible-at?
  "True when something at depth `d` would be visible at screen column
   `c` — i.e. no closer wall (dists) and no closer enemy (edists)
   blocks the line of sight."
  [^float d c dists edists]
  (let [wd (buf-get dists c)
        ed (buf-get edists c)]
    (and (php/< d wd)
         (or (php/=== ed nil) (php/< d ed)))))

(defn- blit-sprite-into
  "Blit a baked sprite (`{:w :h :px}`) centred at column `col` into the
   `buf` overlay (top-priority cell strings) over the vertical screen
   span [`etop`, `etop`+`h`). Width follows the sprite's native aspect;
   the wall/enemy occlusion check (depth `d`) hides a splat / corpse
   behind a closer thing. Transparent pixels are not written (the base
   cell shows). Returns the mutated buffer."
  [buf sprite ^int col ^float d ^int etop ^int h ^int vw ^int vh dists edists]
  (let [sw     (:w sprite)
        sh     (:h sprite)
        px     (:px sprite)
        ehw    (php/max 1 (php/intval (php/round (php// (php/* h sw) sh))))
        ebot   (php/+ etop h)
        r-lo   (php/max 0 etop)
        r-hi   (php/min vh ebot)
        c-from (php/max 0 (php/- col ehw))
        c-to   (php/min (php/- vw 1) (php/+ col ehw))
        ;; Half-strength fog matching the live-enemy sprite path (see
        ;; sprite-fade-index): blit targets (corpses, splats, pickups)
        ;; darken ~15-30% at far range rather than the full 65% the wall
        ;; fog applies. Close blits land on the identity level (23).
        df     (php/min 0.65 (php/* (php// d max-depth) (php// d max-depth)))
        fade   (php/aget sprite-fade (sprite-fade-index df))]
    (loop [c c-from]
      (when (php/<= c c-to)
        (when (pickup-visible-at? d c dists edists)
          (let [sx  (sprite-col-x sw col ehw c)
                sxr (sprite-subcol-x sw col ehw c)]
            (loop [r r-lo]
              (when (php/< r r-hi)
                (let [cell (enemy-sprite-cell px sw sh sx sxr etop ebot r fade)]
                  (when cell (buf-set buf (php/+ (php/* r vw) c) cell)))
                (recur (php/+ r 1))))))
        (recur (php/+ c 1))))
    buf))

(defn- blit-billboard-scaled
  "blit-sprite-into at `scale` x the projected enemy height, kept centred
   (corpses render a bit smaller than a live enemy). `pr` is the pitch
   row offset so the billboard tracks the sheared horizon."
  [buf sprite ^int col ^float d ^float scale ^int vw ^int vh ^float pd dists edists ^int pr]
  (let [h (php/max 2 (php/intval (php/* (sprite-h-pd pd vh d 1.0) scale)))]
    (blit-sprite-into buf sprite col d (php/+ (php/intdiv (php/- vh h) 2) pr) h vw vh dists edists)))

(defn- blit-glow-into
  "Coloured glow square + centre glyph for a far / no-sprite billboard
   (pickup or fireball): the shared body of the two legacy NO_SPRITES
   paths. `pr` is the pitch offset. Mutates + returns `bp` via
   statement-position buf-set (caller must rebind, per the closure-array-
   copy note)."
  [bp proj ^float pd ^float d ^int col ^int pr shade glyph ^int vw ^int vh dists edists]
  (let [hw     (php/max 1 (php/intdiv (:half-width proj) 2))
        c-from (php/max 0 (php/- col hw))
        c-to   (php/min (php/- vw 1) (php/+ col hw))
        h      (sprite-h-pd pd vh d 1.0)
        mid    (php/+ (php/intdiv (php/- vh h) 2) pr (php/intdiv h 2))
        r-top  (php/max 0 (php/- mid (php/intdiv h 6)))
        r-bot  (php/min vh (php/+ mid (php/intdiv h 6) 1))]
    (loop [c c-from]
      (when (php/<= c c-to)
        (when (pickup-visible-at? d c dists edists)
          (loop [r r-top]
            (when (php/< r r-bot)
              (buf-set bp (php/+ (php/* r vw) c) shade)
              (recur (php/+ r 1)))))
        (recur (php/+ c 1))))
    (when (and (php/>= col 0) (php/< col vw)
               (php/>= mid 0) (php/< mid vh)
               (pickup-visible-at? d col dists edists))
      (buf-set bp (php/+ (php/* mid vw) col) glyph))
    bp))

(defn- death-frame
  "Pick the death-animation frame for enemy `type-kw` at remaining
   life-fraction `ttl-frac` (1.0 just-killed -> 0.0 gone). Frames run
   collapse..corpse; the collapse frames play over the first part of the
   fade, then the corpse holds. nil when the type has no baked death seq
   (caller keeps the blood shading). pinky + spectre reuse :demon."
  [type-kw ^float ttl-frac]
  (let [k   (cond (php/=== type-kw :pinky)   :demon
                  (php/=== type-kw :spectre) :demon
                  :else                      type-kw)
        seq (get death-sprites k)]
    (when seq
      (let [n   (php/count seq)
            idx (php/min (php/- n 1)
                         (php/intval (php/* (php/- 1.0 ttl-frac) (php/* n 2.5))))]
        (php/aget seq (php/max 0 idx))))))

(defn- blood-frame
  "Pick a Freedoom blood-spurt frame (big -> small) for a wound hit at
   remaining life-fraction `ttl-frac` (1.0 fresh -> 0.0 gone)."
  [^float ttl-frac]
  (let [n (php/count blood-sprites)]
    (when (php/> n 0)
      (php/aget blood-sprites
                (php/max 0 (php/min (php/- n 1)
                                    (php/intval (php/* (php/- 1.0 ttl-frac) n))))))))

(defn- blit-blood-splat
  "Blit a small blood-spurt `splat` at the enemy's torso (a third of the
   projected height, upper-mid). Returns the buffer."
  [buf splat ^int col ^float d ^int vw ^int vh ^float pd dists no-enemies ^int pr]
  (let [eh   (sprite-h-pd pd vh d 1.0)
        bh   (php/max 2 (php/intdiv eh 3))
        mid  (php/+ (php/intdiv (php/- vh eh) 2) pr (php/intdiv eh 3))
        etop (php/- mid (php/intdiv bh 2))]
    (blit-sprite-into buf splat col d etop bh vw vh dists no-enemies)))

(defn paint-blood-fx-into
  "Draw every blood/death fx in `stats` into `blood-paint`. A kill fx
   carries the dead enemy's `:type`: in sprite mode it blits a Freedoom
   collapse->corpse plus a fresh blood spurt (so even a one-shot kill
   spurts blood). A wound fx (no type) blits the small blood spurt. Under
   NO_SPRITES both fall back to the ttl-tiered red shade. Wall-occluded
   cells skip. Returns the mutated buffer (rebind it — PHP arrays pass by
   value, and the sprite blits go through helpers)."
  [blood-paint stats world dists vw vh ^float pd]
  (let [no-enemies (buf-mk)              ; sprites occlude on walls only
        on?        (sprites-enabled?)
        pr         (pitch-rows (or (:pitch (:player world)) 0.0) vh)]
    (reduce
     (fn [bp fx]
       (let [proj (project-enemy-pd pd fx (:player world) vw)]
         (if (nil? proj)
           bp
           (let [col    (:col proj)
                 d      (:dist proj)
                 ttl    (or (:ttl fx) 0.0)
                 type-k (:type fx)
                 corpse (when (and on? type-k)
                          (death-frame type-k (php// ttl corpse-ttl-seconds)))
                 wsplat (when (and on? (not type-k))
                          (blood-frame (php// ttl fx-ttl-seconds)))]
             (cond
               ;; Kill: collapse->corpse, plus a fresh spurt for the first
               ;; ~0.45s so even a one-life one-shot kill bleeds.
               corpse
               (let [bp1     (blit-billboard-scaled bp corpse col d 0.5 vw vh pd dists no-enemies pr)
                     elapsed (php/- corpse-ttl-seconds ttl)
                     ksplat  (when (php/< elapsed 0.45)
                               (blood-frame (php/max 0.0 (php/- 1.0 (php// elapsed 0.45)))))]
                 (if ksplat
                   (blit-blood-splat bp1 ksplat col d vw vh pd dists no-enemies pr)
                   bp1))
               ;; Wound: small Freedoom blood spurt at the torso.
               wsplat
               (blit-blood-splat bp wsplat col d vw vh pd dists no-enemies pr)
               ;; NO_SPRITES: ttl-tiered red shade block.
               :else
               (let [hw     (:half-width proj)
                     bsh    (cond (php/> ttl 0.65) kill-flash
                                  (php/> ttl 0.5)  death-slump
                                  (php/> ttl 0.35) death-collapse
                                  (php/> ttl 0.15) blood-mid
                                  :else            blood-dim)
                     c-from (php/max 0 (php/- col hw))
                     c-to   (php/min (php/- vw 1) (php/+ col hw))
                     h      (sprite-h-pd pd vh d 1.0)
                     r-top  (php/max 0 (php/+ (php/intdiv (php/- vh h) 2) pr (php/intdiv (php/* h 2) 3)))
                     r-bot  (php/min vh (php/+ (php/intdiv (php/- vh h) 2) pr h))]
                 (loop [c c-from]
                   (when (php/<= c c-to)
                     (when (php/< d (buf-get dists c))
                       (loop [r r-top]
                         (when (php/< r r-bot)
                           (buf-set bp (php/+ (php/* r vw) c) bsh)
                           (recur (php/+ r 1)))))
                     (recur (php/+ c 1))))
                 bp))))))
     blood-paint
     (or (get stats :fx) []))))

(defn paint-pickups-into
  "Project each pickup to screen. In sprite mode (and when a baked
   `sprite` is supplied) it blits the Freedoom item sprite small,
   floating; otherwise it falls back to the coloured BG glow + centre
   icon glyph. Per-column visibility honours both walls AND enemies.

   Returns the mutated buffer — PHP arrays pass by value, and the sprite
   path goes through a helper, so the caller must rebind the result."
  [blood-paint pickups player dists edists vw vh ^float pd shade-now glyph-now sprite-key]
  (let [use-spr (and (sprites-enabled?) (get pickup-sprites sprite-key))
        pr      (pitch-rows (or (:pitch player) 0.0) vh)]
    (reduce
     (fn [bp item]
       (let [proj (project-enemy-pd pd item player vw)]
         (if (nil? proj)
           bp
           (let [col  (:col proj)
                 d    (:dist proj)
                 ;; LOD: use the Freedoom item sprite whenever it would
                 ;; render at >= 2 rows. A higher floor falls back to
                 ;; quads at typical gameplay distances (d>1.8).
                 ;; ph = min(16, 55% of projected height) gives a compact
                 ;; billboard that sits low in the world; both bounds scale
                 ;; by pd/proj-dist so pixel-doubled scenes match on-screen.
                 lodr (php// pd proj-dist)
                 ph   (php/min (php/max 2 (php/intval (php/* 16 lodr)))
                               (php/intval (php/* (sprite-h-pd pd vh d 1.0) 0.55)))]
             (if (and use-spr (php/>= ph (php/max 2 (php/intval (php/* 2 lodr)))))
               ;; Sprite: Freedoom item billboard.
               (let [etop (php/+ (php/intdiv (php/- vh ph) 2) pr)]
                 (blit-sprite-into bp use-spr col d etop ph vw vh dists edists))
               ;; Far / no-sprite: clean coloured glow + centre icon glyph.
               (blit-glow-into bp proj pd d col pr shade-now glyph-now vw vh dists edists))))))
     blood-paint
     (or pickups []))))

(defn paint-projectiles-into
  "Project each enemy fireball to screen and write its orange glow plus
   a white-hot core glyph into `blood-paint`. Same projection +
   visibility pipeline as pickups: `pickup-visible-at?` occludes the
   bolt behind both walls (`dists`) AND nearer enemies (`edists`), so a
   bolt flying past a closer monster is hidden by it instead of bleeding
   through. The firing caster never hides its own bolt — the bolt
   spawns ahead of the caster and only moves closer, so its depth stays
   under the caster's at every column. The glow is a tight square (half
   the projected half-width, a few rows tall) so a bolt stays a compact
   dot rather than a wall-sized blob up close.

   Returns the mutated buffer — PHP arrays pass by value, so the caller
   must rebind to see the writes."
  [blood-paint projectiles player dists edists vw vh ^float pd]
  (let [fireball (and (sprites-enabled?) (get projectile-sprites :fireball))
        pr       (pitch-rows (or (:pitch player) 0.0) vh)]
    (reduce
     (fn [bp bolt]
       (let [proj (project-enemy-pd pd bolt player vw)]
         (if (nil? proj)
           bp
           (let [col (:col proj)
                 d   (:dist proj)]
             (if fireball
               ;; Freedoom fireball billboard at half the projected enemy
               ;; height so the bolt reads as a compact ball in flight.
               (let [fh   (php/max 2 (php/intdiv (sprite-h-pd pd vh d 1.0) 2))
                     etop (php/+ (php/intdiv (php/- vh fh) 2) pr)]
                 (blit-sprite-into bp fireball col d etop fh vw vh dists edists))
               ;; Legacy orange glow + white-hot core (NO_SPRITES).
               (blit-glow-into bp proj pd d col pr fireball-shade fireball-glyph vw vh dists edists))))))
     blood-paint
     (or projectiles []))))

(defn paint-tracers-into
  "Render the cosmetic shot tracers (BFG ball / rocket): each flies from
   its spawn toward the impact by `:t`/`:dur`, projected and blitted as a
   Freedoom projectile sprite that recedes (shrinks) as it travels.
   Wall-occluded. Returns the mutated buffer (rebind it)."
  [blood-paint tracers player dists edists vw vh ^float pd]
  (if (not (sprites-enabled?))
    blood-paint
    (reduce
     (fn [bp tr]
       (let [frac (php// (:t tr) (php/max 0.001 (:dur tr)))
             cx   (php/+ (:x tr) (php/* (php/- (:tx tr) (:x tr)) frac))
             cy   (php/+ (:y tr) (php/* (php/- (:ty tr) (:y tr)) frac))
             proj (project-enemy-pd pd {:x cx :y cy} player vw)
             spr  (get projectile-sprites (:kind tr))
             pr   (pitch-rows (or (:pitch player) 0.0) vh)]
         (if (and proj spr)
           (blit-billboard-scaled bp spr (:col proj) (:dist proj) 0.7 vw vh pd dists edists pr)
           bp)))
     blood-paint
     (or tracers []))))

(defn build-blood-cols
  "Directional blood mask: per-column intensity in [0, 1]. Non-zero
   only when iframes active AND the hit came from `:left` or `:right`.
   Fades from 1.0 at the screen edge that took the hit toward 0 at the
   centre. `attacker-side` also yields `:front` / `:back`, which have no
   screen edge to drip down (the hit vignette shows those bearings), so
   they mask to 0. Exported so tests can pin the falloff behaviour."
  [vw bloody? hurt-side]
  (let [m  (buf-mk)
        w  (php/max 1 (php/min 20 (php/intdiv vw 3)))
        sd (and bloody? hurt-side)]
    (loop [c 0]
      (when (php/< c vw)
        (buf-set m c
                 (cond
                   (not sd)            0.0
                   (php/=== sd :left)  (php/max 0.0 (php/- 1.0 (php// (php/* 1.0 c) w)))
                   (php/=== sd :right) (php/max 0.0
                                                (php/- 1.0
                                                       (php// (php/* 1.0 (php/- (php/- vw 1) c)) w)))
                   :else               0.0))
        (recur (php/+ c 1))))
    m))
