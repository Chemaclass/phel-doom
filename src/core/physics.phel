(ns phel-doom.core.physics
  (:require phel-doom.core.rng :as rng)
  (:require phel-doom.core.state   :refer [max-stamina move-player turn-player clamp-pitch])
  (:require phel-doom.core.map     :refer [missing-key-for passable?])
  (:require phel-doom.core.weapons :refer [weapon-spec]))

(def locked-bump-secs
  "How long the 'NEED <COLOUR> KEY' HUD hint stays on after the player
   bounces off a locked door. ~1.5s is long enough to read without
   blocking the screen when the player keeps colliding."
  1.5)

;; ---------------------------------------------------------------------
;; Player physics: rotation + translation + counter decay.
;;
;; The world holds nine direction counters (:moves), each a seconds-
;; remaining hold time (not a frame count). Physics consumes whatever is
;; non-zero (scaled by dt) and decays each counter by dt seconds, so the
;; hold survives the same wall-clock duration at any frame rate. Controls
;; refresh the counters when keys arrive; this module just reads them.
;; ---------------------------------------------------------------------

(def move-speed
  "World units per second when the player holds forward or back."
  4.5)

(def strafe-speed
  "Sideways units per second. Still slower than forward `move-speed`
   (4.5) so A/D read as a tactical sidestep, not a teleport - but quick
   enough to clear a caster bolt's path during its wind-up, so dodging
   reads as a skill instead of a photo-finish."
  3.0)

(def turn-speed
  "Radians per second of sustained rotation."
  2.0)

(def pitch-speed
  "Look up/down fraction per second of sustained pitch. `:pitch` lives
   in [-1, 1] (clamp-pitch), so at 1.2/s a held look-up key travels from
   level to full-up in just under a second - brisk enough to feel
   responsive without overshooting the clamp on a single key blip."
  1.2)

(def bob-phase-per-unit
  "Radians of head-bob walk-cycle phase advanced per world-unit of ground
   covered (#411). Feel knob, sibling of `move-hold-secs`: distance-
   driven so a faster stride nods faster. `M_PI`/unit is one full up-down
   nod every two cells. Amplitude is a separate, render-side setting
   (`projection/bob-rows`); physics only tracks the phase."
  php/M_PI)

(def sprint-multiplier
  "Speed multiplier applied to longitudinal + lateral motion while the
   sprint slot is on AND stamina is available. Turn-speed is NOT
   scaled — sprint is a translation modifier, not a rotation one."
  1.6)

(def stamina-drain
  "Stamina units burned per second while sprinting AND moving. At
   max-stamina (100) this gives ~3.3s of sustained sprint before the
   pool empties."
  30.0)

(def stamina-regen
  "Stamina units recovered per second while NOT sprinting and once
   the post-sprint cooldown has elapsed. Slower than drain so the
   chase-then-recover loop has a real tactical cost."
  20.0)

(def sprint-cooldown-after
  "Seconds the regen is held back after a sprint stops. Prevents
   tap-shift-tap-shift abuse — the player needs a brief beat off
   the trigger before the pool starts refilling."
  0.5)

(def sprint-engage-threshold
  "Stamina value (out of max-stamina) the player must recover to
   before sprint can re-engage after a full depletion. Below this
   :sprint-blocked? stays latched even though stamina > 0, so the
   player can't stutter-sprint at empty."
  20.0)

(defn try-move
  "Translate the player by (dx, dy) unless the destination cell holds a
   wall or a locked door without the matching keycard.
   When a bump is caused specifically by a missing keycard, arm
   :locked-door-bump-secs + record the colour so the render layer can
   paint 'NEED <COLOUR> KEY' over the 3D view, and enqueue a muted `:click`
   deny cue on the :sfx queue. Wall bumps are silent - only the
   locked-door case is informational."
  [world ^float dx ^float dy]
  (let [{:keys [grid player held-keys]} world
        nx                              (+ (:x player) dx)
        ny                              (+ (:y player) dy)
        ix                              (php/intval nx)
        iy                              (php/intval ny)]
    (cond
      (passable? grid held-keys ix iy)
      (move-player world dx dy)

      :else
      (let [need (missing-key-for grid held-keys ix iy)]
        (if (php/=== need nil)
          world
          ;; Rising-edge deny click: enqueue the muted `:click` only when
          ;; the bump timer was not already armed, so holding into the door
          ;; re-clicks at the ~1.5s hint cadence instead of every frame.
          ;; Inlined (not push-sfx) to avoid a core/combat <-> physics
          ;; require cycle - combat already requires physics/try-move.
          (let [armed? (php/> (or (:locked-door-bump-secs world) 0.0) 0.0)
                w      (assoc world
                              :locked-door-bump-secs   locked-bump-secs
                              :locked-door-bump-colour need)]
            (if armed?
              w
              (update w :sfx (fn [s] (conj (or s []) {:name :click :vol 0.5}))))))))))

(defn- ^:pure counter-on? [moves slot]
  (php/> (get moves slot) 0))

(defn- ^:pure contribution
  [moves slot ^float speed ^float dt]
  (if (counter-on? moves slot) (php/* speed dt) 0.0))

(defn- ^:pure sprinting?
  "True when the player is actively burning sprint this frame: sprint
   intent armed AND stamina pool not empty AND not latched-blocked."
  [world]
  (let [moves (:moves world)]
    (and (counter-on? moves :sprint)
         (php/> (or (:stamina world) 0.0) 0.0)
         (not (:sprint-blocked? world)))))

(defn- ^:pure sprint-factor
  "Speed multiplier to apply this frame — sprint-multiplier when the
   sprint gate is open, 1.0 otherwise."
  [world]
  (if (sprinting? world) sprint-multiplier 1.0))

(defn- ^:pure weapon-movement-factor
  "Per-weapon movement multiplier applied while the weapon is ticking
   (`:fire-cooldown > 0`). Used by the chainsaw to lock the player at
   half speed during melee swings - DOOM-style commitment. Falls
   through to 1.0 for weapons that don't declare `:movement-mul` or
   that aren't currently in their fire-cooldown window."
  [world]
  (let [sp  (weapon-spec world)
        mul (:movement-mul sp)
        cd  (or (:fire-cooldown world) 0.0)]
    (if (and mul (php/> cd 0.0)) mul 1.0)))

(defn- ^:pure turn-delta [moves ^float dt]
  (php/- (contribution moves :turn-right turn-speed dt)
         (contribution moves :turn-left  turn-speed dt)))

(defn- ^:pure pitch-delta [moves ^float dt]
  ;; Look UP adds to `:pitch` (horizon shears down); look down subtracts.
  ;; Same `contribution` helper the yaw path uses, just on the pitch slots.
  (php/- (contribution moves :pitch-up   pitch-speed dt)
         (contribution moves :pitch-down pitch-speed dt)))

(defn- ^:pure longitudinal-delta [world ^float dt]
  (let [moves (:moves world)
        sf    (sprint-factor world)
        wf    (weapon-movement-factor world)]
    (php/* sf wf
           (php/- (contribution moves :fwd  move-speed dt)
                  (contribution moves :back move-speed dt)))))

(defn- ^:pure lateral-delta [world ^float dt]
  (let [moves (:moves world)
        sf    (sprint-factor world)
        wf    (weapon-movement-factor world)]
    (php/* sf wf
           (php/- (contribution moves :strafe-right strafe-speed dt)
                  (contribution moves :strafe-left  strafe-speed dt)))))

(defn- ^:pure apply-rotation [world ^float turn-by]
  (if (php/=== turn-by 0.0)
    world
    (turn-player world turn-by)))

(defn- ^:pure apply-pitch [world ^float pitch-by]
  (if (php/=== pitch-by 0.0)
    world
    (update-in world [:player :pitch]
               (fn [p] (clamp-pitch (php/+ (or p 0.0) pitch-by))))))

(defn- ^:pure apply-translation [world ^float long-d ^float lat-d]
  (if (and (php/=== long-d 0.0) (php/=== lat-d 0.0))
    world
    (let [^float a (:angle (:player world))]
      ;; Post phel-lang#2181: native `+` `-` `*` emit raw PHP arith when
      ;; one operand is a typed local (`long-d` / `lat-d` / `a`) and the
      ;; other is `(php/cos x)` / `(php/sin x)` (return-typed by the
      ;; compiler's PHP-native return-type table). Same PHP as the
      ;; previous `php/*` / `php/-` form, no perf delta, plain Phel
      ;; reads.
      (try-move world
                (- (* long-d (php/cos a)) (* lat-d (php/sin a)))
                (+ (* long-d (php/sin a)) (* lat-d (php/cos a)))))))

(defn- decay-counter [n ^float dt]
  (php/max 0.0 (php/- n dt)))

(defn- ^:pure decay-move-counters [world ^float dt]
  (let [m (:moves world)]
    (assoc world :moves
           {:fwd          (decay-counter (:fwd m) dt)
            :back         (decay-counter (:back m) dt)
            :strafe-left  (decay-counter (:strafe-left m) dt)
            :strafe-right (decay-counter (:strafe-right m) dt)
            :turn-left    (decay-counter (:turn-left m) dt)
            :turn-right   (decay-counter (:turn-right m) dt)
            :sprint       (decay-counter (or (:sprint m) 0.0) dt)
            :pitch-up     (decay-counter (or (:pitch-up m) 0.0) dt)
            :pitch-down   (decay-counter (or (:pitch-down m) 0.0) dt)})))

(defn- ^:pure any-movement-on? [world]
  (let [m (:moves world)]
    (or (counter-on? m :fwd)
        (counter-on? m :back)
        (counter-on? m :strafe-left)
        (counter-on? m :strafe-right))))

(defn- ^:pure moved-dist
  "Euclidean ground distance the player covered between two worlds. Reads
   ACTUAL position, so a wall-blocked frame reports 0 even though a move
   was requested."
  [before after]
  (let [pb (:player before)
        pa (:player after)
        dx (php/- (:x pa) (:x pb))
        dy (php/- (:y pa) (:y pb))]
    (php/sqrt (php/+ (php/* dx dx) (php/* dy dy)))))

(defn- ^:pure advance-bob-phase
  "Advance `:bob-phase` by the ground `dist` covered this frame, wrapped
   into [0, 2*pi). The bob tracks ACTUAL locomotion, so zero distance -
   whether standing idle OR holding a key against a wall (no progress) -
   recentres the phase to exactly 0.0: the head settles level when you
   aren't going anywhere, and a resting frame renders byte-identical. A
   smooth ease-to-centre is a possible feel follow-up; the hard reset
   keeps the at-rest frame byte-identical in a single frame."
  [world ^float dist]
  (if (php/> dist 0.0)
    (assoc world :bob-phase
           (php/fmod (php/+ (or (:bob-phase world) 0.0)
                            (php/* dist bob-phase-per-unit))
                     (php/* 2.0 php/M_PI)))
    (assoc world :bob-phase 0.0)))

(defn apply-physics
  "Per-frame: rotate, shear the look up/down pitch, then translate using
   the new heading, advance the head-bob phase by the ground covered, then
   decay every counter by dt seconds. Translation deltas read both `:moves`
   AND the sprint state (via sprint-factor) so sprint intent x stamina > 0
   x not-blocked yields a 1.6x boost. Pitch is a pure camera shear (no
   effect on translation), clamped by `clamp-pitch`."
  [world ^float dt]
  (let [moves   (:moves world)
        turned  (apply-rotation world (turn-delta moves dt))
        pitched (apply-pitch turned (pitch-delta moves dt))
        walked  (apply-translation pitched
                                   (longitudinal-delta pitched dt)
                                   (lateral-delta pitched dt))]
    (advance-bob-phase (decay-move-counters walked dt)
                       (moved-dist pitched walked))))

(defn tick-stamina
  "Drain stamina while sprinting + moving, regenerate while not (after
   a brief cooldown), and manage the :sprint-blocked? latch.

   - sprinting + moving: stamina -= stamina-drain * dt (clamped >= 0).
     On hitting 0, latch :sprint-blocked? true and arm cooldown.
   - not sprinting: tick cooldown down; once 0, regen by
     stamina-regen * dt (clamped <= max-stamina). Once stamina recovers
     past sprint-engage-threshold, clear :sprint-blocked? so the player
     can sprint again."
  [world ^float dt]
  (let [stam  (or (:stamina world) max-stamina)
        cd    (or (:sprint-cooldown-secs world) 0.0)
        blkd? (boolean (:sprint-blocked? world))
        spr?  (sprinting? world)
        move? (any-movement-on? world)]
    (cond
      (and spr? move?)
      (let [stam'  (php/max 0.0 (php/- stam (php/* stamina-drain dt)))
            empty? (php/<= stam' 0.0)]
        (assoc world
               :stamina               stam'
               :sprint-blocked?       (or blkd? empty?)
               :sprint-cooldown-secs  (if empty? sprint-cooldown-after cd)))

      :else
      (let [cd'        (php/max 0.0 (php/- cd dt))
            regen?     (php/<= cd' 0.0)
            stam'      (if regen?
                         (php/min max-stamina (php/+ stam (php/* stamina-regen dt)))
                         stam)
            unblocked? (and blkd? (php/>= stam' sprint-engage-threshold))]
        (assoc world
               :stamina               stam'
               :sprint-cooldown-secs  cd'
               :sprint-blocked?       (and blkd? (not unblocked?)))))))

(def blood-drop-spawn-rate
  "Expected new drops per second (Bernoulli per-frame using dt)."
  0.35)

(def blood-drop-fall-speed
  "Rows the drop falls per second."
  18.0)

(def blood-drop-ttl
  "Seconds a drop lives before it fades out."
  2.0)

(defn- advance-blood-drops
  "Walk every active drop one frame forward (row += speed*dt, ttl -=
   dt) and drop the ones whose ttl ran out. Returns a fresh vector."
  [drops ^float dt]
  (filterv (fn [d] (php/> (:ttl d) 0.0))
           (map (fn [d]
                  {:col (:col d)
                   :row (php/+ (:row d) (php/* blood-drop-fall-speed dt))
                   :ttl (php/- (:ttl d) dt)})
                (or drops []))))

(defn- maybe-spawn-drop
  "With probability spawn-rate*dt, append a fresh drop at row 1 with a
   uniformly-random normalised column in [0, 1). Otherwise unchanged."
  [drops ^float dt]
  (if (php/< (rng/float!)
             (php/* blood-drop-spawn-rate dt))
    (conj drops
          {:col (rng/float!)
           :row 1.0
           :ttl blood-drop-ttl})
    drops))

(defn tick-blood-drops
  "Ambient ceiling-drip effect: advance existing drops and (when
   :lives <= 6, i.e. 3 hearts of the 10-HP pool) roll a per-frame
   chance to spawn a new one. Already-
   falling drops still finish their fall so the cue doesn't pop out
   mid-frame when the player heals back above the threshold. Columns
   are stored normalised (0..1) so the render layer can scale to
   whatever vw is this frame."
  [world ^float dt]
  (let [drops     (or (:blood-drops world) [])
        advanced  (advance-blood-drops drops dt)
        low-life? (php/<= (or (:lives world) 0) 6)
        spawned   (if low-life? (maybe-spawn-drop advanced dt) advanced)]
    (assoc world :blood-drops spawned)))

(defn- heartbeat-interval
  "Seconds between thumps. Faster when closer to death. Returns nil
   when no heartbeat should play (full lives or dead)."
  [lives]
  ;; HP is a half-heart pool (10 = full): thump in the last ~2 hearts,
  ;; faster in the last heart.
  (cond
    (php/<= lives 0) nil
    (php/<= lives 2) 0.55
    (php/<= lives 4) 0.90
    :else            nil))

(defn tick-heartbeat
  "Advance the heartbeat phase by `dt`. Phase loops 0→1 over one beat.
   `:heartbeat-tick?` flips true on the frame the phase wraps so the
   IO layer can fire the thump sfx exactly once per cycle. Idle (no
   heartbeat) keeps phase at 0 and the flag at false."
  [world ^float dt]
  (let [interval (heartbeat-interval (:lives world))]
    (if (nil? interval)
      (assoc world :heartbeat-phase 0.0 :heartbeat-tick? false)
      (let [phase (php/+ (or (:heartbeat-phase world) 0.0)
                         (php// dt interval))
            wrap? (php/>= phase 1.0)]
        (assoc world
               :heartbeat-phase (if wrap? (php/fmod phase 1.0) phase)
               :heartbeat-tick? wrap?)))))
