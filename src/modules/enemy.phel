(ns phel-doom.modules.enemy
  (:require phel-doom.modules.map :refer [random-spawn wall?]))

(def chase-speed
  "Enemy walking speed in world units per second. Tuned well below the
   player (move-speed in play.phel) so backing off always works."
  1.5)
(def stop-dist
  "Enemies stop closing in once this close, so they don't pile up
   inside the player's cell."
  0.6)

(defn new-enemy
  "Create an enemy record. `x` and `y` are world-space floats; `:alive`
   flips to false when the enemy is shot."
  {:export true}
  [x y]
  {:x x :y y :alive true})

(defn- step-toward
  "Move enemy one frame of chase-speed * dt toward (target-x, target-y),
   skipping any axis whose new cell would collide with a wall. Returns
   an updated enemy map."
  [enemy grid target-x target-y dt]
  (let [ex (:x enemy)
        ey (:y enemy)]
    (let [dx (php/- target-x ex)
          dy (php/- target-y ey)]
      (let [dist (php/sqrt (php/+ (php/* dx dx) (php/* dy dy)))]
        (if (php/<= dist stop-dist)
          enemy
          (let [step (php/* chase-speed dt)]
            (let [nx (php/+ ex (php/* step (php// dx dist)))
                  ny (php/+ ey (php/* step (php// dy dist)))]
              (let [nx' (if (wall? grid (php/intval nx) (php/intval ey)) ex nx)
                    ny' (if (wall? grid (php/intval ex) (php/intval ny)) ey ny)]
                (assoc enemy :x nx' :y ny')))))))))

(defn shoot
  "Fire a hitscan from the player along their facing. Returns
   [new-enemies hit?]: the nearest alive enemy whose distance-to-ray is
   under `hit-radius` and whose distance-along-ray is under `max-range`
   AND closer than the wall in that direction is flipped to :alive false;
   `hit?` is true when an enemy was killed this shot."
  {:export true}
  [enemies px py angle wall-dist hit-radius max-range]
  (let [cos-a (php/cos angle)
        sin-a (php/sin angle)]
    (let [best (loop [i      0
                      best-i -1
                      best-d max-range
                      es     enemies]
                 (if (php/=== es nil)
                   best-i
                   (let [e (first es)]
                     (let [along (when (and e (:alive e))
                                   (let [dx (php/- (:x e) px)
                                         dy (php/- (:y e) py)]
                                     (let [proj (php/+ (php/* dx cos-a) (php/* dy sin-a))]
                                       (when (and (php/> proj 0.0) (php/< proj best-d)
                                                  (php/< proj wall-dist))
                                         (let [perp-x (php/- dx (php/* proj cos-a))
                                               perp-y (php/- dy (php/* proj sin-a))]
                                           (let [perp2 (php/+ (php/* perp-x perp-x) (php/* perp-y perp-y))]
                                             (when (php/<= perp2 (php/* hit-radius hit-radius))
                                               proj)))))))]
                       (if along
                         (recur (php/+ i 1) i along (next es))
                         (recur (php/+ i 1) best-i best-d (next es)))))))]
      (if (php/=== best -1)
        [enemies false]
        [(assoc-in (apply vector enemies) [best :alive] false) true]))))

(defn advance
  "Per-frame update: walk every alive enemy a dt-scaled step toward the
   player, with axis-separated wall collision so they slide along walls
   instead of getting stuck."
  {:export true}
  [enemies grid player-x player-y dt]
  (apply vector
         (map (fn [e]
                (if (:alive e)
                  (step-toward e grid player-x player-y dt)
                  e))
              enemies)))

(defn spawn-enemies
  "Place `n` enemies on random open cells of `grid`, well away from the
   player's spawn so the first frame isn't an ambush."
  {:export true}
  [grid n min-dist-from player-x player-y]
  (loop [acc       []
         attempts  0
         remaining n]
    (cond
      (php/=== remaining 0) acc
      (php/> attempts 200)  acc
      :else
      (let [[ex ey] (random-spawn grid)
            d2      (let [dx (php/- ex player-x)
                          dy (php/- ey player-y)]
                      (php/+ (php/* dx dx) (php/* dy dy)))]
        (if (php/< d2 (php/* min-dist-from min-dist-from))
          (recur acc (php/+ attempts 1) remaining)
          (recur (conj acc (new-enemy ex ey)) (php/+ attempts 1) (php/- remaining 1)))))))
