(ns phel-doom-tests.core.level-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.core.level :refer [ammo-box-count armor-shard-count config-for heart-count num-levels build-world place-secret-reward secret-trophies])
  (:require phel-doom.core.rng :as rng))

;; ---------------------------------------------------------------------
;; Seeded determinism (issue #64): same rng seed => identical level.
;; This is the foundation demo replay relies on.
;; ---------------------------------------------------------------------

(deftest test-build-world-deterministic-under-seed
  (rng/seed! 777)
  (let [a (build-world 1 5)]
    (rng/seed! 777)
    (let [b (build-world 1 5)]
      (is (= (:grid a) (:grid b)) "same seed -> identical map geometry")
      (is (= (:player a) (:player b)) "same spawn position + angle")
      (is (= (map (fn [e] [(:x e) (:y e) (:type e)]) (:enemies a))
             (map (fn [e] [(:x e) (:y e) (:type e)]) (:enemies b)))
          "same enemy spawns"))))

(deftest test-build-world-differs-under-different-seed
  (rng/seed! 1)
  (let [a (build-world 1 5)]
    (rng/seed! 2)
    (is (not (= (:grid a) (:grid (build-world 1 5))))
        "different seeds -> different maps")))

(deftest test-chase-speed-climbs-without-regression
  ;; Difficulty curve overhaul: chase speed must be non-decreasing
  ;; L1->L9 (no level slower than the one before) so the ramp never
  ;; visibly dips. L10 is allowed to ease (single-boss arena).
  (let [speeds (map (fn [n] (:chase-speed (build-world n 5))) (range 1 10))]
    (is (= speeds (sort speeds)) "L1-L9 chase speed is monotonic non-decreasing")))

(deftest test-early-levels-mix-shooter-and-melee
  ;; L1 stays a pure melee tutorial; L2-L5 salt a melee secondary into
  ;; the headline type so no early room is single-type monotony. L3
  ;; pairs the caco shooter with a body-attacker melee half.
  (let [types-at (fn [n] (set (map :type (:enemies (build-world n 5)))))]
    (is (= #{:imp} (types-at 1)) "L1 is pure imp (tutorial)")
    (is (contains? (types-at 2) :imp)   "L2 demons mix in imps")
    (is (contains? (types-at 3) :caco)  "L3 keeps the caco shooter")
    (is (contains? (types-at 3) :imp)   "L3 adds a melee body-attacker")
    (is (php/> (count (types-at 3)) 1)  "L3 is no longer single-type")
    (is (contains? (types-at 4) :demon) "L4 barons get a melee escort")
    (is (contains? (types-at 5) :imp)   "L5 cyberdemons get fodder")))

(deftest test-ranged-pressure-present-l6-l7
  ;; The old curve had a 3-level ranged gap (L5-L7). L6 + L7 now each
  ;; carry a caster so fireballs never disappear for the whole stretch.
  (let [types-at (fn [n] (set (map :type (:enemies (build-world n 5)))))]
    (is (contains? (types-at 6) :caco)  "L6 has a cacodemon")
    (is (contains? (types-at 7) :baron) "L7 has a baron")))

(deftest test-enemies-carry-depth-aggression
  ;; Every built enemy is stamped with a cooldown :aggression scalar
  ;; (enemy-ai/aggression-for), and a deeper level stamps a smaller one.
  (let [a1  (:aggression (first (:enemies (build-world 1 5))))
        a10 (:aggression (first (:enemies (build-world 10 5))))]
    (is (= 1.0 a1) "level 1 enemies attack at the full cooldown")
    (is (php/< a10 a1) "level 10 enemies recover faster between strikes")))

(deftest test-config-for-returns-each-level
  (is (= "imps"        (:name (config-for 1))))
  (is (= "demons"      (:name (config-for 2))))
  (is (= "cacodemons"  (:name (config-for 3))))
  (is (= "barons"      (:name (config-for 4))))
  (is (= "cyberdemons" (:name (config-for 5)))))

(deftest test-config-for-clamps-out-of-range
  ;; n < 1 yields the first level; n > num-levels yields the last.
  (is (= "imps"      (:name (config-for 0))))
  (is (= "imps"      (:name (config-for -10))))
  (is (= "the final" (:name (config-for 99)))))

(deftest test-num-levels-is-ten
  (is (= 10 num-levels)))

(deftest test-build-world-stamps-level-metadata
  (let [w (build-world 3 5)]
    (is (= 3 (:level w)))
    (is (= "cacodemons" (:level-name w)))
    (is (= 1.2 (:chase-speed w)))
    (is (>= (count (:enemies w)) 1))
    ;; grid + pgrid both present and the same dimensions.
    (is (>= (count (:grid w)) 24))))

(deftest test-build-world-clamps-level-for-bad-input
  (let [w (build-world 999 5)]
    ;; build-world reads through config-for which clamps to the last
    ;; entry, but the :level field reflects what the caller asked for.
    (is (= "the final" (:level-name w)))))

(deftest test-build-world-counts-secrets-for-l10
  ;; L10 carries the only hand-authored secrets in the catalog (2
  ;; inside the central pillar's inner walls). :secrets-total + a
  ;; zeroed :secrets-found land on the world so the HUD can paint
  ;; progress and play.phel can bump found-count on each reveal.
  (let [w (build-world 10 5)]
    (is (= 2 (:secrets-total w)))
    (is (= 0 (:secrets-found w)))))

(deftest test-build-world-passes-switches-through-from-config
  ;; L10 carries two switches that flip the central pillar walls
  ;; (issue #62). The level builder forwards :switches verbatim.
  (let [w (build-world 10 5)]
    (is (= 2 (count (:switches w))))
    (is (= [3 14]  (:at (first (:switches w)))))
    (is (= [16 14] (:at (second (:switches w)))))))

(deftest test-build-world-spawns-heart-when-lives-low
  (let [w (build-world 2 3)]
    (is (= 1 (count (:hearts w))))
    (is (= 3 (:lives w)))))

(deftest test-build-world-skips-heart-at-max-lives
  (let [w (build-world 2 10)]
    (is (= 0 (count (:hearts w))))
    (is (= 10 (:lives w)))))

(deftest test-build-world-l4-drops-chainsaw
  ;; Regression: the chainsaw (slot 4) was fully implemented but never
  ;; granted, so it was unreachable. L4 must seed a chainsaw pickup.
  (let [saws (filter (fn [p] (= :chainsaw (:weapon p)))
                     (:weapon-pickups (build-world 4 5)))]
    (is (= 1 (count saws)))))

(deftest test-build-world-l4-skips-chainsaw-when-owned
  (let [saws (filter (fn [p] (= :chainsaw (:weapon p)))
                     (:weapon-pickups (build-world 4 5 0 :normal #{:pistol :chainsaw})))]
    (is (= 0 (count saws)))))

;; ---------------------------------------------------------------------
;; Slim-entry refactor regression: each level's `:enemy` kw is stamped
;; on every enemy, and the world's primary `:enemy` matches the level's
;; catalog type.
;; ---------------------------------------------------------------------

(deftest test-build-world-stamps-primary-enemy-kw
  (is (= :imp   (:enemy (build-world 1 5))))
  (is (= :demon (:enemy (build-world 2 5))))
  (is (= :baron (:enemy (build-world 4 5))))
  (is (= :cyber (:enemy (build-world 5 5)))))

(deftest test-build-world-enemies-all-carry-type
  (let [w  (build-world 1 5)
        es (:enemies w)]
    (is (every? (fn [e] (= :imp (:type e))) es))))

(deftest test-build-world-enemy-lives-match-catalog-default
  ;; L1 :imp has :default-lives 1; build-world's slim entry omits
  ;; :enemy-lives so the catalog default flows through.
  (let [w (build-world 1 5)
        e (first (:enemies w))]
    (is (= 1 (:lives e))))
  ;; L5 :cyber has :default-lives 5 — same path. L5 is now a mix
  ;; (cyber + imp), so pick a cyber out rather than assuming spawn order.
  (let [w (build-world 5 5)
        e (first (filter (fn [x] (= :cyber (:type x))) (:enemies w)))]
    (is (= 5 (:lives e)))))

(deftest test-build-world-drops-world-level-enemy-visual-fields
  ;; Refactor moved visuals out of the world. Sanity-check the dead
  ;; fields really are gone so render can't accidentally re-read them.
  (let [w (build-world 1 5)]
    (is (nil? (:enemy-head-code w)))
    (is (nil? (:enemy-body-code w)))
    (is (nil? (:enemy-face w)))))

;; ---------------------------------------------------------------------
;; L6-L10 smoke: each level builds, exposes the right name, and spawns
;; the expected enemy mix. Random spawn collisions can drop a couple
;; of enemies in tight maps, so counts are tested with ≤ (not =).
;; ---------------------------------------------------------------------

(deftest test-level-6-builds-with-spectre-mix
  (let [w  (build-world 6 5)
        es (:enemies w)]
    (is (= "spectres" (:level-name w)))
    (is (= :spectre   (:enemy w)))
    (let [types (php/array_unique (php/array_map (fn [e] (php/strval (:type e)))
                                                 (to-php-array es)))]
      (is (php/in_array ":spectre" types true)))))

(deftest test-level-7-builds-with-revenant-mix
  (let [w (build-world 7 5)]
    (is (= "revenants" (:level-name w)))
    (is (= :revenant   (:enemy w)))))

(deftest test-level-8-builds-with-archvile-court
  (let [w (build-world 8 5)]
    (is (= "archvile court" (:level-name w)))
    (is (= :archvile         (:enemy w)))))

(deftest test-level-9-builds-with-brood-mix
  (let [w (build-world 9 5)]
    (is (= "the brood" (:level-name w)))
    (is (= :pinky      (:enemy w)))))

(deftest test-level-10-is-the-final-boss-arena
  ;; Hand-authored layout: the south spawn @ sits at row 17 col 10
  ;; (cell centre 10.5, 17.5). One boss with 20 HP, four imps.
  (let [w (build-world 10 5)]
    (is (= "the final" (:level-name w)))
    (is (= :cyber      (:enemy w)))
    ;; Layout was parsed (random-grid would have given different cells).
    (let [p (:player w)]
      (is (= 10.5 (:x p)))
      (is (= 17.5 (:y p))))
    ;; Exactly one boss spec produced one enemy with 50 HP.
    (let [es     (:enemies w)
          bosses (apply vector (filter (fn [e] (= :cyber (:type e))) es))
          imps   (apply vector (filter (fn [e] (= :imp   (:type e))) es))]
      (is (= 1  (count bosses)))
      (is (= 50 (:lives (first bosses))))
      ;; Two imps, each carrying the :max-concurrent 1 cap so the
      ;; respawn step never doubles up minion pressure.
      (is (= 2 (count imps)))
      (is (every? (fn [e] (= 1 (:max-concurrent e))) imps)))))

;; ---------------------------------------------------------------------
;; place-secret-reward: stash dropped at a revealed secret cell.
;; Always an ammo box + armor shard; plus one rotating trophy powerup
;; chosen by reveal index.
;; ---------------------------------------------------------------------

(def empty-pickups
  {:ammo-boxes [] :armor-shards [] :soulspheres [] :berserks [] :invulns []})

(deftest test-place-secret-reward-always-ammo-and-shard
  (let [w (place-secret-reward empty-pickups 5 7 0)]
    (is (= 1 (count (:ammo-boxes w))) "ammo box dropped")
    (is (= 1 (count (:armor-shards w))) "armor shard dropped")
    ;; Cell centre coords.
    (is (= 5.5 (:x (first (:ammo-boxes w)))))
    (is (= 7.5 (:y (first (:ammo-boxes w)))))))

(deftest test-place-secret-reward-trophy-rotates-by-index
  ;; idx 0 -> soulsphere, 1 -> berserk, 2 -> invuln, 3 -> wraps to soul.
  (is (= 1 (count (:soulspheres (place-secret-reward empty-pickups 1 1 0)))))
  (is (= 1 (count (:berserks    (place-secret-reward empty-pickups 1 1 1)))))
  (is (= 1 (count (:invulns     (place-secret-reward empty-pickups 1 1 2)))))
  (is (= 1 (count (:soulspheres (place-secret-reward empty-pickups 1 1 3))))
      "index wraps modulo trophy count"))

(deftest test-place-secret-reward-conjs-onto-existing
  (let [seeded (assoc empty-pickups :ammo-boxes [{:x 0.5 :y 0.5}])
        w      (place-secret-reward seeded 2 2 0)]
    (is (= 2 (count (:ammo-boxes w))) "appends, doesn't clobber existing")))

(deftest test-secret-trophies-are-the-rare-powerups
  (is (= [:soulspheres :berserks :invulns] secret-trophies)))

;; ---------------------------------------------------------------------
;; ammo-box-count: per-level ammo budget scales with the difficulty
;; ammo multiplier (issue #155) on top of the enemy-HP scaling.
;; ---------------------------------------------------------------------

(deftest test-ammo-box-count-baseline-hp-over-divisor
  ;; 6 enemies x 4 HP = 24 hp -> 24 / 8 = 3 boxes.
  (is (= 3 (ammo-box-count {:enemies 6 :enemy-lives 4})))
  (is (= 3 (ammo-box-count {:enemies 6 :enemy-lives 4 :ammo-mul 1.0}))))

(deftest test-ammo-box-count-scales-with-ammo-mul
  ;; x1.5 -> ceil(3 * 1.5) = 5 boxes.
  (is (= 5 (ammo-box-count {:enemies 6 :enemy-lives 4 :ammo-mul 1.5})))
  ;; x1.2 -> ceil(3 * 1.2) = 4 boxes.
  (is (= 4 (ammo-box-count {:enemies 6 :enemy-lives 4 :ammo-mul 1.2}))))

(deftest test-ammo-box-count-keeps-floor-of-two
  (is (= 2 (ammo-box-count {:enemies 1 :enemy-lives 1})))
  (is (= 2 (ammo-box-count {:enemies 1 :enemy-lives 1 :ammo-mul 1.5}))))

(deftest test-ammo-box-count-mixed-spec-uses-total-hp
  ;; specs: 2x3hp + 3x2hp = 12 hp -> 12/8 = 1.5 -> ceil 2; x1.5 -> ceil(2.25) = 3.
  (let [specs [{:type :demon :count 2 :lives 3} {:type :imp :count 3 :lives 2}]]
    (is (= 2 (ammo-box-count {:enemies specs})))
    (is (= 3 (ammo-box-count {:enemies specs :ammo-mul 1.5})))))

;; ---------------------------------------------------------------------
;; Heal/armor pickup scaling (issue #156): deterministic pickup counts
;; (hearts, armor shards) track the difficulty :pickup-mul. Rare
;; powerup odds (berserk/invuln/soulsphere) stay author-tuned.
;; ---------------------------------------------------------------------

(deftest test-heart-count-rounds-pickup-mul
  ;; round, not ceil: hard's x1.2 shouldn't double the heart supply.
  (is (= 1 (heart-count {})))
  (is (= 1 (heart-count {:pickup-mul 1.0})))
  (is (= 1 (heart-count {:pickup-mul 1.2})))
  (is (= 2 (heart-count {:pickup-mul 1.5}))))

(deftest test-armor-shard-count-ceils-pickup-mul
  ;; baseline 3 shards; ceil(3.6) = 4, ceil(4.5) = 5.
  (is (= 3 (armor-shard-count {})))
  (is (= 3 (armor-shard-count {:pickup-mul 1.0})))
  (is (= 4 (armor-shard-count {:pickup-mul 1.2})))
  (is (= 5 (armor-shard-count {:pickup-mul 1.5}))))

(deftest test-build-world-nightmare-seeds-scaled-pickups
  (rng/seed! 42)
  ;; lives=1 < max-lives so hearts are not suppressed; level 1 is
  ;; spacious so spawn-unique-pickups never bails early.
  (let [w (build-world 1 1 0 :nightmare)]
    (is (= 5 (count (:armor-shards w))) "nightmare seeds 5 shards")
    (is (= 2 (count (:hearts w))) "nightmare seeds 2 hearts")))

;; ---------------------------------------------------------------------
;; L2 verticality showcase (issue #237): the level that turns the
;; variable-height feature ON for players. build-world stamps the
;; staircase / platform / pit heights from the level config's
;; :floor-heights onto :floor-pgrid, and the low lintel from
;; :ceil-heights onto :ceil-pgrid. The L2 progression identity (name,
;; demon+imp mix) is preserved so the rest of the run is unchanged.
;; ---------------------------------------------------------------------

(defn- floor-h
  "Floor z stamped at cell (x, y) on a built world's :floor-pgrid."
  [world x y]
  (php/aget (php/aget (:floor-pgrid world) y) x))

(defn- ceil-h
  "Ceiling z stamped at cell (x, y) on a built world's :ceil-pgrid."
  [world x y]
  (php/aget (php/aget (:ceil-pgrid world) y) x))

(deftest test-showcase-level-loads-and-keeps-l2-identity
  ;; The showcase rides on L2: it must still be the "demons" room (name,
  ;; primary enemy, chase) and a demon + imp mix so the difficulty curve
  ;; and weapon-drop progression are untouched - only the geometry is now
  ;; hand-authored verticality.
  (let [w     (build-world 2 5)
        types (set (map :type (:enemies w)))]
    (is (= "demons" (:level-name w)))
    (is (= :demon   (:enemy w)))
    (is (= 1.0      (:chase-speed w)))
    (is (contains? types :demon) "demons present")
    (is (contains? types :imp)   "imp escort present")
    ;; Hand-authored layout parsed (not random-grid): 24x18 with the
    ;; south spawn @ at cell centre (11.5, 15.5).
    (is (= 24  (count (first (:grid w)))))
    (is (= 18  (count (:grid w))))
    (is (= 11.5 (:x (:player w))))
    (is (= 15.5 (:y (:player w))))))

(deftest test-showcase-staircase-rises-one-step-per-cell
  ;; The four stair cells (col 10, rows 8->5) climb by 0.3 each, every
  ;; rise <= step-up-max (0.4) so the whole flight is walkable.
  (let [w (build-world 2 5)]
    (is (< (php/abs (- (floor-h w 10 8) 0.3)) 1.0e-9) "step 1 = 0.3")
    (is (< (php/abs (- (floor-h w 10 7) 0.6)) 1.0e-9) "step 2 = 0.6")
    (is (< (php/abs (- (floor-h w 10 6) 0.9)) 1.0e-9) "step 3 = 0.9")
    (is (< (php/abs (- (floor-h w 10 5) 1.2)) 1.0e-9) "step 4 = 1.2")
    ;; Every successive rise is one 0.3 step (<= 0.4 step-up-max).
    (is (< (php/abs (- (- (floor-h w 10 7) (floor-h w 10 8)) 0.3)) 1.0e-9))
    (is (< (php/abs (- (- (floor-h w 10 6) (floor-h w 10 7)) 0.3)) 1.0e-9))
    (is (< (php/abs (- (- (floor-h w 10 5) (floor-h w 10 6)) 0.3)) 1.0e-9))))

(deftest test-showcase-platform-is-a-raised-plateau
  ;; Rows 2-4 (cols 8-13) sit flat at the top-stair height (1.2): a
  ;; vantage continuous with the stair top, so the cap reads as one
  ;; surface. Sample the corners + centre of the plateau.
  (let [w (build-world 2 5)]
    (is (< (php/abs (- (floor-h w 8 2)  1.2)) 1.0e-9) "plateau NW corner")
    (is (< (php/abs (- (floor-h w 13 4) 1.2)) 1.0e-9) "plateau SE corner")
    (is (< (php/abs (- (floor-h w 10 3) 1.2)) 1.0e-9) "plateau centre")
    ;; Continuous with the top stair (row 5) - no lip between them.
    (is (< (php/abs (- (floor-h w 10 4) (floor-h w 10 5))) 1.0e-9))))

(deftest test-showcase-pit-is-sunken-below-the-floor
  ;; The south-west pit (rows 12-13, cols 4-7) sits one step BELOW ground
  ;; at -0.4, so the player drops in and the 0.4 climb back out is exactly
  ;; walkable.
  (let [w (build-world 2 5)]
    (is (< (php/abs (- (floor-h w 4 12) -0.4)) 1.0e-9) "pit NW corner")
    (is (< (php/abs (- (floor-h w 7 13) -0.4)) 1.0e-9) "pit SE corner")
    (is (php/< (floor-h w 5 12) 0.0) "pit floor is below ground")))

(deftest test-showcase-ground-stays-flat-off-the-features
  ;; The entrance / landing the player spawns on is still flat (0.0) - the
  ;; heights only touch the authored staircase / platform / pit cells, so
  ;; the rest of the room walks like the classic floor.
  (let [w (build-world 2 5)]
    (is (= 0.0 (floor-h w 11 15)) "spawn cell flat")
    (is (= 0.0 (floor-h w 10 11)) "landing at the stair foot flat")
    (is (= 0.0 (floor-h w 18 8))  "east side flat")))

(deftest test-showcase-low-ceiling-lintel-over-the-stair-foot
  ;; The landing row at the foot of the stairs (row 9, cols 8-13) carries
  ;; a hanging ceiling at 0.7 (below the default 1.0) so the climb opens
  ;; out of a low passage; the rest of the ceiling is the flat 1.0.
  (let [w (build-world 2 5)]
    (is (< (php/abs (- (ceil-h w 8 9)  0.7)) 1.0e-9) "lintel west end")
    (is (< (php/abs (- (ceil-h w 13 9) 0.7)) 1.0e-9) "lintel east end")
    (is (php/< (ceil-h w 10 9) 1.0) "lintel hangs below the default ceiling")
    (is (= 1.0 (ceil-h w 10 8))  "ceiling above the lintel is flat 1.0")
    (is (= 1.0 (ceil-h w 11 15)) "ceiling over the spawn is flat 1.0")))

(deftest test-showcase-keeps-the-catalog-at-ten-levels
  ;; Riding the showcase on L2 (not appending a new level) keeps "the
  ;; final" boss arena as the last level, so the win condition
  ;; (reach num-levels) and the out-of-range clamp are unchanged.
  (is (= 10 num-levels))
  (is (= "the final" (:name (config-for num-levels)))))

;; ---------------------------------------------------------------------
;; Campaign verticality beyond the L2 showcase: L3 (descending trench),
;; L5 (raised central dais), L7 (staircase + ledge + low tunnel). Each is
;; hand-authored the same way the showcase is (flat :layout + a separate
;; height map), so build-world stamps the heights onto :floor-pgrid /
;; :ceil-pgrid at the feature cells. Each level KEEPS its catalog identity
;; (name, enemy mix, chase, lock) so the difficulty curve + progression
;; are unchanged - only the geometry is now authored.
;; ---------------------------------------------------------------------

(deftest test-l3-trench-keeps-identity-and-loads
  ;; The descending trench rides on L3: still the "cacodemons" room (name,
  ;; primary enemy, chase) with the caco + demon + imp mix, so progression
  ;; + the chaingun drop are unchanged.
  (let [w     (build-world 3 5)
        types (set (map :type (:enemies w)))]
    (is (= "cacodemons" (:level-name w)))
    (is (= :caco        (:enemy w)))
    (is (= 1.2          (:chase-speed w)))
    (is (contains? types :caco)  "caco shooter present")
    (is (contains? types :demon) "demon present")
    (is (contains? types :imp)   "imp present")
    ;; Hand-authored layout parsed (not random-grid): 28x24.
    (is (= 28 (count (first (:grid w)))))
    (is (= 24 (count (:grid w))))))

(deftest test-l3-trench-steps-down-two-tiers
  ;; The trench rim (rows 9 + 13) sits one step down (-0.4), the bottom
  ;; (rows 10-12) one tier deeper (-0.8). Each tier is one step-up-max
  ;; (0.4) so the descent + climb-out are both walkable.
  (let [w (build-world 3 5)]
    (is (< (php/abs (- (floor-h w 13 9)  -0.4)) 1.0e-9) "upper rim -0.4")
    (is (< (php/abs (- (floor-h w 13 13) -0.4)) 1.0e-9) "lower rim -0.4")
    (is (< (php/abs (- (floor-h w 13 10) -0.8)) 1.0e-9) "bottom -0.8")
    (is (< (php/abs (- (floor-h w 13 12) -0.8)) 1.0e-9) "bottom -0.8")
    ;; Each tier transition is exactly one 0.4 step (<= step-up-max).
    (is (< (php/abs (- (- (floor-h w 13 9) (floor-h w 13 10)) 0.4)) 1.0e-9)
        "rim->bottom is one step")
    (is (< (php/abs (- (- 0.0 (floor-h w 13 9)) 0.4)) 1.0e-9)
        "ground->rim is one step")))

(deftest test-l3-trench-flanks-and-spawn-stay-flat
  ;; The flanking ground (cols 1-4, 23-26) + the spawn row stay flat (0.0),
  ;; so the player can skirt the trench to the exit without descending.
  (let [w (build-world 3 5)]
    (is (= 0.0 (floor-h w 2 11))  "west flank flat")
    (is (= 0.0 (floor-h w 25 11)) "east flank flat")
    (is (= 0.0 (floor-h w 13 20)) "spawn cell flat")
    (is (= 13.5 (:x (:player w))))
    (is (= 20.5 (:y (:player w))))))

(deftest test-l5-dais-keeps-identity-and-loads
  ;; The central dais rides on L5: still "cyberdemons" (name, primary
  ;; enemy, chase, red lock) with the cyber + imp mix, so the rocket drop
  ;; + lock gating are unchanged.
  (let [w     (build-world 5 5)
        types (set (map :type (:enemies w)))]
    (is (= "cyberdemons" (:level-name w)))
    (is (= :cyber        (:enemy w)))
    (is (= 1.6           (:chase-speed w)))
    (is (= :red          (:door-lock w)) "red lock preserved")
    (is (contains? types :cyber) "cyberdemon present")
    (is (contains? types :imp)   "imp fodder present")
    ;; Hand-authored layout parsed: 30x26.
    (is (= 30 (count (first (:grid w)))))
    (is (= 26 (count (:grid w))))
    ;; Locked level still spawns its keycard.
    (is (= 1 (count (:keycards w))) "red keycard spawned")))

(deftest test-l5-dais-ramp-rises-onto-a-plateau
  ;; The two-step ramp (rows 13 + 12) climbs 0 -> 0.4 -> 0.8 onto the dais
  ;; plateau (rows 8-11), continuous with the ramp top (no lip). Each rise
  ;; is one step-up-max (0.4) so the climb is walkable.
  (let [w (build-world 5 5)]
    (is (< (php/abs (- (floor-h w 14 13) 0.4)) 1.0e-9) "ramp step 1 = 0.4")
    (is (< (php/abs (- (floor-h w 14 12) 0.8)) 1.0e-9) "ramp step 2 = 0.8")
    (is (< (php/abs (- (floor-h w 14 9)  0.8)) 1.0e-9) "plateau centre = 0.8")
    (is (< (php/abs (- (floor-h w 12 8)  0.8)) 1.0e-9) "plateau NW corner")
    (is (< (php/abs (- (floor-h w 17 11) 0.8)) 1.0e-9) "plateau SE corner")
    ;; Plateau is continuous with the top ramp step (no lip).
    (is (< (php/abs (- (floor-h w 14 11) (floor-h w 14 12))) 1.0e-9))
    ;; The ground ringing the dais stays flat so the exit is reachable.
    (is (= 0.0 (floor-h w 2 12))  "west ring flat")
    (is (= 0.0 (floor-h w 14 22)) "spawn cell flat")))

(deftest test-l7-staircase-keeps-identity-and-loads
  ;; The staircase + ledge rides on L7: still "revenants" (name, primary
  ;; enemy, chase, yellow lock) with the revenant + demon + baron mix, so
  ;; the BFG drop + lock gating are unchanged.
  (let [w     (build-world 7 5)
        types (set (map :type (:enemies w)))]
    (is (= "revenants" (:level-name w)))
    (is (= :revenant   (:enemy w)))
    (is (= 1.8         (:chase-speed w)))
    (is (= :yellow     (:door-lock w)) "yellow lock preserved")
    (is (contains? types :revenant) "revenant present")
    (is (contains? types :baron)    "baron ranged pressure present")
    ;; Hand-authored layout parsed: 30x26.
    (is (= 30 (count (first (:grid w)))))
    (is (= 26 (count (:grid w))))
    (is (= 1 (count (:keycards w))) "yellow keycard spawned")))

(deftest test-l7-staircase-climbs-onto-a-ledge
  ;; The three-step flight (rows 12 -> 10) climbs 0 -> 0.35 -> 0.70 -> 1.05
  ;; onto the ledge plateau (rows 2-9), each rise <= step-up-max (0.4). The
  ;; ledge cap is continuous with the top step.
  (let [w (build-world 7 5)]
    (is (< (php/abs (- (floor-h w 5 12) 0.35)) 1.0e-9) "step 1 = 0.35")
    (is (< (php/abs (- (floor-h w 5 11) 0.70)) 1.0e-9) "step 2 = 0.70")
    (is (< (php/abs (- (floor-h w 5 10) 1.05)) 1.0e-9) "step 3 = 1.05")
    (is (< (php/abs (- (floor-h w 5 5)  1.05)) 1.0e-9) "ledge = 1.05")
    ;; Every successive rise is one 0.35 step (<= 0.4 step-up-max).
    (is (< (php/abs (- (- (floor-h w 5 11) (floor-h w 5 12)) 0.35)) 1.0e-9))
    (is (< (php/abs (- (- (floor-h w 5 10) (floor-h w 5 11)) 0.35)) 1.0e-9))
    ;; Ledge is continuous with the top step (no lip).
    (is (< (php/abs (- (floor-h w 5 9) (floor-h w 5 10))) 1.0e-9))
    ;; The east half stays flat so the exit is reachable off the climb.
    (is (= 0.0 (floor-h w 22 22)) "spawn cell flat")
    (is (= 0.0 (floor-h w 20 10)) "east of the stairs flat")))

(deftest test-l7-low-ceiling-tunnel-over-the-stair-foot
  ;; The two rows just south of the staircase foot (rows 13-14, cols 3-7)
  ;; carry a hanging ceiling at 0.6 (below the default 1.0), so the climb
  ;; threads a low tunnel; the rest of the ceiling is the flat 1.0.
  (let [w (build-world 7 5)]
    (is (< (php/abs (- (ceil-h w 5 13) 0.6)) 1.0e-9) "tunnel ceiling 0.6")
    (is (< (php/abs (- (ceil-h w 5 14) 0.6)) 1.0e-9) "tunnel ceiling 0.6")
    (is (php/< (ceil-h w 5 13) 1.0) "tunnel hangs below the default ceiling")
    (is (= 1.0 (ceil-h w 5 5))   "ceiling over the ledge is flat 1.0")
    (is (= 1.0 (ceil-h w 22 22)) "ceiling over the spawn is flat 1.0")))
