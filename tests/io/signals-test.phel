(ns phel-doom-tests.io.signals-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.io.input :refer [install-signal-handlers! interrupted? reset-interrupt!]))

;; ---------------------------------------------------------------------
;; These raise a real SIGINT / SIGTERM at the test process rather than
;; mocking, so handlers must be installed first - the default disposition
;; would kill the run.
;; ---------------------------------------------------------------------

(defn- pcntl? []
  (and (php/function_exists "pcntl_signal")
       (php/function_exists "pcntl_signal_dispatch")
       (php/function_exists "posix_kill")))

(deftest test-install-reports-whether-pcntl-is-available
  ;; Never throws on a build without ext-pcntl - it degrades to the old
  ;; behaviour and says so.
  (is (= (pcntl?) (boolean (install-signal-handlers!)))))

(deftest test-not-interrupted-before-any-signal
  (install-signal-handlers!)
  (reset-interrupt!)
  (is (= false (interrupted?)) "no signal -> keep playing"))

(deftest test-sigint-sets-the-quit-flag
  (when (pcntl?)
    (install-signal-handlers!)
    (reset-interrupt!)
    (php/posix_kill (php/getmypid) php/SIGINT)
    ;; interrupted? runs the dispatch itself, which is the whole point:
    ;; the loop does not need its own pcntl call at the checkpoint.
    (is (= true (interrupted?)) "SIGINT -> quit flag set")
    (reset-interrupt!)))

(deftest test-sigterm-sets-the-quit-flag
  (when (pcntl?)
    (install-signal-handlers!)
    (reset-interrupt!)
    (php/posix_kill (php/getmypid) php/SIGTERM)
    (is (= true (interrupted?)) "SIGTERM -> quit flag set")
    (reset-interrupt!)))

(deftest test-the-process-survives-the-signal
  ;; The real regression this guards: default SIGINT disposition kills the
  ;; process. If the handler were not installed, the assertions above
  ;; would never run and the suite would die mid-file.
  (when (pcntl?)
    (install-signal-handlers!)
    (php/posix_kill (php/getmypid) php/SIGINT)
    (interrupted?)
    (reset-interrupt!)
    (is (= false (interrupted?))
        "reached this line at all, and the flag cleared")))

(deftest test-delivery-is-synchronous-not-async
  ;; The invariant .claude/rules/io-boundaries.md actually cares about: a
  ;; signal must not land at an arbitrary opcode boundary, because that can
  ;; be mid-render and render does not retry partial writes.
  ;;
  ;; This is not the PHP default state - symfony/console turns async ON in
  ;; the Application constructor (SignalRegistry), and src/main.phel builds
  ;; the Application at load. So install-signal-handlers! has to turn it
  ;; back off, and this pins that it does.
  (when (pcntl?)
    (php/pcntl_async_signals true)
    (install-signal-handlers!)
    (is (= false (php/pcntl_async_signals))
        "async delivery is off after installing handlers")
    (reset-interrupt!)))

(deftest test-flag-latches-until-reset
  (when (pcntl?)
    (install-signal-handlers!)
    (reset-interrupt!)
    (php/posix_kill (php/getmypid) php/SIGINT)
    (is (= true (interrupted?)) "set")
    (is (= true (interrupted?)) "stays set - the loop may poll more than once")
    (reset-interrupt!)
    (is (= false (interrupted?)) "cleared")))
