(ns phel-doom.modules.input)

(defn init-input!
  "Put the terminal in non-blocking raw mode so we can read single keys
   without waiting for Enter. Switch to the alternate screen buffer and
   hide the cursor to avoid flicker during the render loop.

   Also opts into the Kitty keyboard protocol (`CSI >3u`): flag 1 =
   disambiguate escape codes, flag 2 = report event types (so the
   terminal sends real key-release events as well as press / repeat).
   Terminals that don't support the protocol silently ignore the
   escape; controls.phel parses both kitty CSI-u events AND legacy
   single-byte input so either path works."
  {:export true}
  []
  (php/exec "stty -icanon -echo min 0 time 0")
  (php/stream_set_blocking php/STDIN false)
  (print "\e[?1049h\e[?25l\e[?7l\e[2J\e[H\e[>3u"))

(defn restore!
  "Restore cooked terminal mode, leave the alternate screen buffer, and
   pop the kitty-keyboard-protocol flags so the terminal goes back to
   plain bytes for subsequent shell commands."
  {:export true}
  []
  (print "\e[<u\e[?25h\e[?7h\e[?1049l")
  (php/exec "stty sane"))

(defn read-key
  "Read one key from STDIN. Returns the character or nil if nothing pending."
  {:export true}
  []
  (let [s (php/fread php/STDIN 1)]
    (if (or (= s false) (= s ""))
      nil
      s)))

(defn drain-keys
  "Drain all pending input bytes as a raw string (possibly empty). Lets
   a held key apply its motion multiple times per frame instead of being
   throttled by the loop's read-one-key cadence."
  {:export true}
  []
  (let [s (php/fread php/STDIN 64)]
    (if (= s false) "" s)))
