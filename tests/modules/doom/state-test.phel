(ns phel-doom-tests.modules.doom.state-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.modules.doom.state :refer [new-player new-world move-player turn-player]))

(def grid [[1 1 1] [1 0 1] [1 1 1]])

(deftest test-new-player-records-position-and-angle
  (let [p (new-player 1.0 2.0 0.5)]
    (is (= 1.0 (:x p)))
    (is (= 2.0 (:y p)))
    (is (= 0.5 (:angle p)))))

(deftest test-new-world-records-dimensions
  (let [w (new-world grid (new-player 1.0 1.0 0.0))]
    (is (= 3 (:width w)))
    (is (= 3 (:height w)))))

(deftest test-move-player-translates
  (let [w  (new-world grid (new-player 1.0 1.0 0.0))
        w2 (move-player w 0.3 0.4)]
    (is (= 1.3 (:x (:player w2))))
    (is (= 1.4 (:y (:player w2))))))

(deftest test-turn-player-rotates
  (let [w  (new-world grid (new-player 1.0 1.0 0.0))
        w2 (turn-player w 0.5)]
    (is (= 0.5 (:angle (:player w2))))))
