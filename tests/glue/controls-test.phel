(ns phel-doom-tests.glue.controls-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.glue.controls
            :refer [key-states refresh-from-keys rising-edges initial-key-snapshot
                    nav-deltas refresh-move mouse-aim edge-pan-rate mouse-look-gain]))

(def blank-moves
  {:fwd          0
   :back         0
   :strafe-left  0
   :strafe-right 0
   :turn-left    0
   :turn-right   0
   :sprint       0
   :pitch-up     0
   :pitch-down   0})

(def blank-world
  {:moves blank-moves})

;; ---------------------------------------------------------------------
;; key-states: snapshot of which one-shot keys appear in the byte
;; stream this frame.
;; ---------------------------------------------------------------------

(deftest test-key-states-empty-input
  (let [s (key-states "")]
    (is (= false (:sp s)))
    (is (= false (:m  s)))
    (is (= false (:p  s)))
    (is (= false (:n  s)))
    (is (= false (:e  s)))))

(deftest test-key-states-detects-space
  (is (= true (:sp (key-states " ")))))

(deftest test-key-states-detects-multiple
  (let [s (key-states "mp")]
    (is (= true (:m s)))
    (is (= true (:p s)))
    (is (= false (:sp s)))))

(deftest test-key-states-detects-about-face
  (is (= true (:e (key-states "e")))))

;; ---------------------------------------------------------------------
;; rising-edges: a key counts as "just pressed" only when it was off
;; the previous frame and is on this frame.
;; ---------------------------------------------------------------------

(deftest test-rising-edges-fresh-press-fires
  (let [edges (rising-edges {:sp true :m false :p false :n false :e false}
                            {:sp false :m false :p false :n false :e false})]
    (is (= true (:fire edges)))
    (is (= false (:toggle-map edges)))))

(deftest test-rising-edges-held-key-does-not-refire
  ;; Space pressed both frames — that's "still held", not a new press.
  (let [edges (rising-edges {:sp true :m false :p false :n false :e false}
                            {:sp true :m false :p false :n false :e false})]
    (is (= false (:fire edges)))))

(deftest test-rising-edges-release-does-not-fire
  ;; Was on, now off → nothing to do.
  (let [edges (rising-edges {:sp false :m false :p false :n false :e false}
                            {:sp true  :m false :p false :n false :e false})]
    (is (= false (:fire edges)))))

(deftest test-rising-edges-about-face-edge
  (let [edges (rising-edges {:sp false :m false :p false :n false :e true}
                            {:sp false :m false :p false :n false :e false})]
    (is (= true (:about-face edges)))))

(deftest test-initial-key-snapshot-has-every-tracked-key
  ;; Snapshot must cover every key rising-edges peeks at, else the
  ;; first frame after launch could spuriously fire.
  (is (= false (:sp initial-key-snapshot)))
  (is (= false (:m  initial-key-snapshot)))
  (is (= false (:p  initial-key-snapshot)))
  (is (= false (:n  initial-key-snapshot)))
  (is (= false (:e  initial-key-snapshot)))
  (is (= false (:f3 initial-key-snapshot)))
  ;; Weapon-slot keys are peeked by rising-edges too; a missing key
  ;; makes (not (:kN prev)) nil->true and can spuriously fire slot N
  ;; on frame 0.
  (is (= false (:k1 initial-key-snapshot)))
  (is (= false (:k2 initial-key-snapshot)))
  (is (= false (:k3 initial-key-snapshot)))
  (is (= false (:k4 initial-key-snapshot)))
  (is (= false (:k5 initial-key-snapshot)))
  (is (= false (:k6 initial-key-snapshot)))
  (is (= false (:k7 initial-key-snapshot))))

(deftest test-key-states-detects-f3-xterm-sequence
  ;; Most terminals (xterm, macOS Terminal, iTerm2) send `\eOR` for F3.
  (is (= true (:f3 (key-states "\eOR")))))

(deftest test-key-states-detects-f3-linux-sequence
  ;; Linux console + a handful of others use the CSI `~` form.
  (is (= true (:f3 (key-states "\e[13~")))))

(deftest test-rising-edges-toggle-debug-fires-on-fresh-f3
  (let [edges (rising-edges {:sp false :m false :p false :n false :e false :f3 true}
                            {:sp false :m false :p false :n false :e false :f3 false})]
    (is (= true (:toggle-debug edges)))))

(deftest test-rising-edges-toggle-debug-does-not-refire-while-held
  (let [edges (rising-edges {:sp false :m false :p false :n false :e false :f3 true}
                            {:sp false :m false :p false :n false :e false :f3 true})]
    (is (= false (:toggle-debug edges)))))

(deftest test-key-states-detects-r
  (is (= true (:r (key-states "r")))))

(deftest test-rising-edges-reload-fires-on-fresh-r
  (let [edges (rising-edges {:sp false :m false :p false :n false :e false :r true}
                            {:sp false :m false :p false :n false :e false :r false})]
    (is (= true (:reload edges)))))

;; ---------------------------------------------------------------------
;; Weapon-slot one-shots (1/2/3) — regression: kitty CSI-u release
;; events for one slot must NOT trigger the other two.
;; ---------------------------------------------------------------------

(deftest test-key-states-detects-digits-plain
  (let [s (key-states "2")]
    (is (= false (:k1 s)))
    (is (= true  (:k2 s)))
    (is (= false (:k3 s)))))

(deftest test-key-states-kitty-press-of-key-2-only-fires-k2
  ;; \e[50u  — press of digit '2' (codepoint 50) under kitty CSI-u.
  (let [s (key-states "\e[50u")]
    (is (= false (:k1 s)))
    (is (= true  (:k2 s)))
    (is (= false (:k3 s)))))

(deftest test-key-states-kitty-release-of-key-2-still-only-fires-k2
  ;; \e[50;1:3u — release of key-2 with mods=1, event=3. Bytes '1'
  ;; and '3' inside the CSI must NOT match plain '1' / '3', and the
  ;; release event itself must NOT match k2's press regex either.
  (let [s (key-states "\e[50;1:3u")]
    (is (= false (:k1 s)))
    (is (= false (:k2 s)))
    (is (= false (:k3 s)))))

(deftest test-key-states-kitty-repeat-of-key-2-does-not-fire-press
  ;; \e[50;1:2u — repeat event. Must not register as a press.
  (let [s (key-states "\e[50;1:2u")]
    (is (= false (:k2 s)))))

(deftest test-key-states-kitty-press-of-key-1-with-mods
  ;; \e[49;1u — kitty press with mods, no explicit event marker.
  (let [s (key-states "\e[49;1u")]
    (is (= true  (:k1 s)))
    (is (= false (:k2 s)))
    (is (= false (:k3 s)))))

(deftest test-key-states-letter-key-not-confused-by-digit-in-csi
  ;; A CSI containing '1' must not light up :k1.
  (is (= false (:k1 (key-states "\e[1;2D"))))
  ;; ...but plain "1" still does.
  (is (= true  (:k1 (key-states "1")))))

;; ---------------------------------------------------------------------
;; H info menu toggle. Symmetric with the other rising-edge toggles —
;; pressing H once flips :help?, pressing again flips it back. Held
;; H doesn't refire.
;; ---------------------------------------------------------------------

(deftest test-key-states-detects-h
  (is (= true  (:h (key-states "h"))))
  (is (= false (:h (key-states "")))))

(deftest test-key-states-detects-h-via-kitty-press
  ;; 104 = codepoint of lowercase 'h'.
  (is (= true (:h (key-states "\e[104u")))))

(deftest test-rising-edges-toggle-help-fires-on-fresh-h
  (let [edges (rising-edges (assoc initial-key-snapshot :h true)
                            initial-key-snapshot)]
    (is (= true (:toggle-help edges)))))

(deftest test-rising-edges-toggle-help-does-not-refire-while-held
  (let [held (assoc initial-key-snapshot :h true)]
    (is (= false (:toggle-help (rising-edges held held))))))

;; ---------------------------------------------------------------------
;; ESC: bare ESC byte closes whichever modal is open. Must NOT fire
;; on directional escape sequences (arrow keys, kitty events, F3).
;; ---------------------------------------------------------------------

(deftest test-key-states-detects-bare-esc
  (is (= true  (:esc (key-states "\e"))))
  (is (= false (:esc (key-states "")))))

(deftest test-key-states-ignores-esc-inside-csi
  ;; Arrow keys (`\e[A` etc), kitty CSI-u events, F3 (`\eOR`,
  ;; `\e[13~`) all start with ESC but must NOT register as
  ;; bare-ESC presses — those bytes are part of a sequence.
  (is (= false (:esc (key-states "\e[A"))))
  (is (= false (:esc (key-states "\e[B"))))
  (is (= false (:esc (key-states "\e[D"))))
  (is (= false (:esc (key-states "\eOR"))))    ; F3 xterm
  (is (= false (:esc (key-states "\e[13~"))))  ; F3 linux
  (is (= false (:esc (key-states "\e[50;1:3u"))))) ; kitty release

(deftest test-key-states-esc-with-trailing-input
  ;; ESC mixed with arrow keys should still detect the bare ESC.
  (is (= true (:esc (key-states "\e[A\e")))))

(deftest test-key-states-detects-kitty-esc
  ;; Kitty CSI-u: ESC (keycode 27) arrives wrapped as `\e[27u` (or
  ;; with `;mods` / `;mods:1` for press). Without explicit handling
  ;; the legacy CSI-strip erases the whole sequence and ESC is never
  ;; seen on kitty/WezTerm/Ghostty.
  (is (= true (:esc (key-states "\e[27u"))))
  (is (= true (:esc (key-states "\e[27;1u"))))
  (is (= true (:esc (key-states "\e[27;1:1u"))))
  ;; Repeat (`:2`) and release (`:3`) must NOT count as a press.
  (is (= false (:esc (key-states "\e[27;1:2u"))))
  (is (= false (:esc (key-states "\e[27;1:3u")))))

(deftest test-rising-edges-esc-fires-toggle-help
  ;; ESC is aliased to H — fresh ESC press lights up :toggle-help so
  ;; the info panel opens/closes exactly like pressing H.
  (let [edges (rising-edges (assoc initial-key-snapshot :esc true)
                            initial-key-snapshot)]
    (is (= true (:toggle-help edges)))))

(deftest test-rising-edges-esc-does-not-refire-while-held
  (let [held (assoc initial-key-snapshot :esc true)]
    (is (= false (:toggle-help (rising-edges held held))))))

(deftest test-rising-edges-h-fires-toggle-help
  (let [edges (rising-edges (assoc initial-key-snapshot :h true)
                            initial-key-snapshot)]
    (is (= true (:toggle-help edges)))))

;; ---------------------------------------------------------------------
;; Sprint: SHIFT-modified kitty CSI-u press of any movement key OR plain
;; 'x' byte refreshes the :sprint slot. Release events / plain
;; movement (no SHIFT mod) must NOT light up :sprint.
;;
;; Kitty CSI-u mods are encoded as (bits + 1); bit 0 = SHIFT, so SHIFT
;; alone is mods=2. Event 3 = release.
;; ---------------------------------------------------------------------

(deftest test-kitty-shift-mod-on-w-refreshes-sprint-slot
  ;; \e[119;2u — press of 'w' (codepoint 119) with mods=2 (SHIFT).
  ;; Also refreshes :fwd (W is still W).
  (let [w' (refresh-from-keys blank-world "\e[119;2u")]
    (is (php/> (:sprint (:moves w')) 0))
    (is (php/> (:fwd    (:moves w')) 0))))

(deftest test-kitty-no-mod-on-w-leaves-sprint-untouched
  (let [w' (refresh-from-keys blank-world "\e[119u")]
    (is (= 0 (:sprint (:moves w'))))
    (is (php/> (:fwd (:moves w')) 0))))

(deftest test-kitty-shift-mod-release-does-not-refresh-sprint
  ;; \e[119;2:3u — release event with shift held. Sprint slot stays 0.
  (let [w' (refresh-from-keys blank-world "\e[119;2:3u")]
    (is (= 0 (:sprint (:moves w'))))
    (is (= 0.0 (:fwd  (:moves w'))))))

(deftest test-x-byte-refreshes-sprint-slot
  ;; Legacy / non-kitty fallback: plain 'x' byte arms sprint.
  (let [w' (refresh-from-keys blank-world "x")]
    (is (php/> (:sprint (:moves w')) 0))))

(deftest test-x-still-works-under-kitty-as-codepoint-120
  ;; Under kitty, 'x' arrives wrapped as \e[120u. Must still hit :sprint.
  (let [w' (refresh-from-keys blank-world "\e[120u")]
    (is (php/> (:sprint (:moves w')) 0))))

(deftest test-sprint-slot-uses-short-hold-secs
  ;; Regression: the :sprint slot must NOT inherit the 0.30s
  ;; move-hold-secs bridge. Otherwise releasing SHIFT while still
  ;; walking forward would leave sprint hot for ~300ms — phantom
  ;; drain. sprint-hold-secs (0.05) matches turn-hold-secs so
  ;; release feels instant.
  (let [w' (refresh-from-keys blank-world "x")]
    (is (php/<= (:sprint (:moves w')) 0.1))))

;; ---------------------------------------------------------------------
;; Look up/down (pitch): ↑/↓ arrows arm :pitch-up / :pitch-down on every
;; encoding (legacy CSI \e[A/\e[B, SS3 \eOA/\eOB, kitty-enhanced
;; \e[1;..A/B). 't'/'g' are no longer bound.
;; ---------------------------------------------------------------------

(deftest test-up-arrow-refreshes-pitch-up-slot
  (let [w' (refresh-from-keys blank-world "\e[A")]
    (is (php/> (:pitch-up   (:moves w')) 0))
    (is (= 0   (:pitch-down (:moves w'))))
    (is (= 0   (:fwd        (:moves w'))) "up arrow looks, no longer moves forward")))

(deftest test-down-arrow-refreshes-pitch-down-slot
  (let [w' (refresh-from-keys blank-world "\e[B")]
    (is (php/> (:pitch-down (:moves w')) 0))
    (is (= 0   (:pitch-up   (:moves w'))))
    (is (= 0   (:back       (:moves w'))) "down arrow looks, no longer moves back")))

(deftest test-ss3-up-down-arrows-pitch
  ;; App-cursor SS3 form (tmux / alt-screen) reaches the same slots.
  (is (php/> (:pitch-up   (:moves (refresh-from-keys blank-world "\eOA"))) 0))
  (is (php/> (:pitch-down (:moves (refresh-from-keys blank-world "\eOB"))) 0)))

(deftest test-kitty-enhanced-up-down-arrows-pitch
  ;; Kitty enhanced arrows keep the legacy letter suffix: \e[1;mods:eventA.
  (is (php/> (:pitch-up   (:moves (refresh-from-keys blank-world "\e[1;1:1A"))) 0))
  (is (php/> (:pitch-down (:moves (refresh-from-keys blank-world "\e[1;1:1B"))) 0)))

(deftest test-refresh-move-maps-up-standin-to-pitch-up
  ;; refresh-move sees the normalised single-byte stand-in (^ = up arrow);
  ;; it lands in exactly :pitch-up, nothing else.
  (let [w' (refresh-move blank-world "^")]
    (is (= (assoc blank-moves :pitch-up (:pitch-up (:moves w')))
           (:moves w')))))

(deftest test-t-and-g-no-longer-bound
  ;; The old t/g pitch keys are freed - they touch no slot now.
  (is (= blank-moves (:moves (refresh-from-keys blank-world "t"))))
  (is (= blank-moves (:moves (refresh-from-keys blank-world "g")))))

(deftest test-pitch-slot-uses-short-hold-secs
  ;; Pitch halts fast (like turn), not the long move-hold bridge, so the
  ;; camera doesn't keep drifting after the key is released.
  (let [w' (refresh-from-keys blank-world "\e[A")]
    (is (php/<= (:pitch-up (:moves w')) 0.1))))

;; ---------------------------------------------------------------------
;; Capital WASD: legacy fallback so SHIFT+WASD sprints on terminals
;; without kitty CSI-u (Terminal.app, plain xterm, GNOME Terminal).
;; In cooked raw mode SHIFT just uppercases the byte, so SHIFT+W = 'W'.
;; ---------------------------------------------------------------------

(deftest test-capital-w-refreshes-fwd-and-sprint
  (let [w' (refresh-from-keys blank-world "W")]
    (is (php/> (:fwd    (:moves w')) 0))
    (is (php/> (:sprint (:moves w')) 0))))

(deftest test-capital-s-refreshes-back-and-sprint
  (let [w' (refresh-from-keys blank-world "S")]
    (is (php/> (:back   (:moves w')) 0))
    (is (php/> (:sprint (:moves w')) 0))))

(deftest test-capital-a-refreshes-strafe-left-and-sprint
  (let [w' (refresh-from-keys blank-world "A")]
    (is (php/> (:strafe-left (:moves w')) 0))
    (is (php/> (:sprint      (:moves w')) 0))))

(deftest test-capital-d-refreshes-strafe-right-and-sprint
  (let [w' (refresh-from-keys blank-world "D")]
    (is (php/> (:strafe-right (:moves w')) 0))
    (is (php/> (:sprint       (:moves w')) 0))))

(deftest test-lowercase-w-does-not-arm-sprint
  ;; Plain w (no SHIFT) must NOT light up :sprint — only capitals do.
  (let [w' (refresh-from-keys blank-world "w")]
    (is (php/> (:fwd    (:moves w')) 0))
    (is (= 0 (:sprint (:moves w'))))))

;; ---------------------------------------------------------------------
;; Settings page (issue #107): nav-deltas turns the raw drain string
;; into net cursor / value steps. Arrows (CSI / SS3 / kitty) AND WASD
;; both count, and counting (not a bool) means a held key's OS-repeat
;; burst ramps a slider.
;; ---------------------------------------------------------------------

(deftest test-nav-deltas-csi-arrows
  (is (= {:cursor 1  :value 0}  (nav-deltas "\e[B")) "down")
  (is (= {:cursor -1 :value 0}  (nav-deltas "\e[A")) "up")
  (is (= {:cursor 0  :value 1}  (nav-deltas "\e[C")) "right")
  (is (= {:cursor 0  :value -1} (nav-deltas "\e[D")) "left"))

(deftest test-nav-deltas-ss3-arrows
  ;; SS3 application-cursor form (`\eO*`) common under tmux / alt-screen.
  (is (= {:cursor 1 :value 0}  (nav-deltas "\eOB")))
  (is (= {:cursor 0 :value -1} (nav-deltas "\eOD"))))

(deftest test-nav-deltas-modified-and-kitty-arrows
  (is (= {:cursor -1 :value 0} (nav-deltas "\e[1;2A")) "shift+up")
  (is (= {:cursor -1 :value 0} (nav-deltas "\e[1;1:1A")) "kitty up press"))

(deftest test-nav-deltas-excludes-kitty-release-events
  ;; Regression (menu double-move): with report-event-types on
  ;; (\e[>3u in init-input!), a single arrow tap sends a PRESS and a
  ;; RELEASE (:3). Counting both moved the settings cursor twice per
  ;; keypress. Release events must NOT count.
  (is (= {:cursor 0 :value 0} (nav-deltas "\e[1;1:3B")) "release alone = no move")
  (is (= {:cursor 1 :value 0} (nav-deltas "\e[B\e[1;1:3B")) "bare press + release = one move")
  (is (= {:cursor 1 :value 0} (nav-deltas "\e[1;1:1B\e[1;1:3B")) "press + release = one move"))

(deftest test-nav-deltas-counts-kitty-repeat-for-ramp
  ;; A held arrow on kitty sends press then repeat (:2) events; both
  ;; count so the slider still ramps. Only release (:3) is dropped.
  (is (= {:cursor 3 :value 0} (nav-deltas "\e[1;1:1B\e[1;1:2B\e[1;1:2B"))))

(deftest test-nav-deltas-wasd-fallback
  ;; WASD navigates too, so the page works even when arrows aren't
  ;; recognised by the terminal.
  (is (= {:cursor 1  :value 0}  (nav-deltas "s")) "s = down")
  (is (= {:cursor -1 :value 0}  (nav-deltas "w")) "w = up")
  (is (= {:cursor 0  :value 1}  (nav-deltas "d")) "d = right")
  (is (= {:cursor 0  :value -1} (nav-deltas "a")) "a = left"))

(deftest test-nav-deltas-counts-repeats-for-ramp
  ;; A held key's repeated bytes accumulate so a slider ramps.
  (is (= {:cursor 0 :value 3}  (nav-deltas "ddd")))
  (is (= {:cursor -2 :value 0} (nav-deltas "\e[A\e[A"))))

(deftest test-nav-deltas-empty-and-non-nav
  (is (= {:cursor 0 :value 0} (nav-deltas "")))
  ;; F3's SS3 (`\eOR`) shares the `\eO` prefix but a different final
  ;; byte, so it is not mistaken for an arrow.
  (is (= {:cursor 0 :value 0} (nav-deltas "\eOR"))))

(deftest test-ss3-arrow-drives-in-game-turn
  ;; The SS3 form also feeds the movement path so turning works under
  ;; app-cursor mode, not just menu nav.
  (let [w' (refresh-from-keys blank-world "\eOD")]
    (is (php/> (:turn-left (:moves w')) 0)))
  (let [w' (refresh-from-keys blank-world "\eOC")]
    (is (php/> (:turn-right (:moves w')) 0))))

;; ---------------------------------------------------------------------
;; Menu confirm (#225): key-states :enter detects ENTER/Return; the
;; :confirm rising edge (space OR enter) drives pause-menu select +
;; settings back-out. Edge-gated so a held key can't auto-select.
;; ---------------------------------------------------------------------

(deftest test-key-states-detects-enter
  (is (= true (:enter (key-states "\r"))) "CR is Enter")
  (is (= true (:enter (key-states "\n"))) "LF is Enter")
  (is (not (:enter (key-states ""))) "no Enter in empty input")
  (is (not (:enter (key-states "x"))) "a plain key is not Enter"))

(deftest test-rising-edges-confirm-fires-on-enter
  (let [edges (rising-edges {:sp false :enter true} {:sp false :enter false})]
    (is (= true (:confirm edges)) "fresh Enter confirms")))

(deftest test-rising-edges-confirm-fires-on-space
  (let [edges (rising-edges {:sp true :enter false} {:sp false :enter false})]
    (is (= true (:confirm edges)) "fresh space confirms")))

(deftest test-rising-edges-confirm-held-does-not-refire
  ;; Held space/enter (e.g. fire carried from gameplay into pause, or
  ;; Enter auto-repeat) must NOT keep confirming - edge only.
  (is (= false (:confirm (rising-edges {:sp true :enter false} {:sp true :enter false}))))
  (is (= false (:confirm (rising-edges {:sp false :enter true} {:sp false :enter true})))))

(deftest test-rising-edges-confirm-silent-when-idle
  (is (= false (:confirm (rising-edges {:sp false :enter false} {:sp false :enter false})))))

;; ---------------------------------------------------------------------
;; Mouselook (#324): pure SGR-mouse parse -> a fixed-centre crosshair
;; (aim-col/aim-row nil, gun fires dead-ahead) + a camera yaw/pitch driven
;; by the pointer DELTA since last frame (1:1), with an edge-pan fallback
;; while the pointer is parked in the outer band. SGR report shape:
;; ESC [ < b ; Cx ; Cy (M|m), Cx/Cy 1-based absolute cells.
;;   b = 0  -> left button press (discrete)
;;   b = 32 -> motion bit, button 0 = LEFT DRAG (held during move)
;;   b = 35 -> motion bit, low bits 3 = bare hover (no button held)
;;
;; For [30 120]: look-yaw-per-cell = 1/70 (fov-proj-dist 120 = proj-dist
;; 70), look-pitch-per-cell = 1/(0.4*30) = 1/12, so N columns/rows of
;; pointer travel turn the view N rendered columns/rows. The edge-pan band
;; is the outer 30% of each half-axis (col band starts ~101, row band ~25);
;; edge rate-max yaw 0.16, pitch 0.06. edge-pan-rate is 0 in the inner
;; centre region and eases (square) to max-rate at the very edge.
;; ---------------------------------------------------------------------

(def look-dims
  "Live [rows cols] for the reticle tests: 30 rows, 120 cols (centre cell
   59.5 col / 14.5 row, 0-based)."
  [30 120])

(def test-dt
  "One 60fps frame in seconds, threaded into every mouse-aim call so the
   edge-pan contribution (now per-second, scaled by dt) reproduces the
   same per-frame magnitude these tests were written against."
  (php// 1.0 60.0))

;; Pointer cells (1-based SGR Cx/Cy) used across the suite:
(def center-pos
  "Pointer at (or one off) the terminal centre."
  [60 15])
(def right-edge-pos [120 15])  ; far right edge   -> reticle col 119, +yaw
(def left-edge-pos  [1 15])    ; far left edge    -> reticle col 0,   -yaw
(def top-edge-pos   [60 1])    ; top edge         -> reticle row 0,   +pitch (look up)
(def bottom-edge-pos [60 30])  ; bottom edge      -> reticle row 29,  -pitch (look down)

(defn- approx?
  "Float compare with a tolerance, so an eased ramp that lands on
   0.0393... still matches the expected value."
  [^float a ^float b]
  (php/< (php/abs (php/- a b)) 1.0e-9))

;; --- edge-pan-rate: 0-based pointer cell -> per-frame edge-fallback rate ---

(deftest test-edge-pan-rate-center-region-is-zero
  ;; The inner ~70% centre region adds NO edge turn (the 1:1 delta look
  ;; handles ordinary aiming); only the outer band sustains a turn.
  (is (= 0.0 (edge-pan-rate 59.5 120 0.16)) "screen centre -> no pan")
  (is (= 0.0 (edge-pan-rate 75.0 120 0.16)) "still in the centre region -> no pan")
  (is (= 0.0 (edge-pan-rate 101.0 120 0.16)) "just inside the band edge -> no pan"))

(deftest test-edge-pan-rate-band-pans
  ;; Past the band threshold the camera pans, saturating to max-rate at the
  ;; very edge cell; the left edge pans the opposite sign.
  (is (php/> (edge-pan-rate 110.0 120 0.16) 0.0) "deep in the right band -> +pan")
  (is (approx? 0.16 (edge-pan-rate 119.0 120 0.16)) "right edge saturates to +max")
  (is (approx? -0.16 (edge-pan-rate 0.0 120 0.16)) "left edge saturates to -max"))

(deftest test-edge-pan-rate-grows-toward-edge
  ;; Magnitude grows monotonically the deeper into the band the reticle is.
  (let [near (edge-pan-rate 105.0 120 0.16)
        far  (edge-pan-rate 115.0 120 0.16)]
    (is (php/> near 0.0) "inside the band -> positive")
    (is (php/> far near) "nearer the edge pans faster")
    (is (php/<= far 0.16) "never exceeds the max rate")))

(deftest test-edge-pan-rate-degenerate-axis-is-zero
  (is (= 0.0 (edge-pan-rate 60.0 nil 0.16)) "nil len -> 0")
  (is (= 0.0 (edge-pan-rate 0.0 1 0.16)) "len 1 -> 0"))

;; --- mouse-aim: fixed-centre crosshair + delta mouselook + fire ---

(deftest test-mouse-aim-crosshair-is-always-centred
  ;; The gun fires dead-ahead, so aim-col/aim-row are nil whatever the
  ;; pointer does (resting, mid-screen, at an edge).
  (is (nil? (:aim-col (mouse-aim "" center-pos 1.0 test-dt look-dims))) "resting -> nil reticle")
  (is (nil? (:aim-col (mouse-aim "\e[<35;80;15M" center-pos 1.0 test-dt look-dims))) "moved -> still nil")
  (is (nil? (:aim-col (mouse-aim "\e[<35;120;15M" center-pos 1.0 test-dt look-dims))) "at edge -> still nil")
  (is (nil? (:aim-row (mouse-aim "\e[<35;60;1M" center-pos 1.0 test-dt look-dims))) "nil reticle row too"))

(deftest test-mouse-aim-no-motion-no-turn
  ;; No report this frame (pointer unchanged, interior): zero delta and no
  ;; edge fallback in the centre region, so the camera holds still.
  (let [r (mouse-aim "" center-pos 1.0 test-dt look-dims)]
    (is (= 0.0 (:yaw r)) "no motion -> no yaw")
    (is (= 0.0 (:pitch r)) "no motion -> no pitch")
    (is (= false (:fire? r)))
    (is (= false (:fire-held? r)))
    (is (= center-pos (:pos r)) "cached pointer carried forward")))

(deftest test-mouse-aim-delta-turns-camera-1to1
  ;; Moving the pointer RIGHT yaws right (+), LEFT yaws left (-), by the
  ;; columns moved scaled by mouse-look-gain: 20 columns from centre ->
  ;; gain*20/70 rad (the raw 1:1 is 20/70; fov-proj-dist 120 = proj-dist 70).
  (let [right (mouse-aim "\e[<35;80;15M" center-pos 1.0 test-dt look-dims)
        left  (mouse-aim "\e[<35;40;15M" center-pos 1.0 test-dt look-dims)]
    (is (php/> (:yaw right) 0.0) "pointer right -> yaw right")
    (is (approx? (php/* mouse-look-gain (php// 20.0 70.0)) (:yaw right)) "20 columns -> gain*20/70 rad")
    (is (php/< (:yaw left) 0.0) "pointer left -> yaw left")
    (is (approx? (php/* mouse-look-gain (php// -20.0 70.0)) (:yaw left)) "left is the mirror")
    (is (= 0.0 (:pitch right)) "horizontal move at mid-row -> no pitch")))

(deftest test-mouse-aim-delta-pitch-1to1
  ;; Moving the pointer DOWN looks down (-pitch), UP looks up (+pitch), by
  ;; the rows moved scaled by mouse-look-gain: 5 rows -> gain*5/12 fraction
  ;; (rows grow downward, so down is negative). y 20 / y 10 stay inside the
  ;; row band, so no edge contamination.
  (let [down (mouse-aim "\e[<35;60;20M" center-pos 1.0 test-dt look-dims)
        up   (mouse-aim "\e[<35;60;10M" center-pos 1.0 test-dt look-dims)]
    (is (php/< (:pitch down) 0.0) "pointer down -> look down (-pitch)")
    (is (approx? (php/* mouse-look-gain (php// -5.0 12.0)) (:pitch down)) "5 rows down -> -gain*5/12")
    (is (php/> (:pitch up) 0.0) "pointer up -> look up (+pitch)")
    (is (approx? (php/* mouse-look-gain (php// 5.0 12.0)) (:pitch up)) "5 rows up -> +gain*5/12")
    (is (= 0.0 (:yaw down)) "vertical move at mid-col -> no yaw")))

(deftest test-mouse-aim-delta-is-linear
  ;; The turn is proportional to the distance moved: 20 columns yaws twice
  ;; as far as 10 columns.
  (let [d10 (:yaw (mouse-aim "\e[<35;70;15M" center-pos 1.0 test-dt look-dims))
        d20 (:yaw (mouse-aim "\e[<35;80;15M" center-pos 1.0 test-dt look-dims))]
    (is (approx? (php/* 2.0 d10) d20) "2x the pointer move -> 2x the yaw")))

(deftest test-mouse-aim-sensitivity-scales-the-look
  ;; Sensitivity scales the WHOLE look: 2x sens doubles the delta turn, 0
  ;; disables it; a click still fires at 0.
  (let [s1 (:yaw (mouse-aim "\e[<35;80;15M" center-pos 1.0 test-dt look-dims))
        s2 (:yaw (mouse-aim "\e[<35;80;15M" center-pos 2.0 test-dt look-dims))
        s0 (:yaw (mouse-aim "\e[<35;80;15M" center-pos 0.0 test-dt look-dims))]
    (is (approx? (php/* 2.0 s1) s2) "2x sensitivity -> 2x yaw")
    (is (= 0.0 s0) "0 sensitivity -> no turn"))
  (let [r (mouse-aim "\e[<0;60;15M" center-pos 0.0 test-dt look-dims)]
    (is (= true (:fire? r)) "click fires even at 0 sensitivity")))

(deftest test-mouse-aim-edge-pan-holds-at-edge
  ;; A pointer PINNED at (or gone past) a border keeps panning every frame
  ;; from the CACHED position (ungated, #324) with no new report. A terminal
  ;; cannot lock / confine / hide the pointer, so it drifts to the border and
  ;; can leave the window; the held edge-pan is what keeps the aim from
  ;; freezing there - the turn stays "embedded" even though the arrow can't.
  (is (php/> (:yaw (mouse-aim "" right-edge-pos 1.0 test-dt look-dims)) 0.0) "held at right edge keeps panning right")
  (is (php/< (:yaw (mouse-aim "" left-edge-pos 1.0 test-dt look-dims)) 0.0) "held at left edge keeps panning left")
  (is (php/> (:pitch (mouse-aim "" top-edge-pos 1.0 test-dt look-dims)) 0.0) "held at top keeps looking up")
  (is (php/< (:pitch (mouse-aim "" bottom-edge-pos 1.0 test-dt look-dims)) 0.0) "held at bottom keeps looking down"))

(deftest test-mouse-aim-edge-pan-fires-on-push-into-band
  ;; Pushing DEEPER into the band adds the edge spin ON TOP of the delta (so
  ;; you can turn past the view); retreating toward centre still nets a turn
  ;; BACK (the negative delta dominates the small residual edge-pan until the
  ;; pointer clears the band). 110 / 118 are both in the right band (~101+).
  (let [push-r     (:yaw (mouse-aim "\e[<35;118;15M" [110 15] 1.0 test-dt look-dims))
        delta-only (php/* mouse-look-gain (php// 8.0 70.0))]
    (is (php/> push-r delta-only) "pushing right into the band adds edge spin beyond the delta"))
  (let [retreat (:yaw (mouse-aim "\e[<35;110;15M" [118 15] 1.0 test-dt look-dims))]
    (is (php/< retreat 0.0) "retreating from the right edge nets a turn back (delta dominates)"))
  ;; Vertical twin: pushing down into the bottom band looks further down than
  ;; the bare delta (24 is interior, 28 is in the band).
  (let [push-d     (:pitch (mouse-aim "\e[<35;60;28M" [60 24] 1.0 test-dt look-dims))
        delta-only (php/* mouse-look-gain (php// -4.0 12.0))]
    (is (php/< push-d delta-only) "pushing down into the band looks further down than the delta")))

(deftest test-mouse-aim-interior-has-no-edge-creep
  ;; A pointer resting in the centre region (no motion) adds NO turn: the
  ;; fallback only fires at the border, so ordinary aiming never creeps.
  (let [r (mouse-aim "" [75 15] 1.0 test-dt look-dims)]
    (is (= 0.0 (:yaw r)) "resting mid-screen -> no creep")
    (is (= 0.0 (:pitch r)) "resting mid-screen -> no pitch creep")))

(deftest test-mouse-aim-first-frame-nil-prev-no-jolt
  ;; First frame / post-resize: prev-pos is nil, so even a report far from
  ;; centre yields NO delta turn (the view holds steady, no seed jolt); the
  ;; report just establishes the baseline pointer for next frame.
  (let [r (mouse-aim "\e[<35;80;15M" nil 1.0 test-dt look-dims)]
    (is (= 0.0 (:yaw r)) "nil prev -> no delta yaw")
    (is (= 0.0 (:pitch r)) "nil prev -> no delta pitch")
    (is (= [80 15] (:pos r)) "but the pointer baseline is established"))
  (let [r (mouse-aim "" nil 1.0 test-dt look-dims)]
    (is (= 0.0 (:yaw r)) "nil prev, no report -> no turn")
    (is (= nil (:pos r)) "pos stays nil")))

(deftest test-mouse-aim-last-report-wins-and-drives-delta
  ;; Multiple reports in a frame collapse to the LAST pointer; the delta is
  ;; measured from prev-pos to that final cell (100 is still interior, so no
  ;; edge component muddies the value).
  (let [r (mouse-aim "\e[<35;90;15M\e[<35;100;15M" center-pos 1.0 test-dt look-dims)]
    (is (= [100 15] (:pos r)) "the last report in the frame wins")
    (is (approx? (php/* mouse-look-gain (php// 40.0 70.0)) (:yaw r)) "delta is centre(60)->100 = 40 columns")))

(deftest test-mouse-aim-no-dims-is-inert
  ;; Without [rows cols] there is no viewport to scale the delta or band, so
  ;; the look is inert - but fire intent still parses, so a non-loop caller
  ;; is unaffected.
  (let [r (mouse-aim "\e[<35;120;15M" center-pos 1.0 test-dt)]
    (is (nil? (:aim-col r)) "no dims -> nil reticle")
    (is (= 0.0 (:yaw r)) "no dims -> no yaw")
    (is (= 0.0 (:pitch r)) "no dims -> no pitch"))
  (let [r (mouse-aim "\e[<0;60;15M" center-pos 1.0 test-dt)]
    (is (= true (:fire? r)) "fire still parses with no dims")))

;; --- fire intent + report parsing (independent of the look model) ---

(deftest test-mouse-aim-left-press-fires
  ;; A left-button press (b=0, final M) is a fresh fire rising-edge.
  (let [r (mouse-aim "\e[<0;60;15M" center-pos 1.0 test-dt look-dims)]
    (is (= true (:fire? r)) "left press fires")
    (is (= true (:fire-held? r)) "and counts as held")))

(deftest test-mouse-aim-left-release-does-not-fire
  ;; A left release (final m) is not a press, so it doesn't fire.
  (let [r (mouse-aim "\e[<0;60;15m" center-pos 1.0 test-dt look-dims)]
    (is (= false (:fire? r)) "release does not fire")
    (is (= false (:fire-held? r)) "release is not held")))

(deftest test-mouse-aim-left-drag-is-held-fire-and-turns
  ;; A left DRAG (b=32: motion bit + button 0) feeds auto-fire weapons and,
  ;; being a motion report, also moves the pointer so the camera turns.
  (let [r (mouse-aim "\e[<32;120;15M" center-pos 1.0 test-dt look-dims)]
    (is (= false (:fire? r)) "a drag is not a fresh press edge")
    (is (= true (:fire-held? r)) "but it holds the trigger for auto-fire")
    (is (php/> (:yaw r) 0.0) "and the drag turns the camera toward the pointer")))

(deftest test-mouse-aim-press-then-move-fires-and-turns
  (let [r (mouse-aim "\e[<0;60;15M\e[<35;120;15M" center-pos 1.0 test-dt look-dims)]
    (is (= true (:fire? r)) "the press in the frame still fires")
    (is (php/> (:yaw r) 0.0) "and the move turns the camera")))

(deftest test-mouse-aim-wheel-tick-adds-no-fire
  ;; A scroll-wheel tick (b=64) carries no aim intent: no fire.
  (let [r (mouse-aim "\e[<64;120;15M" center-pos 1.0 test-dt look-dims)]
    (is (= false (:fire? r)) "wheel up does not fire")
    (is (= false (:fire-held? r)) "wheel is not held-fire")))

(deftest test-mouse-aim-right-button-does-not-fire
  (let [r (mouse-aim "\e[<2;60;15M" center-pos 1.0 test-dt look-dims)]
    (is (= false (:fire? r)) "right button is not the fire button")))

(deftest test-mouse-aim-middle-button-does-not-fire
  (let [r (mouse-aim "\e[<1;60;15M" center-pos 1.0 test-dt look-dims)]
    (is (= false (:fire? r)) "middle button is not the fire button")))

(deftest test-mouse-aim-malformed-sequence-ignored
  ;; A truncated report (missing the y field) matches nothing, so the
  ;; pointer stays put (no turn) and nothing fires.
  (let [r (mouse-aim "\e[<35;15M" center-pos 1.0 test-dt look-dims)]
    (is (= 0.0 (:yaw r)) "malformed -> pointer unchanged -> no turn")
    (is (= false (:fire? r)))))

(deftest test-mouse-aim-ignores-kitty-key-event
  ;; A kitty CSI-u KEY event must not be mistaken for a mouse report.
  (let [r (mouse-aim "\e[97;1:1u" center-pos 1.0 test-dt look-dims)]
    (is (= 0.0 (:yaw r)) "kitty key leaves the pointer alone")
    (is (= false (:fire? r)) "kitty key 'a' does not fire")))

(deftest test-mouse-aim-ignores-arrow-and-fkey
  ;; Arrow + F-key escapes are not SGR mouse reports.
  (let [arrow (mouse-aim "\e[C" center-pos 1.0 test-dt look-dims)
        fkey  (mouse-aim "\eOR" center-pos 1.0 test-dt look-dims)]
    (is (= 0.0 (:yaw arrow)) "arrow leaves the pointer alone")
    (is (= false (:fire? arrow)))
    (is (= false (:fire? fkey)))))

(deftest test-mouse-aim-mixed-keyboard-and-mouse-bytes
  ;; A drain holding both WASD bytes and an SGR report: mouse-aim only
  ;; reads the SGR part; the 'w'/'d' are the keyboard path's job.
  (let [r (mouse-aim "w\e[<35;120;15Md" center-pos 1.0 test-dt look-dims)]
    (is (php/> (:yaw r) 0.0) "the embedded report still turns the camera")
    (is (= [120 15] (:pos r)) "pos comes from the SGR part only")))

(deftest test-mouse-aim-bytes-do-not-leak-into-key-parsing
  ;; REGRESSION (the inverse guard): an SGR mouse report fed to the
  ;; keyboard parsers must not be mistaken for movement / fire. The
  ;; report's digits and 'M' must not trip key-states or refresh-move.
  (let [drag "\e[<32;15;10M"
        st   (key-states drag)
        w'   (refresh-from-keys blank-world drag)]
    (is (= false (:sp st)) "no phantom fire from the mouse digits")
    (is (= blank-moves (:moves w')) "no phantom movement from the report")))
