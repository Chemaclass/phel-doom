;; ---------------------------------------------------------------------
;; The play subcommand wires together:
;;   - Terminal IO            (term-size, render!, drain-keys, sleep)
;;   - Per-frame state tick   (tick-world, pure — exported for tests)
;;   - Per-run lifecycle      (run-play → levels, end screens, restart)
;;
;; Per-domain logic (physics, combat, controls) lives in dedicated
;; modules; this file is the orchestration layer.
;; ---------------------------------------------------------------------

(def min-yield-us
  "Floor on the per-iteration usleep so the loop always yields the
   CPU at least briefly, even when the render path already burned
   the full frame budget. Without this a heavy frame would spin
   straight into the next iteration with zero yield."
  1000)

(def menu-frame-us
  "Fixed ~60fps sleep for the static menu / end-screen loops (start,
   death, victory). They don't measure render time + don't share the
   game-loop's iteration timing, so a flat budget is fine — render
   cost is tiny + uniform regardless of terminal size."
  16000)

;; =====================================================================
;; § Terminal IO helpers
;; =====================================================================

(def default-term-size
  "Fallback [rows cols] when stty isn't available (CI, piped input)."
  [24 80])

(defn- parse-stty-line [line]
  (if (or (nil? line) (= line ""))
    nil
    (let [parts (php/explode " " line)]
      [(php/intval (php/aget parts 0))
       (php/intval (php/aget parts 1))])))

(defn- term-size
  "Current terminal [rows cols]. Falls back when stty can't answer."
  []
  (let [out (php/array)]
    (php/exec "stty size 2>/dev/null" out)
    (or (parse-stty-line (php/aget out 0)) default-term-size)))

(def resize-poll-frames
  "How often the loops re-sample `term-size`. Each sample forks + execs
   `stty size` (~1ms + jitter), so polling every frame on a 5ms budget
   is most of the per-frame IO cost yet a resize is a human-timescale
   event. Sampling every Nth frame keeps resize handling responsive
   (re-drawn within ~Nth of a second) while dropping most of the forks.
   12 at the ~120fps game-loop cap matches the same ~100ms wall-clock
   cadence the old value of 6 held at ~60fps. The menu / end-screen
   loops share this constant but still run at menu-frame-us (~60fps),
   so THEIR resize latency doubled to ~200ms - acceptable, a resize is
   a human-timescale event and menus are static."
  12)

(defn poll-size?
  "True when frame `frame` should re-sample `term-size`: the very first
   frame (so initial sizing is never delayed) or every
   `resize-poll-frames`th frame thereafter. Pure so it is unit-testable;
   between samples the loops reuse the last measured [rows cols], which
   `redraw-if-resized` + the auto-calibration already tolerate.

   The frame count is the FALLBACK path since #459: with ext-pcntl the
   loop also samples whenever SIGWINCH says the terminal changed, which
   is the only time the answer differs. A build without ext-pcntl keeps
   this cadence as its only mechanism."
  [frame]
  (or (php/=== frame 0)
      (php/=== 0 (php/% frame resize-poll-frames))))

(def rearm-mouse-frames
  "How often the play loop re-asserts the xterm mouse-reporting escapes
   (#288). A focus loss / regain can silently drop mouse tracking; this
   re-arm catches that without the player noticing. ~1s at the ~120fps cap
   (120, matching the same wall-clock cadence the old value of 60 held at
   ~60fps) is far below a human-noticeable gap yet emits only one short
   idempotent escape burst, so the frame budget is untouched."
  120)

(defn sample-size?
  "Whether this frame should fork `stty size` (#459).

   `winch?` - SIGWINCH fired, so the terminal really did change.
   `armed?` - the SIGWINCH handler is installed, so the signal is a
   complete answer and the frame-count poll is pure overhead.
   `frame`  - the loop's frame counter, for the fallback cadence.

   Frame 0 always samples so initial sizing is never delayed. After that
   an armed loop samples ONLY on the signal, which is the point of the
   change: the fork was ~5ms at 10Hz on an 8.3ms budget, answering a
   question that changes about once a session. Unarmed (no ext-pcntl, or
   a build without SIGWINCH) keeps the old cadence.

   The menu / end-screen loops never read `resized?`, so they keep
   `poll-size?` and their resize latency is unchanged. Pure."
  [winch? armed? ^int frame]
  (or (boolean winch?)
      (php/=== frame 0)
      (and (not armed?) (poll-size? frame))))

(defn rearm-mouse?
  "True when frame `frame` should re-assert the mouse-reporting escapes:
   on a resize (`resized-flag?`, the band where the terminal most often drops
   tracking) or every `rearm-mouse-frames`th frame. Pure / unit-testable;
   the caller still gates the actual emit on the Mouse setting."
  [frame resized-flag?]
  (or resized-flag?
      (php/=== 0 (php/% frame rearm-mouse-frames))))

;; =====================================================================
;; § Per-frame tick orchestration (pure, exported for tests)
;; =====================================================================

(defn- about-face
  "Snap the player's facing by π (180° turn). Triggered by the rising
   edge on the `e` key in the game loop."
  [world]
  (update-in world [:player :angle] (fn [a] (php/+ a php/M_PI))))

(defn apply-mouse-look
  "Apply one frame's mouselook (#324) to the player. `look` is the
   `controls/mouse-aim` result; `:yaw` rotates `:angle` (same path as a
   keyboard turn) and `:pitch` shears `:pitch` clamped to [-1, 1] via
   `clamp-pitch` (same saturation as the ↑/↓ keys). Both come from the
   pointer's per-frame motion (the delta turn) plus the edge-pan fallback,
   so a still pointer in the screen interior (zero yaw/pitch) is a no-op and the
   keyboard look is untouched. Pure; the game loop calls it only on an
   unpaused frame so the camera can't drift while a menu is up."
  [world look]
  (let [yaw   (or (:yaw look) 0.0)
        pitch (or (:pitch look) 0.0)
        w1    (if (php/=== yaw 0.0) world (turn-player world yaw))]
    (if (php/=== pitch 0.0)
      w1
      (update-in w1 [:player :pitch]
                 (fn [p] (clamp-pitch (php/+ (or p 0.0) pitch)))))))

(defn quit-confirmed?
  "True when `q` should end the run outright: only from the pause page
   (menu or its settings sub-page), which is where the question was
   asked (#454).

   `q` used to quit a live run on the spot, one key away from `w`. In
   game it now opens the pause menu on Quit (`arm-quit-menu`), so the
   second press - or Enter on the highlighted row - is the confirmation.
   The start menu and the end screens run their own loops and keep
   quitting on a single `q`.

   The H / ESC info panel also freezes the world, but it is NOT a confirm
   surface: it carries no Quit row, and ESC is the universal back-out key,
   so a `q` there would be the very accident this exists to stop. It arms
   the menu like a live run does.

   On a terminal without kitty release events, HOLDING `q` reaches the
   quit through key autorepeat (arm, then a fresh press edge on the next
   burst). That is deliberate: a held key is not an accident."
  [world quit-request?]
  (and (boolean quit-request?)
       (boolean (:paused world))
       (not (:help? world))))

(defn arm-quit-menu
  "Open the pause menu with the cursor on Quit, so the next `q` (or
   Enter) leaves and anything else is a way back into the run (#454).
   Drops the movement hold counters for the same reason pausing on focus
   loss does: whatever was held when the question came up must not still
   be gliding when the player answers it."
  [world]
  (assoc world
         :paused        true
         :help?         false
         :pause-screen  :menu
         :pause-cursor  (pause-menu-index-of :quit)
         :pause-action  nil
         :pause-confirm nil
         :moves         empty-moves))

(defn- handle-toggles
  "Apply rising-edge toggle keys (pause / minimap / sound / debug /
   help / about-face) for this frame. Debug + help edges stay
   outside the paused short-circuit so F3 / H / ESC still flip
   overlays while paused."
  [world edges]
  (let [;; Focus loss (#454): the terminal reported the window going to
        ;; the background, so freeze the run before the player comes back
        ;; to a corpse. Already-paused worlds are left exactly as they
        ;; are - re-opening the top menu would yank them off the settings
        ;; sub-page they were reading.
        after-focus (if (and (:focus-out edges) (not (:paused world)))
                      (assoc world
                             :paused        true
                             :pause-screen  :menu
                             :pause-cursor  0
                             :pause-action  nil
                             :pause-confirm nil
                             :moves         empty-moves)
                      world)
        ;; `q` in a live run asks instead of quitting (#454): it opens the
        ;; menu on Quit, where a second `q` (or Enter) confirms. A paused
        ;; `q` never reaches here - the game loop quits on it directly.
        after-quit  (if (and (:quit-request edges)
                             (not (quit-confirmed? after-focus true)))
                      (arm-quit-menu after-focus)
                      after-focus)
        after-pause (if (:toggle-pause edges)
                      ;; Pausing ON opens the navigable pause MENU (#203):
                      ;; reset its cursor + screen so P always lands on the
                      ;; top menu, not whatever sub-page was last open.
                      (let [tp (toggle-pause after-quit)]
                        (if (:paused tp)
                          (assoc tp :pause-screen :menu :pause-cursor 0 :pause-action nil
                                 :pause-confirm nil)
                          tp))
                      after-quit)
        after-map   (if (:toggle-map edges) (toggle-map after-pause) after-pause)
        after-sound (if (:toggle-sound edges) (toggle-sound after-map) after-map)
        after-debug (if (:toggle-debug edges) (toggle-debug after-sound) after-sound)
        ;; H + ESC both fire :toggle-help. Couples to pause: opening
        ;; the info menu freezes the game so the player can read it;
        ;; closing un-freezes. If the player already P-paused, then
        ;; H, then H again, the game un-pauses on the second H
        ;; (acceptable — they can re-press P to keep it frozen).
        after-help  (if (:toggle-help edges)
                      (-> after-debug
                          (update :help? not)
                          (assoc :paused (not (:help? after-debug))))
                      after-debug)]
    (if (:about-face edges) (about-face after-help) after-help)))

;; =====================================================================
;; § Settings page (issue #107)
;;
;; The settings page IS the pause screen: pressing P freezes the game
;; AND shows the adjustable options, so there is only one overlay layer
;; to learn (the H info panel stays a separate read-only reference).
;; While paused, the arrows move the cursor / change a value; volumes
;; apply live through the io/sound + io/music atoms and the minimap
;; field mirrors into :show-map. The settings ride on the world under
;; :settings / :settings-cursor so frame-stats can paint them and they
;; carry across level cuts; resuming (P) persists to disk.
;; =====================================================================

(defn- apply-audio-settings!
  "Push the current settings' volumes into the sfx + music layers."
  [settings]
  (set-sfx-scalar!   (sfx-scalar settings))
  (music/set-music-volume! (music-volume settings)))

(defn- step-settings!
  "Apply one frame of pause-page navigation from the raw input `keys`
   via core/settings.navigate: up/down (or W/S) move the cursor,
   left/right (or A/D) adjust the selected field. A held key ramps
   through the OS key-repeat. Volume edits take effect immediately;
   the minimap field mirrors into :show-map so the change shows at once."
  [world keys]
  (let [{:cursor cursor-steps :value value-steps} (nav-deltas keys)
        {:keys [cursor settings adjusted?]}
        (navigate (:settings world) (or (:settings-cursor world) 0) cursor-steps value-steps)]
    (when adjusted? (apply-audio-settings! settings))
    (assoc world
           :settings-cursor cursor
           :settings        settings
           :show-map        (boolean (:minimap settings)))))

(defn step-pause-menu
  "Pure: one frame of pause-MENU navigation (issue #203). up/down (W/S)
   move the cursor; the select edge (space or Enter) resolves the highlighted
   option: `:resume` unpauses here; `:settings` switches to the options
   sub-page; `:restart` / `:quit` are stamped on `:pause-action` for the
   game loop to hand back to the run lifecycle. No select = just move."
  [world cursor-steps select?]
  (let [cursor (pause-menu-move (or (:pause-cursor world) 0) cursor-steps)
        ;; Moving the cursor disarms a pending Restart (#454): the
        ;; confirmation belongs to the row it was asked on.
        moved? (not (php/=== cursor (or (:pause-cursor world) 0)))
        armed  (if moved? nil (:pause-confirm world))
        w      (assoc world :pause-cursor cursor :pause-confirm armed)]
    (if (not select?)
      w
      (let [action (pause-menu-action cursor)]
        (cond
          (= action :resume)   (assoc w :paused false :pause-confirm nil)
          (= action :settings) (assoc w :pause-screen :settings :pause-confirm nil)
          ;; Restart erases the run, and Enter is one keypress away from
          ;; the cursor keys, so the first select only ARMS it (#454);
          ;; hud/pause-menu-string paints the armed row as a question.
          (= action :restart)  (if (= :restart armed)
                                 (assoc w :pause-action :restart :pause-confirm nil)
                                 (assoc w :pause-confirm :restart))
          ;; Quit needs no second ask here: reaching this row is already
          ;; deliberate (navigated to, or `q` which opened the menu on it).
          (= action :quit)     (assoc w :pause-action :quit :pause-confirm nil)
          :else                w)))))

(defn resumed-pause?
  "True when the pause/settings page just closed this frame (was paused,
   now isn't). The cue to persist the player's settings to disk."
  [before after]
  (and (:paused before) (not (:paused after))))

(defn- persist-settings!
  "Write the world's current settings out. Called whenever the player
   leaves the pause/settings page (resume or quit) so edits are never
   lost; volumes were already applied live."
  [world]
  (save-settings! (:settings world)))

(defn- boss-down?
  "True on a boss-locked level once the cyberdemon is dead — combat
   stamps `:boss` into `:held-keys` on the killing blow. Used to stop
   every remaining enemy from respawning so the player's victory lap
   to the exit door isn't ambushed by a fresh boss or revived imp."
  [world]
  (and (= (:door-lock world) :boss)
       (contains? (or (:held-keys world) #{}) :boss)))

(defn- enemy-distance [e ^float px ^float py]
  (let [dx (php/- (:x e) px)
        dy (php/- (:y e) py)]
    (php/sqrt (php/+ (php/* dx dx) (php/* dy dy)))))

(defn- nearest-waker
  ;; The closest enemy that went from :dormant to awake this frame, or
  ;; nil. Compares the two enemy vectors positionally - `advance` maps
  ;; over them in place, so index i is the same monster either side.
  [before after ^float px ^float py]
  (let [es0 (or (:enemies before) [])
        es1 (or (:enemies after) [])]
    (loop [i 0 best nil best-d 9999.0]
      (if (php/>= i (count es1))
        best
        (let [b (get es0 i)
              a (get es1 i)]
          (if (and b a
                   (= :dormant (:state b))
                   (not (= :dormant (:state a)))
                   (:alive a))
            (let [d (enemy-distance a px py)]
              (if (php/< d best-d)
                (recur (php/+ i 1) a d)
                (recur (php/+ i 1) best best-d)))
            (recur (php/+ i 1) best best-d)))))))

(defn- tick-enemies
  "Step every alive enemy one dt-scaled frame toward the player, using
   the world's per-level chase speed. `:pgrid` is forwarded so the
   AI observation pass (enemy-ai) can cast LOS rays from each enemy
   to the player; without it the AI falls through to the legacy
   'always chase' behaviour. Suspends respawns once the boss is down
   on L10 (see boss-down?)."
  [world ^float dt]
  (let [p       (:player world)
        stepped (update world :enemies advance (:grid world) (:pgrid world) (:x p) (:y p) dt
                        (or (:chase-speed world) 0.75)
                        (not (boss-down? world)))]
    ;; Wake cue (#460): a monster noticing you was silent, so the first
    ;; sign of an ambush was taking the hit. One cue for the nearest
    ;; enemy that woke this frame, not one per enemy - a room waking at
    ;; once is one growl, not a chord.
    (if-let [woke (nearest-waker world stepped (:x p) (:y p))]
      (push-sfx stepped (sight-sfx-for (:type woke))
                (distance-volume (enemy-distance woke (:x p) (:y p))))
      stepped)))

(defn- on-door?
  "True when the player's current cell is a door (auto-advances level)."
  [world]
  (let [p (:player world)]
    (door? (:grid world) (php/intval (:x p)) (php/intval (:y p)))))

(defn- cell-ahead
  "Integer (x, y) of the cell the player is facing (one unit ahead
   along `:angle`). Used by F-key handlers (secret reveal, switch
   toggle) to pick the player's interact target."
  [world]
  (let [p (:player world)
        a (:angle p)]
    [(php/intval (php/+ (:x p) (php/cos a)))
     (php/intval (php/+ (:y p) (php/sin a)))]))

(defn- try-reveal-secret
  "Action-key handler: when F was just pressed AND the cell directly
   in front of the player is an unrevealed secret wall, swap that
   cell to floor on the world's grid, drop a reward stash at the
   revealed cell (level/place-secret-reward), and bump `:secrets-found`.
   Plays the door sfx so the reveal is audibly distinct from a wall
   bump. No-op otherwise so other action-bound features (switches,
   etc) chain off the same edge without conflict."
  [world action?]
  (if (not action?)
    world
    (let [[cx cy] (cell-ahead world)]
      (if (secret? (:grid world) cx cy)
        (let [idx (or (:secrets-found world) 0)]
          (push-msg
           (push-sfx
            (-> world
                (assoc :grid (reveal-secret (:grid world) cx cy))
                (rebuild-pgrid)
                (place-secret-reward cx cy idx)
                (update :secrets-found (fn [n] (php/+ (or n 0) 1))))
            :door 1.0)
           "A secret is revealed!"))
        world))))

(defn- try-toggle-switch
  "Action-key handler: when F was just pressed AND the cell directly
   in front of the player is a switch (either state), flip the
   switch glyph + every target cell listed under the matching
   `:switches` entry. Plays the switch throw so the interaction is
   audible and distinct from a door. Chained AFTER `try-reveal-secret` so the two handlers
   never claim the same F-press."
  [world action?]
  (if (not action?)
    world
    (let [[cx cy] (cell-ahead world)]
      (if (switch? (:grid world) cx cy)
        (push-sfx
         (-> world
             (assoc :grid (toggle-switch (:grid world)
                                         (or (:switches world) [])
                                         cx cy))
             (rebuild-pgrid))
         :switch 1.0)
        world))))

(def reload-ready-flash-seconds
  "How long the ' READY! ' HUD cue holds after a reload cooldown
   finishes (the gun goes hot again)."
  0.30)

(defn tick-world
  "Pure one-frame state transition. `keys` is the drained input string,
   `dt` is seconds since the previous tick, `edges` is the rising-edge
   map ({:fire :toggle-map :toggle-pause :toggle-sound :about-face}).
   Physics and AI skip while the world is paused. The pipeline reads
   top-to-bottom: handle one-shots, refresh held-key counters, run
   physics, collect pickups, advance enemies, resolve a shot, decay
   timers + apply contact damage."
  [world keys ^float dt edges]
  ;; Reset the per-frame sfx queue up front so events accumulate fresh
  ;; each tick. Every cue (pickups, interactions, combat) enqueues via
  ;; combat/push-sfx instead of emitting inline, keeping this transform
  ;; pure; the game loop drains `:sfx` after this returns and plays them
  ;; via io/sound, gated on :sound-on.
  (let [w0 (assoc (handle-toggles world edges) :sfx [])]
    (cond
      (:paused w0)                             w0
      ;; Hit-stop: a meaty kill stamped `:hit-stop-secs` last frame.
      ;; Freeze the whole gameplay step (no physics / AI / shooting)
      ;; while it decays so the blow lands with weight. Toggles above
      ;; still work; render keeps drawing the frozen frame (so the
      ;; muzzle flash + blood hold for the duration). ~70ms on a tough
      ;; kill, ~160ms on a boss. See combat/hit-stop-for.
      (php/> (or (:hit-stop-secs w0) 0.0) 0.0)
      (assoc w0 :hit-stop-secs (php/max 0.0 (php/- (:hit-stop-secs w0) dt)))
      ;; Linear pipeline. Each step takes the previous world + its
      ;; own deps and returns a new world. Phel `->` would be nicer
      ;; but the lint pass doesn't macro-expand it (arity-mismatch
      ;; false positives), so stick with sequential let bindings.
      :else
      (let [w1   (refresh-from-keys w0 keys)
            ;; Weapon swap (1-8) routes through weapons/switch-weapon
            ;; — no-op when the player is mid-reload so the lockout
            ;; can't be skipped.
            w1a  (cond
                   (:select-weapon1 edges) (switch-weapon w1 (get weapon-order 0))
                   (:select-weapon2 edges) (switch-weapon w1 (get weapon-order 1))
                   (:select-weapon3 edges) (switch-weapon w1 (get weapon-order 2))
                   (:select-weapon4 edges) (switch-weapon w1 (get weapon-order 3))
                   (:select-weapon5 edges) (switch-weapon w1 (get weapon-order 4))
                   (:select-weapon6 edges) (switch-weapon w1 (get weapon-order 5))
                   (:select-weapon7 edges) (switch-weapon w1 (get weapon-order 6))
                   ;; Wheel / bracket step (#464), after the slot keys so
                   ;; an explicit number always wins.
                   (:next-weapon edges)    (cycle-weapon w1 1)
                   (:prev-weapon edges)    (cycle-weapon w1 -1)
                   :else                   w1)
            ;; Name the weapon on the message line when the swap actually
            ;; took (#456), so a slot press never needs a glance at the
            ;; top-left HUD. A refused swap - unowned slot, mid-reload -
            ;; returns the same weapon and says nothing.
            w1am (if (= (:weapon w1a) (:weapon w1))
                   w1a
                   (push-msg w1a (str (php/strtoupper (name (:weapon w1a)))
                                      " " (or (:mag w1a) 0)
                                      "/" (or (:ammo-reserve w1a) 0))))
            ;; tick-stamina runs BEFORE apply-physics so that, on the
            ;; frame the player's pool empties, the `:sprint-blocked?`
            ;; latch fires before physics samples it — apply-physics
            ;; then walks at base speed instead of getting one final
            ;; 1.6x frame "for free". Drain reads the just-refreshed
            ;; :moves slots (refresh-from-keys above), so the player
            ;; pays for the intent the same frame they signal it.
            ;; First-run hints (#467) retire as soon as the player has
            ;; shown they can move, turn and shoot. `:moves` carries the
            ;; live hold counters, so this reads what they just did.
            w1ah (note-hint-progress
                  w1am
                  (php/> (php/+ (php/+ (or (get-in w1am [:moves :fwd]) 0.0)
                                       (or (get-in w1am [:moves :back]) 0.0))
                                (php/+ (or (get-in w1am [:moves :strafe-left]) 0.0)
                                       (or (get-in w1am [:moves :strafe-right]) 0.0)))
                         0.0)
                  (php/> (php/+ (or (get-in w1am [:moves :turn-left]) 0.0)
                                (or (get-in w1am [:moves :turn-right]) 0.0))
                         0.0)
                  (boolean (:fire edges)))
            w1b  (try-reveal-secret w1ah (:action edges))
            ;; Switch (issue #62): flip the cell glyph + every target
            ;; on the world's :switches metadata. Chained AFTER
            ;; reveal-secret so the F-press never double-fires.
            w1b2 (try-toggle-switch w1b (:action edges))
            ;; Fog-of-war mark: stamp every cell within visit-radius +
            ;; LOS of the player onto :visited so the minimap reveals
            ;; the layout as the player explores. Skipped while paused
            ;; so a paused frame doesn't drift the visible footprint
            ;; from where the player actually is.
            w1c  (mark-visible-cells w1b2)
            w2   (apply-physics (tick-stamina w1c dt) dt)
            ;; Step-on pickups, applied to w2 in order (extend the vector
            ;; to add one; reduce not `->` per the lint note above).
            w4g  (reduce (fn [w f] (f w)) w2
                         [pickup-hearts pickup-armors pickup-armor-shards
                          pickup-ammos pickup-berserks pickup-invulns
                          pickup-soulspheres pickup-backpacks pickup-keycards
                          pickup-weapon-pickups])
            w5   (tick-enemies  w4g dt)
            ;; Casters that released this frame have :fire-now set;
            ;; spawn + march their bolts and resolve player impacts
            ;; before damage-step so a bolt hit and a contact hit can't
            ;; both land in one frame (the bolt's i-frames gate the
            ;; touch test).
            wp   (tick-tracers (tick-projectiles w5 dt) dt)
            ;; Queue the reload sfx only when a reload actually starts
            ;; (reloading? holds on the pre-reload world), routed through
            ;; the :sfx queue so this stays a pure transform like every
            ;; other tick step. The game loop drains + gates on :sound-on.
            w5b  (if (:reload edges)
                   (if (reloading? wp)
                     (push-sfx (reload wp) :reload 0.3)
                     (reload wp))
                   wp)
            w5c  (tick-armory w5b)
            w6   (tick-shooting w5c (:fire edges) (:fire-held edges))
            w7   (damage-step   w6 dt)
            ;; READY flash: damage-step's decay-timers is the sole site
            ;; that ticks :reload-cooldown. If it crossed from >0 to <=0
            ;; this frame the reload just finished and the gun is hot
            ;; again, so stamp the one-shot ' READY! ' HUD cue.
            w7b  (if (and (php/> (or (:reload-cooldown w6) 0.0) 0.0)
                          (php/<= (or (:reload-cooldown w7) 0.0) 0.0))
                   (assoc w7 :reload-ready-secs reload-ready-flash-seconds)
                   w7)
            w8   (tick-heartbeat w7b dt)
            w10  (tick-scare    w8 dt)
            w11  (tick-blood-drops w10 dt)
            w13  (decay-soul-overcap w11 dt)
            ;; Decay the F5/F9 save/load HUD cue (set in game-loop after
            ;; the tick).
            w13b (update w13 :save-flash-secs
                         (fn [s] (php/max 0.0 (php/- (or s 0.0) dt))))
            w13c (update w13b :reload-ready-secs
                         (fn [s] (php/max 0.0 (php/- (or s 0.0) dt))))]
        (advance-game-time w13c dt)))))

;; =====================================================================
;; § Per-frame IO + stats
;; =====================================================================

(defn frame-stats
  "Snapshot of `world` + per-frame timing the render layer needs: the
   render DTO. Public so tests can pin the contract that every
   render-facing setting is actually projected here - a settings row that
   render reads off `stats` but this fn never writes is a toggle that does
   nothing, which is how :truecolor and :quad shipped inert."
  [world fps frame-ms]
  {:fps         fps
   :frame-ms    frame-ms
   :kills       (:kills world)
   :lives       (:lives world)
   :armor       (:armor world)
   :max-lives   max-lives
   :iframes     (:iframes world)
   :shake-secs  (:shake-secs world)
   :fire-anim   (:fire-anim world)
   ;; Crosshair hit-marker FX (issue #201): {:kill? :ttl} or nil. Set in
   ;; the combat step on a connecting shot, decayed each frame.
   :hit-fx      (:hit-fx world)
   :fire-anim-duration fire-anim-seconds
   :intro-secs  (:intro-secs world)
   :flash-secs  (:flash-secs world)
   :fx          (:fx world)
   :paused      (:paused world)
   :level       (:level world)
   :level-name  (:level-name world)
   :hurt-side   (:hurt-side world)
   :hurt-dir    (:hurt-dir world)
   :streak      (:streak world)
   :heat        (:heat world)
   :jam-secs    (:jam-secs world)
   :blood-drops (:blood-drops world)
   :game-time   (or (:game-time world) 0.0)
   :debug?      (:debug? world)
   :perf-stats  (when (:debug? world) (read-perf-snapshot))
   :weapon      (or (:weapon world) :pistol)
   :weapon-name (or (:name (weapon-spec world)) "pistol")
   :palette     (:palette (weapon-spec world))
   :mag         (or (:mag world) 0)
   :mag-size    (or (:mag-size (weapon-spec world)) 10)
   :ammo-reserve (or (:ammo-reserve world) 0)
   :reload-cooldown (or (:reload-cooldown world) 0.0)
   :reload-duration (or (:reload-duration (weapon-spec world)) reload-cooldown-seconds)
   :empty-click-secs (or (:empty-click-secs world) 0.0)
   :berserk-secs (or (:berserk-secs world) 0.0)
   :invuln-secs  (or (:invuln-secs world) 0.0)
   :backpack-level  (backpack-level world)
   :difficulty   (or (:difficulty world) :normal)
   :god?         (boolean (:god? world))
   :help?        (boolean (:help? world))
   :held-keys      (or (:held-keys world) #{})
   :door-lock      (:door-lock world)
   :secrets-total  (or (:secrets-total world) 0)
   :secrets-found  (or (:secrets-found world) 0)
   :locked-door-bump-secs   (or (:locked-door-bump-secs world) 0.0)
   :locked-door-bump-colour (:locked-door-bump-colour world)
   :owned-weapons  (or (:owned-weapons world) #{:pistol})
   :weapon-state   (or (:weapon-state world) {})
   :stamina        (or (:stamina world) max-stamina)
   :max-stamina    max-stamina
   :sprint-blocked? (boolean (:sprint-blocked? world))
   :rear-warning? (rear-attacker? (:enemies world)
                                  (:x (:player world))
                                  (:y (:player world))
                                  (:angle (:player world)))
   ;; Primary enemy type kw — render uses this as the fallback
   ;; visual when a per-enemy `:type` field is missing. Mixed-monster
   ;; rooms still stamp `:type` per enemy at spawn so the renderer
   ;; can branch.
   :enemy                (or (:enemy world) :imp)
   :save-flash-secs      (or (:save-flash-secs world) 0.0)
   :save-flash-msg       (:save-flash-msg world)
   ;; Doom-style message line (#456): what was just picked up / revealed /
   ;; switched to. Render gates on the timer, so the text can stay put.
   ;; Hostile reticle (#458): does a shot fired now connect? Asked through
   ;; the real hitscan selection so the cue can never disagree with the gun.
   :hostile?             (target-in-sights? world)
   :msg-text             (:msg-text world)
   ;; First-run key hints (#467).
   :hint-secs            (or (:hint-secs world) 0.0)
   :msg-secs             (or (:msg-secs world) 0.0)
   :reload-ready-secs    (or (:reload-ready-secs world) 0.0)
   ;; Settings page (issue #107): the pause overlay paints the box from
   ;; these. The page IS the pause screen, so the render layer keys off
   ;; :paused; the cursor + values ride along here.
   :settings             (:settings world)
   :settings-cursor      (or (:settings-cursor world) 0)
   ;; Pause menu (#203): which pause screen is up (:menu top-level options
   ;; vs :settings sub-page) + the menu cursor, so render can paint the
   ;; right overlay.
   :pause-screen         (or (:pause-screen world) :menu)
   :pause-cursor         (or (:pause-cursor world) 0)
   ;; Which menu row is waiting for a second Enter (#454): render paints
   ;; that row as a question instead of its plain label.
   :pause-confirm        (:pause-confirm world)
   ;; Generic HUD-suppression flags (the demo showcase sets them; normal
   ;; play leaves them nil): hide the weapon name/ammo chunk and the
   ;; enemy-themed level label from the top game-info line.
   :hide-weapon?         (boolean (:hide-weapon? world))
   :hide-level-name?     (boolean (:hide-level-name? world))
   ;; UX settings (issue #203): crosshair reticle style + always-on run
   ;; timer in the HUD strip. Both are pure overlay reads.
   :crosshair            (or (:crosshair (:settings world)) :cross)
   :run-timer?           (boolean (:timer (:settings world)))
   ;; Mouselook on flag (#246): the crosshair IS the mouse aim point (no
   ;; visible OS pointer), so paint-crosshair forces a minimal centre dot
   ;; even when the player set Crosshair to :off, so mouse-aiming always has
   ;; an aim indicator.
   :mouse                (boolean (:mouse (:settings world)))
   ;; Movable aim crosshair (#324): the reticle cell the gun aims at, so
   ;; render draws the `+` there. nil (mouse off / not placed) centres it.
   :aim-col              (:aim-col world)
   :aim-row              (:aim-row world)
   ;; Accessibility (issue #200): high-contrast HUD un-dims the dim/grey
   ;; HUD elements (compass, empty hearts, reserve ammo) for low-quality
   ;; terminals.
   :high-contrast?       (boolean (:high-contrast (:settings world)))
   ;; Low detail (perf setting): flatten the wall AND floor interior to
   ;; one sample per cell, trading vertical texture detail for ~11-26%
   ;; render time + ~30-40% bytes on big screens. render reads this key.
   :fast-walls           (boolean (:fast-walls (:settings world)))
   ;; Sub-pixel (compat setting, #332): default ON. OFF picks the
   ;; one-colour-per-cell render path for terminals that draw ▀ half-blocks
   ;; with row seams (macOS Terminal.app). Default-on semantics: only an
   ;; explicit false disables it, so a settings-less fixture stays sub-pixel.
   :subpixel             (not (php/=== false (:subpixel (:settings world))))
   ;; View bob (#411): the walk-cycle head-bob amplitude scalar [0, 1],
   ;; 0 (default) = off. render adds `bob-rows` of the world's `:bob-phase`
   ;; scaled by this to the horizon `pr`, so walls/floor/sky/enemies bob.
   :view-bob             (view-bob-intensity (:settings world))
   ;; Walk-cycle phase (#412): the weapon viewmodel dips + sways on this
   ;; too, scaled by :view-bob. Settles to 0 at rest (byte-identical gun).
   :bob-phase            (or (:bob-phase world) 0.0)
   ;; Room lighting (#418): OFF by default. When on, render folds the
   ;; world's derived :light-grid into the wall shade index.
   :light                (boolean (:light (:settings world)))
   ;; Truecolor + Quad detail: OFF by default. render ANDs each with its
   ;; PHEL_DOOM_* env override. Both ship as options-page rows, so without
   ;; these two projections the player can toggle them and nothing happens -
   ;; only the env forces reached the renderer.
   :truecolor            (boolean (:truecolor (:settings world)))
   :quad                 (boolean (:quad (:settings world)))})

(defn- ms-since
  "Whole-millisecond delta between two microtime samples. Args tagged
   ^float so Phel doesn't infer int from the * 1000 op and implicitly
   downcast a microtime() value at the call site."
  [^float t-then ^float t-now]
  (php/intval (php/* (php/- t-now t-then) 1000)))

(def max-frame-ms
  "Upper bound on a single frame's dt (#278). Real frames run 16-50ms; a
   stall (GC, swap, debugger break) can spike one frame's delta to
   hundreds of ms. Feeding that raw to the pure tick lets `apply-physics`
   translate `move-speed * dt` in one un-swept step, tunnelling the player
   through 1-thick walls / locked doors, and drains every feel timer a
   full step at once. Clamping to 100ms (a ~10fps floor) caps the worst-
   case step well above the real range, so live frames are untouched."
  100)

(defn clamp-frame-ms
  "Cap a raw per-frame millisecond delta at `max-frame-ms` (#278). Pure so
   the clamp is unit-testable; real frames (<= 100ms) pass through
   unchanged, so the live tick / FPS / golden frames stay byte-identical."
  [^int ms]
  (php/min max-frame-ms ms))

(defn- fps-from-ms
  "Instant fps estimate from one frame's ms cost. 0 if delta < 1ms."
  [ms]
  (if (pos? ms) (php/intval (php// 1000.0 ms)) 0))

;; =====================================================================
;; § Per-level result kinds returned by game-loop
;; =====================================================================

;; Per-level run-stat snapshot folded into the cumulative carry by
;; `merge-run-stats`: accuracy counters + secrets found/total (issue #202).
(defn- run-stat-fields [world]
  {:shots-fired    (or (:shots-fired world) 0)
   :shots-hit      (or (:shots-hit world) 0)
   :secrets-found  (or (:secrets-found world) 0)
   :secrets-total  (or (:secrets-total world) 0)
   :damage-taken   (or (:damage-taken world) 0)
   :kills-by-weapon (or (:kills-by-weapon world) {})})

(defn- result-end
  "Terminal per-level result map for a run that has ended. `flag` is
   the kind tag (`:game-over` or `:victory`) set to true alongside the
   shared kills / level / survival-time fields + run-stat carry."
  [flag world ^float t-start ^float now]
  (merge
   {flag        true
    :kills      (:kills world)
    :level      (:level world)
    :level-name (:level-name world)
    :survived-s (php/intval (php/- now t-start))}
   (run-stat-fields world)))

(defn- result-next-level [world ^float t-start ^float now]
  ;; Everything that survives the level cut goes through this map:
  ;; lives, kills, time, backpack, owned weapons, AND the active
  ;; weapon slot + per-weapon mag/reserve so reloads don't reset
  ;; when stepping through the door.
  (let [active (or (:weapon world) :pistol)
        stash  (or (:weapon-state world) {})
        ;; Mirror the active weapon's live :mag / :ammo-reserve back
        ;; into the stash so the snapshot we pass to the next level
        ;; is self-consistent.
        stash' (assoc stash active
                      {:mag     (or (:mag world) 0)
                       :reserve (or (:ammo-reserve world) 0)})]
    (merge
     {:next-level    true
      :level         (php/+ (:level world) 1)
      :kills         (:kills world)
      :lives         (:lives world)
      :backpack-level (backpack-level world)
      :owned-weapons  (or (:owned-weapons world) #{:pistol})
      :weapon        active
      :weapon-state  stash'
      ;; User-preference toggles also follow the player through the
      ;; door — turning the minimap off / muting sound should NOT
      ;; reset every level cut.
      :show-map      (boolean (:show-map world))
      :sound-on      (boolean (:sound-on world))
      ;; Settings edited mid-run carry to the next level so the options
      ;; page keeps showing the player's current choices.
      :settings      (:settings world)
      :survived-s    (php/intval (php/- now t-start))}
     ;; Accuracy + secrets accumulate across the level cut (issue #202).
     (run-stat-fields world))))

(defn- play-door-sfx [world]
  (when (:sound-on world) (play-sfx! :door)))

(defn- door-result
  "When the player steps on a door: either victory (final level) or
   the next-level result."
  [world ^float t-start ^float now]
  (play-door-sfx world)
  (if (php/>= (:level world) num-levels)
    (result-end :victory world t-start now)
    (result-next-level world t-start now)))

;; =====================================================================
;; § Game loop (one level)
;; =====================================================================

(defn- redraw-if-resized [dims rows cols]
  (when (not= [rows cols] dims) (clear-screen)))

(defn- draw-frame [world fps frame-ms rows cols px2?]
  (render! world (assoc (frame-stats world fps frame-ms) :px2? px2?)
           cols rows))

(defn- adaptive-sleep!
  "Yield the CPU for whatever's left of the per-iteration budget,
   never less than min-yield-us. Budget comes from target-frame-us,
   a uniform ~120fps target at every terminal size: when render fits
   the budget the loop sleeps the remainder (steady 120fps); when a
   heavy big-screen frame overruns, `remaining` goes negative and the
   sleep floors at min-yield-us, so framerate degrades smoothly toward
   render-native instead of snapping to a 30fps ceiling.

   `render-start-s` is the microtime captured immediately before the
   render call (NOT the start of the whole loop iteration); the
   intent is to charge sleep against draw cost so input drain + tick
   stay outside the budget window."
  [^float render-start-s ^int cols ^int rows]
  (let [elapsed-us (php/intval (php/* (php/- (php/microtime true) render-start-s) 1000000.0))
        budget     (target-frame-us cols rows)
        remaining  (php/- budget elapsed-us)]
    (php/usleep (php/max min-yield-us remaining))))

(def quick-save-slot
  "Slot F5/F9 quick-save + quick-load use. Slots 1-9 exist in
   io/savegame; the in-game keys drive slot 1 for now."
  1)

(def save-flash-seconds
  "How long the SAVED / LOADED HUD cue holds after F5 / F9."
  1.2)

(defn adopt-loaded-world
  "Pure: graft a quick-loaded `loaded` world onto the live session,
   carrying the CURRENT world's `:settings` + `:settings-cursor` (#279).
   Settings are session-global preference, not run state, so a load must
   keep the live choices rather than the snapshot baked into the save -
   otherwise the load reverts settings and the next resume persists the
   stale copy."
  [current loaded]
  (assoc loaded
         :settings (:settings current)
         :settings-cursor (:settings-cursor current)))

(defn- handle-save-load
  "F5 saves the current world to the quick-save slot; F9 loads it back
   (swapping the whole world). Both stamp a brief `:save-flash-*` HUD
   cue. File IO lives here in the loop, never in the pure tick."
  [world edges]
  (cond
    (:save edges)
    (let [ok (save-game! world quick-save-slot)]
      (assoc world :save-flash-secs save-flash-seconds
             :save-flash-msg (if ok "SAVED" "SAVE FAILED")))
    (:load edges)
    (let [loaded (load-game quick-save-slot)]
      (if loaded
        (assoc (adopt-loaded-world world loaded)
               :save-flash-secs save-flash-seconds :save-flash-msg "LOADED")
        (assoc world :save-flash-secs save-flash-seconds :save-flash-msg "NO SAVE")))
    :else         world))

(defn- next-cal
  "Advance the auto pixel-scale calibration. `cal` is
   {:px 1|2|nil :n int :best ms :tdims [trows tcols]}. In auto mode the
   first `auto-cal-frames` frames render at full detail; this tracks the
   min render-ms across them (warm, least-noisy) and locks the pixel
   scale once enough land (1 = full detail, 2 = pixel-doubled for a
   smooth framerate; the render always fills the whole terminal either
   way). Pixel scale 2 is only ever picked on a big screen (area beyond
   200×45, see perf/big-screen?) — smaller terminals keep full detail
   regardless of the measured cost. A terminal-size change restarts
   calibration so the choice re-fits the new size. No-op when auto is
   off (the player set an explicit --max-cols/--max-rows)."
  [cal auto? ^int trows ^int tcols ^float render-ms]
  (if (not auto?)
    cal
    (let [tdims [trows tcols]]
      (cond
        (not= tdims (:tdims cal)) {:px nil :n 1 :best render-ms :tdims tdims}
        (:px cal)                 cal
        :else
        (let [n'    (php/+ (:n cal) 1)
              best' (php/min (:best cal) render-ms)]
          (if (php/>= n' auto-cal-frames)
            {:px (auto-pixel-scale best' tcols trows) :n n' :best best' :tdims tdims}
            {:px nil :n n' :best best' :tdims tdims}))))))

(defn- game-loop [world0 max-rows max-cols]
  (let [t-start (php/microtime true)
        ;; Auto mode: neither --max-cols nor --max-rows was passed (both
        ;; -1). The loop renders at full detail for a few frames,
        ;; measures, then locks the pixel scale that holds a smooth frame
        ;; budget (see next-cal / auto-pixel-scale) — the render fills
        ;; the whole terminal either way, and only a big screen (beyond
        ;; 200×45) may pixel-double; smaller terminals keep full detail.
        ;; An explicit cap (or 0 = fill) opts out: full detail at the
        ;; player's size.
        auto?   (and (php/< max-cols 0) (php/< max-rows 0))]
    (loop [world      world0
           t-last     t-start
           frame-ms   0
           fps        0
           prev-keys  initial-key-snapshot
           dims       [0 0]
           cal        {:px nil :n 0 :best 1.0e9 :tdims [0 0]}
           ;; Cached pointer position positional mouselook (#318) steers
           ;; from. nil until the first SGR report or until seeded to the
           ;; terminal CENTER below (a centered pointer steers zero, so the
           ;; camera never spins before a real report). Threaded like
           ;; prev-keys.
           prev-mpos  nil
           ;; Frame counter + last raw terminal [trows tcols], threaded so
           ;; the per-frame `stty size` fork only runs on poll frames
           ;; (issue #280); other frames reuse the last dims. Named
           ;; `poll-frame` (not `frame`) to avoid shadowing the demo frame
           ;; map bound lower in the loop body.
           poll-frame 0
           tdims-last [0 0]]
      ;; Manual --max-cols/--max-rows still inset-cap the render area;
      ;; auto mode always fills the terminal (cap-dims with -1 = no-op)
      ;; and varies pixel detail instead.
      ;; SIGWINCH first: `resized?` clears the flag, so it must be asked
      ;; every frame rather than short-circuited by the frame count.
      (let [winch?        (resized?)
            [trows tcols] (if (sample-size? winch? (resize-armed?) poll-frame)
                            (term-size)
                            tdims-last)
            [rows cols]   (cap-dims trows tcols max-rows max-cols)
            px2?          (and auto? (php/=== 2 (:px cal)))]
        (redraw-if-resized dims rows cols)
        ;; Re-arm mouse reporting (#288) on a resize or on the periodic
        ;; cadence so pointer reports recover after a focus loss / regain.
        ;; Gated on the Mouse setting so an opted-out player is untouched.
        (when (and (:mouse (:settings world))
                   (rearm-mouse? poll-frame (not= [rows cols] dims)))
          (rearm-mouse!))
        (let [render-start (php/microtime true)
              _draw        (draw-frame world fps frame-ms rows cols px2?)
              render-ms    (php/* (php/- (php/microtime true) render-start) 1000.0)
              _sleep       (adaptive-sleep! render-start cols rows)
              cal'         (next-cal cal auto? trows tcols render-ms)]
          (let [live-keys (drain-keys)
                now       (php/microtime true)
                ;; Clamp the raw per-frame dt (#278) so one stalled frame
                ;; can't translate the player a full move-speed*dt step in
                ;; the un-swept physics tick (tunnelling through 1-thick
                ;; walls / locked doors) or drain every feel timer at once.
                live-ms   (clamp-frame-ms (ms-since t-last now))
              ;; Input source: live terminal, or — under demo record /
              ;; replay — the recorder taps the stream / the player
              ;; feeds recorded frames (issue #64). A replay that runs
              ;; out of frames sets `:end?` and the cond below quits.
                frame     (demo/resolve-frame! live-keys live-ms)
                keys      (or (:keys frame) "")
                ms        (or (:ms frame) live-ms)
                now-keys  (key-states keys)
                edges0    (rising-edges now-keys prev-keys)
                ;; Mouselook (#324): parse the same drained byte string for
                ;; SGR mouse reports. The crosshair is fixed dead-centre
                ;; (`:aim-col`/`:aim-row` nil) and the gun fires straight
                ;; ahead; `:yaw`/`:pitch` turn the CAMERA from the pointer's
                ;; per-frame motion (applied before the tick so the frame
                ;; renders with the new heading). A left click ORs into the
                ;; existing space-fire edges so a mouse click shoots exactly
                ;; like space (held button feeds auto-fire weapons). `:pos`
                ;; threads forward as the next frame's cached pointer; seed it
                ;; to nil at game start AND on a resize so the first frame
                ;; re-baselines (zero delta) instead of jolting the view from
                ;; a stale or coordinate-shifted position. The live `[rows
                ;; cols]` gives mouse-aim the axis lengths the delta scaling +
                ;; edge band need; `(ms / 1000.0)` is this frame's dt in
                ;; seconds, so the edge-pan rate (per-second) stays frame-
                ;; rate independent at any cap.
                mouse-on? (boolean (:mouse (:settings world)))
                mpos      (if (not= [rows cols] dims) nil prev-mpos)
                look      (mouse-aim keys mpos
                                     (mouse-sensitivity (:settings world))
                                     (php// ms 1000.0)
                                     [rows cols])
                ;; Wheel ticks are weapon steps (#464): the same drained
                ;; byte string, read for scroll reports the aim path
                ;; deliberately ignores. Brackets already arrive as edges.
                wheel     (wheel-weapon-step keys)
                edges     (assoc edges0
                                 :fire      (or (:fire edges0) (:fire? look))
                                 :fire-held (or (:fire-held edges0) (:fire-held? look))
                                 :next-weapon (or (:next-weapon edges0) (php/=== 1 wheel))
                                 :prev-weapon (or (:prev-weapon edges0) (php/=== -1 wheel)))]
            (cond
            ;; Quitting straight from the pause/settings page still
            ;; persists edits (q never hits the resume transition).
              ;; interrupted? also runs the pending-signal dispatch, so this
              ;; is the one frame checkpoint where SIGINT / SIGTERM lands.
              ;; Quitting here unwinds through run-play's finally, so a
              ;; Ctrl-C restores the terminal exactly like pressing q.
              (or (:end? frame)
                  (quit-confirmed? world (:quit-request edges))
                  (interrupted?))
              (do (when (:paused world) (persist-settings! world))
                  :quit)

              :else
              ;; Stamp the scene height AND width the renderer will use this
              ;; frame so the hitscan gates project against the exact view the
              ;; player sees: `:scene-rows` for the vertical gate (#243),
              ;; `:scene-cols` (= the cast width vw) for the off-centre
              ;; reticle-column aim (#324). Same `:debug?`-aware HUD
              ;; reservation as draw-frame's frame-stats, so the hit check and
              ;; the draw agree.
              (let [scened   (assoc world
                                    :scene-rows (scene-rows rows {:debug? (:debug? world)})
                                    :scene-cols cols)
                    ;; Crosshair fixed dead-centre (#324 mouselook): the
                    ;; reticle is always centred (reset-reticle's nil
                    ;; sentinel), so the hitscan fires dead ahead and the `+`
                    ;; sits centre, exactly like keyboard-only play. The mouse
                    ;; contributes the camera turn (yaw/pitch) below, not a
                    ;; reticle cell - applied BEFORE the tick so this frame
                    ;; renders + fires with the new heading, gated on not
                    ;; paused so a menu can't drift the view.
                    reticled (reset-reticle scened)
                    aimed    (if (and mouse-on? (not (:paused world)))
                               (apply-mouse-look reticled look)
                               reticled)
                    ticked0  (tick-world aimed keys (php// ms 1000.0) edges)
                  ;; Pause overlay (#203): while paused (and not in the H
                  ;; info panel) the navigable pause MENU is up. up/down move
                  ;; the cursor, enter/space selects. Selecting Settings drops
                  ;; into the options sub-page (same nav); enter/space backs
                  ;; out to the menu. tick-world already froze gameplay,
                  ;; so this only drives menu/settings state.
                    ticked   (cond
                               (not (and (:paused ticked0) (not (:help? ticked0))))
                               ticked0
                               (= (:pause-screen ticked0) :settings)
                               (let [s (step-settings! ticked0 keys)]
                                 (if (:confirm edges) (assoc s :pause-screen :menu) s))
                               :else
                               (step-pause-menu ticked0 (:cursor (nav-deltas keys)) (:confirm edges)))
                  ;; F5 / F9 quick-save / load run here (file IO),
                  ;; outside the pure tick. Load swaps the whole world;
                  ;; both stamp a brief HUD flash so the player sees it
                  ;; took.
                    world'   (handle-save-load ticked edges)]
              ;; Resuming out of the pause/settings page persists the
              ;; player's choices (volumes were already applied live).
                (when (resumed-pause? world world')
                  (persist-settings! world'))
              ;; Drain the per-frame combat sfx queue that core/combat
              ;; built (gun reports, kill cues, pain, dry-fire clicks).
              ;; core/ stays effect-free; emission lives here, gated on
              ;; :sound-on like every other cue.
                (when (:sound-on world')
                  (doseq [ev (:sfx world')]
                    (play-sfx! (:name ev) (:vol ev))))
                (when (and (:heartbeat-tick? world') (:sound-on world'))
                  (play-sfx! :heartbeat 0.35))
                (when (and (:silence-tick? world') (:sound-on world'))
                  (mute-for! 0.4))
              ;; N toggled sound this frame: start / stop the OST loop
              ;; to match. Comparing the flag (not the edge) also
              ;; catches any other path that flips :sound-on.
                (when (php/!== (:sound-on world) (:sound-on world'))
                  (music/sync-music! (:sound-on world')))
              ;; Pause the OST in lockstep with the game: SIGSTOP it on
              ;; pause so it resumes exactly where it left off on unpause.
              ;; Comparing the flag (not an edge) covers every pause path
              ;; (P menu, H info panel, menu Resume). Both calls no-op when
              ;; the loop isn't running.
                (when (php/!== (:paused world) (:paused world'))
                  (if (:paused world')
                    (music/pause-music!)
                    (music/resume-music!)))
                (cond
                  ;; Pause-menu Quit / Restart (#203): hand the run
                  ;; lifecycle the same signals the end screen uses. Persist
                  ;; settings first (Quit never hits the resume transition).
                  (= (:pause-action world') :quit)
                  (do (persist-settings! world') :quit)
                  (= (:pause-action world') :restart)
                  (do (persist-settings! world') :restart)
                  (php/<= (:lives world') 0)          (result-end :game-over world' t-start now)
                  (on-door? world')                   (door-result      world' t-start now)
                  :else                               (recur world' now ms
                                                             (fps-from-ms ms)
                                                             now-keys
                                                             [rows cols]
                                                             cal'
                                                             (:pos look)
                                                             (php/+ poll-frame 1)
                                                             [trows tcols]))))))))))

;; =====================================================================
;; § End screens (death / victory)
;; =====================================================================

(defn- end-loop
  "Render an end screen each frame until the user picks:
     q  quit
     r  restart with a fresh random seed (new maps)
     R  restart with the SAME random seed (same map sequence) —
        useful when the player wants a replay attempt at a tough
        spawn or wall layout.
   `render-fn` takes (cols rows) and draws the variant."
  [render-fn]
  (loop [dims       [0 0]
         frame      0
         tdims-last [0 0]]
    (let [[rows cols] (if (poll-size? frame) (term-size) tdims-last)]
      (redraw-if-resized dims rows cols)
      (render-fn cols rows)
      (php/usleep menu-frame-us)
      (let [keys (drain-keys)]
        (cond
          (or (str/contains? keys "q") (interrupted?)) :quit
          (str/contains? keys "R")                     :restart-same
          (str/contains? keys "r")                     :restart
          :else                                        (recur [rows cols] (php/+ frame 1) [rows cols]))))))

(defn- death-loop [kills survived-s level level-name scores summary]
  (end-loop (fn [cols rows]
              (render-death-screen cols rows kills survived-s level level-name scores summary))))

(defn- victory-loop [kills survived-s level level-name scores summary]
  (end-loop (fn [cols rows]
              (render-victory-screen cols rows kills survived-s level level-name scores summary))))

;; =====================================================================
;; § Run lifecycle (level chain + restart)
;; =====================================================================

(def- empty-run-stats
  ;; Cumulative run counters carried across levels (issue #202): total
  ;; shots fired / hit, secrets found / total, HP damage taken, and a
  ;; per-weapon kill tally. Reset on restart.
  {:fired 0 :hit 0 :secrets-found 0 :secrets-total 0 :dmg 0 :kbw {}})

(defn- merge-run-stats [carry result]
  ;; Accumulate every per-level snapshot so the end screen reports the
  ;; whole run: total shots, total secrets found out of total available,
  ;; total HP lost, and per-weapon kills summed across levels.
  {:fired         (php/+ (:fired carry)         (or (:shots-fired result) 0))
   :hit           (php/+ (:hit carry)           (or (:shots-hit result) 0))
   :secrets-found (php/+ (:secrets-found carry) (or (:secrets-found result) 0))
   :secrets-total (php/+ (:secrets-total carry) (or (:secrets-total result) 0))
   :dmg           (php/+ (:dmg carry)           (or (:damage-taken result) 0))
   :kbw           (reduce-kv (fn [m w n] (assoc m w (php/+ (or (get m w) 0) n)))
                             (:kbw carry)
                             (or (:kills-by-weapon result) {}))})

(defn- carry-on [carry-kills carry-time carry-stats result]
  [(php/+ carry-kills (:kills result))
   (php/+ carry-time  (:survived-s result))
   (merge-run-stats carry-stats result)])

(defn- run-summary
  "End-of-run summary panel data (issue #202): accuracy percentage,
   secrets found/total, HP damage taken, the per-weapon kill tally, and
   the letter grade from `run-grade`. Pure."
  [stats]
  (let [acc (accuracy-pct (:fired stats) (:hit stats))]
    {:accuracy        acc
     :secrets-found   (:secrets-found stats)
     :secrets-total   (:secrets-total stats)
     :damage-taken    (:dmg stats)
     :kills-by-weapon (:kbw stats)
     :grade           (run-grade (php// acc 100.0)
                                 (:secrets-found stats)
                                 (:secrets-total stats))}))

(defn- maybe-restart
  "Run the end-loop and pass the raw choice (:quit / :restart /
   :restart-same) back to run-levels so it can branch on which kind
   of restart the player asked for."
  [end-fn kills survived-s level level-name scores summary]
  (clear-screen)
  (let [choice (end-fn kills survived-s level level-name scores summary)]
    (clear-screen)
    choice))

(defn- handle-end
  "Show the end screen for `end-fn` (death or victory), persist the
   bests, and translate the player's choice into a vector that
   run-levels can match on:
     [:quit]              quit out
     [:fresh]             restart with a fresh PRNG seed
     [:same seed]         restart re-using the saved seed
   Anything else returns [:quit]. `summary` is the run accuracy/grade
   panel data (issue #202)."
  [end-fn k t summary result seed victory?]
  (let [choice (maybe-restart end-fn k t
                              (:level result)
                              (:level-name result)
                              (update-scores! k (:level result) t victory?)
                              summary)]
    (cond
      (= choice :restart-same) [:same seed]
      (= choice :restart)      [:fresh]
      :else                    [:quit])))

(defn restart-show-map?
  "Initial minimap visibility for a (re)started run: the persisted
   `:minimap` setting, coerced to a strict boolean. The loop entry and
   every restart recur seed `show-map?` through this so a restart honors
   Minimap=off instead of forcing the overlay on (issue #292)."
  [settings]
  (boolean (:minimap settings)))

(defn retry-loadout
  "What a death-screen retry (`r` / `R`) re-enters the level with: the
   rack the player ENTERED that level carrying, never the one they died
   holding (#453).

   Before this, both retry branches recurred with `#{:pistol}` and
   backpack 0, so dying on L7 restarted L7 with the pistol against
   archviles - unwinnable, since kill loot only refills weapons already
   owned (docs/combat.md) and a level seeded only its own debut weapon.

   Entry, not death, for determinism: `build-world` seeds weapon pickups
   from the owned set and draws their cells from the run's PRNG BEFORE the
   ammo boxes, so a retry that owned one weapon more would draw one cell
   fewer and shift every later spawn. `R` promises an identical replay
   (docs/game-loop.md), and entry values are the ones the level was built
   from, so rebuilding with them is identical by construction. A weapon
   grabbed during the fatal attempt is back on the floor where it was.

   Ammo is not carried either: the caller passes a nil weapon-state, so
   build-world seeds fresh mags and reserves. Kills, time and lives still
   reset - a retry is a fresh attempt at the level, not a checkpoint."
  [owned bp-level weapon]
  {:owned-weapons  (or owned #{:pistol})
   :backpack-level (or bp-level 0)
   :weapon         (or weapon :pistol)})

(defn- run-levels
  "Outer loop driving one full run. Each iteration captures a fresh
   PRNG seed before calling build-world so the player can replay the
   SAME map sequence by hitting R on an end screen (fresh seed = lower
   r, same seed = capital R). Lives + kills + time carry across
   levels; death/victory both update the persisted scores file.

   `diff` is the difficulty keyword from --difficulty (or nil for
   :normal). `god?` (from --god) stamps :god? on
   every freshly-built world so combat/vulnerable? short-circuits
   contact damage for the whole run. `armory?` (from --armory / -a)
   hands the player every weapon at spawn and the per-frame ammo
   refill in combat/tick-armory keeps the pool topped up so every
   weapon stays testable without grinding for boxes. `start-level`
   (from --level / -l) sets where the run begins — 1..num-levels,
   clamped. A death retry re-enters the level you died on with the
   loadout carried (`retry-loadout`); a victory restart resets to L1
   with a fresh rack (the start-level only seeds
   the initial loop entry). `demo-phase` (nil for normal play, 1..4 for
   the tech-talk showcase) applies a per-phase world transform after
   build-world (see phel-doom.demo.phases/apply-phase). `max-rows` /
   `max-cols` (from --max-rows / --max-cols; -1 = unset → auto
   pixel-scale, 0 = fill at full detail, N = fixed inset cap) clamp the
   per-frame render size. In auto mode the render always fills the
   terminal: the game-loop measures the machine and pixel-doubles the
   scene when full detail can't hold a smooth framerate."
  [diff god? armory? full-map? demo-phase start-level init-seed init-settings
   max-rows max-cols]
  (loop [level       (php/max 1 (php/min num-levels (or start-level 1)))
         lives       max-lives
         carry-kills 0
         carry-time  0
         carry-stats empty-run-stats
         seed        init-seed
         ;; Backpack stack carried across levels (0..max-backpacks).
         ;; Was a boolean before #68 part 3 - swapped to an int so
         ;; each pickup adds one base's reserve cap.
         bp-level    0
         ;; --armory owns EVERY weapon (README: "own every weapon");
         ;; derive from weapon-order so a new slot is covered for free.
         owned       (if armory? (set weapon-order) #{:pistol})
         ;; Active weapon + per-weapon mag/reserve stash carried
         ;; across level cuts so the player doesn't get reset to a
         ;; full pistol every door. Nil weapon = use build-world's
         ;; default (pistol).
         weapon      nil
         wstate      nil
         ;; Minimap starts in the settings-page default; sound starts on.
         show-map?   (restart-show-map? init-settings)
         sound-on?   true
         ;; Live settings map carried across levels so the options page
         ;; reflects mid-run edits; restarts reset to the loaded value.
         settings    init-settings]
    (rng/seed! seed)
    (let [w0     (build-world level lives bp-level diff owned)
          ;; God mode + carried user toggles + weapon ammo are
          ;; overlaid on the freshly-built world so build-world
          ;; stays purely about the level itself.
          w1     (if god? (assoc w0 :god? true) w0)
          w1a    (if armory? (assoc w1 :armory? true) w1)
          w1b    (if full-map? (assoc w1a :full-map? true) w1a)
          w2     (assoc w1b :show-map show-map? :sound-on sound-on?
                        :settings settings :settings-cursor 0)
          w3     (if (nil? weapon)
                   w2
                   (let [stash  (or wstate (:weapon-state w2))
                         active weapon
                         loaded (get stash active
                                     {:mag (or (:mag w2) 0)
                                      :reserve (or (:ammo-reserve w2) 0)})]
                     (assoc w2
                            :weapon       active
                            :weapon-state stash
                            :mag          (:mag loaded)
                            :ammo-reserve (:reserve loaded))))
          ;; Tech-talk showcase: strip subsystems this phase hasn't
          ;; revealed yet. Pure world->world; no-op for normal play.
          w3d    (if demo-phase (showcase/apply-phase demo-phase w3) w3)
          result (game-loop w3d max-rows max-cols)]
      (cond
        (= result :quit)
        nil

        ;; Pause-menu Restart (#203): restart the whole run from L1 with a
        ;; fresh seed, same reset as a fresh end-screen restart.
        (= result :restart)
        (recur 1 max-lives 0 0 empty-run-stats (rng/fresh-seed) 0 #{:pistol} nil nil (restart-show-map? init-settings) true init-settings)

        (and (map? result) (:next-level result))
        ;; Stamina + sprint-cooldown + :sprint-blocked? are deliberately
        ;; NOT carried across the door — stepping into the next level
        ;; counts as a breather, the pool refills to max via new-world.
        ;; Lives, weapons, mag/reserve and player toggles do carry.
        (let [[k t stats] (carry-on carry-kills carry-time carry-stats result)]
          (recur (:level result) (:lives result) k t stats (rng/next-raw!)
                 (backpack-level result)
                 (or (:owned-weapons result) #{:pistol})
                 (or (:weapon result) :pistol)
                 (or (:weapon-state result) {})
                 (boolean (:show-map result))
                 (boolean (:sound-on result))
                 (or (:settings result) init-settings)))

        (and (map? result) (:victory result))
        (let [[k t stats]     (carry-on carry-kills carry-time carry-stats result)
              [kind new-seed] (handle-end victory-loop k t (run-summary stats) result seed true)]
          (cond
            (= kind :fresh) (recur 1 max-lives 0 0 empty-run-stats (rng/fresh-seed) 0 #{:pistol} nil nil (restart-show-map? init-settings) true init-settings)
            (= kind :same)  (recur 1 max-lives 0 0 empty-run-stats new-seed 0 #{:pistol} nil nil (restart-show-map? init-settings) true init-settings)
            :else           nil))

        (and (map? result) (:game-over result))
        (let [[k t stats]     (carry-on carry-kills carry-time carry-stats result)
              [kind new-seed] (handle-end death-loop k t (run-summary stats) result seed false)
              died-on         (or (:level result) 1)
              ;; The rack survives the death screen (#453); the ammo does
              ;; not - a nil weapon-state means build-world seeds fresh
              ;; mags for the gun that comes back in hand. Fed from THIS
              ;; iteration's bindings (what the level was built with), not
              ;; from `result` (what the player died holding), so the
              ;; same-seed replay rebuilds the identical level.
              kit             (retry-loadout owned bp-level weapon)]
          (cond
            ;; r: try the level you died on again with a fresh map.
            (= kind :fresh) (recur died-on max-lives 0 0 empty-run-stats (rng/fresh-seed) (:backpack-level kit) (:owned-weapons kit) (:weapon kit) nil (restart-show-map? init-settings) true init-settings)
            ;; R: replay the exact level you died on (same seed + same
            ;; level number reproduces identical geometry + enemies).
            (= kind :same)  (recur died-on max-lives 0 0 empty-run-stats new-seed (:backpack-level kit) (:owned-weapons kit) (:weapon kit) nil (restart-show-map? init-settings) true init-settings)
            :else           nil))

        :else
        nil))))

(defn- print-credits []
  (println)
  (println (str "  \e[1mphel-doom\e[0m \e[2mv" version "\e[0m  by \e[1mChemaclass\e[0m  https://github.com/Chemaclass/phel-doom"))
  (println "  written in \e[1mPhel Lang\e[0m  https://phel-lang.org/")
  (println))

(defn- settings-screen!
  "Interactive settings sub-loop reached from the start menu (s).
   Renders the standalone options screen and edits `settings0` until
   the player presses ESC to go back. Arrows or WASD navigate (held
   keys ramp); volume edits apply live; the final map is persisted and
   returned so the caller starts the run with the player's choices."
  [settings0]
  (loop [settings   settings0
         cursor     0
         prev       initial-key-snapshot
         dims       [0 0]
         frame      0
         tdims-last [0 0]]
    (let [[rows cols] (if (poll-size? frame) (term-size) tdims-last)]
      (redraw-if-resized dims rows cols)
      (render-settings! cols rows settings cursor)
      (php/usleep menu-frame-us)
      (let [keys     (drain-keys)
            now      (key-states keys)
            ;; Naked-ESC edge: key-states folds ESC into the h-aliased
            ;; info panel in game, but this pre-game screen just needs
            ;; "did ESC go down this frame" to go back.
            esc-edge (and (:esc now) (not (:esc prev)))]
        (if (or esc-edge (interrupted?))
          ;; Volumes were applied live on each adjust; close just saves.
          ;; An interrupt closes the page the same way ESC does - the flag
          ;; stays set, so the menu loop above quits on its next frame.
          (save-settings! settings)
          ;; Destructure into NON-loop names: binding the result back to
          ;; locals called `settings` / `cursor` (the loop vars) makes the
          ;; recur re-bind the loop's ORIGINAL values, silently dropping
          ;; every edit. Use `nav` + accessors so the recur threads the
          ;; navigated map forward.
          (let [{:cursor cursor-steps :value value-steps} (nav-deltas keys)
                nav                                       (navigate settings cursor cursor-steps value-steps)]
            (when (:adjusted? nav) (apply-audio-settings! (:settings nav)))
            (recur (:settings nav) (:cursor nav) now [rows cols] (php/+ frame 1) [rows cols])))))))

(defn- start-pressed?
  "True when `keys` carries an ENTER / Return (raw mode sends CR; some
   terminals send LF). Space also starts, as a forgiving second key."
  [keys]
  (or (str/contains? keys "\r")
      (str/contains? keys "\n")
      (str/contains? keys " ")))

(defn- show-start-menu!
  "Block on the start screen until the player acts. Re-draws each frame
   so terminal resizes don't leave a stale half-painted box. ENTER (or
   space) starts; `s` opens settings (returning here after); `q` quits.
   Other keys are ignored so a stray arrow can't launch the run by
   accident. Returns :quit, or the (possibly edited) settings map."
  [settings0]
  (loop [settings   settings0
         dims       [0 0]
         frame      0
         tdims-last [0 0]]
    (let [[rows cols] (if (poll-size? frame) (term-size) tdims-last)]
      (redraw-if-resized dims rows cols)
      (render-start-menu cols rows (pointer-limit-notice (terminal-program)))
      (php/usleep menu-frame-us)
      (let [keys (drain-keys)]
        (cond
          ;; Ctrl-C must work here too: install-signal-handlers! replaces
          ;; the default terminate disposition process-wide, so a menu
          ;; that never dispatches would swallow the signal entirely and
          ;; then fire it at the first frame of the run the player starts.
          (or (str/contains? keys "q") (interrupted?)) :quit
          ;; Returning from the settings sub-loop is a fresh entry; reset
          ;; the poll counter so the menu re-samples size eagerly.
          (str/contains? keys "s")                     (recur (settings-screen! settings) [rows cols] 0 [rows cols])
          (start-pressed? keys)                        settings
          :else                                        (recur settings [rows cols] (php/+ frame 1) [rows cols]))))))

(defn- resolve-difficulty
  "Pick the run difficulty: an explicit, valid --difficulty CLI value
   wins; otherwise fall back to the settings-page default. `cli-raw` is
   the raw option string (\"\" when unset). Validity is checked against
   core/settings, the single source of truth for the difficulty list."
  [cli-raw settings]
  (let [d (and cli-raw (not (= cli-raw "")) (keyword cli-raw))]
    (if (valid-difficulty? d)
      d
      (:difficulty settings))))

(defn- opt-int
  "Coerce a CLI render-size-cap option to an int. nil / empty (the flag
   was not passed) → -1, the 'auto' sentinel: when BOTH axes are -1 the
   game-loop auto-calibrates the render pixel scale (full terminal
   always). An explicit value wins: 0 = fill the terminal at full
   detail (opts out of auto), a positive N inset-caps that axis to N."
  [raw]
  (if (or (nil? raw) (= raw ""))
    -1
    (php/max 0 (php/intval raw))))

(defn- teardown!
  "Give the terminal and the OS back: stop the music process, drop any
   demo session, and restore cooked mode / the main screen / the cursor.
   Both session entry points run this from a `finally`, so it must stay
   safe to call after a partial startup - each step is a no-op when the
   thing it undoes was never started.

   Order matters: the music process and the sfx sidecar are killed before
   `restore!` swallows pending input, so nothing still playing can
   outlive the session."
  []
  (music/stop-music!)
  (stop-sfx!)
  (demo/reset-off!)
  (restore!))

(defn- run-play [ctx]
  (let [diff-raw    (cli/opt ctx "difficulty")
        god?        (cli/opt ctx "god")
        armory?     (cli/opt ctx "armory")
        full-map?   (cli/opt ctx "full-map")
        lv-raw      (cli/opt ctx "level")
        ;; CLI gives strings; coerce to int. nil / empty → nil → L1.
        lv          (cond
                      (nil? lv-raw) nil
                      (= lv-raw "") nil
                      :else         (php/intval lv-raw))
        ;; Render-size caps (--max-cols / --max-rows). Unset → -1 on both
        ;; → the game-loop auto-calibrates the pixel scale (full screen,
        ;; pixel-doubled when the machine needs it). An explicit 0 fills
        ;; the terminal at full detail (opts out of auto); a positive
        ;; value inset-caps that axis, leaving a blank border.
        max-cols    (opt-int (cli/opt ctx "max-cols"))
        max-rows    (opt-int (cli/opt ctx "max-rows"))
        ;; Demo (issue #64): --demo replays a recorded run (forces its
        ;; seed + input stream, skips the menu); --record captures the
        ;; run's seed + per-frame input to a file on exit.
        record-path (cli/opt ctx "record")
        demo-path   (cli/opt ctx "demo")
        record?     (and record-path (not (= record-path "")))
        replay?     (and demo-path (not (= demo-path "")))
        replay      (when replay? (demo/read-demo demo-path))
        ;; Replay reproduces the recorded seed; record / normal start
        ;; from a fresh seed (recorded so the run can be replayed).
        init-seed   (if replay (:seed replay) (rng/fresh-seed))
        ;; Persisted settings (volumes + minimap / difficulty defaults).
        ;; Apply the volumes up front so the start menu + OST loop
        ;; honour them before the first frame.
        settings0   (load-settings)]
    (if (and replay? (nil? replay))
      ;; --demo names a file we cannot replay. Starting a normal
      ;; interactive run instead would silently give the player something
      ;; they did not ask for, and there is no useful degraded behaviour.
      (do (cli/error ctx (str "Cannot replay demo: " demo-path
                              " (missing, unreadable, or not a demo file)"))
          1)
      (do
        ;; init-input! after loading settings so the Mouse setting (#246)
        ;; gates the xterm mouse-reporting escapes: off = the terminal never
        ;; captures the pointer. load-settings is plain file IO, so it is
        ;; safe to run before raw mode is set.
        ;; Arm the signal handlers BEFORE raw mode: between init-input! and
        ;; the try/finally below there is no teardown guarantee, so a signal
        ;; landing in that window would kill the process with the terminal
        ;; already in raw mode and the alt screen up.
        (install-signal-handlers!)
        (install-resize-handler!)
        (init-input! (:mouse settings0))
        (apply-audio-settings! settings0)
        (cond
          replay  (demo/start-replay! (:seed replay) (:frames replay))
          record? (demo/start-record! init-seed)
          :else   (demo/reset-off!))
        (let [outcome
              ;; Raw mode, the alternate screen, the hidden cursor and mouse
              ;; capture are process-global: without the finally, a throw
              ;; anywhere in the loop leaves the player's shell unusable.
              ;; The exception still propagates - only teardown is guaranteed.
              (try
                ;; Replay skips the menu (and its settings edits); a normal run
                ;; goes through the start menu, which may edit + persist them.
                (let [menu (if replay settings0 (show-start-menu! settings0))]
                  (if (= menu :quit)
                    {:played? false :recorded? true}
                    (let [settings menu
                          diff     (resolve-difficulty diff-raw settings)]
                      (clear-screen)
                      ;; OST loop runs for the whole gameplay session (across
                      ;; levels + end screens). N-toggle starts/stops it mid-run.
                      (music/start-music!)
                      (run-levels diff god? armory? full-map? nil lv init-seed settings
                                  max-rows max-cols)
                      ;; Carry the write result out of the try: reporting it in
                      ;; here would print into the alternate screen, which the
                      ;; teardown below wipes a moment later.
                      {:played?   true
                       :recorded? (or (not record?) (demo/save-recording! record-path))})))
                (finally
                  (teardown!)))]
          (clear-screen)
          ;; Reported here, after teardown: a message printed inside the
          ;; alternate screen is wiped by restore! moments later. Both are
          ;; persistent conditions (an unwritable HOME), so saying it once
          ;; on the way out is accurate and reaches a cooked terminal.
          (when (settings-write-failed?)
            (cli/error ctx "Could not save settings - your options changes will not persist."))
          (when (scores-write-failed?)
            (cli/error ctx "Could not save high scores - this run's bests were not recorded."))
          (if (:recorded? outcome)
            (do (when (:played? outcome)
                  (cli/success ctx "Thanks for playing.")
                  (print-credits))
                0)
            ;; A lost recording is a total failure of what the player asked
            ;; for, so it exits non-zero like an unreadable --demo path.
            (do (cli/error ctx (str "Could not write the demo recording to " record-path))
                1)))))))

(defn run-demo-session
  "Menu-less tech-talk showcase run for `phase` (1..num-phases). Forces
   god + full-map (full minimap reveal) and threads the phase through run-levels,
   which applies the per-phase world transform after build-world. Same
   loop, teardown, and music lifecycle as a normal run - only the
   start menu and record/replay are skipped. `ctx` drives the closing
   success line. Returns the process exit code."
  [ctx phase]
  ;; Mouse reporting off for the menu-less showcase (#246): a tech-talk
  ;; screencast shouldn't have the terminal capturing the pointer.
  ;; Handlers before raw mode - see run-play.
  (install-signal-handlers!)
  (install-resize-handler!)
  (init-input! false)
  (let [settings0 (load-settings)
        ;; Audio only once enemies are in play (phase 3+); the
        ;; raycaster / weapon reveals stay silent. Mirrors the
        ;; :sound-on flag showcase/apply-phase stamps on the world.
        audio?    (showcase/enemies-in-phase? phase)]
    (apply-audio-settings! settings0)
    (demo/reset-off!)
    (clear-screen)
    (when audio? (music/start-music!))
    ;; Same teardown guarantee as run-play: a throw inside run-levels must
    ;; not leave raw mode / the alt screen / the hidden cursor behind.
    (try
      ;; god + armory (own every weapon, ammo refilled to :armory-reserve
      ;; = 99 each tick by combat/tick-armory) + full-map. The phase stamps
      ;; :show-map true so the corner minimap is visible by default.
      (run-levels :normal true true true phase 1 (rng/fresh-seed) settings0 0 0)
      (finally
        (teardown!)))
    (clear-screen)
    (cli/success ctx (str "Demo phase " phase " - thanks for watching."))
    0))

(def play-command
  {:name "play"
   :doc  "Start the DOOM showcase. WASD / arrow keys move + turn,
          space fires, M toggles the minimap, N toggles sound,
          P pauses, Q quits. Walk into a door to advance levels."
   :opts [{:name    "difficulty"
           :short   "d"
           :mode    :optional
           :doc     "easy | normal | hard | nightmare (overrides the settings-page default)"
           :default ""}
          {:name "god"
           :short "g"
           :mode  :none
           :doc   "Dev god mode: contact damage suppressed; GOD badge in HUD."}
          {:name "armory"
           :short "a"
           :mode  :none
           :doc   "Dev armory: own every weapon + infinite ammo (per-frame refill). Pairs naturally with --god for end-to-end mechanic testing."}
          {:name "full-map"
           :short "f"
           :mode  :none
           :doc   "Reveal the whole minimap from the start (skip fog-of-war). Useful for level editors / debugging."}
          {:name    "level"
           :short   "l"
           :mode    :optional
           :doc     "Start at level N (1..num-levels). Clamped. Pairs naturally with --god to drop straight into a boss room for testing."
           :default ""}
          {:name    "record"
           :mode    :optional
           :doc     "Record the run (seed + per-frame input) to a demo file for deterministic replay."
           :default ""}
          {:name    "demo"
           :mode    :optional
           :doc     "Replay a demo file recorded with --record (skips the start menu)."
           :default ""}
          {:name    "max-cols"
           :mode    :optional
           :doc     "Cap the render width to N columns (surplus becomes a blank inset border). Unset (default) fills the terminal and auto-picks the pixel detail for a smooth framerate; 0 forces full terminal at full detail; N caps to N."
           :default ""}
          {:name    "max-rows"
           :mode    :optional
           :doc     "Cap the render height to N rows (surplus becomes a blank inset border). Unset (default) fills the terminal (auto pixel detail); 0 forces full terminal at full detail; N caps to N."
           :default ""}]
   :run  run-play})
