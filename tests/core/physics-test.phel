(ns phel-doom-tests.core.physics-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.core.state   :refer [max-stamina new-world new-player])
  (:require phel-doom.core.physics :refer [try-move apply-physics sprint-engage-threshold sprint-multiplier stamina-drain stamina-regen tick-heartbeat tick-stamina tick-blood-drops]))

;; Tiny 3x3 grid: walls around the perimeter, open centre.
(def open-world
  (new-world [[1 1 1]
              [1 0 1]
              [1 1 1]]
             (new-player 1.5 1.5 0.0)))

;; 3x3 with no walls — for unconstrained motion checks.
(def empty-world
  (new-world [[0 0 0]
              [0 0 0]
              [0 0 0]]
             (new-player 1.5 1.5 0.0)))

;; ---------------------------------------------------------------------
;; try-move: wall collision is the only contract.
;; ---------------------------------------------------------------------

(deftest test-try-move-into-open-cell
  (let [w (try-move empty-world 0.5 0.0)
        p (:player w)]
    (is (< (php/abs (- (:x p) 2.0)) 0.0001))
    (is (< (php/abs (- (:y p) 1.5)) 0.0001))))

(deftest test-try-move-blocked-by-wall
  ;; Walking east from (1.5, 1.5) lands in cell (2, 1), which is a wall
  ;; in `open-world`. Player should NOT move.
  (let [w (try-move open-world 1.0 0.0)
        p (:player w)]
    (is (= 1.5 (:x p)))
    (is (= 1.5 (:y p)))))

(deftest test-try-move-zero-delta-noop
  (let [w (try-move open-world 0.0 0.0)
        p (:player w)]
    (is (= 1.5 (:x p)))
    (is (= 1.5 (:y p)))))

;; ---------------------------------------------------------------------
;; try-move + locked doors: arming the NEED <COLOUR> KEY HUD cue.
;; ---------------------------------------------------------------------

(def blue-door-world
  (new-world [[1 1 1]
              [1 0 3]  ; cell-door-blue at (2,1)
              [1 1 1]]
             (new-player 1.5 1.5 0.0)))

(deftest test-try-move-into-locked-door-without-key-arms-bump-cue
  ;; Player stays put AND the world records why so render can paint
  ;; 'NEED BLUE KEY' over the 3D view.
  (let [w (try-move blue-door-world 1.0 0.0)
        p (:player w)]
    (is (= 1.5 (:x p)))
    (is (= 1.5 (:y p)))
    (is (php/> (:locked-door-bump-secs w) 0.0))
    (is (= :blue (:locked-door-bump-colour w)))))

(deftest test-try-move-into-locked-door-with-matching-key-passes
  ;; Holding the blue key turns the locked door into a regular door
  ;; (passable trigger). No bump cue armed.
  (let [w0 (assoc blue-door-world :held-keys #{:blue})
        w  (try-move w0 1.0 0.0)
        p  (:player w)]
    (is (= 2.5 (:x p)))
    (is (= 0.0 (or (:locked-door-bump-secs w) 0.0)))))

(deftest test-try-move-into-wall-does-not-arm-bump-cue
  ;; Wall bump stays silent — only LOCKED doors arm the HUD cue.
  (let [w (try-move open-world 1.0 0.0)]
    (is (= 0.0 (or (:locked-door-bump-secs w) 0.0)))
    (is (php/=== nil (:locked-door-bump-colour w)))))

(deftest test-try-move-locked-door-enqueues-one-deny-click
  ;; First bump from a non-armed state plays the muted deny click.
  (let [w (try-move blue-door-world 1.0 0.0)]
    (is (= [{:name :click :vol 0.5}] (:sfx w)))))

(deftest test-try-move-locked-door-hold-does-not-respam-click
  ;; While the bump timer is still armed (player holding into the door)
  ;; no new click is enqueued — the click re-fires only after the timer
  ;; decays, at the HUD-hint cadence, not every frame.
  (let [w1 (try-move blue-door-world 1.0 0.0)
        w2 (try-move (assoc w1 :sfx []) 1.0 0.0)]
    (is (= [] (or (:sfx w2) [])))
    (is (php/> (:locked-door-bump-secs w2) 0.0) "stays armed")))

;; ---------------------------------------------------------------------
;; apply-physics: counters drive movement, decay each frame.
;; ---------------------------------------------------------------------

(deftest test-apply-physics-walks-forward-while-fwd-counter-on
  ;; Stamp the :fwd counter and tick one frame. Player should have
  ;; moved east (angle 0 = +x).
  (let [w0 (assoc-in empty-world [:moves :fwd] 5)
        w1 (apply-physics w0 0.1)]
    (is (> (:x (:player w1)) 1.5))
    ;; Counter decayed by one frame.
    (is (= 4 (:fwd (:moves w1))))))

(deftest test-chainsaw-firing-halves-movement
  ;; While the chainsaw's :fire-cooldown is positive the player walks
  ;; at the weapon's :movement-mul (0.5) - locks the player to a
  ;; commited melee approach instead of kiting at base speed.
  (let [w0           (assoc-in empty-world [:moves :fwd] 5)
        ;; Active chainsaw + mid-fire-cooldown: movement-mul kicks in.
        w-saw        (assoc w0 :weapon :chainsaw :fire-cooldown 0.05)
        ;; Same setup but pistol so the multiplier branch is skipped.
        w-pistol     (assoc w0 :weapon :pistol :fire-cooldown 0.05)
        saw-after    (apply-physics w-saw 0.1)
        pistol-after (apply-physics w-pistol 0.1)
        d-saw        (- (:x (:player saw-after)) 1.5)
        d-pis        (- (:x (:player pistol-after)) 1.5)]
    (is (< d-saw d-pis))
    ;; ~50% of pistol's distance: the chainsaw's 0.5 movement-mul.
    (is (< (php/abs (- d-saw (* 0.5 d-pis))) 0.0001))))

(deftest test-chainsaw-idle-does-not-slow-movement
  ;; :fire-cooldown <= 0 means the saw isn't ticking; walk at full
  ;; speed. The slow only kicks in MID-swing.
  (let [w0       (assoc-in empty-world [:moves :fwd] 5)
        w-saw    (assoc w0 :weapon :chainsaw :fire-cooldown 0.0)
        w-pistol (assoc w0 :weapon :pistol :fire-cooldown 0.0)
        saw      (apply-physics w-saw 0.1)
        pistol   (apply-physics w-pistol 0.1)]
    (is (< (php/abs (- (:x (:player saw)) (:x (:player pistol)))) 0.0001))))

(deftest test-apply-physics-idle-counters-decay-to-zero
  ;; Single-frame counter goes to 0 after one tick.
  (let [w0 (assoc-in empty-world [:moves :fwd] 1)
        w1 (apply-physics w0 0.1)
        w2 (apply-physics w1 0.1)]
    (is (= 0 (:fwd (:moves w1))))
    (is (= 0 (:fwd (:moves w2))))))

(deftest test-apply-physics-turns-via-counter
  (let [w0 (assoc-in empty-world [:moves :turn-right] 3)
        w1 (apply-physics w0 0.1)]
    (is (> (:angle (:player w1)) 0.0))
    (is (= 2 (:turn-right (:moves w1))))))

(deftest test-apply-physics-no-counters-is-noop
  (let [p0 (:player empty-world)
        w1 (apply-physics empty-world 0.1)
        p1 (:player w1)]
    (is (= (:x p0) (:x p1)))
    (is (= (:y p0) (:y p1)))
    (is (= (:angle p0) (:angle p1)))))

;; ---------------------------------------------------------------------
;; apply-pitch (via apply-physics): :pitch-up / :pitch-down counters
;; shear the look up/down fraction, clamped, with no effect on position.
;; ---------------------------------------------------------------------

(deftest test-apply-physics-look-up-raises-pitch
  ;; Look-up adds to :pitch (positive); the counter decays one frame.
  (let [w0 (assoc-in empty-world [:moves :pitch-up] 3)
        w1 (apply-physics w0 0.1)]
    (is (php/> (:pitch (:player w1)) 0.0))
    (is (= 2 (:pitch-up (:moves w1))))))

(deftest test-apply-physics-look-down-lowers-pitch
  (let [w0 (assoc-in empty-world [:moves :pitch-down] 3)
        w1 (apply-physics w0 0.1)]
    (is (php/< (:pitch (:player w1)) 0.0))
    (is (= 2 (:pitch-down (:moves w1))))))

(deftest test-apply-physics-pitch-clamps-and-does-not-wrap
  ;; Hold look-up across many frames: pitch saturates at +1.0, never
  ;; exceeds the cap or flips sign.
  (let [w0 (assoc-in empty-world [:moves :pitch-up] 1)
        wn (loop [w w0 i 0]
             (if (php/< i 200)
               (recur (apply-physics (assoc-in w [:moves :pitch-up] 1) 0.1)
                      (php/+ i 1))
               w))]
    (is (= 1.0 (:pitch (:player wn))))))

(deftest test-apply-physics-pitch-does-not-move-player
  ;; Pitch is a pure camera shear: looking up/down leaves x/y/angle put.
  (let [p0 (:player empty-world)
        w1 (apply-physics (assoc-in empty-world [:moves :pitch-up] 3) 0.1)
        p1 (:player w1)]
    (is (= (:x p0) (:x p1)))
    (is (= (:y p0) (:y p1)))
    (is (= (:angle p0) (:angle p1)))))

(deftest test-apply-physics-no-pitch-counter-leaves-pitch-level
  ;; Default (no pitch keys held): pitch stays 0.0 - the byte-identical
  ;; render contract.
  (is (= 0.0 (:pitch (:player (apply-physics empty-world 0.1))))))

(deftest test-apply-physics-wall-blocks-but-counter-still-decays
  ;; dt large enough that the requested move overshoots the open cell
  ;; (1,1) into the wall at (2,1). Player stays put, counter still
  ;; decays so a player pushed against a wall doesn't build up
  ;; potential energy.
  (let [w0 (assoc-in open-world [:moves :fwd] 3)
        w1 (apply-physics w0 1.0)]
    (is (= 1.5 (:x (:player w1))))
    (is (= 2 (:fwd (:moves w1))))))

;; ---------------------------------------------------------------------
;; tick-heartbeat: phase loops only when low on lives; the wrap flag
;; fires exactly on the frame the phase rolls past 1.0.
;; ---------------------------------------------------------------------

(deftest test-tick-heartbeat-silent-at-full-lives
  (let [w0 (assoc empty-world :lives 5 :heartbeat-phase 0.0)
        w1 (tick-heartbeat w0 0.5)]
    (is (= 0.0 (:heartbeat-phase w1)))
    (is (= false (:heartbeat-tick? w1)))))

(deftest test-tick-heartbeat-silent-when-dead
  (let [w0 (assoc empty-world :lives 0 :heartbeat-phase 0.4)
        w1 (tick-heartbeat w0 0.5)]
    (is (= 0.0 (:heartbeat-phase w1)))
    (is (= false (:heartbeat-tick? w1)))))

(deftest test-tick-heartbeat-advances-phase-at-2-lives
  (let [w0 (assoc empty-world :lives 2 :heartbeat-phase 0.0)
        w1 (tick-heartbeat w0 0.1)]
    (is (> (:heartbeat-phase w1) 0.0))
    (is (< (:heartbeat-phase w1) 1.0))
    (is (= false (:heartbeat-tick? w1)))))

(deftest test-tick-heartbeat-wraps-and-flips-tick-flag
  ;; Big-enough dt to push phase across 1.0 in one frame, so we can
  ;; assert the wrap behaviour without depending on the exact interval.
  (let [w0 (assoc empty-world :lives 1 :heartbeat-phase 0.0)
        w1 (tick-heartbeat w0 5.0)]
    (is (= true (:heartbeat-tick? w1)))
    (is (< (:heartbeat-phase w1) 1.0))
    (is (>= (:heartbeat-phase w1) 0.0))))

(deftest test-tick-heartbeat-faster-in-last-heart-than-second-last
  ;; Same dt, same start phase - the last-heart band (<=2 HP, 0.55s) runs
  ;; faster than the second-last band (<=4 HP, 0.85s), so it accumulates
  ;; more phase per frame.
  (let [w-low (tick-heartbeat (assoc empty-world :lives 2 :heartbeat-phase 0.0) 0.1)
        w-mid (tick-heartbeat (assoc empty-world :lives 4 :heartbeat-phase 0.0) 0.1)]
    (is (> (:heartbeat-phase w-low) (:heartbeat-phase w-mid)))))

;; ---------------------------------------------------------------------
;; bob-phase (#411): distance-driven head-bob walk cycle. Advances by the
;; ACTUAL ground distance covered this frame (so it stays put against a
;; wall), and settles to exactly 0.0 at rest for a byte-identical frame.
;; ---------------------------------------------------------------------

(deftest test-apply-physics-bob-phase-advances-when-moving
  (let [w0 (assoc (assoc-in empty-world [:moves :fwd] 3) :bob-phase 0.0)
        w1 (apply-physics w0 0.1)]
    (is (php/> (:bob-phase w1) 0.0))))

(deftest test-apply-physics-bob-phase-settles-to-zero-at-rest
  ;; No movement counters held: any accumulated phase resets to 0.0 so
  ;; the standing-still frame renders byte-identical.
  (let [w0 (assoc empty-world :bob-phase 2.0)
        w1 (apply-physics w0 0.1)]
    (is (= 0.0 (:bob-phase w1)))))

(deftest test-apply-physics-bob-phase-does-not-advance-against-a-wall
  ;; Distance-driven, not intent-driven: a forward press blocked by a
  ;; wall covers zero ground, so the bob must NOT advance - it resets.
  ;; (Same wall-block setup as the counter-decay test above.)
  (let [w0 (assoc (assoc-in open-world [:moves :fwd] 3) :bob-phase 1.5)
        w1 (apply-physics w0 1.0)]
    (is (= 1.5 (:x (:player w1))) "player stayed put")
    (is (= 0.0 (:bob-phase w1)))))

(deftest test-apply-physics-bob-phase-wraps-below-two-pi
  ;; Walk many frames: the phase stays wrapped into [0, 2*pi) so sin()
  ;; never sees an unbounded argument.
  (let [wn (loop [w (assoc empty-world :bob-phase 0.0) i 0]
             (if (php/< i 50)
               (recur (apply-physics (assoc-in w [:moves :fwd] 3) 0.1)
                      (php/+ i 1))
               w))]
    (is (php/>= (:bob-phase wn) 0.0))
    (is (php/< (:bob-phase wn) (php/* 2.0 php/M_PI)))))

;; ---------------------------------------------------------------------
;; tick-blood-drops: each existing drop falls + ages; expired ones get
;; pruned. Spawn is randomised so we test the deterministic parts.
;; ---------------------------------------------------------------------

(deftest test-tick-blood-drops-advances-row-and-ages
  (let [w  (assoc empty-world :blood-drops [{:col 0.3 :row 5.0 :ttl 1.0}])
        w' (tick-blood-drops w 0.1)
        d  (first (:blood-drops w'))]
    ;; Same col, row increased, ttl decreased.
    (is (= 0.3 (:col d)))
    (is (> (:row d) 5.0))
    (is (< (:ttl d) 1.0))))

(deftest test-tick-blood-drops-drops-expired
  ;; ttl below dt -> drop should be pruned this frame.
  (let [w  (assoc empty-world :blood-drops [{:col 0.3 :row 5.0 :ttl 0.05}])
        w' (tick-blood-drops w 0.1)]
    ;; The original drop is gone. Spawn is probabilistic so there
    ;; might be a fresh one, but it'll have row 1.0 — never the old
    ;; row 5.0.
    (is (every? (fn [d] (not (= 5.0 (:row d))))
                (:blood-drops w')))))

(deftest test-tick-blood-drops-keeps-cols-normalised
  ;; Cols stay 0..1 across ticks; render layer maps to vw.
  (let [w  (assoc empty-world :blood-drops
                  [{:col 0.0 :row 2.0 :ttl 1.0}
                   {:col 0.99 :row 2.0 :ttl 1.0}])
        w' (tick-blood-drops w 0.1)]
    (is (every? (fn [d] (and (php/>= (:col d) 0.0) (php/<= (:col d) 1.0)))
                (:blood-drops w')))))

(deftest test-tick-blood-drops-gated-by-lives
  ;; dt 10.0 multiplies spawn-rate (0.35/sec) well past 1.0 so spawn
  ;; rolls always succeed when allowed. Above the 6-HP threshold the
  ;; gate keeps the drop list at zero; at or below, it grows.
  (let [w-high (tick-blood-drops (assoc empty-world :lives 10 :blood-drops []) 10.0)
        w-low  (tick-blood-drops (assoc empty-world :lives 6 :blood-drops []) 10.0)]
    (is (= 0 (count (:blood-drops w-high))))
    (is (= 1 (count (:blood-drops w-low))))))

;; ---------------------------------------------------------------------
;; Sprint + stamina. Hold SHIFT (kitty) or 'x' (any term) refreshes the
;; :sprint move-slot. While the slot is on AND the player is actually
;; moving AND stamina > 0, longitudinal/lateral speed is multiplied
;; by sprint-multiplier and stamina drains at stamina-drain units/sec.
;; While the slot is off, stamina regenerates after a brief cooldown.
;; Hitting 0 latches :sprint-blocked? until stamina recovers to
;; sprint-engage-threshold so the player can't stutter-sprint at empty.
;; ---------------------------------------------------------------------

(deftest test-tick-stamina-drains-while-sprinting-and-moving
  (let [w  (-> empty-world
               (assoc-in [:moves :sprint] 5)
               (assoc-in [:moves :fwd] 5)
               (assoc :stamina max-stamina))
        w' (tick-stamina w 0.1)]
    (is (< (:stamina w') max-stamina))
    (is (< (php/abs (- (:stamina w') (- max-stamina (* stamina-drain 0.1)))) 0.0001))))

(deftest test-tick-stamina-no-drain-when-sprint-pressed-but-not-moving
  ;; Holding SHIFT alone (no WASD) must not bleed stamina.
  (let [w  (-> empty-world
               (assoc-in [:moves :sprint] 5)
               (assoc :stamina max-stamina))
        w' (tick-stamina w 0.1)]
    (is (= max-stamina (:stamina w')))))

(deftest test-tick-stamina-regenerates-when-not-sprinting
  (let [w  (-> empty-world
               (assoc-in [:moves :sprint] 0)
               (assoc :stamina 50.0 :sprint-cooldown-secs 0.0))
        w' (tick-stamina w 0.1)]
    (is (< (php/abs (- (:stamina w') (+ 50.0 (* stamina-regen 0.1)))) 0.0001))))

(deftest test-tick-stamina-regen-blocked-during-cooldown
  (let [w  (-> empty-world
               (assoc-in [:moves :sprint] 0)
               (assoc :stamina 50.0 :sprint-cooldown-secs 0.5))
        w' (tick-stamina w 0.1)]
    (is (= 50.0 (:stamina w')))
    ;; Cooldown ticks down by dt.
    (is (< (php/abs (- (:sprint-cooldown-secs w') 0.4)) 0.0001))))

(deftest test-tick-stamina-cooldown-clears-then-regen-resumes
  (let [w  (-> empty-world
               (assoc-in [:moves :sprint] 0)
               (assoc :stamina 50.0 :sprint-cooldown-secs 0.05))
        w' (tick-stamina w 0.1)]
    ;; Cooldown ran out (0.05 - 0.1 → 0.0).
    (is (= 0.0 (:sprint-cooldown-secs w')))
    ;; Regen runs with the full dt this frame — keeps the impl
    ;; simple. Once :sprint-cooldown-secs hits 0 the same frame, the
    ;; whole dt feeds into regen.
    (is (< (php/abs (- (:stamina w') (+ 50.0 (* stamina-regen 0.1)))) 0.0001))))

(deftest test-tick-stamina-clamps-at-max
  (let [w  (-> empty-world
               (assoc-in [:moves :sprint] 0)
               (assoc :stamina (- max-stamina 1.0) :sprint-cooldown-secs 0.0))
        w' (tick-stamina w 5.0)]
    (is (= max-stamina (:stamina w')))))

(deftest test-tick-stamina-blocks-sprint-at-zero
  ;; Drain past zero in one big frame; expect :sprint-blocked? to latch.
  (let [w  (-> empty-world
               (assoc-in [:moves :sprint] 5)
               (assoc-in [:moves :fwd] 5)
               (assoc :stamina 1.0))
        w' (tick-stamina w 1.0)]
    (is (= 0.0 (:stamina w')))
    (is (= true (:sprint-blocked? w')))))

(deftest test-tick-stamina-unblocks-only-at-engage-threshold
  ;; Below threshold: still blocked.
  (let [w  (-> empty-world
               (assoc-in [:moves :sprint] 0)
               (assoc :stamina (- sprint-engage-threshold 5.0)
                      :sprint-blocked? true
                      :sprint-cooldown-secs 0.0))
        w' (tick-stamina w 0.01)]
    (is (= true (:sprint-blocked? w'))))
  ;; Above threshold: unblocks.
  (let [w  (-> empty-world
               (assoc-in [:moves :sprint] 0)
               (assoc :stamina sprint-engage-threshold
                      :sprint-blocked? true
                      :sprint-cooldown-secs 0.0))
        w' (tick-stamina w 0.01)]
    (is (= false (:sprint-blocked? w')))))

(deftest test-apply-physics-sprint-multiplier-applies-to-fwd
  ;; Same fwd counter + dt, with vs without :sprint slot. Ratio of the
  ;; resulting deltas must equal sprint-multiplier.
  (let [base   (-> empty-world
                   (assoc-in [:moves :fwd] 5)
                   (assoc :stamina max-stamina))
        slow   (apply-physics base 0.1)
        fast-w (-> empty-world
                   (assoc-in [:moves :fwd] 5)
                   (assoc-in [:moves :sprint] 5)
                   (assoc :stamina max-stamina))
        fast   (apply-physics fast-w 0.1)
        slow-d (- (:x (:player slow)) 1.5)
        fast-d (- (:x (:player fast)) 1.5)]
    (is (php/> fast-d slow-d))
    (is (< (php/abs (- (/ fast-d slow-d) sprint-multiplier)) 0.0001))))

(deftest test-apply-physics-sprint-no-multiplier-when-blocked
  ;; Sprint slot pressed but :sprint-blocked? latched → walks at base speed.
  (let [base  (-> empty-world
                  (assoc-in [:moves :fwd] 5)
                  (assoc :stamina max-stamina))
        slow  (apply-physics base 0.1)
        blk-w (-> empty-world
                  (assoc-in [:moves :fwd] 5)
                  (assoc-in [:moves :sprint] 5)
                  (assoc :stamina max-stamina :sprint-blocked? true))
        blk   (apply-physics blk-w 0.1)]
    (is (< (php/abs (- (:x (:player blk)) (:x (:player slow)))) 0.0001))))

(deftest test-apply-physics-sprint-no-multiplier-at-zero-stamina
  (let [base   (-> empty-world
                   (assoc-in [:moves :fwd] 5)
                   (assoc :stamina max-stamina))
        slow   (apply-physics base 0.1)
        empty- (-> empty-world
                   (assoc-in [:moves :fwd] 5)
                   (assoc-in [:moves :sprint] 5)
                   (assoc :stamina 0.0))
        out    (apply-physics empty- 0.1)]
    (is (< (php/abs (- (:x (:player out)) (:x (:player slow)))) 0.0001))))

(deftest test-flat-move-takes-no-fall-damage
  ;; Belt-and-suspenders byte-identity: a normal flat-ground walk never
  ;; touches :lives or :damage-taken (the fall path is unreachable when
  ;; src-floor == dest == 0.0).
  (let [w  (assoc empty-world :lives 10)
        w' (try-move w 0.5 0.0)]
    (is (= 10 (:lives w')) "flat move: no life lost")
    (is (php/=== nil (:damage-taken w')) "flat move: no fall-damage tally")))
