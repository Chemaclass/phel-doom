(ns phel-doom.modules.doom.input)

(defn init-input!
  "Put the terminal in non-blocking raw mode so we can read single keys
   without waiting for Enter."
  {:export true}
  []
  (php/system "stty -icanon -echo min 0 time 0")
  (php/stream_set_blocking php/STDIN false))

(defn restore!
  "Restore cooked terminal mode."
  {:export true}
  []
  (php/system "stty sane"))

(defn read-key
  "Read one key from STDIN. Returns the character or nil if nothing pending."
  {:export true}
  []
  (let [s (php/fread php/STDIN 1)]
    (if (or (= s false) (= s ""))
      nil
      s)))
