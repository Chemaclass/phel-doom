(ns phel-doom-tests.modules.doom.engine-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.modules.doom.map    :refer [default-grid])
  (:require phel-doom.modules.doom.engine :refer [cast-ray max-depth]))

(deftest test-ray-hits-wall-eventually
  (let [d (cast-ray default-grid 8.0 8.0 0.0)]
    (is (> d 0))
    (is (< d max-depth))))

(deftest test-ray-into-open-space-bounded-by-max-depth
  ;; from (8, 8) facing south-east through long open corridor
  (let [d (cast-ray default-grid 8.0 8.0 (/ php/M_PI 4.0))]
    (is (<= d max-depth))))

(deftest test-ray-near-wall-short-distance
  ;; from (1.5, 1.5) facing north (-y), wall at y=1 → distance ~0.5
  (let [d (cast-ray default-grid 1.5 1.5 (- 0 (/ php/M_PI 2.0)))]
    (is (< d 1.0))))
