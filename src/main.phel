(ns phel-doom.main
  (:require phel.cli :as cli)
  (:require phel-doom.commands.play :refer [play-command]))

(def app
  (cli/application
   {:name     "phel-doom"
    :version  "0.9.0"
    :default  "play"
    :commands [play-command]}))

(when-not *build-mode*
  (php/exit (cli/run app (cli/argv argv))))
