(ns phel-doom.modules.sound)

;; ---------------------------------------------------------------------
;; Sound effects via OS shell-out. NOT the ext-ffi + miniaudio backend
;; on the roadmap (that's a heavy native binding with its own
;; cross-platform install story). This is the pragmatic minimum: fire
;; an async background process per event using whichever player is on
;; PATH.
;;
;; Per-event cost is one fork + exec, ~5–10 ms; tolerable for sparse
;; events like shoot / hit / open-door. Effects skip silently if the
;; player binary is missing, so the game never blocks waiting for
;; audio on a system without speakers.
;; ---------------------------------------------------------------------

(def player-binaries
  "Audio players we'll try in order. First one present on PATH wins."
  ["afplay"      ; macOS
   "paplay"      ; Linux + PulseAudio
   "aplay"       ; Linux + ALSA
   "play"])      ; sox

(def cached-player
  "Memoised result of resolving an audio player on $PATH. nil = not
   resolved yet; false = no player available, skip all sounds; string
   = the binary name to invoke."
  (atom nil))

(defn- which
  "Return the absolute path of `bin` if it's on PATH, else nil."
  [bin]
  (let [out (php/array)
        _   (php/exec (str "command -v " bin " 2>/dev/null") out)]
    (let [line (php/aget out 0)]
      (if (or (php/=== line nil) (= line ""))
        nil
        line))))

(defn- resolve-player []
  (loop [bins player-binaries]
    (if (empty? bins)
      false
      (let [bin (first bins)]
        (if (which bin)
          bin
          (recur (rest bins)))))))

(defn player
  "Return the audio player binary to use this session, or false when no
   supported player is on PATH (sound calls then become no-ops)."
  {:export true}
  []
  (let [v @cached-player]
    (if (php/=== v nil)
      (let [r (resolve-player)]
        (reset! cached-player r)
        r)
      v)))

(defn play-async!
  "Fire-and-forget: spawn the player in the background pointing at
   `path`. Returns immediately. If no player is available or the file
   doesn't exist, this is a silent no-op so the game keeps running on
   bare/headless systems."
  {:export true}
  [path]
  (let [p (player)]
    (when (and p path (php/file_exists path))
      (php/exec (str p " " (php/escapeshellarg path) " > /dev/null 2>&1 &")))))

(defn play-beep!
  "Cross-platform bell as a last-resort fallback: write \\a to STDOUT.
   Terminal handles it (typically a short audible beep, sometimes a
   visual flash, sometimes nothing depending on user prefs)."
  {:export true}
  []
  (php/fwrite php/STDOUT "\a")
  (php/fflush php/STDOUT))
