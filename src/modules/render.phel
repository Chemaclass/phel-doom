(ns phel-doom.modules.render
  (:require phel-doom.modules.engine :refer [cast-frame max-depth proj-dist]))

(def sky        "\e[48;5;236m ")
(def floor      "\e[48;5;239m ")
(def sky-blood  "\e[48;5;52m ")
(def floor-blood "\e[48;5;88m ")
(def enemy-head "\e[48;5;196m ")
(def enemy-body "\e[48;5;52m ")
(def enemy-marker "\e[91;1mE\e[0m")
(def heart-marker "\e[91;1m♥\e[0m")
(def door-shade
  "Solid orange-yellow column drawn when a ray hit a closed door.
   Distinct from the grey wall gradient so doors pop in the 3D view."
  "\e[48;5;172m ")

;; Color CODES used for half-block edge anti-aliasing. The outer
;; column loop composes 'top edge' and 'bottom edge' cells by
;; combining a wall code with the sky / floor code into a single
;; ▀ glyph (upper-half block — FG paints top half, BG paints
;; bottom half). The eye reads it as a sub-cell wall boundary
;; instead of a staircase.
(def sky-code         "236")
(def floor-code       "239")
(def sky-blood-code   "52")
(def floor-blood-code "88")
(def door-code        "172")
(def blood-bright "\e[48;5;160m ")
(def blood-mid    "\e[48;5;88m ")
(def blood-dim    "\e[48;5;52m ")
(def heart-shade
  "Bright pink-red painted into the per-cell overlay so a heart
   pickup pops out against the grey walls + red enemies."
  "\e[48;5;205m ")
(def char-aspect 2.0)
(def hud-rows 1)

(def shade-table
  "Pre-baked ANSI strings for the 24 grayscale palette entries (codes
   232-255). Indexed by an integer shade level 0-23, so the per-cell
   shade lookup is just one PHP array fetch — no memoize, no string
   alloc, no Phel runtime dispatch."
  (let [t (php/array)]
    (loop [i 0]
      (when (php/< i 24)
        (php/aset t i (str "\e[48;5;" (php/+ 232 i) "m "))
        (recur (php/+ i 1))))
    t))

(def shade-code-table
  "Parallel palette to shade-table holding ONLY the 256-color code as
   a string (e.g. \"240\"). Used to compose ▀ half-block edge cells
   that mix a wall colour with sky / floor for sub-pixel-looking wall
   tops and bottoms."
  (let [t (php/array)]
    (loop [i 0]
      (when (php/< i 24)
        (php/aset t i (php/strval (php/+ 232 i)))
        (recur (php/+ i 1))))
    t))

(def shade-table-blood
  "Red gradient palette swapped in for the duration of the player's
   post-hit i-frames so the whole viewport flushes red — instant 'you
   just got hit' feedback without rendering a separate overlay."
  (let [t (php/array)]
    (loop [i 0]
      (when (php/< i 24)
        ;; bright red (close) -> dark red (far) along the 256-color
        ;; reds: 196 -> 58, every shade step ~6 indices.
        (php/aset t i (str "\e[48;5;" (php/- 196 (php/intval (php/* i 6))) "m "))
        (recur (php/+ i 1))))
    t))

(def shade-code-table-blood
  "Code-only twin of shade-table-blood for edge-cell composition."
  (let [t (php/array)]
    (loop [i 0]
      (when (php/< i 24)
        (php/aset t i (php/strval (php/- 196 (php/intval (php/* i 6)))))
        (recur (php/+ i 1))))
    t))

(defn- build-horizon-gradient
  "Per-row PHP array of pre-baked shade strings for the given viewport
   height. Maps each row to a shade-table index based on distance
   from the horizon line (vh/2): closer to the horizon = darker
   (atmospheric haze). Used for both sky AND floor since after a
   distance the eye stops distinguishing them anyway."
  [^int vh tbl]
  (let [arr     (php/array)
        horizon (php/intdiv vh 2)
        max-d   (php/max 1 horizon)]
    (loop [r 0]
      (when (php/< r vh)
        (let [idx (php/max 0
                           (php/min 23
                                    (php/intval (php/* (php/- 1.0
                                                              (php// (php/abs (php/- r horizon))
                                                                     max-d))
                                                       23))))]
          (php/aset arr r (php/aget tbl idx)))
        (recur (php/+ r 1))))
    arr))

;; Per-column shading lives inline in frame->string's hot loop:
;; base distance index, +1 for vertical wall faces (side-shading),
;; ±1 per-cell hash, then resolve TWO shade strings per column
;; (normal + edge-darkened). Inner row loop becomes one aget +
;; one ===-compare against tops/bots-1.

(defn direction-char
  "Map an angle in radians to one of 8 unicode arrow chars, snapping to
   the nearest π/4 sector. Public so the minimap layer and tests can
   share the same convention."
  {:export true}
  [angle]
  (let [q (mod (php/intval
                (+ (/ (php/fmod (+ angle (* 4.0 php/M_PI)) (* 2.0 php/M_PI))
                      (/ php/M_PI 4.0))
                   0.5))
               8)]
    (cond
      (= q 0) "→"
      (= q 1) "↘"
      (= q 2) "↓"
      (= q 3) "↙"
      (= q 4) "←"
      (= q 5) "↖"
      (= q 6) "↑"
      :else   "↗")))

(def minimap-wall  "\e[37;1m#\e[0m")
(def minimap-floor "\e[90m·\e[0m")
(def minimap-door  "\e[33;1mD\e[0m")

(defn- enemy-cells
  "Build a PHP array keyed by `row*gw+col` whose truthy entries mark
   cells currently occupied by an alive enemy. One pass over the
   enemies vector so the minimap inner loop stays O(1) per cell."
  [enemies gw]
  (let [acc (php/array)]
    (loop [es enemies]
      (when (php/!== es nil)
        (let [e (first es)]
          (when (and e (:alive e))
            (php/aset acc
                      (php/+ (php/* (php/intval (:y e)) gw) (php/intval (:x e)))
                      true)))
        (recur (next es))))
    acc))

(defn- heart-cells
  "Build a PHP array keyed by `row*gw+col` whose truthy entries mark
   cells currently holding a heart pickup."
  [hearts gw]
  (let [acc (php/array)]
    (loop [hs hearts]
      (when (php/!== hs nil)
        (let [h (first hs)]
          (when h
            (php/aset acc
                      (php/+ (php/* (php/intval (:y h)) gw) (php/intval (:x h)))
                      true)))
        (recur (next hs))))
    acc))

(defn- minimap-rows
  "Render the world's grid into a PHP array of ANSI-coded strings, one
   per grid row. Reads the grid via :pgrid (PHP-native nested array)
   and builds each row with php/array_push + implode to avoid Phel
   collection dispatch in a hot per-frame call. Alive enemies are
   marked with a red E."
  [world]
  (let [pgrid               (:pgrid world)
        {:keys [x y angle]} (:player world)
        pcol                (php/intval x)
        prow                (php/intval y)
        marker              (str "\e[93;1m" (direction-char angle) "\e[0m")
        gh                  (php/count pgrid)
        gw                  (php/count (php/aget pgrid 0))
        emap                (enemy-cells (:enemies world) gw)
        hmap                (heart-cells (:hearts world) gw)
        rows                (php/array)]
    (loop [row 0]
      (when (php/< row gh)
        (let [grow  (php/aget pgrid row)
              parts (php/array)]
          (loop [col 0]
            (when (php/< col gw)
              (php/array_push parts
                              (cond
                                (and (php/=== row prow) (php/=== col pcol)) marker
                                (php/=== 1 (php/aget grow col))             minimap-wall
                                (php/=== 2 (php/aget grow col))             minimap-door
                                (php/aget emap (php/+ (php/* row gw) col))  enemy-marker
                                (php/aget hmap (php/+ (php/* row gw) col))  heart-marker
                                :else                                       minimap-floor))
              (recur (php/+ col 1))))
          (php/aset rows row (php/implode "" parts)))
        (recur (php/+ row 1))))
    rows))

(defn- hud-line [world stats]
  (let [{:keys [x y angle]} (:player world)]
    (str "\e[0m\e[1mpos\e[0m ("
         (php/number_format x 1) ", " (php/number_format y 1) ")"
         "  \e[1mangle\e[0m "
         (php/intval (* (php/fmod (+ angle (* 4.0 php/M_PI)) (* 2.0 php/M_PI))
                        (/ 180.0 php/M_PI)))
         "°"
         "  \e[1mL" (or (get stats :level) 1) "\e[0m " (or (get stats :level-name) "")
         "  \e[1mkills\e[0m " (or (get stats :kills) 0)
         "  \e[1mfps\e[0m " (or (get stats :fps) 0)
         "  \e[2m[wasd ←→ space fire  m map  n sound  p pause  q quit]\e[0m")))

(defn project-enemy
  "Project one enemy into screen space relative to the player. Returns
   {:col :half-width :dist} or nil if the enemy is behind the player or
   off-screen. Distance is fish-eye corrected so it can be compared
   directly to entries in the wall `dists` array."
  {:export true}
  [enemy player vw]
  (let [dx (php/- (:x enemy) (:x player))
        dy (php/- (:y enemy) (:y player))]
    (let [rel-norm (php/- (php/fmod (php/+ (php/- (php/atan2 dy dx) (:angle player))
                                           (php/* 3.0 php/M_PI))
                                    (php/* 2.0 php/M_PI))
                          php/M_PI)
          cos-rel  (php/cos rel-norm)]
      (if (php/<= cos-rel 0.05)
        nil
        (let [dist (php/* (php/sqrt (php/+ (php/* dx dx) (php/* dy dy))) cos-rel)]
          {:col        (php/intval (php/+ (php/* 0.5 vw) (php/* (php/tan rel-norm) proj-dist)))
           :half-width (php/max 1 (php/intval (php// proj-dist (php/* (php/max 0.5 dist) 3.0))))
           :dist       dist})))))

(defn- collect-enemy-projs
  "Project every alive enemy and return a vector sorted by distance
   descending — back-to-front so closer sprites overwrite farther ones
   when painted in order."
  [enemies player vw]
  (let [raw (loop [es enemies acc []]
              (if (php/=== es nil)
                acc
                (let [e (first es)]
                  (recur (next es)
                         (if (and e (:alive e))
                           (let [p (project-enemy e player vw)]
                             (if p (conj acc p) acc))
                           acc)))))]
    (sort-by (fn [x] (php/- 0.0 (:dist x))) raw)))

(def pause-inner-width
  "Character width of each interior row of the pause menu (between the
   left and right borders). Every row pads to this width so the box
   aligns cleanly regardless of label length."
  28)

(defn- pause-pad
  "Pad `text` to `width` with trailing spaces. Used to make every menu
   row the same width so the right border lines up."
  [text width]
  (str text (php/str_repeat " " (php/max 0 (php/- width (php/strlen text))))))

(defn- pause-menu-string
  "Build the pause overlay as a single ANSI string with absolute cursor
   moves. Pure: caller pushes it into the parts array."
  [vw vh sound-on?]
  (let [rows
        (let [w pause-inner-width]
          (let [bar  (php/str_repeat "─" w)
                blnk (str "│" (pause-pad "" w) "│")
                bord (fn [text]
                       (str "│\e[97m" (pause-pad text w) "│"))]
            [(str "┌" bar "┐")
             blnk
             (str "│\e[1;93m" (pause-pad "           PAUSED" w) "\e[0;97m│")
             blnk
             (str "├" bar "┤")
             blnk
             ;; Sound row built from visible-only chunks so the right
             ;; border lines up no matter how many ANSI bytes the
             ;; emphasis adds inside.
             (let [val (if sound-on? "on" "off")]
               (str "│\e[97m  n   sound: \e[1m" val "\e[0;97m"
                    (php/str_repeat " " (php/max 0 (php/- w (php/+ (php/strlen "  n   sound: ")
                                                                   (php/strlen val)))))
                    "│"))
             (bord "  p   resume")
             (bord "  q   quit")
             blnk
             (str "├" bar "┤")
             blnk
             (str "│\e[2;97m" (pause-pad "  phel-doom by Chemaclass" w) "\e[0;97m│")
             (str "│\e[2;97m" (pause-pad "  written in Phel Lang"   w) "\e[0;97m│")
             blnk
             (str "└" bar "┘")]))]
    (let [col0 (php/max 1 (php/- (php/+ (php/intdiv vw 2) 1)
                                 (php/intdiv (php/+ pause-inner-width 2) 2)))
          row0 (php/max 1 (php/- (php/intdiv vh 2) 4))]
      (loop [i 0 acc ""]
        (if (php/>= i (count rows))
          acc
          (recur (php/+ i 1)
                 (str acc "\e[" (php/+ row0 i) ";" col0 "H\e[40;97m"
                      (get rows i) "\e[0m")))))))

(defn- layout
  "Viewport fills the whole terminal. The minimap is an overlay in the
   top-right corner that the M key shows or hides."
  [cols rows mw]
  {:vw      cols
   :vh      (- rows hud-rows)
   :map-col (php/max 1 (+ (- cols mw) 1))
   :map-row 1})

(defn frame->string
  "Render the world sized to cols x rows. Walls project at a constant
   scale (proj-dist from engine) with a 2:1 character-aspect correction,
   so resizing the terminal widens the FOV instead of growing the walls.
   Minimap is overlaid top-right when (:show-map world) is truthy."
  {:export true}
  [world stats cols rows]
  (let [{:keys [vw vh map-col map-row]}
        (layout cols rows (count (first (:grid world))))
        bloody?                            (php/> (or (get stats :iframes) 0.0) 0.0)
        stbl                               (if bloody? shade-table-blood shade-table)
        ;; Per-row sky + floor strings shaded by distance-to-horizon.
        ;; Same gradient for both — atmospheric haze blends ceiling
        ;; and floor at infinity. Built once per frame (vh might
        ;; change on terminal resize).
        sky-gradient                       (build-horizon-gradient vh stbl)
        floor-gradient                     sky-gradient
        ehead                              (or (get stats :enemy-head) enemy-head)
        ebody                              (or (get stats :enemy-body) enemy-body)
        {:keys [dists hits hxs hys sides]}
        (cast-frame world vw)
        ;; Half-block edge cells need the sky/floor colour CODE for
        ;; the current palette so the composer can write
        ;; "\e[48;5;WALL;38;5;SKYm▀" and let ▀'s upper half show sky.
        sky-c                              (if bloody? sky-blood-code sky-code)
        floor-c                            (if bloody? floor-blood-code floor-code)
        ctbl                               (if bloody? shade-code-table-blood shade-code-table)
        tops                               (php/array)
        bots                               (php/array)
        ;; Three pre-baked ANSI strings per column:
        ;;   shades-normal    interior wall cell (single colour BG)
        ;;   shades-top-edge  ▀ char w/ sky above + wall below (anti-aliased top)
        ;;   shades-bot-edge  ▀ char w/ wall above + floor below (anti-aliased bottom)
        ;; Door columns get door-shade in all three.
        shades-normal                      (php/array)
        shades-top-edge                    (php/array)
        shades-bot-edge                    (php/array)
        mids                               (php/array)
        emask                              (php/array)
        blood-paint                        (php/array)
        mrows                              (if (:show-map world) (minimap-rows world) (php/array))
        visible-mh                         (php/min (php/count mrows) vh)
        ;; First 0-indexed column the minimap overdraws. When the
        ;; minimap is on, the inner row loop emits sky' for those
        ;; cells (rows < visible-mh) since the minimap blits over
        ;; them via absolute cursor positioning anyway — saves a
        ;; chain of aget + cond per cell in the overlay region.
        mini-col0                          (if (php/> visible-mh 0)
                                             (php/max 0 (php/- map-col 1))
                                             vw)]
    (loop [col 0]
      (when (php/< col vw)
        (let [dist   (php/aget dists col)
              wall-h (php/min vh (php/intval
                                  (/ proj-dist (php/* (php/max 0.3 dist) char-aspect))))
              top    (php/intdiv (php/- vh wall-h) 2)]
          (php/aset tops col top)
          (php/aset bots col (php/+ top wall-h))
          (if (php/=== 2 (php/aget hits col))
            (do (php/aset shades-normal   col door-shade)
                (php/aset shades-top-edge col (str "\e[48;5;" door-code ";38;5;" sky-c "m▀"))
                (php/aset shades-bot-edge col (str "\e[48;5;" floor-c ";38;5;" door-code "m▀")))
            (let [idx (php/max 0
                               (php/min 23
                                        (php/+ (php/intval (php/* (php/- 1.0 (php/min 1.0 (php// dist max-depth))) 23))
                                               (if (php/=== (php/aget sides col) 0) 1 0)
                                               (php/- (mod (php/+ (php/* (php/aget hxs col) 37)
                                                                  (php/* (php/aget hys col) 91))
                                                           3)
                                                      1))))]
              (let [wcode (php/aget ctbl idx)]
                (php/aset shades-normal col (php/aget stbl idx))
              ;; Upper-half block: FG paints top half (= sky), BG paints
              ;; bottom half (= wall). Visually anti-aliases the top.
                (php/aset shades-top-edge col
                          (str "\e[48;5;" wcode ";38;5;" sky-c "m▀"))
              ;; Same trick at the bottom but with wall on top, floor below.
                (php/aset shades-bot-edge col
                          (str "\e[48;5;" floor-c ";38;5;" wcode "m▀")))))
          (recur (php/+ col 1)))))
    (doseq [proj (collect-enemy-projs (:enemies world) (:player world) vw)]
           (let [col (:col proj)
                 hw  (:half-width proj)
                 d   (:dist proj)]
             (let [c-from (php/max 0 (php/- col hw))
                   c-to   (php/min (php/- vw 1) (php/+ col hw))
                   h      (php/min vh (php/intval (php// proj-dist
                                                         (php/* (php/max 0.5 d) char-aspect))))]
               (let [e-top (php/intdiv (php/- vh h) 2)]
                 (let [e-bot (php/+ e-top h)
                       e-mid (php/+ e-top (php/intdiv h 3))]
                   (loop [c c-from]
                     (when (php/<= c c-to)
                       (when (php/< d (php/aget dists c))
                         (php/aset tops c e-top)
                         (php/aset bots c e-bot)
                         (php/aset mids c e-mid)
                         (php/aset emask c true))
                       (recur (php/+ c 1)))))))))
    (doseq [fx (or (get stats :fx) [])]
           (let [proj (project-enemy fx (:player world) vw)]
             (when proj
               (let [col (:col proj)
                     hw  (:half-width proj)
                     d   (:dist proj)
                     bsh (let [ttl (or (:ttl fx) 0.0)]
                           (cond (php/> ttl 0.3)  blood-bright
                                 (php/> ttl 0.15) blood-mid
                                 :else            blood-dim))]
                 (let [c-from (php/max 0 (php/- col hw))
                       c-to   (php/min (php/- vw 1) (php/+ col hw))
                       h      (php/min vh (php/intval (php// proj-dist
                                                             (php/* (php/max 0.5 d) char-aspect))))]
                   (let [r-top (php/+ (php/intdiv (php/- vh h) 2) (php/intdiv (php/* h 2) 3))
                         r-bot (php/min vh (php/+ (php/intdiv (php/- vh h) 2) h))]
                     (loop [c c-from]
                       (when (php/<= c c-to)
                         (when (php/< d (php/aget dists c))
                           (loop [r r-top]
                             (when (php/< r r-bot)
                               (php/aset blood-paint (php/+ (php/* r vw) c) bsh)
                               (recur (php/+ r 1)))))
                         (recur (php/+ c 1))))))))))
    ;; Heart pickups: paint a compact bright-pink sprite at the upper
    ;; mid of the projected column so they float visibly above the
    ;; floor without obscuring the wall behind them entirely.
    (doseq [heart (or (:hearts world) [])]
           (let [proj (project-enemy heart (:player world) vw)]
             (when proj
               (let [col (:col proj)
                     hw  (php/max 1 (php/intdiv (:half-width proj) 2))
                     d   (:dist proj)]
                 (let [c-from (php/max 0 (php/- col hw))
                       c-to   (php/min (php/- vw 1) (php/+ col hw))
                       h      (php/min vh (php/intval (php// proj-dist
                                                             (php/* (php/max 0.5 d) char-aspect))))]
                   (let [r-top (let [mid (php/+ (php/intdiv (php/- vh h) 2) (php/intdiv h 2))]
                                 (php/max 0 (php/- mid (php/intdiv h 6))))
                         r-bot (let [mid (php/+ (php/intdiv (php/- vh h) 2) (php/intdiv h 2))]
                                 (php/min vh (php/+ mid (php/intdiv h 6) 1)))]
                     (loop [c c-from]
                       (when (php/<= c c-to)
                         (when (php/< d (php/aget dists c))
                           (loop [r r-top]
                             (when (php/< r r-bot)
                               (php/aset blood-paint (php/+ (php/* r vw) c) heart-shade)
                               (recur (php/+ r 1)))))
                         (recur (php/+ c 1))))))))))
    (let [parts (php/array)]
      (dotimes [row vh]
               (loop [col 0 prev nil run 0]
                 (if (php/>= col vw)
                   (when (php/> run 0)
                     (php/array_push parts prev)
                     (php/array_push parts (php/str_repeat " " (php/- run 1))))
                   (let [c (if (and (php/< row visible-mh) (php/>= col mini-col0))
                             ;; Cells under the minimap overlay — emit a
                             ;; cheap placeholder; the minimap blits over
                             ;; them later via absolute cursor positioning.
                             (php/aget sky-gradient row)
                             (or (php/aget blood-paint (php/+ (php/* row vw) col))
                                 (cond
                                   (php/< row (php/aget tops col))             (php/aget sky-gradient row)
                                   (php/>= row (php/aget bots col))            (php/aget floor-gradient row)
                                   (php/aget emask col)
                                   (if (php/< row (php/aget mids col)) ehead ebody)
                                   (php/=== row (php/aget tops col))
                                   (php/aget shades-top-edge col)
                                   (php/=== row (php/- (php/aget bots col) 1))
                                   (php/aget shades-bot-edge col)
                                   :else
                                   (php/aget shades-normal col))))]
                     (cond
                       (php/=== run 0)  (recur (php/+ col 1) c 1)
                       (php/=== c prev) (recur (php/+ col 1) prev (php/+ run 1))
                       :else            (do
                                          (php/array_push parts prev)
                                          (php/array_push parts (php/str_repeat " " (php/- run 1)))
                                          (recur (php/+ col 1) c 1))))))
               (php/array_push parts "\e[0m\n"))
      (php/array_push parts (hud-line world stats))
      (dotimes [i visible-mh]
               (php/array_push parts (str "\e[" (php/+ map-row i) ";" map-col "H" (php/aget mrows i))))
      ;; Crosshair: dim white + at exact viewport centre so the player
      ;; always knows where a shot would land. Drawn AFTER walls/sprites
      ;; via absolute cursor positioning so wall colours don't bleed
      ;; into the glyph cell.
      (php/array_push parts
                      (str "\e[" (php/+ (php/intdiv vh 2) 1) ";"
                           (php/+ (php/intdiv vw 2) 1) "H\e[97;2m+\e[0m"))
      ;; Level intro splash: while :intro-secs > 0 (set fresh on every
      ;; build-world), overlay a centred banner with the level number
      ;; + monster name.
      (when (php/> (or (get stats :intro-secs) 0.0) 0.0)
        (let [title (str "LEVEL " (or (get stats :level) 1)
                         " · " (php/strtoupper (or (get stats :level-name) "")))]
          (let [bw  (php/+ (php/strlen title) 8)
                bar (php/str_repeat "─" bw)
                pad (php/str_repeat " " 4)]
            (let [row0 (php/max 1 (php/- (php/intdiv vh 2) 2))
                  col0 (php/max 1 (php/- (php/+ (php/intdiv vw 2) 1)
                                         (php/intdiv (php/+ bw 2) 2)))]
              (php/array_push parts
                              (str "\e[" row0 ";" col0 "H\e[40;93;1m┌" bar "┐"
                                   "\e[" (php/+ row0 1) ";" col0 "H\e[40;93;1m│" pad title pad "│"
                                   "\e[" (php/+ row0 2) ";" col0 "H\e[40;93;1m└" bar "┘"
                                   "\e[0m"))))))
      (let [l     (or (get stats :lives) 0)
            cap   (or (get stats :max-lives) 5)
            blink (if bloody? "\e[5;1m" "\e[1m")]
        (php/array_push parts
                        (str "\e[1;1H" blink "\e[91m"
                             (php/str_repeat "♥ " l)
                             "\e[90m"
                             (php/str_repeat "♡ " (php/max 0 (php/- cap l)))
                             "\e[0m")))
      (let [cc (php/+ (php/intdiv vw 2) 1)]
        (php/array_push parts
                        (str "\e[" (php/- vh 1) ";" (php/- cc 1) "H\e[97;1m ║ "
                             "\e[" vh ";" (php/- cc 1) "H\e[97;1m███"
                             "\e[0m"))
        (when (php/> (or (get stats :fire-anim) 0.0) 0.0)
          (php/array_push parts
                          (str "\e[" (php/- vh 4) ";" cc "H\e[93;1m✦"
                               "\e[" (php/- vh 3) ";" cc "H\e[93;1m*"
                               "\e[" (php/- vh 2) ";" (php/- cc 1) "H\e[93;1m*★*"
                               "\e[0m"))))
      (when (get stats :paused)
        (php/array_push parts (pause-menu-string vw vh (get stats :sound-on))))
      (php/implode "" parts))))

(defn clear-screen
  "ANSI clear + cursor home."
  {:export true}
  []
  (print "\e[2J\e[H"))

(defn render!
  "Move cursor home and overwrite the previous frame in place. Avoids
   the full-screen clear that would otherwise flicker each frame."
  {:export true}
  [world stats cols rows]
  (print "\e[H")
  (print (frame->string world stats cols rows))
  (php/flush))

;; ---------------------------------------------------------------------
;; End-of-game screens (death / victory).
;;
;; Same box geometry as the pause menu but full-screen washed in either
;; dark red (death) or dark green (victory). Both screens share
;; render-end-screen — the only thing each variant supplies is the
;; wash colour and the 32-wide row strings.
;; ---------------------------------------------------------------------

(def end-box-width 32)

(defn- end-pad
  "Right-pad `text` with spaces up to `width` visible columns."
  [text width]
  (str text (php/str_repeat " " (php/max 0 (php/- width (php/strlen text))))))

(defn- death-rows [kills survived-s]
  (let [w (end-pad "" end-box-width)]
    [w
     "\e[91;1m            YOU DIED            \e[0m"
     w :sep w
     (str "\e[97m" (end-pad (str "   kills:   " kills)        end-box-width) "\e[0m")
     (str "\e[97m" (end-pad (str "   time:    " survived-s "s") end-box-width) "\e[0m")
     w :sep w
     "\e[97;1m   r  restart      q  quit      \e[0m"
     w :sep w
     "\e[2;97m   phel-doom by Chemaclass      \e[0m"
     "\e[2;97m   written in Phel Lang         \e[0m"
     w]))

(defn- victory-rows [kills survived-s]
  (let [w (end-pad "" end-box-width)]
    [w
     "\e[92;1m            VICTORY!            \e[0m"
     w :sep w
     (str "\e[97m" (end-pad (str "   kills:   " kills)        end-box-width) "\e[0m")
     (str "\e[97m" (end-pad (str "   time:    " survived-s "s") end-box-width) "\e[0m")
     w :sep w
     "\e[97;1m   r  play again   q  quit      \e[0m"
     w :sep w
     "\e[2;97m   phel-doom by Chemaclass      \e[0m"
     "\e[2;97m   written in Phel Lang         \e[0m"
     w]))

(defn- render-end-screen
  "Generic end-of-game overlay: full-screen wash in `wash-bg` plus a
   centred ─┌┐│└┘ box whose contents are `items` (interior strings
   interleaved with :sep markers)."
  [cols rows wash-bg items]
  (let [parts (php/array)
        bar   (php/str_repeat "─" end-box-width)]
    (php/array_push parts "\e[H")
    (loop [r 1]
      (when (php/<= r rows)
        (php/array_push parts (str "\e[" r ";1H" wash-bg
                                   (php/str_repeat " " cols)))
        (recur (php/+ r 1))))
    (let [n       (count items)
          row-top (php/max 1 (php/- (php/intdiv rows 2) (php/intdiv n 2)))
          col0    (php/max 1 (php/- (php/+ (php/intdiv cols 2) 1)
                                    (php/intdiv (php/+ end-box-width 2) 2)))]
      (php/array_push parts (str "\e[" row-top ";" col0
                                 "H\e[40;97m┌" bar "┐\e[0m"))
      (php/array_push parts (str "\e[" (php/+ row-top n 1) ";" col0
                                 "H\e[40;97m└" bar "┘\e[0m"))
      (loop [i 0]
        (when (php/< i n)
          (let [item (get items i)
                row  (php/+ row-top 1 i)]
            (if (= item :sep)
              (php/array_push parts (str "\e[" row ";" col0
                                         "H\e[40;97m├" bar "┤\e[0m"))
              (php/array_push parts (str "\e[" row ";" col0
                                         "H\e[40;97m│" item "\e[40;97m│\e[0m"))))
          (recur (php/+ i 1)))))
    (print (php/implode "" parts))
    (php/flush)))

(defn render-death-screen
  "Centred YOU DIED box on a dark-red wash with cumulative kills + time."
  {:export true}
  [cols rows kills survived-s]
  (render-end-screen cols rows "\e[48;5;52m" (death-rows kills survived-s)))

(defn render-victory-screen
  "Centred VICTORY box on a dark-green wash after clearing all levels."
  {:export true}
  [cols rows kills survived-s]
  (render-end-screen cols rows "\e[48;5;22m" (victory-rows kills survived-s)))
