(ns phel-doom-tests.modules.core.physics-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.modules.core.state   :refer [new-world new-player])
  (:require phel-doom.modules.core.physics :refer [try-move apply-physics tick-heartbeat tick-flicker]))

;; Tiny 3x3 grid: walls around the perimeter, open centre.
(def open-world
  (new-world [[1 1 1]
              [1 0 1]
              [1 1 1]]
             (new-player 1.5 1.5 0.0)))

;; 3x3 with no walls — for unconstrained motion checks.
(def empty-world
  (new-world [[0 0 0]
              [0 0 0]
              [0 0 0]]
             (new-player 1.5 1.5 0.0)))

;; ---------------------------------------------------------------------
;; try-move: wall collision is the only contract.
;; ---------------------------------------------------------------------

(deftest test-try-move-into-open-cell
  (let [w (try-move empty-world 0.5 0.0)
        p (:player w)]
    (is (< (php/abs (- (:x p) 2.0)) 0.0001))
    (is (< (php/abs (- (:y p) 1.5)) 0.0001))))

(deftest test-try-move-blocked-by-wall
  ;; Walking east from (1.5, 1.5) lands in cell (2, 1), which is a wall
  ;; in `open-world`. Player should NOT move.
  (let [w (try-move open-world 1.0 0.0)
        p (:player w)]
    (is (= 1.5 (:x p)))
    (is (= 1.5 (:y p)))))

(deftest test-try-move-zero-delta-noop
  (let [w (try-move open-world 0.0 0.0)
        p (:player w)]
    (is (= 1.5 (:x p)))
    (is (= 1.5 (:y p)))))

;; ---------------------------------------------------------------------
;; apply-physics: counters drive movement, decay each frame.
;; ---------------------------------------------------------------------

(deftest test-apply-physics-walks-forward-while-fwd-counter-on
  ;; Stamp the :fwd counter and tick one frame. Player should have
  ;; moved east (angle 0 = +x).
  (let [w0 (assoc-in empty-world [:moves :fwd] 5)
        w1 (apply-physics w0 0.1)]
    (is (> (:x (:player w1)) 1.5))
    ;; Counter decayed by one frame.
    (is (= 4 (:fwd (:moves w1))))))

(deftest test-apply-physics-idle-counters-decay-to-zero
  ;; Single-frame counter goes to 0 after one tick.
  (let [w0 (assoc-in empty-world [:moves :fwd] 1)
        w1 (apply-physics w0 0.1)
        w2 (apply-physics w1 0.1)]
    (is (= 0 (:fwd (:moves w1))))
    (is (= 0 (:fwd (:moves w2))))))

(deftest test-apply-physics-turns-via-counter
  (let [w0 (assoc-in empty-world [:moves :turn-right] 3)
        w1 (apply-physics w0 0.1)]
    (is (> (:angle (:player w1)) 0.0))
    (is (= 2 (:turn-right (:moves w1))))))

(deftest test-apply-physics-no-counters-is-noop
  (let [p0 (:player empty-world)
        w1 (apply-physics empty-world 0.1)
        p1 (:player w1)]
    (is (= (:x p0) (:x p1)))
    (is (= (:y p0) (:y p1)))
    (is (= (:angle p0) (:angle p1)))))

(deftest test-apply-physics-wall-blocks-but-counter-still-decays
  ;; dt large enough that the requested move overshoots the open cell
  ;; (1,1) into the wall at (2,1). Player stays put, counter still
  ;; decays so a player pushed against a wall doesn't build up
  ;; potential energy.
  (let [w0 (assoc-in open-world [:moves :fwd] 3)
        w1 (apply-physics w0 1.0)]
    (is (= 1.5 (:x (:player w1))))
    (is (= 2 (:fwd (:moves w1))))))

;; ---------------------------------------------------------------------
;; tick-heartbeat: phase loops only when low on lives; the wrap flag
;; fires exactly on the frame the phase rolls past 1.0.
;; ---------------------------------------------------------------------

(deftest test-tick-heartbeat-silent-at-full-lives
  (let [w0 (assoc empty-world :lives 5 :heartbeat-phase 0.0)
        w1 (tick-heartbeat w0 0.5)]
    (is (= 0.0 (:heartbeat-phase w1)))
    (is (= false (:heartbeat-tick? w1)))))

(deftest test-tick-heartbeat-silent-when-dead
  (let [w0 (assoc empty-world :lives 0 :heartbeat-phase 0.4)
        w1 (tick-heartbeat w0 0.5)]
    (is (= 0.0 (:heartbeat-phase w1)))
    (is (= false (:heartbeat-tick? w1)))))

(deftest test-tick-heartbeat-advances-phase-at-2-lives
  (let [w0 (assoc empty-world :lives 2 :heartbeat-phase 0.0)
        w1 (tick-heartbeat w0 0.1)]
    (is (> (:heartbeat-phase w1) 0.0))
    (is (< (:heartbeat-phase w1) 1.0))
    (is (= false (:heartbeat-tick? w1)))))

(deftest test-tick-heartbeat-wraps-and-flips-tick-flag
  ;; Big-enough dt to push phase across 1.0 in one frame, so we can
  ;; assert the wrap behaviour without depending on the exact interval.
  (let [w0 (assoc empty-world :lives 1 :heartbeat-phase 0.0)
        w1 (tick-heartbeat w0 5.0)]
    (is (= true (:heartbeat-tick? w1)))
    (is (< (:heartbeat-phase w1) 1.0))
    (is (>= (:heartbeat-phase w1) 0.0))))

;; ---------------------------------------------------------------------
;; tick-flicker: cooldown counts down then triggers a brief active
;; window. While active, the active-secs counter is what counts down
;; — cooldown is held until the flicker ends.
;; ---------------------------------------------------------------------

(deftest test-tick-flicker-decrements-cooldown-when-idle
  (let [w  (assoc empty-world :lives 5 :flicker-cooldown 10.0 :flicker-active-secs 0.0)
        w' (tick-flicker w 0.5)]
    (is (= 9.5 (:flicker-cooldown w')))
    (is (= 0.0 (:flicker-active-secs w')))))

(deftest test-tick-flicker-fires-when-cooldown-hits-zero
  (let [w  (assoc empty-world :lives 5 :flicker-cooldown 0.0 :flicker-active-secs 0.0)
        w' (tick-flicker w 0.1)]
    (is (php/> (:flicker-active-secs w') 0.0))
    ;; New cooldown sampled into the lives>=5 band (20..30s).
    (is (php/>= (:flicker-cooldown w') 20.0))
    (is (php/<= (:flicker-cooldown w') 30.0))))

(deftest test-tick-flicker-decrements-active-secs-while-active
  (let [w  (assoc empty-world :lives 5 :flicker-cooldown 12.0 :flicker-active-secs 0.15)
        w' (tick-flicker w 0.05)]
    (is (< (php/abs (- (:flicker-active-secs w') 0.10)) 0.0001))
    ;; Cooldown is frozen while active so the next gap restarts cleanly.
    (is (= 12.0 (:flicker-cooldown w')))))

;; ---------------------------------------------------------------------
;; Inverted controls after a hit: :invert-secs > 0 means the :moves
;; map is read with each opposing pair swapped, so :fwd takes the
;; player backward etc. Counter decay still runs (apply-physics decays
;; the underlying map, not the swapped view).
;; ---------------------------------------------------------------------

(deftest test-apply-physics-inverted-fwd-walks-backward
  ;; Stamp :fwd while inverted. Player faces east; inverted :fwd
  ;; should pull them west (x decreases).
  (let [w0 (assoc empty-world :invert-secs 0.5)
        w1 (apply-physics (assoc-in w0 [:moves :fwd] 5) 0.1)]
    (is (< (:x (:player w1)) 1.5))))

(deftest test-apply-physics-inverted-back-walks-forward
  (let [w0 (assoc empty-world :invert-secs 0.5)
        w1 (apply-physics (assoc-in w0 [:moves :back] 5) 0.1)]
    (is (> (:x (:player w1)) 1.5))))

(deftest test-apply-physics-inverted-turn-right-rotates-left
  (let [w0 (assoc empty-world :invert-secs 0.5)
        w1 (apply-physics (assoc-in w0 [:moves :turn-right] 3) 0.1)]
    ;; Inverted turn-right should rotate counter-clockwise (negative).
    (is (< (:angle (:player w1)) 0.0))))

(deftest test-apply-physics-invert-off-is-noop-for-fwd
  ;; Same input, no invert — must walk forward, not backward.
  (let [w0 (assoc empty-world :invert-secs 0.0)
        w1 (apply-physics (assoc-in w0 [:moves :fwd] 5) 0.1)]
    (is (> (:x (:player w1)) 1.5))))

(deftest test-tick-flicker-low-life-resamples-into-faster-band
  ;; When the flicker fires at 1 life, the new cooldown should be in
  ;; the haunted-band (6..12), shorter than the calm 20..30 band.
  (let [w  (assoc empty-world :lives 1 :flicker-cooldown 0.0 :flicker-active-secs 0.0)
        w' (tick-flicker w 0.1)]
    (is (php/>= (:flicker-cooldown w') 6.0))
    (is (php/<= (:flicker-cooldown w') 12.0))))

(deftest test-tick-heartbeat-faster-at-1-life-than-2
  ;; Same dt, same start phase — 1-life run should be further along
  ;; (shorter interval = faster phase accumulation).
  (let [w-low (tick-heartbeat (assoc empty-world :lives 1 :heartbeat-phase 0.0) 0.1)
        w-mid (tick-heartbeat (assoc empty-world :lives 2 :heartbeat-phase 0.0) 0.1)]
    (is (> (:heartbeat-phase w-low) (:heartbeat-phase w-mid)))))
