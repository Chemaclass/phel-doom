(ns phel-doom-tests.core.projection-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.core.engine :refer [max-depth])
  (:require phel-doom.core.projection :refer [wall-px project-height pitch-rows pitch-cap
                                              bob-rows bob-cap
                                              weapon-bob-rows weapon-bob-cols
                                              weapon-bob-cap weapon-sway-cap
                                              sprite-half-rows tier-top-row-dist
                                              ceiling-top-row-dist floor-cast-num]))

;; ---------------------------------------------------------------------
;; wall-px: the shared projection kernel. num / ((max 0.3 dist) * 2.0).
;; ---------------------------------------------------------------------

(deftest wall-px-unit-distance
  ;; 70 / (1.0 * 2.0) = 35
  (is (= 35.0 (wall-px 70.0 1.0))))

(deftest wall-px-distance-floor
  ;; dist below 0.3 clamps to 0.3, so a surface in the player's own cell
  ;; can't blow up to an infinite slice.
  (is (= (wall-px 70.0 0.3) (wall-px 70.0 0.05)))
  (is (= (wall-px 70.0 0.3) (wall-px 70.0 0.0))))

(deftest wall-px-monotonic-in-distance
  ;; Farther away looks shorter.
  (is (php/> (wall-px 70.0 1.0) (wall-px 70.0 2.0)))
  (is (php/> (wall-px 70.0 2.0) (wall-px 70.0 4.0))))

;; ---------------------------------------------------------------------
;; project-height: world height -> screen row.
;; ---------------------------------------------------------------------

(deftest project-height-horizon-at-eye
  ;; z == eye-z lands exactly on the horizon (vh/2) at any distance.
  (is (= 15.0 (project-height 70.0 30 1.0 0.5 0.5)))
  (is (= 15.0 (project-height 70.0 30 9.9 0.5 0.5))))

(deftest project-height-wall-centred-on-horizon
  ;; A one-unit wall (z=1 top, z=0 bottom) straddles the horizon
  ;; symmetrically: midpoint is exactly vh/2.
  (let [top (project-height 70.0 30 2.0 0.5 1.0)
        bot (project-height 70.0 30 2.0 0.5 0.0)]
    (is (= 15.0 (php// (php/+ top bot) 2.0)) "midpoint on horizon")
    (is (php/< top 15.0) "top above horizon")
    (is (php/> bot 15.0) "bottom below horizon")))

(deftest project-height-nearer-is-taller
  ;; Closer wall top projects higher up the screen (smaller row).
  (is (php/< (project-height 70.0 30 1.0 0.5 1.0)
             (project-height 70.0 30 4.0 0.5 1.0))))

(deftest project-height-raising-eye-sinks-world-point
  ;; Looking from a higher eye pushes a fixed world height DOWN the
  ;; screen (larger row) - the basis for stepping onto a platform.
  (is (php/> (project-height 70.0 30 2.0 0.8 1.0)
             (project-height 70.0 30 2.0 0.3 1.0))))

(deftest project-height-reconciles-with-wall-pipeline
  ;; Contract: project-height at z=1 / z=0 (eye 0.5) agrees with the
  ;; integer top/bot the renderer derives from wall-px, on an even-gap
  ;; case (dist 2.5 -> wall-h 14, gap 16). Confirms both the cell-res
  ;; wall path and the general primitive share one kernel.
  (let [pd     70.0 vh     30 dist   2.5
        wall-h (php/min vh (php/intval (wall-px pd dist)))
        top    (php/intdiv (php/- vh wall-h) 2)
        bot    (php/+ top wall-h)]
    (is (= top (php/intval (php/round (project-height pd vh dist 0.5 1.0)))))
    (is (= bot (php/intval (php/round (project-height pd vh dist 0.5 0.0)))))))

;; ---------------------------------------------------------------------
;; pitch-rows: normalised look up/down fraction -> integer horizon shear.
;; ---------------------------------------------------------------------

(deftest pitch-rows-zero-is-zero
  ;; The byte-identical contract: no pitch shears the horizon by nothing
  ;; at every viewport height.
  (is (= 0 (pitch-rows 0.0 30)))
  (is (= 0 (pitch-rows 0.0 24)))
  (is (= 0 (pitch-rows 0.0 44))))

(deftest pitch-rows-positive-looks-up-shears-down
  ;; POSITIVE pitch (look up) shears the horizon DOWN the screen, i.e.
  ;; toward larger row numbers, so the offset is positive.
  (is (php/> (pitch-rows 1.0 30) 0))
  (is (php/> (pitch-rows 0.5 30) 0)))

(deftest pitch-rows-negative-looks-down-shears-up
  ;; NEGATIVE pitch (look down) shears the horizon UP (smaller rows).
  (is (php/< (pitch-rows -1.0 30) 0))
  (is (php/< (pitch-rows -0.5 30) 0)))

(deftest pitch-rows-sign-is-antisymmetric
  ;; Equal-and-opposite pitch gives equal-and-opposite shear.
  (is (= (php/- 0 (pitch-rows 0.7 30)) (pitch-rows -0.7 30))))

(deftest pitch-rows-magnitude-grows-with-pitch
  ;; Looking further up shears the horizon further down.
  (is (php/> (pitch-rows 1.0 30) (pitch-rows 0.5 30)))
  (is (php/> (pitch-rows 0.5 30) (pitch-rows 0.25 30))))

(deftest pitch-rows-caps-at-pitch-cap-fraction
  ;; Full pitch shears by exactly round(pitch-cap * vh) rows - the
  ;; documented ceiling (0.4 * 30 = 12).
  (is (= (php/intval (php/round (php/* pitch-cap 30))) (pitch-rows 1.0 30)))
  (is (= (php/- 0 (php/intval (php/round (php/* pitch-cap 30)))) (pitch-rows -1.0 30))))

(deftest pitch-rows-returns-int
  ;; Always an integer scene-row offset (round, not float), so it can
  ;; index gradient arrays / add to integer wall tops cleanly.
  (is (php/is_int (pitch-rows 0.37 30)))
  (is (php/is_int (pitch-rows -0.81 44))))

;; ---------------------------------------------------------------------
;; bob-rows: distance-driven head-bob horizon shear (issue #411). A
;; sibling of pitch-rows that swings the horizon on a walk-cycle phase,
;; scaled by the View bob intensity setting in [0, 1].
;; ---------------------------------------------------------------------

(def half-pi (php/* 0.5 php/M_PI))

(deftest bob-rows-zero-phase-is-zero
  ;; Byte-identical-at-rest contract: phase 0 (the resting phase set by
  ;; physics) shears by nothing at any height / intensity.
  (is (= 0 (bob-rows 0.0 1.0 30)))
  (is (= 0 (bob-rows 0.0 1.0 24)))
  (is (= 0 (bob-rows 0.0 0.5 44))))

(deftest bob-rows-zero-intensity-is-zero
  ;; View bob off (intensity 0, the default) never shears, even at the
  ;; peak of the walk cycle - so an off frame is byte-identical.
  (is (= 0 (bob-rows half-pi 0.0 30)))
  (is (= 0 (bob-rows (php/* 1.5 php/M_PI) 0.0 44))))

(deftest bob-rows-swings-both-ways
  ;; sin(phase): the up half of the cycle shears one way, the down half
  ;; the other, symmetric about the horizon.
  (is (php/> (bob-rows half-pi 1.0 30) 0))
  (is (php/< (bob-rows (php/* 1.5 php/M_PI) 1.0 30) 0)))

(deftest bob-rows-antisymmetric-in-phase
  ;; Opposite points of the cycle give equal-and-opposite shear.
  (is (= (php/- 0 (bob-rows half-pi 1.0 30))
         (bob-rows (php/- 0 half-pi) 1.0 30))))

(deftest bob-rows-grows-with-intensity
  ;; A higher View bob setting nods further. vh 40: full = round(0.05*40)
  ;; = 2, half = round(1.0) = 1, so the two are distinct (not a rounding
  ;; artefact that would pass without scaling by intensity).
  (is (php/> (bob-rows half-pi 1.0 40) (bob-rows half-pi 0.5 40))))

(deftest bob-rows-caps-at-bob-cap-fraction
  ;; Peak of the cycle at full intensity shears by exactly
  ;; round(bob-cap * vh) rows.
  (is (= (php/intval (php/round (php/* bob-cap 40))) (bob-rows half-pi 1.0 40))))

(deftest bob-rows-returns-int
  ;; Integer scene-row offset, so it adds to pitch-rows and integer wall
  ;; tops cleanly.
  (is (php/is_int (bob-rows 1.1 0.7 30)))
  (is (php/is_int (bob-rows 0.0 0.0 44))))

;; ---------------------------------------------------------------------
;; weapon-bob-rows / weapon-bob-cols: idle viewmodel bob + sway (#412).
;; Share `:bob-phase` and the View bob intensity with head-bob, but the
;; gun traces a downward bowl (|sin| vertical, always dips, never rises
;; above rest) with a left-right sway (sin horizontal) - not a horizon
;; shear.
;; ---------------------------------------------------------------------

(deftest weapon-bob-zero-phase-is-zero
  ;; Byte-identical-at-rest: phase 0 leaves the gun at its resting anchor
  ;; in both axes at any height / width / intensity.
  (is (= 0 (weapon-bob-rows 0.0 1.0 30)))
  (is (= 0 (weapon-bob-cols 0.0 1.0 120)))
  (is (= 0 (weapon-bob-rows 0.0 0.5 44)))
  (is (= 0 (weapon-bob-cols 0.0 0.5 80))))

(deftest weapon-bob-zero-intensity-is-zero
  ;; Motion setting off (the default) never moves the gun, even at the
  ;; peak of the walk cycle.
  (is (= 0 (weapon-bob-rows half-pi 0.0 30)))
  (is (= 0 (weapon-bob-cols half-pi 0.0 120))))

(deftest weapon-bob-rows-only-dips
  ;; |sin| bowl: both peaks of the walk cycle push the gun DOWN (positive
  ;; row shift = lower on screen); it never rises above rest. This is what
  ;; distinguishes it from head-bob's symmetric sin swing.
  (is (php/> (weapon-bob-rows half-pi 1.0 40) 0))
  (is (php/> (weapon-bob-rows (php/* 1.5 php/M_PI) 1.0 40) 0)))

(deftest weapon-bob-rows-peaks-twice-per-cycle
  ;; |sin| => the two half-cycle peaks give the same downward dip.
  (is (= (weapon-bob-rows half-pi 1.0 40)
         (weapon-bob-rows (php/* 1.5 php/M_PI) 1.0 40))))

(deftest weapon-bob-cols-sways-both-ways
  ;; sin(phase): the gun sweeps right on the up half, left on the down.
  (is (php/> (weapon-bob-cols half-pi 1.0 120) 0))
  (is (php/< (weapon-bob-cols (php/* 1.5 php/M_PI) 1.0 120) 0)))

(deftest weapon-bob-cols-antisymmetric-in-phase
  ;; Opposite points of the cycle sway equal-and-opposite.
  (is (= (php/- 0 (weapon-bob-cols half-pi 1.0 120))
         (weapon-bob-cols (php/- 0 half-pi) 1.0 120))))

(deftest weapon-bob-grows-with-intensity
  ;; vh 40 vertical: full = round(0.04*40) = 2, half = round(0.8) = 1.
  ;; vw 80 horizontal: full = round(0.02*80) = 2, half = round(0.8) = 1.
  (is (php/> (weapon-bob-rows half-pi 1.0 40) (weapon-bob-rows half-pi 0.5 40)))
  (is (php/> (weapon-bob-cols half-pi 1.0 80) (weapon-bob-cols half-pi 0.5 80))))

(deftest weapon-bob-caps-at-cap-fraction
  ;; Peak of the cycle at full intensity: round(weapon-bob-cap * vh) rows
  ;; down, round(weapon-sway-cap * vw) cols across.
  (is (= (php/intval (php/round (php/* weapon-bob-cap 40))) (weapon-bob-rows half-pi 1.0 40)))
  (is (= (php/intval (php/round (php/* weapon-sway-cap 120))) (weapon-bob-cols half-pi 1.0 120))))

(deftest weapon-bob-returns-int
  ;; Integer row / col offsets, so they fold into the sprite anchor cleanly.
  (is (php/is_int (weapon-bob-rows 1.1 0.7 30)))
  (is (php/is_int (weapon-bob-cols 1.1 0.7 120)))
  (is (php/is_int (weapon-bob-rows 0.0 0.0 44)))
  (is (php/is_int (weapon-bob-cols 0.0 0.0 80))))

;; ---------------------------------------------------------------------
;; sprite-half-rows: half the on-screen billboard height (rows) the
;; vertical hitscan gate (issue #243) compares against |pitch-rows|.
;; Mirrors the renderer's sprite height exactly:
;;   h = min(svh, intval(scale * proj-dist / (max(0.5, dist) * char-aspect)))
;; with proj-dist = 70, char-aspect = 2; the helper returns h / 2.
;; ---------------------------------------------------------------------

(deftest sprite-half-rows-clamped-near
  ;; Very close (dist below the 0.5 floor): raw height
  ;; 70 / (0.5 * 2) = 70, clamped to svh=30, halved => 15.0.
  (is (= 15.0 (sprite-half-rows 30 0.25 1.0))))

(deftest sprite-half-rows-distant-shrinks
  ;; Far enemy: 70 / (10 * 2) = 3.5 -> intval 3 -> /2 = 1.5. A distant
  ;; sprite leaves the crosshair almost no vertical slack.
  (is (= 1.5 (sprite-half-rows 30 10.0 1.0))))

(deftest sprite-half-rows-closer-is-more-forgiving
  ;; Monotonic: a nearer enemy always projects at least as many rows as a
  ;; farther one, so the gate is strictly more forgiving up close.
  (is (php/>= (sprite-half-rows 30 2.0 1.0)
              (sprite-half-rows 30 8.0 1.0))))

(deftest sprite-half-rows-boss-scale-bigger
  ;; The 2x boss billboard is taller than a standard enemy at the same
  ;; depth, so its half-height (hence its vertical slack) is larger.
  (is (php/> (sprite-half-rows 30 10.0 2.0)
             (sprite-half-rows 30 10.0 1.0))))

(deftest sprite-half-rows-boss-far-value
  ;; 2 * 70 / (10 * 2) = 7 -> intval 7 -> /2 = 3.5.
  (is (= 3.5 (sprite-half-rows 30 10.0 2.0))))

(deftest sprite-half-rows-capped-by-svh
  ;; The height never exceeds svh, so the half-rows never exceeds svh/2
  ;; even at point-blank range with the boss scale.
  (is (= 7.5 (sprite-half-rows 15 0.5 2.0))))

(deftest sprite-half-rows-full-pitch-still-on-near-sprite
  ;; svh 30: full look-up shears the horizon 12 rows; a point-blank
  ;; sprite (half-rows 15) still spans the crosshair (|12| <= 15).
  (is (php/<= (php/abs (pitch-rows 1.0 30))
              (sprite-half-rows 30 0.5 1.0))))

;; ---------------------------------------------------------------------
;; tier-top-row-dist: height-aware floor-cast row distance (issue #370).
;; General inversion of project-height; build-floor-dperp's
;; floor-cast-k / p is the special case eye-z=0.5, z=0.0.
;; ---------------------------------------------------------------------

(deftest tier-top-row-dist-flat-case-matches-floor-cast-k
  ;; z=0, eye-z=0.5: floor-cast-k = 70 * 0.5 / 2 = 17.5, so p=5 gives 3.5 -
  ;; the same numerator build-floor-dperp uses for the flat floor.
  (is (= 3.5 (tier-top-row-dist 70.0 5.0 0.5 0.0))))

(deftest tier-top-row-dist-raised-tier-is-nearer
  ;; A higher floor (z closer to eye-z) needs a SMALLER perpendicular
  ;; distance to land on the same screen row - the tier top is "closer"
  ;; to the horizon than the ground at the same row.
  (is (php/< (tier-top-row-dist 70.0 5.0 0.5 0.25)
             (tier-top-row-dist 70.0 5.0 0.5 0.0))))

(deftest tier-top-row-dist-reconciles-with-project-height
  ;; Round-trip: project-height's row for a given dist/z/eye-z, fed back
  ;; through tier-top-row-dist at the resulting p, returns the same dist.
  (let [pd    70.0 vh    30 dist  4.0 eye-z 0.6 z     0.25
        row   (project-height pd vh dist eye-z z)
        p     (php/- row (php// vh 2.0))]
    (is (< (php/abs (php/- dist (tier-top-row-dist pd p eye-z z))) 0.001))))

(deftest tier-top-row-dist-at-or-above-horizon-is-max-depth
  ;; p <= 0 means the row is at/above the horizon - never sampled as
  ;; floor, mirrors build-floor-dperp's row >= vh/2 guard.
  (is (= max-depth (tier-top-row-dist 70.0 0.0 0.5 0.0)))
  (is (= max-depth (tier-top-row-dist 70.0 -2.0 0.5 0.0))))

(deftest tier-top-row-dist-clamped-to-max-depth
  ;; A tiny p (row hugging the horizon) would blow up toward infinity;
  ;; clamp matches build-floor-dperp's ceiling.
  (is (= max-depth (tier-top-row-dist 70.0 0.001 0.5 0.0))))

;; ---------------------------------------------------------------------
;; ceiling-top-row-dist: the ceiling mirror of tier-top-row-dist (#387).
;; z > eye-z projects ABOVE the horizon, so p = row - horizon is negative.
;; ---------------------------------------------------------------------

(deftest ceiling-top-row-dist-flat-ceiling-case
  ;; z=1, eye-z=0.5: (z-eye-z)*pd = 0.5*70 = 35; p=-5 gives 35/(5*2) = 3.5,
  ;; the ceiling mirror of the flat floor's floor-cast-k / p.
  (is (= 3.5 (ceiling-top-row-dist 70.0 -5.0 0.5 1.0))))

(deftest ceiling-top-row-dist-lower-ceiling-is-nearer
  ;; A lower ceiling (z closer to eye-z) needs a SMALLER perpendicular
  ;; distance to land on the same screen row - it hangs "closer" to the
  ;; horizon than the full-height ceiling at the same row.
  (is (php/< (ceiling-top-row-dist 70.0 -5.0 0.5 0.75)
             (ceiling-top-row-dist 70.0 -5.0 0.5 1.0))))

(deftest ceiling-top-row-dist-reconciles-with-project-height
  ;; Round-trip: project-height's row for a ceiling z/dist/eye-z, fed back
  ;; through ceiling-top-row-dist at the resulting (negative) p, returns
  ;; the same dist.
  (let [pd    70.0 vh    30 dist  4.0 eye-z 0.5 z     0.75
        row   (project-height pd vh dist eye-z z)
        p     (php/- row (php// vh 2.0))]
    (is (< (php/abs (php/- dist (ceiling-top-row-dist pd p eye-z z))) 0.001))))

(deftest ceiling-top-row-dist-at-or-below-horizon-is-max-depth
  ;; p >= 0 means the row is at/below the horizon - never sampled as
  ;; ceiling, mirrors tier-top-row-dist's p <= 0 guard.
  (is (= max-depth (ceiling-top-row-dist 70.0 0.0 0.5 1.0)))
  (is (= max-depth (ceiling-top-row-dist 70.0 2.0 0.5 1.0))))

(deftest ceiling-top-row-dist-clamped-to-max-depth
  ;; A tiny |p| (row hugging the horizon) would blow up toward infinity;
  ;; clamp matches tier-top-row-dist's ceiling.
  (is (= max-depth (ceiling-top-row-dist 70.0 -0.001 0.5 1.0))))

;; ---------------------------------------------------------------------
;; floor-cast-num: eye-height-aware floor-cast numerator. dperp = num / p.
;; z=0 is the base ground plane, z>0 is a raised tier top. The shipped
;; flat floor baked eye=0.5,z=0 into the io-side floor-cast-k const; this
;; is the pure, general source of that numerator.
;; ---------------------------------------------------------------------

(deftest floor-cast-num-flat-matches-floor-cast-k
  ;; eye 0.5, z 0: 70 * 0.5 / 2 = 17.5 - the exact numerator the flat
  ;; floor-cast-k const carries, so the eye-aware table stays byte-identical.
  (is (= 17.5 (floor-cast-num 70.0 0.5 0.0))))

(deftest floor-cast-num-eye-scales-linearly
  ;; Doubling the eye height doubles the numerator: a floor row projects
  ;; to twice the distance, so the ground recedes faster when you climb.
  (is (= 35.0 (floor-cast-num 70.0 1.0 0.0))))

(deftest floor-cast-num-uses-eye-minus-z
  ;; Only the eye-above-surface gap matters: eye 0.75 over a z=0.25 tier
  ;; gives the SAME 17.5 as eye 0.5 over z=0 - proves it is (eye-z - z),
  ;; not eye-z alone (a non-round pair a broken eye-z-only impl fails).
  (is (= 17.5 (floor-cast-num 70.0 0.75 0.25))))

(deftest floor-cast-num-reconciles-tier-top-row-dist
  ;; Contract: dperp = floor-cast-num / p equals the wired tier-top-row-dist
  ;; at the same p (unclamped range), so the renderer's row-remap treads and
  ;; the pure kernel agree to the bit. p=5 keeps it under max-depth.
  (is (< (php/abs (php/- (php// (floor-cast-num 70.0 0.5 0.25) 5.0)
                         (tier-top-row-dist 70.0 5.0 0.5 0.25)))
         1e-9)))
