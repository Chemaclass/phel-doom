(ns phel-doom.core.settings)

;; ---------------------------------------------------------------------
;; Settings model (pure).
;;
;; The player-facing options page: bg-music volume, sfx volume, the
;; default minimap state, and the default difficulty. Volumes are
;; stored as 0..100 percentages (step 10) so the slider math is integer
;; and the persisted JSON is human-readable.
;;
;; This namespace owns the DATA: defaults, coercion of loaded values,
;; cursor movement, value adjustment, and the percent -> playback-scalar
;; mapping. It performs no IO: io/settings loads + saves the map, and
;; commands/play applies the resulting volumes to io/sound + io/music.
;; ---------------------------------------------------------------------

(def default-settings
  "Out-of-the-box options. Music sits under the sfx by default (the OST
   is a bed, not a lead). Minimap starts hidden; difficulty normal.
   Mouse on by default (FPS-style mouselook, #246), sensitivity 50% (the
   neutral 1.0x multiplier - see `mouse-sensitivity`)."
  {:music 60 :sfx 90 :minimap false :difficulty :normal
   :crosshair :cross :timer false :high-contrast false :colorblind :none
   :mouse true :sensitivity 50})

(def difficulty-choices
  "Difficulty keywords the enum field cycles through, easiest first.
   Mirrors the --difficulty CLI option."
  [:easy :normal :hard :nightmare])

(def crosshair-choices
  "Crosshair reticle styles the enum field cycles through. `:off` hides
   the idle reticle entirely (the hit-marker still flashes on a hit)."
  [:cross :dot :open :off])

(def colorblind-choices
  "Colour-vision-deficiency modes the enum field cycles through (issue
   #200). `:none` keeps the default palette; the others swap the
   minimap keycard + door markers - the only glyphs distinguished by
   COLOUR alone - to a CVD-safe triad. `:deuteran` and `:protan` share
   the red-green-safe set; `:tritan` uses the blue-yellow-safe set."
  [:none :deuteran :protan :tritan])

(def pct-step
  "Percent a volume field moves per left/right press."
  10)

(def music-ceiling
  "afplay -v value the OST plays at when Music is 100%. Capped below
   1.0 so a maxed bed still never masks footsteps / shots. 60% (the
   default) maps to 0.30."
  0.5)

(def page-fields
  "Ordered field descriptors driving both navigation and rendering.
   `:kind` selects the adjust + paint behaviour (:pct slider, :bool
   toggle, :enum cycle). An :enum field carries its own `:choices`
   vector so the cycle logic is generic (not difficulty-specific)."
  [{:key :music          :label "Music"          :kind :pct}
   {:key :sfx            :label "SFX"            :kind :pct}
   {:key :minimap        :label "Minimap"        :kind :bool}
   {:key :difficulty     :label "Difficulty"     :kind :enum :choices difficulty-choices}
   {:key :crosshair      :label "Crosshair"      :kind :enum :choices crosshair-choices}
   {:key :timer          :label "Run timer"      :kind :bool}
   {:key :mouse          :label "Mouse"          :kind :bool}
   {:key :sensitivity    :label "Sensitivity"    :kind :pct}
   {:key :high-contrast  :label "High contrast"  :kind :bool}
   {:key :colorblind     :label "Colorblind"     :kind :enum :choices colorblind-choices}])

(defn field-count
  "How many rows the settings page has."
  []
  (count page-fields))

(defn field-at
  "Field descriptor at cursor index `idx`, or nil when out of range."
  [idx]
  (get page-fields idx))

(defn- clamp-pct [n]
  (php/max 0 (php/min 100 (php/intval n))))

(defn- index-of [v coll]
  (loop [i 0 cs coll]
    (cond
      (empty? cs)      -1
      (= (first cs) v) i
      :else            (recur (php/+ i 1) (rest cs)))))

(defn valid-difficulty?
  "True when `d` is one of the difficulty-choices keywords. Exposed so
   the CLI override path can validate a --difficulty value against the
   single source of truth."
  [d]
  (php/>= (index-of d difficulty-choices) 0))

(defn coerce-settings
  "Normalise a loaded (or partial) settings map against the defaults:
   clamp the percent fields (volumes + mouse sensitivity) into 0..100,
   force the bool fields (minimap, run timer, mouse) to booleans, and
   fall back to a valid choice for the enums (:normal
   difficulty, :cross crosshair) when the saved value is unrecognised.
   Always returns a complete, valid map, so callers downstream never
   have to re-validate."
  [raw]
  (let [m (or raw {})
        d (get m :difficulty (:difficulty default-settings))
        x (get m :crosshair (:crosshair default-settings))
        c (get m :colorblind (:colorblind default-settings))]
    {:music          (clamp-pct (get m :music (:music default-settings)))
     :sfx            (clamp-pct (get m :sfx (:sfx default-settings)))
     :minimap        (boolean (get m :minimap (:minimap default-settings)))
     :difficulty     (if (valid-difficulty? d) d :normal)
     :crosshair      (if (php/>= (index-of x crosshair-choices) 0) x :cross)
     :timer          (boolean (get m :timer (:timer default-settings)))
     :mouse          (boolean (get m :mouse (:mouse default-settings)))
     :sensitivity    (clamp-pct (get m :sensitivity (:sensitivity default-settings)))
     :high-contrast  (boolean (get m :high-contrast (:high-contrast default-settings)))
     :colorblind     (if (php/>= (index-of c colorblind-choices) 0) c :none)}))

(defn- wrap [i n]
  (php/% (php/+ (php/% i n) n) n))

(defn move-cursor
  "Move the page cursor by `steps` (negative = up, positive = down),
   wrapping at both ends. Any integer magnitude is allowed so a held
   key's OS-repeat burst can move more than one row in a frame."
  [idx steps]
  (wrap (php/+ idx steps) (field-count)))

;; ---------------------------------------------------------------------
;; Pause menu (issue #203): a navigable top-level menu shown when paused,
;; sitting in front of the settings page. Pure model only - the game loop
;; (commands/play) acts on the resolved action keyword.
;; ---------------------------------------------------------------------

(def pause-menu-options
  "Top-level pause-menu entries in display order. Selecting one resolves
   to an action the game loop acts on: `:resume` unpauses, `:settings`
   opens the options sub-page, `:restart` restarts the run (fresh seed),
   `:quit` exits to the shell."
  [:resume :settings :restart :quit])

(defn pause-menu-count
  "Number of pause-menu rows."
  []
  (count pause-menu-options))

(defn pause-menu-move
  "Move the pause-menu cursor by `steps` (negative up / positive down),
   wrapping at both ends like the settings page."
  [cursor steps]
  (wrap (php/+ cursor steps) (pause-menu-count)))

(defn pause-menu-action
  "Action keyword for the option under `cursor` (wrapped into range), one
   of `pause-menu-options`."
  [cursor]
  (get pause-menu-options (wrap cursor (pause-menu-count))))

(defn- field-descriptor [field-key]
  (loop [fs page-fields]
    (cond
      (empty? fs)                     nil
      (= (:key (first fs)) field-key) (first fs)
      :else                           (recur (rest fs)))))

(defn- cycle-choices [cur choices steps]
  ;; Guard a missing/empty choice list (an :enum field that forgot its
  ;; :choices): hold the current value rather than returning nil and
  ;; silently corrupting the setting.
  (if (or (nil? choices) (empty? choices))
    cur
    (let [n  (count choices)
          i  (index-of cur choices)
          i' (if (php/< i 0) 0 i)]
      (get choices (wrap (php/+ i' steps) n)))))

(defn adjust
  "Adjust `field-key` on `settings` by `steps` (negative = left,
   positive = right): volumes move `steps * pct-step` (clamped), the
   minimap toggles when `steps` is odd, difficulty cycles by `steps`.
   Any integer magnitude is allowed (a held key ramps a slider).
   Returns the new settings map; an unknown field leaves it untouched."
  [settings field-key steps]
  (let [desc (field-descriptor field-key)
        kind (:kind desc)]
    (cond
      (= kind :pct)
      (update settings field-key
              (fn [v] (clamp-pct (php/+ (php/intval v) (php/* steps pct-step)))))

      (= kind :bool)
      (if (php/=== 1 (php/abs (php/% steps 2)))
        (update settings field-key not)
        settings)

      (= kind :enum)
      (update settings field-key (fn [v] (cycle-choices v (:choices desc) steps)))

      :else          settings)))

(defn navigate
  "Apply one frame of page navigation. `cursor-steps` moves the
   selection (negative up / positive down, wrapping); `value-steps`
   adjusts the selected field (negative left / positive right). Both
   are signed integers, so a held key's repeats ramp a slider. Returns
   `{:cursor _ :settings _ :adjusted? _}` so the caller pushes the new
   volumes only when something changed. Pure: the live audio/minimap
   effects stay in the caller (commands/play)."
  [settings cursor cursor-steps value-steps]
  (let [cursor'   (if (php/=== cursor-steps 0) cursor (move-cursor cursor cursor-steps))
        adjusted? (not (php/=== value-steps 0))
        settings' (if adjusted?
                    (adjust settings (:key (field-at cursor')) value-steps)
                    settings)]
    {:cursor cursor' :settings settings' :adjusted? adjusted?}))

(defn music-volume
  "afplay -v playback value [0.0, music-ceiling] for the current Music
   percent. 0% returns 0.0 (the music layer treats that as 'stop the
   OST')."
  [settings]
  (php/* (php// (php/intval (:music settings)) 100.0) music-ceiling))

(defn sfx-scalar
  "Per-event playback scalar [0.0, 1.0] for the current SFX percent.
   io/sound multiplies each effect's volume by this."
  [settings]
  (php// (php/intval (:sfx settings)) 100.0))

(def mouse-sensitivity-neutral
  "The Sensitivity percent that maps to the neutral 1.0x mouselook
   multiplier (the default). Picked at the slider midpoint so the player
   has equal headroom to slow the look down or speed it up."
  50)

(def mouse-sensitivity-span
  "Multiplicative span of the Sensitivity slider, from the midpoint out to
   either end (#275). The multiplier is `span^((pct - 50) / 50)`, so the
   slider is geometric (not linear) around the neutral 1.0x: each end sits
   the SAME ratio away from neutral (3x faster at 100%, 1/3x as fast at
   0%). 3 gives a clearly useful slow<->fast range - distinctly slower
   fine-tracking at the low end, distinctly faster flicks at the high end
   - replacing the old narrow 0..2x linear band where 0% killed the look
   entirely and 100% only doubled it."
  3.0)

(defn mouse-sensitivity
  "Mouselook speed multiplier (#275) for the current Sensitivity percent.
   Geometric around the slider midpoint (`mouse-sensitivity-neutral`, the
   default): `mouse-sensitivity-span ^ ((pct - 50) / 50)`. So 50% is the
   neutral 1.0x (back-compatible with saved settings), 0% slows to ~0.33x
   for fine aiming, and 100% speeds up to 3.0x for fast flicks - a wider,
   genuinely useful range than the old 0..2x linear map.
   `glue/controls.mouse-aim` multiplies the whole mouselook by this - both
   the 1:1 delta turn (pointer motion -> camera yaw/pitch) and the edge-pan
   fallback - so the slider scales how fast the camera swings for a given
   hand movement. The crosshair stays fixed dead-centre regardless."
  [settings]
  (php/pow mouse-sensitivity-span
           (php// (php/- (php/intval (:sensitivity settings)) mouse-sensitivity-neutral)
                  (php/* 1.0 mouse-sensitivity-neutral))))
