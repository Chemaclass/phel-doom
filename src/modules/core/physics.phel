(ns phel-doom.modules.core.physics
  (:require phel-doom.modules.core.state :refer [move-player turn-player])
  (:require phel-doom.modules.core.map   :refer [wall?]))

;; ---------------------------------------------------------------------
;; Player physics: rotation + translation + counter decay.
;;
;; The world holds six direction counters (:moves). Physics consumes
;; whatever is non-zero (scaled by dt) and decays each counter by one
;; frame. Controls refresh the counters when keys arrive; this module
;; just reads them.
;; ---------------------------------------------------------------------

(def move-speed
  "World units per second when the player holds forward or back."
  4.5)

(def strafe-speed
  "Sideways units per second. Slower than forward speed (DOOM-style)
   so A/D feel like a tactical sidestep, not a teleport."
  2.4)

(def turn-speed
  "Radians per second of sustained rotation."
  2.0)

(defn try-move
  "Translate the player by (dx, dy) unless the destination cell holds
   a wall."
  {:export true}
  [world ^float dx ^float dy]
  (let [{:keys [grid player]} world
        nx                    (+ (:x player) dx)
        ny                    (+ (:y player) dy)]
    (if (wall? grid (php/intval nx) (php/intval ny))
      world
      (move-player world dx dy))))

(defn- counter-on? [moves slot]
  (php/> (get moves slot) 0))

(defn- contribution
  [moves slot ^float speed ^float dt]
  (if (counter-on? moves slot) (php/* speed dt) 0.0))

(defn- turn-delta [moves ^float dt]
  (php/- (contribution moves :turn-right turn-speed dt)
         (contribution moves :turn-left  turn-speed dt)))

(defn- longitudinal-delta [moves ^float dt]
  (php/- (contribution moves :fwd  move-speed dt)
         (contribution moves :back move-speed dt)))

(defn- lateral-delta [moves ^float dt]
  (php/- (contribution moves :strafe-right strafe-speed dt)
         (contribution moves :strafe-left  strafe-speed dt)))

(defn- apply-rotation [world ^float turn-by]
  (if (php/=== turn-by 0.0)
    world
    (turn-player world turn-by)))

(defn- apply-translation [world ^float long-d ^float lat-d]
  (if (and (php/=== long-d 0.0) (php/=== lat-d 0.0))
    world
    (let [a (:angle (:player world))]
      (try-move world
                (php/- (php/* long-d (php/cos a)) (php/* lat-d (php/sin a)))
                (php/+ (php/* long-d (php/sin a)) (php/* lat-d (php/cos a)))))))

(defn- decay-counter [n]
  (php/max 0 (php/- n 1)))

(defn- decay-move-counters [world]
  (let [m (:moves world)]
    (assoc world :moves
           {:fwd          (decay-counter (:fwd m))
            :back         (decay-counter (:back m))
            :strafe-left  (decay-counter (:strafe-left m))
            :strafe-right (decay-counter (:strafe-right m))
            :turn-left    (decay-counter (:turn-left m))
            :turn-right   (decay-counter (:turn-right m))})))

(defn- swap-moves
  "Build a fresh moves map with each opposing pair swapped. Used
   while :invert-secs > 0 so WASD + turn keys read as their
   opposites for the disorientation window. Per-key swaps keep the
   counter values themselves intact so the decay still ticks down."
  [m]
  {:fwd          (:back m)
   :back         (:fwd m)
   :strafe-left  (:strafe-right m)
   :strafe-right (:strafe-left m)
   :turn-left    (:turn-right m)
   :turn-right   (:turn-left m)})

(defn apply-physics
  "Per-frame: rotate, then translate using the new heading, then
   decay every counter by one frame. While :invert-secs > 0 the
   move counters are read in their swapped form so the player
   stagger-flails after a hit."
  {:export true}
  [world ^float dt]
  (let [base    (:moves world)
        invert? (php/> (or (:invert-secs world) 0.0) 0.0)
        moves   (if invert? (swap-moves base) base)]
    (let [turned (apply-rotation world (turn-delta moves dt))]
      (let [walked (apply-translation turned
                                      (longitudinal-delta moves dt)
                                      (lateral-delta moves dt))]
        (decay-move-counters walked)))))

(def blood-drop-spawn-rate
  "Expected new drops per second (Bernoulli per-frame using dt)."
  0.35)

(def blood-drop-fall-speed
  "Rows the drop falls per second."
  18.0)

(def blood-drop-ttl
  "Seconds a drop lives before it fades out."
  2.0)

(defn- advance-blood-drops
  "Walk every active drop one frame forward (row += speed*dt, ttl -=
   dt) and drop the ones whose ttl ran out. Returns a fresh vector."
  [drops ^float dt]
  (apply vector
         (filter (fn [d] (php/> (:ttl d) 0.0))
                 (map (fn [d]
                        {:col (:col d)
                         :row (php/+ (:row d) (php/* blood-drop-fall-speed dt))
                         :ttl (php/- (:ttl d) dt)})
                      (or drops [])))))

(defn- maybe-spawn-drop
  "With probability spawn-rate*dt, append a fresh drop at row 1 with a
   uniformly-random normalised column in [0, 1). Otherwise unchanged."
  [drops ^float dt]
  (if (php/< (php// (php/mt_rand) (php/mt_getrandmax))
             (php/* blood-drop-spawn-rate dt))
    (conj drops
          {:col (php// (php/mt_rand) (php/mt_getrandmax))
           :row 1.0
           :ttl blood-drop-ttl})
    drops))

(defn tick-blood-drops
  "Ambient ceiling-drip effect: advance existing drops and roll a
   per-frame chance to spawn a new one. Columns are stored normalised
   (0..1) so the render layer can scale to whatever vw is this frame."
  {:export true}
  [world ^float dt]
  (let [drops    (or (:blood-drops world) [])
        advanced (advance-blood-drops drops dt)
        spawned  (maybe-spawn-drop advanced dt)]
    (assoc world :blood-drops spawned)))

(defn- heartbeat-interval
  "Seconds between thumps. Faster when closer to death. Returns nil
   when no heartbeat should play (full lives or dead)."
  [lives]
  (cond
    (php/<= lives 0) nil
    (php/<= lives 1) 0.55
    (php/<= lives 2) 0.85
    :else            nil))

(defn- flicker-cooldown-bounds
  "Seconds between flickers, narrower (and faster) at low life so the
   place feels actively haunted when you're nearly dead. Returns
   [min max]."
  [lives]
  (cond
    (php/<= lives 2) [6.0 12.0]
    (php/<= lives 4) [12.0 20.0]
    :else            [20.0 30.0]))

(defn- random-in [^float lo ^float hi]
  (php/+ lo (php/* (php/- hi lo) (php// (php/mt_rand) (php/mt_getrandmax)))))

(defn tick-flicker
  "Drive the periodic 'lights flicker' beat. :flicker-active-secs counts
   down while the dim overlay is on; once it hits zero, :flicker-cooldown
   counts down until the next flicker fires. Cooldown band narrows as
   lives drop so the place feels haunted near death.

   The render layer reads :flicker-active-secs from stats to decide
   whether to paint the scanline darken overlay this frame."
  {:export true}
  [world ^float dt]
  (let [active (or (:flicker-active-secs world) 0.0)]
    (if (php/> active 0.0)
      (assoc world :flicker-active-secs (php/max 0.0 (php/- active dt)))
      (let [cd  (or (:flicker-cooldown world) 0.0)
            cd' (php/max 0.0 (php/- cd dt))]
        (if (php/> cd' 0.0)
          (assoc world :flicker-cooldown cd' :flicker-active-secs 0.0)
          (let [[lo hi] (flicker-cooldown-bounds (:lives world))]
            (assoc world
                   :flicker-cooldown    (random-in lo hi)
                   :flicker-active-secs (random-in 0.08 0.18))))))))

(defn tick-heartbeat
  "Advance the heartbeat phase by `dt`. Phase loops 0→1 over one beat.
   `:heartbeat-tick?` flips true on the frame the phase wraps so the
   IO layer can fire the thump sfx exactly once per cycle. Idle (no
   heartbeat) keeps phase at 0 and the flag at false."
  {:export true}
  [world ^float dt]
  (let [interval (heartbeat-interval (:lives world))]
    (if (nil? interval)
      (assoc world :heartbeat-phase 0.0 :heartbeat-tick? false)
      (let [phase (php/+ (or (:heartbeat-phase world) 0.0)
                         (php// dt interval))
            wrap? (php/>= phase 1.0)]
        (assoc world
               :heartbeat-phase (if wrap? (php/fmod phase 1.0) phase)
               :heartbeat-tick? wrap?)))))
