(ns phel-doom-tests.io.scores-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.io.scores :refer [merge-run empty-scores load-scores
                                        update-scores! scores-write-failed?]))

;; The merge tests are pure. The persistence tests run against an
;; isolated temp $HOME so they never touch the user's real
;; ~/.phel-doom-scores.json — scores-path reads $HOME on every call, so
;; swapping the env var redirects load + save together.

(defn- with-temp-home [f]
  (let [prev (php/getenv "HOME")
        tmp  (str (php/sys_get_temp_dir) "/" (php/uniqid "phel-doom-scores-test-"))
        file (str tmp "/.phel-doom-scores.json")]
    (php/mkdir tmp 0777 true)
    (php/putenv (str "HOME=" tmp))
    (try
      (f)
      (finally
        (php/putenv (str "HOME=" prev))
        (when (php/file_exists file) (php/unlink file))
        (php/rmdir tmp)))))

(deftest test-merge-run-from-empty-keeps-current
  (let [s (merge-run empty-scores 12 3 45 false)]
    (is (= 12 (:best-kills s)))
    (is (= 3  (:best-level s)))
    ;; Not a victory: fastest-victory-s stays at the previous 0.
    (is (= 0 (:fastest-victory-s s)))))

(deftest test-merge-run-best-kills-monotonic-non-decreasing
  ;; New kill count below previous best should NOT downgrade it.
  (let [prev {:best-kills 50 :best-level 2 :fastest-victory-s 0}
        s    (merge-run prev 10 1 30 false)]
    (is (= 50 (:best-kills s)))
    (is (= 2  (:best-level s)))))

(deftest test-merge-run-best-level-tracks-deepest-reached
  (let [prev {:best-kills 0 :best-level 2 :fastest-victory-s 0}
        s    (merge-run prev 0 4 0 false)]
    (is (= 4 (:best-level s)))))

(deftest test-merge-run-victory-sets-first-time
  ;; First victory: any time becomes the record (no previous victory
  ;; means :fastest-victory-s starts at 0).
  (let [s (merge-run empty-scores 30 5 120 true)]
    (is (= 120 (:fastest-victory-s s)))))

(deftest test-merge-run-victory-beats-old-record
  (let [prev {:best-kills 0 :best-level 5 :fastest-victory-s 120}
        s    (merge-run prev 30 5 90 true)]
    (is (= 90 (:fastest-victory-s s)))))

(deftest test-merge-run-victory-slower-than-record-keeps-record
  (let [prev {:best-kills 0 :best-level 5 :fastest-victory-s 90}
        s    (merge-run prev 30 5 120 true)]
    (is (= 90 (:fastest-victory-s s)))))

(deftest test-merge-run-non-victory-never-touches-fastest
  (let [prev {:best-kills 0 :best-level 5 :fastest-victory-s 90}
        s    (merge-run prev 30 5 10 false)]
    ;; Even though 10s is much faster than 90s, a non-victory run
    ;; cannot post a time.
    (is (= 90 (:fastest-victory-s s)))))

;; --- persistence ----------------------------------------------------

(deftest test-no-scores-file-reads-as-empty
  ;; First launch: nothing on disk yet, and the end screen still has a
  ;; bests block to draw.
  (with-temp-home
   (fn []
     (is (= empty-scores (load-scores)) "a missing file reads as empty scores"))))

(deftest test-a-runs-bests-survive-a-relaunch
  ;; What the player actually cares about: finish a run, quit, come
  ;; back, and the bests are still there. Goes through the file, not
  ;; through merge-run, so a broken write path cannot pass.
  (with-temp-home
   (fn []
     (update-scores! 12 3 45 false)
     (let [reloaded (load-scores)]
       (is (= 12 (:best-kills reloaded)) "best kills survive a relaunch")
       (is (= 3  (:best-level reloaded)) "deepest level survives a relaunch"))
     ;; A later, worse run must not erase the record on disk either.
     (update-scores! 2 1 10 false)
     (is (= 12 (:best-kills (load-scores))) "a worse run does not overwrite the record"))))

(deftest test-write-failure-is-recorded-not-swallowed
  ;; An unwritable HOME throws away every run's bests. The write cannot
  ;; throw (that would interrupt play), so the failure has to be
  ;; observable instead; run-play reports it once after teardown. Same
  ;; contract as the settings file.
  (with-temp-home
   (fn []
     (update-scores! 1 1 1 false)
     (is (= false (scores-write-failed?)) "a writable HOME records no failure")
     (let [dir (php/getenv "HOME")]
       ;; Remove the file FIRST: writing to an existing file needs no
       ;; directory write permission, so chmod-ing first would prove
       ;; nothing.
       (php/unlink (str dir "/.phel-doom-scores.json"))
       (php/chmod dir 0500)                       ; read + execute, no write
       ;; The failing write emits a PHP warning by design (src/ carries
       ;; no `@` suppression). Silence it so CI output stays readable;
       ;; the recorded flag is what this test is about.
       (let [prev (php/error_reporting 0)]
         (update-scores! 5 2 20 false)
         (php/error_reporting prev))
       (php/chmod dir 0700)                       ; restore so cleanup works
       (is (= true (scores-write-failed?)) "an unwritable HOME is recorded"))
     ;; Leave the flag clean for any later test in this process.
     (update-scores! 1 1 1 false))))
