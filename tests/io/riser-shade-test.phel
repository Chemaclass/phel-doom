(ns phel-doom-tests.io.riser-shade-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.io.render.main :refer [riser-shade-level]))

;; Riser face shading (issue #373, tier polish). `riser-shade-level`
;; turns the coplanar-wall shade index into the riser-FACE index: pulled
;; darker so a step never reads as a same-distance wall, and nudged by
;; tier height so taller rises read progressively distinct. Higher index
;; = brighter (shade-table[i] = ANSI code 232+i), so "darker" = smaller.

(deftest test-riser-is-darker-than-coplanar-wall
  ;; A rise face at any tier is darker than the wall shade it derives from.
  (is (< (riser-shade-level 15 0.25) 15) "tier-1 riser darker than the wall")
  (is (< (riser-shade-level 15 0.75) 15) "tier-3 riser darker than the wall"))

(deftest test-riser-tint-is-monotonic-in-height
  ;; Taller tiers read progressively darker so elevation is legible.
  (is (< (riser-shade-level 15 0.75) (riser-shade-level 15 0.5)))
  (is (< (riser-shade-level 15 0.5) (riser-shade-level 15 0.25))))

(deftest test-riser-shade-exact-levels
  ;; darken 3 below the wall, minus the tier level (round(z1/fz-step)):
  ;; z1 0.25 -> tier 1 -> 15-3-1=11; 0.5 -> 10; 0.75 -> 9.
  (is (= 11 (riser-shade-level 15 0.25)))
  (is (= 10 (riser-shade-level 15 0.5)))
  (is (= 9 (riser-shade-level 15 0.75))))

(deftest test-riser-shade-clamps-at-zero
  ;; A dark, distant wall index can't underflow past 0 (the darkest code).
  (is (= 0 (riser-shade-level 2 0.75)))
  (is (= 0 (riser-shade-level 0 0.25))))
