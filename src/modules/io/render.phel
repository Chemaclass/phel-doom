(ns phel-doom.modules.io.render
  (:require phel-doom.modules.core.enemies :refer [enemy-types])
  (:require phel-doom.modules.core.engine  :refer [cast-frame max-depth proj-dist])
  (:require phel-doom.modules.core.map     :refer [find-door-cell])
  (:require phel-doom.modules.core.weapons :refer [weapon-order weapons]))

;; =====================================================================
;; § Hot-loop buffer macros
;;
;; The inner row + col loops read/write ~7200 cells per frame at 180×40.
;; Bench (docs/contributing.md → Phel gotchas) puts Phel persistent
;; vectors at ~680× slower than php-array on a per-cell read; the row
;; loop would drop from ~60fps to <2fps if we used (get v i) here.
;;
;; To avoid leaking php/* call shapes across the module we wrap the
;; raw php interop in zero-cost macros. Reader stays at the Phel
;; level (`(buf-mk)`, `(buf-set b i v)`, `(buf-get b i)`); the macro
;; expands at compile time to the underlying php/array op.
;;
;; CAVEAT: these are macros, not fns. They compile inline. Trying to
;; pass `buf-set` as a value (e.g. to `map`) won't work. Use them
;; only at direct call sites in hot loops.
;;
;; PHP arrays still pass by value across fn boundaries. Helpers that
;; build a buffer must RETURN it; callers rebind via let. See
;; compute-wall-shades / paint-* helpers for the pattern.
;; =====================================================================

(defmacro buf-mk
  "Create an empty buffer (php-array)."
  []
  `(php/array))

(defmacro buf-set
  "Write `v` at `i` in buffer `b`. Inlines to php/aset."
  [b i v]
  `(php/aset ~b ~i ~v))

(defmacro buf-get
  "Read `b[i]`. Inlines to php/aget."
  [b i]
  `(php/aget ~b ~i))

(defmacro buf-push
  "Append `v` to the end of buffer `b`. Inlines to php/array_push."
  [b v]
  `(php/array_push ~b ~v))

(def sky        "\e[48;5;236m ")
(def floor      "\e[48;5;239m ")
(def sky-blood  "\e[48;5;52m ")
(def floor-blood "\e[48;5;88m ")
(def enemy-head "\e[48;5;196m ")
(def enemy-body "\e[48;5;52m ")
;; All minimap + HUD cells carry an explicit dark BG (`\e[40m`). Without
;; it, the underlying terminal default BG (which can be light/transparent
;; on some iTerm2 themes) shows through and washes the overlay out.
(def enemy-marker "\e[40;91;1mE\e[0m")
(def heart-marker "\e[40;91;1m♥\e[0m")
(def ammo-marker     "\e[40;93;1mA\e[0m")
(def berserk-marker  "\e[40;91;1mB\e[0m")
(def invuln-marker   "\e[40;96;1mI\e[0m")
(def backpack-marker "\e[40;33;1mP\e[0m")
(def keycard-blue-marker "\e[40;94;1mk\e[0m")
(def keycard-red-marker  "\e[40;91;1mk\e[0m")
(def door-blue-marker    "\e[40;94;1m▌\e[0m")
(def door-red-marker     "\e[40;91;1m▌\e[0m")
(def shotgun-pickup-marker  "\e[40;33;1mS\e[0m")
(def chaingun-pickup-marker "\e[40;32;1mC\e[0m")
(def door-shade
  "Door body cell drawn when a ray hit a door. Frame glyph `▌` (left
   half block) on a dark steel BG with bright orange FG, so a column
   of door cells reads as a vertical metal frame rather than a flat
   orange band. Cheap: still one paint cell per column."
  "\e[48;5;94;38;5;214m▌")
(def boss-door-shade
  "Boss-locked door body cell. Same frame glyph as the standard
   door but on a blood-red BG with bright yellow FG so the L10
   exit reads at a glance as 'kill the boss to open this'."
  "\e[48;5;88;38;5;226m▌")
(def boss-door-marker
  "Minimap glyph for the L10 boss-locked door — vivid red so the
   exit reads as 'danger / locked' against the dim minimap floor."
  "\e[40;91;1m▌\e[0m")

;; Color CODES used for half-block edge anti-aliasing. The outer
;; column loop composes 'top edge' and 'bottom edge' cells by
;; combining a wall code with the sky / floor code into a single
;; ▀ glyph (upper-half block — FG paints top half, BG paints
;; bottom half). The eye reads it as a sub-cell wall boundary
;; instead of a staircase.
(def sky-code         "236")
(def floor-code       "239")
(def sky-blood-code   "52")
(def floor-blood-code "88")
(def door-code        "172")
(def boss-door-code   "196")
(def kill-flash    "\e[48;5;231;38;5;226;1m✦")
(def death-slump   "\e[48;5;124;38;5;232;1m▼")
(def death-collapse "\e[48;5;88;38;5;52m▒")
(def blood-bright  "\e[48;5;160m ")
(def blood-mid     "\e[48;5;88m ")
(def blood-dim     "\e[48;5;52m ")
(def sprite-shadow
  "Darkest-grey BG painted into the row immediately under an enemy's
   feet so the sprite reads as grounded instead of floating in mid-air."
  "\e[48;5;232m ")

;; Pickup sprites paint a coloured BG rectangle over the projected
;; column range, then overlay a single ICON glyph at the centre cell
;; so the pickup reads as a proper symbol up close and a coloured
;; glow from across the room. BG + glyph cycle on a sin wave.

(def heart-shade
  "Heartbeat 'systole' frame: dim dark-red BG."
  "\e[48;5;52m ")

(def heart-shade-bright
  "Heartbeat 'diastole' frame: brighter pink-red BG that throbs in
   tempo with the heart-glyph swap below."
  "\e[48;5;205m ")

(def heart-glyph
  "Filled ♥ in bright white on the dim red BG. Single centre cell."
  "\e[48;5;52;38;5;231;1m♥")

(def heart-glyph-bright
  "Pulse frame: ♥ in saturated red on the bright pink BG so glyph +
   BG throb together."
  "\e[48;5;205;38;5;196;1m♥")

(def armor-shade
  "Armor 'idle' BG: deep steel blue."
  "\e[48;5;17m ")

(def armor-shade-bright
  "Armor 'pulse' BG: brighter electric blue."
  "\e[48;5;33m ")

(def armor-glyph
  "White ◆ on the deep-blue BG. Reads as a shield boss."
  "\e[48;5;17;38;5;231;1m◆")

(def armor-glyph-bright
  "Yellow ◆ on the bright-blue BG for the pulse frame."
  "\e[48;5;33;38;5;226;1m◆")

(def ammo-shade
  "Ammo-box idle BG: warm brown so it reads as a wooden crate from a
   distance, distinct from the cooler armor blue and warmer heart red."
  "\e[48;5;94m ")

(def ammo-shade-bright
  "Ammo-box pulse BG: saturated yellow so it grabs the eye when the
   player is low on rounds."
  "\e[48;5;220m ")

(def ammo-glyph
  "White ◉ on the brown BG — round / bullet read at a glance, no
   longer confusable with the squared shotgun / chaingun pickups."
  "\e[48;5;94;38;5;231;1m◉")

(def ammo-glyph-bright
  "Black ◉ on the yellow pulse BG so the icon flips contrast in tempo
   with the shade swap."
  "\e[48;5;220;38;5;52;1m◉")

(def berserk-shade
  "Berserk sphere idle BG: dark blood-red so it reads as 'rage' from
   across the room, distinct from the dim heart red (52)."
  "\e[48;5;88m ")

(def berserk-shade-bright
  "Berserk sphere pulse BG: saturated bright red flare."
  "\e[48;5;196m ")

(def berserk-glyph
  "Yellow Ω on the dark-red BG — Greek omega reads as a 'fury sigil'."
  "\e[48;5;88;38;5;226;1mΩ")

(def berserk-glyph-bright
  "White Ω on the bright pulse BG."
  "\e[48;5;196;38;5;231;1mΩ")

(def invuln-shade
  "Invulnerability sphere idle BG: deep electric blue."
  "\e[48;5;19m ")

(def invuln-shade-bright
  "Invulnerability sphere pulse BG: bright cyan flare."
  "\e[48;5;51m ")

(def invuln-glyph
  "White star on dark blue."
  "\e[48;5;19;38;5;231;1m★")

(def invuln-glyph-bright
  "Yellow star on cyan pulse."
  "\e[48;5;51;38;5;226;1m★")

(def backpack-shade
  "Backpack idle BG: dim olive-tan crate so it reads as field gear."
  "\e[48;5;58m ")

(def backpack-shade-bright
  "Backpack pulse BG: brighter tan flare."
  "\e[48;5;142m ")

(def backpack-glyph
  "White ⊞ on the tan BG: stylised pack."
  "\e[48;5;58;38;5;231;1m⊞")

(def backpack-glyph-bright
  "Black ⊞ on the bright pulse BG."
  "\e[48;5;142;38;5;232;1m⊞")

;; Weapon-pickup glyphs use distinct shapes (not just colour) so the
;; player can tell the loot apart at a glance from across the room:
;;   shotgun  → ╪   (cross-barred = pump action, double-barrel feel)
;;   chaingun → ≣   (triple horizontal = rapid-fire multi-barrel)
;; Both still carry warm-wood / steel-cool BGs so the team identity
;; matches the in-hand sprite's palette.
(def shotgun-pickup-shade  "\e[48;5;94m ")
(def shotgun-pickup-bright "\e[48;5;130m ")
(def shotgun-pickup-glyph  "\e[48;5;94;38;5;253;1m╪")
(def shotgun-pickup-glyph-bright "\e[48;5;130;38;5;253;1m╪")

(def chaingun-pickup-shade  "\e[48;5;238m ")
(def chaingun-pickup-bright "\e[48;5;244m ")
(def chaingun-pickup-glyph  "\e[48;5;238;38;5;46;1m≣")
(def chaingun-pickup-glyph-bright "\e[48;5;244;38;5;46;1m≣")

(def keycard-blue-shade  "\e[48;5;21m ")
(def keycard-blue-bright "\e[48;5;33m ")
(def keycard-blue-glyph  "\e[48;5;21;38;5;231;1m⚿")
(def keycard-blue-glyph-bright "\e[48;5;33;38;5;231;1m⚿")
(def keycard-red-shade   "\e[48;5;52m ")
(def keycard-red-bright  "\e[48;5;124m ")
(def keycard-red-glyph   "\e[48;5;52;38;5;231;1m⚿")
(def keycard-red-glyph-bright "\e[48;5;124;38;5;231;1m⚿")

(def char-aspect 2.0)
(def base-hud-rows 1)

(defn- hud-rows-for
  "Number of HUD rows to reserve at the bottom of the viewport. The
   debug overlay (F3) adds a second row above the standard footer; off
   by default so the 3D viewport keeps its full vertical real estate."
  [stats]
  (if (get stats :debug?) 2 base-hud-rows))

(def perf-snapshot
  "Side-channel for the F3 perf overlay. `render!` writes the latest
   cast-ms / render-ms / bytes / avg-rle / PHP-mem snapshot into this
   atom every frame the overlay is on; `frame-stats` reads it on the
   following frame so the debug row paints last-frame numbers. nil
   while the overlay is off — gates the paint-debug-row helper out."
  (atom nil))

(defn read-perf-snapshot
  "Public accessor for the latest perf snapshot written by render!.
   Called by play.frame-stats so the debug HUD has data to paint on
   the next frame. Returns nil while the overlay has never been on."
  []
  @perf-snapshot)

(defn- record-cast-ms!
  "Helper used by `frame->string` when :debug? is on. Stashes the
   measured cast-phase time so `render!` can subtract it from total
   frame time to get the render-phase slice. Skips the swap when the
   atom is unset so the off path stays branch-free."
  [^float ms]
  (swap! perf-snapshot
         (fn [snap] (if (nil? snap) {:cast-ms ms} (assoc snap :cast-ms ms)))))

(def shade-table
  "Pre-baked ANSI strings for the 24 grayscale palette entries (codes
   232-255). Indexed by an integer shade level 0-23, so the per-cell
   shade lookup is just one PHP array fetch — no memoize, no string
   alloc, no Phel runtime dispatch."
  (let [t (buf-mk)]
    (loop [i 0]
      (when (php/< i 24)
        (buf-set t i (str "\e[48;5;" (php/+ 232 i) "m "))
        (recur (php/+ i 1))))
    t))

(def shade-code-table
  "Parallel palette to shade-table holding ONLY the 256-color code as
   a string (e.g. \"240\"). Used to compose ▀ half-block edge cells
   that mix a wall colour with sky / floor for sub-pixel-looking wall
   tops and bottoms."
  (let [t (buf-mk)]
    (loop [i 0]
      (when (php/< i 24)
        (buf-set t i (php/strval (php/+ 232 i)))
        (recur (php/+ i 1))))
    t))

(def shade-table-blood
  "Red gradient palette swapped in for the duration of the player's
   post-hit i-frames so the whole viewport flushes red — instant 'you
   just got hit' feedback without rendering a separate overlay."
  (let [t (buf-mk)]
    (loop [i 0]
      (when (php/< i 24)
        ;; bright red (close) -> dark red (far) along the 256-color
        ;; reds: 196 -> 58, every shade step ~6 indices.
        (buf-set t i (str "\e[48;5;" (php/- 196 (php/intval (php/* i 6))) "m "))
        (recur (php/+ i 1))))
    t))

(def shade-code-table-blood
  "Code-only twin of shade-table-blood for edge-cell composition."
  (let [t (buf-mk)]
    (loop [i 0]
      (when (php/< i 24)
        (buf-set t i (php/strval (php/- 196 (php/intval (php/* i 6)))))
        (recur (php/+ i 1))))
    t))

(defn- fade-256
  "Darken a 256-color code by factor `t` in [0.0, 1.0]. Handles the
   6×6×6 cube (16-231) by scaling each RGB component, and the 24-step
   grayscale (232-255) by pulling toward the darkest entry. Codes 0-15
   (system palette) are left alone — they're too coarse to fade
   smoothly. Used to fade enemy sprites with distance so they blend
   into the atmospheric haze instead of staying full-saturated
   wherever they are."
  [^int code ^float t]
  (cond
    (php/>= code 232)
    (php/max 232 (php/intval (php/round (php/- code (php/* t (php/- code 232))))))

    (php/>= code 16)
    (let [c (php/- code 16)]
      (let [r (php/intdiv c 36)
            g (php/intdiv (mod c 36) 6)
            b (mod c 6)]
        (let [r' (php/max 0 (php/intval (php/round (php/* (php/- 1.0 t) r))))
              g' (php/max 0 (php/intval (php/round (php/* (php/- 1.0 t) g))))
              b' (php/max 0 (php/intval (php/round (php/* (php/- 1.0 t) b))))]
          (php/+ 16 (php/* 36 r') (php/* 6 g') b'))))

    :else             code))

(defn- enemy-shade-string
  "Compose the ANSI BG-only paint cell for one enemy zone at the
   given fade factor."
  [^int code ^float t]
  (str "\e[48;5;" (fade-256 code t) "m "))

(defn- enemy-textured-shade-string
  "Like enemy-shade-string but embeds `glyph` (a single character) on
   top of the BG, using `fg-code` (also faded by t) as foreground.
   Used for the body zone so each monster has a recognisable scale /
   muscle / armor pattern beyond just colour."
  [^int code ^float t glyph ^int fg-code]
  (str "\e[48;5;" (fade-256 code t)
       ";38;5;" (fade-256 fg-code t)
       "m" glyph))

(def aggro-distance
  "World-units threshold below which an enemy is considered 'close
   enough to hit you'. The head zone pulses (blink SGR) for these
   enemies as a visual danger cue. Slightly more than 2× the touch-
   damage-dist (0.7) in combat.phel so the player gets a beat of
   warning before contact."
  1.8)

(defn- enemy-aggro-head-string
  "Head zone paint cell used when the enemy is within aggro-distance.
   Alternates between full-brightness head colour and a half-faded
   version on a code-driven pulse so the head reads as throbbing —
   freezes on pause along with every other game-time animation
   (issue #7). Terminal SGR 5 (blink) is intentionally avoided so
   pause is observable in this layer too."
  [^int code ^bool bright?]
  (if bright?
    (str "\e[48;5;" code "m ")
    (str "\e[48;5;" (fade-256 code 0.6) "m ")))

(defn- build-horizon-gradient
  "Per-row PHP array of pre-baked shade strings for the given viewport
   height. Maps each row to a shade-table index based on distance
   from the horizon line (vh/2): closer to the horizon = darker
   (atmospheric haze). Used for both sky AND floor since after a
   distance the eye stops distinguishing them anyway."
  [^int vh tbl]
  (let [arr     (buf-mk)
        horizon (php/intdiv vh 2)
        max-d   (php/max 1 horizon)]
    (loop [r 0]
      (when (php/< r vh)
        (let [idx (php/max 0
                           (php/min 23
                                    (php/intval (php/* (php/- 1.0
                                                              (php// (php/abs (php/- r horizon))
                                                                     max-d))
                                                       23))))]
          (buf-set arr r (buf-get tbl idx)))
        (recur (php/+ r 1))))
    arr))

(defn- build-themed-gradient
  "Per-row PHP array of pre-baked BG paint cells for a level-themed
   sky or floor. Brightest = base-code at the screen edge, fades
   toward black at the horizon via fade-256. When `stripe?` is true,
   every other row pulls one extra fade step so floors show subtle
   horizontal banding (tile lines). One pass over vh rows per frame;
   vh is small (~30-40) so the cost is negligible."
  [^int vh ^int base-code stripe?]
  (let [arr     (buf-mk)
        horizon (php/intdiv vh 2)
        max-d   (php/max 1 horizon)]
    (loop [r 0]
      (when (php/< r vh)
        (let [t     (php// (php/abs (php/- r horizon)) max-d)
              fade  (php/- 1.0 t)
              fade' (if (and stripe? (php/=== (mod r 2) 1))
                      (php/max 0.0 (php/- fade 0.12))
                      fade)
              code  (fade-256 base-code fade')]
          (buf-set arr r (str "\e[48;5;" code "m ")))
        (recur (php/+ r 1))))
    arr))

;; Per-column shading lives inline in frame->string's hot loop:
;; base distance index, +1 for vertical wall faces (side-shading),
;; ±1 per-cell hash, then resolve TWO shade strings per column
;; (normal + edge-darkened). Inner row loop becomes one aget +
;; one ===-compare against tops/bots-1.

(defn direction-char
  "Map an angle in radians to one of 8 unicode arrow chars, snapping to
   the nearest π/4 sector. Public so the minimap layer and tests can
   share the same convention."
  [angle]
  (let [q (mod (php/intval
                (+ (/ (php/fmod (+ angle (* 4.0 php/M_PI)) (* 2.0 php/M_PI))
                      (/ php/M_PI 4.0))
                   0.5))
               8)]
    (cond
      (= q 0) "→"
      (= q 1) "↘"
      (= q 2) "↓"
      (= q 3) "↙"
      (= q 4) "←"
      (= q 5) "↖"
      (= q 6) "↑"
      :else   "↗")))

;; Minimap glyphs. Walls use the full-block char █ so adjacent
;; cells form a continuous solid silhouette instead of the patchy
;; '#' ASCII look — minimap reads as a clean overhead floor plan,
;; not a punch-card.
(def minimap-wall  "\e[40;37;1m█\e[0m")
(def minimap-floor "\e[40;90m·\e[0m")
(def minimap-door  "\e[40;33;1mD\e[0m")

(def minimap-door-pulse
  "Bright magenta D for the minimap door cell, swapped in with
   `minimap-door` on a fast sin wave so the exit catches the eye.
   Cycled in the col-loop setup. Code-driven only — terminal SGR
   blink (5) is intentionally dropped so the swap freezes on pause."
  "\e[40;93;1mD\e[0m")

(defn- scaled-cells
  "Build a PHP array keyed by `row*out-w+col` (in MINIMAP coords)
   whose truthy entries mark cells currently holding a thing
   accepted by `keep?`. `step` collapses every step×step grid block
   into one minimap cell, so a far-away pickup still shows up at
   narrow vw where the minimap has been scaled down."
  [items step out-w keep?]
  (let [acc (buf-mk)]
    (loop [xs items]
      (when (php/!== xs nil)
        (let [it (first xs)]
          (when (and it (keep? it))
            (let [r (php/intdiv (php/intval (:y it)) step)
                  c (php/intdiv (php/intval (:x it)) step)]
              (buf-set acc (php/+ (php/* r out-w) c) true))))
        (recur (next xs))))
    acc))

(defn- enemy-cells [enemies step out-w]
  (scaled-cells enemies step out-w (fn [e] (:alive e))))

(defn- heart-cells [hearts step out-w]
  (scaled-cells hearts step out-w (fn [_] true)))

(defn- ammo-cells [boxes step out-w]
  (scaled-cells boxes step out-w (fn [_] true)))

(defn- berserk-cells [bs step out-w]
  (scaled-cells bs step out-w (fn [_] true)))

(defn- invuln-cells [is step out-w]
  (scaled-cells is step out-w (fn [_] true)))

(defn- backpack-cells [bs step out-w]
  (scaled-cells bs step out-w (fn [_] true)))

(defn- minimap-rows
  "Render the world's grid into a PHP array of ANSI-coded strings,
   one per OUTPUT row. `step` collapses every step×step grid block
   into one minimap cell — at narrow vw the minimap shrinks to stay
   under ~1/3 of the screen. step=1 keeps the original 1:1 view.
   `door-glyph` lets the caller swap in a pulsing variant on a sin
   wave. Wall takes priority over door/enemy/pickup when a sampled
   block is mixed, so corridors don't visually vanish."
  [world door-glyph step]
  (let [pgrid               (:pgrid world)
        {:keys [x y angle]} (:player world)
        gh                  (php/count pgrid)
        gw                  (php/count (buf-get pgrid 0))
        out-h               (php/intval (php/ceil (php// gh step)))
        out-w               (php/intval (php/ceil (php// gw step)))
        pcol                (php/intdiv (php/intval x) step)
        prow                (php/intdiv (php/intval y) step)
        marker              (str "\e[40;93;1m" (direction-char angle) "\e[0m")
        emap                (enemy-cells (:enemies world) step out-w)
        hmap                (heart-cells (:hearts world) step out-w)
        amap                (ammo-cells  (:ammo-boxes world) step out-w)
        bmap                (berserk-cells (:berserks world) step out-w)
        imap                (invuln-cells  (:invulns world) step out-w)
        pmap                (backpack-cells (:backpacks world) step out-w)
        kbmap               (scaled-cells (:keycards world) step out-w
                                          (fn [k] (php/=== (:colour k) :blue)))
        krmap               (scaled-cells (:keycards world) step out-w
                                          (fn [k] (php/=== (:colour k) :red)))
        wsmap               (scaled-cells (:weapon-pickups world) step out-w
                                          (fn [w] (php/=== (:weapon w) :shotgun)))
        wcmap               (scaled-cells (:weapon-pickups world) step out-w
                                          (fn [w] (php/=== (:weapon w) :chaingun)))
        rows                (buf-mk)
        block-has-wall?     (fn [r0 c0]
                              (loop [dr 0]
                                (cond
                                  (php/>= dr step) false
                                  (let [grow (buf-get pgrid (php/+ r0 dr))]
                                    (loop [dc 0]
                                      (cond
                                        (php/>= dc step)                         false
                                        (php/=== 1 (buf-get grow (php/+ c0 dc))) true
                                        :else                                    (recur (php/+ dc 1))))) true
                                  :else (recur (php/+ dr 1)))))
        sample-cell         (fn [r0 c0]
                              ;; Priority: wall (1) > any door (2/3/4/5) >
                              ;; floor (0). Door variants flow through so
                              ;; minimap-rows can paint blue/red/boss
                              ;; markers distinct from the orange D.
                              (loop [dr 0 found 0]
                                (if (php/>= dr step)
                                  found
                                  (let [grow (buf-get pgrid (php/+ r0 dr))
                                        v    (loop [dc 0 acc 0]
                                               (if (php/>= dc step)
                                                 acc
                                                 (let [cell (buf-get grow (php/+ c0 dc))]
                                                   (cond
                                                     (php/=== cell 1) 1
                                                     (or (php/=== cell 2)
                                                         (php/=== cell 3)
                                                         (php/=== cell 4)
                                                         (php/=== cell 5)) (recur (php/+ dc 1) cell)
                                                     :else            (recur (php/+ dc 1) acc)))))]
                                    (cond
                                      (php/=== v 1) 1
                                      (or (php/=== v 2)
                                          (php/=== v 3)
                                          (php/=== v 4)
                                          (php/=== v 5)) (recur (php/+ dr 1) v)
                                      :else         (recur (php/+ dr 1) found))))))]
    (loop [row 0]
      (when (php/< row out-h)
        (let [r0    (php/* row step)
              parts (buf-mk)]
          (loop [col 0]
            (when (php/< col out-w)
              (let [c0   (php/* col step)
                    cell (sample-cell r0 c0)]
                (buf-push parts
                          (cond
                            (and (php/=== row prow) (php/=== col pcol))   marker
                            (php/=== 1 cell)                              minimap-wall
                            (block-has-wall? r0 c0)                       minimap-wall
                            (php/=== 2 cell)                              door-glyph
                            (php/=== 3 cell)                              door-blue-marker
                            (php/=== 4 cell)                              door-red-marker
                            (php/=== 5 cell)                              boss-door-marker
                            (buf-get emap (php/+ (php/* row out-w) col))  enemy-marker
                            (buf-get hmap (php/+ (php/* row out-w) col))  heart-marker
                            (buf-get amap (php/+ (php/* row out-w) col))  ammo-marker
                            (buf-get bmap (php/+ (php/* row out-w) col))  berserk-marker
                            (buf-get imap (php/+ (php/* row out-w) col))  invuln-marker
                            (buf-get pmap (php/+ (php/* row out-w) col))  backpack-marker
                            (buf-get kbmap (php/+ (php/* row out-w) col)) keycard-blue-marker
                            (buf-get krmap (php/+ (php/* row out-w) col)) keycard-red-marker
                            (buf-get wsmap (php/+ (php/* row out-w) col)) shotgun-pickup-marker
                            (buf-get wcmap (php/+ (php/* row out-w) col)) chaingun-pickup-marker
                            :else                                         minimap-floor)))
              (recur (php/+ col 1))))
          (buf-set rows row (php/implode "" parts)))
        (recur (php/+ row 1))))
    rows))

(defn- fmt-ms
  "Render an ms reading to one decimal so the debug row stays compact
   even when timings stretch past 10ms. Falls back to `--` when the
   metric is not available yet (e.g. first frame)."
  [v]
  (if (nil? v) "--" (php/number_format v 1)))

(defn- fmt-bytes
  "Human-readable byte count: under 10k stays plain, otherwise `k`/`M`
   suffix with one decimal so the row fits in a single line."
  [n]
  (cond (nil? n)          "--"
        (php/< n 10000)   (str n)
        (php/< n 1000000) (str (php/number_format (php// n 1000.0) 1) "k")
        :else             (str (php/number_format (php// n 1000000.0) 2) "M")))

(defn- hud-debug-line
  "Single-line technical overlay. Reads the snapshot `frame-stats`
   already pulled from the side-channel atom — no instrumentation work
   runs here, so the row repaints cheaply once the cost has been paid
   by the previous frame's render!. Off when :debug? is false. Carries
   the player position / angle / fps too so the standard game HUD can
   stay focused on combat info."
  [world stats]
  (let [snap                (or (get stats :perf-stats) {})
        {:keys [x y angle]} (:player world)
        frame-ms            (or (get stats :frame-ms) 0)
        fps                 (or (get stats :fps) 0)
        cast-ms             (get snap :cast-ms)
        render-ms           (get snap :render-ms)
        bytes               (get snap :bytes)
        avg-rle             (get snap :avg-rle)
        php-mem             (get snap :php-mem)
        php-mem-peak        (get snap :php-mem-peak)]
    (str "\e[0m\e[1;36m[DEBUG]\e[0m"
         "  \e[1mpos\e[0m (" (php/number_format x 1) ", " (php/number_format y 1) ")"
         "  \e[1mangle\e[0m "
         (php/intval (* (php/fmod (+ angle (* 4.0 php/M_PI)) (* 2.0 php/M_PI))
                        (/ 180.0 php/M_PI))) "°"
         "  \e[1mfps\e[0m " fps
         "  \e[1mframe\e[0m " frame-ms "ms"
         "  \e[1mcast\e[0m "  (fmt-ms cast-ms) "ms"
         "  \e[1mrender\e[0m " (fmt-ms render-ms) "ms"
         "  \e[1mbytes\e[0m " (fmt-bytes bytes)
         "  \e[1mrle\e[0m "  (if (nil? avg-rle) "--" (php/number_format avg-rle 1))
         "  \e[1mmem\e[0m "  (fmt-bytes php-mem) "/" (fmt-bytes php-mem-peak))))

(defn- ammo-cell
  "HUD readout: e.g. `ammo 7/10 [23]` — loaded rounds / capacity, then
   bracketed spare reserve. Mag colour goes amber at 3 or fewer rounds
   and red on empty; the reserve goes amber under one mag's worth and
   red on empty so the player can read both the immediate round count
   and the spare pool at a glance."
  [stats]
  (let [mag     (or (get stats :mag) 0)
        cap     (or (get stats :mag-size) 10)
        reserve (or (get stats :ammo-reserve) 0)
        mag-low (php/max 1 (php/intdiv cap 3))
        res-low cap
        mag-col (cond (php/<= mag 0)       "\e[1;91m"
                      (php/<= mag mag-low) "\e[1;93m"
                      :else                "\e[1m")
        res-col (cond (php/<= reserve 0)       "\e[1;91m"
                      (php/<= reserve res-low) "\e[1;93m" ; one mag's worth
                      :else                    "\e[2m")]
    (str "\e[1mammo\e[0m "
         mag-col mag "\e[0m/" cap " "
         res-col "[" reserve "]\e[0m")))

(defn- hud-line
  "Bottom-status row. Was the dump for pos/angle/fps + a cramped key
   legend; those moved to the F3 debug overlay and the pause menu.
   Now a single dim tagline so the bottom strip stays visually
   anchored without competing with the game info up top."
  [_world _stats]
  "\e[0m\e[2mP to pause for controls · F3 for debug\e[0m")

(defn project-enemy
  "Project one enemy into screen space relative to the player. Returns
   {:col :half-width :dist :damage-ratio} or nil if the enemy is behind
   the player or off-screen. `:damage-ratio` is 0.0 at full health and
   approaches 1.0 as the enemy nears death; render uses it to tint the
   body shade darker for wounded enemies. Distance is fish-eye corrected
   so it can be compared directly to entries in the wall `dists` array."
  [enemy player vw]
  (let [dx (php/- (:x enemy) (:x player))
        dy (php/- (:y enemy) (:y player))]
    (let [rel-norm (php/- (php/fmod (php/+ (php/- (php/atan2 dy dx) (:angle player))
                                           (php/* 3.0 php/M_PI))
                                    (php/* 2.0 php/M_PI))
                          php/M_PI)
          cos-rel  (php/cos rel-norm)]
      (if (php/<= cos-rel 0.05)
        nil
        (let [dist      (php/* (php/sqrt (php/+ (php/* dx dx) (php/* dy dy))) cos-rel)
              max-lives (or (:max-lives enemy) 1)
              lives     (or (:lives enemy) max-lives)
              dmg       (if (php/<= max-lives 1)
                          0.0
                          (php/max 0.0 (php/min 1.0
                                                (php/- 1.0 (php// lives max-lives)))))
              ;; Boss scale: cyberdemons (final boss + L5 mob) tower
              ;; 2× wider / taller than the standard catalog so the
              ;; L10 fight reads as a real boss encounter. Other types
              ;; render at native size (1.0).
              scale     (if (php/=== (:type enemy) :cyber) 2.0 1.0)
              hw-base   (php/max 1 (php/intval (php// proj-dist (php/* (php/max 0.5 dist) 3.0))))]
          {:col          (php/intval (php/+ (php/* 0.5 vw) (php/* (php/tan rel-norm) proj-dist)))
           :half-width   (php/max 1 (php/intval (php/* hw-base scale)))
           :dist         dist
           :scale        scale
           :damage-ratio dmg
           :type         (:type enemy)})))))

(defn- collect-enemy-projs
  "Project every alive enemy and return a vector sorted by distance
   descending — back-to-front so closer sprites overwrite farther ones
   when painted in order."
  [enemies player vw]
  (let [raw (loop [es enemies acc []]
              (if (php/=== es nil)
                acc
                (let [e (first es)]
                  (recur (next es)
                         (if (and e (:alive e))
                           (let [p (project-enemy e player vw)]
                             (if p (conj acc p) acc))
                           acc)))))]
    (sort-by (fn [x] (php/- 0.0 (:dist x))) raw)))

(def pause-inner-width
  "Character width of each interior row of the pause menu (between the
   left and right borders). Every row pads to this width so the box
   aligns cleanly regardless of label length. Picked to fit the
   widest entry in the controls list (`  F3     debug overlay`) plus
   trailing breathing room."
  32)

(defn- pause-pad
  "Pad `text` to `width` with trailing spaces. Re-applies the pause
   menu's dark BG before padding so trailing spaces don't fall on
   default terminal BG after an internal `\\e[0m` reset (the right
   `│` border otherwise reads as detached from the item). Uses
   `mb_strlen` so multi-byte glyphs in the controls list (`← →`,
   each 3 bytes / 1 column) don't over-count and shrink the pad —
   the byte-counting variant left the `← →    turn` row's right
   border ~4 columns short."
  [text width]
  (str text "\e[40;97m" (php/str_repeat " " (php/max 0 (php/- width (php/mb_strlen text))))))

(def help-inner-width
  "Character width of each interior row of the H info menu — wider
   than the pause menu to fit the weapon-stats table comfortably."
  44)

(defn- length-without-sgr
  "Visible character length of `s` after stripping CSI SGR escapes.
   Used by help-menu-string to align right-border columns when the
   interior text carries colour codes (keys, buffs)."
  [s]
  (php/strlen (php/preg_replace "/\\x1b\\[[\\d;]*m/" "" s)))

(defn- help-pad
  "Pad `text` to `width` with trailing spaces, re-applying the menu
   wash so trailing spaces stay on the dark BG (same trick as
   pause-pad). Strips SGR escapes before counting so colour-tagged
   rows (`\\e[94;1mblue\\e[40;97m`) line up with plain rows; counts
   the remainder with `mb_strlen` because the interior carries
   UTF-8 separators (`·`) that take 1 column but multiple bytes."
  [text width]
  (let [visible-len (php/mb_strlen
                     (php/preg_replace "/\\x1b\\[[\\d;]*m/" "" text))]
    (str text "\e[40;97m"
         (php/str_repeat " " (php/max 0 (php/- width visible-len))))))

(defn- help-weapon-row
  "Render one weapon entry as a full menu row including both `│`
   borders. Builds the visible string first (no SGR) so the trailing
   pad math is byte-accurate, then wraps the body in the per-weapon
   colour. Active weapon gets a yellow `>` marker; unowned weapons
   render dim with `--/--` ammo so the player sees the slot exists
   but still has to find it on the map."
  [kw spec active? owned? mag reserve cap row-w]
  (let [name     (or (:name spec) (php/strval kw))
        dmg      (or (:damage spec) 0)
        mag-sz   (or (:mag-size spec) 0)
        marker   (if active? "> " "  ")
        name-pad (php/str_repeat " " (php/max 0 (php/- 10 (php/strlen name))))
        ammo-txt (if owned?
                   (let [mag-frag (str mag "/" mag-sz)]
                     (str mag-frag
                          (php/str_repeat " " (php/max 0 (php/- 7 (php/strlen mag-frag))))
                          "[" reserve "/" cap "]"))
                   "--/--   [--/--]")
        body     (str " " marker name name-pad "dmg " dmg "  " ammo-txt)
        body-pad (php/str_repeat " " (php/max 0 (php/- row-w (php/strlen body))))
        sgr      (cond active? "\e[1;93m" owned? "\e[97m" :else "\e[2;90m")]
    (str "│" sgr body "\e[40;97m" body-pad "│")))

(defn- help-menu-string
  "Build the H info overlay. Three sections — run state, player
   status, weapons table — plus a short controls reminder. Pure:
   caller pushes the resulting ANSI string into the parts array.

   Reads everything from `stats` so the overlay never reaches back
   into `world` directly. `stats` carries the same keys frame-stats
   stamps in commands/play.phel — see that fn for the full list."
  [vw vh stats]
  (let [w           help-inner-width
        bar         (php/str_repeat "─" w)
        blnk        (str "│" (help-pad "" w) "│")
        bord        (fn [text]
                      (str "│\e[97m" (help-pad text w) "│"))
        sec         (fn [text]
                      (str "│\e[1;93m" (help-pad (str " " text) w) "\e[40;97m│"))
        lives       (or (:lives stats) 0)
        cap-l       (or (:max-lives stats) 5)
        armor       (or (:armor stats) 0)
        kills       (or (:kills stats) 0)
        streak      (or (:streak stats) 0)
        level-n     (or (:level stats) 1)
        level-name  (or (:level-name stats) "?")
        difficulty  (or (:difficulty stats) :normal)
        time-s      (or (:game-time-s stats) 0.0)
        bsec        (or (:berserk-secs stats) 0.0)
        isec        (or (:invuln-secs stats) 0.0)
        pack?       (boolean (:backpack? stats))
        held        (or (:held-keys stats) #{})
        owned       (or (:owned-weapons stats) #{:pistol})
        active      (or (:weapon stats) :pistol)
        ws          (or (:weapon-state stats) {})
        ;; Active weapon's live mag/reserve live on the top-level
        ;; mirror; other weapons read from :weapon-state stash so
        ;; the table reflects each slot's persisted ammo.
        mag-of      (fn [kw]
                      (if (php/=== kw active)
                        (or (:mag stats) 0)
                        (or (get-in ws [kw :mag]) 0)))
        reserve-of  (fn [kw]
                      (if (php/=== kw active)
                        (or (:ammo-reserve stats) 0)
                        (or (get-in ws [kw :reserve]) 0)))
        cap-of      (fn [kw]
                      (let [base (or (:reserve-cap (get weapons kw)) 0)]
                        (if pack? (php/* 2 base) base)))
        weapon-rows (apply vector
                           (map (fn [kw]
                                  (help-weapon-row kw (get weapons kw)
                                                   (php/=== kw active)
                                                   (contains? owned kw)
                                                   (mag-of kw)
                                                   (reserve-of kw)
                                                   (cap-of kw)
                                                   w))
                                weapon-order))
        keys-str    (cond
                      (and (contains? held :blue) (contains? held :red))
                      "\e[94;1mblue\e[40;97m  \e[91;1mred\e[40;97m"
                      (contains? held :blue)                             "\e[94;1mblue\e[40;97m"
                      (contains? held :red)                              "\e[91;1mred\e[40;97m"
                      :else                                              "\e[2;90m(none)\e[40;97m")
        buffs-str   (let [chunks (apply vector
                                        (filter (fn [s] (not (php/=== s nil)))
                                                [(when (php/> bsec 0.0)
                                                   (str "\e[1;33mBERSERK " (php/intval bsec) "s\e[40;97m"))
                                                 (when (php/> isec 0.0)
                                                   (str "\e[1;94mINVULN " (php/intval isec) "s\e[40;97m"))
                                                 (when pack?
                                                   "\e[1;32m+PACK\e[40;97m")]))]
                      (if (php/=== (count chunks) 0)
                        "\e[2;90m(none)\e[40;97m"
                        (php/implode "  " (to-php-array chunks))))
        rows
        (apply vector
               (php/array_merge
                (to-php-array
                 [(str "┌" bar "┐")
                  blnk
                  (str "│\e[1;96m" (help-pad "        ⓘ  INFO  (H or ESC to close)" w) "\e[40;97m│")
                  blnk
                  (str "├" bar "┤")
                  blnk
                  (sec "RUN")
                  (bord (str "  level:  " level-n "  " level-name))
                  (bord (str "  kills:  " kills "   streak x" streak))
                  (bord (str "  time:   " (php/intval time-s) "s"))
                  (bord (str "  diff:   " (php/ltrim (php/strval difficulty) ":")))
                  blnk
                  (sec "PLAYER")
                  (bord (str "  lives:  " (php/min lives cap-l) "/" cap-l))
                  (bord (str "  armor:  " armor "/3"))
                  ;; Literal prefixes are "  keys:   " / "  buffs:  "
                  ;; — both 10 visible cols. Pad = w - (10 + visible
                  ;; len of the coloured value).
                  (str "│\e[97m  keys:   " keys-str
                       (help-pad "" (php/max 0 (php/- w (php/+ 10 (length-without-sgr keys-str)))))
                       "│")
                  (str "│\e[97m  buffs:  " buffs-str
                       (help-pad "" (php/max 0 (php/- w (php/+ 10 (length-without-sgr buffs-str)))))
                       "│")
                  blnk
                  (sec "WEAPONS  ( > = active )")])
                (to-php-array weapon-rows)
                (to-php-array
                 [blnk
                  (sec "COMPASS HINT")
                  (bord "  Top E S W N strip tints the letter")
                  (bord "  pointing at your next quest target:")
                  (bord "    \e[38;5;214;1morange\e[40;97m = exit door")
                  (bord "    \e[94;1mblue\e[40;97m / \e[91;1mred\e[40;97m = keycard (locked door)")
                  (bord "  Use it to navigate without the 2D map.")
                  blnk
                  (sec "CONTROLS")
                  (bord "  wasd / ↑↓     move forward / back")
                  (bord "  a / d         strafe left / right")
                  (bord "  ← →           turn left / right")
                  (bord "  e             about-face (snap 180)")
                  (bord "  space         fire")
                  (bord "  r             reload")
                  (bord "  1 / 2 / 3     switch weapon slot")
                  (bord "  m             toggle minimap")
                  (bord "  n             toggle sound")
                  (bord "  F3            debug overlay")
                  (bord "  p             pause / resume")
                  (bord "  h / ESC      close this menu")
                  (bord "  q             quit")
                  blnk
                  (str "└" bar "┘")])))]
    (let [n    (count rows)
          col0 (php/max 1 (php/- (php/+ (php/intdiv vw 2) 1)
                                 (php/intdiv (php/+ help-inner-width 2) 2)))
          row0 (php/max 1 (php/intdiv (php/max 1 (php/- vh n)) 2))]
      (loop [i 0 acc ""]
        (if (php/>= i n)
          acc
          (recur (php/+ i 1)
                 (str acc "\e[" (php/+ row0 i) ";" col0 "H\e[40;97m"
                      (get rows i) "\e[0m")))))))

(defn- pause-menu-string
  "Build the pause overlay as a single ANSI string with absolute cursor
   moves. Pure: caller pushes it into the parts array."
  [vw vh sound-on?]
  (let [rows
        (let [w pause-inner-width]
          (let [bar  (php/str_repeat "─" w)
                blnk (str "│" (pause-pad "" w) "│")]
            ;; Minimal post-refactor: PAUSED title + credits. The full
            ;; controls reference lives in the H info menu now, so the
            ;; pause overlay stays a quick visual confirmation of the
            ;; freeze rather than a wall of text. `sound-on?` kept in
            ;; the signature so callers don't need to change; not used.
            [(str "┌" bar "┐")
             blnk
             (str "│\e[1;93m" (pause-pad "             PAUSED" w) "\e[40;97m│")
             blnk
             (str "│\e[2;97m" (pause-pad "   H for info  ·  ESC resumes" w) "\e[22;40;97m│")
             blnk
             (str "├" bar "┤")
             blnk
             ;; Dim text (\e[2) leaks through pause-pad's \e[40;97m
             ;; because BG/FG SGR does not reset the intensity attribute.
             ;; Explicit \e[22 (normal intensity) before the right border
             ;; keeps the `│` bright white like every other row.
             (str "│\e[2;97m" (pause-pad "  phel-doom by Chemaclass" w) "\e[22;40;97m│")
             (str "│\e[2;97m" (pause-pad "  written in Phel Lang"   w) "\e[22;40;97m│")
             blnk
             (str "└" bar "┘")]))]
    (let [col0 (php/max 1 (php/- (php/+ (php/intdiv vw 2) 1)
                                 (php/intdiv (php/+ pause-inner-width 2) 2)))
          row0 (php/max 1 (php/- (php/intdiv vh 2) 4))]
      (loop [i 0 acc ""]
        (if (php/>= i (count rows))
          acc
          (recur (php/+ i 1)
                 (str acc "\e[" (php/+ row0 i) ";" col0 "H\e[40;97m"
                      (get rows i) "\e[0m")))))))

(defn- layout
  "Viewport fills the whole terminal. The minimap is an overlay in the
   top-right corner that the M key shows or hides. The HUD row count
   grows by one when the F3 debug overlay is on so the perf row can
   sit above the standard footer without clipping the 3D view.

   On narrow terminals the minimap auto-scales so it never claims
   more than roughly a third of the screen width: `:map-step` is
   the grid:minimap block size (1 = 1:1, 2 = every 2nd cell, etc.)
   and `:map-mw` is the resulting on-screen minimap width in cols."
  [cols rows grid-w stats]
  (let [max-mw  (php/max 8 (php/intdiv cols 3))
        step    (php/max 1 (php/intval (php/ceil (php// grid-w max-mw))))
        mini-mw (php/intval (php/ceil (php// grid-w step)))]
    {:vw       cols
     :vh       (- rows (hud-rows-for stats))
     :map-col  (php/max 1 (+ (- cols mini-mw) 1))
     :map-row  1
     :map-step step
     :map-mw   mini-mw}))

(defn- pulse
  "Pause-aware sin-wave beat at `freq` rad/s, sampled at game-time `t`
   (seconds). Returns true for half the cycle, false for the other
   half. Caller passes the world's :game-time so the beat freezes
   whenever the game does — used to throb pickups, door glyph, torch
   lights, behind-warning, etc. without per-element state tracking."
  [^float t ^float freq]
  (php/> (php/sin (php/* t freq)) 0.0))

;; =====================================================================
;; § Overlay paint helpers
;;
;; Each fn appends one logical UI overlay to the parts vector via
;; absolute cursor positioning. Frame->string composes the base raycast
;; frame then calls these in order. Keeping them as defn-s makes
;; frame->string scannable + each overlay independently testable.
;; =====================================================================

;; All paint-* helpers below take a `parts` PHP-array, append their
;; absolute-positioned ANSI escapes via php/array_push, and RETURN
;; the array. PHP arrays are pass-by-value at fn boundaries, so the
;; caller MUST rebind parts to the returned value; otherwise the
;; mutations stay local to the helper and the overlay never shows.
;; (Painfully learned: missing pistol, missing hearts HUD.)

(def scare-face-glyph
  "Universal jump-scare face — bright magenta BG, blink white skull.
   Picked outside the existing red/yellow face-attack palette so the
   colour shift itself reads as 'this is different' even at small
   sprite sizes. Painted on every visible alive enemy during the
   scare-secs window."
  "\e[5;48;5;201;38;5;231;1m☠\e[0m")

(defn- visuals-for-type
  "Catalog lookup for a type kw, falling back to the level's primary
   `:enemy` type from stats when the enemy carries no `:type`, then
   to `:imp` as a last resort so visuals are never empty (every enemy
   gets a face overlay, no silent skips on unknown types)."
  [type-kw stats]
  (or (get enemy-types type-kw)
      (get enemy-types (or (get stats :enemy) :imp))
      (get enemy-types :imp)))

(defn- paint-face-overlay
  "At each visible alive enemy's centre column paint that enemy's
   catalog face glyph at the upper-third of the sprite. Three modes:
     - scare-secs active  → wide-eyed scare glyph (one-shot beat)
     - d < aggro-distance → :face-attack telegraph
     - else               → resting :face (alternates with :face-alt
                            on the global face-phase beat)"
  [parts world stats vw vh dists face-phase]
  (let [scare? (php/> (or (get stats :scare-secs) 0.0) 0.0)]
    (doseq [proj (collect-enemy-projs (:enemies world) (:player world) vw)]
           (let [col         (:col proj)
                 d           (:dist proj)
                 visuals     (visuals-for-type (:type proj) stats)
                 face        (get visuals :face)
                 face-alt    (or (get visuals :face-alt) face)
                 face-attack (get visuals :face-attack)
                 idle        (if (php/> face-phase 0.0) face face-alt)
                 glyph       (cond
                               scare?                                     scare-face-glyph
                               (and face-attack (php/< d aggro-distance)) face-attack
                               :else                                      idle)]
             (when (and glyph
                        (php/>= col 0)
                        (php/< col vw)
                        (php/< d (buf-get dists col)))
               (let [h        (php/min vh (php/intval (php// proj-dist
                                                             (php/* (php/max 0.5 d) char-aspect))))
                     face-row (php/+ (php/intdiv (php/- vh h) 2) (php/intdiv h 6))]
                 (when (and (php/>= face-row 1) (php/<= face-row vh))
                   (buf-push parts
                             (str "\e[" face-row ";"
                                  (php/+ col 1) "H" glyph))))))))
  parts)

(defn- paint-wall-lights
  "~3% of wall cells get a flickering torch glyph painted near the
   wall top. Deduped per (hx, hy) so adjacent screen cols of the same
   wall cell share one torch."
  [parts ^float t vw vh hits hxs hys tops]
  (let [seen (buf-mk)
        tcol (if (pulse t 7.0) "\e[1;38;5;220m" "\e[1;38;5;208m")]
    (loop [col 0]
      (when (php/< col vw)
        (when (php/=== 1 (buf-get hits col))
          (let [hx   (buf-get hxs col)
                hy   (buf-get hys col)
                k    (str hx "-" hy)
                hash (mod (php/+ (php/* hx 73856093) (php/* hy 19349663)) 100)]
            (when (and (php/< hash 3) (php/=== (buf-get seen k) nil))
              (buf-set seen k true)
              (let [r (php/max 1 (php/+ (buf-get tops col) 1))]
                (when (php/<= r vh)
                  (buf-push parts
                            (str "\e[" r ";" (php/+ col 1) "H"
                                 tcol "✦\e[0m")))))))
        (recur (php/+ col 1)))))
  parts)

(defn- paint-crosshair
  "Centre `+` glyph. Jumps one row up + brightens while :fire-anim > 0
   so the recoil feels like a kick.

   `center-bg` is the SGR-only prefix of the cell currently under the
   crosshair (the wall/door body shade at the centre column). Painting
   the `+` on that BG keeps the cell's real colour visible underneath
   instead of clobbering it with the terminal default."
  [parts stats vw vh center-bg]
  (let [firing? (php/> (or (get stats :fire-anim) 0.0) 0.0)
        ch-row  (php/+ (php/intdiv vh 2) (if firing? 0 1))
        ch-col  (php/+ (php/intdiv vw 2) 1)
        ch-att  (if firing? "\e[97;1m" "\e[97;2m")]
    (buf-push parts
              (str "\e[" ch-row ";" ch-col "H" center-bg ch-att "+\e[0m")))
  parts)

(defn- paint-intro-splash
  "Centred banner showing 'LEVEL N · NAME' while :intro-secs > 0.
   On locked levels (L4 blue / L5 red) appends a 'FIND THE <COLOUR>
   KEY' subtitle so the player knows the door at the exit needs a
   keycard before they go hunting for it. Subtitle SGR matches the
   lock colour so the cue reads at a glance."
  [parts stats vw vh]
  (when (php/> (or (get stats :intro-secs) 0.0) 0.0)
    (let [title    (str "LEVEL " (or (get stats :level) 1)
                        " · " (php/strtoupper (or (get stats :level-name) "")))
          lock     (get stats :door-lock)
          subtitle (cond
                     (php/=== lock :blue) "FIND THE BLUE KEY"
                     (php/=== lock :red)  "FIND THE RED KEY"
                     (php/=== lock :boss) "KILL THE BOSS TO ESCAPE"
                     :else                nil)
          sub-sgr  (cond
                     (php/=== lock :blue) "\e[40;94;1m"
                     (php/=== lock :red)  "\e[40;91;1m"
                     (php/=== lock :boss) "\e[40;38;5;196;1m"
                     :else                "\e[40;93;1m")
          ;; Box width sized to the longer of title / subtitle so
          ;; both lines fit symmetrically with the same 4-col pad.
          inner    (php/max (php/mb_strlen title)
                            (if subtitle (php/mb_strlen subtitle) 0))
          bw       (php/+ inner 8)
          bar      (php/str_repeat "─" bw)
          centred  (fn [text]
                     (let [pad-total (php/- bw (php/mb_strlen text))
                           pad-l     (php/intdiv pad-total 2)
                           pad-r     (php/- pad-total pad-l)]
                       (str (php/str_repeat " " pad-l) text
                            (php/str_repeat " " pad-r))))
          n-rows   (if subtitle 5 3)
          row0     (php/max 1 (php/- (php/intdiv vh 2) (php/intdiv n-rows 2)))
          col0     (php/max 1 (php/- (php/+ (php/intdiv vw 2) 1)
                                     (php/intdiv (php/+ bw 2) 2)))]
      (buf-push parts
                (str "\e[" row0 ";" col0 "H\e[40;93;1m┌" bar "┐"
                     "\e[" (php/+ row0 1) ";" col0 "H\e[40;93;1m│" (centred title) "│"
                     (if subtitle
                       (str
                        "\e[" (php/+ row0 2) ";" col0 "H\e[40;93;1m├" bar "┤"
                        "\e[" (php/+ row0 3) ";" col0 "H\e[40;97m│" sub-sgr (centred subtitle) "\e[40;93;1m│"
                        "\e[" (php/+ row0 4) ";" col0 "H\e[40;93;1m└" bar "┘")
                       (str
                        "\e[" (php/+ row0 2) ";" col0 "H\e[40;93;1m└" bar "┘"))
                     "\e[0m"))))
  parts)

(defn- paint-locked-bump
  "Pulse 'NEED <COLOUR> KEY' over the upper third of the 3D view
   while :locked-door-bump-secs is ticking down. Re-fires every
   bump because try-move resets the timer to locked-bump-secs each
   collision — so leaning into a locked door keeps the cue alive."
  [parts stats vw vh]
  (let [secs (or (get stats :locked-door-bump-secs) 0.0)]
    (when (php/> secs 0.0)
      (let [colour (get stats :locked-door-bump-colour)
            label  (cond
                     (php/=== colour :blue) "  ⚿  NEED BLUE KEY  ⚿  "
                     (php/=== colour :red)  "  ⚿  NEED RED KEY  ⚿   "
                     (php/=== colour :boss) "  ☠  KILL THE BOSS  ☠  "
                     :else                  "  ⚿  NEED KEY  ⚿  ")
            sgr    (cond
                     (php/=== colour :blue) "\e[40;94;1m"
                     (php/=== colour :red)  "\e[40;91;1m"
                     (php/=== colour :boss) "\e[40;38;5;196;1m"
                     :else                  "\e[40;93;1m")
            row    (php/max 1 (php/intdiv vh 3))
            col0   (php/max 1 (php/- (php/+ (php/intdiv vw 2) 1)
                                     (php/intdiv (php/mb_strlen label) 2)))]
        (buf-push parts
                  (str "\e[" row ";" col0 "H" sgr label "\e[0m")))))
  parts)

(defn- paint-door-face
  "Disembodied red eye blinks at the upper third of every visible
   door column during the door-face active window. Re-uses the
   hits/tops/bots buffers from compute-wall-shades so we don't have
   to re-cast rays."
  [parts stats vw vh hits tops bots]
  (when (php/> (or (get stats :door-face-active-secs) 0.0) 0.0)
    (let [glyph "\e[5;48;5;232;38;5;196;1mʘ\e[0m"]
      (loop [col 0]
        (when (php/< col vw)
          (when (let [h (buf-get hits col)] (or (php/=== 2 h) (php/=== 3 h) (php/=== 4 h)))
            (let [t (buf-get tops col)
                  b (buf-get bots col)
                  r (php/+ t (php/intdiv (php/max 1 (php/- b t)) 3))]
              (when (and (php/>= r 1) (php/<= r vh))
                (buf-push parts (str "\e[" r ";" (php/+ col 1) "H" glyph)))))
          (recur (php/+ col 1))))))
  parts)

(defn- paint-blood-drops
  "Ambient ceiling-drip overlay: paint a short trail of fading red
   glyphs at every active drop position. Columns are normalised
   (0..1) in state — multiplied by vw here. A 3-row tail fades from
   bright red into dark so each drop reads as falling rather than
   teleporting frame to frame."
  [parts stats vw vh]
  (doseq [d (or (get stats :blood-drops) [])]
         (let [col (php/+ 1 (php/intval (php/* (:col d) (php/max 1 (php/- vw 2)))))
               row (php/intval (:row d))]
           (when (and (php/>= col 1) (php/<= col vw))
             (loop [k 0]
               (when (php/< k 3)
                 (let [r    (php/- row k)
                       code (cond (php/=== k 0) 196
                                  (php/=== k 1) 124
                                  :else         52)]
                   (when (and (php/>= r 1) (php/<= r vh))
                     (buf-push parts (str "\e[" r ";" col "H\e[38;5;" code ";1m▌\e[0m"))))
                 (recur (php/+ k 1)))))))
  parts)

(defn- paint-rear-warning
  "Tiny blinking '‹ behind ›' label below the compass when at least
   one alive enemy is in the rear arc + within audible range. Dim
   red on the dark HUD strip so it reads as 'something off' without
   stealing focus from the 3D view. Blink is code-driven off
   game-time so it freezes on pause — terminal SGR 5 would keep
   ticking against the wall clock."
  [parts ^float t stats vw]
  (when (and (get stats :rear-warning?) (pulse t 3.0))
    (let [label "\e[40;38;5;160;1m‹ behind ›\e[0m"
          col   (php/max 1 (php/- (php/intdiv vw 2) 5))]
      (buf-push parts (str "\e[2;" col "H" label))))
  parts)

(defn- paint-low-ammo
  "Top-row pulsing 'LOW AMMO N' label when total firepower
   (mag + reserve) drops to 3 or fewer rounds — i.e. the player is
   3/2/1 shots away from being defenceless. Right-anchored on row 1
   so it sits next to the centre compass without overdrawing it,
   one row ABOVE paint-rear-warning's row-2 strip.

   Row 1 layout the player sees:
     [hearts/armor at col 1]  ... [compass at vw/2 ± 5]  ... [LOW AMMO right]

   Amber at 3, bright red at 1. Suppressed at 0 because the ammo
   HUD cell already flashes red when both mag and reserve hit zero."
  [parts ^float t stats vw]
  (let [total (php/+ (or (get stats :mag) 0)
                     (or (get stats :ammo-reserve) 0))]
    (when (and (php/> total 0) (php/<= total 3) (pulse t 4.0))
      (let [colour (cond (php/<= total 1) "38;5;196"
                         :else            "38;5;214")
            label  (str "\e[40;" colour ";1m! LOW AMMO " total " !\e[0m")
            ;; 14 visible chars in the label; right-anchor with a
            ;; 1-cell breathing margin so it can't bleed past vw.
            col    (php/max 1 (php/- vw 15))]
        (buf-push parts (str "\e[1;" col "H" label))))
    parts))

(defn- paint-reload-reminder
  "Periodic 'press R to RELOAD' nag above the pistol when the player
   is sitting on a near-empty mag with reserve to spare. Cadence
   scales with urgency: visible 0.5s every 5s at mag=2, every 3s at
   mag=1, every 1s at mag=0. Suppressed while reloading (cooldown
   active), when the reserve is dry (a reload would no-op), and
   while the dry-fire CLICK is on screen so the two prompts don't
   stack."
  [parts stats vw vh]
  (let [mag     (or (get stats :mag) 0)
        reserve (or (get stats :ammo-reserve) 0)
        cd      (or (get stats :reload-cooldown) 0.0)
        click   (or (get stats :empty-click-secs) 0.0)
        gt      (or (get stats :game-time) 0.0)]
    (when (and (php/> reserve 0)
               (php/<= cd 0.0)
               (php/<= click 0.0)
               (php/<= mag 2)
               (php/>= vh 9))
      (let [interval (cond (php/<= mag 0) 1.0
                           (php/<= mag 1) 3.0
                           :else          5.0)
            phase    (php/fmod gt interval)]
        (when (php/< phase 0.5)
          (let [text  " press R to RELOAD "
                label (str "\e[40;38;5;226;1m" text "\e[0m")
                col   (php/max 1 (php/- (php/intdiv vw 2)
                                        (php/intdiv (php/strlen text) 2)))
                row   (php/max 3 (php/- vh 8))]
            (buf-push parts (str "\e[" row ";" col "H" label)))))))
  parts)

(def stamina-bar-cells
  "Width of the STA bar in cells. 10 is wide enough to read the pool
   level at a glance without crowding the HUD strip on narrow
   terminals (40-col)."
  10)

(defn- stamina-chip
  "Render the sprint stamina HUD chip:
       ` STA ████████░░`
   - 10 cells total, filled = (intval (* cells (stam/max))).
   - Fill colour: white at ≥33%, amber under 33%, red when latched
     blocked OR at 0 — so the player sees the colour shift before the
     pool empties and notices the cooldown latch.
   - Same `\\e[40m` BG-wash + `\\e[40;97m` close pattern as the +pack
     / [diff] chips so the leading space + trailing handoff stay on
     the dark HUD wash on light-bg terminals."
  [stats]
  ;; :stamina + :max-stamina always populated by frame-stats; no
  ;; fallback so a missing field surfaces as a visible render bug
  ;; instead of a silently-wrong bar.
  (let [stam      (get stats :stamina)
        smax      (get stats :max-stamina)
        ratio     (php// stam smax)
        clamped   (php/max 0.0 (php/min 1.0 ratio))
        filled    (php/intval (php/floor (php/* stamina-bar-cells clamped)))
        empty-n   (php/- stamina-bar-cells filled)
        blocked?  (boolean (get stats :sprint-blocked?))
        fill-col  (cond
                    (or blocked? (php/<= stam 0.0)) "\e[40;91;1m"
                    (php/< clamped 0.33)            "\e[40;33;1m"
                    :else                           "\e[40;97;1m")
        empty-col "\e[40;38;5;240m"]
    (str "\e[40m " fill-col "STA "
         (php/str_repeat "█" filled)
         empty-col
         (php/str_repeat "░" empty-n)
         "\e[40;97m")))

(defn- paint-game-info
  "Top-left game-state strip: `L1 imps · kills 12 · ammo 7/10 [23]`,
   anchored at row 2 col 1 directly under the hearts/armor row. Left
   side stays clear of the minimap (top-right) and the centred
   compass / rear-warning. `_vw` is accepted for parity with the
   other paint-* helpers; the strip is left-anchored so vw doesn't
   feed the col math."
  [parts stats _vw]
  (let [lvl      (or (get stats :level) 1)
        name'    (or (get stats :level-name) "")
        kills    (or (get stats :kills) 0)
        wname    (or (get stats :weapon-name) "pistol")
        mag      (or (get stats :mag) 0)
        cap      (or (get stats :mag-size) 10)
        reserve  (or (get stats :ammo-reserve) 0)
        mag-low  (php/max 1 (php/intdiv cap 3))
        res-low  cap
        mag-col  (cond (php/<= mag 0)       "\e[1;91m"
                       (php/<= mag mag-low) "\e[1;93m"
                       :else                "\e[1m")
        res-col  (cond (php/<= reserve 0)       "\e[1;91m"
                       (php/<= reserve res-low) "\e[1;93m"
                       :else                    "\e[2m")
        ;; Each trailing chunk starts with an explicit `\e[40m` so
        ;; the leading-space byte renders on the dark HUD wash
        ;; instead of inheriting the terminal-default BG that a
        ;; bare `\e[0m` reset would leak (the +pack chip otherwise
        ;; rendered with white halo spaces around it on iTerm2 /
        ;; Ghostty whose default BG is light).
        pack     (if (get stats :backpack?) "\e[40m \e[40;33;1m+pack\e[40;97m" "")
        diff     (or (get stats :difficulty) :normal)
        diff-tag (cond
                   (php/=== diff :easy)      "\e[40m \e[40;32;1m[easy]\e[40;97m"
                   (php/=== diff :hard)      "\e[40m \e[40;33;1m[hard]\e[40;97m"
                   (php/=== diff :nightmare) "\e[40m \e[40;31;1m[nightmare]\e[40;97m"
                   :else                     "")
        keys'    (or (get stats :held-keys) #{})
        keys-tag (str (if (contains? keys' :blue) "\e[40m \e[40;94;1m⚿\e[40;97m" "")
                      (if (contains? keys' :red)  "\e[40m \e[40;91;1m⚿\e[40;97m" ""))
        sta-chip (stamina-chip stats)
        ;; Same wash-preserving pattern for the inline mag / reserve
        ;; recolours: replace bare \e[0m resets with \e[40;97m so
        ;; the row never falls off the dark BG mid-string.
        styled   (str "\e[40;97m\e[1mL" lvl "\e[22m " name'
                      "  \e[1mkills\e[22m " kills
                      "  \e[1m" wname "\e[22m "
                      mag-col mag "\e[22;97m/" cap " "
                      res-col "[" reserve "]\e[22;97m"
                      pack sta-chip keys-tag diff-tag "\e[0m")]
    (buf-push parts (str "\e[2;1H" styled)))
  parts)

(defn- paint-berserk-badge
  "Centred top-of-screen `BERSERK Ns` banner while :berserk-secs is
   ticking. Pulses red so the rage state is unmistakeable. Sits on
   row 3 (under the row-2 game-info strip) so it doesn't fight the
   compass / hearts."
  [parts ^float t stats vw]
  (let [secs (or (get stats :berserk-secs) 0.0)]
    (when (and (php/> secs 0.0) (pulse t 6.0))
      (let [text  (str " BERSERK " (php/intval (php/ceil secs)) "s ")
            label (str "\e[48;5;52;38;5;226;1m" text "\e[0m")
            col   (php/max 1 (php/- (php/intdiv vw 2)
                                    (php/intdiv (php/strlen text) 2)))]
        (buf-push parts (str "\e[3;" col "H" label)))))
  parts)

(defn- paint-invuln-badge
  "Centred top-of-screen `INVULN Ns` banner while :invuln-secs is
   active. Bright cyan on dark blue. Painted on row 4 so it stacks
   below the berserk banner when both fire at once."
  [parts ^float t stats vw]
  (let [secs (or (get stats :invuln-secs) 0.0)]
    (when (and (php/> secs 0.0) (pulse t 5.0))
      (let [text  (str " INVULN " (php/intval (php/ceil secs)) "s ")
            label (str "\e[48;5;19;38;5;51;1m" text "\e[0m")
            col   (php/max 1 (php/- (php/intdiv vw 2)
                                    (php/intdiv (php/strlen text) 2)))]
        (buf-push parts (str "\e[4;" col "H" label)))))
  parts)

(defn- paint-empty-click
  "Trigger pulled on an empty mag: blink a centred prompt above the
   pistol for `empty-click-seconds` so the player sees WHY the shot
   didn't fire. Wording flips based on whether reserve has rounds
   left — `R to reload` is actionable; `OUT OF AMMO` is the
   acknowledgement when both pools are dry. Label is centred from
   its measured visible length so the two variants line up even when
   their lengths differ."
  [parts stats vw vh]
  (let [secs (or (get stats :empty-click-secs) 0.0)]
    (when (and (php/> secs 0.0) (php/>= vh 8))
      (let [reserve (or (get stats :ammo-reserve) 0)
            text    (if (php/> reserve 0)
                      " -- CLICK -- press R to reload "
                      " -- CLICK --   OUT OF AMMO   ")
            sgr     (if (php/> reserve 0) "\e[40;38;5;226;1m" "\e[40;38;5;196;1m")
            label   (str sgr text "\e[0m")
            col     (php/max 1 (php/- (php/intdiv vw 2)
                                      (php/intdiv (php/strlen text) 2)))
            row     (php/max 3 (php/- vh 7))]
        (buf-push parts (str "\e[" row ";" col "H" label))))
    parts))

(defn- paint-flicker
  "Lights-flickering overlay: paint full-width dark scanlines on every
   other row while :flicker-active-secs is positive. The eye reads the
   half-mesh as a strobing dim, but the unpainted rows keep the colours
   underneath so the picture isn't blacked out. Skips the bottom 6
   rows so the pistol + HUD stays readable through the flicker."
  [parts stats vw vh]
  (when (php/> (or (get stats :flicker-active-secs) 0.0) 0.0)
    (let [line   (php/str_repeat " " vw)
          dark   "\e[48;5;232m"
          bottom (php/max 1 (php/- vh 6))]
      (loop [r 1]
        (when (php/<= r bottom)
          (when (php/=== (mod r 2) 1)
            (buf-push parts (str "\e[" r ";1H" dark line "\e[0m")))
          (recur (php/+ r 1))))))
  parts)

(defn- heartbeat-bg
  "Map heartbeat phase to a red BG ansi for the edge bar. Phase 0 is
   the strongest thump, fading by ~0.35. Returns nil when the pulse
   isn't visible this frame so the caller can skip painting."
  [^float phase ^int lives]
  (cond
    (php/>= lives 3)   nil
    (php/<= lives 0)   nil
    (php/< phase 0.10) "\e[48;5;160m"
    (php/< phase 0.22) "\e[48;5;124m"
    (php/< phase 0.32) "\e[48;5;52m"
    :else              nil))

(defn- paint-heartbeat-vignette
  "Pulsing red bar down both screen edges, intensity driven by the
   heartbeat phase. Active only at 1-2 lives, off otherwise. Painted
   AFTER the hit-vignette so a fresh hit still dominates."
  [parts stats vw vh]
  (let [lives (or (get stats :lives) 0)
        phase (or (get stats :heartbeat-phase) 0.0)
        bg    (heartbeat-bg phase lives)]
    (when bg
      (let [left-c0  1
            right-c0 (php/max 1 (php/- vw 1))
            cell     (str bg "  ")]
        (loop [r 1]
          (when (php/<= r vh)
            (buf-push parts (str "\e[" r ";" left-c0  "H" cell))
            (buf-push parts (str "\e[" r ";" right-c0 "H" cell "\e[0m"))
            (recur (php/+ r 1)))))))
  parts)

(defn- paint-hit-vignette
  "2-col red bar down the screen edge on the side the attacker came
   from. Painted while iframes active AND :hurt-side is set."
  [parts stats bloody? vw vh]
  (when (and bloody? (get stats :hurt-side))
    (let [side    (get stats :hurt-side)
          edge-bg "\e[48;5;160m  "
          edge-c0 (if (php/=== side :left) 1 (php/max 1 (php/- vw 1)))]
      (loop [r 1]
        (when (php/<= r vh)
          (buf-push parts (str "\e[" r ";" edge-c0 "H" edge-bg "\e[0m"))
          (recur (php/+ r 1))))))
  parts)

(defn- paint-heat-bar
  "10-cell heat bar under the pistol sprite. Replaced by blinking
   'JAMMED' when :jam-secs > 0. Blink is code-driven off game-time
   so the warning freezes when the game is paused."
  [parts ^float t stats vw vh]
  (let [heat (or (get stats :heat) 0.0)
        jam  (or (get stats :jam-secs) 0.0)
        cc   (php/+ (php/intdiv vw 2) 1)
        row  (php/- vh 6)]
    (when (or (php/> heat 0.0) (php/> jam 0.0))
      (cond
        (php/> jam 0.0)
        (let [sgr (if (pulse t 6.0) "\e[91;1m" "\e[2;91m")]
          (buf-push parts
                    (str "\e[" row ";" (php/- cc 3) "H" sgr "JAMMED\e[0m")))
        :else
        (let [filled (php/intval (php/* heat 10.0))
              empty  (php/- 10 filled)
              colour (cond (php/>= heat 0.85) "\e[41m"
                           (php/>= heat 0.6)  "\e[43m"
                           :else              "\e[42m")]
          (buf-push parts
                    (str "\e[" row ";" (php/- cc 5) "H"
                         colour (php/str_repeat " " filled)
                         "\e[100m" (php/str_repeat " " empty)
                         "\e[0m"))))))
  parts)

(defn- paint-kill-streak
  "'x<N> streak' under the minimap while the streak window is live.
   Yellow for 2-4, red for 5+."
  [parts stats map-col map-row visible-mh]
  (let [streak (or (get stats :streak) 0)]
    (when (php/>= streak 2)
      (let [colour (if (php/>= streak 5) "\e[40;91;1m" "\e[40;93;1m")
            label  (str colour "x" streak " streak\e[0m")
            col0   (php/max 1 (php/- (php/+ map-col (php/strlen "x99 streak"))
                                     (php/strlen "x99 streak")))]
        (buf-push parts
                  (str "\e[" (php/+ map-row visible-mh) ";"
                       col0 "H" label)))))
  parts)

(defn- sector-for-angle
  "World-radian angle → cardinal sector index 0..3 (E S W N) — same
   mapping the compass uses for the player's facing arrow."
  [^float angle]
  (let [norm (php/fmod (php/+ angle (php/* 4.0 php/M_PI))
                       (php/* 2.0 php/M_PI))]
    (mod (php/intval (php/+ 0.5 (php// norm (php// php/M_PI 2.0)))) 4)))

(defn- bearing-sector
  "Sector index (0..3 E/S/W/N) of the vector from player to target
   cell (tx, ty). Nil-safe: returns nil if either coord is nil."
  [world ^float tx ^float ty]
  (let [px (:x (:player world))
        py (:y (:player world))]
    (sector-for-angle (php/atan2 (php/- ty py) (php/- tx px)))))

(defn- quest-target-hint
  "Compass directional helper. Returns `{:sector 0..3 :tag kw}`
   where `:tag` is:
     :blue / :red  — point at the matching un-picked keycard on a
                     locked level (player still needs the key)
     :door         — point at the exit door (the key is already in
                     hand, or the level was never locked)
   nil — nothing useful to point at (no door in grid; defensive).

   Door tint reuses the in-world door SGR colour (orange) so the
   compass cue and the 3D door glyph read as the same artifact."
  [world]
  (let [lock      (:door-lock world)
        held      (or (:held-keys world) #{})
        cards     (or (:keycards world) [])
        need-key? (and lock (not (contains? held lock)))]
    (cond
      need-key?
      (let [match (first (filter (fn [k] (php/=== (:colour k) lock)) cards))]
        (if (php/=== match nil)
          nil
          {:sector (bearing-sector world (:x match) (:y match))
           :tag    lock}))

      :else
      (let [door (find-door-cell (:grid world))]
        (if (php/=== door nil)
          nil
          (let [[dx dy] door]
            ;; Aim at cell-centre so 0.5 nudges don't bias the sector
            ;; toward the cell's upper-left corner.
            {:sector (bearing-sector world (php/+ dx 0.5) (php/+ dy 0.5))
             :tag    :door}))))))

(defn- paint-compass
  "Top-centre 4-letter cardinal strip. Three highlights stack:
     - yellow bold = player's facing sector (always shown)
     - tinted bold = QUEST TARGET sector — points at the keycard
       (blue / red, lock colour) on locked levels until the player
       grabs the card, then switches to the exit door (orange,
       SGR 214 to match the in-world door glyph).
   Quest tint wins over facing tint on the same letter so the cue
   stays visible when the player is already aimed at the right
   cardinal. Other letters render dim white on the dark HUD strip."
  [parts world vw]
  (let [pang   (or (:angle (:player world)) 0.0)
        facing (sector-for-angle pang)
        quest  (quest-target-hint world)
        q-sec  (when quest (:sector quest))
        q-sgr  (cond
                 (php/=== (and quest (:tag quest)) :blue) "\e[40;94;1m"
                 (php/=== (and quest (:tag quest)) :red)  "\e[40;91;1m"
                 (php/=== (and quest (:tag quest)) :door) "\e[40;38;5;214;1m"
                 :else                                    nil)
        labels ["E" "S" "W" "N"]
        cells  (loop [i 0 acc ""]
                 (if (php/>= i 4)
                   acc
                   (recur (php/+ i 1)
                          (str acc
                               (cond
                                 (and q-sgr (php/=== i q-sec))
                                 (str q-sgr (get labels i) "\e[0m")

                                 (php/=== i facing)
                                 (str "\e[40;1;93m" (get labels i) "\e[0m")

                                 :else
                                 (str "\e[40;2;97m" (get labels i) "\e[0m"))
                               (if (php/< i 3) "\e[40m  " "")))))]
    (buf-push parts
              (str "\e[1;" (php/max 1 (php/- (php/intdiv vw 2) 3))
                   "H" cells)))
  parts)

(defn- paint-enemy-hp-flashes
  "Float the remaining HP digit above an enemy's head for the brief
   `:hit-flash-secs` window after each non-killing hit. Skips dead
   enemies and 1-HP enemies (where any hit is a kill anyway, so the
   number would always be 0 the moment it appeared). Bright yellow
   on a dark BG so the digit reads against any sprite zone behind
   it."
  [parts world vw vh]
  (let [player (:player world)]
    (doseq [e (:enemies world)]
           (when (and e
                      (:alive e)
                      (php/> (or (:lives e) 0) 0)
                      (php/> (or (:max-lives e) 1) 1)
                      (php/> (or (:hit-flash-secs e) 0.0) 0.0))
             (let [proj (project-enemy e player vw)]
               (when proj
                 (let [col (:col proj)
                       d   (:dist proj)
                       h   (php/min vh (php/intval (php// proj-dist
                                                          (php/* (php/max 0.5 d) char-aspect))))
                       row (php/max 1 (php/- (php/intdiv (php/- vh h) 2) 1))]
                   (when (and (php/>= col 1) (php/<= col vw))
                     (buf-push parts
                               (str "\e[" row ";" col "H\e[40;38;5;226;1m"
                                    (:lives e) "\e[0m")))))))))
  parts)

(defn- paint-hearts-hud
  "Top-left lives + armor count. Hearts pulse while bloody — code-
   driven off game-time so the blink freezes on pause (issue #7).
   Every glyph carries an explicit dark BG (`\\e[40m`) so the strip
   stays readable on terminals whose default BG is light or
   transparent."
  [parts ^float t stats bloody?]
  (let [l     (or (get stats :lives) 0)
        cap   (or (get stats :max-lives) 5)
        ;; Cap rendered filled hearts at `cap` so dev god mode
        ;; (lives = thousands) doesn't blow the strip across the
        ;; whole screen. Engine still tracks the real :lives value
        ;; for take-damage / heart-pickup math.
        shown (php/min l cap)
        armor (or (get stats :armor) 0)
        god?  (:god? stats)
        blink (cond (and bloody? (pulse t 8.0)) "\e[1m"
                    bloody?                     "\e[2m"
                    :else                       "\e[1m")]
    (buf-push parts
              (str "\e[1;1H\e[40m" blink "\e[91m"
                   (php/str_repeat "♥ " shown)
                   "\e[40;90m"
                   (php/str_repeat "♡ " (php/max 0 (php/- cap shown)))
                   (if (php/> armor 0)
                     (str "\e[40;94;1m" (php/str_repeat "◆ " armor))
                     "")
                   (if god? "\e[40;93;1m GOD " "")
                   "\e[0m")))
  parts)

(def reload-max-drop
  "Peak rows the pistol drops below its rest position mid-reload. The
   sprite is 6 rows tall, so 5 leaves a sliver of muzzle visible at
   the deepest dip — enough to communicate 'gun is down' without
   blanking the bottom of the screen entirely."
  5)

(def recoil-max-up
  "Peak rows the pistol kicks UP per shot. Replaces the old camera-
   tilt (which moved the whole 3D view); only the pistol sprite
   bounces now."
  2)

(defn- recoil-offset
  "Negative row delta (pistol rises) from :fire-anim. Sine curve so
   the kick peaks mid-window and lands back at rest. 0 when no shot
   is in progress."
  [stats]
  (let [t (or (get stats :fire-anim) 0.0)
        d (or (get stats :fire-anim-duration) 0.0)]
    (if (or (php/<= t 0.0) (php/<= d 0.0))
      0
      (let [progress (php/max 0.0 (php/min 1.0 (php/- 1.0 (php// t d))))]
        (php/intval (php/round (php/* recoil-max-up
                                      (php/sin (php/* progress php/M_PI)))))))))

(defn- reload-offset
  "Map a stats map to a row offset for the pistol sprite this frame.
   0 when no reload is in progress; otherwise rises smoothly to
   `reload-max-drop` at the midpoint of the reload window and falls
   back to 0 as the reload completes. Sin curve gives a natural
   drop-hold-raise without piecewise branches."
  [stats]
  (let [cd  (or (get stats :reload-cooldown) 0.0)
        dur (or (get stats :reload-duration) 0.0)]
    (if (or (php/<= cd 0.0) (php/<= dur 0.0))
      0
      (let [progress (php/max 0.0 (php/min 1.0 (php/- 1.0 (php// cd dur))))]
        (php/intval (php/round (php/* reload-max-drop
                                      (php/sin (php/* progress php/M_PI)))))))))

(defn- paint-pistol-hud
  "FPS-style pistol sprite centre-bottom + muzzle flash when firing.

   Each row's BG is taken from `floor-gradient` (trim trailing glyph
   to leave the SGR prefix) so the half-block glyphs (▐ ▌ ▄) have
   their transparent halves fall on the floor colour instead of the
   terminal default (which on some iTerm2 themes is light/white and
   draws a halo around the silhouette).

   While `:reload-cooldown` is positive, the entire sprite is shifted
   down by `reload-offset` rows so the gun visibly drops out of view
   and rises back up over the reload window — rows that would land
   past `vh` are clipped per-row so they don't wrap or trample the
   HUD beneath."
  [parts stats vw vh floor-gradient]
  (when (php/>= vh 6)
    (let [cc        (php/+ (php/intdiv vw 2) 1)
          drop      (reload-offset stats)
          ;; Recoil shifts the sprite UP (negative row delta) on every
          ;; shot. Combined with the reload drop so a fire mid-reload
          ;; just nudges the in-flight reload position.
          recoil    (recoil-offset stats)
          shift     (php/- drop recoil)
          row-bg    (fn [r]
                      (let [cell (buf-get floor-gradient r)]
                        (php/mb_substr cell 0
                                       (php/max 0 (php/- (php/mb_strlen cell) 1)))))
          ;; Render one pistol row only if the shifted row still fits
          ;; on screen. Returns the cursor + paint string or "" when
          ;; the row has slid below the viewport or above row 1.
          paint-row (fn [base-row col bg-row sgr glyphs]
                      (let [r (php/+ base-row shift)]
                        (if (or (php/> r vh) (php/< r 1))
                          ""
                          (str "\e[" r ";" col "H" (row-bg bg-row) sgr glyphs))))
          ;; Per-weapon palette comes from weapons/weapons :palette.
          ;; Falls back to the pistol scheme when no weapon spec is
          ;; passed (e.g. legacy test fixtures). Same 6-slot sprite
          ;; geometry for every weapon; only the SGRs swap so each
          ;; weapon reads with its own colour at a glance.
          palette   (or (get stats :palette)
                        {:muzzle    "\e[1;38;5;250m"
                         :slide     "\e[1;38;5;233m"
                         :slide-dim "\e[1;38;5;232m"
                         :frame     "\e[1;38;5;232m"
                         :grip-hi   "\e[1;38;5;166m"
                         :grip-lo   "\e[1;38;5;130m"})
          muzzle    (:muzzle    palette)
          slide     (:slide     palette)
          slide-dim (:slide-dim palette)
          frame     (:frame     palette)
          grip-hi   (:grip-hi   palette)
          grip-lo   (:grip-lo   palette)]
      ;; Gradient indices are 0-based for vh rows; cursor positions
      ;; are 1-based. Per-weapon silhouette dispatches on :weapon —
      ;; pistol stays narrow + single barrel, shotgun widens with a
      ;; double-barrel muzzle + heavy stock, chaingun adds a multi-
      ;; barrel cluster + wider housing.
      (let [weapon (or (get stats :weapon) :pistol)
            rows
            (cond
              (php/=== weapon :shotgun)
              (str
               (paint-row (php/- vh 5) (php/- cc 1) (php/- vh 6) muzzle    "▄▄▄▄▄▄")
               (paint-row (php/- vh 4) (php/- cc 2) (php/- vh 5) slide     "▐██████▌")
               (paint-row (php/- vh 3) (php/- cc 2) (php/- vh 4) slide     "▐████████▌")
               (paint-row (php/- vh 2) (php/- cc 3) (php/- vh 3) slide-dim "▐██████████▌")
               (paint-row (php/- vh 1) (php/- cc 3) (php/- vh 2) frame
                          (str "▐█" grip-hi "▓▓▓▓▓▓▓▓" frame "█▌"))
               (paint-row vh           (php/- cc 2) (php/- vh 1) grip-lo "▐▓▓▓▓▓▓▓▓▌"))

              (php/=== weapon :chaingun)
              (str
               (paint-row (php/- vh 5) cc           (php/- vh 6) muzzle    "▄ ▄ ▄")
               (paint-row (php/- vh 4) (php/- cc 2) (php/- vh 5) slide     "▐██████▌")
               (paint-row (php/- vh 3) (php/- cc 3) (php/- vh 4) slide     "▐████████▌")
               (paint-row (php/- vh 2) (php/- cc 3) (php/- vh 3) slide-dim "▐██████████▌")
               (paint-row (php/- vh 1) (php/- cc 3) (php/- vh 2) frame
                          (str "▐█" grip-hi "▓▓▓▓▓▓▓▓" frame "█▌"))
               (paint-row vh           (php/- cc 2) (php/- vh 1) grip-lo "▐▓▓▓▓▓▓▓▓▌"))

              :else
              (str
               (paint-row (php/- vh 5) (php/+ cc 1) (php/- vh 6) muzzle    "▄▄")
               (paint-row (php/- vh 4) cc           (php/- vh 5) slide     "▐██▌")
               (paint-row (php/- vh 3) (php/- cc 1) (php/- vh 4) slide     "▐████▌")
               (paint-row (php/- vh 2) (php/- cc 2) (php/- vh 3) slide-dim "▐██████▌")
               (paint-row (php/- vh 1) (php/- cc 2) (php/- vh 2) frame
                          (str "▐█" grip-hi "▓▓▓▓" frame "█▌"))
               (paint-row vh           (php/- cc 1) (php/- vh 1) grip-lo "▐▓▓▓▓▌")))]
        (buf-push parts (str rows "\e[0m")))
      ;; Muzzle flash suppressed during a reload (drop > 0). Tracks
      ;; the recoil so the flash hangs above the muzzle through the
      ;; kick instead of floating in stale screen space.
      (when (and (php/> (or (get stats :fire-anim) 0.0) 0.0)
                 (php/=== drop 0))
        (let [r-top (php/max 1 (php/+ (php/- vh 7) shift))
              r-bot (php/max 1 (php/+ (php/- vh 6) shift))]
          (buf-push parts
                    (str
                     "\e[" r-top ";" cc "H" (row-bg (php/- vh 8)) "\e[1;93m  ✦  "
                     "\e[" r-bot ";" cc "H" (row-bg (php/- vh 7)) "\e[1;93m *★* "
                     "\e[0m"))))))
  parts)

(defn- compute-wall-shades
  "Per-column wall shading. Builds and returns seven PHP-array buffers
   filled with: wall top + bottom screen rows, plus precomputed cell
   strings for the wall body, the top/bot half-block edges, and the
   top/bot ambient-shadow band.

   PHP arrays are pass-by-value in fn args, so the buffers are CREATED
   inside this fn and returned in a map; the caller destructures to
   keep the same names it used previously.

   `cast`       ray-cast outputs {:dists :hits :sides :hxs :hys}
   `palette`    {:stbl :ctbl :sky-c :floor-c :door-shade-now :door-code-now}
   `blood-cols` per-col directional blood mask (from build-blood-cols)
   `haze-shift` int 0-23: how many shade-table steps to pull walls
                toward black. Doors are kept bright as a nav cue."
  [vw vh haze-shift cast palette blood-cols]
  (let [{:keys [dists hits sides hxs hys]}                             cast
        {:keys [stbl ctbl sky-c floor-c door-shade-now door-code-now
                boss-door-shade-now boss-door-code-now]}               palette
        tops                                                           (buf-mk)
        bots                                                           (buf-mk)
        normal                                                         (buf-mk)
        top-edge                                                       (buf-mk)
        bot-edge                                                       (buf-mk)
        top-shadow                                                     (buf-mk)
        bot-shadow                                                     (buf-mk)]
    (loop [col 0]
      (when (php/< col vw)
        (let [dist      (buf-get dists col)
              wall-h    (php/min vh (php/intval
                                     (php// proj-dist (php/* (php/max 0.3 dist) char-aspect))))
              top       (php/intdiv (php/- vh wall-h) 2)
              blood?    (php/> (buf-get blood-cols col) 0.4)
              stbl-l    (if blood? shade-table-blood stbl)
              ctbl-l    (if blood? shade-code-table-blood ctbl)
              sky-c-l   (if blood? sky-blood-code sky-c)
              floor-c-l (if blood? floor-blood-code floor-c)
              h         (buf-get hits col)]
          (buf-set tops col top)
          (buf-set bots col (php/+ top wall-h))
          (cond
            (php/=== 5 h)
            (do (buf-set normal      col boss-door-shade-now)
                (buf-set top-edge    col (str "\e[48;5;" boss-door-code-now ";38;5;" sky-c-l "m▀"))
                (buf-set bot-edge    col (str "\e[48;5;" floor-c-l ";38;5;" boss-door-code-now "m▀"))
                (buf-set top-shadow  col boss-door-shade-now)
                (buf-set bot-shadow  col boss-door-shade-now))
            (or (php/=== 2 h) (php/=== 3 h) (php/=== 4 h))
            (do (buf-set normal      col door-shade-now)
                (buf-set top-edge    col (str "\e[48;5;" door-code-now ";38;5;" sky-c-l "m▀"))
                (buf-set bot-edge    col (str "\e[48;5;" floor-c-l ";38;5;" door-code-now "m▀"))
                (buf-set top-shadow  col door-shade-now)
                (buf-set bot-shadow  col door-shade-now))
            :else
            (let [idx-raw (php/max 0
                                   (php/min 23
                                            (php/+ (php/intval (php/* (php/- 1.0 (php/min 1.0 (php// dist max-depth))) 23))
                                                   (if (php/=== (buf-get sides col) 0) 2 0))))
                  ;; Haze pulls every wall cell toward index 0 (black)
                  ;; by `haze-shift` steps. 0 = full visibility; values
                  ;; come from frame->string based on player lives.
                  idx     (php/max 0 (php/- idx-raw haze-shift))]
              (let [wcode     (buf-get ctbl-l idx)
                    plain     (buf-get stbl-l idx)
                    hx        (buf-get hxs col)
                    hy        (buf-get hys col)
                    bhash     (mod (php/+ (php/* hx 73856093) (php/* hy 19349663)) 100)
                    shd-idx   (php/max 0 (php/- idx 3))
                    shd-bg    (buf-get stbl-l shd-idx)
                    edge-code (buf-get ctbl-l shd-idx)]
                (buf-set normal col
                         ;; Architectural brick texture: ~4% of wall
                         ;; cells (was 14%; dropped the `·` dot variant
                         ;; that read as bright noise rather than
                         ;; mortar). Three glyphs left (▤▦▥) keep
                         ;; mortar variety without speckling every
                         ;; corridor.
                         (if (php/< bhash 4)
                           (let [dcode (buf-get ctbl-l (php/max 0 (php/- idx 5)))
                                 glyph (cond (php/=== (mod bhash 3) 0) "▤"
                                             (php/=== (mod bhash 3) 1) "▦"
                                             :else                     "▥")]
                             (str "\e[48;5;" wcode ";38;5;" dcode "m" glyph))
                           plain))
                (buf-set top-edge   col (str "\e[48;5;" edge-code ";38;5;" sky-c-l "m▀"))
                (buf-set bot-edge   col (str "\e[48;5;" floor-c-l ";38;5;" edge-code "m▀"))
                (buf-set top-shadow col shd-bg)
                (buf-set bot-shadow col shd-bg))))
          (recur (php/+ col 1)))))
    {:tops tops :bots bots :normal normal
     :top-edge top-edge :bot-edge bot-edge
     :top-shadow top-shadow :bot-shadow bot-shadow}))

(defn- paint-blood-fx-into
  "Walk every blood fx in `stats`, project to screen, and write the
   ttl-tiered death-stage shade (kill-flash → slump → collapse →
   blood-mid → blood-dim) into the `blood-paint` overlay buffer for
   the rows the sprite covers. Skips cells occluded by walls.

   Returns the mutated buffer — PHP arrays pass by value, so the
   caller must rebind to see the writes."
  [blood-paint stats world dists vw vh]
  (doseq [fx (or (get stats :fx) [])]
         (let [proj (project-enemy fx (:player world) vw)]
           (when proj
             (let [col    (:col proj)
                   hw     (:half-width proj)
                   d      (:dist proj)
                   bsh    (let [ttl (or (:ttl fx) 0.0)]
                            (cond (php/> ttl 0.65) kill-flash
                                  (php/> ttl 0.5)  death-slump
                                  (php/> ttl 0.35) death-collapse
                                  (php/> ttl 0.15) blood-mid
                                  :else            blood-dim))
                   c-from (php/max 0 (php/- col hw))
                   c-to   (php/min (php/- vw 1) (php/+ col hw))
                   h      (php/min vh (php/intval (php// proj-dist
                                                         (php/* (php/max 0.5 d) char-aspect))))
                   r-top  (php/+ (php/intdiv (php/- vh h) 2) (php/intdiv (php/* h 2) 3))
                   r-bot  (php/min vh (php/+ (php/intdiv (php/- vh h) 2) h))]
               (loop [c c-from]
                 (when (php/<= c c-to)
                   (when (php/< d (buf-get dists c))
                     (loop [r r-top]
                       (when (php/< r r-bot)
                         (buf-set blood-paint (php/+ (php/* r vw) c) bsh)
                         (recur (php/+ r 1)))))
                   (recur (php/+ c 1))))))))
  blood-paint)

(defn- pickup-visible-at?
  "True when a pickup at depth `d` would be visible at screen column
   `c` — i.e. no closer wall (dists) and no closer enemy (edists)
   blocks the line of sight."
  [^float d c dists edists]
  (let [wd (buf-get dists c)
        ed (buf-get edists c)]
    (and (php/< d wd)
         (or (php/=== ed nil) (php/< d ed)))))

(defn- paint-pickups-into
  "Project each pickup (heart / armor) to screen and write its
   coloured BG glow into `blood-paint`, then drop the icon glyph at
   the centre cell. Same routine for both pickup types; only the
   shade + glyph differ. Per-column visibility check honours both
   walls AND enemies — pickups behind either don't draw.

   Returns the mutated buffer — PHP arrays pass by value, so the
   caller must rebind to see the writes."
  [blood-paint pickups player dists edists vw vh shade-now glyph-now]
  (doseq [item pickups]
         (let [proj (project-enemy item player vw)]
           (when proj
             (let [col    (:col proj)
                   hw     (php/max 1 (php/intdiv (:half-width proj) 2))
                   d      (:dist proj)
                   c-from (php/max 0 (php/- col hw))
                   c-to   (php/min (php/- vw 1) (php/+ col hw))
                   h      (php/min vh (php/intval (php// proj-dist
                                                         (php/* (php/max 0.5 d) char-aspect))))
                   mid    (php/+ (php/intdiv (php/- vh h) 2) (php/intdiv h 2))
                   r-top  (php/max 0 (php/- mid (php/intdiv h 6)))
                   r-bot  (php/min vh (php/+ mid (php/intdiv h 6) 1))]
               (loop [c c-from]
                 (when (php/<= c c-to)
                   (when (pickup-visible-at? d c dists edists)
                     (loop [r r-top]
                       (when (php/< r r-bot)
                         (buf-set blood-paint (php/+ (php/* r vw) c) shade-now)
                         (recur (php/+ r 1)))))
                   (recur (php/+ c 1))))
               ;; Centre icon overlay: single cell wins over the BG
               ;; fill because the inner row loop reads blood-paint
               ;; first.
               (when (and (php/>= col 0)
                          (php/< col vw)
                          (php/>= mid 0)
                          (php/< mid vh)
                          (pickup-visible-at? d col dists edists))
                 (buf-set blood-paint
                          (php/+ (php/* mid vw) col)
                          glyph-now))))))
  blood-paint)

(defn build-blood-cols
  "Directional blood mask: per-column intensity in [0, 1]. Non-zero
   only when iframes active AND a hurt-side is set. Fades from 1.0
   at the screen edge that took the hit toward 0 at the centre.
   Exported so tests can pin the falloff behaviour."
  [vw bloody? hurt-side]
  (let [m  (buf-mk)
        w  (php/max 1 (php/min 20 (php/intdiv vw 3)))
        sd (and bloody? hurt-side)]
    (loop [c 0]
      (when (php/< c vw)
        (buf-set m c
                 (cond
                   (not sd)           0.0
                   (php/=== sd :left) (php/max 0.0 (php/- 1.0 (php// (php/* 1.0 c) w)))
                   :else              (php/max 0.0
                                               (php/- 1.0
                                                      (php// (php/* 1.0 (php/- (php/- vw 1) c)) w)))))
        (recur (php/+ c 1))))
    m))

(defn frame->string
  "Render the world sized to cols x rows. Walls project at a constant
   scale (proj-dist from engine) with a 2:1 character-aspect correction,
   so resizing the terminal widens the FOV instead of growing the walls.
   Minimap is overlaid top-right when (:show-map world) is truthy."
  [world stats cols rows]
  (let [{:keys [vw vh map-col map-row map-step]}
        (layout cols rows (count (first (:grid world))) stats)
        bloody?                            (php/> (or (get stats :iframes) 0.0) 0.0)
        ;; Walls + sky + floor are ALL pure grayscale: enemy colours
        ;; pop against neutral stonework, and far walls fade toward
        ;; near-black (shade-table[0] = code 232) like an unseen
        ;; horizon. No per-level wall tinting; level distinction comes
        ;; from enemy sprites + intro splash + audio.
        stbl                               shade-table
        sky-gradient                       (build-horizon-gradient vh shade-table)
        ;; Floor: same grey gradient with subtle tile banding (odd
        ;; rows one fade step darker).
        floor-gradient                     (build-themed-gradient vh 239 true)
        ;; Pre-baked red gradients used when a column sits inside the
        ;; blood band: sky + floor go red for those cols so the band
        ;; reads as a coherent red corner, not red walls floating in a
        ;; grey ceiling. Built only when bloody?; otherwise nil and
        ;; the inner row loop short-circuits the blood swap.
        blood-sky-gradient                 (when bloody?
                                             (build-horizon-gradient vh shade-table-blood))
        blood-floor-gradient               blood-sky-gradient
        ;; Directional blood mask: per-column intensity in [0, 1]. Only
        ;; non-zero during i-frames AND when :hurt-side is set. Fades
        ;; from 1.0 at the screen edge that took the hit toward 0 at
        ;; the centre. Drives the per-col red-shade swap inside the
        ;; col-setup loop below. One vw-sized PHP array built per
        ;; frame; lookup is O(1) inside the loop.
        blood-cols                         (build-blood-cols vw bloody? (get stats :hurt-side))
        ehead                              enemy-head
        ebody                              enemy-body
        elegs                              enemy-body
        ;; Pause-aware clock: render samples its blinks/pulses from
        ;; this instead of wall time so every time-driven animation
        ;; freezes the moment the game is paused (issue #7).
        t                                  (or (get stats :game-time) 0.0)
        ;; Walk-cycle body glyph: same sin-wave selector as the face,
        ;; offset by π so the body glyph swaps on the OPPOSITE beat from
        ;; the face. Eye blinks and scales/muscles shift on alternating
        ;; beats so the monster looks animated without per-enemy state.
        face-phase                         (php/sin (php/* t 3.0))
        ;; Cast phase. When the F3 overlay is on, sample microtime
        ;; around the call so render! can split cast-ms from total
        ;; frame-ms. The branch is the only debug-gated cost in the
        ;; off path — a single `(get stats :debug?)` check per frame.
        debug?                             (get stats :debug?)
        t-cast-start                       (if debug? (php/microtime true) 0.0)
        {:keys [dists hits sides hxs hys]}
        (cast-frame world vw)
        _                                  (when debug?
                                             (record-cast-ms!
                                              (php/* (php/- (php/microtime true) t-cast-start) 1000.0)))
        ;; Half-block edge cells need the sky/floor colour CODE for
        ;; the current palette so the composer can write
        ;; "\e[48;5;WALL;38;5;SKYm▀" and let ▀'s upper half show sky.
        sky-c                              sky-code
        floor-c                            floor-code
        ctbl                               shade-code-table
        ;; Subtle pulse on interactive pickups so the eye picks them
        ;; out of the wall colours: doors and hearts cycle between
        ;; two shades on a sin wave. Wall clock so the rhythm stays
        ;; the same regardless of fps. Frequencies differ (4 vs 6
        ;; rad/s) so the two pulses don't lock together.
        door-bright?                       (pulse t 4.0)
        door-shade-now                     (if door-bright? "\e[48;5;130;38;5;226m▌" door-shade)
        door-code-now                      (if door-bright? "130" door-code)
        ;; Boss door pulses on a faster, alarm-ish beat (5 rad/s) so
        ;; the L10 exit reads as 'kill the boss to open' even at the
        ;; far end of the arena.
        boss-door-bright?                  (pulse t 5.0)
        boss-door-shade-now                (if boss-door-bright? "\e[48;5;124;38;5;226;1m▌" boss-door-shade)
        boss-door-code-now                 (if boss-door-bright? "124" boss-door-code)
        ;; Pickup pulse: systole/diastole BG + matching centre glyph
        ;; both swap on the same beat so the icon throbs in tempo.
        heart-bright?                      (pulse t 6.0)
        heart-shade-now                    (if heart-bright? heart-shade-bright heart-shade)
        heart-glyph-now                    (if heart-bright? heart-glyph-bright heart-glyph)
        armor-bright?                      (pulse t 5.0)
        ;; Aggro head pulse: same code-driven swap so a monster in
        ;; striking range throbs without relying on terminal blink.
        aggro-bright?                      (pulse t 5.0)
        armor-shade-now                    (if armor-bright? armor-shade-bright armor-shade)
        armor-glyph-now                    (if armor-bright? armor-glyph-bright armor-glyph)
        ;; Ammo-box pulse: warm-brown crate to yellow flare at 7 rad/s
        ;; — slower than hearts so the two pickup types read distinct
        ;; even when both are in frame.
        ammo-bright?                       (pulse t 7.0)
        ammo-shade-now                     (if ammo-bright? ammo-shade-bright ammo-shade)
        ammo-glyph-now                     (if ammo-bright? ammo-glyph-bright ammo-glyph)
        ;; Berserk pulse — faster than ammo so a rage sphere flashes
        ;; the most aggressively of any pickup, telegraphing the buff.
        berserk-bright?                    (pulse t 9.0)
        berserk-shade-now                  (if berserk-bright? berserk-shade-bright berserk-shade)
        berserk-glyph-now                  (if berserk-bright? berserk-glyph-bright berserk-glyph)
        ;; Invuln pulse — different cadence (8 rad/s) so a sphere on
        ;; the same screen as a berserk doesn't sync up into one beat.
        invuln-bright?                     (pulse t 8.0)
        invuln-shade-now                   (if invuln-bright? invuln-shade-bright invuln-shade)
        invuln-glyph-now                   (if invuln-bright? invuln-glyph-bright invuln-glyph)
        ;; Backpack pulse — slowest of the powerup family so the
        ;; one-shot pickup reads as 'permanent gear' rather than a
        ;; ticking buff.
        backpack-bright?                   (pulse t 4.0)
        backpack-shade-now                 (if backpack-bright? backpack-shade-bright backpack-shade)
        backpack-glyph-now                 (if backpack-bright? backpack-glyph-bright backpack-glyph)
        ;; Keycards pulse at the same beat as pickups; colour is per-
        ;; card so paint-keycards-into picks the right shade.
        keycard-bright?                    (pulse t 5.5)
        keycard-blue-shade-now             (if keycard-bright? keycard-blue-bright keycard-blue-shade)
        keycard-blue-glyph-now             (if keycard-bright? keycard-blue-glyph-bright keycard-blue-glyph)
        keycard-red-shade-now              (if keycard-bright? keycard-red-bright keycard-red-shade)
        keycard-red-glyph-now              (if keycard-bright? keycard-red-glyph-bright keycard-red-glyph)
        weapon-pickup-bright?              (pulse t 3.0)
        shotgun-pickup-shade-now           (if weapon-pickup-bright? shotgun-pickup-bright shotgun-pickup-shade)
        shotgun-pickup-glyph-now           (if weapon-pickup-bright? shotgun-pickup-glyph-bright shotgun-pickup-glyph)
        chaingun-pickup-shade-now          (if weapon-pickup-bright? chaingun-pickup-bright chaingun-pickup-shade)
        chaingun-pickup-glyph-now          (if weapon-pickup-bright? chaingun-pickup-glyph-bright chaingun-pickup-glyph)
        ;; Atmospheric haze pulls walls toward black as lives drop, so
        ;; the world reads as 'consumed by darkness' the closer the
        ;; player is to dying. Sky / floor untouched; doors keep their
        ;; full-brightness pulse so the exit stays findable.
        haze-shift                         (let [l (or (get stats :lives) 0)]
                                             (cond
                                               (php/<= l 0) 0
                                               (php/<= l 1) 6
                                               (php/<= l 2) 3
                                               (php/<= l 3) 1
                                               :else        0))
        ;; Per-column wall geometry + shade arrays. compute-wall-shades
        ;; CREATES them fresh and returns them (PHP arrays are passed
        ;; by value so a mutating helper can't mutate the caller's
        ;; buffers — we let the helper own the allocation + return).
        ;; Phel destructure reads `:keyword local-name`, so the order
        ;; is opposite to Clojure's `{local :keyword}`.
        {:tops              tops
         :bots              bots
         :normal            shades-normal
         :top-edge          shades-top-edge
         :bot-edge          shades-bot-edge
         :top-shadow        shades-top-shadow
         :bot-shadow        shades-bot-shadow}
        (compute-wall-shades vw vh haze-shift
                             {:dists dists :hits hits :sides sides
                              :hxs hxs    :hys hys}
                             {:stbl stbl :ctbl ctbl
                              :sky-c sky-c :floor-c floor-c
                              :door-shade-now door-shade-now
                              :door-code-now  door-code-now
                              :boss-door-shade-now boss-door-shade-now
                              :boss-door-code-now  boss-door-code-now}
                             blood-cols)
        ;; Enemy sprite zone boundaries (head/body/legs). For each
        ;; column carrying an enemy:
        ;;   row in [tops, mids)   -> head
        ;;   row in [mids, lowers) -> body
        ;;   row in [lowers, bots) -> legs
        mids                               (buf-mk)
        lowers                             (buf-mk)
        emask                              (buf-mk)
        ;; Per-column enemy shade strings. Each enemy projection
        ;; computes faded variants of head/body/legs based on its
        ;; distance and writes them into these arrays for the
        ;; columns it covers.
        eheads                             (buf-mk)
        ebodys                             (buf-mk)
        elegss                             (buf-mk)
        ;; Per-column nearest-enemy distance. Set when the enemy paints
        ;; a column (only if the enemy is in front of the wall there).
        ;; Pickups read it to occlude themselves behind enemies the same
        ;; way `dists` occludes them behind walls.
        edists                             (buf-mk)
        blood-paint                        (buf-mk)
        ;; Pulse the minimap door glyph on the same beat as the 3D
        ;; door shade so the exit catches the eye both in first-person
        ;; and on the overhead map.
        mini-door                          (if door-bright? minimap-door-pulse minimap-door)
        mrows                              (if (:show-map world)
                                             (minimap-rows world mini-door map-step)
                                             (buf-mk))
        visible-mh                         (php/min (php/count mrows) vh)
        ;; First 0-indexed column the minimap overdraws. When the
        ;; minimap is on, the inner row loop emits sky' for those
        ;; cells (rows < visible-mh) since the minimap blits over
        ;; them via absolute cursor positioning anyway — saves a
        ;; chain of aget + cond per cell in the overlay region.
        mini-col0                          (if (php/> visible-mh 0)
                                             (php/max 0 (php/- map-col 1))
                                             vw)]
    (doseq [proj (collect-enemy-projs (:enemies world) (:player world) vw)]
           (let [col (:col proj)
                 hw  (:half-width proj)
                 d   (:dist proj)
                 dmg (or (:damage-ratio proj) 0.0)
                 sc  (or (:scale proj) 1.0)]
             (let [c-from    (php/max 0 (php/- col hw))
                   c-to      (php/min (php/- vw 1) (php/+ col hw))
                   ;; `sc` scales the sprite vertically in lockstep with
                   ;; :half-width so bosses (cyber, sc=2.0) stay
                   ;; proportional instead of stretching wide-but-flat.
                   h         (php/min vh (php/intval (php/* sc
                                                            (php// proj-dist
                                                                   (php/* (php/max 0.5 d) char-aspect)))))
                   ;; Distance-fade factor: 0 at the player's feet,
                   ;; ~0.85 at max-depth. Squared so things stay
                   ;; saturated up close and only really dim once
                   ;; they're past mid-range.
                   dist-fade (php/min 0.85
                                      (php/* (php// d max-depth)
                                             (php// d max-depth)))
                   ;; Wound tint: combine distance fade with the per-
                   ;; enemy damage ratio so wounded sprites read as
                   ;; darker/dirtier even up close. Multiplier kept
                   ;; modest (0.35) so a fully-wounded cyberdemon at
                   ;; mid-range still reads distinct from a healthy
                   ;; one far away. Capped at 0.85 so a near-dead
                   ;; enemy never fades to invisible.
                   body-fade (php/min 0.85 (php/+ dist-fade (php/* dmg 0.35)))]
               (let [e-top (php/intdiv (php/- vh h) 2)]
                 (let [e-bot         (php/+ e-top h)
                       e-mid         (php/+ e-top (php/intdiv h 3))
                       e-lower       (php/+ e-top (php/intdiv (php/* h 2) 3))
                       ;; Per-enemy catalog lookup — mixed-monster rooms
                       ;; (boss + minions) pick the right palette per
                       ;; sprite, single-type rooms hit the same kw on
                       ;; every iteration so the cost is one map get.
                       visuals       (visuals-for-type (:type proj) stats)
                       head-code     (get visuals :head-code)
                       body-code     (get visuals :body-code)
                       legs-code     (get visuals :legs-code)
                       body-glyph-fg (get visuals :body-glyph-fg)
                       body-glyph    (if (php/< face-phase 0.0)
                                       (get visuals :body-glyph)
                                       (or (get visuals :body-glyph-alt)
                                           (get visuals :body-glyph)))
                       ;; Faded shade strings for this enemy at its
                       ;; current distance. Computed ONCE per enemy
                       ;; and assigned to every column it covers.
                       fhead         (cond
                                       (and head-code (php/< d aggro-distance))
                                       (enemy-aggro-head-string head-code aggro-bright?)
                                       head-code
                                       (enemy-shade-string head-code dist-fade)
                                       :else
                                       ehead)
                       fbody         (cond
                                       (and body-code body-glyph body-glyph-fg)
                                       (enemy-textured-shade-string body-code body-fade body-glyph body-glyph-fg)
                                       body-code
                                       (enemy-shade-string body-code body-fade)
                                       :else
                                       ebody)
                       flegs         (if legs-code (enemy-shade-string legs-code dist-fade) elegs)]
                   (loop [c c-from]
                     (when (php/<= c c-to)
                       (when (php/< d (buf-get dists c))
                         (buf-set tops c e-top)
                         (buf-set bots c e-bot)
                         (buf-set mids c e-mid)
                         (buf-set lowers c e-lower)
                         (buf-set eheads c fhead)
                         (buf-set ebodys c fbody)
                         (buf-set elegss c flegs)
                         (buf-set emask c true)
                         ;; Track nearest enemy distance for this col so
                         ;; pickups behind it occlude properly. Multiple
                         ;; enemies on the same col → keep the closest.
                         (let [prev (buf-get edists c)]
                           (when (or (php/=== prev nil) (php/< d prev))
                             (buf-set edists c d)))
                         ;; Grounding shadow: write one dark cell into
                         ;; the blood-paint overlay at the row beneath
                         ;; the sprite. Skips if outside the viewport.
                         (when (php/< e-bot vh)
                           (buf-set blood-paint
                                    (php/+ (php/* e-bot vw) c)
                                    sprite-shadow)))
                       (recur (php/+ c 1)))))))))
    ;; Chain the fx + pickup painters: each one takes the current
    ;; blood-paint, returns a new buffer (PHP arrays pass by value, so
    ;; the helper owns the allocation). Rename per step to keep phel
    ;; lint happy about shadowed-binding without losing the chain.
    ;; Threading (->) would be cleaner but trips arity-mismatch lint.
    (let [bp-fx     (paint-blood-fx-into blood-paint stats world dists vw vh)
          bp-hearts (paint-pickups-into  bp-fx (or (:hearts world) [])
                                         (:player world) dists edists vw vh
                                         heart-shade-now heart-glyph-now)
          bp-armors (paint-pickups-into  bp-hearts (or (:armors world) [])
                                         (:player world) dists edists vw vh
                                         armor-shade-now armor-glyph-now)
          bp-ammos  (paint-pickups-into  bp-armors (or (:ammo-boxes world) [])
                                         (:player world) dists edists vw vh
                                         ammo-shade-now ammo-glyph-now)
          bp-bers   (paint-pickups-into  bp-ammos (or (:berserks world) [])
                                         (:player world) dists edists vw vh
                                         berserk-shade-now berserk-glyph-now)
          bp-inv    (paint-pickups-into  bp-bers (or (:invulns world) [])
                                         (:player world) dists edists vw vh
                                         invuln-shade-now invuln-glyph-now)
          bp-pack   (paint-pickups-into  bp-inv (or (:backpacks world) [])
                                         (:player world) dists edists vw vh
                                         backpack-shade-now backpack-glyph-now)
          bp-kb     (paint-pickups-into  bp-pack
                                         (apply vector
                                                (filter (fn [k] (php/=== (:colour k) :blue))
                                                        (or (:keycards world) [])))
                                         (:player world) dists edists vw vh
                                         keycard-blue-shade-now keycard-blue-glyph-now)
          bp-kr     (paint-pickups-into  bp-kb
                                         (apply vector
                                                (filter (fn [k] (php/=== (:colour k) :red))
                                                        (or (:keycards world) [])))
                                         (:player world) dists edists vw vh
                                         keycard-red-shade-now keycard-red-glyph-now)
          bp-ws     (paint-pickups-into  bp-kr
                                         (apply vector
                                                (filter (fn [w] (php/=== (:weapon w) :shotgun))
                                                        (or (:weapon-pickups world) [])))
                                         (:player world) dists edists vw vh
                                         shotgun-pickup-shade-now shotgun-pickup-glyph-now)
          bp-wc     (paint-pickups-into  bp-ws
                                         (apply vector
                                                (filter (fn [w] (php/=== (:weapon w) :chaingun))
                                                        (or (:weapon-pickups world) [])))
                                         (:player world) dists edists vw vh
                                         chaingun-pickup-shade-now chaingun-pickup-glyph-now)
          parts     (buf-mk)]
      (dotimes [row vh]
               (loop [col 0 prev nil run 0]
                 (if (php/>= col vw)
                   (when (php/> run 0)
                     (buf-push parts prev)
                     (buf-push parts (php/str_repeat " " (php/- run 1))))
                   (let [;; Blood-band sky/floor swap: cols in the
                         ;; directional blood band use the pre-baked red
                         ;; gradients so sky + floor + walls all flush
                         ;; red on the affected side. Short-circuits to
                         ;; the normal gradients when no blood is active.
                         in-blood? (and blood-sky-gradient
                                        (php/> (buf-get blood-cols col) 0.4))
                         sky-row   (buf-get (if in-blood? blood-sky-gradient sky-gradient) row)
                         flr-row   (buf-get (if in-blood? blood-floor-gradient floor-gradient) row)
                         c         (if (and (php/< row visible-mh) (php/>= col mini-col0))
                                     sky-row
                                     (or (buf-get bp-wc (php/+ (php/* row vw) col))
                                         (cond
                                           (php/< row (buf-get tops col))             sky-row
                                           (php/>= row (buf-get bots col))            flr-row
                                           (buf-get emask col)
                                           (cond
                                             (php/< row (buf-get mids col))   (buf-get eheads col)
                                             (php/< row (buf-get lowers col)) (buf-get ebodys col)
                                             :else                            (buf-get elegss col))
                                           (php/=== row (buf-get tops col))
                                           (buf-get shades-top-edge col)
                                           (php/=== row (php/+ (buf-get tops col) 1))
                                           (buf-get shades-top-shadow col)
                                           (php/=== row (php/- (buf-get bots col) 1))
                                           (buf-get shades-bot-edge col)
                                           (php/=== row (php/- (buf-get bots col) 2))
                                           (buf-get shades-bot-shadow col)
                                           :else
                                           (buf-get shades-normal col))))]
                     (cond
                       (php/=== run 0)  (recur (php/+ col 1) c 1)
                       (php/=== c prev) (recur (php/+ col 1) prev (php/+ run 1))
                       :else            (do
                                          (buf-push parts prev)
                                          (buf-push parts (php/str_repeat " " (php/- run 1)))
                                          (recur (php/+ col 1) c 1))))))
               (buf-push parts "\e[0m\n"))
      (when (get stats :debug?)
        (buf-push parts (hud-debug-line world stats))
        (buf-push parts "\n"))
      (buf-push parts (hud-line world stats))
      (dotimes [i visible-mh]
               (buf-push parts (str "\e[" (php/+ map-row i) ";" map-col "H" (buf-get mrows i))))
      ;; Overlay chain: each helper returns the parts buffer because
      ;; PHP arrays pass by value across fn boundaries. Rebind every
      ;; step so the pushed escapes actually accumulate.
      ;;
      ;; The crosshair needs the SGR-only prefix of whatever cell
      ;; sits at the centre column so `+` paints on the real cell
      ;; colour (wall, floor, sky, enemy, blood) instead of clobbering
      ;; it with the terminal default. Replays the same priority chain
      ;; the inner row loop uses (blood-paint > sky / floor > enemy
      ;; zones > wall edges / shadows > wall body). Centre row tracks
      ;; the firing kick so the resolved cell follows the crosshair.
      (let [c-col       (php/intdiv vw 2)
            firing?     (php/> (or (get stats :fire-anim) 0.0) 0.0)
            c-row       (php/+ (php/intdiv vh 2) (if firing? -1 0))
            top-col     (buf-get tops c-col)
            bot-col     (buf-get bots c-col)
            center-cell (or (buf-get bp-wc (php/+ (php/* c-row vw) c-col))
                            (cond
                              (php/< c-row top-col)             (buf-get sky-gradient c-row)
                              (php/>= c-row bot-col)            (buf-get floor-gradient c-row)
                              (buf-get emask c-col)
                              (cond
                                (php/< c-row (buf-get mids c-col))   (buf-get eheads c-col)
                                (php/< c-row (buf-get lowers c-col)) (buf-get ebodys c-col)
                                :else                                (buf-get elegss c-col))
                              (php/=== c-row top-col)           (buf-get shades-top-edge c-col)
                              (php/=== c-row (php/+ top-col 1)) (buf-get shades-top-shadow c-col)
                              (php/=== c-row (php/- bot-col 1)) (buf-get shades-bot-edge c-col)
                              (php/=== c-row (php/- bot-col 2)) (buf-get shades-bot-shadow c-col)
                              :else                             (buf-get shades-normal c-col)))
            center-bg   (php/mb_substr center-cell 0
                                       (php/max 0 (php/- (php/mb_strlen center-cell) 1)))
            ;; Overlay chain: each helper takes the parts buffer plus
            ;; its own deps and returns the (possibly larger) buffer.
            ;; Numbered rebinds so phel lint's shadowed-binding stays
            ;; quiet without changing semantics. Threading (->) would
            ;; be cleaner but trips arity-mismatch lint.
            p1          (paint-face-overlay       parts world stats vw vh dists face-phase)
            p2          (paint-wall-lights        p1 t vw vh hits hxs hys tops)
            p3          (paint-door-face          p2 stats vw vh hits tops bots)
            p4          (paint-crosshair          p3 stats vw vh center-bg)
            p5          (paint-intro-splash       p4 stats vw vh)
            p6          (paint-blood-drops        p5 stats vw vh)
            p7          (paint-flicker            p6 stats vw vh)
            p8          (paint-heartbeat-vignette p7 stats vw vh)
            p9          (paint-hit-vignette       p8 stats bloody? vw vh)
            p10         (paint-heat-bar           p9 t stats vw vh)
            p11         (paint-kill-streak        p10 stats map-col map-row visible-mh)
            p12         (paint-compass            p11 world vw)
            p13         (paint-rear-warning       p12 t stats vw)
            p14         (paint-low-ammo           p13 t stats vw)
            p15         (paint-game-info          p14 stats vw)
            p15b        (paint-berserk-badge      p15 t stats vw)
            p15c        (paint-invuln-badge       p15b t stats vw)
            p16         (paint-hearts-hud         p15c t stats bloody?)
            p17         (paint-pistol-hud         p16 stats vw vh floor-gradient)
            p18         (paint-empty-click        p17 stats vw vh)
            p19         (paint-reload-reminder    p18 stats vw vh)
            p19b        (paint-locked-bump        p19 stats vw vh)
            p20         (paint-enemy-hp-flashes   p19b world vw vh)]
        (when (get stats :paused)
          (buf-push p20 (pause-menu-string vw vh (get stats :sound-on))))
        ;; Help overlay paints last so it sits on top of the pause
        ;; menu when both are toggled at once (player paused, then
        ;; pressed H). H + P are independent flags.
        (when (get stats :help?)
          (buf-push p20 (help-menu-string vw vh stats)))
        (php/implode "" p20)))))

(defn clear-screen
  "ANSI clear + cursor home."
  []
  (print "\e[2J\e[H"))

(defn- white-flash-frame
  "Full-screen white wash, one frame. Painted on impact so the player
   sees a brief jolt before the red i-frame palette swap kicks in."
  [cols rows]
  (let [parts (buf-mk)
        line  (str "\e[107m" (php/str_repeat " " cols))]
    (buf-push parts "\e[H")
    (loop [r 1]
      (when (php/<= r rows)
        (buf-push parts (str "\e[" r ";1H" line))
        (recur (php/+ r 1))))
    (buf-push parts "\e[0m")
    (php/implode "" parts)))

(defn- update-perf-snapshot!
  "Compute the perf snapshot from the just-emitted `frame-str` and the
   `total-ms` it took, then merge it into `perf-snapshot` (cast-ms was
   already stashed by frame->string). Render-ms is whatever's left
   after subtracting cast — the same accounting the manual sanity
   check in issue #9 uses (`cast + render ≈ frame`)."
  [^string frame-str ^float total-ms]
  (let [bytes     (php/strlen frame-str)
        sgr-count (php/max 1 (php/substr_count frame-str "\e["))
        avg-rle   (php// bytes sgr-count)
        cast-ms   (or (get @perf-snapshot :cast-ms) 0.0)
        render-ms (php/max 0.0 (php/- total-ms cast-ms))]
    (swap! perf-snapshot
           (fn [snap]
             (assoc (or snap {})
                    :cast-ms      cast-ms
                    :render-ms    render-ms
                    :bytes        bytes
                    :avg-rle      avg-rle
                    :php-mem      (php/memory_get_usage true)
                    :php-mem-peak (php/memory_get_peak_usage true))))))

(defn render!
  "Move cursor home and overwrite the previous frame in place. Avoids
   the full-screen clear that would otherwise flicker each frame.
   While :flash-secs > 0 the whole viewport flashes white — a 1-frame
   impact jolt that lands before the red i-frame wash. Screen-shake:
   the first ~0.25s of the i-frame window offsets the cursor-home
   anchor by ±1 col so the next frame paints one cell off, reading
   as a snap-shake on damage. When :debug? is set, also samples
   microtime around `frame->string` and updates `perf-snapshot` so the
   next frame's HUD can paint the F3 overlay; the work is gated so
   the off path pays nothing beyond a single key read."
  [world stats cols rows]
  (let [iframes (or (get stats :iframes) 0.0)
        shake?  (php/> iframes 0.75)
        t       (or (get stats :game-time) 0.0)
        debug?  (get stats :debug?)
        shake-x (if shake?
                  (php/+ 1 (mod (php/intval (php/* t 50.0)) 3))
                  1)]
    (print (str "\e[1;" shake-x "H"))
    (if (php/> (or (get stats :flash-secs) 0.0) 0.0)
      (print (white-flash-frame cols rows))
      (if debug?
        (let [t-start  (php/microtime true)
              frame    (frame->string world stats cols rows)
              total-ms (php/* (php/- (php/microtime true) t-start) 1000.0)]
          (print frame)
          (update-perf-snapshot! frame total-ms))
        (print (frame->string world stats cols rows)))))
  (php/flush))

;; ---------------------------------------------------------------------
;; End-of-game screens (death / victory).
;;
;; Same box geometry as the pause menu but full-screen washed in either
;; dark red (death) or dark green (victory). Both screens share
;; render-end-screen — the only thing each variant supplies is the
;; wash colour and the 32-wide row strings.
;; ---------------------------------------------------------------------

(def end-box-width-cap   "Upper bound on the end-screen box width."   36)
(def end-box-width-floor "Smallest readable box at very narrow vw."   22)
(def end-compact-rows    "rows below this drop separators + best-row block." 20)

(defn- end-pad
  "Right-pad `text` with spaces up to `width` visible columns."
  [text width]
  (str text (php/str_repeat " " (php/max 0 (php/- width (php/strlen text))))))

(defn- end-clip
  "Truncate `text` to at most `width` chars so a long level-name on a
   tiny terminal can't bleed past the right border."
  [text width]
  (let [n (php/strlen text)]
    (if (php/<= n width) text (php/substr text 0 width))))

(defn- end-row-text
  "Build one interior text row sized to `width`: clip first, then
   right-pad. Wrapping the SGR around it is the caller's job."
  [text width]
  (end-pad (end-clip text width) width))

(defn- end-centre
  "Centre a visible-text run inside `width` columns, wrapping the
   supplied SGR around the whole padded string."
  [text width sgr]
  (let [t (end-clip text width)
        n (php/strlen t)
        L (php/max 0 (php/intdiv (php/- width n) 2))
        R (php/max 0 (php/- width (php/+ n L)))]
    (str sgr (php/str_repeat " " L) t (php/str_repeat " " R) "\e[0m")))

(defn- end-box-width-for
  "Pick a box width that fits a 4-col total margin while staying within
   the readable floor / cap."
  [cols]
  (php/max end-box-width-floor
           (php/min end-box-width-cap (php/- cols 4))))

(defn- best-victory-cell [s]
  (if (php/<= s 0) "--" (str s "s")))

(defn- best-rows
  "Tiny 3-line block summarising the persisted best scores."
  [scores width]
  [(str "\e[2;93m" (end-row-text (str "   best kills:   " (:best-kills scores)) width) "\e[0m")
   (str "\e[2;93m" (end-row-text (str "   best level:   " (:best-level scores)) width) "\e[0m")
   (str "\e[2;93m" (end-row-text (str "   best time:    "
                                      (best-victory-cell (:fastest-victory-s scores)))
                                 width) "\e[0m")])

(defn- end-rows
  "Compose the interior row list for either variant. `title` is the
   one-line centred banner SGR-painted by the caller; `did-what` is
   the past-tense phrase under the run stats (`died on` / `cleared`).
   Compact mode (when the terminal is too short) drops the leading
   blank-line padding, the best-scores block, and most separators —
   keeps the box tall enough to read even on a 12-row split."
  [title-sgr title did-what kills survived-s level level-name scores rows width]
  (let [bl      (end-row-text "" width)
        compact (php/< rows end-compact-rows)]
    (apply vector
           (concat
            (if compact []  [bl])
            [(end-centre title width title-sgr)]
            (if compact [:sep] [bl :sep bl])
            [(str "\e[97m" (end-row-text (str "  " did-what " L" level " " level-name) width) "\e[0m")
             (str "\e[97m" (end-row-text (str "  kills:   " kills)                width) "\e[0m")
             (str "\e[97m" (end-row-text (str "  time:    " survived-s "s")       width) "\e[0m")]
            (if compact
              [:sep]
              (concat [bl :sep bl] (best-rows scores width) [bl :sep bl]))
            [(end-centre "r new  R same  q quit" width "\e[97;1m")]
            (if compact
              []
              [bl :sep bl
               (str "\e[2;97m" (end-row-text "  phel-doom by Chemaclass" width) "\e[0m")
               (str "\e[2;97m" (end-row-text "  written in Phel Lang"    width) "\e[0m")
               bl])))))

(defn- death-rows [kills survived-s level level-name scores rows width]
  (end-rows "\e[91;1m" "YOU DIED" "died on"  kills survived-s level level-name scores rows width))

(defn- victory-rows [kills survived-s level level-name scores rows width]
  (end-rows "\e[92;1m" "VICTORY!" "cleared" kills survived-s level level-name scores rows width))

(defn- render-end-screen
  "Generic end-of-game overlay: full-screen wash in `wash-bg` plus a
   centred ─┌┐│└┘ box whose contents are `items` (interior strings
   interleaved with :sep markers). Item count is clamped to the
   available rows so a tall box can't paint past the terminal bottom
   on very short terminals."
  [cols rows wash-bg items width]
  (let [parts (buf-mk)
        bar   (php/str_repeat "─" width)]
    (buf-push parts "\e[H")
    (loop [r 1]
      (when (php/<= r rows)
        (buf-push parts (str "\e[" r ";1H" wash-bg
                             (php/str_repeat " " cols)))
        (recur (php/+ r 1))))
    (let [;; Reserve 2 rows for the top + bottom border.
          max-n   (php/max 0 (php/- rows 2))
          n       (php/min max-n (count items))
          row-top (php/max 1 (php/- (php/intdiv rows 2) (php/intdiv n 2)))
          col0    (php/max 1 (php/- (php/+ (php/intdiv cols 2) 1)
                                    (php/intdiv (php/+ width 2) 2)))]
      (buf-push parts (str "\e[" row-top ";" col0
                           "H\e[40;97m┌" bar "┐\e[0m"))
      (buf-push parts (str "\e[" (php/+ row-top n 1) ";" col0
                           "H\e[40;97m└" bar "┘\e[0m"))
      (loop [i 0]
        (when (php/< i n)
          (let [item (get items i)
                row  (php/+ row-top 1 i)]
            (if (= item :sep)
              (buf-push parts (str "\e[" row ";" col0
                                   "H\e[40;97m├" bar "┤\e[0m"))
              (buf-push parts (str "\e[" row ";" col0
                                   "H\e[40;97m│" item "\e[40;97m│\e[0m"))))
          (recur (php/+ i 1)))))
    (print (php/implode "" parts))
    (php/flush)))

;; ---------------------------------------------------------------------
;; Start menu (shown once on game launch, before run-levels).
;; Pixel-perfect: every interior row is normalised to a fixed visible
;; width via end-pad (mb_strwidth on the raw text, ANSI escapes are
;; zero-width). The arrow glyphs ←→↑↓ are mb_strwidth=1 so they pad
;; correctly alongside ASCII; doubling fancy chars would skew the
;; right border.
;; ---------------------------------------------------------------------

(def start-menu-width
  "Visible character width of the menu's interior row (between the
   left and right borders). Pad target for every line."
  48)

(defn- pad-visible
  "Right-pad `text` with spaces so its visible width (ignoring ANSI
   escapes, counting wide chars correctly) hits `width`.

   Items typically end with an internal `\\e[0m` that resets every SGR
   attribute, including the menu's dark BG. Re-apply `\\e[40;97m`
   before the padding so trailing spaces stay on the menu's dark
   wash; otherwise the gap between the item and the right `│` shows
   through as default terminal BG."
  [text width]
  (let [stripped (php/preg_replace "/\\x1b\\[[0-9;]*[a-zA-Z]/" "" text)
        visible  (php/mb_strwidth stripped)
        pad      (php/str_repeat " " (php/max 0 (php/- width visible)))]
    (str text "\e[40;97m" pad)))

(defn- start-menu-rows
  "Interior strings for the start-menu box. `:sep` markers between
   sections become `├─┤` divider rows in render-start-menu.

   Adaptive to terminal height (`rows`):
     >= 32  full menu (title + credit + controls + how-to-play + footer)
     >= 24  drop the how-to-play section
     < 24   ultra-compact (title + footer only; controls listed
             behind a 'press ? for help' hint elsewhere).

   The total row count always fits inside `rows - 4` cells (box top
   border + bottom border + one cushion above + one below)."
  [rows]
  (let [w        start-menu-width
        blank    (pad-visible "" w)
        title    [blank
                  (pad-visible "      \e[1;93m✦  P H E L - D O O M  ✦\e[40;97m" w)
                  blank
                  (pad-visible "         a DOOM-lite raycaster" w)
                  (pad-visible "            written in \e[1mPhel\e[40;97m" w)]
        credit   [blank
                  (pad-visible "          \e[2;97m// crafted by \e[1;93mChemaclass\e[40;97m" w)
                  blank]
        controls [:sep blank
                  (pad-visible "  \e[1mCONTROLS\e[40;97m" w)
                  blank
                  (pad-visible "    \e[93mw s ↑ ↓\e[40;97m   move forward / back" w)
                  (pad-visible "    \e[93ma d    \e[40;97m   strafe left / right" w)
                  (pad-visible "    \e[93m← →    \e[40;97m   turn left / right" w)
                  (pad-visible "    \e[93me      \e[40;97m   about-face (snap 180°)" w)
                  (pad-visible "    \e[93mspace  \e[40;97m   fire" w)
                  (pad-visible "    \e[93mr      \e[40;97m   reload" w)
                  (pad-visible "    \e[93m1 2 3  \e[40;97m   switch weapon slot" w)
                  (pad-visible "    \e[93mh      \e[40;97m   info menu (stats + weapons)" w)
                  (pad-visible "    \e[93mm  n   \e[40;97m   toggle minimap / sound" w)
                  (pad-visible "    \e[93mp F3 q \e[40;97m   pause / debug / quit" w)
                  blank]
        howto    [:sep blank
                  (pad-visible "  \e[1mHOW TO PLAY\e[40;97m" w)
                  blank
                  (pad-visible "    Shoot enemies. Walk into a door to" w)
                  (pad-visible "    advance. Walk over a heart to refill" w)
                  (pad-visible "    a life. Pick up armor to absorb a hit." w)
                  (pad-visible "    Survive 5 levels." w)
                  blank
                  (pad-visible "  \e[1mCOMPASS HINT\e[40;97m" w)
                  blank
                  (pad-visible "    Top-centre \e[93mE S W N\e[40;97m strip tints the" w)
                  (pad-visible "    letter toward your next target:" w)
                  (pad-visible "      \e[38;5;214;1morange\e[40;97m = exit door" w)
                  (pad-visible "      \e[94;1mblue\e[40;97m / \e[91;1mred\e[40;97m = keycard (locked door)" w)
                  (pad-visible "    Use it to navigate without the 2D map." w)
                  blank]
        footer   [:sep blank
                  (pad-visible "      \e[2;97mpress any key to start\e[40;97m" w)
                  blank]]
    (apply vector
           (cond
             ;; Full menu: title + credit + controls + how-to-play + footer.
             (php/>= rows 32) (concat title credit controls howto footer)
             ;; Medium: drop the how-to-play section.
             (php/>= rows 24) (concat title credit controls footer)
             ;; Tight: title + footer only, with a hint that resizing
             ;; reveals the full menu.
             :else            (concat title
                                      [blank
                                       (pad-visible "       \e[2;97mresize terminal for full menu\e[40;97m" w)
                                       blank]
                                      footer)))))

(defn render-start-menu
  "Full-screen wash + centred bordered box listing controls and a
   how-to-play blurb. Same geometry helpers as render-end-screen so
   borders align pixel-perfect with the rest of the UI."
  [cols rows]
  (let [items (start-menu-rows rows)
        parts (buf-mk)
        bar   (php/str_repeat "─" start-menu-width)
        wash  "\e[48;5;233m"]
    (buf-push parts "\e[H")
    (loop [r 1]
      (when (php/<= r rows)
        (buf-push parts (str "\e[" r ";1H" wash
                             (php/str_repeat " " cols)))
        (recur (php/+ r 1))))
    (let [n       (count items)
          row-top (php/max 1 (php/- (php/intdiv rows 2) (php/intdiv n 2)))
          col0    (php/max 1 (php/- (php/+ (php/intdiv cols 2) 1)
                                    (php/intdiv (php/+ start-menu-width 2) 2)))]
      (buf-push parts (str "\e[" row-top ";" col0
                           "H\e[40;97m┌" bar "┐\e[0m"))
      (buf-push parts (str "\e[" (php/+ row-top n 1) ";" col0
                           "H\e[40;97m└" bar "┘\e[0m"))
      (loop [i 0]
        (when (php/< i n)
          (let [item (get items i)
                row  (php/+ row-top 1 i)]
            (if (= item :sep)
              (buf-push parts (str "\e[" row ";" col0
                                   "H\e[40;97m├" bar "┤\e[0m"))
              (buf-push parts (str "\e[" row ";" col0
                                   "H\e[40;97m│" item "\e[40;97m│\e[0m"))))
          (recur (php/+ i 1)))))
    (print (php/implode "" parts))
    (php/flush)))

(defn render-death-screen
  "Centred YOU DIED box on a dark-red wash. Shows this run + the
   persisted bests from the scores file. Box width adapts to `cols`
   (capped 22..36) and switches to a compact layout when `rows`
   drops below `end-compact-rows` so tiny terminals still fit."
  [cols rows kills survived-s level level-name scores]
  (let [w (end-box-width-for cols)]
    (render-end-screen cols rows "\e[48;5;52m"
                       (death-rows kills survived-s level level-name scores rows w)
                       w)))

(defn render-victory-screen
  "Centred VICTORY box on a dark-green wash. Same responsive width +
   compact-mode rules as render-death-screen."
  [cols rows kills survived-s level level-name scores]
  (let [w (end-box-width-for cols)]
    (render-end-screen cols rows "\e[48;5;22m"
                       (victory-rows kills survived-s level level-name scores rows w)
                       w)))
