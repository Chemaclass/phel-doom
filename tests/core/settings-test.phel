(ns phel-doom-tests.core.settings-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.core.difficulty :refer [difficulty-choices])
  (:require phel-doom.core.settings :refer [default-settings
                                            page-fields field-count field-at
                                            coerce-settings resolve-subpixel
                                            move-cursor adjust
                                            navigate valid-difficulty?
                                            music-volume sfx-scalar music-ceiling
                                            mouse-sensitivity mouse-sensitivity-neutral
                                            view-bob-intensity
                                            pause-menu-options pause-menu-count
                                            pause-menu-move pause-menu-action]))

;; ---------------------------------------------------------------------
;; Defaults + page shape
;; ---------------------------------------------------------------------

(deftest test-default-settings-shape
  (is (= 60 (:music default-settings)))
  (is (= 90 (:sfx default-settings)))
  (is (= false (:minimap default-settings)))
  (is (= :normal (:difficulty default-settings)))
  (is (= :cross (:crosshair default-settings)))
  (is (= false (:timer default-settings)))
  (is (= true (:mouse default-settings)) "mouselook on by default (#246)")
  (is (= 50 (:sensitivity default-settings)) "neutral 1.0x sensitivity (#246)")
  (is (= false (:high-contrast default-settings)))
  (is (= :none (:colorblind default-settings)))
  (is (= false (:fast-walls default-settings)))
  (is (= true (:subpixel default-settings)) "sub-pixel half-blocks on by default")
  (is (= false (:truecolor default-settings)) "truecolor off by default (256-palette parity)")
  (is (= false (:quad default-settings)) "quad detail off by default")
  (is (= 0 (:view-bob default-settings)) "head bob off by default (#411, shipped look unchanged)")
  (is (= false (:light default-settings)) "room light off by default (#418, golden frames unchanged)"))

(deftest test-page-has-all-fields-in-order
  ;; Mouse + Sensitivity (#246) sit after Run timer, before the
  ;; accessibility block. View bob (#411) then Room light (#418) are
  ;; appended last.
  (is (= 16 (field-count)))
  (is (= [:music :sfx :minimap :difficulty :crosshair :timer
          :mouse :sensitivity :high-contrast :colorblind :fast-walls :subpixel :truecolor :quad :view-bob :light]
         (map :key page-fields))))

(deftest test-field-at-returns-descriptor-or-nil
  (is (= :music (:key (field-at 0))))
  (is (= :difficulty (:key (field-at 3))))
  (is (= :crosshair (:key (field-at 4))))
  (is (= :mouse (:key (field-at 6))))
  (is (= :sensitivity (:key (field-at 7))))
  (is (= :high-contrast (:key (field-at 8))))
  (is (= :colorblind (:key (field-at 9))))
  (is (= :fast-walls (:key (field-at 10))))
  (is (= :subpixel (:key (field-at 11))))
  (is (= :truecolor (:key (field-at 12))))
  (is (= :quad (:key (field-at 13))))
  (is (= :view-bob (:key (field-at 14))))
  (is (= :light (:key (field-at 15))))
  (is (nil? (field-at 16)))
  (is (nil? (field-at -1))))

;; ---------------------------------------------------------------------
;; coerce-settings: clamp + validate loaded values
;; ---------------------------------------------------------------------

(deftest test-coerce-fills-missing-from-defaults
  (is (= default-settings (coerce-settings {})))
  (is (= default-settings (coerce-settings nil))))

(deftest test-coerce-clamps-volumes-into-0-100
  (let [s (coerce-settings {:music 250 :sfx -40 :minimap true :difficulty :hard})]
    (is (= 100 (:music s)) "music clamps to 100")
    (is (= 0 (:sfx s)) "sfx clamps to 0")))

(deftest test-coerce-rejects-unknown-difficulty
  (is (= :normal (:difficulty (coerce-settings {:difficulty :ultraviolence}))))
  (is (= :nightmare (:difficulty (coerce-settings {:difficulty :nightmare})))))

(deftest test-coerce-forces-minimap-bool
  (is (= true  (:minimap (coerce-settings {:minimap 1}))))
  (is (= false (:minimap (coerce-settings {:minimap nil})))))

(deftest test-coerce-colorblind-defaults-and-validates
  ;; Accessibility (issue #200): colorblind mode falls back to :none when
  ;; missing or unrecognised, and passes a valid CVD keyword through.
  (is (= :none (:colorblind (coerce-settings {}))))
  (is (= :none (:colorblind (coerce-settings {:colorblind :ultraviolence}))))
  (is (= :deuteran (:colorblind (coerce-settings {:colorblind :deuteran}))))
  (is (= :tritan (:colorblind (coerce-settings {:colorblind :tritan})))))

;; ---------------------------------------------------------------------
;; move-cursor: wraps both ends
;; ---------------------------------------------------------------------

(deftest test-move-cursor-steps-and-wraps
  (is (= 1 (move-cursor 0 1)))
  (is (= 0 (move-cursor 1 -1)))
  ;; Derive the last index from field-count so appending a field doesn't
  ;; break the wrap pins.
  (let [last-idx (php/- (field-count) 1)]
    (is (= last-idx (move-cursor 0 -1)) "up from the first field wraps to the last")
    (is (= 0 (move-cursor last-idx 1)) "down from the last field wraps to the first")))

;; ---------------------------------------------------------------------
;; adjust: per-kind value changes
;; ---------------------------------------------------------------------

(deftest test-adjust-volume-steps-by-ten-and-clamps
  (is (= 70 (:music (adjust default-settings :music 1))))
  (is (= 50 (:music (adjust default-settings :music -1))))
  ;; From 90, one step up lands on 100; a further step clamps there.
  (is (= 100 (:music (adjust (assoc default-settings :music 90) :music 1))))
  (is (= 100 (:music (adjust (assoc default-settings :music 100) :music 1)))
      "music clamps at 100")
  (is (= 0 (:sfx (adjust (assoc default-settings :sfx 10) :sfx -1))))
  (is (= 0 (:sfx (adjust (assoc default-settings :sfx 0) :sfx -1))) "clamps at 0"))

(deftest test-adjust-minimap-toggles-regardless-of-direction
  (is (= true  (:minimap (adjust default-settings :minimap 1))))
  (is (= true  (:minimap (adjust default-settings :minimap -1))))
  (is (= false (:minimap (adjust (assoc default-settings :minimap true) :minimap 1)))))

(deftest test-adjust-difficulty-cycles-and-wraps
  (is (= :hard      (:difficulty (adjust default-settings :difficulty 1))))
  (is (= :easy      (:difficulty (adjust default-settings :difficulty -1))))
  (is (= :easy      (:difficulty (adjust (assoc default-settings :difficulty :nightmare) :difficulty 1)))
      "nightmare wraps forward to easy")
  (is (= :nightmare (:difficulty (adjust (assoc default-settings :difficulty :easy) :difficulty -1)))
      "easy wraps back to nightmare"))

(deftest test-adjust-crosshair-cycles-by-its-own-choices
  ;; The :enum cycle is now generic (per-field :choices), not difficulty-
  ;; specific: crosshair runs :cross -> :dot -> :open -> :off and wraps.
  (is (= :dot   (:crosshair (adjust default-settings :crosshair 1))))
  (is (= :off   (:crosshair (adjust default-settings :crosshair -1))) "cross wraps back to off")
  (is (= :cross (:crosshair (adjust (assoc default-settings :crosshair :off) :crosshair 1)))
      "off wraps forward to cross")
  ;; adjusting crosshair must not touch difficulty (separate choice lists).
  (is (= :normal (:difficulty (adjust default-settings :crosshair 1)))))

(deftest test-adjust-timer-toggles
  (is (= true  (:timer (adjust default-settings :timer 1))))
  (is (= false (:timer (adjust (assoc default-settings :timer true) :timer 1)))))

(deftest test-coerce-validates-crosshair-and-timer
  (is (= :cross (:crosshair (coerce-settings {:crosshair :bogus}))) "bad crosshair -> :cross")
  (is (= :open  (:crosshair (coerce-settings {:crosshair :open}))) "valid crosshair kept")
  (is (= :cross (:crosshair (coerce-settings {}))) "missing crosshair -> default")
  (is (= true   (:timer (coerce-settings {:timer 1}))) "timer coerced to bool"))

(deftest test-coerce-forces-high-contrast-bool
  (is (= true  (:high-contrast (coerce-settings {:high-contrast 1}))))
  (is (= false (:high-contrast (coerce-settings {}))) "missing -> default false"))

(deftest test-coerce-forces-fast-walls-bool
  (is (= true  (:fast-walls (coerce-settings {:fast-walls 1}))) "fast-walls coerced to bool")
  (is (= false (:fast-walls (coerce-settings {}))) "missing -> default false"))

(deftest test-coerce-forces-subpixel-bool
  (is (= true  (:subpixel (coerce-settings {:subpixel 1}))) "truthy coerced to bool true")
  (is (= false (:subpixel (coerce-settings {:subpixel false}))) "explicit false preserved")
  (is (= true  (:subpixel (coerce-settings {}))) "missing -> default true"))

(deftest test-coerce-forces-truecolor-bool
  (is (= true  (:truecolor (coerce-settings {:truecolor 1}))) "truthy coerced to bool true")
  (is (= false (:truecolor (coerce-settings {:truecolor false}))) "explicit false preserved")
  (is (= false (:truecolor (coerce-settings {}))) "missing -> default false"))

(deftest test-coerce-forces-quad-bool
  (is (= true  (:quad (coerce-settings {:quad 1}))) "truthy coerced to bool true")
  (is (= false (:quad (coerce-settings {:quad false}))) "explicit false preserved")
  (is (= false (:quad (coerce-settings {}))) "missing -> default false"))

;; ---------------------------------------------------------------------
;; resolve-subpixel: terminal-aware startup default (#332). Args are
;; (value saved? seams? force-on?). macOS Terminal.app shreds the ▀
;; half-block, so a fresh player on a seam terminal defaults OFF.
;; ---------------------------------------------------------------------

(deftest test-resolve-subpixel-seam-terminal-unsaved-defaults-off
  ;; Fresh player on Terminal.app: value is the default-on, but no saved
  ;; choice + seam terminal -> off.
  (is (= false (resolve-subpixel true false true false))))

(deftest test-resolve-subpixel-non-seam-terminal-keeps-default-on
  ;; iTerm2 etc.: not a seam terminal, so the default-on value stands.
  (is (= true (resolve-subpixel true false false false))))

(deftest test-resolve-subpixel-saved-choice-overrides-seam-default
  ;; A saved choice wins over the seam default: a player who turned
  ;; sub-pixel back ON on Terminal.app keeps it (true, not the seam's
  ;; false) — this is what distinguishes `saved?` from `seams?`.
  (is (= true  (resolve-subpixel true  true true false)) "saved on -> on")
  (is (= false (resolve-subpixel false true true false)) "saved off -> off"))

(deftest test-resolve-subpixel-env-force-on-beats-everything
  ;; PHEL_DOOM_SUBPIXEL=1 forces on even on a seam terminal and even over a
  ;; saved off.
  (is (= true (resolve-subpixel true  false true true)))
  (is (= true (resolve-subpixel false true  true true)) "force-on overrides saved off"))

;; ---------------------------------------------------------------------
;; Mouse + Sensitivity (issue #246).
;; ---------------------------------------------------------------------

(deftest test-coerce-forces-mouse-bool
  (is (= true  (:mouse (coerce-settings {:mouse 1}))))
  (is (= false (:mouse (coerce-settings {:mouse false}))) "explicit false kept")
  ;; A nil value can't be told apart from "missing" by `get`, so it heals
  ;; to the default (on) rather than off - same as the other bool fields.
  (is (= true  (:mouse (coerce-settings {:mouse nil}))) "nil heals to default on")
  (is (= true  (:mouse (coerce-settings {}))) "missing -> default true"))

(deftest test-coerce-clamps-sensitivity-into-0-100
  (is (= 100 (:sensitivity (coerce-settings {:sensitivity 250}))) "clamps to 100")
  (is (= 0   (:sensitivity (coerce-settings {:sensitivity -40}))) "clamps to 0")
  (is (= 50  (:sensitivity (coerce-settings {}))) "missing -> default 50"))

(deftest test-adjust-mouse-toggles
  (is (= false (:mouse (adjust default-settings :mouse 1))) "on -> off")
  (is (= true  (:mouse (adjust (assoc default-settings :mouse false) :mouse 1))) "off -> on"))

(deftest test-adjust-sensitivity-steps-by-ten-and-clamps
  (is (= 60 (:sensitivity (adjust default-settings :sensitivity 1))))
  (is (= 40 (:sensitivity (adjust default-settings :sensitivity -1))))
  (is (= 100 (:sensitivity (adjust (assoc default-settings :sensitivity 100) :sensitivity 1))) "clamps at 100")
  (is (= 0 (:sensitivity (adjust (assoc default-settings :sensitivity 0) :sensitivity -1))) "clamps at 0"))

(defn- approx?
  "Float compare with a tolerance, for the geometric sensitivity curve
   whose ends land on irrational multipliers (3^-1, 3^-0.8...)."
  [^float a ^float b]
  (php/< (php/abs (php/- a b)) 1.0e-9))

(deftest test-mouse-sensitivity-maps-percent-to-multiplier
  ;; Geometric span^((pct-50)/50) around the midpoint (#275): 50% neutral
  ;; 1.0x (back-compat for saved settings), 0% ~0.33x (1/3), 100% 3.0x.
  ;; Distinctly slower at the low end, distinctly faster at the high end -
  ;; the wider slow<->fast range the old 0..2x linear map lacked.
  (is (= 1.0 (mouse-sensitivity (assoc default-settings :sensitivity mouse-sensitivity-neutral)))
      "50% stays the neutral 1.0x (saved-settings back-compat)")
  (is (approx? (php// 1.0 3.0) (mouse-sensitivity (assoc default-settings :sensitivity 0)))
      "0% slows to ~0.33x (1/3), not off")
  (is (= 3.0 (mouse-sensitivity (assoc default-settings :sensitivity 100)))
      "100% speeds up to 3.0x"))

(deftest test-mouse-sensitivity-is-geometric-and-symmetric
  ;; The curve is geometric, so points equidistant from the midpoint are
  ;; reciprocals (40% and 60% multiply to 1.0) and the low end is a usable
  ;; slow speed, NOT zero - the key behaviour change from the linear map.
  (let [low  (mouse-sensitivity (assoc default-settings :sensitivity 40))
        high (mouse-sensitivity (assoc default-settings :sensitivity 60))]
    (is (approx? 1.0 (php/* low high)) "equidistant percents are reciprocals")
    (is (php/< low 1.0) "below neutral is slower than 1.0x")
    (is (php/> low 0.0) "but never fully off (unlike the old 0% = 0.0)")))

;; ---------------------------------------------------------------------
;; View bob (issue #411): a :pct amplitude for the walk-cycle head bob,
;; 0 = off (default).
;; ---------------------------------------------------------------------

(deftest test-coerce-clamps-view-bob-into-0-100
  (is (= 100 (:view-bob (coerce-settings {:view-bob 250}))) "clamps to 100")
  (is (= 0   (:view-bob (coerce-settings {:view-bob -40}))) "clamps to 0")
  (is (= 0   (:view-bob (coerce-settings {}))) "missing -> default 0"))

(deftest test-adjust-view-bob-steps-by-ten-and-clamps
  (is (= 10 (:view-bob (adjust default-settings :view-bob 1))))
  (is (= 0  (:view-bob (adjust default-settings :view-bob -1))) "clamps at 0")
  (is (= 100 (:view-bob (adjust (assoc default-settings :view-bob 100) :view-bob 1))) "clamps at 100"))

(deftest test-view-bob-intensity-maps-percent-to-unit-interval
  ;; Linear pct -> [0.0, 1.0] amplitude scalar (like sfx-scalar).
  (is (= 0.0 (view-bob-intensity (assoc default-settings :view-bob 0))))
  (is (= 1.0 (view-bob-intensity (assoc default-settings :view-bob 100))))
  (is (= 0.6 (view-bob-intensity (assoc default-settings :view-bob 60)))))

(deftest test-view-bob-intensity-nil-settings-is-off
  ;; Headless / golden-frame callers pass no :settings map; that must read
  ;; as off (0.0) so those frames stay byte-identical.
  (is (= 0.0 (view-bob-intensity nil))))

(deftest test-adjust-unknown-field-is-noop
  (is (= default-settings (adjust default-settings :nope 1))))

;; ---------------------------------------------------------------------
;; Volume mappings consumed by io/sound + io/music
;; ---------------------------------------------------------------------

(deftest test-music-volume-maps-percent-to-afplay-scalar
  (is (= 0.0 (music-volume (assoc default-settings :music 0))))
  (is (= music-ceiling (music-volume (assoc default-settings :music 100))))
  ;; 60% default maps to the 0.30 baseline music level.
  (is (= 0.3 (music-volume (assoc default-settings :music 60)))))

(deftest test-sfx-scalar-maps-percent-to-unit-interval
  (is (= 0.0 (sfx-scalar (assoc default-settings :sfx 0))))
  (is (= 1.0 (sfx-scalar (assoc default-settings :sfx 100))))
  (is (= 0.9 (sfx-scalar (assoc default-settings :sfx 90)))))

(deftest test-difficulty-choices-easiest-first
  (is (= [:easy :normal :hard :nightmare] difficulty-choices)))

(deftest test-valid-difficulty-guards-the-keyword-list
  (is (= true  (valid-difficulty? :nightmare)))
  (is (= true  (valid-difficulty? :easy)))
  (is (= false (valid-difficulty? :ultraviolence)))
  (is (= false (valid-difficulty? nil))))

;; ---------------------------------------------------------------------
;; navigate: shared cursor-move + value-adjust used by both the start
;; menu and the in-game overlay.
;; ---------------------------------------------------------------------

(deftest test-navigate-moves-cursor-without-adjusting
  (let [r (navigate default-settings 0 1 0)]
    (is (= 1 (:cursor r)) "cursor-dir +1 steps down")
    (is (= false (:adjusted? r)) "no value change")
    (is (= default-settings (:settings r)))))

(deftest test-navigate-adjusts-selected-field
  ;; cursor 0 = Music; value-dir +1 raises it a step, flags adjusted.
  (let [r (navigate default-settings 0 0 1)]
    (is (= 0 (:cursor r)))
    (is (= 70 (:music (:settings r))))
    (is (= true (:adjusted? r)))))

(deftest test-navigate-moves-then-adjusts-the-new-field
  ;; Move to SFX (cursor 1) AND adjust in the same step: the adjust
  ;; targets the field the cursor lands on, not the one it left.
  (let [r (navigate default-settings 0 1 -1)]
    (is (= 1 (:cursor r)))
    (is (= 80 (:sfx (:settings r))) "SFX 90 -> 80")
    (is (= 60 (:music (:settings r))) "Music untouched")))

(deftest test-navigate-noop-when-both-dirs-zero
  (let [r (navigate default-settings 2 0 0)]
    (is (= 2 (:cursor r)))
    (is (= false (:adjusted? r)))
    (is (= default-settings (:settings r)))))

;; ---------------------------------------------------------------------
;; Pause menu (issue #203): navigable top-level menu model.
;; ---------------------------------------------------------------------

(deftest test-pause-menu-options-order
  (is (= [:resume :settings :restart :quit] pause-menu-options))
  (is (= 4 (pause-menu-count))))

(deftest test-pause-menu-move-wraps
  (is (= 1 (pause-menu-move 0 1)))
  (is (= 0 (pause-menu-move 1 -1)))
  (is (= 3 (pause-menu-move 0 -1)) "up from the first option wraps to the last")
  (is (= 0 (pause-menu-move 3 1)) "down from the last option wraps to the first"))

(deftest test-pause-menu-action-resolves-option
  (is (= :resume   (pause-menu-action 0)))
  (is (= :settings (pause-menu-action 1)))
  (is (= :restart  (pause-menu-action 2)))
  (is (= :quit     (pause-menu-action 3)))
  ;; Out-of-range wraps rather than returning nil.
  (is (= :resume   (pause-menu-action 4))))
