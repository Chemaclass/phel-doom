(ns phel-doom-tests.io.demo-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.io.demo :as demo))

(deftest test-frames-json-round-trip
  (let [frames [["w" 16] ["s a" 17] ["" 16]]
        back   (demo/json->demo (demo/frames->json 4242 frames))]
    (is (= 4242 (:seed back)))
    (is (= frames (:frames back)))))

(deftest test-json-demo-rejects-malformed
  (is (= nil (demo/json->demo "garbage not json"))))

(deftest test-json-demo-rejects-version-mismatch
  (let [o (php/array)]
    (php/aset o "version" 99)
    (php/aset o "frames" (php/array))
    (is (= nil (demo/json->demo (php/json_encode o))))))

(deftest test-json-demo-rejects-malformed-frames
  ;; Valid version but a non-array :frames must be rejected (nil),
  ;; matching the docstring - not throw or yield {:frames []}.
  (let [o (php/array)]
    (php/aset o "version" demo/demo-version)
    (php/aset o "seed" 1)
    (php/aset o "frames" "not-an-array")
    (is (= nil (demo/json->demo (php/json_encode o))))))

(deftest test-json-demo-rejects-malformed-frame-elements
  ;; The frames container being an array is not enough: scalar or short
  ;; elements used to decode to [nil nil] pairs, and the nil ms fed the
  ;; loop's dt arithmetic.
  (let [with-frames (fn [frames]
                      (let [o (php/array)]
                        (php/aset o "version" demo/demo-version)
                        (php/aset o "seed" 1)
                        (php/aset o "frames" frames)
                        (php/json_encode o)))]
    (is (= nil (demo/json->demo (with-frames (php/array 1 2 3)))) "scalar frames")
    (is (= nil (demo/json->demo (with-frames (php/array (php/array "w")))))
        "one-element frame")
    (is (= nil (demo/json->demo (with-frames (php/array (php/array "w" "soon")))))
        "non-numeric ms")))

(deftest test-json-demo-rejects-non-string-keys-field
  ;; The keys field feeds key-states / str-contains?, which throw on a
  ;; non-string. Such a demo used to parse fine and then explode on the
  ;; first replayed frame, after the terminal was already in raw mode.
  (let [with-frames (fn [frames]
                      (let [o (php/array)]
                        (php/aset o "version" demo/demo-version)
                        (php/aset o "seed" 1)
                        (php/aset o "frames" frames)
                        (php/json_encode o)))]
    (is (= nil (demo/json->demo (with-frames (php/array (php/array 123 16))))) "int keys")
    (is (= nil (demo/json->demo (with-frames (php/array (php/array true 16))))) "bool keys")
    (is (= nil (demo/json->demo (with-frames (php/array (php/array 1.5 16))))) "float keys")))

(deftest test-record-mode-flags
  (demo/start-record! 1)
  (is (demo/recording?))
  (is (not (demo/replaying?)))
  (is (= 1 (demo/run-seed)))
  (demo/reset-off!)
  (is (not (demo/recording?))))

(deftest test-replay-feeds-frames-then-ends
  (demo/start-replay! 9 [["w" 16] ["s" 17]])
  (let [f1 (demo/resolve-frame! "x" 99)
        f2 (demo/resolve-frame! "x" 99)
        f3 (demo/resolve-frame! "x" 99)]
    (is (= "w" (:keys f1)) "first recorded frame, terminal ignored")
    (is (= 16 (:ms f1)))
    (is (= "s" (:keys f2)))
    (is (= true (:end? f3)) "stream exhausted -> end"))
  (demo/reset-off!))

(deftest test-off-mode-passes-through
  (demo/reset-off!)
  (let [f (demo/resolve-frame! "wd" 16)]
    (is (= "wd" (:keys f)))
    (is (= 16 (:ms f)))))

;; --- recording to disk ----------------------------------------------
;;
;; `--record` promises the player a replayable file. save-recording!'s
;; return value is the only signal play.phel has: true prints "Thanks
;; for playing", false reports the path and exits non-zero. A recording
;; silently discarded is a total loss of what the player asked for, so
;; both arms are pinned here.

(defn- in-temp-dir [f]
  (let [dir (str (php/sys_get_temp_dir) "/" (php/uniqid "phel-doom-demo-test-"))]
    (php/mkdir dir 0777 true)
    (try
      (f dir)
      (finally
        (doseq [p (php/glob (str dir "/*"))] (php/unlink p))
        (php/rmdir dir)
        (demo/reset-off!)))))

(deftest test-a-recorded-session-round-trips-through-a-file
  ;; Record two frames, save, read it back: the seed and the input
  ;; stream must survive, or the replay reproduces a different run.
  (in-temp-dir
   (fn [dir]
     (let [path (str dir "/run.json")]
       (demo/start-record! 4242)
       (demo/resolve-frame! "w" 16)
       (demo/resolve-frame! "wa" 17)
       (is (= true (demo/save-recording! path)) "a writable path reports success")
       (is (php/file_exists path) "the demo file is on disk")
       (let [back (demo/read-demo path)]
         (is (= 4242 (:seed back)) "the run's seed survives")
         (is (= [["w" 16] ["wa" 17]] (:frames back)) "the input stream survives"))))))

(deftest test-a-failed-recording-write-reports-false
  ;; Unwritable directory: play.phel turns this false into a message
  ;; naming the path and a non-zero exit, instead of claiming the run
  ;; was saved.
  (in-temp-dir
   (fn [dir]
     (demo/start-record! 7)
     (demo/resolve-frame! "w" 16)
     (php/chmod dir 0500)                         ; read + execute, no write
     ;; file_put_contents warns on the failure by design; silence it so
     ;; CI output stays readable. The return value is the contract.
     (let [prev (php/error_reporting 0)
           ok   (demo/save-recording! (str dir "/nope.json"))]
       (php/error_reporting prev)
       (php/chmod dir 0700)                       ; restore so cleanup works
       (is (= false ok) "an unwritable path reports failure")))))

(deftest test-saving-outside-a-recording-session-is-not-a-success
  ;; Nothing was captured, so there is nothing to promise the player.
  (in-temp-dir
   (fn [dir]
     (demo/reset-off!)
     (let [path (str dir "/idle.json")]
       (is (= false (demo/save-recording! path)) "not recording -> false")
       (is (not (php/file_exists path)) "and no file is written")))))
