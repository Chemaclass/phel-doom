(ns phel-doom-tests.modules.core.level-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.modules.core.level :refer [config-for num-levels build-world]))

(deftest test-config-for-returns-each-level
  (is (= "imps"        (:name (config-for 1))))
  (is (= "demons"      (:name (config-for 2))))
  (is (= "cacodemons"  (:name (config-for 3))))
  (is (= "barons"      (:name (config-for 4))))
  (is (= "cyberdemons" (:name (config-for 5)))))

(deftest test-config-for-clamps-out-of-range
  ;; n < 1 yields the first level; n > num-levels yields the last.
  (is (= "imps"        (:name (config-for 0))))
  (is (= "imps"        (:name (config-for -10))))
  (is (= "cyberdemons" (:name (config-for 99)))))

(deftest test-num-levels-is-five
  (is (= 5 num-levels)))

(deftest test-build-world-stamps-level-metadata
  (let [w (build-world 3 5)]
    (is (= 3 (:level w)))
    (is (= "cacodemons" (:level-name w)))
    (is (= 1.3 (:chase-speed w)))
    (is (>= (count (:enemies w)) 1))
    ;; grid + pgrid both present and the same dimensions.
    (is (>= (count (:grid w)) 24))))

(deftest test-build-world-clamps-level-for-bad-input
  (let [w (build-world 999 5)]
    ;; build-world reads through config-for which clamps to the last
    ;; entry, but the :level field reflects what the caller asked for.
    (is (= "cyberdemons" (:level-name w)))))

(deftest test-build-world-spawns-heart-when-lives-low
  (let [w (build-world 2 3)]
    (is (= 1 (count (:hearts w))))
    (is (= 3 (:lives w)))))

(deftest test-build-world-skips-heart-at-max-lives
  (let [w (build-world 2 5)]
    (is (= 0 (count (:hearts w))))
    (is (= 5 (:lives w)))))
