;; Public facade for the render layer.
;;
;; render.phel was a 3500-line monolith; it is now split into focused
;; sub-namespaces under src/io/render/ (buffer, palette, frame-math, hud,
;; paint, main). This file re-exports the stable public surface so callers
;; (commands/play, tests) keep requiring `phel-doom.io.render` unchanged.
;; See docs/rendering.md for the module map.
(ns phel-doom.io.render
  (:require phel-doom.io.render.frame-math)
  (:require phel-doom.io.render.hud)
  (:require phel-doom.io.render.paint)
  (:require phel-doom.io.render.main))

;; --- main: per-frame pipeline + screens
(def render! phel-doom.io.render.main/render!)
(def clear-screen phel-doom.io.render.main/clear-screen)
(def read-perf-snapshot phel-doom.io.render.main/read-perf-snapshot)
(def render-start-menu phel-doom.io.render.main/render-start-menu)
(def render-settings! phel-doom.io.render.main/render-settings!)
(def render-death-screen phel-doom.io.render.main/render-death-screen)
(def render-victory-screen phel-doom.io.render.main/render-victory-screen)

;; --- frame-math: projection + visibility (used by tests)
(def direction-char phel-doom.io.render.frame-math/direction-char)
(def project-enemy phel-doom.io.render.frame-math/project-enemy)
(def enemy-front-visible-at? phel-doom.io.render.frame-math/enemy-front-visible-at?)
(def scene-rows phel-doom.io.render.frame-math/scene-rows)

;; --- paint: reload reminder + blood columns (used by tests)
(def reload-reminder-visible? phel-doom.io.render.paint/reload-reminder-visible?)
(def build-blood-cols phel-doom.io.render.paint/build-blood-cols)

;; --- hud: help menu rows (used by tests)
(def help-menu-rows phel-doom.io.render.hud/help-menu-rows)
