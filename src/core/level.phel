(ns phel-doom.core.level
  (:require phel-doom.core.rng :as rng)
  (:require phel-doom.core.state      :refer [apply-ceil-heights apply-floor-heights max-backpacks max-lives new-player new-world with-enemies])
  (:require phel-doom.core.map        :refer [cell-door cell-door-blue cell-door-red cell-door-yellow count-secrets parse-layout random-grid random-spawn seed-doors seed-secrets])
  (:require phel-doom.core.enemy      :refer [default-wander-fraction promote-wanderers spawn-enemies spawn-enemies-mixed])
  (:require phel-doom.core.enemy-ai   :refer [aggression-for])
  (:require phel-doom.core.enemies    :refer [enemy-types type-spec default-lives-for])
  (:require phel-doom.core.difficulty :refer [normalise scale-cfg]))

;; ---------------------------------------------------------------------
;; Level catalog + fresh-world factory.
;;
;; All progression knobs (room size, wall count, monster count, monster
;; type, chase speed, sprite colours) live in `levels`. Adding a new
;; level is a single map literal; nothing else needs to change.
;;
;; build-world wires a chosen level into a brand-new world record by
;; combining the random map generator, door seeding, player spawn, and
;; monster spawning. The IO shell (play.phel) doesn't know any of these
;; numbers — it just asks for level N.
;; ---------------------------------------------------------------------

(def enemy-min-spawn-dist
  "How far from the player a fresh enemy must spawn (world units), so
   the first frame isn't an ambush."
  3.0)

;; ---------------------------------------------------------------------
;; Stair / platform / pit showcase (issue #237). Turns the dormant
;; variable-height feature (#232 floor / #235 ceiling / #233 Z physics)
;; ON for players. Geometry is authored as a flat `:layout` room plus a
;; `:floor-heights` map so every raised cell lands on a known floor cell
;; (a procgen room could drop a step onto a wall). Lives on L2 so the
;; player meets verticality right after the flat L1 tutorial; L1 itself
;; stays flat (it is the golden-frame render fixture).
;; ---------------------------------------------------------------------

(def showcase-step-rise
  "Per-step floor rise on the showcase staircase, in world z. Kept at or
   below `physics/step-up-max` (0.4) so each step auto-climbs when the
   player walks into it instead of blocking like a wall."
  0.3)

(def showcase-pit-depth
  "How far the showcase pit floor sits below the surrounding ground, in
   world z (a negative floor). Set to one step-up so the player drops in
   under gravity and can still walk back out (the 0.4 rise back to ground
   is exactly `physics/step-up-max`)."
  -0.4)

(defn- rect-heights
  "Build a `{[x y] h}` floor/ceiling-height map covering the inclusive
   cell rectangle `[x0..x1] x [y0..y1]`, every cell set to height `h`.
   Pure data helper for composing showcase geometry; the per-cell maps
   `apply-floor-heights` / `apply-ceil-heights` consume have exactly this
   `[x y] -> height` shape."
  [^int x0 ^int y0 ^int x1 ^int y1 ^float h]
  (loop [y   y0
         acc {}]
    (if (php/> y y1)
      acc
      (recur (php/+ y 1)
             (loop [x x0 row-acc acc]
               (if (php/> x x1)
                 row-acc
                 (recur (php/+ x 1) (assoc row-acc [x y] h))))))))

(def showcase-floor-heights
  "Per-cell floor `z` for the L2 showcase (#237): a four-step staircase
   rising north (rows 8->5, cols 8-13) onto a raised platform plateau
   (rows 2-4, same cols) that serves as a vantage, plus a sunken pit in
   the south-west (rows 12-13, cols 4-7). Each stair is one
   `showcase-step-rise`; the plateau holds the top stair height so the
   step-top and platform read as one continuous walkable surface."
  (merge
   ;; Staircase: four ascending steps (south high-y -> north low-y).
   (rect-heights 8 8 13 8 (* 1.0 showcase-step-rise))             ; z 0.3
   (rect-heights 8 7 13 7 (* 2.0 showcase-step-rise))             ; z 0.6
   (rect-heights 8 6 13 6 (* 3.0 showcase-step-rise))             ; z 0.9
   (rect-heights 8 5 13 5 (* 4.0 showcase-step-rise))             ; z 1.2
   ;; Platform plateau at the top-stair height (a raised vantage).
   (rect-heights 8 2 13 4 (* 4.0 showcase-step-rise))             ; z 1.2
   ;; Sunken pit (negative floor) the player drops into and climbs out of.
   (rect-heights 4 12 7 13 showcase-pit-depth)))                  ; z -0.4

(def showcase-ceil-heights
  "Per-cell ceiling `z` for the L2 showcase (#237): a low lintel (z 0.7,
   below the default 1.0) hanging over the landing row at the foot of the
   staircase (row 9, cols 8-13), so the climb opens out of a low passage
   onto the platform. Only ceilings BELOW 1.0 render (a hanging ceiling);
   a higher value would be invisible, so the accent is a drop, not a lift."
  (rect-heights 8 9 13 9 0.7))

(def showcase-layout
  "Flat 24x18 chamber for the L2 verticality showcase (#237). The walls +
   spawn live here; the staircase / platform / pit are NOT layout chars -
   they are stamped separately from `showcase-floor-heights` so each
   raised cell lands on a known floor cell. Spawn `@` is south-of-centre
   (cell 11, row 15 -> centre 11.5, 15.5), looking out across the room
   toward the staircase to the north. `showcase-floor-heights` /
   `showcase-ceil-heights` index these same cells."
  ["########################"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#......................#"
   "#..........@...........#"
   "#......................#"
   "########################"])

;; ---------------------------------------------------------------------
;; Campaign verticality beyond the L2 showcase. Each of L3 / L5 / L7
;; gets a DISTINCT walkable feature, authored the same way the showcase
;; is: a flat `:layout` room plus a separate `{[x y] z}` height map, so
;; every raised / lowered cell is guaranteed to land on a known floor
;; cell (a procgen room could drop a step onto a wall). Every rise the
;; player climbs is <= `physics/step-up-max` (0.4); pits are one step-up
;; deep per tier so the player falls in under gravity and walks back out.
;; The exit door + any keycard reachability is never gated by geometry
;; (the surrounding ground stays flat and walkable around every feature).
;; ---------------------------------------------------------------------

(def trench-step-drop
  "Per-tier floor DROP (negative world z) on the L3 descending trench.
   Each tier is one `physics/step-up-max` deep, so the player descends a
   tier at a time and the climb back UP each tier is exactly the 0.4
   auto-climb ceiling - a stepped pit, walkable both ways."
  -0.4)

(def l3-layout
  "Flat 28x24 chamber for the L3 descending-trench feature. A sunken
   corridor runs east-west across the room's middle: the floor steps DOWN
   one tier on its rim (rows 9 + 13), then a deeper tier at the bottom
   (rows 10-12), so the player walks DOWN into the trench and climbs back
   out the far side. Spawn `@` is south-of-centre (cell 13, row 20 ->
   centre 13.5, 20.5). The exit `D` is on the east wall at the flat spawn
   row (row 20, col 27), reachable by skirting the trench along the flat
   flanking ground. The flanking columns (cols 1-4 + 23-26) stay flat
   ground so the player can always skirt the trench to reach the exit;
   `l3-floor-heights` indexes these same cells."
  ["############################"
   "#..........................#"
   "#..........................#"
   "#..........................#"
   "#..........................#"
   "#..........................#"
   "#..........................#"
   "#..........................#"
   "#..........................#"
   "#..........................#"
   "#..........................#"
   "#..........................#"
   "#..........................#"
   "#..........................#"
   "#..........................#"
   "#..........................#"
   "#..........................#"
   "#..........................#"
   "#..........................#"
   "#..........................#"
   "#............@.............D"
   "#..........................#"
   "#..........................#"
   "############################"])

(def l3-floor-heights
  "Per-cell floor `z` for the L3 descending trench. The trench spans cols
   5-22; its rim rows (9 + 13) sit one `trench-step-drop` down (-0.4) and
   the three bottom rows (10-12) one tier deeper (-0.8). Walking south into
   it: ground 0 -> rim -0.4 -> bottom -0.8, each a 0.4 step (auto-falls);
   climbing back out reverses it, each 0.4 rise <= step-up-max so it is
   walkable both directions. The flat flanking ground (cols 1-4, 23-26)
   carries no entry, so it reads as the classic 0.0 floor a player can
   skirt the trench on."
  (merge
   ;; Upper + lower rim: one tier down.
   (rect-heights 5 9 22 9 (* 1.0 trench-step-drop))     ; z -0.4
   (rect-heights 5 13 22 13 (* 1.0 trench-step-drop))   ; z -0.4
   ;; Trench bottom: a second tier deeper.
   (rect-heights 5 10 22 12 (* 2.0 trench-step-drop)))) ; z -0.8

(def dais-step-rise
  "Per-step floor rise on the L5 central dais ramp, in world z. At or
   below `physics/step-up-max` (0.4) so each step auto-climbs."
  0.4)

(def l5-layout
  "Flat 30x26 chamber for the L5 raised-dais feature. A raised square
   platform sits dead-centre (a vantage in the cyberdemon arena) reached
   by a short two-step ramp on its south face; the rest of the floor is
   flat ground that rings the dais, so the red-locked exit is always
   reachable around it. Spawn `@` is south (cell 14, row 22 -> centre
   14.5, 22.5), facing the dais. The red-locked exit `R` is on the east
   wall at the flat spawn row (row 22, col 29), reachable along the ground
   ring without ever climbing the dais. `l5-floor-heights` indexes these
   cells."
  ["##############################"
   "#............................#"
   "#............................#"
   "#............................#"
   "#............................#"
   "#............................#"
   "#............................#"
   "#............................#"
   "#............................#"
   "#............................#"
   "#............................#"
   "#............................#"
   "#............................#"
   "#............................#"
   "#............................#"
   "#............................#"
   "#............................#"
   "#............................#"
   "#............................#"
   "#............................#"
   "#............................#"
   "#............................#"
   "#.............@..............R"
   "#............................#"
   "#............................#"
   "##############################"])

(def l5-floor-heights
  "Per-cell floor `z` for the L5 central dais: a 6x4 raised plateau (cols
   12-17, rows 8-11) standing two `dais-step-rise` (0.8) above the ground,
   reached by a two-step ramp on its south face (row 13 at z 0.4, row 12
   at z 0.8) directly in front of the spawn. Ground 0 -> ramp 0.4 ->
   ramp-top / plateau 0.8: each rise is one 0.4 step (<= step-up-max), and
   the plateau cap is continuous with the ramp top (no lip). The
   surrounding flat ground rings the dais so the exit + red keycard stay
   reachable without ever climbing it."
  (merge
   ;; Two-step ramp up the dais south face (cols 13-16).
   (rect-heights 13 13 16 13 (* 1.0 dais-step-rise))  ; z 0.4
   (rect-heights 13 12 16 12 (* 2.0 dais-step-rise))  ; z 0.8
   ;; Raised plateau (the dais top) at the ramp-top height.
   (rect-heights 12 8 17 11 (* 2.0 dais-step-rise))))  ; z 0.8

(def l7-step-rise
  "Per-step floor rise on the L7 stairs, in world z. Set to 3/8 = 0.375,
   just below `physics/step-up-max` (0.4) so every step auto-climbs with
   headroom. 0.375 is exactly representable in binary floating point, so a
   stacked run (0.375 -> 0.75 -> 1.125 -> 1.5) never accumulates rounding
   drift that could nudge an adjacent riser above 0.4 and silently block
   the climb (e.g. `0.4 * 3` lands at 1.2000000000000002, whose 0.4 gap to
   1.6 trips the strict `> step-up-max` gate). Keeping every authored z a
   k/8 multiple guarantees the whole staircase stays walkable."
  0.375)

(def l7-tier1-z
  "Floor z of the L7 middle tier: two `l7-step-rise` steps above tier 0."
  (* 2.0 l7-step-rise)) ; 0.75

(def l7-tier2-z
  "Floor z of the L7 top tier: two `l7-step-rise` steps above tier 1."
  (* 4.0 l7-step-rise)) ; 1.5

(def l7-layout
  "Spacious 42x26 three-tier chamber for the L7 stair room (#298). One
   open arena split into three stacked floor tiers by two solid divider
   walls (rows 6 and 16). Each divider is pierced by two stair mouths, so
   four open-sided staircases connect the tiers:

     tier 0 (bottom, rows 17-24)  -- z 0.0,  the spawn floor
     tier 1 (middle, rows  7-15)  -- z 0.75, reached up stairs A / B
     tier 2 (top,    rows  1- 5)  -- z 1.5,  reached up stairs C / D

   The dividers (rows 6 and 16) are solid wall except the named mouths, so
   a tier is reachable ONLY by walking up a stair run (no flat shortcut):

     row 16 mouths: cols 6-12 (stair A) and 23-29 (stair B)  tier0 -> tier1
     row  6 mouths: cols 4-10 (stair C) and 27-33 (stair D)  tier1 -> tier2

   Each stair core is three cells wide with OPEN flanks (no side walls), so
   the player/enemies can fall off the side of a run (#299), reinforcing
   the spacious open-architecture feel. Spawn `@` is on the bottom tier
   (col 19, row 22 -> centre 19.5, 22.5); the yellow-locked exit `Y` sits
   on the east wall at the spawn row (row 22, col 41), reachable across the
   open bottom tier with no climb. `l7-floor-heights` indexes the tier +
   stair cells."
  ["##########################################"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "####.......################.......########"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "######.......##########.......############"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "#..................@.....................Y"
   "#........................................#"
   "#........................................#"
   "##########################################"])

(def l7-floor-heights
  "Per-cell floor `z` for the L7 three-tier stair room (#298). Three flat
   plateaus stacked by two `l7-step-rise` (0.375) steps each, plus four
   three-cell-wide stair cores with OPEN flanks (the flank cells drop back
   to the tier below, so a run is a real open-sided staircase you can fall
   off):

     tier 0 -- z 0.0  (default, no entries): the bottom spawn floor.
     tier 1 -- z 0.75 (rows 7-15): the middle plateau.
     tier 2 -- z 1.5  (rows 1-5):  the top plateau.

   Lower stairs A (cols 8-10) / B (cols 25-27) climb tier0 -> tier1 through
   the row-16 mouths: 0.0 -> 0.375 -> 0.75 northward (rows 16 -> 14). Upper
   stairs C (cols 6-8) / D (cols 29-31) climb tier1 -> tier2 through the
   row-6 mouths: 0.75 -> 1.125 -> 1.5 northward (rows 6 -> 4). Every
   successive rise is one 0.375 step (< step-up-max) so each run auto-climbs,
   and the top of each run is continuous with the tier it lands on. The flank
   cells beside each core stay at the lower tier's height, leaving the stair
   sides open (a fall-off edge, not a wall)."
  (merge
   ;; Tier plateaus: tier 1 (middle) then tier 2 (top). Tier 0 is the z 0.0
   ;; default (no entries). Later stair entries override the plateau cells.
   (rect-heights 1 7 40 15 l7-tier1-z)
   (rect-heights 1 1 40 5 l7-tier2-z)
   ;; Lower stairs A (cols 8-10) / B (cols 25-27): tier0 -> tier1, rows 16 -> 14.
   (rect-heights 8 16 10 16 0.0) (rect-heights 8 15 10 15 l7-step-rise) (rect-heights 8 14 10 14 l7-tier1-z)
   (rect-heights 25 16 27 16 0.0) (rect-heights 25 15 27 15 l7-step-rise) (rect-heights 25 14 27 14 l7-tier1-z)
   ;; Open flanks beside the lower stair cores: drop back to tier 0 (z 0.0)
   ;; so the run sides are fall-off edges, not walls.
   (rect-heights 6 14 7 16 0.0) (rect-heights 11 14 12 16 0.0)
   (rect-heights 23 14 24 16 0.0) (rect-heights 28 14 29 16 0.0)
   ;; Upper stairs C (cols 6-8) / D (cols 29-31): tier1 -> tier2, rows 6 -> 4.
   (rect-heights 6 6 8 6 l7-tier1-z) (rect-heights 6 5 8 5 (* 3.0 l7-step-rise)) (rect-heights 6 4 8 4 l7-tier2-z)
   (rect-heights 29 6 31 6 l7-tier1-z) (rect-heights 29 5 31 5 (* 3.0 l7-step-rise)) (rect-heights 29 4 31 4 l7-tier2-z)
   ;; Open flanks beside the upper stair cores: drop back to tier 1 (z 0.75).
   (rect-heights 4 4 5 6 l7-tier1-z) (rect-heights 9 4 10 6 l7-tier1-z)
   (rect-heights 27 4 28 6 l7-tier1-z) (rect-heights 32 4 33 6 l7-tier1-z)))

(def l7-handrails
  "Handrails on the L7 top-tier (z 1.5) plateau lip (#299). A handrail is a
   directed `[hx hy lx ly]` edge (high cell -> low cell) that blocks an
   entity from stepping OFF that downward edge (physics/try-move +
   enemy/try-step treat it like a wall - a fence you see over but can't
   cross). Only the WEST upper-staircase (stair C) plateau lips are railed,
   so the player/enemy cannot tumble off the plateau onto the west stair
   flanks; the EAST staircase (stair D) flank lips are left OPEN, so a step
   off the east plateau lip is a real 1-tier fall (1 life). The stair
   TREADS themselves are never railed, so all four staircases stay fully
   walkable up and down - the reachability invariant (exit + yellow key on
   the open bottom tier) is untouched. Every edge here is a z 1.5 -> 0.75
   drop (one tier, > step-up-max), enumerated from `l7-floor-heights`."
  ;; West stair-C plateau lips: the z1.5 plateau cells whose step down lands
  ;; on the open z0.75 stair-C flank (cols 4-5 and 9-10).
  #{[4 3 4 4] [5 3 5 4] [9 3 9 4] [10 3 10 4]
    [3 4 4 4] [6 4 5 4] [8 4 9 4] [11 4 10 4]
    [3 5 4 5] [11 5 10 5]})

;; ---------------------------------------------------------------------
;; L6 three-tier stair room (#310). The spectre level gets the same
;; multi-tier-ROOM treatment as L7, but rotated onto the EAST->WEST axis
;; so the campaign reads as a varied multi-level space, not a repeated
;; showcase: where L7 stacks three tiers NORTH (climb up the rows through
;; horizontal divider rows), L6 stacks them WEST (climb left through two
;; vertical divider COLUMNS). The bottom spawn tier is the EAST third, and
;; four open-sided runs climb west up to the middle then top tiers. Reuses
;; the canonical 0.375 ladder (`l7-step-rise` / `l7-tier1-z` / `l7-tier2-z`)
;; so the binary-exact tier z's (0.0 / 0.75 / 1.5) are a single source of
;; truth - every run stays auto-climbable with no float drift.
;; ---------------------------------------------------------------------

(def l6-layout
  "Spacious 42x26 three-tier chamber for the L6 spectre room (#310). One
   open arena split into three stacked floor tiers by two solid divider
   COLUMNS (cols 28 and 13). Each divider is pierced by two stair mouths,
   so four open-sided staircases connect the tiers along the east->west
   axis:

     tier 0 (east,   cols 29-40)  -- z 0.0,  the spawn floor
     tier 1 (middle, cols 14-27)  -- z 0.75, reached up stairs A / B
     tier 2 (west,   cols  1-12)  -- z 1.5,  reached up stairs C / D

   The dividers (cols 28 and 13) are solid wall except the named mouths, so
   a tier is reachable ONLY by walking up a stair run (no flat shortcut):

     col 28 mouths: rows 5-9 (stair A) and 16-20 (stair B)  tier0 -> tier1
     col 13 mouths: rows 5-9 (stair C) and 16-20 (stair D)  tier1 -> tier2

   Each stair core is three cells tall with OPEN flanks (no side walls), so
   the player/enemies can fall off the side of a run (#314). Spawn `@` is on
   the bottom (east) tier (col 35, row 12 -> centre 35.5, 12.5); the
   unlocked exit `D` sits on the east wall at the spawn row (row 12, col 41),
   reachable across the open bottom tier with no climb (L6 has no keycard).
   `l6-floor-heights` indexes the tier + stair cells."
  ["##########################################"
   "#............#..............#............#"
   "#............#..............#............#"
   "#............#..............#............#"
   "#............#..............#............#"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "#............#..............#............#"
   "#............#..............#............#"
   "#............#..............#......@.....D"
   "#............#..............#............#"
   "#............#..............#............#"
   "#............#..............#............#"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "#........................................#"
   "#............#..............#............#"
   "#............#..............#............#"
   "#............#..............#............#"
   "#............#..............#............#"
   "##########################################"])

(def l6-floor-heights
  "Per-cell floor `z` for the L6 three-tier stair room (#310). Three flat
   plateaus stacked west by two `l7-step-rise` (0.375) steps each, plus four
   three-cell-tall stair cores with OPEN flanks (the flank cells drop back to
   the tier below, so a run is a real open-sided staircase you can fall off):

     tier 0 -- z 0.0  (default, no entries): the bottom (east) spawn floor.
     tier 1 -- z 0.75 (cols 14-27): the middle plateau.
     tier 2 -- z 1.5  (cols 1-12):  the top (west) plateau.

   Lower stairs A (rows 6-8) / B (rows 17-19) climb tier0 -> tier1 through the
   col-28 mouths: 0.0 -> 0.375 -> 0.75 westward (cols 29 -> 27). Upper stairs
   C (rows 6-8) / D (rows 17-19) climb tier1 -> tier2 through the col-13
   mouths: 0.75 -> 1.125 -> 1.5 westward (cols 14 -> 12). Every successive
   rise is one 0.375 step (< step-up-max) so each run auto-climbs, and the top
   of each run is continuous with the tier it lands on. The flank cells beside
   each core stay at the lower tier's height, leaving the stair sides open (a
   fall-off edge, not a wall)."
  (merge
   ;; Tier plateaus: tier 1 (middle) then tier 2 (top/west). Tier 0 is the
   ;; z 0.0 default (no entries). Later stair entries override plateau cells.
   (rect-heights 14 1 27 24 l7-tier1-z)
   (rect-heights 1 1 12 24 l7-tier2-z)
   ;; Lower stairs A (rows 6-8) / B (rows 17-19): tier0 -> tier1, cols 29 -> 27.
   (rect-heights 29 6 29 8 0.0) (rect-heights 28 6 28 8 l7-step-rise) (rect-heights 27 6 27 8 l7-tier1-z)
   (rect-heights 29 17 29 19 0.0) (rect-heights 28 17 28 19 l7-step-rise) (rect-heights 27 17 27 19 l7-tier1-z)
   ;; Open flanks beside the lower stair cores (cols 27-29 at the mouth edge
   ;; rows): drop back to tier 0 (z 0.0) so the run sides are fall-off edges.
   (rect-heights 27 5 29 5 0.0) (rect-heights 27 9 29 9 0.0)
   (rect-heights 27 16 29 16 0.0) (rect-heights 27 20 29 20 0.0)
   ;; Upper stairs C (rows 6-8) / D (rows 17-19): tier1 -> tier2, cols 14 -> 12.
   (rect-heights 14 6 14 8 l7-tier1-z) (rect-heights 13 6 13 8 (* 3.0 l7-step-rise)) (rect-heights 12 6 12 8 l7-tier2-z)
   (rect-heights 14 17 14 19 l7-tier1-z) (rect-heights 13 17 13 19 (* 3.0 l7-step-rise)) (rect-heights 12 17 12 19 l7-tier2-z)
   ;; Open flanks beside the upper stair cores (cols 12-14 at the mouth edge
   ;; rows): drop back to tier 1 (z 0.75).
   (rect-heights 12 5 14 5 l7-tier1-z) (rect-heights 12 9 14 9 l7-tier1-z)
   (rect-heights 12 16 14 16 l7-tier1-z) (rect-heights 12 20 14 20 l7-tier1-z)))

(def levels
  "Per-level configuration. Each entry is intentionally tiny — visuals
   live in `enemies.phel` so a new level needs only disposition data
   (size / walls / enemy type / count / chase speed). Required fields
   per entry:

     :size       [w h] room dimensions in grid cells
     :walls      random wall-blob count for procgen rooms
     :enemy      catalog kw (see enemies/enemy-types) — single type
     :enemies    int (count of :enemy) OR vector of mixed specs
                 `[{:type :imp :count 4 :lives 1} {:type :baron …}]`
     :chase      enemy speed (units/sec)
     :name       short label used in the intro splash + HUD chip

   Optional:

     :enemy-lives  override the catalog's :default-lives (single-type only)
     :door-lock    :blue | :red | :yellow — adds a keycard + locked exit
     :layout       vector of ASCII strings (see map/parse-layout) —
                   bypasses random-grid for hand-authored arenas

   Adding a new room = append one map literal here."
  ;; Chase speed climbs monotonically L1-L9 (no level slower than the
  ;; one before, so difficulty never visibly regresses) and peaks at the
  ;; L9 brood; L10 eases to 1.6 because it is a single-boss dodging arena,
  ;; not a swarm. Pre-overhaul the curve dipped 2.0 -> 1.7 at L5 -> L6.
  ;; Each level's headline `:enemy` stays the plurality, but L2+ salt in
  ;; a melee secondary (and L3 a body/shooter split) so no room is a
  ;; single-type monotony. L1 is left pure: the clean melee tutorial
  ;; where you learn move + shoot against the simplest foe before any
  ;; mixing starts.
  [{:size [22 16] :walls 12 :enemy :imp   :enemies 4 :chase 0.8 :name "imps"}
   ;; L2 — the verticality showcase (issue #237). Hand-authored so the
   ;; floor heights land on known cells: a flat south entrance, a
   ;; four-step staircase climbing north onto a raised platform plateau
   ;; (a vantage over the room), and a sunken pit in the south-west the
   ;; player drops into and walks back out of. A low lintel hangs over
   ;; the stair foot. Demons + an imp escort patrol the floor; one
   ;; standing on the platform rises to stand on it (#234 enemy
   ;; floor-anchor). Keeps the L2 identity (name, demon+imp mix, chase
   ;; 1.0, shotgun drop) so progression + balance are unchanged - only
   ;; the geometry is now authored verticality instead of procgen.
   {:enemy :demon :chase 1.0 :name "demons"
    :enemies [{:type :demon :count 5}
              {:type :imp   :count 2}]
    :layout        showcase-layout
    :floor-heights showcase-floor-heights
    :ceil-heights  showcase-ceil-heights}
   ;; L3 introduces the cacodemon shooter; a 50/50 melee mix (demon +
   ;; imp callback) pressures the player up close while they learn to
   ;; strafe the bolts. Hand-authored verticality (a descending trench
   ;; corridor): the floor steps DOWN two tiers across the room's middle,
   ;; so the player walks into a sunken corridor and climbs back out. Keeps
   ;; the L3 identity (name, caco+demon+imp mix, chase 1.2, chaingun drop);
   ;; only the geometry is now authored instead of procgen.
   {:enemy :caco :chase 1.2 :name "cacodemons"
    :enemies [{:type :caco  :count 4}
              {:type :demon :count 2}
              {:type :imp   :count 2}]
    :layout        l3-layout
    :floor-heights l3-floor-heights}
   {:size [44 28] :walls 55 :enemy :baron :chase 1.4 :name "barons" :door-lock :blue
    :enemies [{:type :baron :count 3}
              {:type :demon :count 3}]}
   ;; L5 — the cyberdemon arena. Hand-authored verticality (a raised
   ;; central dais): a square plateau stands at the room centre, reached by
   ;; a two-step ramp on its south face - a vantage in the open arena. The
   ;; red-locked exit + keycard stay reachable on the flat ground ringing
   ;; the dais. Keeps the L5 identity (name, cyber+imp mix, chase 1.6, red
   ;; lock, rocket drop); only the geometry is now authored.
   {:enemy :cyber :chase 1.6 :name "cyberdemons" :door-lock :red
    :enemies [{:type :cyber :count 5}
              {:type :imp   :count 2}]
    :layout        l5-layout
    :floor-heights l5-floor-heights}

   ;; --- L6-L10 ----------------------------------------------------
   ;; Progressive mixed-monster rooms; L10 hand-authored boss arena.
   ;; Each level's `:enemy` is the primary type (drives the intro
   ;; splash name + the render fallback); `:enemies` is a vector of
   ;; specs so render reads visuals per-sprite.

   ;; L6 — spectres debut. Mostly spectres (HP 3, agile), a couple of
   ;; imps mixed in to keep the early-game vocabulary, plus one caco so
   ;; ranged pressure doesn't vanish for the whole L5-L7 stretch.
   ;; Hand-authored verticality (#310): a spacious three-tier chamber, the
   ;; east->west counterpart of L7's north-stacked room - two solid divider
   ;; COLUMNS each pierced by two open-sided staircases, so the player climbs
   ;; four runs west across three stacked plateaus. The unlocked exit stays
   ;; on the open bottom (east) tier, reachable with no climb. Keeps the L6
   ;; identity (name, spectre+imp+caco mix, chase 1.7, no lock); only the
   ;; geometry is authored. No :ceil-heights: the room is open (flat 1.0).
   {:enemy   :spectre
    :chase   1.7
    :name    "spectres"
    :enemies [{:type :spectre :count 4}
              {:type :imp     :count 2}
              {:type :caco    :count 1}]
    :layout        l6-layout
    :floor-heights l6-floor-heights}

   ;; L7 — revenants (HP 4) leading a small demon escort, with a lone
   ;; baron lobbing fireballs to keep a ranged threat in the room.
   ;; Hand-authored verticality (#298): a spacious three-tier chamber split
   ;; by two divider walls, each pierced by two open-sided staircases, so
   ;; the player climbs four stair runs up and down between three stacked
   ;; plateaus. The yellow-locked exit stays reachable on the open bottom
   ;; tier without any climb. Keeps the L7 identity (name, revenant+demon+
   ;; baron mix, chase 1.8, yellow lock, BFG drop); only the geometry is
   ;; authored. No :ceil-heights: the room is open (flat 1.0 ceiling).
   {:enemy   :revenant
    :chase   1.8
    :name    "revenants"
    :door-lock :yellow
    :enemies [{:type :revenant :count 4}
              {:type :demon    :count 2}
              {:type :baron    :count 1}]
    :layout        l7-layout
    :floor-heights l7-floor-heights
    :handrails     l7-handrails}

   ;; L8 — archvile court: two casters backed by mixed mid-tier mass.
   {:size    [50 30]
    :walls   72
    :enemy   :archvile
    :chase   1.9
    :name    "archvile court"
    :enemies [{:type :archvile :count 2}
              {:type :caco     :count 3}
              {:type :mancubus :count 2}]}

   ;; L9 — the brood: pinkies (HP 2, very fast) flanking barons +
   ;; mancubi. Chaos pace — the player should feel surrounded.
   {:size    [54 32]
    :walls   78
    :enemy   :pinky
    :chase   2.0
    :name    "the brood"
    :enemies [{:type :pinky    :count 3}
              {:type :baron    :count 3}
              {:type :mancubus :count 2}]}

   ;; L10 — the final. Hand-authored arena: open chamber with a
   ;; central pillar for cover, player spawns south, BOSS-locked
   ;; door north. ONE cyberdemon boss with 50 HP (needs ~17 shotgun
   ;; shells or ~50 chaingun rounds — a real fight). Two imps
   ;; harass at MOST 1 alive at a time (`:max-concurrent 1` blocks
   ;; the respawn from doubling up). The 'X' in the layout is a
   ;; boss-locked door: impassable until combat conj's `:boss` onto
   ;; :held-keys when the cyberdemon dies. Walk through after the
   ;; kill to win the run.
   {:enemy     :cyber
    :chase     1.6
    :name      "the final"
    :door-lock :boss
    :enemies   [{:type :cyber :count 1 :lives 50}
                {:type :imp   :count 2 :lives 1 :max-concurrent 1}]
    ;; 'S' cells are secret walls: identical to normal walls until
    ;; the player walks up and presses F. Two are tucked into the
    ;; central pillar's inner walls so a careful explorer can break
    ;; into the cover for a tactical advantage; the boss arena's
    ;; openness otherwise leaves nowhere to hide. 'T' cells are
    ;; switches (issue #62) - pressing F adjacent to one toggles the
    ;; linked cells listed under `:switches` below.
    :layout    ["####################"
                "#.........X........#"
                "#..................#"
                "#..................#"
                "#..................#"
                "#..................#"
                "#..................#"
                "#..................#"
                "#......##..##......#"
                "#......S....S......#"
                "#......#....#......#"
                "#......##..##......#"
                "#..................#"
                "#..................#"
                "#..T............T..#"
                "#..................#"
                "#..................#"
                "#.........@........#"
                "####################"]
    ;; Both switches open the inner pillar walls so the player can
    ;; cut through the cover instead of going around. The pillar's
    ;; row 10 carries `#....#` at cols 7 + 12; switches flip those
    ;; to floor (and back on a second F-press) so the boss-arena
    ;; cover is reconfigurable mid-fight.
    :switches  [{:at [3 14]  :targets [[7 10]]}
                {:at [16 14] :targets [[12 10]]}]}])

(def num-levels
  "Total levels in the catalog; clamped on every lookup."
  (count levels))

(defn config-for
  "Return the config for level N (1-indexed). Out-of-range numbers
   clamp to the boundary so callers don't have to guard."
  [n]
  (get levels (php/max 0 (php/min (php/- num-levels 1) (php/- n 1)))))

(defn- spawn-unique-pickups
  "Seed `n` {:x :y} pickups at random open cells, retrying when
   `random-spawn` collides with one already placed (otherwise stepping
   on the shared cell silently consumes multiple pickups for a single
   reward). Bails after `(* n 6)` attempts so a tight map can't
   infinite-loop; the caller just gets the ones that fit."
  [grid n]
  (loop [acc [] attempts 0]
    (cond
      (php/>= (count acc) n)       acc
      (php/> attempts (php/* n 6)) acc
      :else
      (let [[sx sy] (random-spawn grid)
            dup?    (some (fn [p] (and (php/=== (:x p) sx) (php/=== (:y p) sy))) acc)]
        (if dup?
          (recur acc (php/+ attempts 1))
          (recur (conj acc {:x sx :y sy}) (php/+ attempts 1)))))))

(defn- maybe-spawn-heart
  "Return a vector with `n` heart pickups at random open cells, or []
   when the player is already at max-lives (no point spawning hearts
   they can't pick up). `n` > 1 only on harder difficulties (issue
   #156, see heart-count)."
  [grid lives n]
  (if (php/>= lives max-lives)
    []
    (spawn-unique-pickups grid n)))

(defn- maybe-spawn-armor
  "Roughly one in two levels carries an armor pickup. Picked up via
   `pickup-armors` in play.phel; absorbs the next contact-damage hit."
  [grid]
  (if (zero? (rng/int! 2))
    (let [[ax ay] (random-spawn grid)]
      [{:x ax :y ay}])
    []))

(defn- maybe-spawn-berserk
  "Rare berserk sphere — ~1 in 8 levels (was 1 in 4, tuned down
   after v0.3 playtesting found powerups stacking too often)."
  [grid]
  (if (php/=== 0 (rng/int! 8))
    (let [[bx by] (random-spawn grid)]
      [{:x bx :y by}])
    []))

(defn- maybe-spawn-invuln
  "Very rare — ~1 in 12 levels."
  [grid]
  (if (php/=== 0 (rng/int! 12))
    (let [[ix iy] (random-spawn grid)]
      [{:x ix :y iy}])
    []))

(defn- maybe-spawn-soulsphere
  "Rare soulsphere (issue #68): ~1 in 10 levels. Bumps `:lives` over
   the normal cap by `soul-overcap`; the over-cap portion decays
   back to `max-lives` over time, so the player gets a real defensive
   buffer for a stretch of fight."
  [grid]
  (if (php/=== 0 (rng/int! 10))
    (let [[sx sy] (random-spawn grid)]
      [{:x sx :y sy}])
    []))

(defn- spawn-armor-shards
  "Common armor shards (issue #68): seed `n` of them at random open
   cells. Each adds +1 armor over the normal `max-armor` cap up to
   `armor-shard-cap` (10). Skip duplicates so two shards can't share
   a cell (silently merging into one pickup)."
  [grid n]
  (spawn-unique-pickups grid n))

(def armor-shards-per-level
  "Tunable: how many shards seed per level. Three keeps the level
   floor visibly seeded with the common pickup without overwhelming
   the heart / armor / ammo balance."
  3)

(def secrets-per-level
  "Procgen levels seed up to this many secret passages (map/seed-secrets).
   Two gives the explorer a reason to bump suspicious walls without
   carving the map into swiss cheese. Hand-authored layouts (L10) keep
   their own secrets and are NOT auto-seeded."
  2)

(def secret-trophies
  "Trophy powerup dropped behind a revealed secret, picked by reveal
   order so each secret hands out a different rare prize before
   cycling. These are exactly the powerups that are otherwise low-odds
   random spawns — secrets become the reliable way to earn them."
  [:soulspheres :berserks :invulns])

(defn place-secret-reward
  "Drop a reward stash at a just-revealed secret cell `(cx, cy)`: an
   ammo box + an armor shard (always) plus one rotating trophy powerup
   (soulsphere / berserk / invuln, chosen by `idx` = the count of
   secrets already found). Pure — conj's onto the world's pickup
   vectors at the cell centre so the normal pickup-* passes collect
   them when the player steps in. `idx` 0-based."
  [world ^int cx ^int cy ^int idx]
  (let [x      (php/+ 0.5 cx)
        y      (php/+ 0.5 cy)
        trophy (get secret-trophies (mod idx (count secret-trophies)))
        at     {:x x :y y}]
    (-> world
        (update :ammo-boxes (fn [v] (conj (or v []) at)))
        (update :armor-shards (fn [v] (conj (or v []) at)))
        (update trophy (fn [v] (conj (or v []) at))))))

(defn- pack->level
  "Coerce a `pack` arg to a backpack stack level. Accepts the legacy
   boolean (true = level 1) or the new integer level for back-compat
   with old callers; anything else reads as 0."
  [pack]
  (cond
    (boolean? pack)   (if pack 1 0)
    (php/is_int pack) pack
    :else             0))

(defn- maybe-spawn-backpack
  "Stacking backpack (#68 part 3): L2+ only, ~1 in 5 qualifying
   levels. Skipped once the player is at `max-backpacks`. `pack`
   accepts the legacy boolean (true = level 1) or the new integer
   level for back-compat with old callers."
  [grid level-num pack]
  (let [lvl (pack->level pack)]
    (if (or (php/>= lvl max-backpacks)
            (php/< level-num 2)
            (php/!== 0 (rng/int! 5)))
      []
      (let [[bx by] (random-spawn grid)]
        [{:x bx :y by}]))))

(defn- specs-total-hp
  "Sum `count * lives` across a mixed-spec vector. Used to size the
   ammo box budget per level — the player needs roughly enough
   bullets to cover every monster's HP."
  [specs]
  (reduce (fn [total s]
            (php/+ total (php/* (or (:count s) 0) (or (:lives s) 1))))
          0
          specs))

(defn ammo-box-count
  "Per-level ammo-box budget. Scales with the expected shot count
   (sum of `count * lives` across enemies) so bigger maps with
   tougher monsters get more refill points, then multiplies by the
   difficulty `:ammo-mul` (issue #155) so faster enemies — and the
   misses they force on spray weapons — don't starve the player.
   Floor of 2 so every level has at least one fallback. Divisor 8
   tuned to give roughly 1.3 mags of ammo per expected kill."
  [cfg]
  (let [enemies (:enemies cfg)
        hp      (cond
                  (vector? enemies) (specs-total-hp enemies)
                  :else             (php/* (or enemies 0)
                                           (or (:enemy-lives cfg) 1)))
        mul     (or (:ammo-mul cfg) 1.0)]
    (php/max 2 (php/intval (php/ceil (php/* mul (php// hp 8)))))))

(def hearts-per-level
  "Tunable: baseline hearts seeded per level before difficulty
   scaling (see heart-count)."
  1)

(defn heart-count
  "Hearts seeded per level: `hearts-per-level` baseline, scaled by
   the difficulty :pickup-mul (issue #156) and rounded — hard's x1.2
   keeps a single heart, nightmare's x1.5 bumps to two — so heal
   supply tracks the denser roster without trivialising mid
   difficulties. Floor of 1."
  [cfg]
  (php/max 1 (php/intval (php/round (php/* hearts-per-level
                                           (or (:pickup-mul cfg) 1.0))))))

(defn armor-shard-count
  "Armor shards seeded per level: `armor-shards-per-level` baseline,
   scaled by the difficulty :pickup-mul (issue #156) and ceil'd —
   hard gets 4, nightmare 5."
  [cfg]
  (php/intval (php/ceil (php/* armor-shards-per-level
                               (or (:pickup-mul cfg) 1.0)))))

(defn- lock-cell-for
  "Map a lock-colour kw to the matching locked-door cell value."
  [colour]
  (cond
    (php/=== colour :blue)   cell-door-blue
    (php/=== colour :red)    cell-door-red
    (php/=== colour :yellow) cell-door-yellow
    :else                    cell-door))

(defn- lock-the-door
  "Replace the FIRST cell-door in `grid` with the locked variant for
   `colour`. seed-doors only places one door per level so this is a
   single-row scan; returns the original grid unchanged when colour
   is nil (unlocked level) or no door was found (defensive)."
  [grid colour]
  (if (php/=== colour nil)
    grid
    (let [target (lock-cell-for colour)
          h      (count grid)]
      (loop [y 0]
        (cond
          (php/>= y h) grid
          :else
          (let [row    (get grid y)
                w      (count row)
                door-x (loop [x 0]
                         (cond
                           (php/>= x w)                    -1
                           (php/=== cell-door (get row x)) x
                           :else                           (recur (php/+ x 1))))]
            (if (php/>= door-x 0)
              (assoc-in grid [y door-x] target)
              (recur (php/+ y 1)))))))))

(defn- maybe-spawn-weapon-pickups
  "Per-level weapon drops. L2 always seeds a shotgun, L3 a chaingun,
   L4 the chainsaw, L5 the rocket launcher (issue #123), L6 the
   incinerator (issue #122), L7 the rare BFG (issue #58). Each skipped
   if the player already owns the weapon so a re-played level doesn't
   spam duplicate pickups. Returns a
   vector of `{:x :y :weapon kw}` items."
  [grid level-num owned]
  (let [owned'     (or owned #{:pistol})
        candidates
        (cond
          (php/=== level-num 2) (if (contains? owned' :shotgun)       [] [:shotgun])
          (php/=== level-num 3) (if (contains? owned' :chaingun)      [] [:chaingun])
          (php/=== level-num 4) (if (contains? owned' :chainsaw)      [] [:chainsaw])
          (php/=== level-num 5) (if (contains? owned' :rocket)        [] [:rocket])
          (php/=== level-num 6) (if (contains? owned' :incinerator)   [] [:incinerator])
          (php/=== level-num 7) (if (contains? owned' :bfg)           [] [:bfg])
          :else                 [])]
    (apply vector
           (map (fn [kw]
                  (let [[wx wy] (random-spawn grid)]
                    {:x wx :y wy :weapon kw}))
                candidates))))

(defn- maybe-spawn-keycard
  "Drop one keycard at a random open cell when the level is locked
   by a colour the player can pick up (`:blue` / `:red`). The
   `:boss` lock has no physical key — combat grants it on boss
   death — so no card spawns."
  [grid colour]
  (cond
    (php/=== colour nil)   []
    (php/=== colour :boss) []
    :else
    (let [[kx ky] (random-spawn grid)]
      [{:x kx :y ky :colour colour}])))

(defn- spawn-ammo-boxes
  "Seed `n` ammo boxes at random open cells, retrying when
   `random-spawn` collides with one already placed (otherwise
   stepping on the shared cell silently consumes multiple boxes
   for a single reward). Bails after a few extra tries so a tight
   map can't infinite-loop; the player just gets the boxes that
   did fit."
  [grid n]
  (spawn-unique-pickups grid n))

(defn- build-grid
  "Two paths: hand-authored `:layout` (parsed via map/parse-layout —
   bypasses random + seed-doors + lock-the-door, the author put doors
   + locks directly in the ASCII) OR random `random-grid + seed-doors
   + lock-the-door` for the procedural path. Returns `{:grid :spawn}`."
  [cfg]
  (if (:layout cfg)
    (or (parse-layout (:layout cfg))
        (throw (php/new php/InvalidArgumentException
                        (str "Level layout missing player spawn '@': "
                             (:name cfg)))))
    (let [[w h] (:size cfg)
          grid  (lock-the-door
                 (seed-doors (random-grid w h (:walls cfg)) 1)
                 (:door-lock cfg))]
      {:grid grid :spawn (random-spawn grid)})))

(defn- normalise-enemies
  "Coerce the level's `:enemies` field into a vector of mixed specs
   `[{:type :count :lives [:max-concurrent]}]`. Single-type entries
   (int + `:enemy` + optional `:enemy-lives`) become a 1-element
   vector. Already-mixed entries get `:type` defaulted from `:enemy`
   and `:lives` from the catalog when omitted; any extra spec keys
   (e.g. `:max-concurrent`) pass through verbatim."
  [cfg]
  (let [es (:enemies cfg)]
    (cond
      (vector? es)
      (apply vector
             (map (fn [spec]
                    (let [t (or (:type spec) (:enemy cfg) :imp)]
                      (merge spec
                             {:type  t
                              :count (or (:count spec) 0)
                              :lives (or (:lives spec) (default-lives-for t))})))
                  es))

      :else
      (let [t (or (:enemy cfg) :imp)]
        [{:type  t
          :count (or es 0)
          :lives (or (:enemy-lives cfg) (default-lives-for t))}]))))

(defn build-world
  {:doc "Construct a brand-new world for `level-num` carrying `lives` over
         from the previous level. Walls, enemies, doors, player spawn, and
         pickups are randomised by default; a level entry can opt into a
         hand-authored `:layout` for boss arenas. Enemies stamp `:type` so
         render reads per-enemy visuals from the catalog.

         `pack-level` (the 3rd positional) is the player's current backpack
         stack count (0..max-backpacks). Accepts a legacy boolean for
         back-compat: true coerces to 1, false to 0."
   :see-also ["new-world" "config-for" "build-grid"]
   :example "(build-world 1 max-lives) ; => world map for level 1"}
  ([level-num lives] (build-world level-num lives 0 :normal #{:pistol}))
  ([n l pack] (build-world n l pack :normal #{:pistol}))
  ([n l pack diff] (build-world n l pack diff #{:pistol}))
  ([lv life pack diff owned]
   (let [diff'       (normalise diff)
         raw         (config-for lv)
         ;; Resolve :enemy-lives from the catalog BEFORE scale-cfg —
         ;; otherwise scale-cfg's missing-field default of 1 masks
         ;; the catalog default and every monster spawns with 1 HP.
         primed      (if (or (vector? (:enemies raw)) (:enemy-lives raw))
                       raw
                       (assoc raw :enemy-lives
                              (default-lives-for (or (:enemy raw) :imp))))
         cfg         (scale-cfg primed diff')
         lock        (:door-lock cfg)
         built       (build-grid cfg)
         spawn       (:spawn built)
         ;; Seed hidden reward passages into procgen levels. Skipped on
         ;; hand-authored layouts (they pin their own secrets) and on
         ;; locked levels — a secret shortcut there could bypass the
         ;; keycard door and break the lock gating.
         grid        (if (and (not (:layout cfg)) (not lock))
                       (seed-secrets (:grid built) secrets-per-level)
                       (:grid built))
         [px py]     spawn
         specs       (normalise-enemies cfg)
         ;; Seed per-cell floor heights (#232) and ceiling heights (#235)
         ;; from the level config's optional `:floor-heights` /
         ;; `:ceil-heights` maps (`{[x y] height}`). Absent on every
         ;; current level -> all-zero flat floor + all-1.0 flat ceiling
         ;; -> render byte-identical to pre-#232/#235.
         world       (apply-ceil-heights
                      (apply-floor-heights
                       (new-world grid (new-player px py (php/* (rng/int! 360)
                                                                (php// php/M_PI 180.0))))
                       (:floor-heights cfg))
                      (:ceil-heights cfg))
         spawned     (spawn-enemies-mixed grid specs
                                          enemy-min-spawn-dist px py)
         ;; Nightmare: stamp every spawned enemy so respawn picks the
         ;; shorter delay range AND the :max-concurrent cap is bypassed
         ;; (see core/enemy.phel/tick-one). Other difficulties get no
         ;; stamp -> default respawn behaviour.
         tagged-foes (if (php/=== :nightmare diff')
                       (apply vector (map (fn [e] (assoc e :nightmare? true)) spawned))
                       spawned)
         ;; Depth-scaled aggression: every enemy carries a cooldown
         ;; multiplier derived from the level number, so the same type
         ;; attacks more often deeper in (enemy-ai/tick-attack reads it).
         aggr        (aggression-for lv)
         aggro-foes  (apply vector (map (fn [e] (assoc e :aggression aggr)) tagged-foes))
         ;; Half the freshly-spawned dormant enemies start pacing
         ;; instead of sleeping. Wanderers can stumble into the
         ;; player's LOS by accident — that's the "rooms feel alive"
         ;; cue. Tests opting out pass through 0.0 via fixtures that
         ;; never run through build-world (they construct enemies
         ;; directly).
         lively-foes (promote-wanderers aggro-foes default-wander-fraction)
         with-foes   (with-enemies world lively-foes)]
     (assoc with-foes
            :level         lv
            :lives         life
            :difficulty    diff'
            :backpack-level (pack->level pack)
            :owned-weapons (or owned #{:pistol})
            :hearts        (maybe-spawn-heart grid life (heart-count cfg))
            :armors        (maybe-spawn-armor grid)
            :berserks      (maybe-spawn-berserk grid)
            :invulns       (maybe-spawn-invuln grid)
            :soulspheres   (maybe-spawn-soulsphere grid)
            :armor-shards  (spawn-armor-shards grid (armor-shard-count cfg))
            :backpacks     (maybe-spawn-backpack grid lv pack)
            :keycards      (maybe-spawn-keycard grid lock)
            :weapon-pickups (maybe-spawn-weapon-pickups grid lv (or owned #{:pistol}))
            :door-lock     lock
            ;; Per-edge handrails (#299): the level config's optional
            ;; `:handrails` set of `[hx hy lx ly]` downward-edge keys,
            ;; threaded onto the world so physics/try-move + enemy/try-step
            ;; can block a step off a railed lip. Absent -> empty set, so a
            ;; level with no rails (every level but L7) behaves as before.
            :handrails     (or (:handrails cfg) #{})
            :secrets-total (count-secrets grid)
            :secrets-found 0
            ;; Switches: level config opts in via :switches; build-world
            ;; passes it through to the world so play.phel can resolve
            ;; F-press targets. Defaults to [] when the level has no
            ;; switches.
            :switches      (or (:switches cfg) [])
            :ammo-boxes    (spawn-ammo-boxes grid (ammo-box-count cfg))
            :chase-speed   (:chase cfg)
            ;; Primary type fallback for render — used when an enemy
            ;; doesn't carry its own :type (defensive only, every
            ;; enemy from spawn-enemies-mixed has one).
            :enemy         (or (:enemy cfg) (:type (first specs)))
            :level-name    (:name cfg)
            ;; Centred 1.5s intro splash. tick-world decays this; render
            ;; paints the overlay while > 0.
            :intro-secs    1.5))))
