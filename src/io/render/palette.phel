  "\e[48;5;184m ")
(def keycard-yellow-glyph
  "Yellow keycard ⚿ glyph on the dim yellow BG. FG is dark (16) rather
   than white so the icon keeps contrast against the bright yellow."
  "\e[48;5;100;38;5;16;1m⚿")
