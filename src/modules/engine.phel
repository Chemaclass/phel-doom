(ns phel-doom.modules.engine)

(def max-depth 12.0)
(def step 0.35)
(def proj-dist
  "Horizontal projection distance in screen cells. Wall heights are
   `proj-dist / (dist * char-aspect)`, so this controls how big walls
   look at a given world distance. The horizontal FOV emerges as
   `2 * atan(viewport-width / 2 / proj-dist)` — wider terminals show
   more of the world without changing wall scale."
  70.0)

(defn- pwall?
  "Wall test against a PHP-native nested array. OOB returns nil from
   aget, which is not == 1, so the ray simply runs to max-depth and stops."
  [pgrid x y]
  (let [row (php/aget pgrid y)]
    (if (php/=== row nil)
      false
      (php/=== 1 (php/aget row x)))))

(defn cast-ray
  "March a ray from (px, py) at the given angle until it hits a wall or
   `max-depth`. Uses incremental position update (no per-step multiply)
   and a PHP-native grid lookup."
  {:export true}
  [pgrid px py angle]
  (let [dx (php/* (php/cos angle) step)
        dy (php/* (php/sin angle) step)]
    (loop [dist 0.0 x px y py]
      (cond
        (php/>= dist max-depth)                      max-depth
        (pwall? pgrid (php/intval x) (php/intval y)) dist
        :else                                        (recur (php/+ dist step) (php/+ x dx) (php/+ y dy))))))

(defn cast-frame
  "Cast `width` rays and return a PHP array of fish-eye-corrected
   distances, one per column. Returning a flat PHP array (not a lazy
   seq of maps) keeps the column loop in the renderer doing a single
   aget per column instead of walking a Phel seq + keyword lookup."
  {:export true}
  [world width]
  (let [pgrid               (:pgrid world)
        {:keys [x y angle]} (:player world)
        center              (* 0.5 width)
        dists               (php/array)]
    (loop [col 0]
      (when (php/< col width)
        (let [offset (php/atan (/ (php/- col center) proj-dist))]
          (php/aset dists col
                    (php/* (cast-ray pgrid x y (php/+ angle offset))
                           (php/cos offset)))
          (recur (php/+ col 1)))))
    dists))
