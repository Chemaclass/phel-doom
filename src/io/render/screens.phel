;; Full-screen overlay screens: the start menu, the settings page and the
;; death / victory end screens. Each washes the whole terminal and paints a
;; centred bordered box, so they share render-end-screen's geometry and
;; never touch the per-frame scene pipeline in io/render/main.
(ns phel-doom.io.render.screens
  (:require phel-doom.io.render.buffer :refer [buf-mk buf-push])
  (:require phel-doom.io.render.hud :refer [settings-menu-string])
  (:require phel-doom.core.format :refer [format-duration])
  (:require phel-doom.core.version :refer [version]))

;; End-of-game screens (death / victory).
;;
;; Same box geometry as the settings page but full-screen washed in either
;; dark red (death) or dark green (victory). Both screens share
;; render-end-screen — the only thing each variant supplies is the
;; wash colour and the 32-wide row strings.
;; ---------------------------------------------------------------------

(def end-box-width-cap   "Upper bound on the end-screen box width."   36)

(def end-box-width-floor "Smallest readable box at very narrow vw."   22)

(def end-compact-rows    "rows below this drop separators + best-row block." 20)

(defn- end-pad
  "Right-pad `text` with spaces up to `width` visible columns."
  [text width]
  (str text (php/str_repeat " " (php/max 0 (php/- width (php/strlen text))))))

(defn- end-clip
  "Truncate `text` to at most `width` chars so a long level-name on a
   tiny terminal can't bleed past the right border."
  [text width]
  (let [n (php/strlen text)]
    (if (php/<= n width) text (php/substr text 0 width))))

(defn- end-row-text
  "Build one interior text row sized to `width`: clip first, then
   right-pad. Wrapping the SGR around it is the caller's job."
  [text width]
  (end-pad (end-clip text width) width))

(defn- end-centre
  "Centre a visible-text run inside `width` columns, wrapping the
   supplied SGR around the whole padded string."
  [text width sgr]
  (let [t (end-clip text width)
        n (php/strlen t)
        L (php/max 0 (php/intdiv (php/- width n) 2))
        R (php/max 0 (php/- width (php/+ n L)))]
    (str sgr (php/str_repeat " " L) t (php/str_repeat " " R) "\e[0m")))

(defn- end-box-width-for
  "Pick a box width that fits a 4-col total margin while staying within
   the readable floor / cap."
  [cols]
  (php/max end-box-width-floor
           (php/min end-box-width-cap (php/- cols 4))))

(defn- best-victory-cell [s]
  (if (php/<= s 0) "--" (format-duration s)))

(defn- weapon-kills-line
  "Compact `pistol 5  chaingun 12` breakdown from a `:kills-by-weapon`
   map, skipping weapons with no kills. Empty string when nothing landed
   (so the caller can drop the row). end-row-text clips it to the box
   width, so a long loadout never overflows."
  [kbw]
  (let [kept   (reduce-kv (fn [acc w n] (if (php/> n 0) (conj acc [w n]) acc))
                          []
                          (or kbw {}))
        ;; Most-used weapon first, so the width clip drops the least-used
        ;; rather than the headline weapon's count.
        sorted (sort-by (fn [p] (php/- 0 (get p 1))) kept)]
    (reduce (fn [acc p]
              (str acc (if (php/=== acc "") "" "  ") (name (get p 0)) " " (get p 1)))
            ""
            sorted)))

(defn- grade-sgr
  "Bold SGR colour for a run grade letter so the rank reads at a glance:
   gold S, green A, cyan B, white C, dim D."
  [grade]
  (cond
    (= grade "S") "\e[93;1m"
    (= grade "A") "\e[92;1m"
    (= grade "B") "\e[96;1m"
    (= grade "C") "\e[97;1m"
    :else         "\e[90;1m"))

(defn- best-rows
  "Tiny 3-line block summarising the persisted best scores."
  [scores width]
  [(str "\e[2;93m" (end-row-text (str "   best kills:   " (:best-kills scores)) width) "\e[0m")
   (str "\e[2;93m" (end-row-text (str "   best level:   " (:best-level scores)) width) "\e[0m")
   (str "\e[2;93m" (end-row-text (str "   best time:    "
                                      (best-victory-cell (:fastest-victory-s scores)))
                                 width) "\e[0m")])

(defn- end-rows
  "Compose the interior row list for either variant. `title` is the
   one-line centred banner SGR-painted by the caller; `did-what` is
   the past-tense phrase under the run stats (`died on` / `cleared`).
   Compact mode (when the terminal is too short) drops the leading
   blank-line padding, the best-scores block, and most separators —
   keeps the box tall enough to read even on a 12-row split."
  [title-sgr title did-what kills survived-s level level-name scores summary rows width]
  (let [bl       (end-row-text "" width)
        compact  (php/< rows end-compact-rows)
        stat     (fn [text] (str "\e[97m" (end-row-text (str "  " text) width) "\e[0m"))
        ;; Run-summary panel (issue #202): accuracy %, secrets (only when
        ;; the run had any), and the letter rank centred + colour-coded.
        wkl      (if summary (weapon-kills-line (:kills-by-weapon summary)) "")
        sum-rows (if summary
                   (vec (concat
                         [(stat (str "accuracy: " (:accuracy summary) "%"))]
                         (if (php/> (or (:secrets-total summary) 0) 0)
                           [(stat (str "secrets:  " (:secrets-found summary)
                                       "/" (:secrets-total summary)))]
                           [])
                         [(stat (str "damage:   " (or (:damage-taken summary) 0)))]
                         (if (php/=== wkl "")
                           []
                           [(stat (str "by: " wkl))])
                         [(end-centre (str "RANK  " (:grade summary)) width
                                      (grade-sgr (:grade summary)))]))
                   [])]
    (vec (concat
          (if compact []  [bl])
          [(end-centre title width title-sgr)]
          (if compact [:sep] [bl :sep bl])
          [(stat (str did-what " L" level " " level-name))
           (stat (str "kills:    " kills))
           (stat (str "time:     " (format-duration survived-s)))]
          sum-rows
          (if compact
            [:sep]
            (concat [bl :sep bl] (best-rows scores width) [bl :sep bl]))
          [(end-centre "r new  R same  q quit" width "\e[97;1m")]
          (if compact
            []
            [bl :sep bl
             (str "\e[2;97m" (end-row-text "  phel-doom by Chemaclass" width) "\e[0m")
             (str "\e[2;97m" (end-row-text "  written in Phel Lang"    width) "\e[0m")
             bl])))))

(defn- death-rows [kills survived-s level level-name scores summary rows width]
  (end-rows "\e[91;1m" "YOU DIED" "died on"  kills survived-s level level-name scores summary rows width))

(defn- victory-rows [kills survived-s level level-name scores summary rows width]
  (end-rows "\e[92;1m" "VICTORY!" "cleared" kills survived-s level level-name scores summary rows width))

(defn- render-end-screen
  "Generic end-of-game overlay: full-screen wash in `wash-bg` plus a
   centred ─┌┐│└┘ box whose contents are `items` (interior strings
   interleaved with :sep markers). Item count is clamped to the
   available rows so a tall box can't paint past the terminal bottom
   on very short terminals."
  [cols rows wash-bg items width]
  (let [parts (buf-mk)
        bar   (php/str_repeat "─" width)]
    (buf-push parts "\e[H")
    (loop [r 1]
      (when (php/<= r rows)
        (buf-push parts (str "\e[" r ";1H" wash-bg
                             (php/str_repeat " " cols)))
        (recur (php/+ r 1))))
    (let [;; Reserve 2 rows for the top + bottom border.
          max-n   (php/max 0 (php/- rows 2))
          n       (php/min max-n (count items))
          row-top (php/max 1 (php/- (php/intdiv rows 2) (php/intdiv n 2)))
          col0    (php/max 1 (php/- (php/+ (php/intdiv cols 2) 1)
                                    (php/intdiv (php/+ width 2) 2)))]
      (buf-push parts (str "\e[" row-top ";" col0
                           "H\e[40;97m┌" bar "┐\e[0m"))
      (buf-push parts (str "\e[" (php/+ row-top n 1) ";" col0
                           "H\e[40;97m└" bar "┘\e[0m"))
      (loop [i 0]
        (when (php/< i n)
          (let [item (get items i)
                row  (php/+ row-top 1 i)]
            (if (= item :sep)
              (buf-push parts (str "\e[" row ";" col0
                                   "H\e[40;97m├" bar "┤\e[0m"))
              (buf-push parts (str "\e[" row ";" col0
                                   "H\e[40;97m│" item "\e[40;97m│\e[0m"))))
          (recur (php/+ i 1)))))
    (print (php/implode "" parts))
    (php/flush)))
;; =====================================================================
;; § Start menu
;; =====================================================================

;; ---------------------------------------------------------------------
;; Start menu (shown once on game launch, before run-levels).
;; Pixel-perfect: every interior row is normalised to a fixed visible
;; width via end-pad (mb_strwidth on the raw text, ANSI escapes are
;; zero-width). The arrow glyphs ←→↑↓ are mb_strwidth=1 so they pad
;; correctly alongside ASCII; doubling fancy chars would skew the
;; right border.
;; ---------------------------------------------------------------------

(def start-menu-width
  "Visible character width of the menu's interior row (between the
   left and right borders). Pad target for every line."
  48)

(defn- pad-visible
  "Right-pad `text` with spaces so its visible width (ignoring ANSI
   escapes, counting wide chars correctly) hits `width`.

   Items typically end with an internal `\\e[40;97m` (or `\\e[0m`)
   that resets BG + FG. The `22` in the trailing reset also clears
   any sticky intensity attribute — `\\e[2;97m` (dim) sets bit `2`
   which `\\e[40;97m` alone does NOT cancel, so without the `22` the
   trailing pad spaces and the closing `│` border inherit the dim
   wash and read as gray. Re-applies `\\e[40;97m` (with `22` for
   intensity-normal) before the padding so trailing spaces stay on
   the menu's dark BG at full brightness."
  [text width]
  (let [stripped (php/preg_replace "/\\x1b\\[[0-9;]*[a-zA-Z]/" "" text)
        visible  (php/mb_strwidth stripped)
        pad      (php/str_repeat " " (php/max 0 (php/- width visible)))]
    (str text "\e[22;40;97m" pad)))

(defn- start-menu-rows
  "Interior strings for the start-menu box. `:sep` markers between
   sections become `├─┤` divider rows in render-start-menu.

   Controls are laid out in two columns to keep the box short.

   Adaptive to terminal height (`rows`):
     >= 28  full menu (title + controls + how-to-play + footer)
     >= 22  drop the how-to-play section
     < 22   ultra-compact (title + footer only, with a resize hint).

   The total row count always fits inside `rows - 4` cells (box top
   border + bottom border + one cushion above + one below).

   `mouse-note` is an optional terminal caveat (nil to omit) appended to the
   how-to section under the universal mouse line."
  [rows mouse-note]
  (let [w        start-menu-width
        half     (php/intdiv w 2)
        blank    (pad-visible "" w)
        ;; key+label cell: 2-space indent, yellow key in an 8-col field,
        ;; then the label. ANSI is ignored by pad-visible's width count.
        cell     (fn [key label]
                   (str "  \e[93m" key "\e[40;97m"
                        (php/str_repeat " " (php/max 1 (php/- 8 (php/mb_strwidth key))))
                        label))
        ;; one interior row holding two key/label cells side by side; each
        ;; cell padded to half the interior so the columns line up.
        row2     (fn [lkey llab rkey rlab]
                   (str (pad-visible (cell lkey llab) half)
                        (pad-visible (if (= rkey "") "" (cell rkey rlab)) half)))
        title    [blank
                  (pad-visible "      \e[1;93m✦  P H E L - D O O M  ✦\e[40;97m" w)
                  blank
                  (pad-visible (str "       \e[2;97m// crafted by \e[1;93mChemaclass\e[40;97m\e[2;97m  // v" version "\e[40;97m") w)
                  blank]
        controls [:sep blank
                  (pad-visible "  \e[1mCONTROLS\e[40;97m" w)
                  blank
                  (row2 "w s"     "move"   "1 .. 8" "weapon slot")
                  (row2 "a d"     "strafe" "h"      "info menu")
                  (row2 "← → ↑ ↓" "turn/look" "m n" "map / sound")
                  (row2 "e"       "180°"   "p"      "pause")
                  (row2 "space"   "fire"   "F3 q"   "debug / quit")
                  (row2 "r"       "reload" "mouse"  "look/fire")
                  blank]
        ;; Last line is terminal-aware: a capable terminal gets the universal
        ;; mouse hint; one that can't hide the OS pointer gets the cosmetic-
        ;; arrow caveat instead (same row count, so the box height is fixed).
        howto    [:sep blank
                  (pad-visible "  \e[1mHOW TO PLAY\e[40;97m" w)
                  blank
                  (pad-visible "  Shoot enemies. Walk into a door to advance." w)
                  (pad-visible "  Heart refills a life. Armor soaks a hit." w)
                  (pad-visible (str "  " (or mouse-note
                                             "Mouse turns the view; aim is the + crosshair.")) w)
                  blank]
        footer   [:sep blank
                  (pad-visible "    \e[93mENTER\e[40;97m start   \e[93ms\e[40;97m settings   \e[93mq\e[40;97m quit" w)
                  blank]]
    (vec (cond
           ;; Full menu: title + controls (2-col) + how-to-play + footer.
           ;; Needs >= 30 rows so the box (with the how-to section) fits
           ;; without the bottom border / footer clipping off-screen.
           (php/>= rows 30) (concat title controls howto footer)
           ;; Medium: drop the how-to-play section.
           (php/>= rows 22) (concat title controls footer)
           ;; Tight: title + footer only, with a hint that resizing
           ;; reveals the full menu. 13 items, so it needs rows >= 15 -
           ;; render-end-screen clamps the item count to rows - 2 and
           ;; drops from the TAIL, which is where the key hints live.
           (php/>= rows 15) (concat title
                                    [:sep blank
                                     (pad-visible "       \e[2;97mresize terminal for full menu\e[40;97m" w)
                                     blank]
                                    footer)
           ;; Ultra-tight (< 15 rows): the key hints matter more than the
           ;; title cushion, so drop the blanks and the resize hint rather
           ;; than let the clamp eat the ENTER/settings/quit line.
           :else            (concat [(pad-visible "      \e[1;93m✦  P H E L - D O O M  ✦\e[40;97m" w)]
                                    footer)))))

(defn render-start-menu
  "Full-screen wash + centred bordered box listing controls and a
   how-to-play blurb. Painted by render-end-screen, so borders align
   pixel-perfect with the rest of the UI. `mouse-note` is an optional
   terminal caveat line (nil to omit) from `pointer-limit-notice`."
  [cols rows mouse-note]
  (render-end-screen cols rows "\e[48;5;233m"
                     (start-menu-rows rows mouse-note)
                     start-menu-width))

(defn render-settings!
  "Full-screen wash + centred settings box, for the start-menu options
   screen (no game frame behind it). `settings` is the live map and
   `cursor` the selected field index. The in-game pause overlay reuses
   the same box via render!'s :paused branch; this entry just adds the
   background wash so it reads as a standalone screen."
  [cols rows settings cursor]
  (let [parts (buf-mk)
        wash  "\e[48;5;233m"]
    (buf-push parts "\e[H")
    (loop [r 1]
      (when (php/<= r rows)
        (buf-push parts (str "\e[" r ";1H" wash (php/str_repeat " " cols)))
        (recur (php/+ r 1))))
    (buf-push parts (settings-menu-string cols rows settings cursor
                                          "↑↓ws move  ←→ad change  esc back"))
    (print (php/implode "" parts))
    (php/flush)))

(defn render-death-screen
  "Centred YOU DIED box on a dark-red wash. Shows this run + the
   persisted bests from the scores file. Box width adapts to `cols`
   (capped 22..36) and switches to a compact layout when `rows`
   drops below `end-compact-rows` so tiny terminals still fit."
  [cols rows kills survived-s level level-name scores summary]
  (let [w (end-box-width-for cols)]
    (render-end-screen cols rows "\e[48;5;52m"
                       (death-rows kills survived-s level level-name scores summary rows w)
                       w)))

(defn render-victory-screen
  "Centred VICTORY box on a dark-green wash. Same responsive width +
   compact-mode rules as render-death-screen."
  [cols rows kills survived-s level level-name scores summary]
  (let [w (end-box-width-for cols)]
    (render-end-screen cols rows "\e[48;5;22m"
                       (victory-rows kills survived-s level level-name scores summary rows w)
                       w)))
