(ns phel-doom-tests.io.fog-lut-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.io.render.palette :refer [code-r code-g code-b nearest-256])
  (:require phel-doom.io.render.frame-math
            :refer [tex-fade-table tex-fade-tc bg-cell-cache
                    halfblock halfblock-tc paint-bg quadblock
                    seam-darken-16 seam-darken-8 seam-darken-5]))

;; ---------------------------------------------------------------------
;; Colour-space helpers (palette): 256-colour code <-> RGB round-trip.
;; These back the load-time fog LUT bake, so they must be exact for the
;; known anchor codes.
;; ---------------------------------------------------------------------

(deftest code-rgb-cube-anchors
  ;; cube code 16 = (0,0,0), 231 = (255,255,255), 21 = (0,0,255).
  (is (= 0 (php/aget code-r 16)) "cube 16 red = 0")
  (is (= 0 (php/aget code-g 16)) "cube 16 green = 0")
  (is (= 0 (php/aget code-b 16)) "cube 16 blue = 0")
  (is (= 255 (php/aget code-r 231)) "cube 231 red = 255")
  (is (= 255 (php/aget code-b 231)) "cube 231 blue = 255")
  (is (= 255 (php/aget code-b 21)) "cube 21 blue = 255")
  (is (= 0 (php/aget code-r 21)) "cube 21 red = 0"))

(deftest code-rgb-grayscale-anchors
  ;; grayscale 232 = (8,8,8), 255 = (238,238,238).
  (is (= 8 (php/aget code-r 232)) "gray 232 = 8")
  (is (= 238 (php/aget code-r 255)) "gray 255 = 238"))

(deftest nearest-256-round-trips
  (is (= 231 (nearest-256 255 255 255)) "white -> 231")
  (is (= 16 (nearest-256 0 0 0)) "black -> 16")
  (is (= 60 (nearest-256 95 95 135)) "blue-gray fog target -> cube 60"))

;; ---------------------------------------------------------------------
;; Tinted + filmic distance fog (frame-math tex-fade-table). Default ON.
;; ---------------------------------------------------------------------

(defn- decode [^int code] [(php/aget code-r code) (php/aget code-g code) (php/aget code-b code)])

(deftest near-level-preserves-code
  ;; Level 23 = nearest wall: filmic(1) = 1, so the fade is a no-op and
  ;; the code round-trips to itself.
  (is (= 196 (php/aget (php/aget tex-fade-table 23) 196)) "near red preserved")
  (is (= 46 (php/aget (php/aget tex-fade-table 23) 46)) "near green preserved"))

(deftest far-level-is-neutral-haze-not-black
  ;; Level 0 = farthest: fully faded toward the near-neutral grey fog
  ;; tint, not black. A pure-red wall ends neutral (no warm cast left:
  ;; blue >= red) and non-zero. The tint is desaturated, so the channels
  ;; sit close together rather than carrying an obvious blue.
  (let [far     (php/aget (php/aget tex-fade-table 0) 196)
        [r g b] (decode far)]
    (is (not (= 16 far)) "far is not pure black (code 16)")
    (is (>= b r) "far haze is not warm: blue >= red")
    (is (> b 0) "far haze has light energy")
    (is (<= (php/abs (php/- b r)) 24) "far haze is near-neutral, not a saturated blue")))

(deftest fog-converges-toward-haze
  ;; Aerial perspective: every code converges to the SAME grey haze at the
  ;; far end. A bright code (white) rolls DOWN toward the haze; a code
  ;; dimmer than the haze rolls UP toward it. Both meet at the same fog
  ;; level (whatever the tint quantizes to), so compare them to each other
  ;; rather than to a hard-coded code.
  (let [luma        (fn [^int code] (let [[r g b] (decode code)] (php/+ r g b)))
        bright-near (luma (php/aget (php/aget tex-fade-table 23) 231))
        bright-far  (luma (php/aget (php/aget tex-fade-table 0) 231))
        dim-near    (luma (php/aget (php/aget tex-fade-table 23) 16))
        dim-far     (luma (php/aget (php/aget tex-fade-table 0) 16))]
    (is (>= bright-near bright-far) "bright code darkens toward haze with distance")
    (is (<= dim-near dim-far) "dim code lightens toward haze with distance")
    (is (= bright-far dim-far) "bright + dim codes both reach the same haze at the far end")))

;; ---------------------------------------------------------------------
;; Perf-hoisted seam-darken LUTs (#273). 256-entry per-step darken
;; tables baked once at load. Grayscale codes (>=232) subtract `steps`
;; clamped at 232; cube codes (<232) fade hue-true toward black by
;; steps/24. These pin the bake so a future builder edit fails HERE
;; (named, readable) rather than only via the opaque golden frame hash.
;; ---------------------------------------------------------------------

(deftest seam-darken-tables-are-256-wide
  ;; Indexed straight by 256-colour code, so every code must resolve.
  (is (= 256 (php/count seam-darken-16)) "seam-darken-16 covers all 256 codes")
  (is (= 256 (php/count seam-darken-8)) "seam-darken-8 covers all 256 codes")
  (is (= 256 (php/count seam-darken-5)) "seam-darken-5 covers all 256 codes"))

(deftest seam-darken-grayscale-subtracts-steps
  ;; Grayscale ramp (>=232): straight `code - steps` (the old seam
  ;; arithmetic). 255 - 16/8/5 = 239/247/250.
  (is (= 239 (php/aget seam-darken-16 255)) "gray 255 -16 = 239")
  (is (= 247 (php/aget seam-darken-8 255)) "gray 255 -8 = 247")
  (is (= 250 (php/aget seam-darken-5 255)) "gray 255 -5 = 250"))

(deftest seam-darken-grayscale-clamps-at-232
  ;; Never drops below the darkest grayscale entry (232): a near-floor
  ;; code minus a big step saturates, and 232 itself is a fixed point.
  (is (= 232 (php/aget seam-darken-16 240)) "240 -16 clamps to 232, not 224")
  (is (= 232 (php/aget seam-darken-16 232)) "232 is the grayscale floor"))

(deftest seam-darken-cube-stays-on-the-cube-and-hue-true
  ;; Cube black (16 = 0,0,0) has no light to remove, so it is a fixed
  ;; point across every step count.
  (is (= 16 (php/aget seam-darken-16 16)) "cube black -16 stays black")
  (is (= 16 (php/aget seam-darken-8 16)) "cube black -8 stays black")
  ;; Cube white (231 = 5,5,5) fades hue-true toward black via steps/24;
  ;; more steps = darker. Anchor the exact bake AND the monotonic order.
  (is (= 102 (php/aget seam-darken-16 231)) "cube white -16 = 102 (hue-true fade)")
  (is (= 145 (php/aget seam-darken-8 231)) "cube white -8 = 145")
  (is (= 188 (php/aget seam-darken-5 231)) "cube white -5 = 188")
  (is (< (php/aget seam-darken-16 231)
         (php/aget seam-darken-8 231)
         (php/aget seam-darken-5 231))
      "more darken steps -> a dimmer cube code"))

;; ---------------------------------------------------------------------
;; Perf-hoisted bg-cell-cache (#273): 256 pre-baked BG paint cells, one
;; per 256-colour code, fetched after a `tex-fade-table` lookup so the
;; hot wall path allocates no per-cell strings. Pin the exact cell shape
;; (escape + single space) and the full coverage.
;; ---------------------------------------------------------------------

(deftest bg-cell-cache-is-256-wide
  (is (= 256 (php/count bg-cell-cache)) "one BG cell per 256-colour code"))

(deftest bg-cell-cache-cell-is-bg-escape-plus-space
  ;; Each entry paints background colour <code> then emits a single space:
  ;; ESC [ 48 ; 5 ; <code> m <space>. Pin two anchors so a stray byte in
  ;; the bake (extra reset, missing space, fg instead of bg) trips here.
  (is (= "\e[48;5;10m " (php/aget bg-cell-cache 10)) "code 10 BG cell")
  (is (= "\e[48;5;196m " (php/aget bg-cell-cache 196)) "code 196 BG cell"))

;; ---------------------------------------------------------------------
;; Truecolor (24-bit) fog: tex-fade-tc holds tagged paint values
;; (256 + (r<<16|g<<8|b)) — the same fade as tex-fade-table but WITHOUT the
;; nearest-256 snap, so the cell builders can emit \e[..;2;r;g;b. The
;; tagged value must re-snap to exactly the matching 256 LUT entry.
;; ---------------------------------------------------------------------

(defn- tc? [^int v] (>= v 256))
(defn- tc-rgb [^int v]
  (let [p (php/- v 256)]
    [(php/intdiv p 65536) (php/intdiv (php/% p 65536) 256) (php/% p 256)]))

(deftest tex-fade-tc-values-are-tagged-truecolor
  ;; Every cube/grey entry is tagged (>=256); system codes (<16) pass
  ;; through as-is so UI markers never get a fake RGB.
  (is (tc? (php/aget (php/aget tex-fade-tc 23) 196)) "near red is tagged")
  (is (tc? (php/aget (php/aget tex-fade-tc 0) 196)) "far red is tagged")
  (is (tc? (php/aget (php/aget tex-fade-tc 12) 46)) "mid green is tagged")
  (is (= 7 (php/aget (php/aget tex-fade-tc 12) 7)) "system code passes through untagged"))

(deftest tex-fade-tc-near-level-is-exact-rgb
  ;; Level 23 = nearest wall, filmic(1)=1 -> no fade, so the tagged RGB is
  ;; the code's exact cube RGB. 196 = (255,0,0).
  (is (= [255 0 0] (tc-rgb (php/aget (php/aget tex-fade-tc 23) 196))) "near red = exact (255,0,0)"))

(deftest tex-fade-tc-resnaps-to-256-lut
  ;; The truecolor value is the SAME colour as the 256 path, just unsnapped:
  ;; quantizing it back must land on the matching tex-fade-table code. Pins
  ;; the two paths together so they can't drift apart.
  (let [check (fn [lvl code]
                (let [[r g b] (tc-rgb (php/aget (php/aget tex-fade-tc lvl) code))]
                  (is (= (php/aget (php/aget tex-fade-table lvl) code)
                         (nearest-256 r g b))
                      (str "lvl " lvl " code " code " re-snaps to 256 LUT"))))]
    (check 23 196) (check 0 196) (check 12 46) (check 6 240) (check 18 21)))

(deftest halfblock-tc-emits-truecolor-cell
  (let [red   (php/aget (php/aget tex-fade-tc 23) 196)   ; tagged (255,0,0)
        green (php/aget (php/aget tex-fade-tc 23) 46)]   ; tagged (0,255,0)
    ;; Two distinct tagged channels -> full 24-bit ▀ cell (top FG, bottom BG).
    (is (= "\e[38;2;255;0;0;48;2;0;255;0m▀"
           (halfblock-tc red green)) "two tagged colours paint a 24-bit ▀")))

(deftest halfblock-tc-equal-collapses-to-space
  (let [red (php/aget (php/aget tex-fade-tc 23) 196)]
    (is (= "\e[48;2;255;0;0m " (halfblock-tc red red)) "top==bot -> single BG space cell")))

(deftest halfblock-tc-mixes-truecolor-fg-with-256-bg
  ;; A faded truecolor wall over a 256 sky/floor seam code: FG truecolor,
  ;; BG 256, one ▀ cell. Proves per-channel disambiguation.
  (let [red (php/aget (php/aget tex-fade-tc 23) 196)]
    (is (= "\e[38;2;255;0;0;48;5;236m▀" (halfblock-tc red 236)) "tagged FG + 256 BG")
    (is (= "\e[38;5;236;48;2;255;0;0m▀" (halfblock-tc 236 red)) "256 FG + tagged BG")))

(deftest paint-bg-routes-256-to-cache-and-tags-to-truecolor
  (is (= (php/aget bg-cell-cache 196) (paint-bg 196)) "256 code -> identical pre-baked cell")
  (let [red (php/aget (php/aget tex-fade-tc 23) 196)]
    (is (= "\e[48;2;255;0;0m " (paint-bg red)) "tagged value -> 24-bit BG cell")))

;; ---------------------------------------------------------------------
;; Quad floor: quadblock packs four sub-pixel samples into one 2×2
;; Block-Elements cell, quantising to brightest (FG) + darkest (BG).
;; ---------------------------------------------------------------------

(deftest quadblock-left-bright-right-dark-is-left-half
  ;; TL/BL bright (231), TR/BR dark (16): the bright column is FG, dark is
  ;; BG, mask = left half -> ▌.
  (is (= "\e[38;5;231;48;5;16m▌" (quadblock 231 16 231 16)) "vertical split -> ▌"))

(deftest quadblock-top-bright-bottom-dark-is-upper-half
  ;; Degenerate (caller would collapse this to a ▀ halfblock), but quadblock
  ;; itself still resolves the mask: top set, bottom clear -> ▀.
  (is (= "\e[38;5;231;48;5;16m▀" (quadblock 231 231 16 16)) "horizontal split -> ▀"))

(deftest quadblock-single-bright-corner-is-that-quadrant
  ;; Only TL bright -> upper-left quadrant glyph ▘.
  (is (= "\e[38;5;231;48;5;16m▘" (quadblock 231 16 16 16)) "one bright corner -> ▘"))

(deftest quadblock-resolves-truecolor-channels
  (let [red   (php/aget (php/aget tex-fade-tc 23) 196)   ; tagged (255,0,0)
        black 16]
    ;; tagged-FG + 256-BG in a single quad cell (left column red).
    (is (= "\e[38;2;255;0;0;48;5;16m▌" (quadblock red black red black))
        "truecolor FG + 256 BG quadrant")))
