(ns phel-doom.modules.engine)

(def max-depth 12.0)
(def step 0.35)
(def proj-dist
  "Horizontal projection distance in screen cells. Wall heights are
   `proj-dist / (dist * char-aspect)`, so this controls how big walls
   look at a given world distance. The horizontal FOV emerges as
   `2 * atan(viewport-width / 2 / proj-dist)` — wider terminals show
   more of the world without changing wall scale."
  70.0)

(defn- cell-at
  "Return the cell value at integer (x, y) in `pgrid`. 0 = floor, 1 =
   wall, 2 = closed door. Out-of-bounds yields 1 so rays stop at the
   map edge."
  [pgrid x y]
  (let [row (php/aget pgrid y)]
    (if (php/=== row nil)
      1
      (let [v (php/aget row x)]
        (if (php/=== v nil) 1 v)))))

(defn cast-ray
  "March a ray from (px, py) at the given angle until it hits a non-
   floor cell or `max-depth`. Returns the travelled distance only
   (back-compat for shooting code that doesn't care what was hit)."
  {:export true}
  [pgrid px py angle]
  (let [dx (php/* (php/cos angle) step)
        dy (php/* (php/sin angle) step)]
    (loop [dist 0.0 x px y py]
      (cond
        (php/>= dist max-depth)                                   max-depth
        (php/!== 0 (cell-at pgrid (php/intval x) (php/intval y))) dist
        :else                                                     (recur (php/+ dist step) (php/+ x dx) (php/+ y dy))))))

(defn- cast-ray-hit
  "Like cast-ray but returns [dist hit-cell]: the cell value (0 if the
   ray escaped to max-depth) lets the renderer pick a wall-vs-door
   shade per column."
  [pgrid px py angle]
  (let [dx (php/* (php/cos angle) step)
        dy (php/* (php/sin angle) step)]
    (loop [dist 0.0 x px y py]
      (let [hit (cell-at pgrid (php/intval x) (php/intval y))]
        (cond
          (php/>= dist max-depth) [max-depth 0]
          (php/!== 0 hit)         [dist hit]
          :else                   (recur (php/+ dist step) (php/+ x dx) (php/+ y dy)))))))

(defn cast-frame
  "Cast `width` rays and return {:dists ... :hits ...}: per-column
   fish-eye-corrected distances and the cell value the ray hit (0
   floor / 1 wall / 2 door). Renderer picks the per-column shade
   from :hits."
  {:export true}
  [world width]
  (let [pgrid               (:pgrid world)
        {:keys [x y angle]} (:player world)
        center              (* 0.5 width)
        dists               (php/array)
        hits                (php/array)]
    (loop [col 0]
      (when (php/< col width)
        (let [offset (php/atan (/ (php/- col center) proj-dist))]
          (let [[d h] (cast-ray-hit pgrid x y (php/+ angle offset))]
            (php/aset dists col (php/* d (php/cos offset)))
            (php/aset hits col h))
          (recur (php/+ col 1)))))
    {:dists dists :hits hits}))
