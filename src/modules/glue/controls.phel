(ns phel-doom.modules.glue.controls
  (:require phel.string :as str))

;; ---------------------------------------------------------------------
;; Controls: drained terminal bytes -> direction counters + rising-edge
;; one-shots. This module is intentionally pure: it doesn't touch the
;; terminal (input.phel does that), it just consumes the byte string
;; drain-keys returns.
;; ---------------------------------------------------------------------

;; =====================================================================
;; § Directional input
;; =====================================================================

(def move-hold-frames
  "Frames a movement direction (W/S/A/D + ↑/↓ arrows) stays active
   after each input byte. Sized to bridge the OS initial-key-repeat
   delay (~250-500ms on macOS/Linux): without this, the first byte
   arrives, motion runs for a few frames, then stops dead until the
   OS finally starts auto-repeating. 18 frames (~300ms at 60fps)
   covers the typical initial-delay so a press reads as one smooth
   walk, at the cost of ~300ms of post-release glide. Kitty-protocol
   release events (when supported) override this with an instant
   clear."
  18)

(def turn-hold-frames
  "Frames a turn direction (←/→) stays active after each input byte.
   Short, so rotation halts within ~50ms of releasing the arrow. The
   OS terminal sends no key-release event; this counter is the only
   way the game can tell the player let go."
  3)

(def key->slot
  "Map a single-byte input to the direction-counter slot it activates.
   Arrow-key escape sequences are normalised to ^ _ < > before lookup
   so they slot in alongside WASD."
  {"^" :fwd    "w" :fwd
   "_" :back   "s" :back
   "<" :turn-left
   ">" :turn-right
   "a" :strafe-left
   "d" :strafe-right})

(def turn-slots
  "Slots that use turn-hold-frames instead of move-hold-frames."
  #{:turn-left :turn-right})

(defn- hold-frames-for [slot]
  (if (turn-slots slot) turn-hold-frames move-hold-frames))

(defn refresh-move
  "If `byte` maps to a direction slot, refresh that slot's counter on
   `world`. Anything else (unmapped bytes) leaves the world untouched."
  {:export true}
  [world byte]
  (let [slot (get key->slot byte)]
    (if (nil? slot)
      world
      (assoc-in world [:moves slot] (hold-frames-for slot)))))

(def arrow-escape-keys
  "Search-side PHP array for php/str_replace: arrow-key CSI escapes."
  (php/array "\e[A" "\e[B" "\e[D" "\e[C"))

(def arrow-escape-replacements
  "Replace-side PHP array for php/str_replace: single-byte stand-ins
   for ↑↓←→ so refresh-from-keys can walk the input one byte at a time."
  (php/array "^"    "_"    "<"    ">"))

(defn- normalise-arrows [keys]
  (php/str_replace arrow-escape-keys arrow-escape-replacements keys))

;; ---------------------------------------------------------------------
;; Kitty keyboard protocol parsing.
;;
;; When init-input! sent CSI >3u the terminal (if it supports the
;; protocol) replaces plain key bytes with CSI-u events of the form:
;;     ESC [ <code> [;<mods>[:<event>]] u
;; where <event> is 1 (press), 2 (repeat), or 3 (release). This lets
;; us track real release transitions instead of guessing from absence
;; of input — which is the whole point of the opt-in.
;;
;; The keycode for ASCII keys is the codepoint of the lowercase
;; letter (w=119, a=97, s=115, d=100). Arrow keys are CSI ~ sequences
;; under the legacy protocol but become regular CSI u codes here:
;;     left  57417, right 57415... actually kitty assigns 1-based
;; functional codes. To keep parsing simple we only recognise the
;; ASCII direction keys (w/a/s/d) — players using ↑↓←→ still get
;; legacy CSI sequences via the arrow-normalisation path above, which
;; works regardless of protocol support.
;; ---------------------------------------------------------------------

(def ascii->slot
  "ASCII codepoint -> direction-counter slot. Only WASD movement +
   ←→ turn (kitty reports left-arrow as 57351, right as 57349)."
  {119 :fwd
   115 :back
   97 :strafe-left
   100 :strafe-right
   57351 :turn-left
   57349 :turn-right})

(defn- clear-slot
  "Force a counter to 0 (immediate stop)."
  [world slot]
  (assoc-in world [:moves slot] 0))

(defn- press-slot
  "Press / repeat event: set the counter to the slot's normal hold."
  [world slot]
  (assoc-in world [:moves slot] (hold-frames-for slot)))

(defn- handle-kitty-event
  "Apply one parsed kitty event [code event-type] to `world`. Press +
   repeat refresh the slot's hold; release clears the slot to 0 so
   the player stops the instant they let go."
  [world code event-type]
  (let [slot (get ascii->slot code)]
    (if (nil? slot)
      world
      (cond
        (php/=== event-type 3) (clear-slot world slot)
        :else                  (press-slot world slot)))))

(defn- apply-kitty-events
  "Scan `keys` for kitty CSI-u sequences and fold them into `world`.
   Returns [world-after-events leftover-string]; leftover-string is
   what's left after stripping recognised CSI-u tokens so the legacy
   byte path can handle anything that wasn't a kitty event."
  [world keys]
  (let [matches (php/array)
        ;; Regex: ESC [ <code> ( ; mods ( : event )? )? u
        ;; - code is digits
        ;; - optional ;mods (digits)
        ;; - optional :event (digits) inside the mods group
        re      "/\\x1b\\[(\\d+)(?:;\\d+(?::(\\d+))?)?u/"]
    (php/preg_match_all re keys matches)
    (let [codes  (php/aget matches 1)
          events (php/aget matches 2)
          n      (php/count codes)]
      (loop [i 0 w world]
        (if (php/>= i n)
          [w (php/preg_replace re "" keys)]
          (let [code (php/intval (php/aget codes i))]
            (let [evraw (php/aget events i)]
              ;; Missing :event capture means press (event-type 1).
              (let [event (if (or (php/=== evraw nil) (php/=== evraw ""))
                            1
                            (php/intval evraw))]
                (recur (php/+ i 1) (handle-kitty-event w code event))))))))))

(def arrow-letter->slot
  "Kitty-enhanced arrow CSI sequences (`\\e[1;<mods>(:<event>)?<letter>`)
   keep the legacy letter suffix instead of becoming CSI-u tokens.
   Letter codes: A=up B=down C=right D=left."
  {"A" :fwd
   "B" :back
   "D" :turn-left
   "C" :turn-right})

(defn- apply-kitty-arrow-events
  "Strip kitty-enhanced arrow sequences from `keys` and fold them
   into `world`. Pattern: ESC [ 1 [;mods[:event]] <A|B|C|D>. Event 3
   = release (clear slot); anything else = press/repeat (refresh hold).
   Plain legacy arrows (\\e[A etc.) are untouched here and handled
   downstream by normalise-arrows. Returns [world leftover]."
  [world keys]
  (let [matches (php/array)
        re      "/\\x1b\\[1(?:;\\d+(?::(\\d+))?)?([ABCD])/"]
    (php/preg_match_all re keys matches)
    (let [events  (php/aget matches 1)
          letters (php/aget matches 2)
          n       (php/count letters)]
      (loop [i 0 w world]
        (if (php/>= i n)
          [w (php/preg_replace re "" keys)]
          (let [letter (php/aget letters i)
                evraw  (php/aget events i)
                event  (if (or (php/=== evraw nil) (php/=== evraw ""))
                         1
                         (php/intval evraw))
                slot   (get arrow-letter->slot letter)]
            (recur (php/+ i 1)
                   (if (nil? slot)
                     w
                     (cond
                       (php/=== event 3) (clear-slot w slot)
                       :else             (press-slot w slot))))))))))

(defn refresh-from-keys
  "Fold every input byte into `world`. Three-stage parse: kitty CSI-u
   events (WASD with press/repeat/release) → kitty enhanced arrows
   (\\e[1;m:eD with same events) → legacy normalise + single-byte
   refresh. Terminals supporting any subset of kitty fall through
   gracefully to the legacy path."
  {:export true}
  [world keys]
  (let [[w1 leftover1] (apply-kitty-events world keys)
        [w2 leftover2] (apply-kitty-arrow-events w1 leftover1)]
    (let [normalised (normalise-arrows leftover2)
          n          (php/strlen normalised)]
      (loop [i 0 w w2]
        (if (php/>= i n)
          w
          (recur (php/+ i 1)
                 (refresh-move w (php/substr normalised i 1))))))))

;; =====================================================================
;; § Edge detection (one-shot actions)
;; =====================================================================

(def initial-key-snapshot
  "First-frame snapshot — nothing held yet."
  {:m false :sp false :p false :n false :e false :f3 false :r false})

(defn- f3-pressed? [keys]
  ;; F3 across terminals: xterm/macOS Terminal/iTerm2 send `\eOR`;
  ;; Linux console + a few others send `\e[13~`. Cover both.
  (or (str/contains? keys "\eOR")
      (str/contains? keys "\e[13~")))

(defn key-states
  "Which of the tracked one-shot keys appear in `keys` this frame."
  {:export true}
  [keys]
  {:m  (str/contains? keys "m")
   :sp (str/contains? keys " ")
   :p  (str/contains? keys "p")
   :n  (str/contains? keys "n")
   :e  (str/contains? keys "e")
   :f3 (f3-pressed? keys)
   :r  (str/contains? keys "r")})

(defn rising-edges
  "Build the edges map tick consumes — truthy only for keys that just
   turned on relative to the previous snapshot."
  {:export true}
  [now prev]
  {:fire         (and (:sp now) (not (:sp prev)))
   :toggle-map   (and (:m now)  (not (:m prev)))
   :toggle-pause (and (:p now)  (not (:p prev)))
   :toggle-sound (and (:n now)  (not (:n prev)))
   :toggle-debug (and (:f3 now) (not (:f3 prev)))
   :reload       (and (:r now)  (not (:r prev)))
   :about-face   (and (:e now)  (not (:e prev)))})
