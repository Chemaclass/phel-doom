#!/usr/bin/env bash
set -eu

[ "${3:-0}" = 1 ] || exit 0
root=$(git rev-parse --show-toplevel)
common=$(git rev-parse --git-common-dir)
main=$(cd "$common/.." && pwd -P)
root=$(cd "$root" && pwd -P)

[ "$root" != "$main" ] || exit 0
[ ! -e "$root/vendor" ] && [ ! -L "$root/vendor" ] || exit 0
command -v agnostic-ai >/dev/null 2>&1 || exit 0
cd "$root"
agnostic-ai sync
