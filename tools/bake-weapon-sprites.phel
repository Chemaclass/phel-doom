(ns bake (:require phel-doom.io.wad :refer [parse-header parse-directory find-lump]))

(defn u16 [s off] (php/aget (php/unpack "v" (php/substr s off 2)) 1))
(defn u32 [s off] (php/aget (php/unpack "V" (php/substr s off 4)) 1))
(defn u8  [s off] (php/ord (php/substr s off 1)))

(defn decode-pic [s base]
  (let [w (u16 s base) h (u16 s (php/+ base 2)) px (php/array)]
    (dotimes [i (php/* w h)] (php/aset px i -1))
    (dotimes [col w]
             (let [colofs (u32 s (php/+ base 8 (php/* col 4)))]
               (loop [p (php/+ base colofs)]
                 (let [td (u8 s p)]
                   (when (php/!== td 255)
                     (let [len (u8 s (php/+ p 1)) dat (php/+ p 3)]
                       (dotimes [k len]
                                (let [y (php/+ td k)]
                                  (when (php/< y h) (php/aset px (php/+ (php/* y w) col) (u8 s (php/+ dat k))))))
                       (recur (php/+ dat len 1))))))))
    {:w w :h h :px px}))

(defn palette [s base]
  (let [pal (php/array)]
    (dotimes [i 256]
             (php/aset pal i [(u8 s (php/+ base (php/* i 3)))
                              (u8 s (php/+ base (php/* i 3) 1))
                              (u8 s (php/+ base (php/* i 3) 2))]))
    pal))

;; Nearest xterm-256 index for an RGB triple (6x6x6 cube + gray ramp).
(defn rgb->256 [r g b]
  (if (and (php/=== r g) (php/=== g b))
    (cond (php/< r 8)   16
          (php/> r 248) 231
          :else         (php/+ 232 (php/intval (php/round (php// (php/* (php/- r 8) 24) 247)))))
    (php/+ 16
           (php/* 36 (php/intval (php/round (php// (php/* r 5) 255))))
           (php/* 6 (php/intval (php/round (php// (php/* g 5) 255))))
           (php/intval (php/round (php// (php/* b 5) 255))))))

;; Nearest-neighbor resize to target px-height; width doubled for the
;; ~2:1 terminal cell aspect (matches the viewer that looked right).
(defn resample [pic th]
  (let [w     (:w pic) h     (:h pic) px    (:px pic)
        scale (php// (php/* 1.0 th) h)
        tw    (php/intval (php/round (php/* w scale 2.0)))
        out   (php/array)]
    (dotimes [y th]
             (dotimes [x tw]
                      (let [sx (php/min (php/- w 1) (php/intval (php// x (php/* scale 2.0))))
                            sy (php/min (php/- h 1) (php/intval (php// y scale)))]
                        (php/aset out (php/+ (php/* y tw) x) (php/aget px (php/+ (php/* sy w) sx))))))
    {:w tw :h th :px out}))

;; Usage: vendor/bin/phel run tools/bake-weapon-sprites.phel <freedoom1.wad> [freedoom2.wad]
;; freedoom1 carries every weapon view except the super shotgun
;; (SHT2A0), which only ships in freedoom2 — pass it as the 2nd arg.
(defn load-wad [path]
  (let [s   (php/file_get_contents path)
        dir (parse-directory s (parse-header s))]
    {:s s :dir dir :pal (palette s (:offset (find-lump dir "PLAYPAL")))}))

;; Returns the formatted ":key {:w .. :h .. :px [..]}" entry string for
;; `lump`, or nil when the lump is absent. NOTE: a PHP array passed to a
;; fn is copy-on-write, so this must RETURN the string for the caller to
;; collect — pushing into a passed-in buffer here would mutate a copy.
(defn weapon-entry [wad k lump th]
  (let [e (find-lump (:dir wad) lump)]
    (when e
      (let [s   (:s wad)
            pal (:pal wad)
            pic (resample (decode-pic s (:offset e)) th)
            w   (:w pic) h   (:h pic) px  (:px pic) row (php/array)]
        (dotimes [i (php/* w h)]
                 (let [v (php/aget px i)]
                   (php/array_push row (if (php/=== v -1) "-1" (php/strval (rgb->256 (php/aget (php/aget pal v) 0) (php/aget (php/aget pal v) 1) (php/aget (php/aget pal v) 2)))))))
        (php/sprintf "\n   %s {:w %d :h %d\n             :px [%s]}"
                     k w h (php/implode " " row))))))

(let [argv (php/aget php/$_SERVER "argv")
      wad1 (if (php/>= (php/count argv) 4) (php/aget argv 3) "/tmp/fd1.wad")
      w1   (load-wad wad1)
      ;; Bake height in px: keep this low so the gun sits in the bottom
      ;; strip and does not swallow the 3D view. Width scales with it.
      th   16
      sb   (php/array)
      n    (php/array)]
  (php/aset n 0 0)
  (php/array_push sb "(ns phel-doom.io.render.weapon-sprites-data)\n\n")
  (php/array_push sb ";; GENERATED by tools/bake-weapon-sprites.phel from Freedoom (BSD).\n")
  (php/array_push sb ";; Each weapon: xterm-256 px grid (w*h, -1 = transparent), bottom-anchored\n")
  (php/array_push sb ";; first-person viewmodel. Do NOT hand-edit; re-bake instead.\n\n")
  (php/array_push sb "(def baked-weapons\n  {")
  ;; weapon key -> freedoom1 viewmodel lump. (No super-shotgun: it isn't
  ;; in freedoom1 / classic DOOM, so it keeps its ASCII silhouette.)
  (foreach [pair [[":pistol" "PISGA0"] [":shotgun" "SHTGA0"] [":chaingun" "CHGGA0"]
                  [":chainsaw" "SAWGA0"] [":bfg" "BFGGA0"] [":incinerator" "PLSGA0"]
                  [":rocket" "MISGA0"]]]
    (let [entry (weapon-entry w1 (php/aget pair 0) (php/aget pair 1) th)]
      (when entry
        (php/array_push sb entry)
        (php/aset n 0 (php/+ (php/aget n 0) 1)))))
  (php/array_push sb "})\n")
  (php/file_put_contents "src/io/render/weapon_sprites_data.phel" (php/implode "" sb))
  (php/printf "wrote src/io/render/weapon_sprites_data.phel (%d weapons)\n" (php/aget n 0)))
