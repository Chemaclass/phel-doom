;; Render entry points: the per-frame frame->string pipeline, render!,
;; perf snapshot, and the end / menu screens.
(ns phel-doom.io.render.main
  (:require phel-doom.io.render.buffer :refer [buf-mk buf-set buf-get buf-push])
  (:require phel-doom.io.render.palette :refer [sky floor enemy-head enemy-body door-shade boss-door-shade door-code boss-door-code sprite-shadow heart-shade heart-shade-bright heart-glyph heart-glyph-bright armor-shade armor-shade-bright armor-glyph armor-glyph-bright armor-shard-shade armor-shard-shade-bright armor-shard-glyph armor-shard-glyph-bright ammo-shade ammo-shade-bright ammo-glyph ammo-glyph-bright berserk-shade berserk-shade-bright berserk-glyph berserk-glyph-bright invuln-shade invuln-shade-bright invuln-glyph invuln-glyph-bright soulsphere-shade soulsphere-shade-bright soulsphere-glyph soulsphere-glyph-bright backpack-shade backpack-shade-bright backpack-glyph backpack-glyph-bright shotgun-pickup-shade shotgun-pickup-bright shotgun-pickup-glyph shotgun-pickup-glyph-bright chaingun-pickup-shade chaingun-pickup-bright chaingun-pickup-glyph chaingun-pickup-glyph-bright bfg-pickup-shade bfg-pickup-bright bfg-pickup-glyph bfg-pickup-glyph-bright incinerator-pickup-shade incinerator-pickup-bright incinerator-pickup-glyph incinerator-pickup-glyph-bright rocket-pickup-shade rocket-pickup-bright rocket-pickup-glyph rocket-pickup-glyph-bright keycard-blue-shade keycard-blue-bright keycard-blue-glyph keycard-blue-glyph-bright keycard-red-shade keycard-red-bright keycard-red-glyph keycard-red-glyph-bright keycard-yellow-shade keycard-yellow-bright keycard-yellow-glyph keycard-yellow-glyph-bright shade-table shade-code-table shade-table-blood shade-code-table-blood])
  (:require phel-doom.io.render.frame-math :refer [enemy-shade-string enemy-textured-shade-string boss-col-paint aggro-distance enemy-aggro-head-string build-horizon-gradient build-themed-gradient build-horizon-gradient-codes build-themed-gradient-codes tex-fade-table tex-fade-tc bg-cell-cache halfblock halfblock-tc paint-bg quadblock build-sky-halfblock build-sky-codes-sub seam-darken-16 seam-darken-8 seam-darken-5 seam-shade! collect-enemy-projs layout pulse visuals-for-type enemy-front-visible-at?])
  (:require phel-doom.io.render.wall-texture-data :refer [wall-tex])
  (:require phel-doom.io.render.enemy-sprite :refer [sprite-for-type-lod sprite-fade sprite-fade-index sprite-col-x sprite-subcol-x enemy-sprite-cell enemy-sprite-quad])
  (:require phel-doom.io.render.hud :refer [minimap-door-pulse minimap-rows minimap-frame hud-debug-line hud-line-str help-menu-string settings-menu-string pause-menu-string])
  (:require phel-doom.io.render.paint :refer [paint-face-overlay paint-crosshair paint-intro-splash paint-locked-bump paint-blood-drops paint-rear-warning paint-low-ammo paint-reload-reminder paint-save-flash paint-reload-ready paint-game-info paint-berserk-badge paint-invuln-badge paint-empty-click paint-heartbeat-vignette paint-hit-vignette paint-berserk-tint paint-heat-bar paint-kill-streak paint-compass paint-enemy-hp-flashes paint-hearts-hud paint-pistol-hud paint-weapon-hud])
  (:require phel-doom.io.render.sprites :refer [paint-blood-fx-into paint-pickups-into paint-projectiles-into paint-tracers-into build-blood-cols])
  (:require phel-doom.core.engine :refer [cast-frame max-depth proj-dist])
  (:require phel-doom.core.projection :refer [char-aspect wall-px pitch-rows project-height])
  (:require phel-doom.core.perf :refer [render-scale])
  (:require phel-doom.core.format :refer [format-duration])
  (:require phel-doom.core.version :refer [version]))

;; =====================================================================
;; § Perf snapshot side-channel
;; =====================================================================

(def perf-snapshot
  "Side-channel for the F3 perf overlay. `render!` writes the latest
   cast-ms / render-ms / bytes / avg-rle / PHP-mem snapshot into this
   atom every frame the overlay is on; `frame-stats` reads it on the
   following frame so the debug row paints last-frame numbers. nil
   while the overlay is off — gates the paint-debug-row helper out."
  (atom nil))

(defn read-perf-snapshot
  "Public accessor for the latest perf snapshot written by render!.
   Called by play.frame-stats so the debug HUD has data to paint on
   the next frame. Returns nil while the overlay has never been on."
  []
  @perf-snapshot)

(defn- record-cast-ms!
  "Helper used by `frame->string` when :debug? is on. Stashes the
   measured cast-phase time so `render!` can subtract it from total
   frame time to get the render-phase slice. Skips the swap when the
   atom is unset so the off path stays branch-free."
  [^float ms]
  (swap! perf-snapshot
         (fn [snap] (if (nil? snap) {:cast-ms ms} (assoc snap :cast-ms ms)))))

;; =====================================================================
;; § Enemy sprite toggle
;; =====================================================================

(def enemy-sprites-on?
  "Memoised PHEL_DOOM_NO_SPRITES probe for enemy billboard sprites.
   Reads the same env var as the weapon sprite toggle so one flag
   disables all Freedoom bitmaps. nil = not yet probed."
  (atom nil))

(defn- enemy-sprites-enabled?
  "Enemy billboard sprites are ON by default. PHEL_DOOM_NO_SPRITES=1
   forces the legacy glyph path (A/B compare, CI, narrow terminals)."
  []
  (let [cached @enemy-sprites-on?]
    (if (nil? cached)
      (let [on (not (php/=== "1" (php/getenv "PHEL_DOOM_NO_SPRITES")))]
        (reset! enemy-sprites-on? on)
        on)
      cached)))
;; =====================================================================
;; § Wall texture (baked Freedoom WALL70_2)
;; =====================================================================

(def wall-tex-px
  "Flat row-major xterm-256 palette array of the baked stone wall
   texture, sampled per wall cell by (u, v)."
  (:px wall-tex))

(def wall-tex-w
  "Wall texture width/height (square, 64). Both the U and V sample wrap
   into [0, wall-tex-w)."
  (:w wall-tex))

(def floor-tex-mid
  "Mid-grey the floor texture is contrast-compressed toward (~texture mean)."
  242)

(def floor-tex-soften
  "Contrast factor (0..1) for the floor copy of the stone texture. The
   flat's hard dark cracks (codes ~232-236), sampled at the floor plane's
   2× vertical grazing angle, read as harsh black speckle down long
   corridors. The floor (only) samples a softened copy that lerps each
   texel toward `floor-tex-mid`, so cracks calm to a gentle mottle while
   the walls keep full contrast. 1.0 = identical to walls, 0.0 = flat grey."
  0.5)

(def floor-tex-px
  "Contrast-softened copy of `wall-tex-px` sampled by the floor plane only
   (see `floor-tex-soften`). Each texel is lerped toward `floor-tex-mid`
   and clamped into the grayscale ramp. Built once at load; the floor path
   then pays nothing extra (same single `aget` as before, different array)."
  (let [n (php/count wall-tex-px)
        a (php/array)]
    (loop [i 0]
      (when (php/< i n)
        (let [c  (php/aget wall-tex-px i)
              c' (php/intval (php/round (php/+ floor-tex-mid
                                               (php/* (php/- c floor-tex-mid) floor-tex-soften))))]
          (php/aset a i (php/max 232 (php/min 255 c'))))
        (recur (php/+ i 1))))
    a))

(def door-tex-px
  "Procedural 64×64 amber metal door texture (flat row-major xterm-256
   colour-cube codes), sampled by the same per-cell (u, v) path as the
   stone walls. Layout: dark rust outer border (52) with a red-rust frame
   ring (88) and four corner rivets (214); the body is six vertical planks
   (alternating 166/172 fills, 214 left-edge highlight, 130 right-edge
   shadow, 94 grooves) split by a horizontal mid rail — the classic
   two-panel DOOM door silhouette. All codes live in the 16-231 colour
   cube so `tex-fade-table` distance fog darkens them hue-true. Built
   once at load; deterministic."
  (let [a (php/array)]
    (loop [v 0]
      (when (php/< v 64)
        (loop [u 0]
          (when (php/< u 64)
            (let [pu (php/% (php/- u 5) 9)
                  pi (php/intdiv (php/- u 5) 9)
                  c  (cond
                       ;; outer border ring (52 = dark rust; 58 would be
                       ;; olive and reads green against the amber body)
                       (or (php/< u 2) (php/> u 61) (php/< v 2) (php/> v 61)) 52
                       ;; corner rivets on the frame
                       (and (or (php/=== u 3) (php/=== u 60))
                            (or (php/=== v 3) (php/=== v 60)))                214
                       ;; frame ring (red-rust, same family as the border:
                       ;; 94 here reads olive next to the amber planks)
                       (or (php/< u 5) (php/> u 58) (php/< v 5) (php/> v 58)) 88
                       ;; horizontal mid rail + its lighter lips
                       (and (php/>= v 30) (php/<= v 32))                      94
                       (or (php/=== v 29) (php/=== v 33))                     130
                       ;; vertical plank grooves + edge shading
                       (php/>= pu 7)                                          94
                       (php/=== pu 0)                                         214
                       (php/=== pu 6)                                         130
                       ;; plank fill, alternating warmth per plank
                       (php/=== 0 (php/% pi 2))                               166
                       :else                                                  172)]
              (php/aset a (php/+ (php/* v 64) u) c))
            (recur (php/+ u 1))))
        (recur (php/+ v 1))))
    a))

(defn- wall-textures-enabled?
  "Textured walls are ON by default; PHEL_DOOM_FLAT_WALLS=1 forces the
   old flat-shaded stone (A/B compare, or taste). Resolved per frame."
  []
  (not (php/=== "1" (php/getenv "PHEL_DOOM_FLAT_WALLS"))))

(defn- floor-textures-enabled?
  "Textured floor (floor-casting) is ON by default; PHEL_DOOM_FLAT_FLOOR=1
   forces the old flat grey floor gradient. Also gated by the wall-texture
   flag (no point casting a floor texture with textures off)."
  []
  (not (php/=== "1" (php/getenv "PHEL_DOOM_FLAT_FLOOR"))))

(defn- subpixel-enabled?
  "Half-block sub-pixel rendering (▀ with independent top/bottom colours,
   2× vertical resolution on floor / walls / sky) is ON by default.
   PHEL_DOOM_NO_SUBPIXEL=1 forces the old one-colour-per-cell paths for an
   A/B perf baseline or terminals whose font lacks the ▀ block glyph.
   Resolved once per frame."
  []
  (not (php/=== "1" (php/getenv "PHEL_DOOM_NO_SUBPIXEL"))))

(defn- no-truecolor?
  "PHEL_DOOM_NO_TRUECOLOR=1 hard-disables the 24-bit fog path regardless
   of the :truecolor setting — the escape hatch for terminals without
   truecolor support. Resolved per frame."
  []
  (php/=== "1" (php/getenv "PHEL_DOOM_NO_TRUECOLOR")))

(defn- force-truecolor?
  "PHEL_DOOM_TRUECOLOR=1 forces the 24-bit fog path on without touching
   saved settings (A/B compare, screenshots). Resolved per frame."
  []
  (php/=== "1" (php/getenv "PHEL_DOOM_TRUECOLOR")))

(defn- no-quad?
  "PHEL_DOOM_NO_QUAD=1 hard-disables the 2×2 quadrant floor regardless of
   the :quad-floor setting (escape hatch / perf baseline). Per frame."
  []
  (php/=== "1" (php/getenv "PHEL_DOOM_NO_QUAD")))

(defn- force-quad?
  "PHEL_DOOM_QUAD=1 forces the quadrant floor on without touching saved
   settings (A/B compare, screenshots). Per frame."
  []
  (php/=== "1" (php/getenv "PHEL_DOOM_QUAD")))

(defn- flat-walltex-on?
  "Dev / bench override for the `Low detail` player setting (fidelity-for-speed,
   crisp-edge): PHEL_DOOM_FLAT_WALLTEX=1 forces the low-detail path on without
   touching saved settings, so local/bench.phel + an A/B compare can toggle it.
   The player path is the `:fast-walls` setting (kept that key name for
   save-file back-compat) threaded via stats; frame->string ORs the two. Low
   detail paints both the wall AND the floor INTERIOR as one flat colour (single
   texel) instead of a two-sample ▀ half-block, removing the bulk of the
   per-sub-row wall + floor texture sampling on the hottest render path. The wall
   seam mixer still runs, so the wall SILHOUETTE / top-bottom edges keep their
   sub-pixel precision - only the interior textures lose vertical half-row
   detail. Sky and sprites are untouched. Both unset = byte-identical to the
   shipped renderer (golden frame hashes unchanged). Full-detail (non-px2) only.
   Resolved once per frame."
  []
  (php/=== "1" (php/getenv "PHEL_DOOM_FLAT_WALLTEX")))

(def floor-cast-k
  "Numerator of the floor-cast perpendicular distance: a floor cell `p`
   pixels below the horizon sits at perp-distance `floor-cast-k / p`.
   Derived from the wall projection with a half-unit camera eye height:
   `proj-dist * 0.5 / char-aspect`."
  (php// (php/* proj-dist 0.5) char-aspect))

(defn- build-floor-dperp
  "Per-row perpendicular ground distance for floor-casting. Row centres
   below the horizon (`vh/2`) map to `floor-cast-k / (row+0.5 - vh/2)`,
   clamped to `max-depth`. Rows at/above the horizon get `max-depth`
   (never sampled as floor — walls/sky cover them). One pass over vh.
   `pr` (scene rows, default 0) shears the horizon down/up for look
   up/down so the floor plane tracks the pitched wall band; pr=0 keeps
   the table identical."
  [^int vh & [pr-arg]]
  (let [pr     (or pr-arg 0)
        arr    (php/array)
        center (php/+ (php/* 0.5 vh) pr)]
    (loop [r 0]
      (when (php/< r vh)
        (let [p (php/- (php/+ r 0.5) center)]
          (php/aset arr r (if (php/<= p 0.0)
                            max-depth
                            (php/min max-depth (php// floor-cast-k p)))))
        (recur (php/+ r 1))))
    arr))

;; Seam accent depths live as hue-true darken LUTs in frame-math
;; (seam-darken-16 / -8 / -5): base line 16 steps, wall shoulder +
;; first floor sub-row 8, sky lip 5. LUTs (not plain subtraction)
;; because door texels are colour-cube codes where `code - n` would
;; jump hue instead of darkening.

(def floor-darken
  "Shade steps the textured floor sits below a wall at the same distance.
   The floor is lit at a grazing angle and reads as in-shadow stone; a
   few steps darker also calms the high-frequency texel aliasing near the
   camera so the floor reads as ground, not noise."
  4)

(defn- build-floor-level
  "Per-row fog level (0..23) for the textured floor, from `build-floor-dperp`.
   Same gamma falloff as the walls, pulled `floor-darken` steps darker so
   the ground reads as shadowed stone distinct from the lit walls."
  [floor-dperp ^int vh]
  (let [arr (php/array)]
    (loop [r 0]
      (when (php/< r vh)
        (let [d (php/aget floor-dperp r)]
          (php/aset arr r (php/max 0
                                   (php/min 23
                                            (php/- (php/intval (php/* (php/pow (php/- 1.0 (php/min 1.0 (php// d max-depth))) 0.6) 23))
                                                   floor-darken)))))
        (recur (php/+ r 1))))
    arr))

(def floor-cast-k-sub
  "Floor-cast numerator at sub-pixel (2×) vertical resolution. Doubling
   the vertical pixel density halves the per-pixel drop below the horizon,
   so the perp-distance numerator doubles to keep the same world point."
  (php/* 2.0 floor-cast-k))

(defn- build-floor-dperp-sub
  "Per-SUB-ROW perpendicular ground distance for the half-block floor.
   Indexes 0..2vh-1; the horizon sits at sub-row `vh`. Sub-rows below it
   map to `k / (s+0.5 - vh)`, clamped to `max-depth`; sub-rows at/above
   the horizon get `max-depth` (never sampled as floor). `k` is the
   projection numerator for ONE sub-row of drop (`floor-cast-k-sub`,
   sub-row = half a terminal row). The pixel-doubled renderer passes
   `vh` = 2x its scene height so the table covers its 4-per-scene-row
   sub-pixel space - the same sub-pixel density as full detail. `pr`
   (SCENE rows, default 0) shears the sub-row horizon by `2·pr` for look
   up/down so the floor tracks the pitched wall sub-bounds; pr=0 keeps
   the table identical."
  [^int vh ^float k & [pr-arg]]
  (let [pr     (or pr-arg 0)
        arr    (php/array)
        sub    (php/* 2 vh)
        center (php/+ (php/* 1.0 vh) (php/* pr 2))]
    (loop [s 0]
      (when (php/< s sub)
        (let [p (php/- (php/+ s 0.5) center)]
          (php/aset arr s (if (php/<= p 0.0)
                            max-depth
                            (php/min max-depth (php// k p)))))
        (recur (php/+ s 1))))
    arr))

(defn- build-floor-level-sub
  "Per-SUB-ROW fog level (0..23) for the half-block floor, from
   `build-floor-dperp-sub`. Same gamma + `floor-darken` as the cell-res
   `build-floor-level`, just sampled at 2× vertical resolution."
  [floor-dperp-sub ^int vh]
  (let [arr (php/array)
        sub (php/* 2 vh)]
    (loop [s 0]
      (when (php/< s sub)
        (let [d (php/aget floor-dperp-sub s)]
          (php/aset arr s (php/max 0
                                   (php/min 23
                                            (php/- (php/intval (php/* (php/pow (php/- 1.0 (php/min 1.0 (php// d max-depth))) 0.6) 23))
                                                   floor-darken)))))
        (recur (php/+ s 1))))
    arr))

;; =====================================================================
;; § Per-column wall shading
;; =====================================================================

(defn- compute-wall-shades
  "Per-column wall shading. Builds and returns seven PHP-array buffers
   filled with: wall top + bottom screen rows, plus precomputed cell
   strings for the wall body, the top/bot half-block edges, and the
   top/bot ambient-shadow band.

   PHP arrays are pass-by-value in fn args, so the buffers are CREATED
   inside this fn and returned in a map; the caller destructures to
   keep the same names it used previously.

   `cast`       ray-cast outputs {:dists :hits :sides}
   `palette`    {:stbl :ctbl :door-shade-now :door-code-now
                 :door-tex-boost :sky-code-grad :floor-code-grad
                 :blood-sky-code-grad :blood-floor-code-grad}
   `blood-cols` per-col directional blood mask (from build-blood-cols)
   `haze-shift` int 0-23: how many shade-table steps to pull walls
                toward black. Doors are kept bright as a nav cue.
   `pd`         wall-height projection numerator: `proj-dist` at full
                detail, half of it in pixel-doubled mode (scene rows are
                two terminal rows tall, so heights halve to keep the
                same on-screen wall size).
   `pr`         look up/down horizon shear in scene rows (default 0):
                added to every wall top so the whole wall band slides
                down (look up) / up (look down) with the sky/floor
                split. pr=0 keeps the shading byte-identical."
  [vw vh haze-shift cast palette blood-cols ^float pd & [pr-arg]]
  (let [{:keys [dists hits sides wallxs]}                              cast
        {:keys [stbl ctbl door-shade-now door-code-now
                door-tex-boost
                boss-door-shade-now boss-door-code-now boss-unlocked?
                sky-code-grad floor-code-grad
                blood-sky-code-grad blood-floor-code-grad]}            palette
        tops                                                           (buf-mk)
        bots                                                           (buf-mk)
        normal                                                         (buf-mk)
        top-edge                                                       (buf-mk)
        bot-edge                                                       (buf-mk)
        top-shadow                                                     (buf-mk)
        bot-shadow                                                     (buf-mk)
        ;; Per-column wall-texture sampling state. `tex-u` is the
        ;; texture column (0..63) from the ray's wall-hit fraction;
        ;; `tex-level` is the 0..23 distance/side brightness used to fog
        ;; the texture, or -1 to mark a cell that is NOT textured (boss
        ;; door or a blood-band column — those keep the flat `normal`
        ;; shade so the red wash / nav glyphs stay clean). `tex-px` is
        ;; the texel array the column samples: the stone wall texture,
        ;; or the amber door texture on door columns.
        tex-u                                                          (buf-mk)
        tex-level                                                      (buf-mk)
        tex-px                                                         (buf-mk)
        pr                                                             (or pr-arg 0)
        ;; Column-loop invariant: vh-1 is used in sky-edge-row and
        ;; flr-edge-row (both per-column). Hoisting saves 2*vw
        ;; subtractions per compute-wall-shades call.
        vh-1                                                           (php/- vh 1)]
    (loop [col 0]
      (when (php/< col vw)
        (let [dist         (buf-get dists col)
              wall-h       (php/min vh (php/intval (wall-px pd dist)))
              top          (php/+ (php/intdiv (php/- vh wall-h) 2) pr)
              blood?       (php/> (buf-get blood-cols col) 0.4)
              stbl-l       (if blood? shade-table-blood stbl)
              ctbl-l       (if blood? shade-code-table-blood ctbl)
              ;; Sample the gradient code at the exact row of each seam
              ;; cell so the ▀ top-half blends the true sky shade at that
              ;; row (not a flat dark-236), eliminating the dark-dot
              ;; artifact where bright gradient meets flat edge code.
              sky-edge-row (php/max 0 (php/min vh-1 top))
              flr-edge-row (php/max 0 (php/min vh-1 (php/- (php/+ top wall-h) 1)))
              sky-edge-c   (buf-get (if (and blood? blood-sky-code-grad)
                                      blood-sky-code-grad
                                      sky-code-grad)
                                    sky-edge-row)
              flr-edge-c   (buf-get (if (and blood? blood-floor-code-grad)
                                      blood-floor-code-grad
                                      floor-code-grad)
                                    flr-edge-row)
              h            (buf-get hits col)]
          (buf-set tops col top)
          (buf-set bots col (php/+ top wall-h))
          (buf-set tex-level col -1)            ; default: not textured
          (cond
            ;; Boss door stays blood-red ONLY while the boss lives; once
            ;; killed (held-keys gains :boss) it falls through to the
            ;; regular orange textured door so it reads as walk-through.
            (and (php/=== 5 h) (not boss-unlocked?))
            (do (buf-set normal      col boss-door-shade-now)
                (buf-set top-edge    col (str "\e[48;5;" boss-door-code-now ";38;5;" sky-edge-c "m▀"))
                (buf-set bot-edge    col (str "\e[48;5;" flr-edge-c ";38;5;" boss-door-code-now "m▀"))
                (buf-set top-shadow  col boss-door-shade-now)
                (buf-set bot-shadow  col boss-door-shade-now))
            (or (php/=== 2 h) (php/=== 3 h) (php/=== 4 h) (php/=== 9 h) (php/=== 5 h))
            (do (buf-set normal      col door-shade-now)
                (buf-set top-edge    col (str "\e[48;5;" door-code-now ";38;5;" sky-edge-c "m▀"))
                (buf-set bot-edge    col (str "\e[48;5;" flr-edge-c ";38;5;" door-code-now "m▀"))
                (buf-set top-shadow  col door-shade-now)
                (buf-set bot-shadow  col door-shade-now)
                ;; Textured door: same gamma distance fog + EW side
                ;; shading as the stone walls, but floored at level 8
                ;; (a door is the nav cue — it never fades to black)
                ;; and immune to the near-death haze. The door pulse
                ;; rides the fog level via `door-tex-boost` instead of
                ;; swapping paint strings. Blood-band columns keep the
                ;; flat striped door (the seam mixer's sky/floor codes
                ;; are grayscale-only).
                (when (not blood?)
                  (let [didx (php/max 0
                                      (php/min 23
                                               (php/+ (php/intval (php/* (php/pow (php/- 1.0 (php/min 1.0 (php// dist max-depth))) 0.6) 23))
                                                      (if (php/=== (buf-get sides col) 0) 3 0))))]
                    (buf-set tex-u     col (php/min 63 (php/intval (php/* (buf-get wallxs col) 64))))
                    (buf-set tex-level col (php/min 23 (php/+ (php/max 8 (php/min 21 didx)) door-tex-boost)))
                    (buf-set tex-px    col door-tex-px))))
            :else
            (let [idx-raw (php/max 0
                                   (php/min 23
                                            (php/+ (php/intval (php/* (php/pow (php/- 1.0 (php/min 1.0 (php// dist max-depth))) 0.6) 23))
                                                   (if (php/=== (buf-get sides col) 0) 3 0))))
                  ;; Haze pulls every wall cell toward index 0 (black)
                  ;; by `haze-shift` steps. 0 = full visibility; values
                  ;; come from frame->string based on player lives.
                  idx     (php/max 0 (php/- idx-raw haze-shift))]
              (let [plain     (buf-get stbl-l idx)
                    shd-idx   (php/max 0 (php/- idx 3))
                    shd-bg    (buf-get stbl-l shd-idx)
                    edge-code (buf-get ctbl-l shd-idx)]
                ;; Flat plain wall cells: no per-cell brick speckle. Walls
                ;; read as clean shaded stone; depth comes from the gamma
                ;; distance falloff + stronger EW side-shading instead.
                (buf-set normal col plain)
                (buf-set top-edge   col (str "\e[48;5;" edge-code ";38;5;" sky-edge-c "m▀"))
                (buf-set bot-edge   col (str "\e[48;5;" flr-edge-c ";38;5;" edge-code "m▀"))
                (buf-set top-shadow col shd-bg)
                (buf-set bot-shadow col shd-bg)
                ;; Plain stone walls get the baked texture (unless blood
                ;; is washing this column - then the flat red `normal`
                ;; reads cleaner than a tinted texture). `idx` doubles as
                ;; the texture fog level so depth + EW side-shading match
                ;; the flat path exactly.
                (when (not blood?)
                  (buf-set tex-u     col (php/min 63 (php/intval (php/* (buf-get wallxs col) 64))))
                  (buf-set tex-level col idx)
                  (buf-set tex-px    col wall-tex-px)))))
          (recur (php/+ col 1)))))
    {:tops tops :bots bots :normal normal
     :top-edge top-edge :bot-edge bot-edge
     :top-shadow top-shadow :bot-shadow bot-shadow
     :tex-u tex-u :tex-level tex-level :tex-px tex-px}))

;; =====================================================================
;; § Riser / tier-top column data (issue #370)
;; =====================================================================

(def riser-face-darken
  "Shade-table steps a riser FACE is pulled below the coplanar wall shade
   (issue #373). Big enough that a step never reads as a same-distance
   wall, small enough that a near rise doesn't crush to black."
  3)

(defn riser-shade-level
  {:doc "Shade-table index for a riser FACE (issue #373 tier polish). Takes
         the index a coplanar WALL would use at the same distance and pulls
         it darker by `riser-face-darken` plus the tier level (height `z1`
         in fz-step units: 0.25/0.5/0.75 -> 1/2/3), so a step reads distinct
         from a wall AND taller rises read progressively darker (elevation
         legible at a glance). Higher index = brighter (shade-table[i] =
         code 232+i), so the pull is a subtraction, clamped at 0 (darkest).
         `4.0` is `1 / map/fz-step` - kept literal to avoid a core.map
         require in this hot render module; map-test/test-fz-step-pinned
         pins fz-step at 0.25, so a drift there fails the suite loudly."
   :see-also ["compute-riser-shades"]}
  [^int wall-idx ^float z1]
  (php/max 0 (php/- wall-idx
                    (php/+ riser-face-darken
                           (php/intval (php/round (php/* z1 4.0)))))))

(defn- compute-riser-shades
  "Per-column NEAREST riser data from the flat `:spans` stream (#369),
   for painting a step's rise-face and gating the tier-top floor-cast
   behind it (#370).

   `:spans` arrives ordered by ascending distance within a ray and
   ascending column across rays (docs/raycaster.md), so the FIRST event
   seen for a column is its nearest riser; farther risers in the same
   column are behind it and never visible, so they're skipped outright -
   this IS the row clip; there's nothing nearer left to paint over.

   Returns 5 php-arrays; a column with no riser is simply absent (its
   `riser-top` aget reads nil, the row loop's `has-riser?` sentinel):
     riser-top / riser-bot  screen rows of the riser face [top, bot)
     riser-shade            side-shaded wall colour string for the face
     riser-dist             fish-eye corrected distance (for the enemy
                             z-buffer compare, same role as `dists`)
     tier-fz                floor height BEYOND the riser (z1) - the
                             tier-top floor-cast in the row loop reads
                             this instead of 0.0.

   `pd` is the wall-height projection numerator (scene_pd: proj-dist at
   full detail, halved in px2); `svh` is the scene viewport height
   `project-height` centres rows on; `eye-z` is the camera height;
   `haze-shift` dims the riser face exactly like `compute-wall-shades`
   dims walls."
  [spans ^int haze-shift stbl ctbl ^float pd ^int svh ^float eye-z & [pr-arg]]
  (let [pr         (or pr-arg 0)
        span-n     (php/count spans)
        riser-top  (php/array)
        riser-bot  (php/array)
        riser-sh   (php/array)
        riser-dist (php/array)
        tier-fz    (php/array)]
    (loop [base 0]
      (when (php/< base span-n)
        (let [col (php/aget spans base)]
          (when (php/=== nil (php/aget riser-top col))
            (let [d-corr   (php/aget spans (php/+ base 1))
                  z0       (php/aget spans (php/+ base 2))
                  z1       (php/aget spans (php/+ base 3))
                  side     (php/aget spans (php/+ base 4))
                  top-f    (project-height pd svh d-corr eye-z z1)
                  bot-f    (project-height pd svh d-corr eye-z z0)
                  idx-raw  (php/max 0
                                    (php/min 23
                                             (php/+ (php/intval (php/* (php/pow (php/- 1.0 (php/min 1.0 (php// d-corr max-depth))) 0.6) 23))
                                                    (if (php/=== side 0) 3 0))))
                  ;; #373 tier polish: risers read as steps, not walls.
                  ;; Start from the shade a coplanar wall would use here,
                  ;; then pull it darker + nudge by tier height (z1).
                  wall-idx (php/max 0 (php/- idx-raw haze-shift))
                  idx      (riser-shade-level wall-idx z1)]
              (php/aset riser-top  col (php/+ (php/intval (php/round top-f)) pr))
              (php/aset riser-bot  col (php/+ (php/intval (php/round bot-f)) pr))
              (php/aset riser-sh   col (php/aget stbl idx))
              (php/aset riser-dist col d-corr)
              (php/aset tier-fz    col z1))))
        (recur (php/+ base 8))))
    {:riser-top riser-top :riser-bot riser-bot :riser-shade riser-sh
     :riser-dist riser-dist :tier-fz tier-fz}))

;; =====================================================================
;; § Pulse cadences + near-death haze
;; =====================================================================

;; Pickup pulse cadences (rad/s). Each interactive pickup throbs on a
;; distinct frequency so co-spawned items read as separate beats instead
;; of syncing into one flash. Tuned by feel; frame->string's pulse
;; bindings below pair each cadence with the glyph it drives. (Doors and
;; the aggro head no longer pulse - held steady-bright for a calmer 3D
;; view - so their cadences were dropped.)
(def pulse-freq-heart         6.0)
(def pulse-freq-armor         5.0)
(def pulse-freq-ammo          7.0)
(def pulse-freq-berserk       9.0)
(def pulse-freq-invuln        8.0)
(def pulse-freq-soulsphere    6.0)
(def pulse-freq-armor-shard   5.5)
(def pulse-freq-backpack      4.0)
(def pulse-freq-keycard       5.5)
(def pulse-freq-weapon-pickup 3.0)

(defn- haze-shift-for-lives
  "Shade-table steps to pull walls toward black as the life pool drains,
   so the world reads as 'consumed by darkness' near death. `lives` is a
   half-heart pool (10 = full); the haze ramps over the last ~3 hearts.
   0 = full visibility; higher = darker (clamped into the shade table by
   compute-wall-shades). Sky / floor / doors are left untouched."
  [lives]
  (let [l (or lives 0)]
    (cond
      (php/<= l 0) 0
      (php/<= l 2) 6
      (php/<= l 4) 3
      (php/<= l 6) 1
      :else        0)))
;; =====================================================================
;; § Per-frame pipeline
;; =====================================================================

;; Sky / floor gradients (shade arrays + their code twins, normal +
;; blood variants) depend ONLY on `vh`: the palettes are compile-time
;; constants and the floor base-code / banding are literals. They were
;; rebuilt from scratch every frame (6 × O(vh) allocations); now a
;; single-slot atom memoizes the whole bundle keyed by vh, so they
;; rebuild only when the viewport height changes (resize / F3 toggle).
;; Input-determined cache — same vh always yields the same arrays — so
;; it preserves frame->string's referential transparency, same as the
;; engine's offset-cache.
(def- gradient-cache (atom {:vh -1 :pr 0}))

;; Single-slot memo for the full-resolution weapon-sprite floor gradient
;; (pixel-doubled mode only). Keyed on terminal height `vh` alone - it
;; carries no pitch shear and `vh` only changes on resize, so the lookup
;; is a per-frame O(1) hit instead of a ~0.2ms rebuild every frame.
(def- floor-full-cache (atom {:vh -1 :grad nil}))

(defn- build-wall-sub-bounds
  "Per-column seam data for the sub-row wall mixers, all
   column-constant so the cell loops read plain agets. Returns a
   php-array `[tops-sub bots-sub mix sky-lim floor-from]`:
     tops-sub/bots-sub  wall bounds in SUB-rows (`n` per scene cell:
                        4 in pixel-doubled mode where a scene cell is
                        two terminal rows tall, 2 at full detail -
                        both are half a terminal row, the ▀ sub-pixel
                        precision)
     mix                1 when the column mixes at sub precision
                        (textured + not a glyph-mode enemy column)
     sky-lim            first scene row that is NOT pure sky
     floor-from         first scene row that is pure floor
   Arrays are created here so the writes happen in this fn's own scope
   (see the closure-copy note in docs/performance.md). `pd` is the scene
   projection numerator (proj-dist at full detail, half of it in
   pixel-doubled mode); falls back to the scene-row tops/bots for
   non-mixing columns. NOTE: the fallbacks copy tops/bots BEFORE the
   enemy zone pass mutates them, so consumers must only trust sky-lim /
   floor-from on mix columns (mix columns are never glyph-enemy
   columns, whose tops/bots the zone pass rewrites). `pr` (scene rows,
   default 0) shears the sub-row band by `pr*n` for look up/down so the
   seam tracks the cell-res tops; pr=0 keeps the bounds identical."
  [dists tex-levels emask tops bots ^bool sprites-on ^bool tex-on? ^int svw ^int svh ^float pd ^int n & [pr-arg]]
  (let [pr  (or pr-arg 0)
        ts  (php/array)
        bs  (php/array)
        mx  (php/array)
        sl  (php/array)
        ff  (php/array)
        nf  (php/* 1.0 n)
        cap (php/* n svh)
        ;; Look up/down: shear the sub-row wall band by `pr` SCENE rows =
        ;; `pr*n` sub-rows (n per scene cell), matching the cell-res tops
        ;; from compute-wall-shades so the half-row seam tracks the band.
        prn (php/* pr n)]
    (loop [c 0]
      (when (php/< c svw)
        (let [dist (buf-get dists c)
              whs  (php/min cap (php/intval (wall-px (php/* nf pd) dist)))
              t    (php/+ (php/intdiv (php/- cap whs) 2) prn)
              b    (php/+ t whs)
              ;; Plain nested `if` (ternary) instead of `and`/`or`: those
              ;; macro forms compile to a per-column IIFE closure capturing
              ;; the whole frame scope (svw calls/frame); the ternary inlines
              ;; with no capture. Same boolean, runs in the wall-bounds loop.
              mix? (if tex-on?
                     (if (php/>= (buf-get tex-levels c) 0)
                       (if sprites-on true (php/=== nil (buf-get emask c)))
                       false)
                     false)]
          (php/aset ts c t)
          (php/aset bs c b)
          (php/aset mx c (if mix? 1 0))
          (php/aset sl c (if mix? (php/intdiv t n) (buf-get tops c)))
          (php/aset ff c (if mix?
                           (php/+ (php/intdiv (php/max t (php/- b 1)) n) 1)
                           (buf-get bots c))))
        (recur (php/+ c 1))))
    (php/array ts bs mx sl ff)))

(defn- compact-cast-2
  "Compact a full-width cast done at scale 2 (one ray per two output
   columns, replicated) into scene-width arrays for the pixel-doubled
   renderer: every second column carries the sample, and the offset
   tables were built for the FULL width — so the half-res scene keeps
   the full-size FOV instead of zooming like a half-size terminal.

   `:spans` (#369) is a flat event stream keyed by the ray's FULL-width
   base column, not a per-column array — it can't compact by strided
   copy like the other six. Instead each event's `col` field is halved
   in place (`do-cast` casts one ray per TWO output columns, so a
   full-width base col j is always scene col j/2 - integer division,
   exact) so the scene-space row loop can index it the same way it
   indexes the px1 stream. d-corr / z0 / z1 / side / hx / hy / wallx
   pass through unchanged."
  [cast ^int svw]
  (let [{:keys [dists hits sides wallxs floordxs floordys spans]} cast
        d                                                         (php/array)
        h                                                         (php/array)
        s                                                         (php/array)
        w                                                         (php/array)
        fx                                                        (php/array)
        fy                                                        (php/array)
        sp                                                        (php/array)
        span-n                                                    (php/count spans)]
    (loop [i 0]
      (when (php/< i svw)
        (let [j (php/* 2 i)]
          (php/aset d i (php/aget dists j))
          (php/aset h i (php/aget hits j))
          (php/aset s i (php/aget sides j))
          (php/aset w i (php/aget wallxs j))
          (php/aset fx i (php/aget floordxs j))
          (php/aset fy i (php/aget floordys j)))
        (recur (php/+ i 1))))
    (loop [e 0]
      (when (php/< e span-n)
        (php/aset sp e (php/intdiv (php/aget spans e) 2))
        (loop [k 1]
          (when (php/< k 8)
            (php/aset sp (php/+ e k) (php/aget spans (php/+ e k)))
            (recur (php/+ k 1))))
        (recur (php/+ e 8))))
    {:dists d :hits h :sides s :wallxs w :floordxs fx :floordys fy :spans sp}))

(defn- frame-gradients
  "Memoized sky/floor gradient bundle for viewport height `vh` and look
   up/down shear `pr` (scene rows, default 0). Returns a map of the 6
   gradient arrays (normal + blood, shade + code twins), rebuilding only
   when `vh` OR `pr` changes (resize / pitch). Blood variants are always
   built here; the caller still gates their USE on the live `bloody?`
   flag. Keying on `pr` keeps the bundle input-determined (same vh + pr
   => same arrays), preserving frame->string's referential transparency;
   pr=0 reproduces the pre-pitch bundle byte-for-byte."
  [^int vh & [pr-arg]]
  (let [pr (or pr-arg 0)
        c  @gradient-cache]
    (if (and (php/=== vh (:vh c)) (php/=== pr (:pr c)))
      c
      (let [bundle {:vh             vh
                    :pr             pr
                    :sky            (build-horizon-gradient vh shade-table pr)
                    :sky-hb         (build-sky-halfblock vh shade-code-table pr)
                    :floor          (build-themed-gradient vh 239 true pr)
                    :sky-code       (build-horizon-gradient-codes vh shade-code-table pr)
                    :floor-code     (build-themed-gradient-codes vh 239 true pr)
                    :blood-sky      (build-horizon-gradient vh shade-table-blood pr)
                    :blood-sky-code (build-horizon-gradient-codes vh shade-code-table-blood pr)}]
        (reset! gradient-cache bundle)
        bundle))))

(defn- floor-gradient-full-for
  "Memoized full-resolution (terminal-height `vh`, no pitch shear) floor
   gradient for the weapon-sprite painter. In pixel-doubled mode the scene
   gradient is half-res, so the viewmodel needs its own vh-keyed gradient;
   `vh` changes only on resize, so the single-slot cache turns a per-frame
   rebuild into an O(1) hit. Output is byte-identical to the inline build."
  [^int vh]
  (let [c @floor-full-cache]
    (if (php/=== vh (:vh c))
      (:grad c)
      (let [g (build-themed-gradient vh 239 true)]
        (reset! floor-full-cache {:vh vh :grad g})
        g))))

(defn- emit-scene-px2
  "Pixel-doubled scene emitter (issue #350, Part B of #350's extraction
   from frame->string). Walks the half-res scene; each internal cell
   emits two output columns on TWO output rows. The sky / floor /
   wall-texture branches resolve their two vertical sub-samples into
   the row PAIR (upper row = top sub-sample, lower = bottom) instead
   of packing them into one ▀ cell, so vertical detail matches the
   half-block look at 2x the pixel size. Sprite cells spread their
   2x2 texel quad over the real 2x2 block (full sprite detail).
   Composite glyph cells (doors, edges, pickups) repeat verbatim.
   Solid BG cells run-length-coalesce like the px1 loop (cell + N
   spaces); composite cells push literally so glyphs survive the
   doubling. Upper row streams straight into `parts`; the lower row
   accumulates in `rowb` and is appended after the upper row's newline.

   PERF-CRITICAL SHAPE: same statement-position register discipline as
   emit-scene-px1 - a cond/and/let in a per-cell binding VALUE compiles
   to a closure copying the whole in-scope local set (~10us/cell). The
   cell's pack resolves through a local pack-reg, composite base cells
   through a local cell-reg; every remaining binding value is a pure
   expression. Buf-pushes stay in statement position (a push inside a
   binding value would land on an IIFE's array COPY and be silently
   lost). See docs/performance.md.

   `parts` and `center-cap` are php-arrays: PHP arrays pass by value
   across fn boundaries, so this fn returns `[parts center-cap]` and
   the caller MUST rebind both from the result (see the closure
   array-copy note in docs/performance.md)."
  ;; Param groups (order MUST match the call site in frame->string).
  ;; Phel has no named args; a swapped adjacent same-type param compiles
  ;; clean, so keep insertions inside their group.
  [parts center-cap                                       ; output bufs (returned, php-array by value)
   vw vh svw svh                                          ; viewport + scene dims
   sky-gradient sky-sub-codes floor-gradient blood-sky-gradient blood-cols  ; gradients
   floordxs floordys pfx pfy floor-dperp-sub floor-level-sub                ; floor-cast
   tops bots shades-normal shades-top-edge shades-bot-edge shades-top-shadow shades-bot-shadow  ; wall spans + shades
   shades-tex-u shades-tex-level shades-tex-px                              ; wall texture
   riser-top riser-bot riser-shade                                         ; risers (#370)
   mids lowers emask eheads ebodys elegss                                  ; enemy glyph rows
   e-stop e-sbot e-vtop e-vbot e-sx e-sxr e-spx e-sw e-sh e-fade           ; sprite window
   sprites-on bp-trc                                                       ; sprite/blood flags
   wsub-top wsub-bot wsub-mix wsub-skylim wsub-floorfrom                   ; wall sub-sample
   floor-flat? tex-fade-table bg-cell-cache                                ; fog + bg cache
   ;; seam group: consumed only via the non-hygienic `seam-shade!` macro
   ;; (frame_math.phel) which captures these by name - not "unused".
   floor-code-at seam-darken-16 seam-darken-8 seam-darken-5                ; seam shading (via seam-shade!)
   hits cap-sr cap-scl cap-bot? cap-right?                                 ; centre-cell capture
   mini-scol0 mini-srow-lo mini-srow-hi]                                   ; minimap window
  (let [cell-reg (php/array)
        pack-reg (php/array)]
    (dotimes [r2 svh]
      (let [row-bot?       (php/< (php/+ (php/* 2 r2) 1) vh)
            rowb           (buf-mk)
                ;; Row-constant hoists: sub-row indices, floor-cast row
                ;; terms, gradient rows, the packed sky sample (column-
                ;; independent!) and the minimap column limit.
            s4             (php/* 4 r2)
            s4b            (php/+ s4 1)
            s4c            (php/+ s4 2)
            s4d            (php/+ s4 3)
            sky-pack-row   (php/+ (php/* (php/+ (php/* (php/+ (php/* (php/aget sky-sub-codes s4) 256)
                                                              (php/aget sky-sub-codes s4b))
                                                       256)
                                                (php/aget sky-sub-codes s4c))
                                         256)
                                  (php/aget sky-sub-codes s4d))
            dp0            (php/aget floor-dperp-sub s4)
            dp1            (php/aget floor-dperp-sub s4b)
            dp2            (php/aget floor-dperp-sub s4c)
            dp3            (php/aget floor-dperp-sub s4d)
            ffade0         (php/aget tex-fade-table (php/aget floor-level-sub s4))
            ffade1         (php/aget tex-fade-table (php/aget floor-level-sub s4b))
            ffade2         (php/aget tex-fade-table (php/aget floor-level-sub s4c))
            ffade3         (php/aget tex-fade-table (php/aget floor-level-sub s4d))
            sky-r2         (buf-get sky-gradient r2)
            blood-sky-r2   (if blood-sky-gradient (buf-get blood-sky-gradient r2) nil)
            flr-r2         (buf-get floor-gradient r2)
            mini-slim      (if (and (php/>= r2 mini-srow-lo) (php/<= r2 mini-srow-hi)) mini-scol0 svw)
            cap-this-srow? (php/=== r2 cap-sr)
            rowbase2       (php/* r2 svw)]
        (loop [col 0 pa nil ra 0 pb nil rb 0]
          (if (php/>= col svw)
            (do (when (php/> ra 0)
                  (buf-push parts pa)
                  (buf-push parts (php/str_repeat (if (php/str_ends_with pa "▀") "▀" " ")
                                                  (php/- ra 1))))
                (when (php/> rb 0)
                  (buf-push rowb pb)
                  (buf-push rowb (php/str_repeat (if (php/str_ends_with pb "▀") "▀" " ")
                                                 (php/- rb 1)))))
            (let [mini?       (php/>= col mini-slim)
                  in-blood?   (if blood-sky-gradient
                                (php/> (buf-get blood-cols col) 0.4)
                                false)
                  tops-c      (buf-get tops col)
                  bots-c      (buf-get bots col)
                      ;; Plain wall hit (1) / no hit: shade cells are solid
                      ;; BG paints; doors (2-4, 9) + boss (5) carry glyphs.
                  plain?      (php/< (buf-get hits col) 2)
                      ;; Sub-row seam mixing (per-column data precomputed
                      ;; in build-wall-sub-bounds): textured, non-glyph-
                      ;; enemy columns place the wall top/bottom at
                      ;; half-row precision and mix sky / wall / floor
                      ;; codes inside the boundary cells' packs, so
                      ;; receding wall silhouettes step smoothly instead
                      ;; of in whole 2-row scene cells.
                  mixw?       (php/=== 1 (php/aget wsub-mix col))
                  sky-lim     (php/aget wsub-skylim col)
                  floor-from  (php/aget wsub-floorfrom col)
                      ;; Riser bounds (#370), scene-row precision - see
                      ;; emit-scene-px1 for the full rationale. Nil (dead)
                      ;; comparisons on a flat world; inlined aget, no
                      ;; per-cell function dispatch.
                  rtop2       (php/aget riser-top col)
                  has-riser2? (php/!== nil rtop2)
                  rbot2       (if has-riser2? (buf-get riser-bot col) 0)]
                  ;; Cell pack -> pack-reg[0], resolved by ONE statement
                  ;; cond: the split kinds (sky / floor texture / wall
                  ;; texture) sample all four vertical sub-texels and
                  ;; pack them base-256 (the same key shape as the
                  ;; halfblock cache). Negative values mark the
                  ;; composite kinds resolved below:
                  ;;   -1 minimap placeholder  -2 riser face (#370)
                  ;;   -3 sky flat (blood)     -4 floor flat
                  ;;   -5 enemy glyph zone      -6 top edge
                  ;;   -7 top shadow            -8 bot edge
                  ;;   -9 bot shadow            -10 wall flat
                  ;;   -11 tier-top floor (#370)
              (cond
                mini?
                (php/aset pack-reg 0 -1)
                (php/< r2 sky-lim)
                (if in-blood?
                  (php/aset pack-reg 0 -3)
                  (php/aset pack-reg 0 sky-pack-row))
                (if has-riser2? (if (php/>= r2 rtop2) (php/< r2 rbot2) false) false)
                (php/aset pack-reg 0 -2)
                (if has-riser2? (php/< r2 rtop2) false)
                (php/aset pack-reg 0 -11)
                (php/>= r2 (if has-riser2? rbot2 floor-from))
                (if (if in-blood? true floor-flat?)
                  (php/aset pack-reg 0 -4)
                  (let [fdx (buf-get floordxs col)
                        fdy (buf-get floordys col)
                        fx0 (php/+ pfx (php/* dp0 fdx))
                        fy0 (php/+ pfy (php/* dp0 fdy))
                        fx1 (php/+ pfx (php/* dp1 fdx))
                        fy1 (php/+ pfy (php/* dp1 fdy))
                        fx2 (php/+ pfx (php/* dp2 fdx))
                        fy2 (php/+ pfy (php/* dp2 fdy))
                        fx3 (php/+ pfx (php/* dp3 fdx))
                        fy3 (php/+ pfy (php/* dp3 fdy))
                        tc0 (php/aget floor-tex-px
                                      (php/+ (php/* (php/intval (php/* (php/- fy0 (php/floor fy0)) 64)) 64)
                                             (php/intval (php/* (php/- fx0 (php/floor fx0)) 64))))
                        tc1 (php/aget floor-tex-px
                                      (php/+ (php/* (php/intval (php/* (php/- fy1 (php/floor fy1)) 64)) 64)
                                             (php/intval (php/* (php/- fx1 (php/floor fx1)) 64))))
                        tc2 (php/aget floor-tex-px
                                      (php/+ (php/* (php/intval (php/* (php/- fy2 (php/floor fy2)) 64)) 64)
                                             (php/intval (php/* (php/- fx2 (php/floor fx2)) 64))))
                        tc3 (php/aget floor-tex-px
                                      (php/+ (php/* (php/intval (php/* (php/- fy3 (php/floor fy3)) 64)) 64)
                                             (php/intval (php/* (php/- fx3 (php/floor fx3)) 64))))]
                    (php/aset pack-reg 0
                              (php/+ (php/* (php/+ (php/* (php/+ (php/* (php/aget ffade0 tc0) 256)
                                                                 (php/aget ffade1 tc1))
                                                          256)
                                                   (php/aget ffade2 tc2))
                                            256)
                                     (php/aget ffade3 tc3)))))
                (if sprites-on false (buf-get emask col))
                (php/aset pack-reg 0 -5)
                (if mixw? false (php/=== r2 tops-c))
                (php/aset pack-reg 0 -6)
                (if mixw? false (php/=== r2 (php/+ tops-c 1)))
                (php/aset pack-reg 0 -7)
                (if mixw? false (php/=== r2 (php/- bots-c 1)))
                (php/aset pack-reg 0 -8)
                (if mixw? false (php/=== r2 (php/- bots-c 2)))
                (php/aset pack-reg 0 -9)
                    ;; Wall body / seam cell at sub-row precision.
                    ;; Interior cells (fully inside the wall) take
                    ;; the straight 4-sample path; only the one or
                    ;; two boundary cells per column pay the
                    ;; per-sub-row sky / wall / floor resolution
                    ;; (m0..m3 via pack-reg slots 1-4).
                mixw?
                (let [ts-sub (php/aget wsub-top col)
                      bs-sub (php/aget wsub-bot col)
                      whs    (php/max 1 (php/- bs-sub ts-sub))
                      u      (buf-get shades-tex-u col)
                      tpx    (buf-get shades-tex-px col)
                      fade   (php/aget tex-fade-table (buf-get shades-tex-level col))
                      rel    (php/- s4 ts-sub)]
                  (if (if (php/> rel 0) (php/< (php/+ s4 3) (php/- bs-sub 2)) false)
                    (php/aset pack-reg 0
                              (php/+ (php/* (php/+ (php/* (php/+ (php/* (php/aget fade (php/aget tpx (php/+ (php/* (php/min 63 (php/intdiv (php/* rel 64) whs)) 64) u))) 256)
                                                                 (php/aget fade (php/aget tpx (php/+ (php/* (php/min 63 (php/intdiv (php/* (php/+ rel 1) 64) whs)) 64) u))))
                                                          256)
                                                   (php/aget fade (php/aget tpx (php/+ (php/* (php/min 63 (php/intdiv (php/* (php/+ rel 2) 64) whs)) 64) u))))
                                            256)
                                     (php/aget fade (php/aget tpx (php/+ (php/* (php/min 63 (php/intdiv (php/* (php/+ rel 3) 64) whs)) 64) u)))))
                        ;; Seam accents: graduated dark border tracing
                        ;; the exact wall/floor + wall/sky diagonals -
                        ;; near-black wall base sub-row, dark sub-row
                        ;; above it, dark first floor sub-row, and a
                        ;; lighter lip at the sky seam. The four sub-row
                        ;; codes resolve into pack-reg slots 1-4 first.
                    (do
                      (seam-shade! 1 s4 rel)
                      (seam-shade! 2 s4b (php/+ rel 1))
                      (seam-shade! 3 s4c (php/+ rel 2))
                      (seam-shade! 4 s4d (php/+ rel 3))
                      (php/aset pack-reg 0
                                (php/+ (php/* (php/+ (php/* (php/+ (php/* (php/aget pack-reg 1) 256)
                                                                   (php/aget pack-reg 2))
                                                            256)
                                                     (php/aget pack-reg 3))
                                              256)
                                       (php/aget pack-reg 4))))))
                :else
                (php/aset pack-reg 0 -10))
                  ;; Composite kinds resolve their single base cell into
                  ;; cell-reg[0]; split kinds build their pair from the
                  ;; unpacked codes in the pure bindings below.
              (let [pack   (php/aget pack-reg 0)
                    split? (php/>= pack 0)]
                (when (php/< pack 0)
                  (cond
                    (php/=== pack -1)  (php/aset cell-reg 0 sky-r2)
                    (php/=== pack -2)  (php/aset cell-reg 0 (buf-get riser-shade col))
                    (php/=== pack -3)  (php/aset cell-reg 0 blood-sky-r2)
                        ;; Intentional alias: the blood floor reuses the
                        ;; blood sky row — one uniform red wash.
                    (php/=== pack -4)  (php/aset cell-reg 0 (if in-blood? blood-sky-r2 flr-r2))
                        ;; Tier-top floor (#370): same flat gradient the
                        ;; -4 case uses - see the px1 loop's rationale for
                        ;; not texturing this thin sliver yet.
                    (php/=== pack -11) (php/aset cell-reg 0 (if in-blood? blood-sky-r2 flr-r2))
                    (php/=== pack -5)  (cond
                                         (php/< r2 (buf-get mids col))
                                         (php/aset cell-reg 0 (buf-get eheads col))
                                         (php/< r2 (buf-get lowers col))
                                         (php/aset cell-reg 0 (buf-get ebodys col))
                                         :else
                                         (php/aset cell-reg 0 (buf-get elegss col)))
                    (php/=== pack -6)  (php/aset cell-reg 0 (buf-get shades-top-edge col))
                    (php/=== pack -7)  (php/aset cell-reg 0 (buf-get shades-top-shadow col))
                    (php/=== pack -8)  (php/aset cell-reg 0 (buf-get shades-bot-edge col))
                    (php/=== pack -9)  (php/aset cell-reg 0 (buf-get shades-bot-shadow col))
                    :else              (php/aset cell-reg 0 (buf-get shades-normal col))))
                (let [;; Unpack the 4 vertical sub-samples and compose
                          ;; the row pair as half-block cells: full vertical
                          ;; colour fidelity (2 sub-pixels per output row,
                          ;; same as the full-detail ▀ path), only
                          ;; horizontal is doubled.
                      sp3      (php/% pack 256)
                      spq1     (php/intdiv pack 256)
                      sp2      (php/% spq1 256)
                      spq2     (php/intdiv spq1 256)
                      sp1      (php/% spq2 256)
                      sp0      (php/intdiv spq2 256)
                      base-a   (if split? (halfblock sp0 sp1) (php/aget cell-reg 0))
                      base-b   (if split? (halfblock sp2 sp3) (php/aget cell-reg 0))
                          ;; Solid = safe to run-length-coalesce with space
                          ;; continuation (pure BG paint, no glyph). Shadows +
                          ;; flat wall shades are solid only on plain wall hits
                          ;; (door columns carry the ▌ glyph cell there).
                      base-sl? (if split?
                                 true
                                 (if (php/=== pack -1)
                                   true
                                   (if (php/=== pack -2)
                                     true
                                     (if (php/=== pack -3)
                                       true
                                       (if (php/=== pack -4)
                                         true
                                         (if (php/=== pack -11)
                                           true
                                           (if (php/=== pack -7)
                                             plain?
                                             (if (php/=== pack -9)
                                               plain?
                                               (if (php/=== pack -10) plain? false)))))))))
                          ;; Overlay merge: tracer/pickup buffer wins the whole
                          ;; block; a sprite quad overrides per quadrant with
                          ;; transparent texels keeping the base pair.
                      bp-cell  (if mini? nil (buf-get bp-trc (php/+ rowbase2 col)))
                      quad     (if mini?
                                 nil
                                 (if bp-cell
                                   nil
                                   (if sprites-on
                                     (if (buf-get emask col)
                                           ;; #302: gate on the VISIBLE window
                                           ;; (e-vtop/e-vbot) but sample against
                                           ;; the FULL box (e-stop/e-sbot) so a
                                           ;; tier-clipped sprite crops, not squishes.
                                       (if (php/>= r2 (buf-get e-vtop col))
                                         (if (php/< r2 (buf-get e-vbot col))
                                           (enemy-sprite-quad
                                            (buf-get e-spx col) (buf-get e-sw col) (buf-get e-sh col)
                                            (buf-get e-sx col) (buf-get e-sxr col)
                                            (buf-get e-stop col) (buf-get e-sbot col) r2
                                            (buf-get e-fade col))
                                           nil)
                                         nil)
                                       nil)
                                     nil)))
                      qa1      (if quad (php/aget quad 0) nil)
                      qa2      (if quad (php/aget quad 1) nil)
                      qb1      (if quad (php/aget quad 2) nil)
                      qb2      (if quad (php/aget quad 3) nil)
                      a1       (if bp-cell
                                 bp-cell
                                 (if quad
                                   (if (php/=== qa1 -1) base-a (php/aget bg-cell-cache qa1))
                                   base-a))
                      a2       (if bp-cell
                                 bp-cell
                                 (if quad
                                   (if (php/=== qa2 -1) base-a (php/aget bg-cell-cache qa2))
                                   base-a))
                      b1       (if bp-cell
                                 bp-cell
                                 (if quad
                                   (if (php/=== qb1 -1) base-b (php/aget bg-cell-cache qb1))
                                   base-b))
                      b2       (if bp-cell
                                 bp-cell
                                 (if quad
                                   (if (php/=== qb2 -1) base-b (php/aget bg-cell-cache qb2))
                                   base-b))
                      sa?      (if bp-cell
                                 false
                                 (if quad
                                   (if (php/=== qa1 -1)
                                     (if (php/=== qa2 -1) base-sl? false)
                                     (if (php/!== qa2 -1) true false))
                                   base-sl?))
                      sb?      (if bp-cell
                                 false
                                 (if quad
                                   (if (php/=== qb1 -1)
                                     (if (php/=== qb2 -1) base-sl? false)
                                     (if (php/!== qb2 -1) true false))
                                   base-sl?))
                      dbl?     (php/< (php/+ (php/* 2 col) 1) vw)
                      n-out    (if dbl? 2 1)
                      match-a? (if sa? (if (php/=== a1 a2) (php/=== a1 pa) false) false)
                      run-a?   (if sa? (php/=== a1 a2) false)
                      match-b? (if row-bot?
                                 (if sb? (if (php/=== b1 b2) (php/=== b1 pb) false) false)
                                 false)
                      run-b?   (if row-bot? (if sb? (php/=== b1 b2) false) false)]
                      ;; Stash the real rendered quadrant under the
                      ;; crosshair (same contract as the px1 capture).
                  (when cap-this-srow?
                    (when (php/=== col cap-scl)
                      (php/aset center-cap 0
                                (if cap-bot?
                                  (if cap-right? b2 b1)
                                  (if cap-right? a2 a1)))))
                      ;; RLE step (pushes in statement position; the
                      ;; not-match guards nest as statement ifs so no
                      ;; and-form lands in expression position).
                  (if match-a?
                    nil
                    (do
                      (when (php/> ra 0)
                        (buf-push parts pa)
                        (buf-push parts (php/str_repeat (if (php/str_ends_with pa "▀") "▀" " ")
                                                        (php/- ra 1))))
                      (if run-a?
                        nil
                        (do
                          (buf-push parts a1)
                          (when dbl? (buf-push parts a2))))))
                  (when row-bot?
                    (if match-b?
                      nil
                      (do
                        (when (php/> rb 0)
                          (buf-push rowb pb)
                          (buf-push rowb (php/str_repeat (if (php/str_ends_with pb "▀") "▀" " ")
                                                         (php/- rb 1))))
                        (if run-b?
                          nil
                          (do
                            (buf-push rowb b1)
                            (when dbl? (buf-push rowb b2)))))))
                  (recur (php/+ col 1)
                         (if match-a? pa (if run-a? a1 nil))
                         (if match-a? (php/+ ra n-out) (if run-a? n-out 0))
                         (if match-b? pb (if run-b? b1 nil))
                         (if match-b? (php/+ rb n-out) (if run-b? n-out 0))))))))
        (buf-push parts "\e[0m\n")
        (when row-bot?
          (buf-push parts (php/implode "" rowb))
          (buf-push parts "\e[0m\n"))))
    [parts center-cap]))

(defn- emit-scene-px1
  "Full-detail (px1) row loop emitter (issue #350, Part B of #350's
   extraction from frame->string).

   PERF-CRITICAL SHAPE: inside the per-cell loop every binding value
   is a PURE expression and the cell resolves through conds in
   STATEMENT position writing into a local `cell-reg` (read back with
   one aget for the RLE step). A statement-form (cond / and / let) in
   a binding VALUE compiles to a per-cell PHP closure copying the
   whole in-scope local set - that closure overhead WAS ~85% of the
   render cost. Keep any new per-cell logic in statement position.
   See docs/performance.md.

   `parts` and `center-cap` are php-arrays: PHP arrays pass by value
   across fn boundaries, so this fn returns `[parts center-cap]` and
   the caller MUST rebind both from the result (see the closure
   array-copy note in docs/performance.md)."
  ;; Param groups (order MUST match the call site in frame->string).
  ;; Phel has no named args; a swapped adjacent same-type param compiles
  ;; clean, so keep insertions inside their group.
  [parts center-cap                                       ; output bufs (returned, php-array by value)
   vw vh                                                  ; viewport dims
   sky-gradient sky-sub-codes floor-gradient blood-sky-gradient blood-cols  ; gradients
   floordxs floordys pfx pfy floor-dperp-sub floor-level-sub                ; floor-cast
   tops bots shades-normal shades-top-edge shades-bot-edge shades-top-shadow shades-bot-shadow  ; wall spans + shades
   shades-tex-u shades-tex-level shades-tex-px                              ; wall texture
   riser-top riser-bot riser-shade                                         ; risers (#370)
   mids lowers emask eheads ebodys elegss                                  ; enemy glyph rows
   e-stop e-sbot e-vtop e-vbot e-sx e-sxr e-spx e-sw e-sh e-fade           ; sprite window
   sprites-on bp-trc                                                       ; sprite/blood flags
   wsub-top wsub-bot wsub-mix wsub-skylim wsub-floorfrom                   ; wall sub-sample
   floor-flat? tex-fade-table bg-cell-cache                                ; fog + bg cache
   sky-hb tex-on? subpixel? quad? flat-walltex?                            ; px1 render-mode flags
   floor-dperp floor-level                                                 ; floor-cast (whole-row)
   mini-col0 mini-row-lo mini-row-hi                                       ; minimap window
   cap-col cap-row                                                         ; centre-cell capture
   ;; seam group: consumed only via the non-hygienic `seam-shade!` macro
   ;; (frame_math.phel) which captures these by name - not "unused".
   floor-code-at seam-darken-16 seam-darken-8 seam-darken-5 ftab hb]       ; seam shading (via seam-shade!) + fade tables
  (let [cell-reg (php/array)
        pack-reg (php/array)]
    (dotimes [row vh]
      (let [;; Row-constant hoists: gradient rows, floor-cast row
                ;; terms and the minimap column limit don't vary by
                ;; column — resolve once per row, not per cell.
            sky-plain     (buf-get sky-gradient row)
            flr-plain     (buf-get floor-gradient row)
            sky-hb-row    (buf-get sky-hb row)
            blood-sky-row (if blood-sky-gradient (buf-get blood-sky-gradient row) nil)
                ;; Intentional alias (same as the gradient pair): blood
                ;; floor = blood sky, one uniform red wash.
            blood-flr-row blood-sky-row
            rowbase       (php/* row vw)
            mini-lim      (if (and (php/>= row mini-row-lo) (php/<= row mini-row-hi)) mini-col0 vw)
            cap-this-row? (php/=== row cap-row)
            s-top         (php/* 2 row)
            s-bot         (php/+ s-top 1)
            dpt           (php/aget floor-dperp-sub s-top)
            dpb           (php/aget floor-dperp-sub s-bot)
            flr-fade-top  (php/aget ftab (php/aget floor-level-sub s-top))
            flr-fade-bot  (php/aget ftab (php/aget floor-level-sub s-bot))
            dp-cell       (buf-get floor-dperp row)
            flr-fade-cell (php/aget ftab (buf-get floor-level row))]
        (loop [col 0 prev nil run 0]
          (if (php/>= col vw)
            (when (php/> run 0)
              (buf-push parts prev)
              (buf-push parts (php/str_repeat " " (php/- run 1))))
            (do
                  ;; Resolve this cell into cell-reg[0]: base kind first
                  ;; (sky / floor / glyph zones / edges / wall body),
                  ;; then the sprite + blood-paint overlays overwrite in
                  ;; priority order (blood-paint > sprite > base).
                  ;; Minimap-covered cells skip it all — the blit
                  ;; overdraws them, so they emit the sky row.
              (let [in-blood? (if blood-sky-gradient
                                (php/> (buf-get blood-cols col) 0.4)
                                false)]
                (if (php/>= col mini-lim)
                  (php/aset cell-reg 0 (if in-blood? blood-sky-row sky-plain))
                  (let [top        (buf-get tops col)
                        bot        (buf-get bots col)
                            ;; Sub-row seam mixing (see build-wall-sub-
                            ;; bounds): textured, non-glyph-enemy columns
                            ;; place the wall top/bottom at half-row
                            ;; precision and mix sky / wall / floor codes
                            ;; inside the boundary ▀ cells, so receding
                            ;; wall silhouettes step in half-row diagonals
                            ;; instead of whole-cell stairs. The sky/floor
                            ;; limits come from wsub only on mix columns —
                            ;; the wsub fallbacks predate the enemy zone
                            ;; pass, so glyph-enemy columns must keep the
                            ;; live tops/bots.
                        mixw?      (php/=== 1 (php/aget wsub-mix col))
                            ;; Riser bounds (#370): `riser-top` is empty on a
                            ;; flat world, so this aget is nil for every
                            ;; column and the two cond clauses below are dead
                            ;; comparisons - no new branch cost on the
                            ;; byte-identical flat path. Inlined aget (not a
                            ;; `riser-top-at` call) so the hot per-cell path
                            ;; pays no function dispatch.
                        rtop       (php/aget riser-top col)
                        has-riser? (php/!== nil rtop)
                        rbot       (if has-riser? (buf-get riser-bot col) 0)]
                    (cond
                          ;; Half-block sky stacks two gradient sub-rows
                          ;; per cell (2× vertical). Blood columns keep
                          ;; the flat red wash.
                      (php/< row (if mixw? (php/aget wsub-skylim col) top))
                      (php/aset cell-reg 0 (if in-blood?
                                             blood-sky-row
                                             (if subpixel? sky-hb-row sky-plain)))
                          ;; Riser face (#370): the step's rise, painted
                          ;; like a wall using the pre-shaded EW colour
                          ;; from compute-riser-shades. Nearest riser only
                          ;; (compute-riser-shades already dropped farther
                          ;; ones in this column) so this IS the row clip -
                          ;; nothing behind it competes for these rows.
                      (if has-riser? (if (php/>= row rtop) (php/< row rbot) false) false)
                      (php/aset cell-reg 0 (buf-get riser-shade col))
                          ;; Tier-top floor (#370): the raised tier's own
                          ;; ground, visible in the thin band between the
                          ;; far wall's bottom and the riser's top. Reuses
                          ;; the flat floor gradient (untextured) rather
                          ;; than a second textured floor-cast pass - see
                          ;; docs/rendering.md for why texturing this
                          ;; sliver isn't worth the per-cell cost yet.
                      (if has-riser? (php/< row rtop) false)
                      (php/aset cell-reg 0 (if in-blood? blood-flr-row flr-plain))
                          ;; Floor: cast the ground plane and sample the
                          ;; stone texture. Player + per-row perp-distance
                          ;; × the column's floor basis gives the world
                          ;; floor point; frac → texture (u, v); fog by
                          ;; the row's floor level. Blood-band columns +
                          ;; the flat-floor flag keep the grey gradient.
                      (php/>= row (if has-riser? rbot (if mixw? (php/aget wsub-floorfrom col) bot)))
                      (if (if in-blood? true floor-flat?)
                        (php/aset cell-reg 0 (if in-blood? blood-flr-row flr-plain))
                        (if (and subpixel? (not flat-walltex?))
                          (if quad?
                              ;; Quad floor: 2×2 ground texels per cell at
                              ;; sub-column precision (the per-column cast has
                              ;; no sub-column ray, so the left/right basis is
                              ;; lerped 0.25 toward each neighbour). Collapses
                              ;; to the ▀ cell when left==right so flat / far
                              ;; floor still RLE-coalesces; quadblock only fires
                              ;; where the extra horizontal detail is real.
                            (let [fdx  (buf-get floordxs col)
                                  fdy  (buf-get floordys col)
                                  fdxl (if (php/> col 0)
                                         (php/+ (php/* 0.75 fdx) (php/* 0.25 (buf-get floordxs (php/- col 1)))) fdx)
                                  fdyl (if (php/> col 0)
                                         (php/+ (php/* 0.75 fdy) (php/* 0.25 (buf-get floordys (php/- col 1)))) fdy)
                                  fdxr (if (php/< col (php/- vw 1))
                                         (php/+ (php/* 0.75 fdx) (php/* 0.25 (buf-get floordxs (php/+ col 1)))) fdx)
                                  fdyr (if (php/< col (php/- vw 1))
                                         (php/+ (php/* 0.75 fdy) (php/* 0.25 (buf-get floordys (php/+ col 1)))) fdy)
                                  fxtl (php/+ pfx (php/* dpt fdxl)) fytl (php/+ pfy (php/* dpt fdyl))
                                  fxtr (php/+ pfx (php/* dpt fdxr)) fytr (php/+ pfy (php/* dpt fdyr))
                                  fxbl (php/+ pfx (php/* dpb fdxl)) fybl (php/+ pfy (php/* dpb fdyl))
                                  fxbr (php/+ pfx (php/* dpb fdxr)) fybr (php/+ pfy (php/* dpb fdyr))
                                  ftl  (php/aget flr-fade-top (php/aget floor-tex-px (php/+ (php/* (php/intval (php/* (php/- fytl (php/floor fytl)) 64)) 64) (php/intval (php/* (php/- fxtl (php/floor fxtl)) 64)))))
                                  ftr  (php/aget flr-fade-top (php/aget floor-tex-px (php/+ (php/* (php/intval (php/* (php/- fytr (php/floor fytr)) 64)) 64) (php/intval (php/* (php/- fxtr (php/floor fxtr)) 64)))))
                                  fbl  (php/aget flr-fade-bot (php/aget floor-tex-px (php/+ (php/* (php/intval (php/* (php/- fybl (php/floor fybl)) 64)) 64) (php/intval (php/* (php/- fxbl (php/floor fxbl)) 64)))))
                                  fbr  (php/aget flr-fade-bot (php/aget floor-tex-px (php/+ (php/* (php/intval (php/* (php/- fybr (php/floor fybr)) 64)) 64) (php/intval (php/* (php/- fxbr (php/floor fxbr)) 64)))))]
                              (php/aset cell-reg 0
                                        (if (if (php/=== ftl ftr) (php/=== fbl fbr) false)
                                          (hb ftl fbl)
                                          (quadblock ftl ftr fbl fbr))))
                              ;; Half-block floor: two stacked ground
                              ;; samples (top sub-row = farther) packed
                              ;; into one ▀ cell. flat-walltex? (the Fast
                              ;; render setting) drops to the single-sample
                              ;; flat cell below, halving floor texel work.
                            (let [fdx (buf-get floordxs col)
                                  fdy (buf-get floordys col)
                                  fxt (php/+ pfx (php/* dpt fdx))
                                  fyt (php/+ pfy (php/* dpt fdy))
                                  fxb (php/+ pfx (php/* dpb fdx))
                                  fyb (php/+ pfy (php/* dpb fdy))
                                  txt (php/intval (php/* (php/- fxt (php/floor fxt)) 64))
                                  tyt (php/intval (php/* (php/- fyt (php/floor fyt)) 64))
                                  txb (php/intval (php/* (php/- fxb (php/floor fxb)) 64))
                                  tyb (php/intval (php/* (php/- fyb (php/floor fyb)) 64))
                                  tct (php/aget floor-tex-px (php/+ (php/* tyt 64) txt))
                                  tcb (php/aget floor-tex-px (php/+ (php/* tyb 64) txb))]
                              (php/aset cell-reg 0
                                        (hb (php/aget flr-fade-top tct)
                                            (php/aget flr-fade-bot tcb)))))
                          (let [fx (php/+ pfx (php/* dp-cell (buf-get floordxs col)))
                                fy (php/+ pfy (php/* dp-cell (buf-get floordys col)))
                                tx (php/intval (php/* (php/- fx (php/floor fx)) 64))
                                ty (php/intval (php/* (php/- fy (php/floor fy)) 64))
                                tc (php/aget floor-tex-px (php/+ (php/* ty 64) tx))]
                            (php/aset cell-reg 0
                                      (paint-bg (php/aget flr-fade-cell tc))))))
                          ;; Glyph-mode enemy zones (sprite mode skips so
                          ;; the real wall resolves behind the billboard).
                      (if sprites-on false (buf-get emask col))
                      (cond
                        (php/< row (buf-get mids col))
                        (php/aset cell-reg 0 (buf-get eheads col))
                        (php/< row (buf-get lowers col))
                        (php/aset cell-reg 0 (buf-get ebodys col))
                        :else
                        (php/aset cell-reg 0 (buf-get elegss col)))
                          ;; Whole-cell edge + shadow bands only on
                          ;; non-mix columns; mix columns trace the seam
                          ;; at sub-row precision below instead.
                      (if mixw? false (php/=== row top))
                      (php/aset cell-reg 0 (buf-get shades-top-edge col))
                      (if mixw? false (php/=== row (php/+ top 1)))
                      (php/aset cell-reg 0 (buf-get shades-top-shadow col))
                      (if mixw? false (php/=== row (php/- bot 1)))
                      (php/aset cell-reg 0 (buf-get shades-bot-edge col))
                      (if mixw? false (php/=== row (php/- bot 2)))
                      (php/aset cell-reg 0 (buf-get shades-bot-shadow col))
                          ;; Wall body / seam cell. Mix columns sample
                          ;; the wall texture against the SUB-row bounds:
                          ;; interior cells take the straight two-sample
                          ;; path; the one or two boundary cells per
                          ;; column resolve each ▀ sub-row as sky / wall
                          ;; / floor with the graduated dark seam accents
                          ;; (same mixer as the pixel-doubled emitter,
                          ;; sub-row codes via pack-reg slots 1-2).
                          ;; Non-mix textured columns keep the cell-bound
                          ;; sampling; tex-level < 0 (boss door / blood
                          ;; column, or textures disabled) falls back to
                          ;; the flat shade. Door columns sample the
                          ;; amber door texture via the same path
                          ;; (per-column texel array in shades-tex-px).
                      :else
                      (if mixw?
                        (let [ts-sub (php/aget wsub-top col)
                              bs-sub (php/aget wsub-bot col)
                              whs    (php/max 1 (php/- bs-sub ts-sub))
                              u      (buf-get shades-tex-u col)
                              tpx    (buf-get shades-tex-px col)
                              fade   (php/aget tex-fade-table (buf-get shades-tex-level col))
                              s2     (php/* 2 row)
                              s2b    (php/+ s2 1)
                              rel    (php/- s2 ts-sub)]
                          (if (if (php/> rel 0) (php/< s2b (php/- bs-sub 2)) false)
                                ;; Wall INTERIOR (fully inside the wall). flat-walltex?
                                ;; (crisp-edge prototype) paints it as one flat cell from
                                ;; a single texel - the seam/silhouette cells below keep
                                ;; their sub-pixel resolution, so only the interior texture
                                ;; loses vertical half-row detail. Default: 2-sample ▀.
                            (if flat-walltex?
                              (php/aset cell-reg 0
                                        (php/aget bg-cell-cache (php/aget fade (php/aget tpx (php/+ (php/* (php/min 63 (php/intdiv (php/* rel 64) whs)) 64) u)))))
                              (php/aset cell-reg 0
                                        (halfblock (php/aget fade (php/aget tpx (php/+ (php/* (php/min 63 (php/intdiv (php/* rel 64) whs)) 64) u)))
                                                   (php/aget fade (php/aget tpx (php/+ (php/* (php/min 63 (php/intdiv (php/* (php/+ rel 1) 64) whs)) 64) u))))))
                            (if quad?
                                  ;; Quad silhouette AA: sample the wall edge at
                                  ;; TWO sub-columns (bounds lerped 0.25 toward
                                  ;; each neighbour — the per-column cast has no
                                  ;; sub-column ray) × the two sub-rows, tag each
                                  ;; of the 2×2 as sky / wall / floor, and emit the
                                  ;; quadrant glyph, so a receding wall edge steps
                                  ;; in half-CELL diagonals instead of whole
                                  ;; columns. Wall colour is column-stable (edge
                                  ;; AA, not texture sub-detail); collapses to ▀
                                  ;; when the edge doesn't split the cell.
                              (let [tlb  (if (php/> col 0) (php/aget wsub-top (php/- col 1)) ts-sub)
                                    trb  (if (php/< col (php/- vw 1)) (php/aget wsub-top (php/+ col 1)) ts-sub)
                                    blb  (if (php/> col 0) (php/aget wsub-bot (php/- col 1)) bs-sub)
                                    brb  (if (php/< col (php/- vw 1)) (php/aget wsub-bot (php/+ col 1)) bs-sub)
                                        ;; Fractional on purpose: the half-cell
                                        ;; edge offset is sub-integer, so rounding
                                        ;; to whole sub-rows would snap back to
                                        ;; ts/bs and never split the cell. Compare
                                        ;; the integer sub-row directly against the
                                        ;; lerped float edge so it straddles.
                                    ts-l (php/+ (php/* 0.75 ts-sub) (php/* 0.25 tlb))
                                    ts-r (php/+ (php/* 0.75 ts-sub) (php/* 0.25 trb))
                                    bs-l (php/+ (php/* 0.75 bs-sub) (php/* 0.25 blb))
                                    bs-r (php/+ (php/* 0.75 bs-sub) (php/* 0.25 brb))
                                    wc2  (php/aget fade (php/aget tpx (php/+ (php/* (php/min 63 (php/max 0 (php/intdiv (php/* rel 64) whs))) 64) u)))
                                    wl2  (if (php/>= s2 (php/- bs-sub 1)) (php/aget seam-darken-16 wc2)
                                             (if (php/>= s2 (php/- bs-sub 2)) (php/aget seam-darken-8 wc2)
                                                 (if (php/=== s2 ts-sub) (php/aget seam-darken-5 wc2) wc2)))
                                    wc2b (php/aget fade (php/aget tpx (php/+ (php/* (php/min 63 (php/max 0 (php/intdiv (php/* (php/+ rel 1) 64) whs))) 64) u)))
                                    wl2b (if (php/>= s2b (php/- bs-sub 1)) (php/aget seam-darken-16 wc2b)
                                             (if (php/>= s2b (php/- bs-sub 2)) (php/aget seam-darken-8 wc2b)
                                                 (if (php/=== s2b ts-sub) (php/aget seam-darken-5 wc2b) wc2b)))
                                    sk2  (php/aget sky-sub-codes s2)
                                    sk2b (php/aget sky-sub-codes s2b)
                                    fl2  (floor-code-at s2 col)
                                    fl2b (floor-code-at s2b col)
                                    qtl  (if (php/< s2 ts-l) sk2 (if (php/>= s2 bs-l) fl2 wl2))
                                    qtr  (if (php/< s2 ts-r) sk2 (if (php/>= s2 bs-r) fl2 wl2))
                                    qbl  (if (php/< s2b ts-l) sk2b (if (php/>= s2b bs-l) fl2b wl2b))
                                    qbr  (if (php/< s2b ts-r) sk2b (if (php/>= s2b bs-r) fl2b wl2b))]
                                (php/aset cell-reg 0
                                          (if (if (php/=== qtl qtr) (php/=== qbl qbr) false)
                                            (hb qtl qbl)
                                            (quadblock qtl qtr qbl qbr))))
                                ;; Seam accents: graduated dark border
                                ;; tracing the exact wall/floor + wall/sky
                                ;; diagonals - near-black wall base
                                ;; sub-row, dark sub-row above it, dark
                                ;; first floor sub-row, and a lighter lip
                                ;; at the sky seam.
                              (do
                                (seam-shade! 1 s2 rel)
                                (seam-shade! 2 s2b (php/+ rel 1))
                                (php/aset cell-reg 0
                                          (halfblock (php/aget pack-reg 1) (php/aget pack-reg 2)))))))
                        (let [lvl (buf-get shades-tex-level col)]
                          (if (if tex-on? (php/>= lvl 0) false)
                            (if subpixel?
                                  ;; Half-block wall: two V samples down
                                  ;; the column (same U, same fog level)
                                  ;; stacked into one ▀ cell.
                              (let [wh   (php/max 1 (php/- bot top))
                                    u    (buf-get shades-tex-u col)
                                    tpx  (buf-get shades-tex-px col)
                                    rel2 (php/* 2 (php/- row top))
                                    tvt  (php/min 63 (php/intdiv (php/* rel2 32) wh))
                                    tvb  (php/min 63 (php/intdiv (php/* (php/+ rel2 1) 32) wh))
                                    fade (php/aget tex-fade-table lvl)]
                                (php/aset cell-reg 0
                                          (halfblock (php/aget fade (php/aget tpx (php/+ (php/* tvt 64) u)))
                                                     (php/aget fade (php/aget tpx (php/+ (php/* tvb 64) u))))))
                              (let [wh   (php/max 1 (php/- bot top))
                                    tv   (php/min 63 (php/intdiv (php/* (php/- row top) 64) wh))
                                    tc   (php/aget (buf-get shades-tex-px col)
                                                   (php/+ (php/* tv 64) (buf-get shades-tex-u col)))
                                    fade (php/aget tex-fade-table lvl)]
                                (php/aset cell-reg 0
                                          (php/aget bg-cell-cache (php/aget fade tc)))))
                            (php/aset cell-reg 0 (buf-get shades-normal col))))))
                        ;; Sprite overlay: the sampled Freedoom pixel
                        ;; replaces the base cell; transparent pixels
                        ;; keep it (wall/floor shows through).
                    (when sprites-on
                      (when (buf-get emask col)
                            ;; #302: gate on the VISIBLE window (e-vtop/e-vbot)
                            ;; but sample against the FULL box (e-stop/e-sbot) so
                            ;; a tier-clipped sprite crops rather than squishes.
                        (when (php/>= row (buf-get e-vtop col))
                          (when (php/< row (buf-get e-vbot col))
                            (let [sc (enemy-sprite-cell
                                      (buf-get e-spx col) (buf-get e-sw col) (buf-get e-sh col)
                                      (buf-get e-sx col) (buf-get e-sxr col)
                                      (buf-get e-stop col) (buf-get e-sbot col) row
                                      (buf-get e-fade col))]
                              (when sc (php/aset cell-reg 0 sc)))))))
                        ;; Blood-paint decal wins over sprite + base.
                    (let [bp (buf-get bp-trc (php/+ rowbase col))]
                      (when bp (php/aset cell-reg 0 bp))))))
                  ;; Stash the real rendered cell under the crosshair so
                  ;; the reticle BG matches it exactly (one cell/frame).
              (when cap-this-row?
                (when (php/=== col cap-col)
                  (php/aset center-cap 0 (php/aget cell-reg 0))))
              (let [c (php/aget cell-reg 0)]
                (cond
                  (php/=== run 0)  (recur (php/+ col 1) c 1)
                  (php/=== c prev) (recur (php/+ col 1) prev (php/+ run 1))
                  :else            (do
                                     (buf-push parts prev)
                                     (buf-push parts (php/str_repeat " " (php/- run 1)))
                                     (recur (php/+ col 1) c 1))))))))
      (buf-push parts "\e[0m\n"))
    [parts center-cap]))

(defn frame->string
  "Render the world sized to cols x rows. Walls project at a constant
   scale (proj-dist from engine) with a 2:1 character-aspect correction,
   so resizing the terminal widens the FOV instead of growing the walls.
   Minimap is overlaid top-right when (:show-map world) is truthy."
  [world stats cols rows]
  (let [{:keys [vw vh map-col map-row map-step map-mw]}
        (layout cols rows (count (first (:grid world))) stats)
        ;; Pixel-doubled mode (auto-picked by the game loop on machines
        ;; where full detail can't hold a smooth framerate): the SCENE
        ;; renders at half resolution (svw × svh, the view a half-size
        ;; terminal would show) and each scene cell paints a 2×2
        ;; terminal block, quartering the per-cell render cost while
        ;; still filling the whole terminal. Text/HUD overlays keep
        ;; full-resolution coordinates. px-sc scales scene-coordinate
        ;; painters (door face, glyph-mode enemy faces) back to
        ;; terminal coordinates.
        px2?                               (boolean (get stats :px2?))
        px-sc                              (if px2? 2 1)
        svw                                (if px2? (php/intdiv (php/+ vw 1) 2) vw)
        svh                                (if px2? (php/intdiv (php/+ vh 1) 2) vh)
        ;; Look up/down camera pitch -> integer horizon shear in SCENE
        ;; rows. Computed once; threaded into every horizon=svh/2 site
        ;; (wall tops, sub-row seam bounds, floor-cast tables, sky/floor
        ;; gradients, sprite anchors) so the whole scene shears together.
        ;; pr=0 (default, no pitch) leaves every site at its original
        ;; centre, so the render is byte-identical to the no-pitch path.
        ;; POSITIVE pitch (look up) => POSITIVE pr => band slides DOWN.
        pr                                 (pitch-rows (or (:pitch (:player world)) 0.0) svh)
        ;; Sub-row twin: the half-block sky / floor-cast tables index at
        ;; 2 sub-rows per SCENE row at full detail and 2 per PASSED-vh row
        ;; in px2 (where the table is built at 2·svh). They scale `pr` by
        ;; 2 internally, so a px2 scene-row shift needs 2·pr handed in to
        ;; land 4 sub-rows per scene cell - matching the n=4 wall bounds.
        pr-sub                             (if px2? (php/* 2 pr) pr)
        ;; Full-resolution pitch shear (rows): the HP-flash overlay floats
        ;; at terminal resolution (vh, not svh), so it tracks the sprite
        ;; head using the vh-scaled offset.
        pr-full                            (pitch-rows (or (:pitch (:player world)) 0.0) vh)
        bloody?                            (php/> (or (get stats :iframes) 0.0) 0.0)
        ;; Walls + sky + floor are ALL pure grayscale: enemy colours
        ;; pop against neutral stonework, and far walls fade toward
        ;; near-black (shade-table[0] = code 232) like an unseen
        ;; horizon. No per-level wall tinting; level distinction comes
        ;; from enemy sprites + intro splash + audio.
        stbl                               shade-table
        ;; Sky/floor gradients (+ blood + code twins) are memoized by the
        ;; SCENE height (see frame-gradients); the per-frame rebuild is
        ;; gone. In pixel-doubled mode every scene-side consumer keys off
        ;; svh, so the memo stays single-keyed and stable across frames.
        grads                              (frame-gradients svh pr)
        sky-gradient                       (:sky grads)
        ;; Half-block sky: per-row ▀ cell stacking two sub-rows of the
        ;; horizon gradient (2× vertical smoothness). Row-constant, so it
        ;; still RLE-coalesces. Used when subpixel? is on (blood keeps the
        ;; flat red gradient).
        sky-hb                             (:sky-hb grads)
        ;; Raw sub-row sky codes: the same gradient curve as sky-hb left
        ;; unpacked. The pixel-doubled emitter paints sub-row 2r on the
        ;; upper output row and 2r+1 on the lower as two solid cells;
        ;; the full-detail seam mixer blends the code at a wall-top
        ;; boundary sub-row into its ▀ cell. Sized to the path's
        ;; sub-row space (4 per scene cell in px2, 2 per cell in px1).
        sky-sub-codes                      (build-sky-codes-sub (if px2? (php/* 2 svh) svh) shade-code-table pr-sub)
        ;; Floor: same grey gradient with subtle tile banding (odd
        ;; rows one fade step darker).
        floor-gradient                     (:floor grads)
        ;; Pre-baked red gradients used when a column sits inside the
        ;; blood band: sky + floor go red for those cols so the band
        ;; reads as a coherent red corner, not red walls floating in a
        ;; grey ceiling. nil unless bloody? so the inner row loop
        ;; short-circuits the blood swap (the cache always holds them;
        ;; the bloody? gate keeps the nil-when-inactive contract).
        ;; The blood floor intentionally reuses this same gradient (one
        ;; uniform red wash top-to-bottom): the row loops below read
        ;; their per-row blood value from blood-sky-gradient for both
        ;; sky AND floor cells.
        blood-sky-gradient                 (when bloody? (:blood-sky grads))
        ;; Code-only gradient twins for ▀ half-block edge composition.
        ;; The top-edge cell blends wall BG with the sky shade AT THAT ROW
        ;; in FG; using a flat sky-code produced a dark notch at the seam
        ;; wherever the gradient is brighter than code 236. Similarly the
        ;; bot-edge blends the floor shade at its row into the BG half.
        sky-code-gradient                  (:sky-code grads)
        floor-code-gradient                (:floor-code grads)
        blood-sky-code-gradient            (when bloody? (:blood-sky-code grads))
        blood-floor-code-gradient          blood-sky-code-gradient
        ;; Directional blood mask: per-column intensity in [0, 1]. Only
        ;; non-zero during i-frames AND when :hurt-side is set. Fades
        ;; from 1.0 at the screen edge that took the hit toward 0 at
        ;; the centre. Drives the per-col red-shade swap inside the
        ;; col-setup loop below. One vw-sized PHP array built per
        ;; frame; lookup is O(1) inside the loop.
        blood-cols                         (build-blood-cols svw bloody? (get stats :hurt-side))
        ehead                              enemy-head
        ebody                              enemy-body
        elegs                              enemy-body ; intentional: default legs = body colour (no separate legs def)
        ;; Pause-aware clock: render samples its blinks/pulses from
        ;; this instead of wall time so every time-driven animation
        ;; freezes the moment the game is paused (issue #7).
        t                                  (or (get stats :game-time) 0.0)
        ;; Walk-cycle body glyph: same sin-wave selector as the face,
        ;; offset by π so the body glyph swaps on the OPPOSITE beat from
        ;; the face. Eye blinks and scales/muscles shift on alternating
        ;; beats so the monster looks animated without per-enemy state.
        face-phase                         (php/sin (php/* t 3.0))
        ;; Cast phase. When the F3 overlay is on, sample microtime
        ;; around the call so render! can split cast-ms from total
        ;; frame-ms. The branch is the only debug-gated cost in the
        ;; off path — a single `(get stats :debug?)` check per frame.
        debug?                             (get stats :debug?)
        t-cast-start                       (if debug? (php/microtime true) 0.0)
        ;; render-scale is a uniform 1 at every size: exact 1:1 cast,
        ;; crisp walls. cast-frame still takes the factor so the
        ;; replication path stays available if ever needed.
        scale                              (render-scale svw svh)
        ;; Pixel-doubled cast: cast at the FULL width with scale 2 (one
        ;; ray per two columns, full-width FOV tables) and compact every
        ;; second sample to scene width — same framing as full detail,
        ;; no zoom. Wall/sprite heights below scale through scene-pd.
        cast-result
        (if px2?
          (compact-cast-2 (cast-frame world vw 2) svw)
          (cast-frame world svw scale))
        {:keys [dists hits sides wallxs floordxs floordys]} cast-result
        scene-pd                           (if px2? (php/* 0.5 proj-dist) proj-dist)
        tex-on?                            (wall-textures-enabled?)
        floor-tex-on?                      (and tex-on? (floor-textures-enabled?))
        ;; Half-block sub-pixel rendering: ▀ cells with independent
        ;; top/bottom colours give 2× vertical resolution on floor /
        ;; walls / sky. Gated by BOTH the env override (subpixel-enabled?,
        ;; PHEL_DOOM_NO_SUBPIXEL=1) AND the player setting (:subpixel in stats,
        ;; #332 Terminal.app compat). Default-on: a missing :subpixel key reads
        ;; as true, so the shipped render + golden fixtures stay byte-identical.
        subpixel?                          (and (subpixel-enabled?)
                                                (not (php/=== false (get stats :subpixel))))
        ;; Truecolor distance-fog: floor cells emit 24-bit \e[48;2;r;g;b
        ;; instead of a nearest-256 code, removing the cube/grey-ramp snap
        ;; banding. OFF by default (256 parity); the :truecolor setting or
        ;; PHEL_DOOM_TRUECOLOR=1 turns it on, PHEL_DOOM_NO_TRUECOLOR=1 forces
        ;; it off. Only the full-detail (px1) floor path honours it.
        truecolor?                         (and (not (no-truecolor?))
                                                (if (force-truecolor?)
                                                  true
                                                  (boolean (get stats :truecolor))))
        ;; Quad detail: pack a 2×2 quadrant glyph where the four sub-pixels
        ;; differ — smoothing the wall SILHOUETTE staircase (the visible win,
        ;; high-contrast wall/sky edge) and adding horizontal floor texel
        ;; detail. OFF by default; honoured only with sub-pixel on, full-detail
        ;; px1. Collapses to the ▀ half-block where there's no horizontal
        ;; detail, so flat / far surfaces stay byte-cheap.
        quad?                              (and (not (no-quad?))
                                                (if (force-quad?)
                                                  true
                                                  (boolean (get stats :quad))))
        flat-walltex?                      (or (flat-walltex-on?) (boolean (get stats :fast-walls)))
        ;; Floor-cast inputs: player position + per-row perpendicular
        ;; distance / fog level for the textured ground plane. The cell-
        ;; res arrays drive the legacy single-texel floor; the sub arrays
        ;; (2× vertical) drive the half-block floor.
        {:x pfx :y pfy}                    (:player world)
        floor-dperp                        (build-floor-dperp svh pr)
        floor-level                        (build-floor-level floor-dperp svh)
        floor-dperp-sub                    (build-floor-dperp-sub (if px2? (php/* 2 svh) svh) floor-cast-k-sub pr-sub)
        floor-level-sub                    (build-floor-level-sub floor-dperp-sub (if px2? (php/* 2 svh) svh))
        _                                  (when debug?
                                             (record-cast-ms!
                                              (php/* (php/- (php/microtime true) t-cast-start) 1000.0)))
        ;; Half-block edge cells need the sky/floor colour CODE for
        ;; the current palette so the composer can write
        ;; "\e[48;5;WALL;38;5;SKYm▀" and let ▀'s upper half show sky.
        ctbl                               shade-code-table
        ;; Calmer 3D view: doors and the aggro head are held STEADY on
        ;; their bright frame instead of pulsing between two shades. The
        ;; door already reads as a door from its glyph + full-brightness
        ;; shade (and stays findable down the arena); the aggro head reads
        ;; as 'in striking range' from its bright head colour. The old
        ;; sin-wave throb was visual noise, not information.
        door-shade-now                     "\e[48;5;130;38;5;226m▌"
        door-code-now                      "130"
        boss-door-shade-now                "\e[48;5;124;38;5;226;1m▌"
        boss-door-code-now                 "124"
        ;; Once the boss dies (combat stamps :boss into held-keys) the
        ;; boss-locked exit renders as the normal orange door, signalling
        ;; it's now walk-through.
        boss-unlocked?                     (and (php/=== (:door-lock world) :boss)
                                                (contains? (or (:held-keys world) #{}) :boss))
        ;; Pickup pulse: systole/diastole BG + matching centre glyph
        ;; both swap on the same beat so the icon throbs in tempo. Kept:
        ;; a gentle two-shade glow that draws the eye to interactables,
        ;; NOT an on/off blink. (See docs/rendering.md, calm-view note.)
        heart-bright?                      (pulse t pulse-freq-heart)
        heart-shade-now                    (if heart-bright? heart-shade-bright heart-shade)
        heart-glyph-now                    (if heart-bright? heart-glyph-bright heart-glyph)
        armor-bright?                      (pulse t pulse-freq-armor)
        ;; Aggro head held steady-bright (calm 3D view): a monster in
        ;; striking range shows its full head colour, no throb.
        aggro-bright?                      true
        armor-shade-now                    (if armor-bright? armor-shade-bright armor-shade)
        armor-glyph-now                    (if armor-bright? armor-glyph-bright armor-glyph)
        ;; Ammo-box pulse: warm-brown crate to yellow flare at 7 rad/s
        ;; — slower than hearts so the two pickup types read distinct
        ;; even when both are in frame.
        ammo-bright?                       (pulse t pulse-freq-ammo)
        ammo-shade-now                     (if ammo-bright? ammo-shade-bright ammo-shade)
        ammo-glyph-now                     (if ammo-bright? ammo-glyph-bright ammo-glyph)
        ;; Berserk pulse — faster than ammo so a rage sphere flashes
        ;; the most aggressively of any pickup, telegraphing the buff.
        berserk-bright?                    (pulse t pulse-freq-berserk)
        berserk-shade-now                  (if berserk-bright? berserk-shade-bright berserk-shade)
        berserk-glyph-now                  (if berserk-bright? berserk-glyph-bright berserk-glyph)
        ;; Invuln pulse — different cadence (8 rad/s) so a sphere on
        ;; the same screen as a berserk doesn't sync up into one beat.
        invuln-bright?                     (pulse t pulse-freq-invuln)
        invuln-shade-now                   (if invuln-bright? invuln-shade-bright invuln-shade)
        invuln-glyph-now                   (if invuln-bright? invuln-glyph-bright invuln-glyph)
        ;; Soulsphere pulse — slower than invuln so a co-spawn reads
        ;; with two distinct cadences instead of synced flashes.
        soulsphere-bright?                 (pulse t pulse-freq-soulsphere)
        soulsphere-shade-now               (if soulsphere-bright? soulsphere-shade-bright soulsphere-shade)
        soulsphere-glyph-now               (if soulsphere-bright? soulsphere-glyph-bright soulsphere-glyph)
        ;; Armor-shard pulse: faster than the full armor pickup
        ;; (5 rad/s) so a shard sitting next to an armor item reads
        ;; with a quicker tempo - matches its 'common chip drop'
        ;; feel vs the rarer fuller pickup.
        armor-shard-bright?                (pulse t pulse-freq-armor-shard)
        armor-shard-shade-now              (if armor-shard-bright? armor-shard-shade-bright armor-shard-shade)
        armor-shard-glyph-now              (if armor-shard-bright? armor-shard-glyph-bright armor-shard-glyph)
        ;; Backpack pulse — slowest of the powerup family so the
        ;; one-shot pickup reads as 'permanent gear' rather than a
        ;; ticking buff.
        backpack-bright?                   (pulse t pulse-freq-backpack)
        backpack-shade-now                 (if backpack-bright? backpack-shade-bright backpack-shade)
        backpack-glyph-now                 (if backpack-bright? backpack-glyph-bright backpack-glyph)
        ;; Keycards pulse at the same beat as pickups; colour is per-
        ;; card so paint-keycards-into picks the right shade.
        keycard-bright?                    (pulse t pulse-freq-keycard)
        keycard-blue-shade-now             (if keycard-bright? keycard-blue-bright keycard-blue-shade)
        keycard-blue-glyph-now             (if keycard-bright? keycard-blue-glyph-bright keycard-blue-glyph)
        keycard-red-shade-now              (if keycard-bright? keycard-red-bright keycard-red-shade)
        keycard-red-glyph-now              (if keycard-bright? keycard-red-glyph-bright keycard-red-glyph)
        keycard-yellow-shade-now           (if keycard-bright? keycard-yellow-bright keycard-yellow-shade)
        keycard-yellow-glyph-now           (if keycard-bright? keycard-yellow-glyph-bright keycard-yellow-glyph)
        weapon-pickup-bright?              (pulse t pulse-freq-weapon-pickup)
        shotgun-pickup-shade-now           (if weapon-pickup-bright? shotgun-pickup-bright shotgun-pickup-shade)
        shotgun-pickup-glyph-now           (if weapon-pickup-bright? shotgun-pickup-glyph-bright shotgun-pickup-glyph)
        chaingun-pickup-shade-now          (if weapon-pickup-bright? chaingun-pickup-bright chaingun-pickup-shade)
        chaingun-pickup-glyph-now          (if weapon-pickup-bright? chaingun-pickup-glyph-bright chaingun-pickup-glyph)
        bfg-pickup-shade-now               (if weapon-pickup-bright? bfg-pickup-bright bfg-pickup-shade)
        bfg-pickup-glyph-now               (if weapon-pickup-bright? bfg-pickup-glyph-bright bfg-pickup-glyph)
        incinerator-pickup-shade-now       (if weapon-pickup-bright? incinerator-pickup-bright incinerator-pickup-shade)
        incinerator-pickup-glyph-now       (if weapon-pickup-bright? incinerator-pickup-glyph-bright incinerator-pickup-glyph)
        rocket-pickup-shade-now            (if weapon-pickup-bright? rocket-pickup-bright rocket-pickup-shade)
        rocket-pickup-glyph-now            (if weapon-pickup-bright? rocket-pickup-glyph-bright rocket-pickup-glyph)
        ;; Atmospheric haze pulls walls toward black as lives drop, so
        ;; the world reads as 'consumed by darkness' the closer the
        ;; player is to dying. Sky / floor untouched; doors keep their
        ;; full-brightness pulse so the exit stays findable.
        ;; HP is a half-heart pool (10 = full): haze ramps over the last
        ;; ~3 hearts, deepening toward the last half-heart.
        haze-shift                         (haze-shift-for-lives (get stats :lives))
        ;; Per-column wall geometry + shade arrays. compute-wall-shades
        ;; CREATES them fresh and returns them (PHP arrays are passed
        ;; by value so a mutating helper can't mutate the caller's
        ;; buffers — we let the helper own the allocation + return).
        ;; Phel destructure reads `:keyword local-name`, so the order
        ;; is opposite to Clojure's `{local :keyword}`.
        {:tops              tops
         :bots              bots
         :normal            shades-normal
         :top-edge          shades-top-edge
         :bot-edge          shades-bot-edge
         :top-shadow        shades-top-shadow
         :bot-shadow        shades-bot-shadow
         :tex-u             shades-tex-u
         :tex-level         shades-tex-level
         :tex-px            shades-tex-px}
        (compute-wall-shades svw svh haze-shift
                             {:dists dists :hits hits :sides sides :wallxs wallxs}
                             {:stbl stbl :ctbl ctbl
                              :door-shade-now door-shade-now
                              :door-code-now  door-code-now
                              ;; Steady door brightness (calm 3D view): the
                              ;; door always rides the fog +3 levels brighter,
                              ;; no sin-wave swap between boosted and base.
                              :door-tex-boost 3
                              :boss-door-shade-now boss-door-shade-now
                              :boss-door-code-now  boss-door-code-now
                              :boss-unlocked?      boss-unlocked?
                              :sky-code-grad         sky-code-gradient
                              :floor-code-grad       floor-code-gradient
                              :blood-sky-code-grad   blood-sky-code-gradient
                              :blood-floor-code-grad blood-floor-code-gradient}
                             blood-cols
                             scene-pd
                             pr)
        ;; Camera eye height: 0.5 (today's flat-ground constant) plus the
        ;; player's own elevation. `:z` lands in the parallel #371; a
        ;; missing key reads as 0.0 so this stays byte-identical to the
        ;; hardcoded 0.5 everywhere else in the file until that lands.
        eye-z                               (php/+ 0.5 (get (:player world) :z 0.0))
        ;; Riser faces + tier-top floor gating (#370), from the flat
        ;; :spans stream (#369). Empty on flat worlds -> every array below
        ;; comes back empty, so the row loop's `riser-top` aget reads nil
        ;; for every column and its extra branches never fire.
        {:riser-top riser-top :riser-bot riser-bot :riser-shade riser-shade
         :riser-dist riser-dist :tier-fz tier-fz}
        (compute-riser-shades (:spans cast-result) haze-shift stbl ctbl scene-pd svh eye-z pr)
        ;; Enemy sprite zone boundaries (head/body/legs). For each
        ;; column carrying an enemy:
        ;;   row in [tops, mids)   -> head
        ;;   row in [mids, lowers) -> body
        ;;   row in [lowers, bots) -> legs
        mids                               (buf-mk)
        lowers                             (buf-mk)
        emask                              (buf-mk)
        ;; Per-column enemy shade strings. Each enemy projection
        ;; computes faded variants of head/body/legs based on its
        ;; distance and writes them into these arrays for the
        ;; columns it covers.
        eheads                             (buf-mk)
        ebodys                             (buf-mk)
        elegss                             (buf-mk)
        ;; Per-column nearest-enemy distance. Set when the enemy paints
        ;; a column (only if the enemy is in front of the wall there).
        ;; Pickups read it to occlude themselves behind enemies the same
        ;; way `dists` occludes them behind walls.
        edists                             (buf-mk)
        ;; Per-column billboard sprite buffers. Only written when
        ;; enemy-sprites-enabled? AND the enemy type resolves to a
        ;; baked sprite. The zone pass populates these INSTEAD of
        ;; tops/bots/eheads/ebodys/elegss so the wall extent is
        ;; preserved behind transparent pixels.
        ;;   e-stop  : billboard top screen row (FULL box; drives sprite-y)
        ;;   e-sbot  : billboard bottom screen row (exclusive, FULL box)
        ;;   e-vtop  : cross-tier VISIBLE-window top row (#302). Equals
        ;;             e-stop unless a nearer ceiling drop shaved the head.
        ;;   e-vbot  : visible-window bottom (exclusive). Equals e-sbot
        ;;             unless a nearer floor riser cut the feet. The paint
        ;;             gate draws only [e-vtop, e-vbot) while the sprite is
        ;;             sampled against the FULL [e-stop, e-sbot) box, so a
        ;;             clipped sprite is CROPPED (true pixels, hidden rows
        ;;             gone) instead of squished into the window.
        ;;   e-sx    : sprite x for this column (precomputed, see sprite-col-x)
        ;;   e-spx   : sprite `:px` php-array ref
        ;;   e-sw    : sprite native width
        ;;   e-sh    : sprite native height
        ;;   e-fade  : per-enemy `sprite-fade` level (distance fog +
        ;;             wound tint), shared by every covered column
        e-stop                             (buf-mk)
        e-sbot                             (buf-mk)
        e-vtop                             (buf-mk)
        e-vbot                             (buf-mk)
        e-sx                               (buf-mk)
        e-sxr                              (buf-mk)
        e-spx                              (buf-mk)
        e-sw                               (buf-mk)
        e-sh                               (buf-mk)
        e-fade                             (buf-mk)
        ;; Resolved once per frame — avoids per-column getenv overhead.
        sprites-on                         (enemy-sprites-enabled?)
        blood-paint                        (buf-mk)
        ;; Project + depth-sort enemies once: the zone pass paints them
        ;; back-to-front, then a second pass grounds the shadows reading
        ;; the completed `edists` (see below).
        ;; Enemy projection always runs at the FULL width (full-FOV
        ;; column mapping); the zone passes halve cols/widths into scene
        ;; cells in pixel-doubled mode so sprites keep their on-screen
        ;; size and position.
        enemy-projs                        (collect-enemy-projs (:enemies world) (:player world) vw)
        ;; Steady-bright minimap door glyph, matching the now-steady 3D
        ;; door shade so the exit catches the eye both in first-person
        ;; and on the overhead map (calmer 3D view: no blink).
        mini-door                          minimap-door-pulse
        mrows                              (if (:show-map world)
                                             (minimap-rows world mini-door map-step)
                                             (buf-mk))
        ;; Content rows that fit below the top border + edge margin
        ;; without overrunning the 3D viewport; the bottom border sits
        ;; one row past them.
        visible-mh                         (if (:show-map world)
                                             (php/min (php/count mrows)
                                                      (php/max 0 (php/- vh map-row)))
                                             0)
        map-shown?                         (php/> visible-mh 0)
        ;; Framed-panel skip RECTANGLE in 0-indexed scene-row/col terms.
        ;; The inner row loop emits flat sky for every cell the panel will
        ;; overdraw (box border + content), so the blit is the only writer
        ;; there — a chain of aget + cond per cell saved in the overlay
        ;; region. Outside the rectangle (including the top + right edge
        ;; margins) the real 3D scene renders. When the map is hidden the
        ;; bounds collapse to sentinels that never match.
        mini-col0                          (if map-shown? (php/max 0 (php/- map-col 2)) vw)
        mini-row-lo                        (if map-shown? (php/max 0 (php/- map-row 2)) vh)
        mini-row-hi                        (if map-shown? (php/- (php/+ map-row visible-mh) 1) -1)]
    (doseq [proj enemy-projs]
      (let [col (if px2? (php/intdiv (:col proj) 2) (:col proj))
            hw  (if px2? (php/max 1 (php/intdiv (:half-width proj) 2)) (:half-width proj))
            d   (:dist proj)
            dmg (or (:damage-ratio proj) 0.0)
            sc  (or (:scale proj) 1.0)]
        (let [;; `sc` scales the sprite vertically in lockstep with
                   ;; :half-width so bosses (cyber, sc=2.0) stay
                   ;; proportional instead of stretching wide-but-flat.
              h         (php/min svh (php/intval (php/* sc
                                                        (php// scene-pd
                                                               (php/* (php/max 0.5 d) char-aspect)))))
                   ;; Freedoom billboard sprite for this enemy (nil when
                   ;; sprites are off or the type has none -> glyph path).
                   ;; Mip-aware: far enemies sample a pre-filtered half /
                   ;; quarter res level matched to the billboard's
                   ;; on-screen sub-row count (2 per cell) instead of
                   ;; point-skipping native texels.
              spr       (when sprites-on
                          (sprite-for-type-lod (:type proj)
                                               (php/max 1 (php/* 2 h))))
              sw        (when spr (:w spr))
              sh        (when spr (:h spr))
              spx       (when spr (:px spr))
                   ;; Box width from the sprite's NATIVE aspect, not the
                   ;; glyph hitbox: half-width = round(h * sw / sh), since
                   ;; a terminal cell is ~2:1 tall and a half-block packs
                   ;; two sprite rows per cell. Keeps the monster
                   ;; undistorted (the glyph hitbox is far too narrow and
                   ;; squished the sprite). Glyph mode keeps the old hw.
              ehw       (if spr
                          (php/max 1 (php/intval (php/round (php// (php/* h sw) sh))))
                          hw)
              c-from    (php/max 0 (php/- col ehw))
              c-to      (php/min (php/- svw 1) (php/+ col ehw))
                   ;; Distance-fade factor: 0 at the player's feet,
                   ;; ~0.65 at max-depth. Squared curve keeps things
                   ;; saturated up close; cap at 0.65 (not 0.85) so a
                   ;; monster at max range stays 35% lit and readable
                   ;; against the dark wall rather than merging into it.
              dist-fade (php/min 0.65
                                 (php/* (php// d max-depth)
                                        (php// d max-depth)))
                   ;; Wound tint: combine distance fade with the per-
                   ;; enemy damage ratio so wounded sprites read as
                   ;; darker/dirtier even up close. Multiplier kept
                   ;; modest (0.35) so a fully-wounded cyberdemon at
                   ;; mid-range still reads distinct from a healthy
                   ;; one far away. Capped at 0.65 so a near-dead
                   ;; enemy never fades to invisible.
              body-fade (php/min 0.65 (php/+ dist-fade (php/* dmg 0.35)))
                   ;; sprite-fade level for the whole billboard: half-
                   ;; strength fog vs walls (see sprite-fade-index) so a
                   ;; monster at max depth sits at fog level ~16 (30%
                   ;; darkening) rather than level 8 (65%), keeping its
                   ;; shading bands visible against dark stone.
              sfade     (php/aget sprite-fade (sprite-fade-index body-fade))]
          ;; #297: anchor the billboard by its FEET on the projected z=0
          ;; floor (eye-z 0.5 on flat ground), then draw the body UPWARD by
          ;; `h`. `scene-pd` is halved in px2 mode, so the projection scales
          ;; there automatically.
          (let [feet-row (php/+ (php/intval (php/round (php/+ (php// svh 2.0)
                                                              (php/* 0.5 (wall-px scene-pd d)))))
                                pr)
                e-top    (php/- feet-row h)]
            (let [e-bot         (php/+ e-top h)
                  e-mid         (php/+ e-top (php/intdiv h 3))
                  e-lower       (php/+ e-top (php/intdiv (php/* h 2) 3))
                       ;; Per-enemy catalog lookup — mixed-monster rooms
                       ;; (boss + minions) pick the right palette per
                       ;; sprite, single-type rooms hit the same kw on
                       ;; every iteration so the cost is one map get.
                  visuals       (visuals-for-type (:type proj) stats)
                  head-code     (get visuals :head-code)
                  body-code     (get visuals :body-code)
                  legs-code     (get visuals :legs-code)
                  body-glyph-fg (get visuals :body-glyph-fg)
                  body-glyph    (if (php/< face-phase 0.0)
                                  (get visuals :body-glyph)
                                  (or (get visuals :body-glyph-alt)
                                      (get visuals :body-glyph)))
                       ;; Faded shade strings for this enemy at its
                       ;; current distance. Computed ONCE per enemy
                       ;; and assigned to every column it covers.
                  fhead         (cond
                                  (and head-code (php/< d aggro-distance))
                                  (enemy-aggro-head-string head-code aggro-bright?)
                                  head-code
                                  (enemy-shade-string head-code dist-fade)
                                  :else
                                  ehead)
                  fbody         (cond
                                  (and body-code body-glyph body-glyph-fg)
                                  (enemy-textured-shade-string body-code body-fade body-glyph body-glyph-fg)
                                  body-code
                                  (enemy-shade-string body-code body-fade)
                                  :else
                                  ebody)
                  flegs         (if legs-code (enemy-shade-string legs-code dist-fade) elegs)]
              (loop [c c-from]
                (when (php/<= c c-to)
                  (when (php/< d (buf-get dists c))
                    ;; The sprite is gated against the full-height wall
                    ;; (`dists`, above); on the flat single-floor world the
                    ;; whole billboard span [e-top, e-bot) is visible.
                    (let [c-top e-top
                          c-bot e-bot]
                      (if spr
                               ;; Sprite path: stash the FULL billboard box
                               ;; (e-stop/e-sbot drive the sprite-y sampling)
                               ;; plus the cross-tier VISIBLE window
                               ;; (e-vtop/e-vbot gate which rows paint). The
                               ;; emitter samples against the full box, so a
                               ;; tier-clipped sprite is CROPPED at its true
                               ;; pixels, not squished into the window. Wall
                               ;; tops/bots stay untouched so transparent
                               ;; pixels show the wall behind.
                        (do
                          (buf-set e-stop c e-top)
                          (buf-set e-sbot c e-bot)
                          (buf-set e-vtop c c-top)
                          (buf-set e-vbot c c-bot)
                          (buf-set e-sx c (sprite-col-x sw col ehw c))
                          (buf-set e-sxr c (sprite-subcol-x sw col ehw c))
                          (buf-set e-spx c spx)
                          (buf-set e-sw c sw)
                          (buf-set e-sh c sh)
                          (buf-set e-fade c sfade)
                          (buf-set emask c true))
                        (do
                                 ;; Glyph path: clip the drawn span to [c-top,
                                 ;; c-bot). `mids`/`lowers` keep the UNCLIPPED
                                 ;; `e-mid`/`e-lower` - the head/body/legs split
                                 ;; is anatomical, so clamping tops/bots just
                                 ;; ends the paint loop early (legs/head hidden)
                                 ;; without sliding the zones.
                          (buf-set tops c c-top)
                          (buf-set bots c c-bot)
                          (buf-set mids c e-mid)
                          (buf-set lowers c e-lower)
                                   ;; Cyberdemon: carve a boss silhouette out of
                                   ;; the rectangle so the form reads as helmet +
                                   ;; arms + 2 legs instead of a giant imp brick.
                          (let [[ph pb pl] (if (and (php/=== (:type proj) :cyber)
                                                    body-code)
                                             (boss-col-paint
                                              (php// (php/abs (php/- c col))
                                                     (php/max 1 hw))
                                              fhead fbody flegs body-code body-fade
                                              (buf-get shades-normal c))
                                             [fhead fbody flegs])]
                            (buf-set eheads c ph)
                            (buf-set ebodys c pb)
                            (buf-set elegss c pl))
                          (buf-set emask c true)))
                               ;; Track nearest enemy distance for this col so
                               ;; pickups behind it occlude properly. Multiple
                               ;; enemies on the same col → keep the closest.
                               ;; The shadow pass below also reads this to keep
                               ;; only the front enemy's grounding shadow.
                               ;; Skipped when fully tier-occluded (clip nil):
                               ;; a hidden enemy can't occlude a pickup as an
                               ;; enemy, and its grounding shadow must not draw.
                      (let [prev (buf-get edists c)]
                        (when (or (php/=== prev nil) (php/< d prev))
                          (buf-set edists c d)))))
                  (recur (php/+ c 1)))))))))
    ;; Grounding shadows, second pass. The shadow goes into blood-paint
    ;; (top-priority overlay), so it can't be painted inline during the
    ;; back-to-front zone pass: a FAR enemy's shadow row would sit over a
    ;; NEAR enemy's body (which lives in the lower-priority enemy-zone
    ;; layer) and bleed through. Deferring until `edists` holds the
    ;; nearest dist per column lets us drop a shadow cell only for the
    ;; column's front-most enemy (d <= edists[c]); farther enemies skip
    ;; it. Still wall-gated (d < dists[c]). (issue #86)
    ;; Glyph-mode only: the Freedoom billboards carry their own grounded
    ;; silhouette, so a painted shadow under them just muddies the sprite.
    (when (not sprites-on)
      (doseq [proj enemy-projs]
        (let [col    (if px2? (php/intdiv (:col proj) 2) (:col proj))
              hw     (if px2? (php/max 1 (php/intdiv (:half-width proj) 2)) (:half-width proj))
              d      (:dist proj)
              ;; #297: the shadow sits on the SAME flat z=0 feet row the zone
              ;; pass anchors the sprite to, so shadow + feet track together.
              e-bot  (php/+ (php/intval (php/round (php/+ (php// svh 2.0)
                                                          (php/* 0.5 (wall-px scene-pd d)))))
                            pr)
              c-from (php/max 0 (php/- col hw))
              c-to   (php/min (php/- svw 1) (php/+ col hw))]
          (when (php/< e-bot svh)
            (loop [c c-from]
              (when (php/<= c c-to)
                (when (enemy-front-visible-at? d c dists edists)
                  (buf-set blood-paint
                           (php/+ (php/* e-bot svw) c)
                           sprite-shadow))
                (recur (php/+ c 1))))))))
    ;; Chain the fx + pickup painters: each one takes the current
    ;; blood-paint, returns a new buffer (PHP arrays pass by value, so
    ;; the helper owns the allocation). Rename per step to keep phel
    ;; lint happy about shadowed-binding without losing the chain.
    ;; Threading (->) would be cleaner but trips arity-mismatch lint.
    (let [bp-fx               (paint-blood-fx-into blood-paint stats world dists svw svh scene-pd)
          bp-hearts           (paint-pickups-into  bp-fx (or (:hearts world) [])
                                                   (:player world) dists edists svw svh scene-pd
                                                   heart-shade-now heart-glyph-now :heart)
          bp-armors           (paint-pickups-into  bp-hearts (or (:armors world) [])
                                                   (:player world) dists edists svw svh scene-pd
                                                   armor-shade-now armor-glyph-now :armor)
          bp-shards           (paint-pickups-into  bp-armors (or (:armor-shards world) [])
                                                   (:player world) dists edists svw svh scene-pd
                                                   armor-shard-shade-now armor-shard-glyph-now :armor-shard)
          bp-ammos            (paint-pickups-into  bp-shards (or (:ammo-boxes world) [])
                                                   (:player world) dists edists svw svh scene-pd
                                                   ammo-shade-now ammo-glyph-now :ammo)
          bp-bers             (paint-pickups-into  bp-ammos (or (:berserks world) [])
                                                   (:player world) dists edists svw svh scene-pd
                                                   berserk-shade-now berserk-glyph-now :berserk)
          bp-inv              (paint-pickups-into  bp-bers (or (:invulns world) [])
                                                   (:player world) dists edists svw svh scene-pd
                                                   invuln-shade-now invuln-glyph-now :invuln)
          bp-soul             (paint-pickups-into  bp-inv (or (:soulspheres world) [])
                                                   (:player world) dists edists svw svh scene-pd
                                                   soulsphere-shade-now soulsphere-glyph-now :soulsphere)
          bp-pack             (paint-pickups-into  bp-soul (or (:backpacks world) [])
                                                   (:player world) dists edists svw svh scene-pd
                                                   backpack-shade-now backpack-glyph-now :backpack)
          keycards            (or (:keycards world) [])
          weapon-pickups      (or (:weapon-pickups world) [])
          bp-kb               (if (seq keycards) (paint-pickups-into  bp-pack
                                                                      (apply vector
                                                                             (filter (fn [k] (php/=== (:colour k) :blue))
                                                                                     keycards))
                                                                      (:player world) dists edists svw svh scene-pd
                                                                      keycard-blue-shade-now keycard-blue-glyph-now :keycard-blue) bp-pack)
          bp-kr               (if (seq keycards) (paint-pickups-into  bp-kb
                                                                      (apply vector
                                                                             (filter (fn [k] (php/=== (:colour k) :red))
                                                                                     keycards))
                                                                      (:player world) dists edists svw svh scene-pd
                                                                      keycard-red-shade-now keycard-red-glyph-now :keycard-red) bp-kb)
          bp-ky               (if (seq keycards) (paint-pickups-into  bp-kr
                                                                      (apply vector
                                                                             (filter (fn [k] (php/=== (:colour k) :yellow))
                                                                                     keycards))
                                                                      (:player world) dists edists svw svh scene-pd
                                                                      keycard-yellow-shade-now keycard-yellow-glyph-now :keycard-yellow) bp-kr)
          bp-ws               (if (seq weapon-pickups) (paint-pickups-into  bp-ky
                                                                            (apply vector
                                                                                   (filter (fn [w] (php/=== (:weapon w) :shotgun))
                                                                                           weapon-pickups))
                                                                            (:player world) dists edists svw svh scene-pd
                                                                            shotgun-pickup-shade-now shotgun-pickup-glyph-now :shotgun) bp-ky)
          bp-wc               (if (seq weapon-pickups) (paint-pickups-into  bp-ws
                                                                            (apply vector
                                                                                   (filter (fn [w] (php/=== (:weapon w) :chaingun))
                                                                                           weapon-pickups))
                                                                            (:player world) dists edists svw svh scene-pd
                                                                            chaingun-pickup-shade-now chaingun-pickup-glyph-now :chaingun) bp-ws)
          bp-wb               (if (seq weapon-pickups) (paint-pickups-into  bp-wc
                                                                            (apply vector
                                                                                   (filter (fn [w] (php/=== (:weapon w) :bfg))
                                                                                           weapon-pickups))
                                                                            (:player world) dists edists svw svh scene-pd
                                                                            bfg-pickup-shade-now bfg-pickup-glyph-now :bfg) bp-wc)
          bp-wi               (if (seq weapon-pickups) (paint-pickups-into  bp-wb
                                                                            (apply vector
                                                                                   (filter (fn [w] (php/=== (:weapon w) :incinerator))
                                                                                           weapon-pickups))
                                                                            (:player world) dists edists svw svh scene-pd
                                                                            incinerator-pickup-shade-now incinerator-pickup-glyph-now :incinerator) bp-wb)
          bp-wr               (if (seq weapon-pickups) (paint-pickups-into  bp-wi
                                                                            (apply vector
                                                                                   (filter (fn [w] (php/=== (:weapon w) :rocket))
                                                                                           weapon-pickups))
                                                                            (:player world) dists edists svw svh scene-pd
                                                                            rocket-pickup-shade-now rocket-pickup-glyph-now :rocket) bp-wi)
          ;; Fireballs paint last into the overlay so an incoming bolt
          ;; sits on top of every pickup glow it crosses.
          bp-proj             (paint-projectiles-into bp-wr (or (:projectiles world) [])
                                                      (:player world) dists edists svw svh scene-pd)
          ;; Player BFG ball / rocket tracers fly on top of everything.
          bp-trc              (paint-tracers-into bp-proj (or (:shot-tracers world) [])
                                                  (:player world) dists edists svw svh scene-pd)
          parts               (buf-mk)
          ;; Crosshair centre cell, captured live from the row loop (1-slot
          ;; php-array). The reticle paints its `+` on the REAL rendered
          ;; cell under it (wall texture / floor / sky / sprite), so its BG
          ;; always matches the surroundings - no recomputed flat-shade
          ;; mismatch that read as a fake light box on textured walls.
          cap-col             (php/intdiv vw 2)
          cap-row             (php/+ (php/intdiv vh 2)
                                     (if (php/> (or (get stats :fire-anim) 0.0) 0.0) -1 0))
          center-cap          (php/array)
          ;; Scene-space capture coords: in pixel-doubled mode the centre
          ;; terminal cell maps to internal cell (cap-row/2, cap-col/2);
          ;; the row/col parity picks which quadrant of the 2×2 block.
          cap-sr              (php/intdiv cap-row px-sc)
          cap-scl             (php/intdiv cap-col px-sc)
          cap-bot?            (and px2? (php/=== 1 (php/% cap-row 2)))
          cap-right?          (and px2? (php/=== 1 (php/% cap-col 2)))
          ;; Minimap skip region in scene cells (the blit itself stays at
          ;; full terminal coordinates).
          mini-scol0          (php/intdiv mini-col0 px-sc)
          mini-srow-lo        (php/intdiv mini-row-lo px-sc)
          mini-srow-hi        (php/intdiv mini-row-hi px-sc)
          ;; Full-resolution floor gradient for the weapon-sprite painter
          ;; (it paints at terminal coordinates; the scene gradient is
          ;; half-res in pixel-doubled mode).
          floor-gradient-full (if px2?
                                (floor-gradient-full-for vh)
                                floor-gradient)
          ;; SUB-row wall bounds for BOTH emitters (half a terminal row
          ;; of precision: 4 sub-rows per 2-terminal-row scene cell in
          ;; pixel-doubled mode, 2 per cell at full detail). Textured
          ;; seam cells mix sky / wall / floor codes at these bounds, so
          ;; the receding wall silhouette steps in half-row increments
          ;; instead of whole cells (the "square staircase" look). At
          ;; full detail the mixer needs the ▀ sub-pixel cells, so the
          ;; mix flag is gated on subpixel? there (px2 always mixes).
          wsub                (build-wall-sub-bounds dists shades-tex-level emask tops bots
                                                     sprites-on
                                                     (if px2? tex-on? (if subpixel? tex-on? false))
                                                     svw svh scene-pd
                                                     (if px2? 4 2)
                                                     pr)
          wsub-top            (php/aget wsub 0)
          wsub-bot            (php/aget wsub 1)
          wsub-mix            (php/aget wsub 2)
          wsub-skylim         (php/aget wsub 3)
          wsub-floorfrom      (php/aget wsub 4)
          ;; Floor texel code at one screen SUB-row for column `col` —
          ;; the seam-cell mixer calls this only for the few sub-rows that
          ;; fall below a wall bottom inside a boundary cell.
          floor-code-at       (fn [^int sub ^int col]
                                (let [dp (php/aget floor-dperp-sub sub)
                                      fx (php/+ pfx (php/* dp (buf-get floordxs col)))
                                      fy (php/+ pfy (php/* dp (buf-get floordys col)))]
                                  (php/aget (php/aget tex-fade-table (php/aget floor-level-sub sub))
                                            (php/aget floor-tex-px
                                                      (php/+ (php/* (php/intval (php/* (php/- fy (php/floor fy)) 64)) 64)
                                                             (php/intval (php/* (php/- fx (php/floor fx)) 64)))))))
          ;; frame-constant: floor-tex-on? does not change within a frame,
          ;; so floor-flat? is hoisted here out of both per-row let bindings
          ;; (px1 dotimes row + px2 dotimes r2) to avoid recomputing it vh
          ;; (or svh) times per frame. Byte-identical output guaranteed.
          floor-flat?         (if floor-tex-on? false true)
          ;; Pin the referred frame-math globals as frame-level locals so
          ;; inner references resolve to a PHP local variable instead of a
          ;; Phel::getDefinition() call (two array lookups + singleton probe)
          ;; every time they appear in per-row or per-cell code. tex-fade-table
          ;; is the hottest: 4 reads per row in px2 + 2-3 reads per wall cell
          ;; in px1. Byte-identical output guaranteed (same value, cached early).
          tex-fade-table      tex-fade-table
          bg-cell-cache       bg-cell-cache
          seam-darken-16      seam-darken-16
          seam-darken-8       seam-darken-8
          seam-darken-5       seam-darken-5
          ;; Truecolor floor (px1 only): swap the fog LUT + the ▀ builder
          ;; for their 24-bit twins. OFF -> these are the plain 256 globals
          ;; so the floor path stays byte-identical. px2 keeps the 256 pins
          ;; above (truecolor + pixel-doubling is a perf contradiction).
          ftab                (if truecolor? tex-fade-tc tex-fade-table)
          hb                  (if truecolor? halfblock-tc halfblock)
          ;; #350 Part B: the scene emitters are lifted into module-level
          ;; defn-s (emit-scene-px2 / emit-scene-px1). PHP arrays pass by
          ;; value across fn boundaries (see docs/performance.md), so both
          ;; `parts` and `center-cap` must be REBOUND from the returned
          ;; [parts center-cap] pair rather than mutated in place.
          [parts center-cap]
          (if px2?
            (emit-scene-px2 parts center-cap
                            vw vh svw svh
                            sky-gradient sky-sub-codes floor-gradient blood-sky-gradient blood-cols
                            floordxs floordys pfx pfy floor-dperp-sub floor-level-sub
                            tops bots shades-normal shades-top-edge shades-bot-edge shades-top-shadow shades-bot-shadow
                            shades-tex-u shades-tex-level shades-tex-px
                            riser-top riser-bot riser-shade
                            mids lowers emask eheads ebodys elegss
                            e-stop e-sbot e-vtop e-vbot e-sx e-sxr e-spx e-sw e-sh e-fade
                            sprites-on bp-trc
                            wsub-top wsub-bot wsub-mix wsub-skylim wsub-floorfrom
                            floor-flat? tex-fade-table bg-cell-cache
                            floor-code-at seam-darken-16 seam-darken-8 seam-darken-5
                            hits cap-sr cap-scl cap-bot? cap-right?
                            mini-scol0 mini-srow-lo mini-srow-hi)
            (emit-scene-px1 parts center-cap
                            vw vh
                            sky-gradient sky-sub-codes floor-gradient blood-sky-gradient blood-cols
                            floordxs floordys pfx pfy floor-dperp-sub floor-level-sub
                            tops bots shades-normal shades-top-edge shades-bot-edge shades-top-shadow shades-bot-shadow
                            shades-tex-u shades-tex-level shades-tex-px
                            riser-top riser-bot riser-shade
                            mids lowers emask eheads ebodys elegss
                            e-stop e-sbot e-vtop e-vbot e-sx e-sxr e-spx e-sw e-sh e-fade
                            sprites-on bp-trc
                            wsub-top wsub-bot wsub-mix wsub-skylim wsub-floorfrom
                            floor-flat? tex-fade-table bg-cell-cache
                            sky-hb tex-on? subpixel? quad? flat-walltex?
                            floor-dperp floor-level
                            mini-col0 mini-row-lo mini-row-hi
                            cap-col cap-row
                            floor-code-at seam-darken-16 seam-darken-8 seam-darken-5 ftab hb))]
      (when (get stats :debug?)
        (buf-push parts (hud-debug-line world stats))
        (buf-push parts "\n"))
      (buf-push parts hud-line-str)
      ;; Framed minimap panel: wrap the visible content rows in a box
      ;; border (title strip) and blit it inset from the top + right edges.
      ;; The box top/left sit one cell up-left of the content origin; the
      ;; skip rectangle above reserved exactly these cells.
      (when (php/> visible-mh 0)
        (let [content (buf-mk)]
          (dotimes [i visible-mh] (buf-push content (buf-get mrows i)))
          (let [panel (minimap-frame content map-mw "MAP")
                ftop  (php/- map-row 1)
                fleft (php/- map-col 1)]
            (dotimes [j (php/count panel)]
              (buf-push parts (str "\e[" (php/+ ftop j) ";" fleft "H" (buf-get panel j)))))))
      ;; Overlay chain: each helper returns the parts buffer because
      ;; PHP arrays pass by value across fn boundaries. Rebind every
      ;; step so the pushed escapes actually accumulate.
      ;;
      ;; The crosshair needs the SGR-only prefix of whatever cell sits
      ;; under the centre so `+` paints on the real cell colour (wall
      ;; texture, floor, sky, enemy sprite, blood) instead of the terminal
      ;; default. That cell was already resolved by the row loop and
      ;; captured into center-cap, so we reuse it verbatim - no second,
      ;; drift-prone priority chain (the old replay used the flat wall
      ;; shade, which mismatched the textured wall and read as a fake light
      ;; box). Fallback to the column's flat wall shade only if the centre
      ;; was never captured (degenerate viewport).
      ;; Reticle scene column (#324): the cell whose BG the `+` paints on.
      ;; The reticle's terminal-coord 0-based column (:aim-col) maps to its
      ;; scene column by the pixel-double scale; absent (mouse off) it is the
      ;; scene centre, and the row loop's live `center-cap` capture is reused
      ;; there verbatim so the mouse-off frame stays byte-identical. Off the
      ;; centre we fall back to that column's wall shade (the live textured
      ;; cell was only captured at the centre).
      (let [aim-col     (get stats :aim-col)
            c-col       (if (php/=== nil aim-col)
                          (php/intdiv svw 2)
                          (php/max 0 (php/min (php/- svw 1) (php/intdiv aim-col px-sc))))
            center-cell (or (when (php/=== c-col (php/intdiv svw 2)) (php/aget center-cap 0))
                            (buf-get shades-normal c-col))
            center-bg   (php/mb_substr center-cell 0
                                       (php/max 0 (php/- (php/mb_strlen center-cell) 1)))
            ;; Overlay chain: each helper takes the parts buffer plus
            ;; its own deps and returns the (possibly larger) buffer.
            ;; Numbered rebinds so phel lint's shadowed-binding stays
            ;; quiet without changing semantics. Threading (->) would
            ;; be cleaner but trips arity-mismatch lint.
            ;; Face glyph (blinking eyes) is a glyph-era tell; the
            ;; Freedoom sprites already show a face, so skip it in sprite mode.
            p1          (if sprites-on parts
                            (paint-face-overlay parts world stats svw svh dists edists face-phase px-sc pr))
            p4          (paint-crosshair          p1 stats vw vh center-bg)
            p5          (paint-intro-splash       p4 stats vw vh)
            p6          (paint-blood-drops        p5 stats vw vh)
            p8          (paint-heartbeat-vignette p6 stats vw vh)
            p9          (paint-hit-vignette       p8 stats bloody? vw vh)
            p9b         (paint-berserk-tint       p9 t stats vw vh)
            p10         (paint-heat-bar           p9b t stats vw vh)
            p11         (paint-kill-streak        p10 stats map-col map-row visible-mh)
            p12         (paint-compass            p11 world vw)
            p13         (paint-rear-warning       p12 t stats vw)
            p14         (paint-low-ammo           p13 t stats vw)
            p15         (paint-game-info          p14 stats vw)
            p15b        (paint-berserk-badge      p15 t stats vw)
            p15c        (paint-invuln-badge       p15b t stats vw)
            p16         (paint-hearts-hud         p15c t stats bloody?)
            ;; `:hide-weapon?` skips the gun sprite (nothing in hand).
            p17         (if (:hide-weapon? world)
                          p16
                          (paint-weapon-hud p16 stats vw vh floor-gradient-full))
            p18         (paint-empty-click        p17 stats vw vh)
            p19         (paint-reload-reminder    p18 stats vw vh)
            p19b        (paint-locked-bump        p19 stats vw vh)
            p19c        (paint-enemy-hp-flashes   p19b world vw vh pr-full)
            p20         (paint-save-flash         p19c stats vw vh)
            p20b        (paint-reload-ready       p20 stats vw vh)]
        ;; Pause (P) IS the settings page: freezing the game and the
        ;; options live in one overlay so there's only one layer to
        ;; learn. The H info panel can still sit on top of it (player
        ;; paused, then pressed H); it paints last so it wins.
        (when (and (get stats :paused) (not (get stats :help?)))
          ;; Pause menu (#203): the top-level menu is the default pause
          ;; screen; Settings drops into the options sub-page.
          (if (= (get stats :pause-screen) :settings)
            (buf-push p20b (settings-menu-string vw vh
                                                 (get stats :settings)
                                                 (get stats :settings-cursor)
                                                 "↑↓ws move  ←→ad change  enter/space back"))
            (buf-push p20b (pause-menu-string vw vh (get stats :pause-cursor)))))
        (when (get stats :help?)
          (buf-push p20b (help-menu-string vw vh stats)))
        (php/implode "" p20b)))))
;; =====================================================================
;; § IO entry points
;; =====================================================================

;; --- DO NOT swap `print` / `println` for `php/fwrite` in render! ---
;; `php/fwrite($fh, $s)` returns the byte count actually written,
;; which can be `< strlen($s)` on partial writes (kernel terminal
;; buffer full, or EINTR from a signal under pcntl_async_signals).
;; The renderer doesn't loop on partial writes; result is silently
;; truncated frames (only the first slice paints). PHP's `print` /
;; `echo` already loop internally via the output handler, so they're
;; the safe primitive here. See PR #54 black-screen incident.

(defn clear-screen
  "ANSI clear + cursor home."
  []
  (print "\e[2J\e[H"))

(defn- white-flash-frame
  "Full-screen white wash, one frame. Painted on impact so the player
   sees a brief jolt before the red i-frame palette swap kicks in."
  [cols rows]
  (let [parts (buf-mk)
        line  (str "\e[107m" (php/str_repeat " " cols))]
    (buf-push parts "\e[H")
    (loop [r 1]
      (when (php/<= r rows)
        (buf-push parts (str "\e[" r ";1H" line))
        (recur (php/+ r 1))))
    (buf-push parts "\e[0m")
    (php/implode "" parts)))

(defn- update-perf-snapshot!
  "Compute the perf snapshot from the just-emitted `frame-str` and the
   `total-ms` it took, then merge it into `perf-snapshot` (cast-ms was
   already stashed by frame->string). Render-ms is whatever's left
   after subtracting cast — the same accounting the manual sanity
   check in issue #9 uses (`cast + render ≈ frame`)."
  [^string frame-str ^float total-ms]
  (let [bytes     (php/strlen frame-str)
        sgr-count (php/max 1 (php/substr_count frame-str "\e["))
        avg-rle   (php// bytes sgr-count)
        cast-ms   (or (get @perf-snapshot :cast-ms) 0.0)
        render-ms (php/max 0.0 (php/- total-ms cast-ms))]
    (swap! perf-snapshot
           (fn [snap]
             (assoc (or snap {})
                    :cast-ms      cast-ms
                    :render-ms    render-ms
                    :bytes        bytes
                    :avg-rle      avg-rle
                    :php-mem      (php/memory_get_usage true)
                    :php-mem-peak (php/memory_get_peak_usage true))))))

(defn render!
  "Move cursor home and overwrite the previous frame in place. Avoids
   the full-screen clear that would otherwise flicker each frame.
   While :flash-secs > 0 the whole viewport flashes white — a 1-frame
   impact jolt that lands before the red i-frame wash. Screen-shake:
   the first ~0.25s of the i-frame window offsets the cursor-home
   anchor by ±1 col so the next frame paints one cell off, reading
   as a snap-shake on damage. When :debug? is set, also samples
   microtime around `frame->string` and updates `perf-snapshot` so the
   next frame's HUD can paint the F3 overlay; the work is gated so
   the off path pays nothing beyond a single key read."
  [world stats cols rows]
  (let [iframes (or (get stats :iframes) 0.0)
        shake?  (php/> iframes 0.75)
        t       (or (get stats :game-time) 0.0)
        debug?  (get stats :debug?)
        shake-x (if shake?
                  (php/+ 1 (mod (php/intval (php/* t 50.0)) 3))
                  1)]
    ;; Re-assert hide-cursor every frame (#246): init-input! hides the
    ;; terminal caret once, but a terminal can resurface it on a mode
    ;; flip / resize / SGR-mouse-tracking enable, which would leave a
    ;; blinking caret racing the fixed-centre crosshair (the real FPS aim
    ;; point). Re-emitting \e[?25l per frame is one idempotent escape and
    ;; keeps the caret reliably hidden for the whole session.
    (print "\e[?25l")
    ;; Same per-frame re-assert for the OS MOUSE pointer (#295): the
    ;; crosshair IS the aim, so the arrow must stay hidden. `\e[>3p`
    ;; (XTSMPOINTER always-hide) is sent on enable + rearm, but a mode flip
    ;; / focus change can resurface the arrow between rearms; re-emitting it
    ;; per frame (only while the Mouse setting is on) keeps it hidden as
    ;; reliably as the caret. Terminals without XTSMPOINTER ignore it - no
    ;; portable escape can hide the pointer there (#313).
    (when (get stats :mouse) (print "\e[>3p"))
    (print (str "\e[1;" shake-x "H"))
    (if (php/> (or (get stats :flash-secs) 0.0) 0.0)
      (print (white-flash-frame cols rows))
      (if debug?
        (let [t-start  (php/microtime true)
              frame    (frame->string world stats cols rows)
              total-ms (php/* (php/- (php/microtime true) t-start) 1000.0)]
          (print frame)
          (update-perf-snapshot! frame total-ms))
        (print (frame->string world stats cols rows)))))
  (php/flush))
;; =====================================================================
;; § End screens (death / victory)
;; =====================================================================

;; ---------------------------------------------------------------------
;; End-of-game screens (death / victory).
;;
;; Same box geometry as the settings page but full-screen washed in either
;; dark red (death) or dark green (victory). Both screens share
;; render-end-screen — the only thing each variant supplies is the
;; wash colour and the 32-wide row strings.
;; ---------------------------------------------------------------------

(def end-box-width-cap   "Upper bound on the end-screen box width."   36)

(def end-box-width-floor "Smallest readable box at very narrow vw."   22)

(def end-compact-rows    "rows below this drop separators + best-row block." 20)

(defn- end-pad
  "Right-pad `text` with spaces up to `width` visible columns."
  [text width]
  (str text (php/str_repeat " " (php/max 0 (php/- width (php/strlen text))))))

(defn- end-clip
  "Truncate `text` to at most `width` chars so a long level-name on a
   tiny terminal can't bleed past the right border."
  [text width]
  (let [n (php/strlen text)]
    (if (php/<= n width) text (php/substr text 0 width))))

(defn- end-row-text
  "Build one interior text row sized to `width`: clip first, then
   right-pad. Wrapping the SGR around it is the caller's job."
  [text width]
  (end-pad (end-clip text width) width))

(defn- end-centre
  "Centre a visible-text run inside `width` columns, wrapping the
   supplied SGR around the whole padded string."
  [text width sgr]
  (let [t (end-clip text width)
        n (php/strlen t)
        L (php/max 0 (php/intdiv (php/- width n) 2))
        R (php/max 0 (php/- width (php/+ n L)))]
    (str sgr (php/str_repeat " " L) t (php/str_repeat " " R) "\e[0m")))

(defn- end-box-width-for
  "Pick a box width that fits a 4-col total margin while staying within
   the readable floor / cap."
  [cols]
  (php/max end-box-width-floor
           (php/min end-box-width-cap (php/- cols 4))))

(defn- best-victory-cell [s]
  (if (php/<= s 0) "--" (format-duration s)))

(defn- weapon-kills-line
  "Compact `pistol 5  chaingun 12` breakdown from a `:kills-by-weapon`
   map, skipping weapons with no kills. Empty string when nothing landed
   (so the caller can drop the row). end-row-text clips it to the box
   width, so a long loadout never overflows."
  [kbw]
  (let [m      (or kbw {})
        kept   (filter (fn [p] (php/> (get p 1) 0))
                       (map (fn [w] [w (or (get m w) 0)]) (keys m)))
        ;; Most-used weapon first, so the width clip drops the least-used
        ;; rather than the headline weapon's count.
        sorted (sort-by (fn [p] (php/- 0 (get p 1))) kept)]
    (reduce (fn [acc p]
              (str acc (if (php/=== acc "") "" "  ") (name (get p 0)) " " (get p 1)))
            ""
            sorted)))

(defn- grade-sgr
  "Bold SGR colour for a run grade letter so the rank reads at a glance:
   gold S, green A, cyan B, white C, dim D."
  [grade]
  (cond
    (= grade "S") "\e[93;1m"
    (= grade "A") "\e[92;1m"
    (= grade "B") "\e[96;1m"
    (= grade "C") "\e[97;1m"
    :else         "\e[90;1m"))

(defn- best-rows
  "Tiny 3-line block summarising the persisted best scores."
  [scores width]
  [(str "\e[2;93m" (end-row-text (str "   best kills:   " (:best-kills scores)) width) "\e[0m")
   (str "\e[2;93m" (end-row-text (str "   best level:   " (:best-level scores)) width) "\e[0m")
   (str "\e[2;93m" (end-row-text (str "   best time:    "
                                      (best-victory-cell (:fastest-victory-s scores)))
                                 width) "\e[0m")])

(defn- end-rows
  "Compose the interior row list for either variant. `title` is the
   one-line centred banner SGR-painted by the caller; `did-what` is
   the past-tense phrase under the run stats (`died on` / `cleared`).
   Compact mode (when the terminal is too short) drops the leading
   blank-line padding, the best-scores block, and most separators —
   keeps the box tall enough to read even on a 12-row split."
  [title-sgr title did-what kills survived-s level level-name scores summary rows width]
  (let [bl       (end-row-text "" width)
        compact  (php/< rows end-compact-rows)
        stat     (fn [text] (str "\e[97m" (end-row-text (str "  " text) width) "\e[0m"))
        ;; Run-summary panel (issue #202): accuracy %, secrets (only when
        ;; the run had any), and the letter rank centred + colour-coded.
        wkl      (if summary (weapon-kills-line (:kills-by-weapon summary)) "")
        sum-rows (if summary
                   (apply vector
                          (concat
                           [(stat (str "accuracy: " (:accuracy summary) "%"))]
                           (if (php/> (or (:secrets-total summary) 0) 0)
                             [(stat (str "secrets:  " (:secrets-found summary)
                                         "/" (:secrets-total summary)))]
                             [])
                           [(stat (str "damage:   " (or (:damage-taken summary) 0)))]
                           (if (php/=== wkl "")
                             []
                             [(stat (str "by: " wkl))])
                           [(end-centre (str "RANK  " (:grade summary)) width
                                        (grade-sgr (:grade summary)))]))
                   [])]
    (apply vector
           (concat
            (if compact []  [bl])
            [(end-centre title width title-sgr)]
            (if compact [:sep] [bl :sep bl])
            [(stat (str did-what " L" level " " level-name))
             (stat (str "kills:    " kills))
             (stat (str "time:     " (format-duration survived-s)))]
            sum-rows
            (if compact
              [:sep]
              (concat [bl :sep bl] (best-rows scores width) [bl :sep bl]))
            [(end-centre "r new  R same  q quit" width "\e[97;1m")]
            (if compact
              []
              [bl :sep bl
               (str "\e[2;97m" (end-row-text "  phel-doom by Chemaclass" width) "\e[0m")
               (str "\e[2;97m" (end-row-text "  written in Phel Lang"    width) "\e[0m")
               bl])))))

(defn- death-rows [kills survived-s level level-name scores summary rows width]
  (end-rows "\e[91;1m" "YOU DIED" "died on"  kills survived-s level level-name scores summary rows width))

(defn- victory-rows [kills survived-s level level-name scores summary rows width]
  (end-rows "\e[92;1m" "VICTORY!" "cleared" kills survived-s level level-name scores summary rows width))

(defn- render-end-screen
  "Generic end-of-game overlay: full-screen wash in `wash-bg` plus a
   centred ─┌┐│└┘ box whose contents are `items` (interior strings
   interleaved with :sep markers). Item count is clamped to the
   available rows so a tall box can't paint past the terminal bottom
   on very short terminals."
  [cols rows wash-bg items width]
  (let [parts (buf-mk)
        bar   (php/str_repeat "─" width)]
    (buf-push parts "\e[H")
    (loop [r 1]
      (when (php/<= r rows)
        (buf-push parts (str "\e[" r ";1H" wash-bg
                             (php/str_repeat " " cols)))
        (recur (php/+ r 1))))
    (let [;; Reserve 2 rows for the top + bottom border.
          max-n   (php/max 0 (php/- rows 2))
          n       (php/min max-n (count items))
          row-top (php/max 1 (php/- (php/intdiv rows 2) (php/intdiv n 2)))
          col0    (php/max 1 (php/- (php/+ (php/intdiv cols 2) 1)
                                    (php/intdiv (php/+ width 2) 2)))]
      (buf-push parts (str "\e[" row-top ";" col0
                           "H\e[40;97m┌" bar "┐\e[0m"))
      (buf-push parts (str "\e[" (php/+ row-top n 1) ";" col0
                           "H\e[40;97m└" bar "┘\e[0m"))
      (loop [i 0]
        (when (php/< i n)
          (let [item (get items i)
                row  (php/+ row-top 1 i)]
            (if (= item :sep)
              (buf-push parts (str "\e[" row ";" col0
                                   "H\e[40;97m├" bar "┤\e[0m"))
              (buf-push parts (str "\e[" row ";" col0
                                   "H\e[40;97m│" item "\e[40;97m│\e[0m"))))
          (recur (php/+ i 1)))))
    (print (php/implode "" parts))
    (php/flush)))
;; =====================================================================
;; § Start menu
;; =====================================================================

;; ---------------------------------------------------------------------
;; Start menu (shown once on game launch, before run-levels).
;; Pixel-perfect: every interior row is normalised to a fixed visible
;; width via end-pad (mb_strwidth on the raw text, ANSI escapes are
;; zero-width). The arrow glyphs ←→↑↓ are mb_strwidth=1 so they pad
;; correctly alongside ASCII; doubling fancy chars would skew the
;; right border.
;; ---------------------------------------------------------------------

(def start-menu-width
  "Visible character width of the menu's interior row (between the
   left and right borders). Pad target for every line."
  48)

(defn- pad-visible
  "Right-pad `text` with spaces so its visible width (ignoring ANSI
   escapes, counting wide chars correctly) hits `width`.

   Items typically end with an internal `\\e[40;97m` (or `\\e[0m`)
   that resets BG + FG. The `22` in the trailing reset also clears
   any sticky intensity attribute — `\\e[2;97m` (dim) sets bit `2`
   which `\\e[40;97m` alone does NOT cancel, so without the `22` the
   trailing pad spaces and the closing `│` border inherit the dim
   wash and read as gray. Re-applies `\\e[40;97m` (with `22` for
   intensity-normal) before the padding so trailing spaces stay on
   the menu's dark BG at full brightness."
  [text width]
  (let [stripped (php/preg_replace "/\\x1b\\[[0-9;]*[a-zA-Z]/" "" text)
        visible  (php/mb_strwidth stripped)
        pad      (php/str_repeat " " (php/max 0 (php/- width visible)))]
    (str text "\e[22;40;97m" pad)))

(defn- start-menu-rows
  "Interior strings for the start-menu box. `:sep` markers between
   sections become `├─┤` divider rows in render-start-menu.

   Controls are laid out in two columns to keep the box short.

   Adaptive to terminal height (`rows`):
     >= 28  full menu (title + controls + how-to-play + footer)
     >= 22  drop the how-to-play section
     < 22   ultra-compact (title + footer only, with a resize hint).

   The total row count always fits inside `rows - 4` cells (box top
   border + bottom border + one cushion above + one below).

   `mouse-note` is an optional terminal caveat (nil to omit) appended to the
   how-to section under the universal mouse line."
  [rows mouse-note]
  (let [w        start-menu-width
        half     (php/intdiv w 2)
        blank    (pad-visible "" w)
        ;; key+label cell: 2-space indent, yellow key in an 8-col field,
        ;; then the label. ANSI is ignored by pad-visible's width count.
        cell     (fn [key label]
                   (str "  \e[93m" key "\e[40;97m"
                        (php/str_repeat " " (php/max 1 (php/- 8 (php/mb_strwidth key))))
                        label))
        ;; one interior row holding two key/label cells side by side; each
        ;; cell padded to half the interior so the columns line up.
        row2     (fn [lkey llab rkey rlab]
                   (str (pad-visible (cell lkey llab) half)
                        (pad-visible (if (= rkey "") "" (cell rkey rlab)) half)))
        title    [blank
                  (pad-visible "      \e[1;93m✦  P H E L - D O O M  ✦\e[40;97m" w)
                  blank
                  (pad-visible (str "       \e[2;97m// crafted by \e[1;93mChemaclass\e[40;97m\e[2;97m  // v" version "\e[40;97m") w)
                  blank]
        controls [:sep blank
                  (pad-visible "  \e[1mCONTROLS\e[40;97m" w)
                  blank
                  (row2 "w s"     "move"   "1 .. 8" "weapon slot")
                  (row2 "a d"     "strafe" "h"      "info menu")
                  (row2 "← → ↑ ↓" "turn/look" "m n" "map / sound")
                  (row2 "e"       "180°"   "p"      "pause")
                  (row2 "space"   "fire"   "F3 q"   "debug / quit")
                  (row2 "r"       "reload" "mouse"  "look/fire")
                  blank]
        ;; Last line is terminal-aware: a capable terminal gets the universal
        ;; mouse hint; one that can't hide the OS pointer gets the cosmetic-
        ;; arrow caveat instead (same row count, so the box height is fixed).
        howto    [:sep blank
                  (pad-visible "  \e[1mHOW TO PLAY\e[40;97m" w)
                  blank
                  (pad-visible "  Shoot enemies. Walk into a door to advance." w)
                  (pad-visible "  Heart refills a life. Armor soaks a hit." w)
                  (pad-visible (str "  " (or mouse-note
                                             "Mouse turns the view; aim is the + crosshair.")) w)
                  blank]
        footer   [:sep blank
                  (pad-visible "    \e[93mENTER\e[40;97m start   \e[93ms\e[40;97m settings   \e[93mq\e[40;97m quit" w)
                  blank]]
    (apply vector
           (cond
             ;; Full menu: title + controls (2-col) + how-to-play + footer.
             ;; Needs >= 30 rows so the box (with the how-to section) fits
             ;; without the bottom border / footer clipping off-screen.
             (php/>= rows 30) (concat title controls howto footer)
             ;; Medium: drop the how-to-play section.
             (php/>= rows 22) (concat title controls footer)
             ;; Tight: title + footer only, with a hint that resizing
             ;; reveals the full menu.
             :else            (concat title
                                      [:sep blank
                                       (pad-visible "       \e[2;97mresize terminal for full menu\e[40;97m" w)
                                       blank]
                                      footer)))))

(defn render-start-menu
  "Full-screen wash + centred bordered box listing controls and a
   how-to-play blurb. Same geometry helpers as render-end-screen so
   borders align pixel-perfect with the rest of the UI. `mouse-note` is an
   optional terminal caveat line (nil to omit) from `pointer-limit-notice`."
  [cols rows mouse-note]
  (let [items (start-menu-rows rows mouse-note)
        parts (buf-mk)
        bar   (php/str_repeat "─" start-menu-width)
        wash  "\e[48;5;233m"]
    (buf-push parts "\e[H")
    (loop [r 1]
      (when (php/<= r rows)
        (buf-push parts (str "\e[" r ";1H" wash
                             (php/str_repeat " " cols)))
        (recur (php/+ r 1))))
    (let [n       (count items)
          row-top (php/max 1 (php/- (php/intdiv rows 2) (php/intdiv n 2)))
          col0    (php/max 1 (php/- (php/+ (php/intdiv cols 2) 1)
                                    (php/intdiv (php/+ start-menu-width 2) 2)))]
      (buf-push parts (str "\e[" row-top ";" col0
                           "H\e[40;97m┌" bar "┐\e[0m"))
      (buf-push parts (str "\e[" (php/+ row-top n 1) ";" col0
                           "H\e[40;97m└" bar "┘\e[0m"))
      (loop [i 0]
        (when (php/< i n)
          (let [item (get items i)
                row  (php/+ row-top 1 i)]
            (if (= item :sep)
              (buf-push parts (str "\e[" row ";" col0
                                   "H\e[40;97m├" bar "┤\e[0m"))
              (buf-push parts (str "\e[" row ";" col0
                                   "H\e[40;97m│" item "\e[40;97m│\e[0m"))))
          (recur (php/+ i 1)))))
    (print (php/implode "" parts))
    (php/flush)))

(defn render-settings!
  "Full-screen wash + centred settings box, for the start-menu options
   screen (no game frame behind it). `settings` is the live map and
   `cursor` the selected field index. The in-game pause overlay reuses
   the same box via render!'s :paused branch; this entry just adds the
   background wash so it reads as a standalone screen."
  [cols rows settings cursor]
  (let [parts (buf-mk)
        wash  "\e[48;5;233m"]
    (buf-push parts "\e[H")
    (loop [r 1]
      (when (php/<= r rows)
        (buf-push parts (str "\e[" r ";1H" wash (php/str_repeat " " cols)))
        (recur (php/+ r 1))))
    (buf-push parts (settings-menu-string cols rows settings cursor
                                          "↑↓ws move  ←→ad change  esc back"))
    (print (php/implode "" parts))
    (php/flush)))

(defn render-death-screen
  "Centred YOU DIED box on a dark-red wash. Shows this run + the
   persisted bests from the scores file. Box width adapts to `cols`
   (capped 22..36) and switches to a compact layout when `rows`
   drops below `end-compact-rows` so tiny terminals still fit."
  [cols rows kills survived-s level level-name scores summary]
  (let [w (end-box-width-for cols)]
    (render-end-screen cols rows "\e[48;5;52m"
                       (death-rows kills survived-s level level-name scores summary rows w)
                       w)))

(defn render-victory-screen
  "Centred VICTORY box on a dark-green wash. Same responsive width +
   compact-mode rules as render-death-screen."
  [cols rows kills survived-s level level-name scores summary]
  (let [w (end-box-width-for cols)]
    (render-end-screen cols rows "\e[48;5;22m"
                       (victory-rows kills survived-s level level-name scores summary rows w)
                       w)))
