(ns phel-doom.modules.state)

(defn new-player
  "Create a player record with floating-point position and angle in radians."
  {:export true}
  [x y angle]
  {:x x :y y :angle angle})

(def max-lives
  "Hard cap on the player's life total. Heart pickups don't go above
   this; new runs start here."
  5)

(defn new-world
  "Bundle map grid and player into the world state. Stores a PHP-native
   copy of the grid under :pgrid so the raycast hot loop can read cells
   via aget instead of going through Phel's persistent-vector dispatch."
  {:export true}
  [grid player]
  {:grid      grid
   :pgrid     (to-php-array (map to-php-array grid))
   :width     (count (first grid))
   :height    (count grid)
   :player    player
   :show-map  true
   :paused    false
   :sound-on  true
   :enemies   []
   :hearts    []
   :kills     0
   :lives     max-lives
   :iframes   0.0
   :fire-anim 0.0
   :fx        []
   :moves     {:fwd          0
               :back         0
               :strafe-left  0
               :strafe-right 0
               :turn-left    0
               :turn-right   0}})

(defn gain-life
  "Add one life to the player, capped at max-lives."
  {:export true}
  [world]
  (update world :lives (fn [l] (php/min max-lives (php/+ l 1)))))

(defn with-enemies
  "Attach an enemies vector to the world. Kept as a separate step so
   new-world stays pure / deterministic for tests."
  {:export true}
  [world enemies]
  (assoc world :enemies enemies))

(defn toggle-map
  "Flip the :show-map flag that switches the renderer between overlay
   minimap (false) and side-by-side big map (true)."
  {:export true}
  [world]
  (update world :show-map not))

(defn toggle-pause
  "Flip the :paused flag. While true, the game loop skips physics, AI,
   shot resolution, and i-frame decay; render still runs so the pause
   overlay stays visible."
  {:export true}
  [world]
  (update world :paused not))

(defn toggle-sound
  "Flip the :sound-on flag. While false, every sfx call resolves to a
   no-op."
  {:export true}
  [world]
  (update world :sound-on not))

(defn move-player
  "Translate the player by (dx, dy) — no collision check here."
  {:export true}
  [world dx dy]
  (let [{:keys [x y]} (:player world)]
    (update world :player merge {:x (+ x dx) :y (+ y dy)})))

(defn turn-player
  "Rotate the player by dtheta radians."
  {:export true}
  [world dtheta]
  (let [a (:angle (:player world))]
    (update world :player merge {:angle (+ a dtheta)})))
