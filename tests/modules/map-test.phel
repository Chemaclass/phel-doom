(ns phel-doom-tests.modules.map-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.modules.map :refer [default-grid wall?]))

(deftest test-walls-on-perimeter
  (is (wall? default-grid 0 0))
  (is (wall? default-grid 15 0))
  (is (wall? default-grid 0 15))
  (is (wall? default-grid 15 15)))

(deftest test-open-spaces
  (is (not (wall? default-grid 1 1)))
  (is (not (wall? default-grid 8 8))))

(deftest test-out-of-bounds-is-wall
  (is (wall? default-grid -1 0))
  (is (wall? default-grid 100 100)))
