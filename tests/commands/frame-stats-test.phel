(ns phel-doom-tests.commands.frame-stats-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.core.rng :as rng)
  (:require phel-doom.core.level :refer [build-world])
  (:require phel-doom.core.settings :as settings)
  (:require phel-doom.commands.play :refer [frame-stats]))

;; ---------------------------------------------------------------------
;; frame-stats is the render DTO. Most of render receives only `stats`, so a
;; settings row that render honours but frame-stats never projects is a
;; toggle that silently does nothing.
;;
;; Two painters are the documented exception - `hud/minimap-rows` and
;; `paint/paint-compass` take `world` and read `(:settings world)` directly
;; (:colorblind and :high-contrast). They are safe because the world carries
;; :settings, but they are NOT covered by the table below, so adding a
;; render-facing setting consumed that way still needs its own test.
;;
;; The golden flag tests cannot catch this: they hand-build a stats map and
;; inject the key directly, proving the emit path works and saying nothing
;; about whether the setting reaches it.
;; ---------------------------------------------------------------------

(def world
  (let [prev @rng/state]
    (rng/seed! 4242)
    (let [w (build-world 1 5 0 :normal #{:pistol})]
      (reset! rng/state prev)
      w)))

(defn- stats-with [settings]
  (frame-stats (assoc world :settings (settings/coerce-settings settings)) 60 16.0))

;; Boolean settings render reads off `stats`, paired with the stats key
;; carrying them. Three more are stats-only but not booleans, so they get
;; their own test below: :crosshair (enum), :timer (-> :run-timer?) and
;; :mouse (defaults TRUE, so the off case is the interesting one).
;;
;; Of the rest: :music/:sfx are audio, :colorblind and :minimap reach the
;; minimap via `(:settings world)`, and :difficulty / :sensitivity drive run
;; config and input rather than render.
(def render-facing
  [[:high-contrast :high-contrast?]
   [:fast-walls    :fast-walls]
   [:light         :light]
   [:truecolor     :truecolor]
   [:quad          :quad]])

(deftest test-render-facing-settings-are-projected-when-on
  (let [on (reduce (fn [m [setting _]] (assoc m setting true)) {} render-facing)
        s  (stats-with on)]
    (foreach [[setting stat-key] render-facing]
      (is (= true (get s stat-key))
          (str (name setting) " on -> stats " (name stat-key) " true")))))

(deftest test-render-facing-settings-are-projected-when-off
  (let [off (reduce (fn [m [setting _]] (assoc m setting false)) {} render-facing)
        s   (stats-with off)]
    (foreach [[setting stat-key] render-facing]
      (is (= false (get s stat-key))
          (str (name setting) " off -> stats " (name stat-key) " false")))))

(deftest test-every-render-facing-key-is-present-not-nil
  ;; Absent is worse than false: render's (boolean (get stats k)) reads nil
  ;; as off, so a dropped projection looks exactly like the setting being
  ;; turned off and nothing fails.
  (let [s (stats-with {})]
    (foreach [[_ stat-key] render-facing]
      (is (contains? s stat-key) (str (name stat-key) " present in stats")))))

(deftest test-stats-only-settings-are-projected
  ;; :crosshair, :timer and :mouse have NO route to render other than this
  ;; DTO, so dropping or renaming one here would silently disable it -
  ;; the same shape as the :truecolor / :quad bug. tests/io/paint-test.phel
  ;; hand-builds a stats map with these keys injected, so it cannot catch it.
  (let [on  (stats-with {:crosshair :dot :timer true :mouse true})
        off (stats-with {:crosshair :off :timer false :mouse false})]
    (is (= :dot (:crosshair on)) "crosshair enum projected")
    (is (= :off (:crosshair off)) "crosshair :off projected, not defaulted away")
    (is (= true (:run-timer? on)) "timer on -> :run-timer? true")
    (is (= false (:run-timer? off)) "timer off -> :run-timer? false")
    (is (= true (:mouse on)) "mouse on")
    (is (= false (:mouse off)) "mouse off - the non-default case")))

(deftest test-subpixel-defaults-on-and-only-explicit-false-disables
  (is (= true (:subpixel (stats-with {}))) "absent -> on")
  (is (= true (:subpixel (stats-with {:subpixel true}))) "true -> on")
  (is (= false (:subpixel (stats-with {:subpixel false}))) "explicit false -> off"))

(deftest test-view-bob-projects-as-an-intensity-scalar
  (is (= 0.0 (:view-bob (stats-with {:view-bob 0}))) "0% -> 0.0")
  (is (php/> (:view-bob (stats-with {:view-bob 100})) 0.0) "100% -> positive"))
