;; Render geometry + projection math: gradients, sprite scaling,
;; enemy projection, visibility tests. Pure helpers.
(ns phel-doom.io.render.frame-math
  (:require phel-doom.io.render.buffer :refer [buf-mk buf-set buf-get])
  (:require phel-doom.io.render.palette :refer [base-hud-rows code-r code-g code-b nearest-256])
  (:require phel-doom.core.enemies :refer [enemy-types])
  (:require phel-doom.core.engine :refer [proj-dist])
  (:require phel-doom.core.projection :refer [char-aspect wall-px]))

(defn- hud-rows-for
  "Number of HUD rows to reserve at the bottom of the viewport. The
   debug overlay (F3) adds a second row above the standard footer; off
   by default so the 3D viewport keeps its full vertical real estate."
  [stats]
  (if (get stats :debug?) 2 base-hud-rows))

(defn scene-rows
  "Full-detail scene viewport height (rows) for a terminal `rows` tall
   with HUD `stats`: the same `:vh` the renderer derives in `layout`
   (`rows - hud-rows`). The game loop stamps this on the world as
   `:scene-rows` so the vertical hitscan gate (issue #243) projects an
   enemy billboard against the exact height the player sees. Full detail
   on purpose: the pixel-doubled downscale is a perf knob and must not
   change where shots land."
  [^int rows stats]
  (php/- rows (hud-rows-for stats)))

(defn- ^:pure fade-256
  "Darken a 256-color code by factor `t` in [0.0, 1.0]. Handles the
   6×6×6 cube (16-231) by scaling each RGB component, and the 24-step
   grayscale (232-255) by pulling toward the darkest entry. Codes 0-15
   (system palette) are left alone — they're too coarse to fade
   smoothly. Used to fade enemy sprites with distance so they blend
   into the atmospheric haze instead of staying full-saturated
   wherever they are."
  [^int code ^float t]
  (cond
    (php/>= code 232)
    (php/max 232 (php/intval (php/round (php/- code (php/* t (php/- code 232))))))

    (php/>= code 16)
    (let [c (php/- code 16)]
      (let [r (php/intdiv c 36)
            g (php/intdiv (mod c 36) 6)
            b (mod c 6)]
        (let [r' (php/max 0 (php/intval (php/round (php/* (php/- 1.0 t) r))))
              g' (php/max 0 (php/intval (php/round (php/* (php/- 1.0 t) g))))
              b' (php/max 0 (php/intval (php/round (php/* (php/- 1.0 t) b))))]
          (php/+ 16 (php/* 36 r') (php/* 6 g') b'))))

    :else             code))

(defn- fog-tinted?
  ;; Tinted + filmic atmospheric fog is ON by default. PHEL_DOOM_FLAT_FOG=1
  ;; forces the legacy linear fade-to-black distance fog (A/B fallback,
  ;; same pattern as NO_SUBPIXEL / FLAT_WALLS). Read once at load.
  []
  (not (php/=== "1" (php/getenv "PHEL_DOOM_FLAT_FOG"))))

(def- fog-rgb
  ;; Far-distance fog target: a near-neutral light grey with only a faint
  ;; cool bias. Distance fades lerp toward THIS instead of pure black, so
  ;; depth reads as atmospheric haze (aerial perspective: distant surfaces
  ;; recede into a lighter, softer grey) rather than just going "dark".
  ;;
  ;; This was a saturated blue-grey (95/95/135 = cube code 60) - the only
  ;; distinctly-cool tint the 256-colour cube can hold near mid-grey - but
  ;; in the game's near-monochrome levels that read as an out-of-place
  ;; BLUE band through far openings rather than subtle haze. The 256-colour
  ;; palette can't express a "barely cool" mid-grey (the grey ramp is dense,
  ;; so anything close to neutral snaps onto it and loses the hue; anything
  ;; bluer jumps to the obvious 95/95/135). So the honest desaturation is a
  ;; neutral grey: 112/112/120 re-quantizes to grey ~118 at the far end,
  ;; killing the blue band while keeping the lighter-with-distance depth cue.
  (php/array 112 112 120))

(def- filmic-norm
  ;; The ACES-ish curve evaluated at b=1, used to normalise `filmic` so a
  ;; full-brightness input maps to 1.0: num/den = 2.54/3.16.
  (php// 2.54 3.16))

(defn- filmic
  ;; Normalised ACES-ish filmic tone curve on a brightness factor
  ;; b in [0,1]: a toe that keeps shadow contrast and a shoulder that
  ;; rolls off highlights, so the scene reads "lit" rather than linearly
  ;; dimmed. Mid-tones gain contrast; near walls (b~1) roll to full.
  ;; Evaluated load-time only.
  [^float b]
  (let [bc  (cond (php/< b 0.0) 0.0 (php/> b 1.0) 1.0 :else b)
        num (php/* bc (php/+ (php/* 2.51 bc) 0.03))
        den (php/+ (php/* bc (php/+ (php/* 2.43 bc) 0.59)) 0.14)]
    (php// (php// num den) filmic-norm)))

(defn- fade-256-fog
  ;; Distance fade that lerps a colour code toward `fog-rgb` (not black)
  ;; with a filmic brightness curve, then re-quantizes to the nearest
  ;; 256-colour code. `t` in [0,1] = fog amount (0 near, 1 far). System
  ;; codes (0-15) pass through unchanged, matching fade-256. Pure RGB-space
  ;; lerp; load-time LUT bake only.
  [^int code ^float t]
  (if (php/< code 16)
    code
    (let [b  (filmic (php/- 1.0 t))
          fr (php/aget fog-rgb 0)
          fg (php/aget fog-rgb 1)
          fb (php/aget fog-rgb 2)
          r  (php/intval (php/round (php/+ fr (php/* b (php/- (php/aget code-r code) fr)))))
          g  (php/intval (php/round (php/+ fg (php/* b (php/- (php/aget code-g code) fg)))))
          bl (php/intval (php/round (php/+ fb (php/* b (php/- (php/aget code-b code) fb)))))]
      (nearest-256 r g bl))))

(def- fog-fade
  ;; Resolved-once distance fade for every fog LUT bake below. Tinted +
  ;; filmic by default; PHEL_DOOM_FLAT_FOG=1 -> legacy fade-256 (toward
  ;; black). Both share the `(code, t)` signature so callers are agnostic.
  (if (fog-tinted?) fade-256-fog fade-256))

(def tex-fade-table
  "24-level × 256-code distance-fog lookup for textured walls:
   `tex-fade-table[level][code]` is `code` faded by `1 - level/23` toward
   the cool haze tint (or toward black under `PHEL_DOOM_FLAT_FOG=1`) via
   `fog-fade`. Level 23 = full brightness (near wall), 0 = fully fogged
   (far). Lets the wall-texture path apply per-cell fog with a single
   nested `aget` instead of a `fog-fade` call per cell. Built once at
   load (24×256 calls); pure + immutable thereafter."
  (let [outer (php/array)]
    (loop [lvl 0]
      (when (php/< lvl 24)
        (let [inner (php/array)
              t     (php/- 1.0 (php// lvl 23.0))]
          (loop [c 0]
            (when (php/< c 256)
              (php/aset inner c (fog-fade c t))
              (recur (php/+ c 1))))
          (php/aset outer lvl inner))
        (recur (php/+ lvl 1))))
    outer))

;; ---------------------------------------------------------------------
;; Truecolor (24-bit) tagged paint values. A "paint value" handed to the
;; cell builders is EITHER a 256-colour code (0..255 — the legacy path) OR
;; a tagged 24-bit colour:  tagged = 256 + (r<<16 | g<<8 | b),  r/g/b 0..255.
;; Any value >= 256 therefore carries an exact RGB triple. `tex-fade-tc`
;; bakes tagged values; `halfblock-tc` / `paint-bg` disambiguate PER channel
;; so a tagged FG can pair with a 256 BG in one cell (mixed wall/seam cells
;; just work) and the legacy 256-only `halfblock` stays byte-identical.
;; This removes the `nearest-256` snap that bands the distance fog onto the
;; 6×6×6 cube + 24-step grey ramp. Gated OFF by default in the renderer.
(def tc-tag 256)

(defn- pack-tc
  ;; Tag an RGB triple (clamped 0..255) as a truecolor paint value.
  ;; Load-time LUT bake only.
  [^int r ^int g ^int b]
  (php/+ tc-tag
         (php/+ (php/* (php/max 0 (php/min 255 r)) 65536)
                (php/+ (php/* (php/max 0 (php/min 255 g)) 256)
                       (php/max 0 (php/min 255 b))))))

(defn- fade-rgb-fog
  ;; Truecolor twin of `fade-256-fog`: identical filmic lerp toward
  ;; `fog-rgb`, but pack the exact RGB instead of snapping to nearest-256.
  ;; System codes (<16) pass through as their plain code (UI/markers).
  [^int code ^float t]
  (if (php/< code 16)
    code
    (let [b  (filmic (php/- 1.0 t))
          fr (php/aget fog-rgb 0)
          fg (php/aget fog-rgb 1)
          fb (php/aget fog-rgb 2)]
      (pack-tc (php/intval (php/round (php/+ fr (php/* b (php/- (php/aget code-r code) fr)))))
               (php/intval (php/round (php/+ fg (php/* b (php/- (php/aget code-g code) fg)))))
               (php/intval (php/round (php/+ fb (php/* b (php/- (php/aget code-b code) fb)))))))))

(defn- fade-rgb-flat
  ;; Truecolor twin of the legacy fade-to-black fog (PHEL_DOOM_FLAT_FOG):
  ;; lerp the code's RGB toward black by `t`. Niche A/B combo; kept simple.
  [^int code ^float t]
  (if (php/< code 16)
    code
    (let [k (php/- 1.0 t)]
      (pack-tc (php/intval (php/round (php/* k (php/aget code-r code))))
               (php/intval (php/round (php/* k (php/aget code-g code))))
               (php/intval (php/round (php/* k (php/aget code-b code))))))))

(def- fog-fade-rgb
  ;; Resolved-once truecolor distance fade (tinted+filmic by default,
  ;; toward-black under PHEL_DOOM_FLAT_FOG). Same `(code, t)` signature as
  ;; `fog-fade` so the LUT bake is symmetric.
  (if (fog-tinted?) fade-rgb-fog fade-rgb-flat))

(def tex-fade-tc
  "Truecolor twin of `tex-fade-table`: `tex-fade-tc[level][code]` is the
   TAGGED 24-bit colour (>=256) of `code` faded by `1 - level/23` toward
   the haze tint — no nearest-256 snap, so the renderer paints it as a
   `\\e[38;2;r;g;b` / `\\e[48;2;r;g;b` cell. Built once at load (24×256)."
  (let [outer (php/array)]
    (loop [lvl 0]
      (when (php/< lvl 24)
        (let [inner (php/array)
              t     (php/- 1.0 (php// lvl 23.0))]
          (loop [c 0]
            (when (php/< c 256)
              (php/aset inner c (fog-fade-rgb c t))
              (recur (php/+ c 1))))
          (php/aset outer lvl inner))
        (recur (php/+ lvl 1))))
    outer))

(defn- build-seam-darken
  ;; 256-entry LUT darkening a colour code by `steps` grayscale-equivalent
  ;; shade steps: grayscale-ramp codes subtract `steps` clamped at 232
  ;; (exactly the old seam arithmetic), colour-cube codes fade toward
  ;; black by steps/24 (hue-preserving — plain subtraction on a cube code
  ;; jumps to a different hue, e.g. amber 166 - 16 = green 150).
  [^int steps]
  (let [a (php/array)]
    (loop [c 0]
      (when (php/< c 256)
        (php/aset a c
                  (if (php/>= c 232)
                    (php/max 232 (php/- c steps))
                    (fade-256 c (php// steps 24.0))))
        (recur (php/+ c 1))))
    a))

(def seam-darken-16
  "Seam-accent darken LUT, 16 shade steps: the wall's bottom-most sub-row
   (near-black base line). See `build-seam-darken`."
  (build-seam-darken 16))

(def seam-darken-8
  "Seam-accent darken LUT, 8 shade steps: second-to-bottom wall sub-row
   and the floor's first sub-row past the seam."
  (build-seam-darken 8))

(def seam-darken-5
  "Seam-accent darken LUT, 5 shade steps: the wall's top sub-row lip
   against the sky."
  (build-seam-darken 5))

(defmacro seam-shade!
  "Resolve one wall/sky/floor seam sub-sample into `pack-reg[slot]`: sky
   code above the wall top, seam-darkened floor at/below the wall bottom,
   else the fogged wall texel graduated-darkened near the floor/sky seams.
   `slot` is the literal pack-reg index, `sub` the sub-row index symbol,
   `rel` the wall-relative sub-row form. Expands INLINE (no per-cell call,
   so the frame-local pins stay PHP locals - see main/frame->string) and
   reads these call-site locals: pack-reg, ts-sub, bs-sub, whs, u, col,
   fade, tpx, sky-sub-codes, floor-code-at, seam-darken-5/8/16. Was
   copy-pasted 6x across the px2 + px1 emitters (#350)."
  [slot sub rel]
  `(cond
     (php/< ~sub ts-sub)
     (php/aset pack-reg ~slot (php/aget sky-sub-codes ~sub))
     (php/>= ~sub bs-sub)
     (php/aset pack-reg ~slot (if (php/=== ~sub bs-sub)
                                (php/aget seam-darken-8 (floor-code-at ~sub col))
                                (floor-code-at ~sub col)))
     :else
     (let [wc# (php/aget fade (php/aget tpx (php/+ (php/* (php/min 63 (php/intdiv (php/* ~rel 64) whs)) 64) u)))]
       (php/aset pack-reg ~slot
                 (if (php/>= ~sub (php/- bs-sub 1))
                   (php/aget seam-darken-16 wc#)
                   (if (php/>= ~sub (php/- bs-sub 2))
                     (php/aget seam-darken-8 wc#)
                     (if (php/=== ~sub ts-sub)
                       (php/aget seam-darken-5 wc#)
                       wc#)))))))

(def bg-cell-cache
  "256 pre-baked BG paint cells `\\e[48;5;<code>m ` (escape + one space),
   indexed by 256-colour code. The textured-wall path resolves a faded
   code via `tex-fade-table` then fetches its ready cell here — no
   per-cell string allocation."
  (let [a (php/array)]
    (loop [c 0]
      (when (php/< c 256)
        (php/aset a c (str "\e[48;5;" c "m "))
        (recur (php/+ c 1))))
    a))

;; Lazy memo of two-colour ▀ half-block paint cells, keyed `top*256+bot`.
;; Each entry is `\e[38;5;<top>;48;5;<bot>m▀` so the cell shows two stacked
;; full-colour sub-pixels (top fg / bottom bg) - the sub-pixel renderer's
;; per-cell output. `top == bot` collapses to a single-colour BG cell
;; (renders identically, fewer bytes, RLE-coalesces with flat neighbours).
;; Populated on first sight of each colour pair; the floor / wall fades land
;; in a small grayscale band so the live set stays in the low thousands.
;; Raw php-array def-mutation persists across calls in Phel, so no atom
;; indirection in the hot path. NOTE: `def-` does NOT take a string
;; docstring (it would be stored AS the value) - keep this a `;;` comment.
(def- half-cell-cache (php/array))

(defn halfblock
  "Resolve (memoised) the ▀ half-block paint cell for top fg-code /
   bottom bg-code. One array fetch on the hot path after warmup; builds
   + stores the string only on a cache miss. See `half-cell-cache`."
  [^int top ^int bot]
  (let [k   (php/+ (php/* top 256) bot)
        hit (php/aget half-cell-cache k)]
    (if hit
      hit
      (let [s (if (php/=== top bot)
                (str "\e[48;5;" top "m ")
                (str "\e[38;5;" top ";48;5;" bot "m▀"))]
        (php/aset half-cell-cache k s)
        s))))

(defn- tc-fg
  ;; SGR fragment selecting `v` as FOREGROUND: "38;5;CODE" for a 256 code,
  ;; "38;2;R;G;B" for a tagged truecolor value. Cache-miss path only.
  [^int v]
  (if (php/< v tc-tag)
    (str "38;5;" v)
    (let [p (php/- v tc-tag)]
      (str "38;2;" (php/intdiv p 65536) ";" (php/intdiv (php/% p 65536) 256) ";" (php/% p 256)))))

(defn- tc-bg
  ;; SGR fragment selecting `v` as BACKGROUND. Cache-miss path only.
  [^int v]
  (if (php/< v tc-tag)
    (str "48;5;" v)
    (let [p (php/- v tc-tag)]
      (str "48;2;" (php/intdiv p 65536) ";" (php/intdiv (php/% p 65536) 256) ";" (php/% p 256)))))

;; Lazy memo of truecolor ▀ cells. Values can be tagged 24-bit ints up to
;; 256 + 0xFFFFFF, so the int key `top*tc-key-base + bot` (tc-key-base >
;; the max tagged value) stays collision-free and well inside PHP's 64-bit
;; int — far faster than a "top_bot" string key on the floor hot path.
;; Only populated when the truecolor renderer is active.
(def- tc-key-base (php/+ tc-tag 16777216))
(def- half-cell-cache-tc (php/array))
;; Lazy memo of tagged-truecolor BG cells `\e[48;2;r;g;bm `, keyed by the
;; tagged value. 256 codes never land here (paint-bg routes those to the
;; pre-baked bg-cell-cache).
(def- bg-cell-cache-tc (php/array))

(defn halfblock-tc
  "Truecolor-aware ▀ half-block builder. Resolves each channel
   independently — a tagged 24-bit value emits `38;2;`/`48;2;`, a 256 code
   emits `38;5;`/`48;5;` — so wall/seam cells that mix a faded truecolor
   wall against a 256 sky/floor seam paint correctly. `top == bot` collapses
   to a single BG cell (fewer bytes, RLE-coalesces). Memoised like
   `halfblock`. The renderer swaps this in for `halfblock` only when the
   :truecolor path is live."
  [^int top ^int bot]
  (let [k   (php/+ (php/* top tc-key-base) bot)
        hit (php/aget half-cell-cache-tc k)]
    (if hit
      hit
      (let [s (if (php/=== top bot)
                (str "\e[" (tc-bg top) "m ")
                (str "\e[" (tc-fg top) ";" (tc-bg bot) "m▀"))]
        (php/aset half-cell-cache-tc k s)
        s))))

(defn paint-bg
  "Resolve a single-colour BG paint cell for paint value `v`: a 256 code
   hits the pre-baked `bg-cell-cache` (byte-identical to the legacy path);
   a tagged truecolor value builds + memoises a `\\e[48;2;r;g;bm ` cell.
   Replaces a raw `bg-cell-cache` fetch at the floor/wall single-sample
   sites so they transparently support both palettes."
  [^int v]
  (if (php/< v tc-tag)
    (php/aget bg-cell-cache v)
    (let [hit (php/aget bg-cell-cache-tc v)]
      (if hit
        hit
        (let [s (str "\e[" (tc-bg v) "m ")]
          (php/aset bg-cell-cache-tc v s)
          s)))))

;; ---------------------------------------------------------------------
;; 2×2 quadrant sub-pixels (#? quad floor). The ▀ half-block already gives
;; 2× VERTICAL resolution; quadrant Block-Elements glyphs add a 2nd
;; HORIZONTAL sample per cell, so a floor cell can show four texels packed
;; into the two colours an ANSI cell allows. A cell quantises its 4 samples
;; to brightest (FG) + darkest (BG) and picks the glyph whose mask paints
;; each quadrant with the nearer colour. Caller collapses the no-horizontal-
;; detail case (left==right) to a ▀ halfblock so flat/far floor still
;; RLE-coalesces — quadblock only fires where the extra detail is real.
(def- paint-lum256
  ;; 256-code -> rough luminance (r+g+b) for the quad quantizer.
  (let [a (php/array)]
    (loop [c 0]
      (when (php/< c 256)
        (php/aset a c (php/+ (php/aget code-r c) (php/+ (php/aget code-g c) (php/aget code-b c))))
        (recur (php/+ c 1))))
    a))

(defn- paint-lum
  ;; Luminance of a paint value (256 code via LUT, tagged truecolor via unpack).
  [^int v]
  (if (php/< v tc-tag)
    (php/aget paint-lum256 v)
    (let [p (php/- v tc-tag)]
      (php/+ (php/intdiv p 65536) (php/+ (php/intdiv (php/% p 65536) 256) (php/% p 256))))))

(def- quad-glyphs
  ;; pattern (TL<<3 | TR<<2 | BL<<1 | BR) -> Block-Elements glyph; FG paints
  ;; the set bits, BG the clear bits. Universal (Unicode 1.0) coverage.
  (php/array " " "▗" "▖" "▄" "▝" "▐" "▞" "▟" "▘" "▚" "▌" "▙" "▀" "▜" "▛" "█"))

;; Two caches to avoid 64-bit overflow on raw truecolor keys.
;; 256-only inputs (all channels < tc-tag): keyed by raw ((tl*256+tr)*256+bl)*256+br,
;; which fits in 32 bits and lets the cache hit skip the 8 paint-lum calls.
;; Truecolor/mixed inputs: keyed by (fg*tc-key-base+bg)*16+pat (quantize-keyed,
;; original scheme — a raw 4-channel tc-key-base key would overflow 64-bit int).
(def- quad-cell-cache (php/array))
(def- quad-cell-cache-256 (php/array))

(defn quadblock
  "2×2 quadrant paint cell for the four sub-pixel paint values TL/TR/BL/BR
   (256 codes or tagged truecolor — resolved per channel like halfblock-tc).
   Quantises to the brightest (FG) + darkest (BG) sample by luminance,
   assigns each quadrant to the nearer of the two, and looks up the
   Block-Elements glyph for that 2×2 mask. 256-code inputs check a raw-quad
   cache before quantizing, skipping 8 `paint-lum` calls on a hit. Truecolor
   inputs use a quantize-keyed cache to avoid 64-bit key overflow.
   Callers must first collapse the no-horizontal-detail case
   (TL==TR & BL==BR) to a ▀ halfblock — this is the genuinely 2-wide path."
  [^int tl ^int tr ^int bl ^int br]
  (if (if (php/< tl tc-tag) (if (php/< tr tc-tag) (if (php/< bl tc-tag) (php/< br tc-tag) false) false) false)
    ;; 256-only: raw-key cache checked BEFORE quantize — hit avoids all lum work.
    (let [rk  (php/+ (php/* (php/+ (php/* (php/+ (php/* tl 256) tr) 256) bl) 256) br)
          hit (php/aget quad-cell-cache-256 rk)]
      (if hit
        hit
        (let [llt  (paint-lum tl) lrt  (paint-lum tr) llb  (paint-lum bl) lrb  (paint-lum br)
              ;; brightest of each row, then brightest overall -> FG; darkest -> BG.
              topv (if (php/>= llt lrt) tl tr)  topl (if (php/>= llt lrt) llt lrt)
              botv (if (php/>= llb lrb) bl br)  botl (if (php/>= llb lrb) llb lrb)
              fg   (if (php/>= topl botl) topv botv)
              fgl  (if (php/>= topl botl) topl botl)
              ntpv (if (php/< llt lrt) tl tr)   ntpl (if (php/< llt lrt) llt lrt)
              nbtv (if (php/< llb lrb) bl br)   nbtl (if (php/< llb lrb) llb lrb)
              bg   (if (php/<= ntpl nbtl) ntpv nbtv)
              bgl  (if (php/<= ntpl nbtl) ntpl nbtl)
              mid  (php/+ fgl bgl)              ; compare 2*lum vs fgl+bgl
              pat  (php/+ (php/+ (if (php/>= (php/* 2 llt) mid) 8 0)
                                 (if (php/>= (php/* 2 lrt) mid) 4 0))
                          (php/+ (if (php/>= (php/* 2 llb) mid) 2 0)
                                 (if (php/>= (php/* 2 lrb) mid) 1 0)))
              s    (str "\e[" (tc-fg fg) ";" (tc-bg bg) "m" (php/aget quad-glyphs pat))]
          (php/aset quad-cell-cache-256 rk s)
          s)))
    ;; Truecolor/mixed: quantize-keyed cache (raw key would overflow 64-bit).
    (let [llt  (paint-lum tl) lrt  (paint-lum tr) llb  (paint-lum bl) lrb  (paint-lum br)
          ;; brightest of each row, then brightest overall -> FG; darkest -> BG.
          topv (if (php/>= llt lrt) tl tr)  topl (if (php/>= llt lrt) llt lrt)
          botv (if (php/>= llb lrb) bl br)  botl (if (php/>= llb lrb) llb lrb)
          fg   (if (php/>= topl botl) topv botv)
          fgl  (if (php/>= topl botl) topl botl)
          ntpv (if (php/< llt lrt) tl tr)   ntpl (if (php/< llt lrt) llt lrt)
          nbtv (if (php/< llb lrb) bl br)   nbtl (if (php/< llb lrb) llb lrb)
          bg   (if (php/<= ntpl nbtl) ntpv nbtv)
          bgl  (if (php/<= ntpl nbtl) ntpl nbtl)
          mid  (php/+ fgl bgl)              ; compare 2*lum vs fgl+bgl
          pat  (php/+ (php/+ (if (php/>= (php/* 2 llt) mid) 8 0)
                             (if (php/>= (php/* 2 lrt) mid) 4 0))
                      (php/+ (if (php/>= (php/* 2 llb) mid) 2 0)
                             (if (php/>= (php/* 2 lrb) mid) 1 0)))
          k    (php/+ (php/* (php/+ (php/* fg tc-key-base) bg) 16) pat)
          hit  (php/aget quad-cell-cache k)]
      (if hit
        hit
        (let [s (str "\e[" (tc-fg fg) ";" (tc-bg bg) "m" (php/aget quad-glyphs pat))]
          (php/aset quad-cell-cache k s)
          s)))))

(defn build-sky-halfblock
  "Per-row ▀ half-block sky cells at 2× vertical resolution. Each screen
   cell row stacks two sub-rows of the horizon gradient (top fg, bottom
   bg) so the sky band steps twice as smoothly toward the horizon. The
   pair is row-constant (gradient depends only on the row), so the inner
   loop still RLE-coalesces each sky row into a single run. `ctbl` is the
   shade-code-table (bare numeric code strings); the sub-row index runs
   over 2·vh with the horizon at vh. Optional `horizon-offset` (scene
   rows, default 0) shears the horizon for look up/down: it shifts the
   sub-row horizon by `2·offset` so the sky tracks the pitched wall band."
  [^int vh ctbl & [horizon-offset]]
  (let [pr      (or horizon-offset 0)
        arr     (buf-mk)
        ;; Sub-row horizon: vh at level pitch, sheared by pr*2 (two
        ;; sub-rows per scene row) so the sky band tracks the same
        ;; pitched horizon as the wall sub-bounds and floor-cast.
        horizon (php/+ vh (php/* pr 2))
        max-d   (php/max 1 vh)
        code-at (fn [^int s]
                  (let [idx (php/max 0
                                     (php/min 23
                                              (php/intval (php/* (php/- 1.0
                                                                        (php// (php/abs (php/- s horizon))
                                                                               max-d))
                                                                 23))))]
                    (php/intval (buf-get ctbl idx))))]
    (loop [r 0]
      (when (php/< r vh)
        (buf-set arr r (halfblock (code-at (php/* 2 r))
                                  (code-at (php/+ (php/* 2 r) 1))))
        (recur (php/+ r 1))))
    arr))

(defn build-sky-codes-sub
  "Raw per-SUB-ROW sky gradient codes (ints), indexes 0..2·vh-1 with the
   horizon at sub-row vh — the same curve `build-sky-halfblock` packs
   into ▀ cells, left unpacked so the pixel-doubled renderer can paint
   sub-row `2r` on the upper output row and `2r+1` on the lower as two
   solid cells (full vertical sky smoothness at pixel scale 2). Optional
   `horizon-offset` (scene rows, default 0) shears the horizon by
   `2·offset` sub-rows for look up/down."
  [^int vh ctbl & [horizon-offset]]
  (let [pr      (or horizon-offset 0)
        arr     (php/array)
        ;; Sub-row horizon at vh, sheared by pr*2 (two sub-rows per scene
        ;; row) - same pitched horizon the half-block sky packs.
        horizon (php/+ vh (php/* pr 2))
        max-d   (php/max 1 vh)
        sub     (php/* 2 vh)]
    (loop [s 0]
      (when (php/< s sub)
        (let [idx (php/max 0
                           (php/min 23
                                    (php/intval (php/* (php/- 1.0
                                                              (php// (php/abs (php/- s horizon))
                                                                     max-d))
                                                       23))))]
          (php/aset arr s (php/intval (buf-get ctbl idx))))
        (recur (php/+ s 1))))
    arr))

(defn enemy-shade-string
  "Compose the ANSI BG-only paint cell for one enemy zone at the
   given fade factor."
  [^int code ^float t]
  (str "\e[48;5;" (fade-256 code t) "m "))

(defn enemy-textured-shade-string
  "Like enemy-shade-string but embeds `glyph` (a single character) on
   top of the BG, using `fg-code` (also faded by t) as foreground.
   Used for the body zone so each monster has a recognisable scale /
   muscle / armor pattern beyond just colour."
  [^int code ^float t glyph ^int fg-code]
  (str "\e[48;5;" (fade-256 code t)
       ";38;5;" (fade-256 fg-code t)
       "m" glyph))

(defn ^:pure sprite-h-pd
  "Screen-space height (rows) of a sprite at depth `d` for an explicit
   projection numerator `pd` — `proj-dist` at full detail, half of it in
   the pixel-doubled scene (rows are two terminal rows tall there, so
   heights halve to keep the same on-screen size). Multiplied by scale
   factor `sc`; clamped to `vh`."
  [^float pd ^int vh ^float d ^float sc]
  (php/min vh (php/intval (php/* sc (php// pd (php/* (php/max 0.5 d) char-aspect))))))

(defn ^:pure sprite-h
  "Screen-space height (rows) of a sprite at depth `d`, multiplied by
   scale factor `sc` (1.0 for standard enemies, 2.0 for cyberdemons).
   Clamps to `vh` so the result never exceeds the viewport. Used by
   all sprite painters that need the projected height — centralises
   the `proj-dist / (max(0.5, d) * char-aspect)` formula."
  [^int vh ^float d ^float sc]
  (sprite-h-pd proj-dist vh d sc))

(defn ^:pure boss-col-paint
  "Per-column body / legs / head string overrides that carve a
   boss-shaped silhouette out of the cyberdemon's 2× rectangle:

     - head: visible only near centre (helmet); outer cols show wall.
     - body: solid dense torso centre, lighter arms reach to the edges.
     - legs: gap between two leg columns at the bottom — gap + outer
       cols show wall (boss is in front of the chamber wall).

   Returns `[head body legs]`. `rel-abs` is |col - centre| / max(1, hw)
   so 0 = centre, 1 = edge. `fhead/fbody/flegs` are the default
   per-zone strings the caller already computed; this helper just
   selectively swaps them. `body-code` + `body-fade` reused so the
   arm tint matches the torso. `wall-bg` is the per-col wall body
   string (`shades-normal[c]`) so silhouette cut-outs show the
   chamber wall behind the boss instead of a flat sky block."
  [^float rel-abs fhead fbody flegs ^int body-code ^float body-fade wall-bg]
  (let [arm  (enemy-textured-shade-string body-code body-fade "█" body-code)]
    [(if (php/< rel-abs 0.4) fhead wall-bg)
     (cond
       (php/< rel-abs 0.55) fbody
       (php/< rel-abs 0.95) arm
       :else                wall-bg)
     (cond
       (php/< rel-abs 0.18) wall-bg
       (php/< rel-abs 0.65) flegs
       :else                wall-bg)]))

(def aggro-distance
  "World-units threshold below which an enemy is considered 'close
   enough to hit you'. The head zone is painted full-brightness for
   these enemies as a steady danger cue. Slightly more than 2× the
   touch-damage-dist (0.7) in combat.phel so the player gets a beat of
   warning before contact."
  1.8)

(defn enemy-aggro-head-string
  "Head zone paint cell used when the enemy is within aggro-distance.
   Held steady on the full-brightness head colour (calmer 3D view): the
   bright head IS the 'in striking range' cue, so the old code-driven
   throb between full and half-faded was dropped. `bright?` is kept for
   signature stability (the caller now passes a constant true); a false
   value still falls back to the faded shade."
  [^int code ^bool bright?]
  (if bright?
    (str "\e[48;5;" code "m ")
    (str "\e[48;5;" (fade-256 code 0.6) "m ")))

(defn build-horizon-gradient
  "Per-row PHP array of pre-baked shade strings for the given viewport
   height. Maps each row to a shade-table index based on distance
   from the horizon line (vh/2): closer to the horizon = darker
   (atmospheric haze). Used for both sky AND floor since after a
   distance the eye stops distinguishing them anyway. Optional
   `horizon-offset` (scene rows, default 0) shears the horizon for look
   up/down while keeping the gradient span fixed, so pr=0 is unchanged."
  [^int vh tbl & [horizon-offset]]
  (let [pr      (or horizon-offset 0)
        arr     (buf-mk)
        ;; Horizon line sheared by `pr` scene rows for look up/down; the
        ;; normalisation span (max-d) keeps the unshifted half-height so
        ;; the gradient just translates (pr=0 => identical bytes).
        base    (php/intdiv vh 2)
        horizon (php/+ base pr)
        max-d   (php/max 1 base)]
    (loop [r 0]
      (when (php/< r vh)
        (let [idx (php/max 0
                           (php/min 23
                                    (php/intval (php/* (php/- 1.0
                                                              (php// (php/abs (php/- r horizon))
                                                                     max-d))
                                                       23))))]
          (buf-set arr r (buf-get tbl idx)))
        (recur (php/+ r 1))))
    arr))

(defn build-themed-gradient
  "Per-row PHP array of pre-baked BG paint cells for a level-themed
   sky or floor. Brightest = base-code at the screen edge, fades
   toward black at the horizon via fade-256. When `stripe?` is true,
   every other row pulls one extra fade step so floors show subtle
   horizontal banding (tile lines). One pass over vh rows per frame;
   vh is small (~30-40) so the cost is negligible. Optional
   `horizon-offset` (scene rows, default 0) shears the horizon for look
   up/down; pr=0 leaves output unchanged."
  [^int vh ^int base-code stripe? & [horizon-offset]]
  (let [pr      (or horizon-offset 0)
        arr     (buf-mk)
        base    (php/intdiv vh 2)
        horizon (php/+ base pr)
        max-d   (php/max 1 base)]
    (loop [r 0]
      (when (php/< r vh)
        (let [t     (php// (php/abs (php/- r horizon)) max-d)
              fade  (php/- 1.0 t)
              fade' (if (and stripe? (php/=== (mod r 2) 1))
                      (php/max 0.0 (php/- fade 0.12))
                      fade)
              code  (fog-fade base-code fade')]
          (buf-set arr r (str "\e[48;5;" code "m ")))
        (recur (php/+ r 1))))
    arr))

(defn build-horizon-gradient-codes
  "Code-only twin of build-horizon-gradient. Stores bare 256-color
   code strings (e.g. \"240\") instead of full SGR paint cells.
   Used to sample the sky gradient code at a specific row so the ▀
   half-block edge cell can blend the exact sky shade of that row
   into the top-half FG, eliminating the flat-236 seam artifact.
   Optional `horizon-offset` (scene rows, default 0) shears the horizon
   for look up/down; pr=0 leaves output unchanged."
  [^int vh ctbl & [horizon-offset]]
  (let [pr      (or horizon-offset 0)
        arr     (buf-mk)
        base    (php/intdiv vh 2)
        horizon (php/+ base pr)
        max-d   (php/max 1 base)]
    (loop [r 0]
      (when (php/< r vh)
        (let [idx (php/max 0
                           (php/min 23
                                    (php/intval (php/* (php/- 1.0
                                                              (php// (php/abs (php/- r horizon))
                                                                     max-d))
                                                       23))))]
          (buf-set arr r (buf-get ctbl idx)))
        (recur (php/+ r 1))))
    arr))

(defn build-themed-gradient-codes
  "Code-only twin of build-themed-gradient. Stores bare 256-color
   code strings (e.g. \"237\") instead of full SGR paint cells.
   Used to sample the floor gradient code at a specific row so the ▀
   half-block edge cell can blend the exact floor shade of that row
   into the bottom-half BG, eliminating the flat floor-code seam.
   Optional `horizon-offset` (scene rows, default 0) shears the horizon
   for look up/down; pr=0 leaves output unchanged."
  [^int vh ^int base-code stripe? & [horizon-offset]]
  (let [pr      (or horizon-offset 0)
        arr     (buf-mk)
        base    (php/intdiv vh 2)
        horizon (php/+ base pr)
        max-d   (php/max 1 base)]
    (loop [r 0]
      (when (php/< r vh)
        (let [t     (php// (php/abs (php/- r horizon)) max-d)
              fade  (php/- 1.0 t)
              fade' (if (and stripe? (php/=== (mod r 2) 1))
                      (php/max 0.0 (php/- fade 0.12))
                      fade)
              code  (fog-fade base-code fade')]
          (buf-set arr r (php/strval code)))
        (recur (php/+ r 1))))
    arr))

(defn direction-char
  "Map an angle in radians to one of 8 unicode arrow chars, snapping to
   the nearest π/4 sector. Public so the minimap layer and tests can
   share the same convention."
  [angle]
  (let [q (php/% (php/intval
                  (php/+ (php// (php/fmod (php/+ angle (php/* 4.0 php/M_PI)) (php/* 2.0 php/M_PI))
                                (php// php/M_PI 4.0))
                         0.5))
                 8)]
    (cond
      (= q 0) "→"
      (= q 1) "↘"
      (= q 2) "↓"
      (= q 3) "↙"
      (= q 4) "←"
      (= q 5) "↖"
      (= q 6) "↑"
      :else   "↗")))

(defn ^:pure project-enemy-pd
  "Project one billboard-style entity into screen space for an explicit
   projection numerator `pd` (`proj-dist` at full detail, half of it in
   the pixel-doubled scene so columns/widths land in scene cells).
   Returns {:col :half-width :dist :scale :damage-ratio :type} or nil
   when behind / off-screen — see `project-enemy` for the field contract."
  [^float pd enemy player ^int vw]
  (let [dx (php/- (:x enemy) (:x player))
        dy (php/- (:y enemy) (:y player))]
    (let [rel-norm (php/- (php/fmod (php/+ (php/- (php/atan2 dy dx) (:angle player))
                                           (php/* 3.0 php/M_PI))
                                    (php/* 2.0 php/M_PI))
                          php/M_PI)
          cos-rel  (php/cos rel-norm)]
      (if (php/<= cos-rel 0.05)
        nil
        (let [dist      (php/* (php/sqrt (php/+ (php/* dx dx) (php/* dy dy))) cos-rel)
              max-lives (or (:max-lives enemy) 1)
              lives     (or (:lives enemy) max-lives)
              dmg       (if (php/<= max-lives 1)
                          0.0
                          (php/max 0.0 (php/min 1.0
                                                (php/- 1.0 (php// lives max-lives)))))
              ;; Boss scale: cyberdemons (final boss + L5 mob) tower
              ;; 2× wider / taller than the standard catalog so the
              ;; L10 fight reads as a real boss encounter. Other types
              ;; render at native size (1.0).
              scale     (if (php/=== (:type enemy) :cyber) 2.0 1.0)
              hw-base   (php/max 1 (php/intval (php// pd (php/* (php/max 0.5 dist) 3.0))))]
          {:col          (php/intval (php/+ (php/* 0.5 vw) (php/* (php/tan rel-norm) pd)))
           :half-width   (php/max 1 (php/intval (php/* hw-base scale)))
           :dist         dist
           :scale        scale
           :damage-ratio dmg
           :type         (:type enemy)})))))

(defn project-enemy
  "Project one enemy into screen space relative to the player. Returns
   {:col :half-width :dist :scale :damage-ratio :type} or nil if the enemy
   is behind the player or off-screen. `:damage-ratio` is 0.0 at full health
   and approaches 1.0 as the enemy nears death; render uses it to tint the
   body shade darker for wounded enemies. Distance is fish-eye corrected
   so it can be compared directly to entries in the wall `dists` array."
  [enemy player ^int vw]
  (project-enemy-pd proj-dist enemy player vw))

(defn collect-enemy-projs
  "Project every alive enemy and return a vector sorted by distance
   descending — back-to-front so closer sprites overwrite farther ones
   when painted in order."
  [enemies player vw]
  (let [raw (loop [es enemies acc []]
              (if (php/=== es nil)
                acc
                (let [e (first es)]
                  (recur (next es)
                         (if (and e (:alive e))
                           (let [p (project-enemy e player vw)]
                             (if p (conj acc p) acc))
                           acc)))))]
    (sort-by (fn [x] (php/- 0.0 (:dist x))) raw)))

(defn layout
  "Viewport fills the whole terminal. The minimap is an overlay in the
   top-right corner that the M key shows or hides. The HUD row count
   grows by one when the F3 debug overlay is on so the perf row can
   sit above the standard footer without clipping the 3D view.

   On narrow terminals the minimap auto-scales so it never claims
   more than roughly a third of the screen width: `:map-step` is
   the grid:minimap block size (1 = 1:1, 2 = every 2nd cell, etc.)
   and `:map-mw` is the resulting on-screen minimap width in cols.

   At ultra-wide terminals (vw >> 120) a raw `cols/3` minimap would
   bloat to >40 cols and dominate the screen / chew emit cycles
   without adding readability — cap the upper bound at 40 cols so
   the map stays a compact corner overlay. Standard 80×24 / 120×30
   layouts already sit at or below 40 so this is a no-op for them."
  [cols rows grid-w stats]
  (let [max-mw  (php/max 8 (php/min 40 (php/intdiv cols 3)))
        step    (php/max 1 (php/intval (php/ceil (php// grid-w max-mw))))
        mini-mw (php/intval (php/ceil (php// grid-w step)))]
    {:vw       cols
     :vh       (- rows (hud-rows-for stats))
     ;; The minimap is framed (1-cell box border) and inset from the top
     ;; edge so the panel reads as a deliberate HUD element instead of
     ;; glyphs butting the border. `:map-col` / `:map-row` are the CONTENT
     ;; origin: the left + top border sit one cell up-left of it. The
     ;; panel stays flush to the right terminal edge (the right border
     ;; replaces the old glyph-on-the-edge), because the per-row 3D skip
     ;; runs from a left column to end-of-row and so cannot carve a real
     ;; right margin without leaking flat sky. Top margin (row 1) + the
     ;; top border (row 2) give the breathing room; content starts row 3.
     ;; `max 2` keeps the left border on-screen on tiny terminals.
     :map-col  (php/max 2 (- cols mini-mw))
     :map-row  3
     :map-step step
     :map-mw   mini-mw}))

(defn ^:pure pulse
  "Pause-aware sin-wave beat at `freq` rad/s, sampled at game-time `t`
   (seconds). Returns true for half the cycle, false for the other
   half. Caller passes the world's :game-time so the beat freezes
   whenever the game does — used to throb pickups, door glyph, torch
   lights, behind-warning, etc. without per-element state tracking."
  [^float t ^float freq]
  (php/> (php/sin (php/* t freq)) 0.0))

(defn visuals-for-type
  "Catalog lookup for a type kw, falling back to the level's primary
   `:enemy` type from stats when the enemy carries no `:type`, then
   to `:imp` as a last resort so visuals are never empty (every enemy
   gets a face overlay, no silent skips on unknown types)."
  [type-kw stats]
  (or (get enemy-types type-kw)
      (get enemy-types (or (get stats :enemy) :imp))
      (get enemy-types :imp)))

(defn ^:pure enemy-front-visible-at?
  "True when an enemy at depth `d` is the front-most thing to draw at
   screen column `c`: in front of the wall (dists) AND the front-most
   enemy there (`d <= edists[c]`, where edists holds the nearest enemy
   depth per column after the zone pass). Unlike `pickup-visible-at?`
   the enemy compare is inclusive (`<=`) so the column's own front
   enemy — whose depth equals the stored nearest — still draws; only
   enemies strictly behind it skip.

   Shared by the per-enemy overlays that paint OVER the zone layer and
   would otherwise bleed through a nearer sprite: the grounding shadow
   (issue #86) and the face / eyes glyph (issue #91). Exported for
   tests."
  [^float d c dists edists]
  (let [wd (buf-get dists c)
        ed (buf-get edists c)]
    (and (php/< d wd)
         (or (php/=== ed nil) (php/<= d ed)))))
