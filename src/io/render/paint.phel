;; Overlay paint helpers: every transient visual effect layered onto
;; the base frame (face, crosshair, vignettes, badges, pistol HUD).
(ns phel-doom.io.render.paint
  (:require phel-doom.io.render.buffer :refer [buf-get buf-push])
  (:require phel-doom.io.render.sprites :refer [sprites-enabled?])
  (:require phel-doom.io.render.frame-math :refer [sprite-h aggro-distance visuals-for-type enemy-front-visible-at?])
  (:require phel-doom.io.render.weapon-sprites-data :refer [baked-weapons weapon-flashes])
  (:require phel-doom.core.engine :refer [proj-dist])
  (:require phel-doom.core.projection :refer [wall-px weapon-bob-rows weapon-bob-cols])
  (:require phel-doom.core.format :refer [format-duration])
  (:require phel-doom.core.map :refer [find-door-cell]))

;; Each fn appends one logical UI overlay to the `parts` PHP-array via
;; absolute cursor positioning. `frame->string` (in render/main) composes
;; the base raycast frame then calls these in order; keeping each overlay
;; as its own public fn makes it independently testable.

;; All paint-* helpers below take a `parts` PHP-array, append their
;; absolute-positioned ANSI escapes via php/array_push, and RETURN
;; the array. PHP arrays are pass-by-value at fn boundaries, so the
;; caller MUST rebind parts to the returned value; otherwise the
;; mutations stay local to the helper and the overlay never shows.
;; (Painfully learned: missing pistol, missing hearts HUD.)

;; =====================================================================
;; § Enemy overlays (face, lights)
;; =====================================================================

(defn paint-face-overlay
  "At each visible alive enemy's centre column paint that enemy's
   catalog face glyph at the upper-third of the sprite. Two modes:
     - d < aggro-distance → :face-attack telegraph
     - else               → resting :face (alternates with :face-alt
                            on the global face-phase beat)

   The decorative jump-scare glyph swap (a hardware-blink SGR-5 skull
   painted during the `:scare-secs` window) was removed for a calmer
   3D view: it carried no information the resting / attack faces don't
   already, and the blink read as a random strobe.

   `edists` (nearest enemy depth per column, built during the zone
   pass) gates the glyph so a face behind a closer sprite doesn't bleed
   through — same fix as the grounding shadow (issue #91).

   `sc` is the render pixel scale: `vw`/`vh`/`dists`/`edists` live in
   SCENE cells, so the emitted terminal coordinates multiply by `sc`
   (1 = full detail, identity; 2 = pixel-doubled scene).

   `pr` (scene rows, default 0) is the look up/down horizon shear: the
   sprite body shifts by `pr` in the base frame, so the face glyph adds
   the same `pr` to stay pinned to the head. pr=0 keeps the overlay
   exactly where it was.

   `enemy-projs` is the caller's already-projected/sorted enemy list:
   frame->string projects every enemy once for the zone
   pass, so this fn reuses that same vector instead of re-running
   `collect-enemy-projs` a second time. The caller MUST pass a bundle
   built with the same `vw` this fn receives (full-width at full
   detail; a fresh svw-width bundle in pixel-doubled mode, since the
   zone pass's bundle is projected at the FULL terminal width) so the
   :col values line up with the `vw`-scoped bounds check below.

   The face tracks the sprite's feet anchor on flat ground: the feet row
   is `round(vh/2 + 0.5 * wall-px(proj-dist, d)) + pr`, and the face glyph
   paints at the sprite's upper third (`feet-row - h + h/6`) so it sits on
   the standing body."
  [parts enemy-projs stats vw vh dists edists face-phase ^int sc & [pr-arg]]
  (let [pr (or pr-arg 0)]
    (doseq [proj enemy-projs]
      (let [col         (:col proj)
            d           (:dist proj)
            visuals     (visuals-for-type (:type proj) stats)
            face        (get visuals :face)
            face-alt    (or (get visuals :face-alt) face)
            face-attack (get visuals :face-attack)
            idle        (if (php/> face-phase 0.0) face face-alt)
            glyph       (cond
                          (and face-attack (php/< d aggro-distance)) face-attack
                          :else                                      idle)]
        (when (and glyph
                   (php/>= col 0)
                   (php/< col vw)
                   (enemy-front-visible-at? d col dists edists))
          (let [h        (sprite-h vh d 1.0)
                feet-row (php/+ (php/intval (php/round (php/+ (php// vh 2.0) (php/* 0.5 (wall-px proj-dist d))))) pr)
                face-row (php/+ (php/- feet-row h) (php/intdiv h 6))]
            (when (and (php/>= face-row 1) (php/<= face-row vh))
              (buf-push parts
                        (str "\e[" (php/* sc face-row) ";"
                             (php/+ (php/* sc col) 1) "H" glyph))))))))
  parts)

;; =====================================================================
;; § HUD cues (crosshair, prompts, doors, blood)
;; =====================================================================

(defn paint-crosshair
  "Aim reticle glyph, style from the Crosshair setting (`+` cross /
   `·` dot / `○` open / hidden when `:off`). Jumps one row up + brightens
   while :fire-anim > 0 so the recoil feels like a kick; a live hit-fx
   overrides the idle glyph with a `✗`/`×` hit-marker (even when `:off`).

   Movable crosshair (#324): the reticle is drawn at the world's reticle
   cell `(:aim-col, :aim-row)` (0-based viewport cells the player moved the
   mouse to), so the `+` is the aim point wherever it points. When the
   reticle is absent (`:aim-col` nil - mouse off / not yet placed) it falls
   back to the FIXED screen centre `(vw/2 + 1, vh/2)`, byte-identical to the
   pre-#324 centre crosshair, so keyboard-only / mouse-off frames are
   unchanged. The firing one-row jump + the hit-marker apply at the reticle
   position.

   FPS-aim guarantee (#246): the crosshair IS the mouse aim point (the OS
   pointer stays hidden / unlockable), so when the mouse is ON (`:mouse`
   true) the `:off` style still paints a minimal dot `·` rather than leaving
   the player with no aim indicator. With the mouse off, `:off` keeps hiding
   the idle reticle as before (the hit-marker still flashes on a hit).

   `center-bg` is the SGR-only prefix of the cell currently under the
   reticle (the wall/door body shade at the reticle column). Painting the
   `+` on that BG keeps the cell's real colour visible underneath instead of
   clobbering it with the terminal default."
  [parts stats vw vh center-bg]
  (let [firing?  (php/> (or (get stats :fire-anim) 0.0) 0.0)
        ;; Reticle cell (0-based) the mouse moved to, or the fixed centre
        ;; when absent. Cursor coords are 1-based, so add 1. The non-firing
        ;; idle row is `+1` over the projected centre (centre default
        ;; `vh/2 + 1`); firing lifts it one row.
        aim-col  (get stats :aim-col)
        aim-row  (get stats :aim-row)
        base-col (if (php/=== nil aim-col) (php/+ (php/intdiv vw 2) 1) (php/+ aim-col 1))
        base-row (if (php/=== nil aim-row) (php/+ (php/intdiv vh 2) 1) (php/+ aim-row 1))
        ch-col   base-col
        ch-row   (php/- base-row (if firing? 1 0))
        ;; Hit-marker (issue #201): a live :hit-fx overrides the reticle
        ;; for its brief ttl - a bold-red ✗ confirms a kill, a bold-yellow
        ;; × confirms a wound. Single-shot feedback (it does not strobe).
        hit-fx   (get stats :hit-fx)
        hit?     (and hit-fx (php/> (or (:ttl hit-fx) 0.0) 0.0))
        kill?    (and hit? (:kill? hit-fx))
        ;; Idle reticle glyph from the crosshair-style setting (#203);
        ;; :off normally draws nothing when idle (nil glyph). But while
        ;; mouselook is on the centre reticle IS the aim point, so :off
        ;; falls back to a minimal dot so the player always has an aim
        ;; indicator (#246). The hit-marker overrides regardless so a hit
        ;; always confirms.
        mouse?   (boolean (get stats :mouse))
        style    (or (get stats :crosshair) :cross)
        idle     (cond (= style :dot)  "·"
                       (= style :open) "○"
                       (= style :off)  (if mouse? "·" nil)
                       :else           "+")
        glyph    (cond kill? "✗" hit? "×" :else idle)
        ;; Idle: bold bright-white (NOT the old faint `2`, which read as a
        ;; translucent smudge against the busy half-block floor). Firing:
        ;; bold bright-yellow as a muzzle-kick flash, paired with the
        ;; one-row jump above. center-bg keeps the underlying cell colour
        ;; as the glyph's background so the reticle still sits in the scene.
        ;; Wound and firing share the bold-yellow attribute on purpose: a
        ;; hit almost always lands on the same frame the muzzle flash is
        ;; up, so the two yellows never perceptibly collide - a kill (red)
        ;; is the only state that needs to stand apart.
        ch-att   (cond kill?   "\e[91;1m"
                       hit?    "\e[93;1m"
                       firing? "\e[93;1m"
                       :else   "\e[97;1m")]
    (when glyph
      (buf-push parts
                (str "\e[" ch-row ";" ch-col "H" center-bg ch-att glyph "\e[0m"))))
  parts)

(defn paint-intro-splash
  "Centred banner showing 'LEVEL N · NAME' while :intro-secs > 0.
   Appends an objective subtitle: 'FIND THE <COLOUR> KEY' on locked levels
   (L4 blue / L5 red / L7 yellow), 'KILL THE BOSS TO ESCAPE' on the boss
   level, and 'FIND THE EXIT' (orange, matching the compass exit arrow) on
   plain levels - so the player always has a stated objective (issue #203).
   Subtitle SGR matches the lock / exit colour so the cue reads at a glance."
  [parts stats vw vh]
  (when (php/> (or (get stats :intro-secs) 0.0) 0.0)
    (let [title    (str "LEVEL " (or (get stats :level) 1)
                        " · " (php/strtoupper (or (get stats :level-name) "")))
          lock     (get stats :door-lock)
          subtitle (cond
                     (php/=== lock :blue)   "FIND THE BLUE KEY"
                     (php/=== lock :red)    "FIND THE RED KEY"
                     (php/=== lock :yellow) "FIND THE YELLOW KEY"
                     (php/=== lock :boss)   "KILL THE BOSS TO ESCAPE"
                     ;; Unlocked level: point the player at the exit (the
                     ;; compass already tints the cardinal orange toward it).
                     :else                  "FIND THE EXIT")
          sub-sgr  (cond
                     (php/=== lock :blue)   "\e[40;94;1m"
                     (php/=== lock :red)    "\e[40;91;1m"
                     (php/=== lock :yellow) "\e[40;93;1m"
                     (php/=== lock :boss)   "\e[40;38;5;196;1m"
                     ;; Orange to match the compass exit-door arrow (SGR 214).
                     :else                  "\e[40;38;5;214;1m")
          ;; Box width sized to the longer of title / subtitle so
          ;; both lines fit symmetrically with the same 4-col pad.
          inner    (php/max (php/mb_strlen title)
                            (if subtitle (php/mb_strlen subtitle) 0))
          bw       (php/+ inner 8)
          bar      (php/str_repeat "─" bw)
          centred  (fn [text]
                     (let [pad-total (php/- bw (php/mb_strlen text))
                           pad-l     (php/intdiv pad-total 2)
                           pad-r     (php/- pad-total pad-l)]
                       (str (php/str_repeat " " pad-l) text
                            (php/str_repeat " " pad-r))))
          n-rows   (if subtitle 5 3)
          row0     (php/max 1 (php/- (php/intdiv vh 2) (php/intdiv n-rows 2)))
          col0     (php/max 1 (php/- (php/+ (php/intdiv vw 2) 1)
                                     (php/intdiv (php/+ bw 2) 2)))]
      (buf-push parts
                (str "\e[" row0 ";" col0 "H\e[40;93;1m┌" bar "┐"
                     "\e[" (php/+ row0 1) ";" col0 "H\e[40;93;1m│" (centred title) "│"
                     (if subtitle
                       (str
                        "\e[" (php/+ row0 2) ";" col0 "H\e[40;93;1m├" bar "┤"
                        "\e[" (php/+ row0 3) ";" col0 "H\e[40;97m│" sub-sgr (centred subtitle) "\e[40;93;1m│"
                        "\e[" (php/+ row0 4) ";" col0 "H\e[40;93;1m└" bar "┘")
                       (str
                        "\e[" (php/+ row0 2) ";" col0 "H\e[40;93;1m└" bar "┘"))
                     "\e[0m"))))
  parts)

(defn paint-locked-bump
  "Show 'NEED <COLOUR> KEY' steady over the upper third of the 3D view
   while :locked-door-bump-secs is ticking down. Re-fires every
   bump because try-move resets the timer to locked-bump-secs each
   collision — so leaning into a locked door keeps the cue alive."
  [parts stats vw vh]
  (let [secs (or (get stats :locked-door-bump-secs) 0.0)]
    (when (php/> secs 0.0)
      (let [colour (get stats :locked-door-bump-colour)
            label  (cond
                     (php/=== colour :blue)   "  ⚿  NEED BLUE KEY  ⚿  "
                     (php/=== colour :red)    "  ⚿  NEED RED KEY  ⚿   "
                     (php/=== colour :yellow) "  ⚿  NEED YELLOW KEY  ⚿"
                     (php/=== colour :boss)   "  ☠  KILL THE BOSS  ☠  "
                     :else                    "  ⚿  NEED KEY  ⚿  ")
            sgr    (cond
                     (php/=== colour :blue)   "\e[40;94;1m"
                     (php/=== colour :red)    "\e[40;91;1m"
                     (php/=== colour :yellow) "\e[40;93;1m"
                     (php/=== colour :boss)   "\e[40;38;5;196;1m"
                     :else                    "\e[40;93;1m")
            row    (php/max 1 (php/intdiv vh 3))
            col0   (php/max 1 (php/- (php/+ (php/intdiv vw 2) 1)
                                     (php/intdiv (php/mb_strlen label) 2)))]
        (buf-push parts
                  (str "\e[" row ";" col0 "H" sgr label "\e[0m")))))
  parts)

(def blood-drop-codes
  "256-color codes for the 3-row blood-drop tail: bright -> mid -> dim
   red. Same red gradient family as shade-table-blood."
  [196 124 52])

(defn paint-blood-drops
  "Ambient ceiling-drip overlay: paint a short trail of fading red
   glyphs at every active drop position. Columns are normalised
   (0..1) in state — multiplied by vw here. A 3-row tail fades from
   bright red into dark so each drop reads as falling rather than
   teleporting frame to frame."
  [parts stats vw vh]
  (doseq [d (or (get stats :blood-drops) [])]
    (let [col (php/+ 1 (php/intval (php/* (:col d) (php/max 1 (php/- vw 2)))))
          row (php/intval (:row d))]
      (when (and (php/>= col 1) (php/<= col vw))
        (loop [k 0]
          (when (php/< k 3)
            (let [r    (php/- row k)
                  code (get blood-drop-codes k)]
              (when (and (php/>= r 1) (php/<= r vh))
                (buf-push parts (str "\e[" r ";" col "H\e[38;5;" code ";1m▌\e[0m"))))
            (recur (php/+ k 1)))))))
  parts)

(defn paint-rear-warning
  "Tiny steady '‹ behind ›' label below the compass when at least
   one alive enemy is in the rear arc + within audible range. Dim
   red on the dark HUD strip so it reads as 'something off' without
   stealing focus from the 3D view. Held steady while the rear threat
   is live (calmer 3D view): the cue keeps its meaning without the old
   on/off blink reading as a random strobe.

   `t` is retained for signature stability with the other paint cues."
  [parts ^float t stats vw]
  (when (get stats :rear-warning?)
    (let [label "\e[40;38;5;160;1m‹ behind ›\e[0m"
          col   (php/max 1 (php/- (php/intdiv vw 2) 5))]
      (buf-push parts (str "\e[2;" col "H" label))))
  parts)

(defn paint-low-ammo
  "Top-row steady 'LOW AMMO N' label when total firepower
   (mag + reserve) drops to 3 or fewer rounds — i.e. the player is
   3/2/1 shots away from being defenceless. Right-anchored on row 1
   so it sits next to the centre compass without overdrawing it,
   one row ABOVE paint-rear-warning's row-2 strip.

   Row 1 layout the player sees:
     [hearts/armor at col 1]  ... [compass at vw/2 ± 5]  ... [LOW AMMO right]

   Amber at 3, bright red at 1. Held steady while low (calmer 3D view):
   the colour carries the urgency, no on/off blink needed. Suppressed at
   0 because the ammo HUD cell already turns red when both pools hit zero.

   `t` is retained for signature stability with the other paint cues."
  [parts ^float t stats vw]
  (let [total (php/+ (or (get stats :mag) 0)
                     (or (get stats :ammo-reserve) 0))]
    (when (and (php/> total 0) (php/<= total 3))
      (let [colour (cond (php/<= total 1) "38;5;196"
                         :else            "38;5;214")
            label  (str "\e[40;" colour ";1m! LOW AMMO " total " !\e[0m")
            ;; 14 visible chars in the label; right-anchor with a
            ;; 1-cell breathing margin so it can't bleed past vw.
            col    (php/max 1 (php/- vw 15))]
        (buf-push parts (str "\e[1;" col "H" label))))
    parts))

(def reload-reminder-frac
  "Mag fraction at or below which the periodic reload nag arms. Relative
   to the weapon's mag-size so a 10-round pistol and a 4-round shotgun
   both nag at 'nearly empty' rather than a shared absolute count."
  0.3)

(defn reload-reminder-visible?
  {:doc "True when the 'press R to RELOAD' nag should be on screen this
         frame, given ammo state. Pure so the threshold rules are
         unit-testable independent of the ANSI paint.

         Armed (and held STEADY, for a calmer 3D view) when the mag
         fraction is at or below `reload-reminder-frac` AND there is
         reserve to draw from. The old game-time on/off blink cadence was
         dropped: a near-empty mag is a steady danger state, not a
         flashing one. Suppressed: while reloading (`reload-cd` > 0),
         during the dry-fire CLICK (so prompts don't stack), and on tiny
         viewports (`vh` < 9). Single-round mags (BFG, chainsaw: mag-size
         <= 1) reload every shot by design, so the nag is pure noise and
         is skipped entirely.

         `game-time` is accepted but unused (signature stability)."
   :see-also ["paint-reload-reminder"]
   :example "(reload-reminder-visible? 2 10 30 0.0 0.0 0.0 30) ; => true"}
  [^int mag ^int mag-size ^int reserve ^float reload-cd ^float click-secs ^float game-time ^int vh]
  (and (php/> mag-size 1)
       (php/> reserve 0)
       (php/<= reload-cd 0.0)
       (php/<= click-secs 0.0)
       (php/>= vh 9)
       (php/<= (php// mag mag-size) reload-reminder-frac)))

(defn paint-reload-reminder
  "Steady 'press R to RELOAD' nag above the gun when the player is
   sitting on a near-empty mag with reserve to spare. Visibility is
   decided by the pure `reload-reminder-visible?` (held steady while
   armed, no blink); this fn only positions and paints the chip."
  [parts stats vw vh]
  (let [mag      (or (get stats :mag) 0)
        mag-size (or (get stats :mag-size) 10)
        reserve  (or (get stats :ammo-reserve) 0)
        cd       (or (get stats :reload-cooldown) 0.0)
        click    (or (get stats :empty-click-secs) 0.0)
        gt       (or (get stats :game-time) 0.0)]
    (when (reload-reminder-visible? mag mag-size reserve cd click gt vh)
      (let [text  " press R to RELOAD "
            label (str "\e[40;38;5;226;1m" text "\e[0m")
            col   (php/max 1 (php/- (php/intdiv vw 2)
                                    (php/intdiv (php/strlen text) 2)))
            row   (php/max 3 (php/- vh 8))]
        (buf-push parts (str "\e[" row ";" col "H" label)))))
  parts)

(defn paint-save-flash
  "Brief centred SAVED / LOADED cue near the top after F5 / F9 quick
   save / load (issue #63). Green chip so it's distinct from the amber
   ammo nag."
  [parts stats vw vh]
  (let [secs (or (get stats :save-flash-secs) 0.0)
        msg  (get stats :save-flash-msg)]
    (when (and (php/> secs 0.0) msg (php/>= vh 5))
      (let [text  (str " " msg " ")
            label (str "\e[48;5;22;38;5;231;1m" text "\e[0m")
            col   (php/max 1 (php/- (php/intdiv vw 2)
                                    (php/intdiv (php/strlen text) 2)))]
        (buf-push parts (str "\e[3;" col "H" label)))))
  parts)

(defn paint-reload-ready
  "Brief centred ' READY! ' cue when the reload cooldown finishes and the
   gun is hot again - bright green, at the reload-reminder row so it reads
   as that nag's resolution. Drives off the one-shot `:reload-ready-secs`
   timer (stamped in tick-world on the reload-cooldown >0 -> <=0 edge)."
  [parts stats vw vh]
  (let [secs (or (get stats :reload-ready-secs) 0.0)]
    (when (and (php/> secs 0.0) (php/>= vh 9))
      (let [text  " READY! "
            label (str "\e[40;92;1m" text "\e[0m")
            col   (php/max 1 (php/- (php/intdiv vw 2)
                                    (php/intdiv (php/strlen text) 2)))
            row   (php/max 3 (php/- vh 8))]
        (buf-push parts (str "\e[" row ";" col "H" label)))))
  parts)

(def stamina-bar-cells
  "Width of the STA bar in cells. 10 is wide enough to read the pool
   level at a glance without crowding the HUD strip on narrow
   terminals (40-col)."
  10)

(defn- stamina-chip
  "Render the sprint stamina HUD chip:
       ` STA ████████░░`
   - 10 cells total, filled = (intval (* cells (stam/max))).
   - Fill colour: white at ≥33%, amber under 33%, red when latched
     blocked OR at 0 — so the player sees the colour shift before the
     pool empties and notices the cooldown latch.
   - Same `\\e[40m` BG-wash + `\\e[40;97m` close pattern as the +pack
     / [diff] chips so the leading space + trailing handoff stay on
     the dark HUD wash on light-bg terminals."
  [stats]
  ;; :stamina + :max-stamina always populated by frame-stats; no
  ;; fallback so a missing field surfaces as a visible render bug
  ;; instead of a silently-wrong bar.
  (let [stam      (get stats :stamina)
        smax      (get stats :max-stamina)
        ratio     (php// stam smax)
        clamped   (php/max 0.0 (php/min 1.0 ratio))
        filled    (php/intval (php/floor (php/* stamina-bar-cells clamped)))
        empty-n   (php/- stamina-bar-cells filled)
        blocked?  (boolean (get stats :sprint-blocked?))
        fill-col  (cond
                    (or blocked? (php/<= stam 0.0)) "\e[40;91;1m"
                    (php/< clamped 0.33)            "\e[40;33;1m"
                    :else                           "\e[40;97;1m")
        empty-col "\e[40;38;5;240m"]
    (str "\e[40m " fill-col "STA "
         (php/str_repeat "█" filled)
         empty-col
         (php/str_repeat "░" empty-n)
         "\e[40;97m")))

(defn paint-game-info
  "Top-left game-state strip: `L1 imps · kills 12 · ammo 7/10 [23]`,
   anchored at row 2 col 1 directly under the hearts/armor row. Left
   side stays clear of the minimap (top-right) and the centred
   compass / rear-warning. `_vw` is accepted for parity with the
   other paint-* helpers; the strip is left-anchored so vw doesn't
   feed the col math."
  [parts stats _vw]
  (let [hide-wpn?  (get stats :hide-weapon?)
        hide-name? (get stats :hide-level-name?)
        lvl        (or (get stats :level) 1)
        ;; The level label is enemy-themed ("imps"); `:hide-level-name?`
        ;; blanks it (used when a level has no foes to name).
        name'      (if hide-name? "" (or (get stats :level-name) ""))
        kills      (or (get stats :kills) 0)
        wname      (or (get stats :weapon-name) "pistol")
        mag        (or (get stats :mag) 0)
        cap        (or (get stats :mag-size) 10)
        reserve    (or (get stats :ammo-reserve) 0)
        mag-low    (php/max 1 (php/intdiv cap 3))
        res-low    cap
        mag-col    (cond (php/<= mag 0)       "\e[1;91m"
                         (php/<= mag mag-low) "\e[1;93m"
                         :else                "\e[1m")
        ;; High-contrast (#200): a healthy reserve count shows bold white
        ;; instead of the default dim (SGR 2) that reads as a smudge.
        res-col    (cond (php/<= reserve 0)          "\e[1;91m"
                         (php/<= reserve res-low)    "\e[1;93m"
                         (get stats :high-contrast?) "\e[1m"
                         :else                       "\e[2m")
        ;; Each trailing chunk starts with an explicit `\e[40m` so
        ;; the leading-space byte renders on the dark HUD wash
        ;; instead of inheriting the terminal-default BG that a
        ;; bare `\e[0m` reset would leak (the +pack chip otherwise
        ;; rendered with white halo spaces around it on iTerm2 /
        ;; Ghostty whose default BG is light).
        ;; +pack chip shows the stack count beyond level 1: e.g. a
        ;; player with 2 backpacks reads `+pack x2`. Issue #68 part 3
        ;; switched the boolean to a stacking int; the label keeps
        ;; backward-compatible appearance for the single-pack case.
        bp-lvl     (or (get stats :backpack-level)
                       (if (get stats :backpack?) 1 0))
        pack       (cond
                     (php/<= bp-lvl 0)  ""
                     (php/=== bp-lvl 1) "\e[40m \e[40;33;1m+pack\e[40;97m"
                     :else              (str "\e[40m \e[40;33;1m+pack x" bp-lvl "\e[40;97m"))
        diff       (or (get stats :difficulty) :normal)
        diff-tag   (cond
                     (php/=== diff :easy)      "\e[40m \e[40;32;1m[easy]\e[40;97m"
                     (php/=== diff :hard)      "\e[40m \e[40;33;1m[hard]\e[40;97m"
                     (php/=== diff :nightmare) "\e[40m \e[40;31;1m[nightmare]\e[40;97m"
                     :else                     "")
        keys'      (or (get stats :held-keys) #{})
        keys-tag   (str (if (contains? keys' :blue)   "\e[40m \e[40;94;1m⚿\e[40;97m" "")
                        (if (contains? keys' :red)    "\e[40m \e[40;91;1m⚿\e[40;97m" "")
                        (if (contains? keys' :yellow) "\e[40m \e[40;93;1m⚿\e[40;97m" ""))
        sta-chip   (stamina-chip stats)
        ;; Always-on run timer (issue #203): elapsed run time appended to
        ;; the strip when the Run-timer setting is on. game-time already
        ;; rides in stats, so this is a pure format + concat.
        timer-tag  (if (get stats :run-timer?)
                     (str "\e[40m \e[40;96;1m" (format-duration (or (get stats :game-time) 0.0)) "\e[40;97m")
                     "")
        ;; No weapon in hand (`:hide-weapon?`): drop the name + ammo chunk
        ;; so the info line never advertises a gun that isn't drawn.
        wpn-chunk  (if hide-wpn?
                     ""
                     (str "  \e[1m" wname "\e[22m "
                          mag-col mag "\e[22;97m/" cap " "
                          res-col "[" reserve "]\e[22;97m"))
        ;; Same wash-preserving pattern for the inline mag / reserve
        ;; recolours: replace bare \e[0m resets with \e[40;97m so
        ;; the row never falls off the dark BG mid-string.
        styled     (str "\e[40;97m\e[1mL" lvl "\e[22m " name'
                        "  \e[1mkills\e[22m " kills
                        wpn-chunk
                        pack sta-chip keys-tag diff-tag timer-tag "\e[0m")]
    (buf-push parts (str "\e[2;1H" styled)))
  parts)
;; =====================================================================
;; § Status badges + screen vignettes
;; =====================================================================

(defn- paint-timed-badge
  "Centred top-of-screen powerup banner while the `secs-key` timer is
   ticking. `label` is the word, `sgr` the colour run, `row` the
   terminal row. Shared by the berserk + invuln banners; row decides
   their stacking order when both fire at once. Held STEADY (always
   visible while the timer ticks) for a calmer 3D view - the badge +
   its live countdown carry the state, no on/off pulse needed.

   `t` and `freq` are retained for signature stability with the
   per-badge callers."
  [parts ^float t stats vw secs-key label sgr ^int row ^float freq]
  (let [secs (or (get stats secs-key) 0.0)]
    (when (php/> secs 0.0)
      (let [text (str " " label " " (php/intval (php/ceil secs)) "s ")
            col  (php/max 1 (php/- (php/intdiv vw 2)
                                   (php/intdiv (php/strlen text) 2)))]
        (buf-push parts (str "\e[" row ";" col "H" sgr text "\e[0m")))))
  parts)

(defn paint-berserk-badge
  "Centred top-of-screen `BERSERK Ns` banner while :berserk-secs is
   ticking. Steady red so the rage state is unmistakeable without a
   strobe. Sits on row 3 (under the row-2 game-info strip) so it
   doesn't fight the compass / hearts."
  [parts ^float t stats vw]
  (paint-timed-badge parts t stats vw :berserk-secs "BERSERK"
                     "\e[48;5;52;38;5;226;1m" 3 6.0))

(defn paint-invuln-badge
  "Centred top-of-screen `INVULN Ns` banner while :invuln-secs is
   active. Bright cyan on dark blue. Painted on row 4 so it stacks
   below the berserk banner when both fire at once."
  [parts ^float t stats vw]
  (paint-timed-badge parts t stats vw :invuln-secs "INVULN"
                     "\e[48;5;19;38;5;51;1m" 4 5.0))

(defn paint-empty-click
  "Trigger pulled on an empty mag: show a centred prompt above the
   pistol for `empty-click-seconds` so the player sees WHY the shot
   didn't fire. Single-shot acknowledgement (held steady for its brief
   ttl, no blink). Wording flips based on whether reserve has rounds
   left — `R to reload` is actionable; `OUT OF AMMO` is the
   acknowledgement when both pools are dry. Label is centred from
   its measured visible length so the two variants line up even when
   their lengths differ."
  [parts stats vw vh]
  (let [secs (or (get stats :empty-click-secs) 0.0)]
    (when (and (php/> secs 0.0) (php/>= vh 8))
      (let [reserve (or (get stats :ammo-reserve) 0)
            text    (if (php/> reserve 0)
                      " -- CLICK -- press R to reload "
                      " -- CLICK --   OUT OF AMMO   ")
            sgr     (if (php/> reserve 0) "\e[40;38;5;226;1m" "\e[40;38;5;196;1m")
            label   (str sgr text "\e[0m")
            col     (php/max 1 (php/- (php/intdiv vw 2)
                                      (php/intdiv (php/strlen text) 2)))
            row     (php/max 3 (php/- vh 7))]
        (buf-push parts (str "\e[" row ";" col "H" label))))
    parts))

(defn paint-heartbeat-vignette
  "Steady dim-red bar down both screen edges while in the last ~2 hearts
   (<= 4 HP), off otherwise. Keeps the low-health danger cue but holds it
   steady (calmer 3D view): the old heartbeat-phase pulse made the edges
   throb, which read as a strobe. Painted AFTER the hit-vignette so a
   fresh hit still dominates."
  [parts stats vw vh]
  (let [lives (or (get stats :lives) 0)
        ;; Steady dim-red (52) edge whenever in the last ~2 hearts, with
        ;; no per-frame phase pulse. nil above 4 HP and at death.
        bg    (if (and (php/< lives 5) (php/> lives 0)) "\e[48;5;52m" nil)]
    (when bg
      (let [left-c0  1
            right-c0 (php/max 1 (php/- vw 1))
            cell     (str bg "  ")]
        (loop [r 1]
          (when (php/<= r vh)
            (buf-push parts (str "\e[" r ";" left-c0  "H" cell))
            (buf-push parts (str "\e[" r ";" right-c0 "H" cell "\e[0m"))
            (recur (php/+ r 1)))))))
  parts)

(defn paint-hit-vignette
  "Directional damage arc on the screen edge the attacker came from,
   8-way (issue #201). Painted while iframes active AND `:hurt-dir` is
   set (octant 0..7 from `attacker-octant`). The four cardinals paint a
   centred red bar on the matching edge; the four diagonals paint an L at
   the matching corner, so the player reads the precise incoming-damage
   bearing instead of the old 4-way band. Single-shot feedback (not a
   strobe). No paint when `:hurt-dir` is absent."
  [parts stats bloody? vw vh]
  (let [oct (get stats :hurt-dir)]
    (when (and bloody? (php/!== oct nil))
      ;; `h` = [row c0 c1] horizontal edge strip or nil; `v` = [col r0 r1]
      ;; vertical edge strip or nil. Diagonals set both (an L at a corner).
      ;; Pushes stay in statement position - a buf-push inside a closure
      ;; would mutate a COPY of `parts` and vanish (closure array-copy).
      (let [red "\e[48;5;160m"
            cc  (php/intdiv vw 2)
            cr  (php/intdiv vh 2)
            hw  (php/max 2 (php/intdiv vw 6))
            hh  (php/max 1 (php/intdiv vh 6))
            h   (cond
                  (php/=== oct 0) [1  (php/- cc hw) (php/+ cc hw)]
                  (php/=== oct 4) [vh (php/- cc hw) (php/+ cc hw)]
                  (php/=== oct 1) [1  (php/- vw hw) vw]
                  (php/=== oct 3) [vh (php/- vw hw) vw]
                  (php/=== oct 5) [vh 1 hw]
                  (php/=== oct 7) [1  1 hw]
                  :else           nil)
            v   (cond
                  (php/=== oct 2) [(php/- vw 1) (php/- cr hh) (php/+ cr hh)]
                  (php/=== oct 6) [1            (php/- cr hh) (php/+ cr hh)]
                  (php/=== oct 1) [(php/- vw 1) 1 hh]
                  (php/=== oct 3) [(php/- vw 1) (php/- vh hh) vh]
                  (php/=== oct 5) [1            (php/- vh hh) vh]
                  (php/=== oct 7) [1            1 hh]
                  :else           nil)]
        (when h
          (let [row (get h 0)
                a   (php/max 1 (get h 1))
                b   (php/min vw (get h 2))]
            (buf-push parts (str "\e[" row ";" a "H" red
                                 (php/str_repeat " " (php/max 1 (php/+ (php/- b a) 1)))
                                 "\e[0m"))))
        (when v
          (let [col (php/max 1 (get v 0))
                r0  (php/max 1 (get v 1))
                r1  (php/min vh (get v 2))]
            (loop [r r0]
              (when (php/<= r r1)
                (buf-push parts (str "\e[" r ";" col "H" red "  \e[0m"))
                (recur (php/+ r 1)))))))))
  parts)

(defn paint-berserk-tint
  "Thin rage-red border around the viewport while `:berserk-secs > 0`.
   Distinct from the iframe `paint-hit-vignette` red band so the player
   can read the two states at once (berserk while taking damage shows
   both): the iframe band is bright (code 160) on one edge only;
   berserk paints code 88 (deep crimson) on all four edges, held STEADY
   (calmer 3D view) instead of the old bright/dim sync pulse. Skipped
   when iframes are also active so the shouty hit-vignette wins; the
   berserk badge already covers readability for that overlap case.

   `t` is retained for signature stability with the other paint cues."
  [parts ^float t stats vw vh]
  (let [secs    (or (get stats :berserk-secs) 0.0)
        bloody? (php/> (or (get stats :iframes) 0.0) 0.0)]
    (when (and (php/> secs 0.0) (not bloody?))
      ;; Steady deep-crimson (88) border; no bright (124) pulse frame.
      (let [bg   "\e[48;5;88m"
            top  (str bg (php/str_repeat " " vw) "\e[0m")
            edge (str bg " \e[0m")]
        (buf-push parts (str "\e[1;1H" top))
        (buf-push parts (str "\e[" vh ";1H" top))
        (loop [r 2]
          (when (php/<= r (php/- vh 1))
            (buf-push parts (str "\e[" r ";1H" edge))
            (buf-push parts (str "\e[" r ";" vw "H" edge))
            (recur (php/+ r 1)))))))
  parts)
;; =====================================================================
;; § Weapon HUD, compass, health
;; =====================================================================

(defn paint-heat-bar
  "10-cell heat bar under the pistol sprite. Replaced by a steady bright-red
   'JAMMED' when :jam-secs > 0 (calmer 3D view): the word + its position
   carry the state, no on/off blink needed.

   `t` is retained for signature stability with the other paint cues."
  [parts ^float t stats vw vh]
  (let [heat (or (get stats :heat) 0.0)
        jam  (or (get stats :jam-secs) 0.0)
        cc   (php/+ (php/intdiv vw 2) 1)
        row  (php/- vh 6)]
    (when (or (php/> heat 0.0) (php/> jam 0.0))
      (cond
        (php/> jam 0.0)
        (buf-push parts
                  (str "\e[" row ";" (php/- cc 3) "H\e[91;1mJAMMED\e[0m"))
        :else
        (let [filled (php/intval (php/* heat 10.0))
              empty  (php/- 10 filled)
              colour (cond (php/>= heat 0.85) "\e[41m"
                           (php/>= heat 0.6)  "\e[43m"
                           :else              "\e[42m")]
          (buf-push parts
                    (str "\e[" row ";" (php/- cc 5) "H"
                         colour (php/str_repeat " " filled)
                         "\e[100m" (php/str_repeat " " empty)
                         "\e[0m"))))))
  parts)

(defn paint-kill-streak
  "'x<N> streak' under the minimap while the streak window is live.
   Yellow for 2-4, red for 5+."
  [parts stats map-col map-row visible-mh]
  (let [streak (or (get stats :streak) 0)]
    (when (php/>= streak 2)
      (let [colour (if (php/>= streak 5) "\e[40;91;1m" "\e[40;93;1m")
            label  (str colour "x" streak " streak\e[0m")
            col0   (php/max 1 (php/- (php/+ map-col (php/strlen "x99 streak"))
                                     (php/strlen "x99 streak")))]
        (buf-push parts
                  (str "\e[" (php/+ map-row visible-mh) ";"
                       col0 "H" label)))))
  parts)

(defn- sector-for-angle
  "World-radian angle → cardinal sector index 0..3 (E S W N) — same
   mapping the compass uses for the player's facing arrow."
  [^float angle]
  (let [norm (php/fmod (php/+ angle (php/* 4.0 php/M_PI))
                       (php/* 2.0 php/M_PI))]
    (mod (php/intval (php/+ 0.5 (php// norm (php// php/M_PI 2.0)))) 4)))

(defn- bearing-sector
  "Sector index (0..3 E/S/W/N) of the vector from player to target
   cell (tx, ty). Nil-safe: returns nil if either coord is nil."
  [world ^float tx ^float ty]
  (let [px (:x (:player world))
        py (:y (:player world))]
    (sector-for-angle (php/atan2 (php/- ty py) (php/- tx px)))))

(defn- quest-target-hint
  "Compass directional helper. Returns `{:sector 0..3 :tag kw}`
   where `:tag` is:
     :blue / :red / :yellow
                   — point at the matching un-picked keycard on a
                     locked level (player still needs the key)
     :door         — point at the exit door (the key is already in
                     hand, or the level was never locked)
   nil — nothing useful to point at (no door in grid; defensive).

   Door tint reuses the in-world door SGR colour (orange) so the
   compass cue and the 3D door glyph read as the same artifact."
  [world]
  (let [lock      (:door-lock world)
        held      (or (:held-keys world) #{})
        cards     (or (:keycards world) [])
        need-key? (and lock (not (contains? held lock)))]
    (cond
      need-key?
      (let [match (first (filter (fn [k] (php/=== (:colour k) lock)) cards))]
        (if (php/=== match nil)
          nil
          {:sector (bearing-sector world (:x match) (:y match))
           :tag    lock}))

      :else
      (let [door (find-door-cell (:grid world))]
        (if (php/=== door nil)
          nil
          (let [[dx dy] door]
            ;; Aim at cell-centre so 0.5 nudges don't bias the sector
            ;; toward the cell's upper-left corner.
            {:sector (bearing-sector world (php/+ dx 0.5) (php/+ dy 0.5))
             :tag    :door}))))))

(defn paint-compass
  "Top-centre 4-letter cardinal strip. Three highlights stack:
     - yellow bold = player's facing sector (always shown)
     - tinted bold = QUEST TARGET sector — points at the keycard
       (blue / red / yellow, lock colour) on locked levels until the player
       grabs the card, then switches to the exit door (orange,
       SGR 214 to match the in-world door glyph).
   Quest tint wins over facing tint on the same letter so the cue
   stays visible when the player is already aimed at the right
   cardinal. Other letters render dim white on the dark HUD strip."
  [parts world vw]
  ;; paint-compass takes `world` (not the stats map), so it reads the
  ;; high-contrast setting straight from `:settings` rather than the
  ;; stats `:high-contrast?` the other HUD paints use. Both resolve the
  ;; same value (frame-stats derives `:high-contrast?` from this), so they
  ;; can't diverge within a render pass.
  (let [hc?    (boolean (:high-contrast (:settings world)))
        ;; High-contrast (#200): bold white non-facing letters instead of
        ;; the default dim (SGR 2) white that washes out on poor terminals.
        other  (if hc? "\e[40;97;1m" "\e[40;2;97m")
        pang   (or (:angle (:player world)) 0.0)
        facing (sector-for-angle pang)
        quest  (quest-target-hint world)
        q-sec  (when quest (:sector quest))
        q-sgr  (cond
                 (php/=== (and quest (:tag quest)) :blue)   "\e[40;94;1m"
                 (php/=== (and quest (:tag quest)) :red)    "\e[40;91;1m"
                 (php/=== (and quest (:tag quest)) :yellow) "\e[40;93;1m"
                 (php/=== (and quest (:tag quest)) :door)   "\e[40;38;5;214;1m"
                 :else                                      nil)
        labels ["E" "S" "W" "N"]
        cells  (loop [i 0 acc ""]
                 (if (php/>= i 4)
                   acc
                   (recur (php/+ i 1)
                          (str acc
                               (cond
                                 (and q-sgr (php/=== i q-sec))
                                 (str q-sgr (get labels i) "\e[0m")

                                 (php/=== i facing)
                                 (str "\e[40;1;93m" (get labels i) "\e[0m")

                                 :else
                                 (str other (get labels i) "\e[0m"))
                               (if (php/< i 3) "\e[40m  " "")))))]
    (buf-push parts
              (str "\e[1;" (php/max 1 (php/- (php/intdiv vw 2) 3))
                   "H" cells)))
  parts)

(defn paint-enemy-hp-flashes
  "Float the remaining HP digit above an enemy's head for the brief
   `:hit-flash-secs` window after each non-killing hit. Skips dead
   enemies and 1-HP enemies (where any hit is a kill anyway, so the
   number would always be 0 the moment it appeared). Bright yellow
   on a dark BG so the digit reads against any sprite zone behind
   it. `pr` (rows, default 0) is the look up/down horizon shear at full
   resolution, added so the digit tracks the pitched sprite head.

   `enemy-projs` is the caller's already-projected/sorted enemy list
   (same bundle `paint-face-overlay` takes): this fn used to
   call `project-enemy` a SECOND time per hit-flashing enemy even though
   frame->string's zone pass already projected every alive enemy at the
   same full `vw`. `project-enemy-pd` now carries `:lives` / `:max-lives`
   / `:hit-flash-secs` on every projection (computed there at zero extra
   cost), so this fn filters the shared bundle instead of re-projecting.
   Same `vw`, same pure projection; enemies now paint in the bundle's
   back-to-front order (was `(:enemies world)` list order - only
   observable if two flashing enemies land on the same cell).

   The digit tracks the sprite's feet anchor on flat ground: the feet row
   is `round(vh/2 + 0.5 * wall-px(proj-dist, d)) + pr`, and the digit
   floats one row above the head (`feet-row - h - 1`)."
  [parts enemy-projs vw vh & [pr-arg]]
  (let [pr (or pr-arg 0)]
    (doseq [proj enemy-projs]
      (when (and (php/> (or (:lives proj) 0) 0)
                 (php/> (or (:max-lives proj) 1) 1)
                 (php/> (or (:hit-flash-secs proj) 0.0) 0.0))
        (let [col      (:col proj)
              d        (:dist proj)
              h        (sprite-h vh d 1.0)
              feet-row (php/+ (php/intval (php/round (php/+ (php// vh 2.0) (php/* 0.5 (wall-px proj-dist d))))) pr)
              row      (php/max 1 (php/- (php/- feet-row h) 1))]
          (when (and (php/>= col 1) (php/<= col vw))
            (buf-push parts
                      (str "\e[" row ";" col "H\e[40;38;5;226;1m"
                           (:lives proj) "\e[0m")))))))
  parts)

(defn paint-hearts-hud
  "Top-left lives + armor count. Hearts are held steady bright (calmer 3D
   view): the old dim/bright pulse while bloody read as a strobe, and the
   low-health danger is already carried by the steady heartbeat-vignette
   edge bar. Every glyph carries an explicit dark BG (`\\e[40m`) so the
   strip stays readable on terminals whose default BG is light or
   transparent.

   `t` and `bloody?` are retained for signature stability with the
   caller."
  [parts ^float t stats bloody?]
  (let [hp        (or (get stats :lives) 0)
        cap       (or (get stats :max-lives) 10)
        ;; HP is a half-heart pool: 2 HP per heart. Draw `slots` base
        ;; hearts (10 HP -> 5) as full ♥ / half ◖ / empty ·, with any
        ;; soulsphere over-cap HP shown as extra full hearts beyond the
        ;; base row. Clamp the displayed pool (cap + soul headroom) so
        ;; dev god mode (lives = thousands) can't blow the strip across
        ;; the screen; the engine still tracks the real :lives value.
        slots     (php/intdiv (php/+ cap 1) 2)
        disp      (php/max 0 (php/min hp (php/+ cap 4)))
        full      (php/intdiv disp 2)
        half?     (php/=== 1 (php/% disp 2))
        empty     (php/max 0 (php/- slots (php/+ full (if half? 1 0))))
        armor     (or (get stats :armor) 0)
        god?      (:god? stats)
        ;; High-contrast (#200): empty heart pips in plain white instead
        ;; of the dim grey (90) that disappears on washed-out terminals.
        empty-sgr (if (get stats :high-contrast?) "\e[40;97m" "\e[40;90m")]
    (buf-push parts
              (str "\e[1;1H\e[40m\e[1m\e[91m"
                   (php/str_repeat "♥ " full)
                   (if half? "◖ " "")
                   empty-sgr
                   (php/str_repeat "· " empty)
                   (if (php/> armor 0)
                     (str "\e[40;94;1m" (php/str_repeat "◆ " armor))
                     "")
                   (if god? "\e[40;93;1m GOD " "")
                   "\e[0m")))
  parts)

(def reload-max-drop
  "Peak rows the pistol drops below its rest position mid-reload. The
   sprite is 6 rows tall, so 5 leaves a sliver of muzzle visible at
   the deepest dip — enough to communicate 'gun is down' without
   blanking the bottom of the screen entirely."
  5)

(def recoil-max-up
  "Peak rows the gun kicks UP per shot. Replaces the old camera-tilt
   (which moved the whole 3D view); only the gun sprite bounces now. A
   2-row kick was too subtle to read at a glance, so the snap is bigger
   and clearly visible while still settling back in the fire window."
  5)

(defn- recoil-offset
  "Negative row delta (pistol rises) from :fire-anim. Sine curve so
   the kick peaks mid-window and lands back at rest. 0 when no shot
   is in progress."
  [stats]
  (let [t (or (get stats :fire-anim) 0.0)
        d (or (get stats :fire-anim-duration) 0.0)]
    (if (or (php/<= t 0.0) (php/<= d 0.0))
      0
      (let [progress (php/max 0.0 (php/min 1.0 (php/- 1.0 (php// t d))))]
        (php/intval (php/round (php/* recoil-max-up
                                      (php/sin (php/* progress php/M_PI)))))))))

(defn- reload-offset
  "Map a stats map to a row offset for the pistol sprite this frame.
   0 when no reload is in progress; otherwise rises smoothly to
   `reload-max-drop` at the midpoint of the reload window and falls
   back to 0 as the reload completes. Sin curve gives a natural
   drop-hold-raise without piecewise branches."
  [stats]
  (let [cd  (or (get stats :reload-cooldown) 0.0)
        dur (or (get stats :reload-duration) 0.0)]
    (if (or (php/<= cd 0.0) (php/<= dur 0.0))
      0
      (let [progress (php/max 0.0 (php/min 1.0 (php/- 1.0 (php// cd dur))))]
        (php/intval (php/round (php/* reload-max-drop
                                      (php/sin (php/* progress php/M_PI)))))))))

(defn paint-pistol-hud
  "FPS-style pistol sprite centre-bottom + muzzle flash when firing.

   Each row's BG is taken from `floor-gradient` (trim trailing glyph
   to leave the SGR prefix) so the half-block glyphs (▐ ▌ ▄) have
   their transparent halves fall on the floor colour instead of the
   terminal default (which on some iTerm2 themes is light/white and
   draws a halo around the silhouette).

   While `:reload-cooldown` is positive, the entire sprite is shifted
   down by `reload-offset` rows so the gun visibly drops out of view
   and rises back up over the reload window — rows that would land
   past `vh` are clipped per-row so they don't wrap or trample the
   HUD beneath."
  [parts stats vw vh floor-gradient]
  (when (php/>= vh 6)
    (let [cc        (php/+ (php/intdiv vw 2) 1)
          drop      (reload-offset stats)
          ;; Recoil shifts the sprite UP (negative row delta) on every
          ;; shot. Combined with the reload drop so a fire mid-reload
          ;; just nudges the in-flight reload position.
          recoil    (recoil-offset stats)
          shift     (php/- drop recoil)
          row-bg    (fn [r]
                      (let [cell (buf-get floor-gradient r)]
                        (php/mb_substr cell 0
                                       (php/max 0 (php/- (php/mb_strlen cell) 1)))))
          ;; Render one pistol row only if the shifted row still fits
          ;; on screen. Returns the cursor + paint string or "" when
          ;; the row has slid below the viewport or above row 1.
          paint-row (fn [base-row col bg-row sgr glyphs]
                      (let [r (php/+ base-row shift)]
                        (if (or (php/> r vh) (php/< r 1))
                          ""
                          (str "\e[" r ";" col "H" (row-bg bg-row) sgr glyphs))))
          ;; Per-weapon palette comes from weapons/weapons :palette.
          ;; Falls back to the pistol scheme when no weapon spec is
          ;; passed (e.g. legacy test fixtures). Same 6-slot sprite
          ;; geometry for every weapon; only the SGRs swap so each
          ;; weapon reads with its own colour at a glance.
          palette   (or (get stats :palette)
                        {:muzzle    "\e[1;38;5;250m"
                         :slide     "\e[1;38;5;233m"
                         :slide-dim "\e[1;38;5;232m"
                         :frame     "\e[1;38;5;232m"
                         :grip-hi   "\e[1;38;5;166m"
                         :grip-lo   "\e[1;38;5;130m"})
          muzzle    (:muzzle    palette)
          slide     (:slide     palette)
          slide-dim (:slide-dim palette)
          frame     (:frame     palette)
          grip-hi   (:grip-hi   palette)
          grip-lo   (:grip-lo   palette)]
      ;; Gradient indices are 0-based for vh rows; cursor positions are
      ;; 1-based. Per-weapon SILHOUETTE dispatches on :weapon so each
      ;; weapon reads by SHAPE, not just colour: the pistol is a narrow
      ;; single barrel; the shotgun a wide double-barrel; the chaingun a
      ;; spaced rotary cluster; the chainsaw a toothed blade over an
      ;; engine (no barrel); the BFG a
      ;; bulky cannon with a glowing aperture; the incinerator a thin
      ;; nozzle over a fat fuel tank; the rocket a straight round tube.
      (let [weapon (or (get stats :weapon) :pistol)
            rows
            (cond
              (php/=== weapon :shotgun)
              (str
               (paint-row (php/- vh 5) (php/- cc 1) (php/- vh 6) muzzle    "▄▄▄▄▄▄")
               (paint-row (php/- vh 4) (php/- cc 2) (php/- vh 5) slide     "▐██████▌")
               (paint-row (php/- vh 3) (php/- cc 2) (php/- vh 4) slide     "▐████████▌")
               (paint-row (php/- vh 2) (php/- cc 3) (php/- vh 3) slide-dim "▐██████████▌")
               (paint-row (php/- vh 1) (php/- cc 3) (php/- vh 2) frame
                          (str "▐█" grip-hi "▓▓▓▓▓▓▓▓" frame "█▌"))
               (paint-row vh           (php/- cc 2) (php/- vh 1) grip-lo "▐▓▓▓▓▓▓▓▓▌"))

              (php/=== weapon :chaingun)
              (str
               (paint-row (php/- vh 5) cc           (php/- vh 6) muzzle    "▄ ▄ ▄")
               (paint-row (php/- vh 4) (php/- cc 2) (php/- vh 5) slide     "▐██████▌")
               (paint-row (php/- vh 3) (php/- cc 3) (php/- vh 4) slide     "▐████████▌")
               (paint-row (php/- vh 2) (php/- cc 3) (php/- vh 3) slide-dim "▐██████████▌")
               (paint-row (php/- vh 1) (php/- cc 3) (php/- vh 2) frame
                          (str "▐█" grip-hi "▓▓▓▓▓▓▓▓" frame "█▌"))
               (paint-row vh           (php/- cc 2) (php/- vh 1) grip-lo "▐▓▓▓▓▓▓▓▓▌"))

              ;; Chainsaw: no barrel. Toothed blade up top, light chain
              ;; bar, then the engine block + handle.
              (php/=== weapon :chainsaw)
              (str
               (paint-row (php/- vh 5) (php/- cc 3) (php/- vh 6) muzzle    "◣◢◣◢◣◢◣")
               (paint-row (php/- vh 4) (php/- cc 3) (php/- vh 5) slide-dim "▐░░░░░░░▌")
               (paint-row (php/- vh 3) (php/- cc 2) (php/- vh 4) slide     "▐██████▌")
               (paint-row (php/- vh 2) (php/- cc 3) (php/- vh 3) slide     "▐████████▌")
               (paint-row (php/- vh 1) (php/- cc 3) (php/- vh 2) frame
                          (str "▐█" grip-hi "▓▓▓▓▓▓" frame "█▌"))
               (paint-row vh           (php/- cc 2) (php/- vh 1) grip-lo "▐▓▓▓▓▓▓▌"))

              ;; BFG: bulky cannon, wide glowing aperture + lit core.
              (php/=== weapon :bfg)
              (str
               (paint-row (php/- vh 5) (php/- cc 4) (php/- vh 6) muzzle    "▟██████▙")
               (paint-row (php/- vh 4) (php/- cc 4) (php/- vh 5) slide     "▐██████████▌")
               (paint-row (php/- vh 3) (php/- cc 4) (php/- vh 4) slide
                          (str "▐██" muzzle "▓▓▓▓" slide "██▌"))
               (paint-row (php/- vh 2) (php/- cc 4) (php/- vh 3) slide-dim "▐██████████▌")
               (paint-row (php/- vh 1) (php/- cc 3) (php/- vh 2) frame
                          (str "▐█" grip-hi "▓▓▓▓▓▓▓" frame "█▌"))
               (paint-row vh           (php/- cc 2) (php/- vh 1) grip-lo "▐▓▓▓▓▓▌"))

              ;; Incinerator: thin nozzle over a fat round fuel tank.
              (php/=== weapon :incinerator)
              (str
               (paint-row (php/- vh 5) cc           (php/- vh 6) muzzle    "╤═")
               (paint-row (php/- vh 4) (php/- cc 1) (php/- vh 5) slide     "▐███▌")
               (paint-row (php/- vh 3) (php/- cc 2) (php/- vh 4) slide     "▐██████▌")
               (paint-row (php/- vh 2) (php/- cc 3) (php/- vh 3) slide-dim "▐████████▌")
               (paint-row (php/- vh 1) (php/- cc 2) (php/- vh 2) frame
                          (str "▐█" grip-hi "▓▓▓▓" frame "█▌"))
               (paint-row vh           (php/- cc 2) (php/- vh 1) grip-lo "▐▓▓▓▓▌"))

              ;; Rocket launcher: a straight uniform tube with a rounded
              ;; bore, no taper.
              (php/=== weapon :rocket)
              (str
               (paint-row (php/- vh 5) (php/- cc 2) (php/- vh 6) muzzle    "▗▄▄▄▄▖")
               (paint-row (php/- vh 4) (php/- cc 2) (php/- vh 5) slide     "▐██████▌")
               (paint-row (php/- vh 3) (php/- cc 2) (php/- vh 4) slide     "▐██████▌")
               (paint-row (php/- vh 2) (php/- cc 2) (php/- vh 3) slide-dim "▐██████▌")
               (paint-row (php/- vh 1) (php/- cc 2) (php/- vh 2) frame
                          (str "▐█" grip-hi "▓▓▓▓" frame "█▌"))
               (paint-row vh           (php/- cc 1) (php/- vh 1) grip-lo "▐▓▓▓▓▌"))

              :else
              (str
               (paint-row (php/- vh 5) (php/+ cc 1) (php/- vh 6) muzzle    "▄▄")
               (paint-row (php/- vh 4) cc           (php/- vh 5) slide     "▐██▌")
               (paint-row (php/- vh 3) (php/- cc 1) (php/- vh 4) slide     "▐████▌")
               (paint-row (php/- vh 2) (php/- cc 2) (php/- vh 3) slide-dim "▐██████▌")
               (paint-row (php/- vh 1) (php/- cc 2) (php/- vh 2) frame
                          (str "▐█" grip-hi "▓▓▓▓" frame "█▌"))
               (paint-row vh           (php/- cc 1) (php/- vh 1) grip-lo "▐▓▓▓▓▌")))]
        (buf-push parts (str rows "\e[0m")))
      ;; Muzzle flash suppressed during a reload (drop > 0). Tracks
      ;; the recoil so the flash hangs above the muzzle through the
      ;; kick instead of floating in stale screen space.
      (when (and (php/> (or (get stats :fire-anim) 0.0) 0.0)
                 (php/=== drop 0))
        (let [r-top (php/max 1 (php/+ (php/- vh 7) shift))
              r-bot (php/max 1 (php/+ (php/- vh 6) shift))]
          (buf-push parts
                    (str
                     "\e[" r-top ";" cc "H" (row-bg (php/- vh 8)) "\e[1;93m  ✦  "
                     "\e[" r-bot ";" cc "H" (row-bg (php/- vh 7)) "\e[1;93m *★* "
                     "\e[0m"))))))
  parts)

(defn- floor-row-bg
  "The floor gradient's SGR-only prefix for screen row index `r` (the
   cell minus its trailing glyph). Used as the backing colour for the
   transparent half of a half-lit weapon cell so the gun has no halo."
  [floor-gradient r]
  (let [cell (or (buf-get floor-gradient r) "")]
    (php/mb_substr cell 0 (php/max 0 (php/- (php/mb_strlen cell) 1)))))

(defn- weapon-row-string
  "Build one half-block sprite row (pixel rows `tb`..`tb+w` over
   `bb`..`bb+w`) as a single string. Transparent runs collapse to one
   cursor-forward; a colour SGR is emitted only when it changes from the
   previous cell, so flat regions cost a handful of bytes. `bg` is the
   floor prefix for the row (backs a half-lit cell's transparent half).
   `pf` / `pb` track the fg / bg currently set on the terminal: -2 =
   none yet, -1 = the floor bg, else an xterm-256 index."
  [px tb bb w bg]
  (loop [x 0 acc (php/array) skip 0 pf -2 pb -2]
    (if (php/>= x w)
      (php/implode "" acc)
      (let [top (php/aget px (php/+ tb x))
            bot (php/aget px (php/+ bb x))]
        (if (and (php/=== top -1) (php/=== bot -1))
          (recur (php/+ x 1) acc (php/+ skip 1) pf pb)
          ;; At least one half is lit. fg = the lit half (top wins when
          ;; both); bg = bot when both lit, else the floor (-1 sentinel).
          (let [lead  (if (php/> skip 0) (str "\e[" skip "C") "")
                half? (or (php/=== top -1) (php/=== bot -1))
                nf    (if (php/=== top -1) bot top)
                nb    (if half? -1 bot)
                fg    (if (php/=== nf pf) "" (str "\e[38;5;" nf "m"))
                bg'   (cond (php/=== nb pb) ""
                            (php/=== nb -1) bg
                            :else           (str "\e[48;5;" nb "m"))
                glyph (if (php/=== top -1) "▄" "▀")]
            (php/array_push acc (str lead bg' fg glyph))
            (recur (php/+ x 1) acc 0 nf nb)))))))

(defn paint-weapon-sprite
  "Paint a baked Freedoom viewmodel (`spr` = {:w :h :px}, an xterm-256
   pixel grid with -1 = transparent) centre-bottom, two pixel rows per
   half-block cell, anchored at `vh`. Reuses the reload drop + recoil
   kick so the gun animates on fire. `flash` (or nil) is a muzzle-flash
   sprite overlaid at the gun's top while firing - the green/blue/fire
   energy burst for the bfg / plasma / rocket. See weapon-row-string for
   the per-row byte-saving (cursor-skip + SGR dedup)."
  [parts stats spr vw vh floor-gradient flash]
  (let [w       (:w spr)
        rows    (php/intdiv (:h spr) 2)
        px      (:px spr)
        ;; Idle bob/sway (#412): the gun dips + sways on the walk cycle,
        ;; sharing :bob-phase and the View bob intensity with head-bob.
        ;; Both settle to 0 at rest, so a standing frame is byte-identical.
        bob-ph  (or (:bob-phase stats) 0.0)
        bob-int (get stats :view-bob 0.0)
        vbob    (weapon-bob-rows bob-ph bob-int vh)
        hbob    (weapon-bob-cols bob-ph bob-int vw)
        shift   (php/+ (php/- (reload-offset stats) (recoil-offset stats)) vbob)
        c0      (php/max 1 (php/min (php/+ (php/- vw w) 1)
                                    (php/+ (php/+ (php/intdiv (php/- vw w) 2) 1) hbob)))
        r0      (php/+ (php/- vh rows) 1)]
    (dotimes [j rows]
      (let [sr (php/+ r0 j shift)]
        (when (and (php/<= sr vh) (php/>= sr 1))
          (let [tb   (php/* (php/* 2 j) w)
                bb   (php/+ tb w)
                bg   (floor-row-bg floor-gradient (php/- sr 1))
                line (weapon-row-string px tb bb w bg)]
            (buf-push parts (str "\e[" sr ";" c0 "H" line "\e[0m"))))))
    ;; Muzzle flash burst: sits at the gun's top while firing.
    (when flash
      (let [fw    (:w flash)
            frows (php/intdiv (:h flash) 2)
            fpx   (:px flash)
            fc0   (php/max 1 (php/min (php/+ (php/- vw fw) 1)
                                      (php/+ (php/+ (php/intdiv (php/- vw fw) 2) 1) hbob)))
            ftop  (php/+ (php/- r0 frows) shift 1)]
        (dotimes [j frows]
          (let [sr (php/+ ftop j)]
            (when (and (php/<= sr vh) (php/>= sr 1))
              (let [tb   (php/* (php/* 2 j) fw)
                    bb   (php/+ tb fw)
                    bg   (floor-row-bg floor-gradient (php/- sr 1))
                    line (weapon-row-string fpx tb bb fw bg)]
                (buf-push parts (str "\e[" sr ";" fc0 "H" line "\e[0m")))))))))
  parts)

(defn paint-weapon-hud
  "Bottom first-person weapon view. Paints a baked Freedoom sprite when
   one exists for the active weapon and fits the viewport width; falls
   back to the hand-built ASCII silhouette otherwise (or when
   PHEL_DOOM_NO_SPRITES=1)."
  [parts stats vw vh floor-gradient]
  (let [wk      (or (get stats :weapon) :pistol)
        spr     (get baked-weapons wk)
        firing? (php/> (or (get stats :fire-anim) 0.0) 0.0)
        ;; Muzzle flash only for the energy / heavy weapons. On the
        ;; hitscan guns a flash sprite masks the gun's recoil bounce,
        ;; reading as "the gun stopped animating".
        energy? (or (= wk :bfg) (= wk :incinerator) (= wk :rocket))
        flash   (when (and firing? energy?) (get weapon-flashes wk))]
    (if (and spr (sprites-enabled?) (php/<= (:w spr) vw))
      (paint-weapon-sprite parts stats spr vw vh floor-gradient flash)
      (paint-pistol-hud parts stats vw vh floor-gradient))))

