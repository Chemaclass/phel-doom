(ns phel-doom-tests.core.projection-test
  (:require phel.test :refer [deftest is])
  (:require phel-doom.core.projection :refer [wall-px project-height pitch-rows pitch-cap sprite-half-rows sprite-feet-row clip-sprite-span]))

;; ---------------------------------------------------------------------
;; wall-px: the shared projection kernel. num / ((max 0.3 dist) * 2.0).
;; ---------------------------------------------------------------------

(deftest wall-px-unit-distance
  ;; 70 / (1.0 * 2.0) = 35
  (is (= 35.0 (wall-px 70.0 1.0))))

(deftest wall-px-distance-floor
  ;; dist below 0.3 clamps to 0.3, so a surface in the player's own cell
  ;; can't blow up to an infinite slice.
  (is (= (wall-px 70.0 0.3) (wall-px 70.0 0.05)))
  (is (= (wall-px 70.0 0.3) (wall-px 70.0 0.0))))

(deftest wall-px-monotonic-in-distance
  ;; Farther away looks shorter.
  (is (php/> (wall-px 70.0 1.0) (wall-px 70.0 2.0)))
  (is (php/> (wall-px 70.0 2.0) (wall-px 70.0 4.0))))

;; ---------------------------------------------------------------------
;; project-height: world height -> screen row.
;; ---------------------------------------------------------------------

(deftest project-height-horizon-at-eye
  ;; z == eye-z lands exactly on the horizon (vh/2) at any distance.
  (is (= 15.0 (project-height 70.0 30 1.0 0.5 0.5)))
  (is (= 15.0 (project-height 70.0 30 9.9 0.5 0.5))))

(deftest project-height-wall-centred-on-horizon
  ;; A one-unit wall (z=1 top, z=0 bottom) straddles the horizon
  ;; symmetrically: midpoint is exactly vh/2.
  (let [top (project-height 70.0 30 2.0 0.5 1.0)
        bot (project-height 70.0 30 2.0 0.5 0.0)]
    (is (= 15.0 (php// (php/+ top bot) 2.0)) "midpoint on horizon")
    (is (php/< top 15.0) "top above horizon")
    (is (php/> bot 15.0) "bottom below horizon")))

(deftest project-height-nearer-is-taller
  ;; Closer wall top projects higher up the screen (smaller row).
  (is (php/< (project-height 70.0 30 1.0 0.5 1.0)
             (project-height 70.0 30 4.0 0.5 1.0))))

(deftest project-height-raising-eye-sinks-world-point
  ;; Looking from a higher eye pushes a fixed world height DOWN the
  ;; screen (larger row) - the basis for stepping onto a platform.
  (is (php/> (project-height 70.0 30 2.0 0.8 1.0)
             (project-height 70.0 30 2.0 0.3 1.0))))

(deftest project-height-reconciles-with-wall-pipeline
  ;; Contract: project-height at z=1 / z=0 (eye 0.5) agrees with the
  ;; integer top/bot the renderer derives from wall-px, on an even-gap
  ;; case (dist 2.5 -> wall-h 14, gap 16). Confirms both the cell-res
  ;; wall path and the general primitive share one kernel.
  (let [pd     70.0 vh     30 dist   2.5
        wall-h (php/min vh (php/intval (wall-px pd dist)))
        top    (php/intdiv (php/- vh wall-h) 2)
        bot    (php/+ top wall-h)]
    (is (= top (php/intval (php/round (project-height pd vh dist 0.5 1.0)))))
    (is (= bot (php/intval (php/round (project-height pd vh dist 0.5 0.0)))))))

;; ---------------------------------------------------------------------
;; pitch-rows: normalised look up/down fraction -> integer horizon shear.
;; ---------------------------------------------------------------------

(deftest pitch-rows-zero-is-zero
  ;; The byte-identical contract: no pitch shears the horizon by nothing
  ;; at every viewport height.
  (is (= 0 (pitch-rows 0.0 30)))
  (is (= 0 (pitch-rows 0.0 24)))
  (is (= 0 (pitch-rows 0.0 44))))

(deftest pitch-rows-positive-looks-up-shears-down
  ;; POSITIVE pitch (look up) shears the horizon DOWN the screen, i.e.
  ;; toward larger row numbers, so the offset is positive.
  (is (php/> (pitch-rows 1.0 30) 0))
  (is (php/> (pitch-rows 0.5 30) 0)))

(deftest pitch-rows-negative-looks-down-shears-up
  ;; NEGATIVE pitch (look down) shears the horizon UP (smaller rows).
  (is (php/< (pitch-rows -1.0 30) 0))
  (is (php/< (pitch-rows -0.5 30) 0)))

(deftest pitch-rows-sign-is-antisymmetric
  ;; Equal-and-opposite pitch gives equal-and-opposite shear.
  (is (= (php/- 0 (pitch-rows 0.7 30)) (pitch-rows -0.7 30))))

(deftest pitch-rows-magnitude-grows-with-pitch
  ;; Looking further up shears the horizon further down.
  (is (php/> (pitch-rows 1.0 30) (pitch-rows 0.5 30)))
  (is (php/> (pitch-rows 0.5 30) (pitch-rows 0.25 30))))

(deftest pitch-rows-caps-at-pitch-cap-fraction
  ;; Full pitch shears by exactly round(pitch-cap * vh) rows - the
  ;; documented ceiling (0.4 * 30 = 12).
  (is (= (php/intval (php/round (php/* pitch-cap 30))) (pitch-rows 1.0 30)))
  (is (= (php/- 0 (php/intval (php/round (php/* pitch-cap 30)))) (pitch-rows -1.0 30))))

(deftest pitch-rows-returns-int
  ;; Always an integer scene-row offset (round, not float), so it can
  ;; index gradient arrays / add to integer wall tops cleanly.
  (is (php/is_int (pitch-rows 0.37 30)))
  (is (php/is_int (pitch-rows -0.81 44))))

;; ---------------------------------------------------------------------
;; sprite-half-rows: half the on-screen billboard height (rows) the
;; vertical hitscan gate (issue #243) compares against |pitch-rows|.
;; Mirrors the renderer's sprite height exactly:
;;   h = min(svh, intval(scale * proj-dist / (max(0.5, dist) * char-aspect)))
;; with proj-dist = 70, char-aspect = 2; the helper returns h / 2.
;; ---------------------------------------------------------------------

(deftest sprite-half-rows-clamped-near
  ;; Very close (dist below the 0.5 floor): raw height
  ;; 70 / (0.5 * 2) = 70, clamped to svh=30, halved => 15.0.
  (is (= 15.0 (sprite-half-rows 30 0.25 1.0))))

(deftest sprite-half-rows-distant-shrinks
  ;; Far enemy: 70 / (10 * 2) = 3.5 -> intval 3 -> /2 = 1.5. A distant
  ;; sprite leaves the crosshair almost no vertical slack.
  (is (= 1.5 (sprite-half-rows 30 10.0 1.0))))

(deftest sprite-half-rows-closer-is-more-forgiving
  ;; Monotonic: a nearer enemy always projects at least as many rows as a
  ;; farther one, so the gate is strictly more forgiving up close.
  (is (php/>= (sprite-half-rows 30 2.0 1.0)
              (sprite-half-rows 30 8.0 1.0))))

(deftest sprite-half-rows-boss-scale-bigger
  ;; The 2x boss billboard is taller than a standard enemy at the same
  ;; depth, so its half-height (hence its vertical slack) is larger.
  (is (php/> (sprite-half-rows 30 10.0 2.0)
             (sprite-half-rows 30 10.0 1.0))))

(deftest sprite-half-rows-boss-far-value
  ;; 2 * 70 / (10 * 2) = 7 -> intval 7 -> /2 = 3.5.
  (is (= 3.5 (sprite-half-rows 30 10.0 2.0))))

(deftest sprite-half-rows-capped-by-svh
  ;; The height never exceeds svh, so the half-rows never exceeds svh/2
  ;; even at point-blank range with the boss scale.
  (is (= 7.5 (sprite-half-rows 15 0.5 2.0))))

(deftest sprite-half-rows-full-pitch-still-on-near-sprite
  ;; svh 30: full look-up shears the horizon 12 rows; a point-blank
  ;; sprite (half-rows 15) still spans the crosshair (|12| <= 15).
  (is (php/<= (php/abs (pitch-rows 1.0 30))
              (sprite-half-rows 30 0.5 1.0))))

(deftest sprite-half-rows-full-pitch-misses-far-sprite
  ;; Same full pitch (12 rows) overshoots a distant sprite (half-rows
  ;; 1.5): the crosshair points at the floor/sky, not the body.
  (is (php/> (php/abs (pitch-rows 1.0 30))
             (sprite-half-rows 30 10.0 1.0))))

;; ---------------------------------------------------------------------
;; sprite-feet-row: the FEET anchor (issue #297). The renderer stands the
;; enemy billboard on the projected floor at this row and draws the body
;; upward, instead of centring it on the horizon (the old float). The feet
;; therefore land exactly on the z=0 floor surface for the enemy's cell.
;; ---------------------------------------------------------------------

(deftest sprite-feet-row-equals-projected-floor-flat
  ;; On flat ground (fz=0, eye-z=0.5) the feet land on the SAME row the
  ;; floor surface (project-height at z=0) projects to, at every distance.
  ;; This is the contract that keeps the sprite grounded, not floating.
  (let [pd 70.0 svh 28 eye-z 0.5 pr 0]
    (doseq [d [2.0 4.0 6.0 9.0]]
      (is (= (php/+ (php/intval (php/round (project-height pd svh d eye-z 0.0))) pr)
             (sprite-feet-row pd svh d eye-z 0.0 pr))
          (str "feet on projected floor at d=" d)))))

(deftest sprite-feet-row-below-horizon-flat
  ;; A flat-ground enemy's feet always sit BELOW the horizon (svh/2): the
  ;; floor in front of the camera projects downward. The old horizon-centred
  ;; anchor put the feet above this row (the visible float).
  (let [pd 70.0 svh 28 eye-z 0.5 pr 0]
    (doseq [d [2.0 4.0 8.0]]
      (is (php/> (sprite-feet-row pd svh d eye-z 0.0 pr) (php/intdiv svh 2))
          (str "feet below horizon at d=" d)))))

(deftest sprite-feet-row-raised-cell-stands-higher
  ;; A raised cell (fz>0, e.g. the L5 dais at 0.8) projects the feet HIGHER
  ;; up the screen (smaller row) than flat ground at the same distance, so
  ;; the enemy stands ON its platform. The lift already lives inside
  ;; project-height, so callers must NOT also subtract floor-offset-rows.
  (let [pd 70.0 svh 28 eye-z 0.5 pr 0]
    (doseq [d [3.0 5.0]]
      (is (php/< (sprite-feet-row pd svh d eye-z 0.8 pr)
                 (sprite-feet-row pd svh d eye-z 0.0 pr))
          (str "raised feet above flat feet at d=" d)))))

(deftest sprite-feet-row-pitch-shears-with-floor
  ;; The feet carry the pitch shear: looking up (pr>0) slides the whole
  ;; sprite down the screen by exactly pr, matching the wall/floor band.
  (let [pd 70.0 svh 28 eye-z 0.5 d 4.0]
    (is (= (php/+ (sprite-feet-row pd svh d eye-z 0.0 0) 5)
           (sprite-feet-row pd svh d eye-z 0.0 5)))))

;; ---------------------------------------------------------------------
;; clip-sprite-span: the cross-tier occlusion clip (issue #302). Intersect
;; the billboard span [e-top, e-bot) with the nearer-tier bands:
;;   - a nearer riser (step-d < d) clips the FEET to no lower than the
;;     riser band TOP (step-from); feet below it are covered.
;;   - a nearer ceiling drop (ceil-d < d) clips the HEAD to no higher than
;;     the ceiling band BOTTOM lip (ceil-bots); head above it is covered.
;; Returns the visible [top bot] or nil when fully occluded. Span numbers
;; are screen rows: smaller = higher on screen, e-top < e-bot.
;; ---------------------------------------------------------------------

(deftest clip-span-flat-passes-through
  ;; Flat level: both tier distances nil -> neither guard fires -> the
  ;; span is returned unchanged. This is the byte-identical no-op contract.
  (is (= [8 20] (clip-sprite-span 8 20 nil 30 nil 30 5.0))))

(deftest clip-span-higher-tier-over-edge-unchanged
  ;; An enemy whose feet (e-bot 14) already sit AT/ABOVE a nearer riser's
  ;; top edge (step-from 14) shows fully over the platform edge: the clip
  ;; floors at min(14, 14) = 14, the whole span survives.
  (is (= [6 14] (clip-sprite-span 6 14 2.0 14 nil 30 5.0))))

(deftest clip-span-behind-riser-feet-clipped
  ;; An enemy BEHIND a nearer riser (step-d 2 < d 5) whose feet (e-bot 20)
  ;; fall below the riser top (step-from 14): the feet are hidden, the
  ;; visible span shrinks to [e-top, step-from).
  (is (= [8 14] (clip-sprite-span 8 20 2.0 14 nil 30 5.0))))

(deftest clip-span-fully-behind-riser-dropped
  ;; The whole sprite sits below the riser top edge (e-top 16 >= step-from
  ;; 14): nothing is visible, return nil (skip the column entirely).
  (is (= nil (clip-sprite-span 16 24 2.0 14 nil 30 5.0))))

(deftest clip-span-riser-farther-than-enemy-unchanged
  ;; The riser is FARTHER than the enemy (step-d 9 > d 5): the player sees
  ;; over it, no clip - the span is untouched even though step-from would
  ;; otherwise cut it.
  (is (= [8 20] (clip-sprite-span 8 20 9.0 14 nil 30 5.0))))

(deftest clip-span-under-nearer-cap-head-pushed-down
  ;; A nearer hanging ceiling (ceil-d 2 < d 5) with bottom lip ceil-bots
  ;; 10: the head above it is hidden, the visible span starts at
  ;; max(e-top 6, 10) = 10.
  (is (= [10 20] (clip-sprite-span 6 20 nil 30 2.0 10 5.0))))

(deftest clip-span-ceiling-farther-than-enemy-unchanged
  ;; The ceiling drop is FARTHER than the enemy (ceil-d 9 > d 5): no clip,
  ;; the head is not pushed down even though ceil-bots would cut it.
  (is (= [6 20] (clip-sprite-span 6 20 nil 30 9.0 10 5.0))))

(deftest clip-span-fully-under-cap-dropped
  ;; The whole sprite sits above the ceiling's bottom lip (e-bot 9 <=
  ;; ceil-bots 10): fully occluded by the hanging ceiling, return nil.
  (is (= nil (clip-sprite-span 4 9 nil 30 2.0 10 5.0))))

(deftest clip-span-riser-and-ceiling-both-clip
  ;; Squeezed BETWEEN a nearer riser (feet -> 16) and a nearer ceiling
  ;; (head -> 9): the visible span is the intersection [9, 16).
  (is (= [9 16] (clip-sprite-span 6 22 2.0 16 3.0 9 5.0))))

(deftest clip-span-riser-and-ceiling-squeeze-to-nil
  ;; The two nearer tiers overlap past each other (ceiling lip 14 >= riser
  ;; top 12 after clipping): no visible rows, return nil.
  (is (= nil (clip-sprite-span 6 22 2.0 12 3.0 14 5.0))))

(deftest clip-span-ceiling-sentinel-ignored-when-distance-nil
  ;; Guard correctness: a riserless/ceilingless column carries a sentinel
  ;; band value (svh), but with ceil-d nil the band is never consulted, so
  ;; the head is NOT swallowed by max(e-top, svh). The span survives.
  (is (= [6 20] (clip-sprite-span 6 20 nil 28 nil 28 5.0))))

(deftest clip-span-equal-distance-is-not-nearer
  ;; A tier at EXACTLY the sprite distance is not strictly nearer
  ;; (step-d 5 == d 5), so it does not clip - only a strictly nearer tier
  ;; occludes (matches the wall gate's strict `<`).
  (is (= [8 20] (clip-sprite-span 8 20 5.0 14 nil 30 5.0))))
